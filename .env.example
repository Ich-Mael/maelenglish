# Copy to .env.local and fill in. Never commit real values.

# Required
APP_DB=mongodb://localhost:27017/maelenglish   # new, separate database (not the AfroHK one)
SECRET=change-me                               # session / auth secret (long random string)
APP_URL=http://localhost:3001
APP_TZ=Africa/Ouagadougou                      # optional — day boundary for streaks and daily goals                  # public base URL, used in emails and metadata

# Email (Brevo SMTP) — activation and password-reset links. Without it, links are logged in development
EMAIL_FROM=
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# WhatsApp Cloud API (Meta) — enrolment notifications only (never passwords).
# Without token + phone number id, WhatsApp runs in simulation mode
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_COUNTRY_CODE=226
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
