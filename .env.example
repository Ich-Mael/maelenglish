# Copy to .env.local and fill in. Never commit real values.
# In production (Render) set the same variables in the dashboard.

# Required
APP_DB=mongodb://localhost:27017/maelenglish   # dedicated MaelEnglish database (never the AfroHK one)
APP_URL=http://localhost:3001                  # public base URL (prod: https://your-domain), used in emails, sitemap, share images
APP_TZ=Africa/Ouagadougou                      # optional — day boundary for streaks and daily goals

# Email (Brevo SMTP) — activation and password-reset links, enrolment emails. Without it, links are logged in development
# Sender verified in Brevo (Senders & IP), e.g. MaelEnglish <contact@your-domain> — NOT the …@smtp-brevo.com login
EMAIL_FROM=
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# WhatsApp Cloud API (Meta) — enrolment notifications only (never passwords).
# Without token + phone number id, WhatsApp runs in simulation mode
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_COUNTRY_CODE=226
# optional: WHATSAPP_API_VERSION (default v21.0), WHATSAPP_TEMPLATE_LANG (default fr),
#           WHATSAPP_TEMPLATE_ENROLLMENT (default maelenglish_inscription)

# Object storage for audio — Cloudflare R2 (S3-compatible), see DECISIONS.md.
# The bucket's CORS must allow PUT and GET from APP_URL. Without these, development uses
# a local driver (.uploads/); STORAGE_DRIVER=local forces it (local production-build tests only).
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto

# Daily coach email digest: runs automatically in production; set to « on » to try it in development.
# DIGEST_SCHEDULER=on

# Claude (writing task correction, Claude Haiku 5.5). Without it: fake corrections in development, « correction pas encore disponible » in production.
ANTHROPIC_API_KEY=
# Model of the public diagnostic's report (/diagnostic). Default: claude-sonnet-5-5.
ANTHROPIC_MODEL=
# Where the diagnostic report's « Découvrir le programme » button goes. Default: /#programmes.
NEXT_PUBLIC_PROGRAM_URL=

# Azure AI Speech (neural voices: dictionary pronunciation, later speech features). Speech resource in the Azure portal,
# region close to the server (e.g. westeurope). Without it: dictionary recordings / the browser's voice.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ElevenLabs Agents (AI speaking partner: role-play voice calls; Claude Haiku 5.5 run by ElevenLabs). API key from
# elevenlabs.io → Developers → API keys (needs the Agents / ConvAI and Voices permissions). Without it the Speaking
# Partner says « not available yet ».
ELEVENLABS_API_KEY=

# MaelEnglish Coaching live sessions — Daily (dashboard.daily.co → Developers → API key). Embedded video calls with
# screen sharing (10,000 free participant-minutes a month). Without it, sessions use the coaching's backup video link
# (Zoom / Google Meet) set by the coach.
DAILY_API_KEY=
