<% layout('layouts/boilerplate') %>
<style>
  .form-label {
    margin-top: 1rem;
  }
</style>
<style>
  .subject-card {
    box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;
    font-size: 1.2rem;
    color: rgb(27, 27, 124);
    margin: 2rem 0 1rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1rem 2rem;
  }
</style>
<h1 class="text-center pt-3 mt-5 text-primary"> <%=schoolClass.title %>  |  Serie <%=schoolClass.serie %></h1>
<div class="container mb-5">
  <div class="row mt-5">
    <% for(let subject of subjects) {%>
    <div class="col-md-4 px-3">
      <div class="subject-card">
      <h3 class="text-center pt-3"><%= subject.title %></h3>
      <a href="/admindashboard/100bac/class/<%=schoolClass._id%>/subject/<%=subject._id%>/chapter/new"
        class="btn my-3 btn-primary">Add a new chapter</a>

      <a href="/admindashboard/100bac/class/<%=schoolClass._id%>/subject/<%=subject._id%>/chapters"
        class="btn my-3 btn-success">All Chapters</a>

      </div>
    </div>
    <% } %>
  </div>
</div>