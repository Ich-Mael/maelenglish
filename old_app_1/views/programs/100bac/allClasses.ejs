<% layout('layouts/boilerplate') %>
<style>
  html {
    font-size: 90%;
  }
</style>

<h3 class="text-center mt-5">Serie D</h3>
<div class="col-md-8 mb-5 container">
  <div class="row">
    <% for(let schoolClass of schoolClassesD) {%>
    <div class="col-md-6 p-3">
      <div class="p-3" style="box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;">
        <h2><%= schoolClass.title %></h2>
        <a href='/admindashboard/100bac/class/<%= schoolClass._id %>/subject/new' class="btn mx-2 btn-primary"> Add
          Subject</a>
        <a href="/admindashboard/100bac/class/<%= schoolClass._id %>/subjects" class="btn mx-2 btn-success"> View all
          Subjects of this Class </a>
      </div>
    </div>
    <% } %>
  </div>
</div>

<hr style="height: 0.5rem; color: rgb(14, 14, 198);">

<h3 class="text-center mt-5">Serie A</h3>
<div class="col-md-8 mb-5  container">
  <div class="row">
    <% for(let schoolClass of schoolClassesA) {%>
    <div class="col-md-6 p-3">
      <div class="p-3" style="box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;">
        <h2><%= schoolClass.title %></h2>
        <a href='/admindashboard/100bac/class/<%= schoolClass._id %>/subject/new' class="btn mx-2 btn-primary"> Add
          Subject</a>
        <a href="/admindashboard/100bac/class/<%= schoolClass._id %>/subjects" class="btn mx-2 btn-success"> View all
          Subjects of this Class </a>

          <hr>
        <a class="d-block" href="/admindashboard/100bac/class/<%=schoolClass._id%>/addStudent"
          class="btn my-3 btn-success">Add a student to this class</a> 
      </div>
    </div>
    <% } %>
  </div>
</div>