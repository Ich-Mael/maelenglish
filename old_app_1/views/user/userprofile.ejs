<% layout('layouts/boilerplate') %>
<link href="/stylesheets/user/userprofile.css" rel="stylesheet" />
<div class="container col-md-10" style="margin-top: 100px">
  <div class="row user-banner">
    <div class="col-md-3">
      <img src="<%= user.imageUrl %>" class="user-img img-thumbnail" alt="" />
    </div>
    <div class="col-md-6">
      <h1 class="welcome-msg py-3">
        Salut <%= user.username %> !
        <span>
          <br />
          Bienvenue dans votre espace <span>Afro </span
          ><span class="text-primary">e</span>-School
        </span>
      </h1>
    </div>
    <div class="col-md-3">
      <a href="/reset-password" class="btn btn-outline-danger my-3"
        >Reinitialiser mon mot de passe</a
      >
      <%if(currentUser.role === "admin"){%>
      <a href="/admindashboard" class="btn btn-outline-dark my-3">Admindashboard</a>
      <a href="/register" class="btn btn-outline-dark my-3">Création de compte</a>
      <%}%>
    </div>
  </div>
</div>

<p class="quote">Votre réussite scolaire est garantie à 100%</p>
<h2 class="my-program">
  Mes programmes <span class="text-primary">e</span>-School
</h2>
<div class="row container my-5">
  <div class="col-md-4">
    <% if (currentUser.isHighSchoolStudent) {%>
    <div class="program-wrapper">
      <div class="program-img-wrapper">
        <img
          src="https://www.careersportal.co.za/sites/default/files/styles/amp_1200x675_16_9/public/images/Terrique%20Faro/Maths_1.jpg?itok=tO4eBhoE"
          class="img-fluid"
          alt=""
        />
        <a
          class="btn my-3 ms-3 btn-outline-primary"
          href="/user/<%=currentUser._id%>/highschoolDashboard/<%=currentUser.highSchool_id%>"
          >Afro e-Maths</a
        >
        <%}%>
      </div>
    </div>
  </div>
</div>
