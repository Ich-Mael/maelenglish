<% layout('layouts/main') %>

<style>
  :root {
    --primary-color: #5d06ba;
    --primary-light: #f3e5f5;
    --primary-dark: #2d0370;
    --text-dark: #1d1d1f;
    --text-muted: #6e6e73;
    --border-color: #e5e5e5;
    --card-bg: #ffffff;
    --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --shadow-md: 0 10px 30px rgba(0, 0, 0, 0.1);
    --radius-md: 16px;
    font-family: 'Outfit', sans-serif;
  }
  
  body {
    background-color: #f8f9fa;
    font-family: var(--font-family);
  }

  .page-header {
    background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
    color: white;
    padding: 7rem 0 5rem 0;
    margin-bottom: -3rem;
    position: relative;
    z-index: 1;
  }

  .breadcrumb-item a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-weight: 500;
  }
  
  .breadcrumb-item.active {
    color: rgba(255, 255, 255, 0.9);
  }
  
  .breadcrumb-item + .breadcrumb-item::before {
    color: rgba(255, 255, 255, 0.5);
  }

  .page-title {
    font-size: 2.2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    font-size: 1.1rem;
    opacity: 0.9;
    font-weight: 300;
  }

  .content-wrapper {
    position: relative;
    z-index: 2;
    padding-bottom: 3rem;
  }
  
  .resource-details-card {
    background: white;
    border-radius: var(--radius-md);
    padding: 2.5rem;
    box-shadow: var(--shadow-sm);
    margin-bottom: 2rem;
  }
  
  .resource-meta-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    background-color: #f3f4f6;
    color: var(--text-muted);
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    margin-right: 0.5rem;
    margin-bottom: 0.5rem;
  }
  
  .resource-type-badge {
    background-color: var(--primary-light);
    color: var(--primary-color);
  }
  
  .resource-description {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text-dark);
    margin: 2rem 0;
    padding: 2rem;
    background-color: #fcfcfc;
    border-radius: 12px;
    border: 1px solid #f0f0f0;
  }

  .resource-description h1,
  .resource-description h2,
  .resource-description h3 {
    margin-top: 1.5rem;
    font-weight: 700;
  }
  
  .resource-description ul,
  .resource-description ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .icon-box {
    width: 64px;
    height: 64px;
    background-color: var(--primary-light);
    color: var(--primary-color);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }
  
  .btn-open-resource {
    background: linear-gradient(135deg, #5d06ba 0%, #4a0496 100%);
    color: white;
    border: none;
    padding: 1rem 2rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    transition: all 0.3s;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(93, 6, 186, 0.2);
  }
  
  .btn-open-resource:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(93, 6, 186, 0.3);
    color: white;
  }
</style>

<!-- Header -->
<div class="page-header">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-3">
        <li class="breadcrumb-item"><a href="/maelenglish/instructor/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="/maelenglish/instructor/courses">My Courses</a></li>
        <li class="breadcrumb-item"><a href="/maelenglish/instructor/courses/<%= resource.courseId ? resource.courseId._id : '' %>">Course</a></li>
        <li class="breadcrumb-item"><a href="/maelenglish/instructor/resources/module/<%= resource.moduleId ? resource.moduleId._id : '' %>">Resources</a></li>
        <li class="breadcrumb-item active" aria-current="page">View Resource</li>
      </ol>
    </nav>
    <h1 class="page-title w-75">
      <%= resource.title %>
    </h1>
  </div>
</div>

<div class="container content-wrapper">
  
  <div class="row">
    <div class="col-lg-10 mx-auto">
      <div class="resource-details-card">
        
        <div class="d-flex flex-wrap align-items-center mb-4">
          <div class="resource-meta-badge resource-type-badge">
            <i class="bi bi-tag-fill me-2"></i> <%= resource.type %>
          </div>
          <div class="resource-meta-badge">
            <i class="bi bi-calendar3 me-2"></i> Created: <%= new Date(resource.createdAt).toLocaleDateString() %>
          </div>
          <div class="resource-meta-badge">
            <i class="bi bi-eye-fill me-2"></i> <%= resource.viewCount %> Views
          </div>
        </div>
        
        <div class="row mb-5">
          <div class="col-12">
            <h5 class="fw-bold text-dark mb-3">Instructions / Description</h5>
            <!-- Render Rich Text Description -->
            <div class="resource-description">
              <%- resource.description %>
            </div>
          </div>
        </div>
        
        <div class="d-flex justify-content-center pt-3 border-top">
          <a href="<%= resource.link %>" target="_blank" class="btn-open-resource" id="openResourceBtn">
            <i class="bi bi-box-arrow-up-right"></i> Open Resource Material
          </a>
        </div>
        
      </div>
      
      <div class="text-center">
        <a href="/maelenglish/instructor/resources/module/<%= resource.moduleId ? resource.moduleId._id : '' %>" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-left me-2"></i> Back to Resource List
        </a>
      </div>
    </div>
  </div>

</div>

<!-- Auto-track view if needed via script, though backend handles it on load. 
     Maybe track click on 'Open Resource' if that's what counts as a view? 
     The backend route for this page already increments view count.
-->
<script>
  // Optional: Track outbound click if we want to distinguish between "Viewed Page" and "Opened Link"
  document.getElementById('openResourceBtn').addEventListener('click', function() {
    // Analytics logic could go here
    console.log('Resource link opened');
  });
</script>
