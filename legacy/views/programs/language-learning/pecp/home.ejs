<% layout('layouts/main') %>
<%# MaelEnglish Coaching (ex English Coaching Boost / PECP). Styles: /assets/css/maelenglish.css %>
<% headContent = `
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800;900&display=swap" rel="stylesheet">
  <link href="/assets/css/maelenglish.css" rel="stylesheet">
` %>
<%
  const wa = (msg) => 'https://wa.me/22667323131?text=' + encodeURIComponent(msg);
  const audiences = [
    { icon: 'briefcase', title: 'Cadres et managers', text: 'Animer une réunion, présenter des résultats, piloter une équipe ou des partenaires anglophones.' },
    { icon: 'person-badge', title: 'Candidats', text: 'Préparer un entretien en anglais, un CV et une lettre de motivation, une prise de poste à l’international.' },
    { icon: 'building', title: 'Professions spécialisées', text: 'Santé, finance, tech, juridique, ONG : le vocabulaire et les situations propres à votre secteur.' },
    { icon: 'mic', title: 'Prise de parole', text: 'Conférences, pitchs, formations à animer : gagner en aisance et en clarté à l’oral.' }
  ];
  const faq = [
    { q: 'Quel niveau faut-il pour commencer ?', a: 'Aucun niveau minimum. Le diagnostic de départ sert justement à construire un programme adapté, du débutant qui veut oser parler au cadre qui veut perfectionner son anglais professionnel.' },
    { q: 'Les séances se font en ligne ?', a: 'Oui, 100 % en ligne, en visioconférence : vous suivez votre coaching depuis votre ordinateur ou votre téléphone, où que vous soyez et selon votre emploi du temps.' },
    { q: 'Combien de temps dure un coaching ?', a: 'Cela dépend de votre objectif et de votre échéance (un entretien dans deux semaines ou une progression sur plusieurs mois). Le rythme et la durée sont fixés ensemble après le diagnostic.' },
    { q: 'Quel est le tarif ?', a: 'Le tarif dépend de la formule choisie (nombre et fréquence des séances). Écrivez-nous sur WhatsApp : un conseiller vous envoie une proposition adaptée.' },
    { q: 'Mon entreprise peut-elle prendre en charge le coaching ?', a: 'Oui. Nous établissons un devis et un programme pour l’entreprise, pour un collaborateur ou pour une équipe.' }
  ];
%>

<div class="me-page">

  <!-- Hero -->
  <section class="me-hero">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-7">
          <span class="me-pill">MaelEnglish Coaching</span>
          <h1 style="margin-top:18px">Un coach. Votre métier. <em>Vos objectifs.</em></h1>
          <p class="me-hero__lead">
            Un accompagnement individuel en anglais professionnel, construit autour de votre poste,
            de votre secteur et de vos échéances. Vous travaillez exactement ce dont vous avez besoin,
            au rythme qui vous convient.
          </p>
          <div class="me-hero__cta">
            <a href="<%= wa('Bonjour, je souhaite un coaching MaelEnglish. Mon métier et mon objectif : ') %>" target="_blank" rel="noopener" class="me-btn me-btn--coral me-btn--wa">
              <i class="bi bi-whatsapp"></i> Demander mon diagnostic
            </a>
            <a href="#deroulement" class="me-btn me-btn--outline">Comment ça marche <i class="bi bi-arrow-down"></i></a>
          </div>
          <div class="me-hero__proof">
            <span><i class="bi bi-person-check-fill"></i> 100 % personnalisé</span>
            <span><i class="bi bi-calendar-check"></i> Horaires flexibles</span>
            <span><i class="bi bi-camera-video"></i> 100 % en ligne</span>
          </div>
        </div>
        <div class="col-lg-5">
          <div class="me-chat" aria-label="Exemples d'objectifs de coaching">
            <div class="me-chat__card">
              <div class="me-chat__role"><i class="bi bi-person-badge"></i> Entretien</div>
              <p class="me-chat__en" lang="en">“Tell me about a challenge you overcame.”</p>
              <p class="me-chat__fr">Parlez-moi d’une difficulté que vous avez surmontée.</p>
            </div>
            <div class="me-chat__card">
              <div class="me-chat__role"><i class="bi bi-easel"></i> Présentation</div>
              <p class="me-chat__en" lang="en">“Let me walk you through our proposal.”</p>
              <p class="me-chat__fr">Laissez-moi vous présenter notre proposition.</p>
            </div>
            <div class="me-chat__card">
              <div class="me-chat__role"><i class="bi bi-people"></i> Négociation</div>
              <p class="me-chat__en" lang="en">“We could meet halfway on the price.”</p>
              <p class="me-chat__fr">Nous pourrions trouver un compromis sur le prix.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- For whom -->
  <section class="me-section">
    <div class="container">
      <div class="me-head">
        <span class="me-pill">Pour qui ?</span>
        <h2>Pour celles et ceux dont l’anglais est un enjeu professionnel</h2>
      </div>
      <div class="me-jobs me-jobs--2">
        <% audiences.forEach(function (a) { %>
          <article class="me-job">
            <div class="me-job__icon"><i class="bi bi-<%= a.icon %>"></i></div>
            <h3><%= a.title %></h3>
            <p style="color:var(--me-muted);margin:0"><%= a.text %></p>
          </article>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="me-section me-section--tint" id="deroulement">
    <div class="container">
      <div class="me-head">
        <span class="me-pill">Le déroulement</span>
        <h2>Quatre étapes, un programme sur mesure</h2>
      </div>
      <div class="me-steps">
        <div class="me-step">
          <div class="me-step__num"></div>
          <h3>Diagnostic</h3>
          <p>Un premier échange pour évaluer votre niveau et comprendre votre métier et votre objectif.</p>
        </div>
        <div class="me-step">
          <div class="me-step__num"></div>
          <h3>Programme sur mesure</h3>
          <p>Un plan de séances construit autour de vos situations réelles et de votre échéance.</p>
        </div>
        <div class="me-step">
          <div class="me-step__num"></div>
          <h3>Séances avec votre coach</h3>
          <p>Mises en situation, corrections immédiates, exercices ciblés entre les séances.</p>
        </div>
        <div class="me-step">
          <div class="me-step__num"></div>
          <h3>Suivi et bilan</h3>
          <p>Un point régulier sur vos progrès et un bilan final avec des recommandations.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="me-section" id="faq">
    <div class="container">
      <div class="me-head">
        <span class="me-pill">Questions fréquentes</span>
        <h2>Tout ce qu’il faut savoir</h2>
      </div>
      <div class="me-faq">
        <% faq.forEach(function (f, i) { %>
          <details <%= i === 0 ? 'open' : '' %>>
            <summary><%= f.q %></summary>
            <p><%= f.a %></p>
          </details>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="me-cta">
    <div class="container">
      <div class="me-cta__box">
        <div>
          <picture>
            <source srcset="/assets/img/Maelenglish/maelenglish-logo-light.webp" type="image/webp">
            <img src="/assets/img/Maelenglish/maelenglish-logo-light.png" alt="MaelEnglish — Speak the Language of Your Profession" loading="lazy" width="800" height="267">
          </picture>
          <h2>Parlons de votre objectif</h2>
          <p>Indiquez-nous votre métier et votre échéance : nous vous proposons un diagnostic et une formule adaptée.</p>
        </div>
        <div class="me-cta__actions">
          <a href="<%= wa('Bonjour, je souhaite un coaching MaelEnglish. Mon métier et mon objectif : ') %>" target="_blank" rel="noopener" class="me-btn me-btn--coral me-btn--wa">
            <i class="bi bi-whatsapp"></i> Écrire sur WhatsApp
          </a>
          <a href="tel:+22667323131" class="me-btn me-btn--ghost"><i class="bi bi-telephone"></i> +226 67 32 31 31</a>
          <a href="/maelenglish" class="me-btn me-btn--ghost">Découvrir MaelEnglish</a>
        </div>
      </div>
    </div>
  </section>

</div>
