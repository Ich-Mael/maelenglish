<% layout('layouts/main') %>
<% headContent = `<style>
  .page-wrapper{margin-top:80px;padding:2rem 0 4rem}
  .page-header{background:linear-gradient(135deg,#5d06ba,#2d0370);color:#fff;padding:2rem;border-radius:16px;margin-bottom:2rem}
  .sub-card{background:#fff;border-radius:14px;box-shadow:0 2px 8px rgba(0,0,0,.06);padding:1.5rem;margin-bottom:1rem}
  .sub-meta{font-size:.82rem;color:#666;margin-bottom:.75rem}
  .sub-content{background:#f8f9fa;border-radius:8px;padding:.75rem 1rem;font-size:.9rem;margin-bottom:1rem;white-space:pre-wrap}
</style>` %>
<div class="page-wrapper">
  <div class="container" style="max-width:900px">
    <div class="page-header">
      <h1 style="margin:0;font-size:1.6rem;font-weight:800;">📝 File de correction — <%= course.title %></h1>
    </div>
    <%- include('../../../../partials/flash') %>
    <% if (submissions.length === 0) { %>
      <div class="sub-card text-center text-muted py-4"><p class="fs-2 mb-2">✅</p><p>Aucun devoir en attente de correction.</p></div>
    <% } else { %>
      <p class="text-muted mb-3"><strong><%= submissions.length %></strong> devoir(s) à corriger</p>
      <% submissions.forEach(sub => { %>
        <div class="sub-card">
          <div class="sub-meta">
            <strong><%= sub.userId.surname %> <%= sub.userId.name %></strong> (@<%= sub.userId.username %>) ·
            <%= sub.assignmentType === 'final_project' ? 'Projet final' : 'Devoir' %>
            <% if (sub.moduleId) { %> · Module : <%= sub.moduleId.title %><% } %> ·
            Soumis le <%= new Date(sub.createdAt).toLocaleDateString('fr-FR') %>
          </div>
          <div class="sub-content"><%= sub.content %></div>
          <form action="/maelenglish/cours/admindashboard/<%= course._id %>/grading/<%= sub._id %>/grade" method="POST" class="d-flex gap-2 flex-wrap align-items-end">
            <div>
              <label class="form-label mb-0 small fw-semibold">Note (/<%= sub.maxScore %>) <span class="text-muted fw-normal">optionnel</span></label>
              <input type="number" name="grade" class="form-control form-control-sm" min="0" max="<%= sub.maxScore %>" style="width:90px">
            </div>
            <div class="flex-grow-1">
              <label class="form-label mb-0 small fw-semibold">Feedback</label>
              <input type="text" name="feedback" class="form-control form-control-sm" placeholder="Commentaire pour l'étudiant">
            </div>
            <button type="submit" name="action" value="approve" class="btn btn-success btn-sm px-3"><i class="bi bi-check-lg"></i> Valider</button>
            <button type="submit" name="action" value="return" formnovalidate class="btn btn-outline-danger btn-sm px-3"><i class="bi bi-arrow-counterclockwise"></i> À refaire</button>
          </form>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>
