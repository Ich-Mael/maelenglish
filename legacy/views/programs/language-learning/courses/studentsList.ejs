<% layout('layouts/main') %>

<style>
  :root {
    --primary-color: #5d06ba;
    --primary-light: #f3e5f5;
    --primary-dark: #2d0370;
    --text-dark: #1d1d1f;
    --text-muted: #6e6e73;
    --border-color: #e5e5e5;
    --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --shadow-md: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  body {
    background-color: #f8f9fa;
    font-family: 'Outfit', sans-serif;
  }

  .admin-container {
    padding-top: 100px;
    padding-bottom: 50px;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Premium Header */
  .page-header {
    background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
    color: white;
    padding: 3rem 2.5rem;
    border-radius: 24px;
    margin-bottom: 2.5rem;
    box-shadow: 0 20px 40px rgba(93, 6, 186, 0.2);
    position: relative;
    overflow: hidden;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .page-header::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.1) 0%, transparent 20%);
    pointer-events: none;
  }

  .header-content {
      position: relative;
      z-index: 1;
  }

  .header-content h1 {
    font-size: 2.2rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.5px;
  }

  .header-content p {
    font-size: 1.1rem;
    opacity: 0.9;
    font-weight: 300;
    margin: 0;
  }

  .btn-add-student {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    color: white;
    padding: 0.8rem 1.5rem;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    border: 1px solid rgba(255, 255, 255, 0.3);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
    z-index: 1;
  }

  .btn-add-student:hover {
    background: white;
    color: var(--primary-color);
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.15);
  }

  /* Stats Row */
  .stats-row {
      margin-bottom: 2rem;
  }

  .stats-card {
    background: white;
    border-radius: 20px;
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 100%;
    border: 1px solid rgba(0,0,0,0.03);
    transition: transform 0.3s ease;
  }

  .stats-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-md);
  }

  .stats-icon {
    width: 60px;
    height: 60px;
    background: var(--primary-light);
    color: var(--primary-color);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
  }

  .stats-info h3 {
    margin: 0;
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.2;
  }

  .stats-info p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* Table Style */
  .table-card {
    background: white;
    border-radius: 24px;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    border: none;
  }

  .table-header-controls {
    padding: 2rem;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: white;
  }
  
  .table-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-dark);
      display: flex;
      align-items: center;
      gap: 10px;
  }

  .search-wrapper {
    position: relative;
    width: 350px;
  }

  .search-wrapper i {
    position: absolute;
    left: 1.2rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--primary-color);
  }

  .search-input {
    width: 100%;
    padding: 0.8rem 1rem 0.8rem 3rem;
    border: 2px solid #f0f0f0;
    border-radius: 50px;
    outline: none;
    transition: all 0.3s ease;
    font-size: 0.95rem;
    background: #fcfcfc;
  }

  .search-input:focus {
    border-color: var(--primary-color);
    background: white;
    box-shadow: 0 4px 12px rgba(93, 6, 186, 0.05);
  }

  .table {
    margin: 0;
  }

  .table th {
    background: #fafafa;
    padding: 1.25rem 2rem;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-muted);
    letter-spacing: 1px;
    border-bottom: 2px solid var(--border-color);
  }

  .table td {
    padding: 1.5rem 2rem;
    vertical-align: middle;
    border-bottom: 1px solid #f0f0f0;
    font-size: 0.95rem;
  }

  .table tbody tr {
    transition: background-color 0.2s;
  }

  .table tbody tr:hover {
    background-color: #fcfaff;
  }

  .student-profile {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .student-avatar {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
  }

  .student-name {
    font-weight: 700;
    color: var(--text-dark);
    display: block;
    margin-bottom: 2px;
  }

  .student-username {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .contact-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
  }
  
  .contact-email {
      font-weight: 500;
      color: var(--text-dark);
  }

  .badge-level {
    background: var(--primary-light);
    color: var(--primary-color);
    padding: 6px 14px;
    border-radius: 30px;
    font-size: 0.8rem;
    font-weight: 700;
    display: inline-block;
  }

  .date-block {
      background: #f8f9fa;
      padding: 6px 12px;
      border-radius: 8px;
      display: inline-block;
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--text-dark);
      border: 1px solid #eee;
  }
  
  .date-label {
      font-size: 0.75rem;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-left: 4px;
      font-weight: 600;
  }

  .action-btn {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    background: white;
    border: 1px solid var(--border-color);
    transition: all 0.2s ease;
    margin-left: 6px;
    text-decoration: none;
  }

  .action-btn:hover {
    background: var(--primary-color);
    color: white;
    border-color: var(--primary-color);
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(93, 6, 186, 0.2);
  }
  
  .action-btn.whatsapp {
      color: #25D366;
      border-color: #25D36630;
      background: #25D36610;
  }
  
  .action-btn.whatsapp:hover {
      background: #25D366;
      border-color: #25D366;
      color: white;
  }
  
  /* Empty State */
  .empty-state {
      padding: 4rem 2rem;
      text-align: center;
  }
  
  .empty-icon {
      font-size: 4rem;
      color: #e0e0e0;
      margin-bottom: 1.5rem;
      display: block;
  }

  @media (max-width: 992px) {
    .header-content h1 { font-size: 1.8rem; }
  }

  @media (max-width: 768px) {
    .page-header {
      padding: 2rem;
      flex-direction: column;
      align-items: flex-start;
      border-radius: 20px;
    }
    
    .btn-add-student {
        width: 100%;
        justify-content: center;
    }
    
    .table-header-controls {
        flex-direction: column;
        gap: 1.5rem;
    }
    
    .search-wrapper {
        width: 100%;
    }
  }
</style>

<div class="container admin-container">
  <!-- Header -->
  <div class="page-header">
    <div class="header-content">
      <h1>Gestion des Étudiants</h1>
      <p>
        <span style="opacity: 0.7;">Cours :</span> 
        <strong><%= course.title %></strong>
      </p>
    </div>
    <a href="/maelenglish/cours/admindashboard/<%= course._id %>/addStudent" class="btn-add-student">
      <i class="bi bi-person-plus-fill"></i>
      Ajouter un étudiant
    </a>
  </div>

  <!-- Stats Row -->
  <div class="row stats-row">
    <div class="col-md-4 col-sm-6 mb-3 mb-md-0">
      <div class="stats-card">
        <div class="stats-icon">
          <i class="bi bi-people-fill"></i>
        </div>
        <div class="stats-info">
          <h3><%= course.students.length %></h3>
          <p>Au Total</p>
        </div>
      </div>
    </div>
    <!-- Possible extra stats can be added here -->
  </div>

  <!-- Table Card -->
  <div class="table-card">
    <div class="table-header-controls">
      <div class="table-title">
          <i class="bi bi-list-check text-primary"></i> 
          Liste des Inscrits
      </div>
      <div class="search-wrapper">
        <i class="bi bi-search"></i>
        <input type="text" id="studentSearch" class="search-input" placeholder="Rechercher par nom, email...">
      </div>
    </div>

    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" style="width: 60px; padding-left: 2.5rem;">#</th>
            <th scope="col">Profil Étudiant</th>
            <th scope="col">Coordonnées</th>
            <th scope="col">Niveau</th>
            <th scope="col">Date d'Expiration</th>
            <th scope="col" class="text-end" style="padding-right: 2.5rem;">Actions</th>
          </tr>
        </thead>
        <tbody id="studentsTableBody">
          <% course.students.forEach((student, index) => { 
                // Determine enrollment dates for this specific course
                let enrollmentInfo = { start: null, end: null };
                if (student.specialProgram && student.specialProgram.length > 0) {
                    const program = student.specialProgram.find(p => p.courseTitle === course.title) || student.specialProgram[student.specialProgram.length - 1]; // Fallback to last
                    if (program) {
                        enrollmentInfo.start = new Date(program.startDate).toLocaleDateString('fr-FR', {day: '2-digit', month: '2-digit', year: 'numeric'});
                        enrollmentInfo.end = new Date(program.endDate).toLocaleDateString('fr-FR', {day: '2-digit', month: '2-digit', year: 'numeric'});
                        
                        enrollmentInfo.start = new Date(program.startDate).toLocaleDateString('fr-FR', {day: '2-digit', month: '2-digit', year: 'numeric'});
                        enrollmentInfo.end = new Date(program.endDate).toLocaleDateString('fr-FR', {day: '2-digit', month: '2-digit', year: 'numeric'});
                        enrollmentInfo.daysLeft = Math.ceil((new Date(program.endDate) - new Date()) / (1000 * 60 * 60 * 24));
                        enrollmentInfo.isExpired = new Date(program.endDate) < new Date();
                        
                        // ISO strings for input fields
                        enrollmentInfo.startISO = new Date(program.startDate).toISOString().split('T')[0];
                        enrollmentInfo.endISO = new Date(program.endDate).toISOString().split('T')[0];
                    }
                }
          %>
          <tr>
            <td style="padding-left: 2.5rem; color: var(--text-muted); font-weight: 600;"><%= index + 1 %></td>
            <td>
              <div class="student-profile">
                <img src="<%= student.imageUrl || 'https://www.kindpng.com/picc/m/105-1055656_account-user-profile-avatar-avatar-user-profile-icon.png' %>" 
                     alt="<%= student.name %>" class="student-avatar">
                <div class="student-info">
                  <span class="student-name"><%= student.surname %> <%= student.name %></span>
                  <span class="student-username">@<%= student.username %></span>
                </div>
              </div>
            </td>
            <td>
              <div class="contact-info">
                <span class="contact-email"><%= student.email %></span>
                <% if(student.phoneNumber) { %>
                    <small class="text-muted"><i class="bi bi-telephone-fill me-1" style="font-size: 0.7rem;"></i><%= student.phoneNumber %></small>
                <% } %>
              </div>
            </td>
            <td>
              <% if(student.englishLevel) { %>
                <span class="badge-level"><%= student.englishLevel %></span>
              <% } else { %>
                <span class="badge bg-light text-muted border">Non évalué</span>
              <% } %>
            </td>
            <td>
                <% if(enrollmentInfo.end) { %>
                    <div class="d-flex flex-column gap-1">
                        <% if(enrollmentInfo.isExpired) { %>
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-20" style="width: fit-content;">Expiré</span>
                            <span class="text-danger small fw-bold"><%= enrollmentInfo.end %></span>
                        <% } else { %>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-20" style="width: fit-content;">Actif (<%= enrollmentInfo.daysLeft %> j)</span>
                            <span class="text-dark small fw-bold"><%= enrollmentInfo.end %></span>
                        <% } %>
                    </div>
                <% } else { %>
                    <span class="text-muted small">Non défini</span>
                <% } %>
            </td>
            <td class="text-end" style="padding-right: 2.5rem;">
              <div class="d-flex justify-content-end">
                  <% if(student.whatsAppLink) { %>
                    <a href="<%= student.whatsAppLink %>" target="_blank" class="action-btn whatsapp" title="WhatsApp Direct">
                        <i class="bi bi-whatsapp"></i>
                    </a>
                  <% } %>
                  <a href="/admin/users/<%= student._id %>/edit" class="action-btn" title="Voir/Modifier Profil">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <button type="button" 
                          class="action-btn" 
                          title="Modifier l'accès"
                          data-bs-toggle="modal" 
                          data-bs-target="#editAccessModal"
                          data-student-id="<%= student._id %>"
                          data-student-name="<%= student.name %> <%= student.surname %>"
                          data-start-date="<%= enrollmentInfo.startISO || '' %>"
                          data-end-date="<%= enrollmentInfo.endISO || '' %>">
                    <i class="bi bi-calendar-event"></i>
                  </button>
              </div>
            </td>
          </tr>
          <% }) %>
          
          <% if(course.students.length === 0) { %>
            <tr>
                <td colspan="6">
                    <div class="empty-state">
                        <i class="bi bi-people empty-icon"></i>
                        <h4 class="text-dark fw-bold">Aucun étudiant inscrit</h4>
                        <p class="text-muted mb-0">Utilisez le bouton "Ajouter un étudiant" pour inscrire des apprenants à ce cours.</p>
                    </div>
                </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Edit Access Modal -->
<div class="modal fade" id="editAccessModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold text-dark">Modifier l'accès</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body pt-4">
        <form id="editAccessForm" method="POST">
          <div class="mb-3">
            <label for="startDate" class="form-label text-muted fw-bold small text-uppercase">Date de début</label>
            <input type="date" class="form-control form-control-lg" id="startDate" name="startDate" required style="border-radius: 12px; font-size: 0.95rem;">
          </div>
          <div class="mb-4">
            <label for="endDate" class="form-label text-muted fw-bold small text-uppercase">Date de fin</label>
            <input type="date" class="form-control form-control-lg" id="endDate" name="endDate" required style="border-radius: 12px; font-size: 0.95rem;">
            
            <div class="mt-2 d-flex gap-2 justify-content-end flex-wrap">
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill extend-btn" data-months="3">
                    +3 Mois
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill extend-btn" data-months="6">
                    +6 Mois
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill extend-btn" data-months="12">
                    +1 An
                </button>
            </div>
          </div>
          <div class="d-grid">
            <button type="submit" class="btn btn-primary btn-lg" style="border-radius: 50px; background: var(--primary-color); border: none;">
                Enregistrer les modifications
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Simple Client-Side Search
    const studentSearch = document.getElementById('studentSearch');
    if (studentSearch) {
      studentSearch.addEventListener('keyup', function() {
        const searchValue = this.value.toLowerCase();
        const rows = document.querySelectorAll('#studentsTableBody tr');

        rows.forEach(row => {
          const text = row.innerText.toLowerCase();
          if (text.includes(searchValue)) {
            row.style.display = '';
          } else {
            row.style.display = 'none';
          }
        });
      });
    }

    // Access Modal Handling
    const editAccessModal = document.getElementById('editAccessModal');
    if (editAccessModal) {
      editAccessModal.addEventListener('show.bs.modal', event => {
        // Button that triggered the modal
        const button = event.relatedTarget;
        
        // Extract info from data-bs-* attributes
        const studentId = button.getAttribute('data-student-id');
        const studentName = button.getAttribute('data-student-name');
        const startDate = button.getAttribute('data-start-date');
        const endDate = button.getAttribute('data-end-date');
        
        // Update the modal's content.
        const modalTitle = editAccessModal.querySelector('.modal-title');
        const modalBodyInputStart = editAccessModal.querySelector('#startDate');
        const modalBodyInputEnd = editAccessModal.querySelector('#endDate');
        const form = editAccessModal.querySelector('#editAccessForm');
        
        modalTitle.textContent = `Modifier l'accès pour ${studentName}`;
        modalBodyInputStart.value = startDate;
        modalBodyInputEnd.value = endDate;
        
        // Update form action
        form.action = `/maelenglish/cours/admindashboard/<%= course._id %>/students/${studentId}/access`;
      });
    }

    // Quick Extension Buttons Logic
    document.querySelectorAll('.extend-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const endDateInput = document.getElementById('endDate');
            const monthsToAdd = parseInt(this.getAttribute('data-months'));
            
            let baseDate = new Date();
            if (endDateInput.value) {
                const currentEnd = new Date(endDateInput.value);
                // If current end date is in the future, add to it. 
                // If it's in the past (expired), add to TODAY.
                if (currentEnd > new Date()) {
                    baseDate = currentEnd;
                }
            }
            
            // Add months
            baseDate.setMonth(baseDate.getMonth() + monthsToAdd);
            
            // Format to YYYY-MM-DD
            const newDateISO = baseDate.toISOString().split('T')[0];
            endDateInput.value = newDateISO;
        });
    });
  });
</script>