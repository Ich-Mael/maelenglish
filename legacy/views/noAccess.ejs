<% layout('layouts/main') %>
<%
  const code = typeof statusCode !== 'undefined' ? statusCode : 500;
  const isAuthError = code === 401 || code === 403;
  const isNotFound  = code === 404;
  const icon        = isAuthError ? 'bi-shield-lock-fill text-danger'
                    : isNotFound  ? 'bi-search text-secondary'
                    :               'bi-exclamation-triangle-fill text-warning';
  const title       = isAuthError ? 'Accès Refusé'
                    : isNotFound  ? 'Page introuvable'
                    :               'Une erreur est survenue';
  const subtitle    = isAuthError ? 'Vous n\'avez pas les permissions nécessaires pour accéder à cette page.'
                    : isNotFound  ? 'La page que vous cherchez n\'existe pas ou a été déplacée.'
                    :               'Quelque chose s\'est mal passé. Réessayez ou contactez l\'administrateur.';
%>

<div class="container d-flex flex-column align-items-center justify-content-center" style="min-height: 70vh; margin-top: 100px;">
    <div class="text-center p-5 shadow-lg bg-white" style="border-radius: 24px; max-width: 600px; border: 1px solid #eee;">
        <div class="mb-4">
            <i class="bi <%= icon %>" style="font-size: 5rem;"></i>
        </div>
        <h1 class="fw-bold mb-3" style="color: #1d1d1f;"><%= code %> — <%= title %></h1>
        <p class="text-muted mb-4 fs-5"><%= subtitle %></p>
        <% if (typeof message !== 'undefined' && message && !isAuthError && !isNotFound) { %>
        <p class="text-muted small mb-4" style="font-family:monospace;background:#f8fafc;padding:.75rem 1rem;border-radius:8px;text-align:left;"><%= message %></p>
        <% } %>
        <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
            <a href="/" class="btn btn-primary btn-lg px-4 rounded-pill" style="background: #5d06ba; border: none;">
                Retour à l'accueil
            </a>
            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">
                Page précédente
            </a>
        </div>
    </div>
</div>
