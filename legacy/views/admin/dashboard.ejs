<% layout('layouts/main') %>

<% headContent = `<style>
  :root {
    --purple: #5d06ba;
    --purple-dark: #2d0370;
    --purple-light: #ede8f8;
    --teal: #0e7490;
    --teal-dark: #164e63;
    --teal-light: #e0f2f7;
  }

  .admin-wrap {
    margin-top: 80px;
    padding: 2rem 0 5rem;
    background: #f5f4f8;
    min-height: 100vh;
  }

  /* ── Header ── */
  .dash-header {
    background: linear-gradient(135deg, var(--purple) 0%, var(--purple-dark) 100%);
    color: #fff;
    border-radius: 20px;
    padding: 2.25rem 2rem;
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    box-shadow: 0 8px 32px rgba(93,6,186,.25);
  }
  .dash-header h1 { margin: 0; font-size: 1.9rem; font-weight: 800; display: flex; align-items: center; gap: .75rem; }
  .dash-header p  { margin: .3rem 0 0; opacity: .85; font-size: 1rem; }
  .dash-header-right { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
  .dash-pw-btn {
    display: inline-flex; align-items: center; gap: .4rem;
    background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.3);
    color: #fff; padding: .45rem 1rem; border-radius: 50px;
    font-size: .85rem; font-weight: 600; text-decoration: none;
    transition: background .2s, transform .2s;
  }
  .dash-pw-btn:hover { background: rgba(255,255,255,.3); color: #fff; transform: translateY(-1px); text-decoration: none; }
  .role-pill {
    background: rgba(255,255,255,.18);
    border: 1px solid rgba(255,255,255,.3);
    padding: .35rem 1rem;
    border-radius: 50px;
    font-size: .85rem;
    font-weight: 600;
    backdrop-filter: blur(8px);
    white-space: nowrap;
  }

  /* ── Stat cards ── */
  .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
  .stat-card {
    background: #fff;
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 2px 10px rgba(0,0,0,.06);
    border-left: 4px solid var(--purple);
    transition: transform .2s, box-shadow .2s;
  }
  .stat-card:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(0,0,0,.1); }
  .stat-card.c-red    { border-left-color: #ef4444; }
  .stat-card.c-blue   { border-left-color: #3b82f6; }
  .stat-card.c-green  { border-left-color: #22c55e; }
  .stat-card.c-teal   { border-left-color: var(--teal); }
  .stat-card.c-orange { border-left-color: #f59e0b; }
  .stat-num   { font-size: 2rem; font-weight: 800; color: var(--purple-dark); margin: 0; line-height: 1; }
  .stat-card.c-teal .stat-num { color: var(--teal-dark); }
  .stat-label { font-size: .8rem; color: #777; margin: .4rem 0 0; font-weight: 500; }

  /* ── Section headers ── */
  .section-header {
    display: flex;
    align-items: center;
    gap: .6rem;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--purple-dark);
    margin: 0 0 1rem;
  }
  .section-header .dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--purple);
    flex-shrink: 0;
  }
  .section-header.teal-theme { color: var(--teal-dark); }
  .section-header.teal-theme .dot { background: var(--teal); }

  /* ── Quick action cards ── */
  .action-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2.5rem; }
  .action-card {
    background: #fff;
    border-radius: 14px;
    padding: 1.25rem;
    box-shadow: 0 2px 10px rgba(0,0,0,.06);
    text-decoration: none;
    color: inherit;
    display: flex;
    align-items: center;
    gap: 1rem;
    border: 2px solid transparent;
    transition: all .2s;
  }
  .action-card:hover { border-color: var(--purple); box-shadow: 0 6px 20px rgba(93,6,186,.14); transform: translateY(-2px); color: inherit; text-decoration: none; }
  .action-icon {
    width: 46px; height: 46px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.3rem; color: #fff; flex-shrink: 0;
    background: linear-gradient(135deg, var(--purple) 0%, var(--purple-dark) 100%);
  }
  .action-icon.teal { background: linear-gradient(135deg, var(--teal) 0%, var(--teal-dark) 100%); }
  .action-title { font-weight: 700; font-size: .95rem; color: var(--purple-dark); margin: 0 0 .15rem; }
  .action-sub   { font-size: .78rem; color: #888; margin: 0; }

  /* ── Program section panels ── */
  .prog-section {
    background: #fff;
    border-radius: 18px;
    padding: 1.75rem;
    box-shadow: 0 2px 12px rgba(0,0,0,.06);
    margin-bottom: 2rem;
  }
  .prog-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin-top: 1.25rem; }
  .prog-card {
    border: 2px solid #f0edf8;
    border-radius: 14px;
    padding: 1.25rem;
    transition: all .2s;
  }
  .prog-card:hover { border-color: var(--purple); background: #faf8ff; }
  .prog-card.teal-card { border-color: #cce8ef; }
  .prog-card.teal-card:hover { border-color: var(--teal); background: #f0fbfe; }
  .prog-card-header {
    display: flex; align-items: center; gap: .75rem;
    margin-bottom: 1rem; padding-bottom: .75rem;
    border-bottom: 1px solid #f0f0f0;
  }
  .prog-icon {
    width: 40px; height: 40px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem; color: #fff; flex-shrink: 0;
    background: linear-gradient(135deg, var(--purple) 0%, var(--purple-dark) 100%);
  }
  .prog-icon.teal { background: linear-gradient(135deg, var(--teal) 0%, var(--teal-dark) 100%); }
  .prog-name { font-weight: 700; font-size: 1rem; color: var(--purple-dark); margin: 0; }
  .prog-name.teal { color: var(--teal-dark); }
  .prog-links { display: flex; flex-direction: column; gap: .4rem; }
  .prog-link {
    display: flex; align-items: center; gap: .5rem;
    color: var(--purple); text-decoration: none;
    font-size: .875rem; font-weight: 500;
    padding: .4rem .65rem;
    border-radius: 7px;
    transition: all .15s;
  }
  .prog-link:hover { background: var(--purple-light); color: var(--purple-dark); text-decoration: none; }
  .prog-link.teal-link { color: var(--teal); }
  .prog-link.teal-link:hover { background: var(--teal-light); color: var(--teal-dark); }

  /* ── Institution analytics table ── */
  .inst-table-wrap { margin-top: 1.25rem; overflow-x: auto; border-radius: 10px; border: 1px solid #e5e7eb; }
  .inst-table-wrap table { margin: 0; font-size: .875rem; }
  .inst-table-wrap thead th { background: #f0fbfe; color: var(--teal-dark); font-weight: 700; font-size: .75rem; text-transform: uppercase; letter-spacing: .04em; border-bottom: 2px solid #bae6fd; }
  .inst-count-pill { background: var(--teal-light); color: var(--teal-dark); padding: .15rem .6rem; border-radius: 20px; font-size: .8rem; font-weight: 600; }

  /* ── Mini bar chart ── */
  .mini-chart { display: flex; gap: .35rem; align-items: flex-end; height: 56px; margin-top: 1rem; padding: 0 .25rem; }
  .mini-bar {
    flex: 1;
    background: var(--teal);
    border-radius: 3px 3px 0 0;
    min-height: 4px;
    opacity: .65;
    transition: opacity .2s;
    cursor: default;
  }
  .mini-bar:hover { opacity: 1; }
  .chart-label { font-size: .72rem; color: #888; margin-top: .3rem; font-weight: 500; }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .dash-header { flex-direction: column; align-items: flex-start; }
    .dash-header h1 { font-size: 1.5rem; }
    .stats-row { grid-template-columns: 1fr 1fr; }
    .action-grid { grid-template-columns: 1fr 1fr; }
    .prog-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .stats-row { grid-template-columns: 1fr; }
    .action-grid { grid-template-columns: 1fr; }
  }
</style>` %>

<div class="admin-wrap">
  <div class="container">

    <!-- Header -->
    <div class="dash-header">
      <div>
        <h1><i class="bi bi-speedometer2"></i> Tableau de bord</h1>
        <p>Bienvenue, <strong><%= currentUser.name %> <%= currentUser.surname %></strong></p>
      </div>
      <div class="dash-header-right">
        <span class="role-pill">
          <i class="bi bi-shield-check me-1"></i>
          <%= currentUser.role === 'super-admin' ? 'Super Administrateur' : 'Administrateur' %>
        </span>
        <a href="/forgot-password" class="dash-pw-btn">
          <i class="bi bi-key-fill"></i> Changer le mot de passe
        </a>
      </div>
    </div>

    <%- include('../partials/flash') %>

    <!-- Stats row -->
    <div class="stats-row">
      <div class="stat-card">
        <p class="stat-num"><%= typeof stats !== 'undefined' ? stats.totalUsers : 0 %></p>
        <p class="stat-label">Total utilisateurs</p>
      </div>
      <div class="stat-card c-red">
        <p class="stat-num"><%= typeof stats !== 'undefined' ? stats.totalAdmins : 0 %></p>
        <p class="stat-label">Administrateurs</p>
      </div>
      <div class="stat-card c-blue">
        <p class="stat-num"><%= typeof stats !== 'undefined' ? stats.totalLearners : 0 %></p>
        <p class="stat-label">Apprenants</p>
      </div>
      <div class="stat-card c-green">
        <p class="stat-num"><%= typeof stats !== 'undefined' ? stats.verifiedUsers : 0 %></p>
        <p class="stat-label">Comptes vérifiés</p>
      </div>
      <div class="stat-card c-teal">
        <p class="stat-num"><%= typeof totalInstitutions !== 'undefined' ? totalInstitutions : 0 %></p>
        <p class="stat-label">Institutions actives</p>
      </div>
      <div class="stat-card c-orange">
        <p class="stat-num"><%= typeof totalInstitutionStudents !== 'undefined' ? totalInstitutionStudents : 0 %></p>
        <p class="stat-label">Étudiants institutions</p>
      </div>
    </div>

    <!-- Quick actions -->
    <div class="section-header"><span class="dot"></span>Actions rapides</div>
    <div class="action-grid" style="margin-bottom:2.5rem;">
      <a href="/admin/users/create" class="action-card">
        <div class="action-icon"><i class="bi bi-person-plus"></i></div>
        <div><p class="action-title">Créer un compte</p><p class="action-sub">Admin, apprenant, institution…</p></div>
      </a>
      <a href="/admin/users" class="action-card">
        <div class="action-icon"><i class="bi bi-people"></i></div>
        <div><p class="action-title">Gérer les utilisateurs</p><p class="action-sub">Voir, modifier, vérifier</p></div>
      </a>
      <a href="/admin/institutions/new" class="action-card">
        <div class="action-icon teal"><i class="bi bi-building-add"></i></div>
        <div><p class="action-title">Nouvelle institution</p><p class="action-sub">Créer un partenaire</p></div>
      </a>
      <a href="/admin/messages" class="action-card" style="position:relative;">
        <div class="action-icon" style="background:#fef3c7;color:#d97706;"><i class="bi bi-envelope"></i></div>
        <div>
          <p class="action-title">Messages visiteurs</p>
          <p class="action-sub">Boîte de réception</p>
        </div>
        <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
          <span style="position:absolute;top:12px;right:14px;background:#ef4444;color:#fff;font-size:.7rem;font-weight:800;min-width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;padding:0 4px;"><%= unreadMessages %></span>
        <% } %>
      </a>
    </div>

    <!-- ── AfroHK Programs ── -->
    <div class="prog-section">
      <div class="section-header"><span class="dot"></span>Programmes AfroHK</div>
      <div class="prog-grid">

        <!-- E-Kalan -->
        <div class="prog-card">
          <div class="prog-card-header">
            <div class="prog-icon"><i class="bi bi-mortarboard"></i></div>
            <h3 class="prog-name">E-Kalan</h3>
          </div>
          <div class="prog-links">
            <a href="/programs/ekalan/kalan/admindashboard/kalan/series_and_classes" class="prog-link"><i class="bi bi-book"></i> Classes et séries</a>
            <a href="/programs/ekalan/kalan/admindashboard/kalan/students" class="prog-link"><i class="bi bi-people"></i> Étudiants</a>
            <a href="/programs/ekalan/kalan/admindashboard/kalan/premium-requests" class="prog-link"><i class="bi bi-star"></i> Demandes premium</a>
            <a href="/programs/ekalan/kalan/admindashboard/kalan/maths-lab" class="prog-link"><i class="bi bi-calculator"></i> Kalan Maths Lab</a>
          </div>
        </div>

        <!-- Language Learning -->
        <div class="prog-card">
          <div class="prog-card-header">
            <div class="prog-icon"><i class="bi bi-translate"></i></div>
            <h3 class="prog-name">MaelEnglish</h3>
          </div>
          <div class="prog-links">
            <a href="/maelenglish/cours/admindashboard" class="prog-link"><i class="bi bi-list-ul"></i> Cours</a>
            <a href="/maelenglish/cours/admindashboard/new" class="prog-link"><i class="bi bi-plus-circle"></i> Nouveau cours</a>
            <a href="/maelenglish/admin/instructors" class="prog-link"><i class="bi bi-person-badge"></i> Instructeurs</a>
            <a href="/maelenglish/coaching" class="prog-link"><i class="bi bi-person-lines-fill"></i> PECP</a>
          </div>
        </div>

      </div>
    </div>

    <!-- ── Institution Program ── -->
    <div class="prog-section" style="border-left: 4px solid var(--teal);">
      <div class="section-header teal-theme"><span class="dot"></span>Programme Institutions Partenaires</div>
      <p class="text-muted small mb-0" style="margin-top:-.5rem;margin-bottom:1rem;">Cours créés par AfroHK et déployés via les institutions partenaires.</p>

      <div class="prog-grid">

        <!-- Institutions -->
        <div class="prog-card teal-card">
          <div class="prog-card-header">
            <div class="prog-icon teal"><i class="bi bi-building"></i></div>
            <h3 class="prog-name teal">Institutions</h3>
          </div>
          <div class="prog-links">
            <a href="/admin/institutions" class="prog-link teal-link"><i class="bi bi-list-ul"></i> Toutes les institutions</a>
            <a href="/admin/institutions/new" class="prog-link teal-link"><i class="bi bi-plus-circle"></i> Créer une institution</a>
          </div>
        </div>

        <!-- Users / Students -->
        <div class="prog-card teal-card">
          <div class="prog-card-header">
            <div class="prog-icon teal"><i class="bi bi-person-vcard"></i></div>
            <h3 class="prog-name teal">Comptes</h3>
          </div>
          <div class="prog-links">
            <a href="/admin/users?role=institution-admin" class="prog-link teal-link"><i class="bi bi-shield-person"></i> Admins institutions</a>
            <a href="/admin/users/create" class="prog-link teal-link"><i class="bi bi-person-plus"></i> Créer un compte</a>
          </div>
        </div>

        <!-- Messages -->
        <div class="prog-card teal-card">
          <div class="prog-card-header">
            <div class="prog-icon teal"><i class="bi bi-envelope"></i></div>
            <h3 class="prog-name teal">
              Messages
              <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
                <span style="margin-left:.5rem;background:#ef4444;color:#fff;font-size:.65rem;font-weight:800;padding:.15rem .5rem;border-radius:50px;vertical-align:middle;"><%= unreadMessages %> non lu<%= unreadMessages > 1 ? 's' : '' %></span>
              <% } %>
            </h3>
          </div>
          <div class="prog-links">
            <a href="/admin/messages" class="prog-link teal-link"><i class="bi bi-inbox"></i> Boîte de réception</a>
          </div>
        </div>

      </div>

      <!-- Institution analytics -->
      <% if (typeof institutionStats !== 'undefined' && institutionStats.length > 0) { %>
      <div style="margin-top:1.75rem;padding-top:1.5rem;border-top:1px solid #e0f2f7;">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
          <span class="section-header teal-theme mb-0" style="font-size:1rem;"><span class="dot"></span>Activité des institutions</span>
          <span class="text-muted small"><%= totalInstitutions %> institution(s) · <%= totalInstitutionStudents %> étudiant(s)</span>
        </div>

        <div class="inst-table-wrap">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th>Institution</th>
                <th>Cours</th>
                <th>Étudiants</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% institutionStats.forEach(({ institution, studentCount, courseCount }) => { %>
                <tr>
                  <td class="fw-semibold"><%= institution.name %></td>
                  <td><%= courseCount %></td>
                  <td><span class="inst-count-pill"><%= studentCount %></span></td>
                  <td><a href="/admin/institutions/<%= institution._id %>" class="btn btn-sm btn-outline-primary py-0 px-2">Voir</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <% if (recentEnrollments && recentEnrollments.length > 0) { %>
          <div style="margin-top:1.25rem;">
            <p class="chart-label">Inscriptions — 6 derniers mois</p>
            <div class="mini-chart">
              <% const maxCount = Math.max(...recentEnrollments.map(e => e.count), 1); %>
              <% const monthNames = ['Jan','Fév','Mar','Avr','Mai','Jun','Jul','Aoû','Sep','Oct','Nov','Déc']; %>
              <% recentEnrollments.forEach(e => { %>
                <div style="display:flex;flex-direction:column;align-items:center;flex:1;gap:.25rem;">
                  <div class="mini-bar"
                       style="width:100%;height:<%= Math.round((e.count / maxCount) * 100) %>%;"
                       title="<%= monthNames[e._id.month - 1] %> <%= e._id.year %> : <%= e.count %>"></div>
                  <span style="font-size:.65rem;color:#aaa;"><%= monthNames[e._id.month - 1] %></span>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>
      <% } %>
    </div>

  </div>
</div>
