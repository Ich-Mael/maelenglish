<% if (success && success.length) { %>
<div class="flash-toast flash-success" role="alert">
  <span><%= success %></span>
  <button onclick="this.parentElement.remove()" aria-label="Fermer">×</button>
</div>
<% } %>

<% if (error && error.length) { %>
<div class="flash-toast flash-error" role="alert">
  <span><%= error %></span>
  <button onclick="this.parentElement.remove()" aria-label="Fermer">×</button>
</div>
<% } %>

<style>
.flash-toast {
  position: fixed;
  top: 84px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: .75rem 1.1rem .75rem 1.25rem;
  border-radius: 12px;
  font-size: .88rem;
  font-weight: 500;
  line-height: 1.45;
  min-width: 280px;
  max-width: min(580px, 92vw);
  box-shadow: 0 8px 30px rgba(0,0,0,.18), 0 2px 8px rgba(0,0,0,.1);
  animation: flashSlideIn .28s cubic-bezier(.22,.68,0,1.2) both;
}
.flash-success {
  background: #f0fdf4;
  color: #15803d;
  border: 1px solid #bbf7d0;
}
.flash-error {
  background: #fef2f2;
  color: #b91c1c;
  border: 1px solid #fecaca;
}
.flash-toast button {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 1.25rem;
  line-height: 1;
  padding: 0 .1rem;
  color: currentColor;
  opacity: .5;
  flex-shrink: 0;
  transition: opacity .15s;
}
.flash-toast button:hover { opacity: 1; }
@keyframes flashSlideIn {
  from { opacity: 0; transform: translateX(-50%) translateY(-10px); }
  to   { opacity: 1; transform: translateX(-50%) translateY(0); }
}
</style>

<script>
(function() {
  var toasts = document.querySelectorAll('.flash-toast');
  toasts.forEach(function(t) {
    setTimeout(function() {
      t.style.transition = 'opacity .4s';
      t.style.opacity = '0';
      setTimeout(function() { if (t.parentElement) t.parentElement.removeChild(t); }, 420);
    }, 5000);
  });
})();
</script>
