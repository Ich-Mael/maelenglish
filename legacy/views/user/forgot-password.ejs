<% layout('layouts/main') %>

<% headContent = `
  <style>
    .auth-container {
      max-width: 500px;
      margin: 4rem auto;
      padding: 2rem;
    }
    
    .auth-card {
      background: white;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      padding: 2.5rem;
      border-top: 5px solid #5d06ba;
    }
    
    .auth-title {
      color: var(--color-dark);
      margin-bottom: 1.5rem;
      text-align: center;
      font-weight: 700;
    }
    
    .auth-btn {
      width: 100%;
      padding: 0.8rem;
      font-weight: 600;
      margin-top: 1rem;
      background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
      border: none;
      color: white;
      transition: all 0.3s ease;
    }

    .auth-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(93, 6, 186, 0.3);
      color: white;
    }
    
    .form-label {
      font-weight: 500;
      color: #555;
    }
    
    .form-control {
      padding: 0.8rem;
      border-radius: var(--radius-sm);
    }
    
    .form-control:focus {
      border-color: #5d06ba;
      box-shadow: 0 0 0 0.25rem rgba(93, 6, 186, 0.1);
    }

    .auth-footer {
        text-align: center;
        margin-top: 1.5rem;
        font-size: 0.9rem;
    }

    .auth-footer a {
        color: #5d06ba;
        text-decoration: none;
        font-weight: 600;
    }

    .auth-footer a:hover {
        text-decoration: underline;
    }
  </style>
` %>

<div class="auth-container">
  <div class="auth-card" data-aos="fade-up">
    <h2 class="auth-title">Mot de passe oublié ?</h2>
    <p class="text-center text-muted mb-4">Entrez votre nom d’utilisateur, votre email ou votre numéro WhatsApp. Vous recevrez un code sur WhatsApp ou un lien par email.</p>
    
    <form action="/forgot-password" method="POST" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="identifier" class="form-label">Identifiant, email ou n° WhatsApp</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-person"></i></span>
            <input type="text" class="form-control" id="identifier" name="identifier" required autocomplete="username" placeholder="ex. awa.traore, nom@exemple.com ou 70 12 34 56">
        </div>
      </div>
      
      <button type="submit" class="btn auth-btn">Continuer</button>
    </form>
    
    <div class="auth-footer">
        <a href="/login"><i class="bi bi-arrow-left"></i> Retour à la connexion</a>
    </div>
  </div>
</div>
