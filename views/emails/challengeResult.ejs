<!DOCTYPE html>
<html lang="fr" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= subject %></title>
</head>
<body style="margin:0; padding:0; background-color:#f1eefb;">
    <div style="display:none; max-height:0; overflow:hidden; opacity:0;"><%= approved ? 'Point de contrôle validé — le jour suivant est débloqué.' : 'Votre coach vous demande de retravailler ce point de contrôle.' %></div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f1eefb;">
        <tr>
            <td align="center" style="padding:32px 16px;">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px; max-width:600px; background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 6px 24px rgba(76,29,149,0.10);">
                    <tr>
                        <td align="center" bgcolor="<%= approved ? '#1e7e34' : '#b45309' %>" style="background-color:<%= approved ? '#1e7e34' : '#b45309' %>; padding:32px 24px;">
                            <span style="display:inline-block; font-size:12px; font-weight:800; letter-spacing:1px; text-transform:uppercase; color:#ffffff; opacity:.85;">English Challenge</span>
                            <div style="font-size:22px; font-weight:800; color:#ffffff; margin-top:6px;">
                                <%= approved ? '✅ Point de contrôle validé !' : '🔁 Point de contrôle à refaire' %>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:32px 40px; font-family:Arial,sans-serif; color:#374151; font-size:15px; line-height:1.65;">
                            <p style="margin:0 0 14px;">Bonjour<%= user && user.name ? ' ' + user.name : '' %>,</p>
                            <% if (approved) { %>
                                <p style="margin:0 0 14px;">Bravo ! Votre coach a validé le point de contrôle de <strong><%= dayTitle %></strong> (<strong><%= courseTitle %></strong>). <strong>Le jour suivant est maintenant débloqué.</strong></p>
                            <% } else { %>
                                <p style="margin:0 0 14px;">Votre coach vous invite à retravailler le point de contrôle de <strong><%= dayTitle %></strong> (<strong><%= courseTitle %></strong>) avant de continuer.</p>
                            <% } %>
                            <% if (feedback && feedback.trim()) { %>
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 22px;">
                                    <tr><td style="background:#f7f4ff; border-left:4px solid #6d28d9; border-radius:8px; padding:14px 16px; font-size:14px; color:#4b3b73;"><strong>Remarque du coach :</strong><br><%= feedback %></td></tr>
                                </table>
                            <% } else { %>
                                <div style="height:8px;"></div>
                            <% } %>
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center" bgcolor="#6d28d9" style="background-color:#6d28d9; border-radius:999px;">
                                        <a href="<%= url %>" style="display:inline-block; padding:13px 30px; font-family:Arial,sans-serif; font-size:15px; font-weight:700; color:#ffffff; text-decoration:none; border-radius:999px;"><%= approved ? 'Continuer le défi' : 'Retravailler le jour' %></a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding:20px 40px 32px; font-family:Arial,sans-serif; color:#9ca3af; font-size:12px;">Afro House of Knowledge — English Boost</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
