<!DOCTYPE html>
<html lang="fr" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= subject %></title>
</head>
<body style="margin:0; padding:0; background-color:#f1eefb;">
    <div style="display:none; max-height:0; overflow:hidden; opacity:0;">Un élève attend la validation de son point de contrôle.</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f1eefb;">
        <tr>
            <td align="center" style="padding:32px 16px;">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px; max-width:600px; background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 6px 24px rgba(76,29,149,0.10);">
                    <tr>
                        <td align="center" bgcolor="#5b21b6" style="background-color:#5b21b6; background-image:linear-gradient(135deg,#6d28d9 0%,#4c1d95 100%); padding:32px 24px;">
                            <span style="display:inline-block; font-size:12px; font-weight:800; letter-spacing:1px; text-transform:uppercase; color:#e9d5ff;">MaelEnglish Challenge</span>
                            <div style="font-size:22px; font-weight:800; color:#ffffff; margin-top:6px;">Un point de contrôle à corriger</div>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:32px 40px; font-family:Arial,sans-serif; color:#374151; font-size:15px; line-height:1.65;">
                            <p style="margin:0 0 14px;">Bonjour<%= user && user.name ? ' ' + user.name : '' %>,</p>
                            <p style="margin:0 0 14px;">
                                <strong><%= studentName %></strong> vient de soumettre le point de contrôle de
                                <strong><%= dayTitle %></strong> dans le défi <strong><%= courseTitle %></strong>.
                            </p>
                            <p style="margin:0 0 24px;">Sa progression est en pause : le jour suivant ne se débloquera qu'après votre validation.</p>
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center" bgcolor="#6d28d9" style="background-color:#6d28d9; border-radius:999px;">
                                        <a href="<%= url %>" style="display:inline-block; padding:13px 30px; font-family:Arial,sans-serif; font-size:15px; font-weight:700; color:#ffffff; text-decoration:none; border-radius:999px;">Corriger maintenant</a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding:20px 40px 32px; font-family:Arial,sans-serif; color:#9ca3af; font-size:12px;">Afro House of Knowledge — MaelEnglish</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
