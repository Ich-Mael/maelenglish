<!-- ======= Footer ======= -->
<style>
  /* Footer Premium Styles */
  #footer {
    background: #0f0f12;
    color: #e0e0e0;
    font-size: 0.95rem;
    font-family: 'Outfit', sans-serif;
    padding-top: 5rem;
    margin-top: auto;
    position: relative;
    overflow: hidden;
  }

  /* Top Gradient Border */
  #footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #5d06ba 0%, #a259ff 50%, #5d06ba 100%);
  }

  /* Subtle Background Glow */
  #footer::after {
    content: '';
    position: absolute;
    top: -100px;
    right: -100px;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(93, 6, 186, 0.15) 0%, transparent 70%);
    z-index: 0;
    pointer-events: none;
  }

  .footer-content {
    position: relative;
    z-index: 1;
    padding-bottom: 4rem;
  }

  /* Brand Section */
  .footer-brand h3 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1.2rem;
    letter-spacing: -0.5px;
    color: white;
    display: inline-block;
  }
  
  .footer-brand h3 span {
    color: #5d06ba;
  }

  .footer-brand p {
    color: #a0a0a5;
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 320px;
    font-size: 1rem;
  }

  /* Column Titles */
  .footer-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 1.5rem;
    letter-spacing: 0.5px;
  }

  /* Links with Hover Effect */
  .footer-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: 1rem;
  }

  .footer-links a {
    color: #a0a0a5;
    text-decoration: none;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1rem;
  }

  .footer-links a:hover {
    color: #a259ff;
    transform: translateX(5px);
  }
  
  .footer-links a i {
      font-size: 0.8rem;
      color: #5d06ba;
      transition: color 0.3s ease;
  }
  
  .footer-links a:hover i {
      color: #a259ff;
  }

  /* Contact Items */
  .footer-contact-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
    color: #a0a0a5;
  }

  .footer-contact-item i {
    color: #5d06ba;
    font-size: 1.25rem;
    margin-top: 2px;
    flex-shrink: 0;
  }

  /* Modern Social Icons */
  .social-links {
    display: flex;
    gap: 12px;
  }

  .social-btn {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .social-btn:hover {
    background: #5d06ba;
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(93, 6, 186, 0.3);
    border-color: #5d06ba;
  }
  
  .social-btn i {
    font-size: 1.2rem;
  }

  /* Footer Bottom */
  .footer-bottom {
    background: #050507;
    padding: 2rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.9rem;
    color: #6e6e73;
  }

  /* Newsletter/Input Group (Optional Future Use) */
  .footer-input-group {
    position: relative;
    margin-top: 1rem;
  }
  
  .footer-input {
    width: 100%;
    padding: 12px 16px;
    padding-right: 50px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    color: white;
    outline: none;
    transition: all 0.3s ease;
  }
  
  .footer-input:focus {
    border-color: #5d06ba;
    background: rgba(255,255,255,0.08);
  }
  
  .footer-input-btn {
    position: absolute;
    right: 5px;
    top: 5px;
    bottom: 5px;
    width: 40px;
    background: #5d06ba;
    border: none;
    border-radius: 8px;
    color: white;
    cursor: pointer;
    transition: background 0.3s ease;
  }
  
  .footer-input-btn:hover {
    background: #7b2cbf;
  }

  @media (max-width: 991px) {
    .footer-brand { margin-bottom: 2rem; }
    .footer-links { margin-bottom: 2rem; }
  }
</style>

