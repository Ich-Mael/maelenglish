<!-- ======= Footer ======= -->
<style>
  #footer {
    background: #09040f;
    color: #cbd5e1;
    font-family: 'Outfit', sans-serif;
    position: relative;
    overflow: hidden;
  }

  /* ambient glows */
  #footer .fg-orb-1 {
    position: absolute;
    top: -120px; right: -80px;
    width: 520px; height: 520px;
    background: radial-gradient(circle, rgba(93,6,186,.18) 0%, transparent 65%);
    pointer-events: none;
  }
  #footer .fg-orb-2 {
    position: absolute;
    bottom: 60px; left: -100px;
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(168,85,247,.10) 0%, transparent 65%);
    pointer-events: none;
  }

  /* dot-grid texture */
  #footer::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,.028) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
  }

  /* top accent line */
  .footer-accent-line {
    height: 3px;
    background: linear-gradient(90deg, transparent 0%, #5d06ba 30%, #a855f7 60%, transparent 100%);
  }

  /* ── CTA strip ── */
  .footer-cta-strip {
    position: relative; z-index: 1;
    border-bottom: 1px solid rgba(255,255,255,.06);
    padding: 2.5rem 0;
  }
  .footer-cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .footer-cta-text .fct-label {
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #a855f7;
    margin-bottom: .35rem;
  }
  .footer-cta-text h2 {
    font-size: 1.55rem;
    font-weight: 800;
    color: #fff;
    margin: 0;
    line-height: 1.25;
    letter-spacing: -.02em;
  }
  .footer-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    background: #5d06ba;
    color: #fff;
    font-size: .88rem;
    font-weight: 700;
    padding: .75rem 1.6rem;
    border-radius: 12px;
    text-decoration: none;
    white-space: nowrap;
    transition: background .22s, transform .22s, box-shadow .22s;
    box-shadow: 0 4px 18px rgba(93,6,186,.35);
    flex-shrink: 0;
  }
  .footer-cta-btn:hover {
    background: #4a0594;
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(93,6,186,.5);
    color: #fff;
  }
  .footer-cta-btn i { font-size: .9rem; transition: transform .22s; }
  .footer-cta-btn:hover i { transform: translateX(3px); }

  /* ── Main grid ── */
  .footer-main {
    position: relative; z-index: 1;
    padding: 3.5rem 0 3rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1.2fr 1.3fr;
    gap: 2.5rem 3rem;
  }

  /* brand col */
  .footer-brand-col {}
  .footer-logo-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px; height: 56px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 4px 20px rgba(0,0,0,.35);
    overflow: hidden;
    padding: 7px;
    margin-bottom: 1.2rem;
    text-decoration: none;
    transition: transform .25s, box-shadow .25s;
    flex-shrink: 0;
  }
  .footer-logo-circle:hover {
    transform: scale(1.07);
    box-shadow: 0 6px 28px rgba(93,6,186,.35);
  }
  .footer-logo-circle img {
    width: 100%; height: 100%;
    object-fit: contain;
    display: block;
  }
  .footer-brand-name {
    font-size: 1.15rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: .6rem;
    letter-spacing: -.01em;
  }
  .footer-brand-name span { color: #a855f7; }
  .footer-tagline {
    font-size: .85rem;
    color: #7c8ca0;
    line-height: 1.65;
    margin-bottom: 1.5rem;
    max-width: 280px;
  }

  /* social */
  .footer-social {
    display: flex;
    gap: 9px;
    flex-wrap: wrap;
  }
  .footer-social-btn {
    width: 38px; height: 38px;
    border-radius: 10px;
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(255,255,255,.08);
    display: flex; align-items: center; justify-content: center;
    color: #94a3b8;
    text-decoration: none;
    font-size: 1rem;
    transition: background .22s, color .22s, transform .22s, border-color .22s;
  }
  .footer-social-btn:hover {
    background: #5d06ba;
    border-color: #5d06ba;
    color: #fff;
    transform: translateY(-3px);
  }

  /* column */
  .footer-col-title {
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 1.25rem;
    position: relative;
    padding-bottom: .6rem;
  }
  .footer-col-title::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 24px; height: 2px;
    background: #5d06ba;
    border-radius: 2px;
  }
  .footer-col ul {
    list-style: none;
    padding: 0; margin: 0;
    display: flex;
    flex-direction: column;
    gap: .15rem;
  }
  .footer-col ul li a {
    display: flex;
    align-items: center;
    gap: .5rem;
    color: #7c8ca0;
    text-decoration: none;
    font-size: .88rem;
    padding: .45rem 0;
    border-bottom: 1px solid transparent;
    transition: color .22s, gap .22s;
  }
  .footer-col ul li a i {
    font-size: .65rem;
    color: #5d06ba;
    opacity: 0;
    transition: opacity .22s, transform .22s;
  }
  .footer-col ul li a:hover {
    color: #e2e8f0;
    gap: .75rem;
  }
  .footer-col ul li a:hover i {
    opacity: 1;
    transform: translateX(2px);
  }
  .footer-col ul li a .ext-icon {
    font-size: .62rem;
    color: #4b5563;
    margin-left: auto;
    opacity: 0;
    transition: opacity .22s;
  }
  .footer-col ul li a:hover .ext-icon { opacity: 1; }

  /* contact col */
  .footer-contact-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .footer-contact-row {
    display: flex;
    align-items: flex-start;
    gap: .85rem;
  }
  .footer-contact-row .fci {
    width: 34px; height: 34px;
    border-radius: 9px;
    background: rgba(93,6,186,.15);
    border: 1px solid rgba(93,6,186,.25);
    display: flex; align-items: center; justify-content: center;
    color: #a855f7;
    font-size: .9rem;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .footer-contact-row .fct {
    font-size: .75rem;
    color: #4b5563;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .06em;
    margin-bottom: .15rem;
  }
  .footer-contact-row .fcv {
    font-size: .85rem;
    color: #94a3b8;
    line-height: 1.45;
  }
  .footer-contact-row a.fcv {
    text-decoration: none;
    transition: color .2s;
  }
  .footer-contact-row a.fcv:hover { color: #e2e8f0; }

  /* ── Divider ── */
  .footer-divider {
    position: relative; z-index: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.07) 30%, rgba(255,255,255,.07) 70%, transparent);
    margin: 0;
  }

  /* ── Bottom bar ── */
  .footer-bottom {
    position: relative; z-index: 1;
    padding: 1.5rem 0;
  }
  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .footer-copyright {
    font-size: .8rem;
    color: #4b5563;
  }
  .footer-copyright strong { color: #64748b; }
  .footer-made {
    font-size: .78rem;
    color: #374151;
    display: flex;
    align-items: center;
    gap: .35rem;
  }
  .footer-made .heart { color: #ef4444; }
  .footer-legal {
    display: flex;
    gap: 1.5rem;
  }
  .footer-legal a {
    font-size: .78rem;
    color: #374151;
    text-decoration: none;
    transition: color .2s;
  }
  .footer-legal a:hover { color: #94a3b8; }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .footer-grid { grid-template-columns: 1.6fr 1fr 1.1fr; }
    .footer-brand-col { grid-column: 1 / -1; display: flex; align-items: flex-start; gap: 2rem; flex-wrap: wrap; }
    .footer-tagline { max-width: 360px; }
  }
  @media (max-width: 768px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
    .footer-brand-col { grid-column: 1 / -1; flex-direction: column; gap: 0; }
    .footer-cta-inner { flex-direction: column; align-items: flex-start; }
    .footer-cta-text h2 { font-size: 1.25rem; }
    .footer-bottom-inner { flex-direction: column; align-items: flex-start; gap: .75rem; }
  }
  @media (max-width: 480px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-main { padding: 2.5rem 0 2rem; }
  }
</style>

