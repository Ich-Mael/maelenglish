<%#
  Reusable class-wide premium CTA for Kalan — tier "Kalan Naaba" (toute la classe).
  Expects locals:
    schoolClass   — { _id, title, serie }
    naabaPrice    — { full, discounted, pct } (computeNaabaPrice)
    hasNaaba      — bool: student already holds Kalan Naaba for this class
    naabaPending  — bool: student has a pending Kalan Naaba request
  Only shows the request UI to logged-in high-school students who lack it.
%>
<% const knFull = Number(naabaPrice && naabaPrice.full || 0); %>
<% const knDisc = Number(naabaPrice && naabaPrice.discounted || 0); %>
<% const knPct = Number(naabaPrice && naabaPrice.pct != null ? naabaPrice.pct : 20); %>
<% const knWa = encodeURIComponent(`Bonjour, je souhaite obtenir Kalan Naaba (accès premium à toute la classe ${schoolClass.title} ${schoolClass.serie}). Prix: ${knDisc.toLocaleString('fr-FR')} FCFA (-${knPct}%).`); %>

<style>
  .kn { max-width: 1100px; margin: 0 auto 2rem; }
  .kn-card { border-radius: 18px; padding: 1.6rem 1.85rem; display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;
    box-shadow: 0 10px 30px rgba(50, 44, 77, 0.2); position: relative; overflow: hidden; }
  .kn-card .kn-icon { font-size: 2.7rem; flex-shrink: 0; }
  .kn-text { flex: 1; min-width: 250px; }
  .kn-text h3 { margin: 0 0 .35rem; font-family: 'Baloo 2', system-ui, sans-serif; font-size: 1.35rem; font-weight: 800; display: flex; align-items: center; gap: .55rem; flex-wrap: wrap; }
  .kn-text p { margin: 0; font-size: .95rem; opacity: .94; }
  .kn-badge { display: inline-flex; align-items: center; gap: .35rem; font-size: .72rem; font-weight: 800; letter-spacing: .05em;
    text-transform: uppercase; padding: .28rem .65rem; border-radius: 999px; background: #ffc23a; color: #322c4d; }
  .kn-price { display: flex; align-items: baseline; gap: .6rem; margin-top: .5rem; flex-wrap: wrap; }
  .kn-price .now { font-size: 1.45rem; font-weight: 800; color: #ffc23a; }
  .kn-price .was { text-decoration: line-through; opacity: .65; font-size: 1rem; }
  .kn-price .save { font-size: .78rem; font-weight: 700; background: rgba(255,194,58,.18); color: #ffc23a; padding: .15rem .55rem; border-radius: 999px; }
  .kn-actions { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
  .kn-btn { border: none; cursor: pointer; border-radius: 50px; padding: .85rem 1.6rem; font-weight: 800; font-size: .98rem;
    display: inline-flex; align-items: center; gap: .5rem; text-decoration: none; transition: transform .2s, box-shadow .2s; }
  .kn-btn-primary { background: #ffc23a; color: #322c4d; }
  .kn-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(255,194,58,.45); color: #322c4d; }
  .kn-btn-ghost { background: rgba(255,255,255,.14); color: #fff; border: 1px solid rgba(255,255,255,.35); }
  .kn-btn-ghost:hover { background: rgba(255,255,255,.24); color: #fff; }

  /* Locked — navy with the logo's sun yellow */
  .kn-locked { background: #322c4d; color: #fff; border: 1px solid rgba(255,194,58,.45); }
  .kn-locked::after { content: ''; position: absolute; top: -45%; right: -6%; width: 260px; height: 260px; border-radius: 50%;
    background: #ffc23a; opacity: .14; pointer-events: none; }
  .kn-locked::before { content: ''; position: absolute; bottom: -60%; left: -5%; width: 200px; height: 200px; border-radius: 50%;
    background: #5e17eb; opacity: .35; pointer-events: none; }
  .kn-locked > * { position: relative; z-index: 1; }
  .kn-locked .kn-icon { color: #ffc23a; }
  /* Pending */
  .kn-pending { background: #fff3d6; color: #7a5b00; border: 1px solid #ffe3a3; box-shadow: none; }
  .kn-pending .kn-icon { color: #d99a00; }
  /* Unlocked */
  .kn-unlocked { background: #5e17eb; color: #fff; border: 1px solid rgba(255,194,58,.5); }
  .kn-unlocked::after { content: ''; position: absolute; top: -45%; right: -6%; width: 260px; height: 260px; border-radius: 50%;
    background: #ffc23a; opacity: .2; pointer-events: none; }
  .kn-unlocked > * { position: relative; z-index: 1; }
  .kn-unlocked .kn-icon { color: #ffc23a; }

  .kn-warn { margin-top: .75rem; display: flex; gap: .65rem; align-items: flex-start; font-size: .82rem; line-height: 1.45;
    color: #7a5b00; background: #fff3d6; border: 1px solid #ffe3a3; border-radius: 12px; padding: .75rem .95rem; }
  .kn-warn i { font-size: 1.1rem; color: #d99a00; flex-shrink: 0; margin-top: .05rem; }

  @media (max-width: 600px) {
    .kn-card { flex-direction: column; text-align: center; }
    .kn-text h3, .kn-price { justify-content: center; }
    .kn-actions { width: 100%; justify-content: center; }
    .kn-btn { width: 100%; justify-content: center; }
  }
</style>

<% if (hasNaaba) { %>
  <div class="kn">
    <div class="kn-card kn-unlocked">
      <i class="bi bi-gem kn-icon"></i>
      <div class="kn-text">
        <h3><span class="kn-badge"><i class="bi bi-gem"></i> Kalan Naaba</span> activé pour toute la classe</h3>
        <p>Vous avez accès aux contenus premium de <strong>toutes les matières</strong> de cette classe. Excellent choix !</p>
      </div>
    </div>
    <div class="kn-warn">
      <i class="bi bi-shield-exclamation"></i>
      <span><strong>Compte strictement personnel.</strong> Le partage de votre compte, ou le téléchargement et la redistribution des contenus par un moyen illégal, est interdit et entraîne la suspension immédiate de l'accès, sans remboursement.</span>
    </div>
  </div>
<% } else if (currentUser && currentUser.highSchool_id && knFull > 0) { %>
  <% if (naabaPending) { %>
    <div class="kn">
      <div class="kn-card kn-pending">
        <i class="bi bi-hourglass-split kn-icon"></i>
        <div class="kn-text">
          <h3><span class="kn-badge"><i class="bi bi-gem"></i> Kalan Naaba</span> &mdash; demande en attente</h3>
          <p>Votre demande pour toute la classe est en cours de traitement. Vous serez notifié une fois approuvée.</p>
        </div>
      </div>
    </div>
  <% } else { %>
    <div class="kn">
      <div class="kn-card kn-locked">
        <i class="bi bi-gem kn-icon"></i>
        <div class="kn-text">
          <h3><span class="kn-badge"><i class="bi bi-gem"></i> Kalan Naaba</span> &mdash; débloquez toute la classe</h3>
          <p>Un seul accès pour les contenus premium de <strong>toutes les matières</strong> de la classe.</p>
          <div class="kn-price">
            <span class="now"><%= knDisc.toLocaleString('fr-FR') %> FCFA</span>
            <% if (knPct > 0 && knFull > knDisc) { %>
              <span class="was"><%= knFull.toLocaleString('fr-FR') %> FCFA</span>
              <span class="save">-<%= knPct %>%</span>
            <% } %>
          </div>
        </div>
        <div class="kn-actions">
          <form method="POST" action="/programs/ekalan/kalan/class/<%= schoolClass._id %>/request-naaba-access">
            <button type="submit" class="kn-btn kn-btn-primary">
              <i class="bi bi-send-fill"></i> Demander Kalan Naaba
            </button>
          </form>
          <a class="kn-btn kn-btn-ghost" target="_blank" href="https://wa.me/22653344444?text=<%= knWa %>">
            <i class="bi bi-whatsapp"></i> WhatsApp
          </a>
        </div>
      </div>
    </div>
  <% } %>
<% } %>
