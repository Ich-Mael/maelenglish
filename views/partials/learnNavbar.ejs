<style>
  .learn-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    height: 64px;
    background: #fff;
    border-bottom: 1px solid #e2e8f0;
    box-shadow: 0 1px 6px rgba(0,0,0,.06);
    display: flex;
    align-items: center;
    padding: 0 1.5rem;
    gap: 1rem;
  }
  .learn-nav-home { display: flex; align-items: center; flex-shrink: 0; padding: .25rem; border-radius: 8px; transition: background .15s; }
  .learn-nav-home:hover { background: #f1f5f9; }
  .learn-nav-home img { width: 30px; height: 30px; object-fit: contain; border-radius: 6px; opacity: .8; transition: opacity .15s; }
  .learn-nav-home:hover img { opacity: 1; }
  .learn-nav-divider { width: 1px; height: 20px; background: #e2e8f0; flex-shrink: 0; }
  .learn-nav-back {
    display: flex;
    align-items: center;
    gap: .45rem;
    color: #475569;
    font-size: .88rem;
    font-weight: 600;
    text-decoration: none;
    padding: .4rem .8rem;
    border-radius: 8px;
    transition: background .15s, color .15s;
    white-space: nowrap;
  }
  .learn-nav-back:hover { background: #f1f5f9; color: #1e293b; }
  .learn-nav-instructors {
    display: inline-flex; align-items: center; gap: .3rem;
    font-size: .82rem; font-weight: 600; text-decoration: none;
    padding: .35rem .7rem; border-radius: 8px;
    color: #64748b; white-space: nowrap; flex-shrink: 0;
    transition: background .15s, color .15s;
  }
  .learn-nav-instructors:hover { background: #f1f5f9; color: #1e293b; }
  @media (max-width: 640px) { .learn-nav-instructors { display: none; } }
  .learn-nav-brand {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .55rem;
    font-weight: 700;
    font-size: .95rem;
    color: #1e293b;
    overflow: hidden;
  }
  .learn-nav-brand-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--learn-brand, #0e7490);
    flex-shrink: 0;
  }
  .learn-nav-brand-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .learn-nav-user {
    display: flex;
    align-items: center;
    gap: .65rem;
    flex-shrink: 0;
  }
  .learn-nav-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--learn-brand, #0e7490);
    color: #fff;
    font-size: .8rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .learn-nav-username {
    font-size: .85rem;
    font-weight: 600;
    color: #334155;
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .learn-nav-logout {
    font-size: .82rem;
    color: #94a3b8;
    text-decoration: none;
    padding: .3rem .65rem;
    border-radius: 6px;
    transition: background .15s, color .15s;
    white-space: nowrap;
  }
  .learn-nav-logout:hover { background: #fee2e2; color: #dc2626; }
  @media (max-width: 576px) {
    .learn-nav-username { display: none; }
    .learn-nav-brand-name { max-width: 140px; }
  }
  /* Notification bell */
  .notif-wrap { position: relative; flex-shrink: 0; }
  .notif-btn {
    width: 34px; height: 34px; border-radius: 50%; border: none; cursor: pointer;
    background: #f1f5f9; color: #475569; display: flex; align-items: center;
    justify-content: center; font-size: 1rem; position: relative; transition: background .15s;
  }
  .notif-btn:hover { background: #e2e8f0; }
  .notif-badge {
    position: absolute; top: -3px; right: -3px; min-width: 16px; height: 16px;
    border-radius: 8px; background: #ef4444; color: #fff; font-size: .62rem;
    font-weight: 800; display: flex; align-items: center; justify-content: center;
    padding: 0 3px; border: 2px solid #fff; line-height: 1;
  }
  .notif-dropdown {
    display: none; position: absolute; top: calc(100% + 10px); right: 0;
    width: 300px; background: #fff; border-radius: 14px;
    box-shadow: 0 8px 30px rgba(0,0,0,.14); border: 1px solid #e2e8f0; z-index: 2000;
    overflow: hidden;
  }
  .notif-dropdown.open { display: block; }
  .notif-header {
    padding: .75rem 1rem; font-size: .75rem; font-weight: 800; text-transform: uppercase;
    letter-spacing: .06em; color: #94a3b8; border-bottom: 1px solid #f1f5f9;
    display: flex; align-items: center; justify-content: space-between;
  }
  .notif-item {
    display: flex; gap: .65rem; padding: .8rem 1rem; border-bottom: 1px solid #f8fafc;
    text-decoration: none; color: inherit; transition: background .12s;
  }
  .notif-item:last-child { border-bottom: none; }
  .notif-item:hover { background: #f8fafc; }
  .notif-icon { width: 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: .9rem; flex-shrink: 0; }
  .notif-icon-ann   { background: #dbeafe; }
  .notif-icon-grade { background: #dcfce7; }
  .notif-text strong { font-size: .85rem; font-weight: 600; color: #1e293b; display: block; line-height: 1.35; }
  .notif-text span   { font-size: .75rem; color: #94a3b8; }
  .notif-empty { padding: 1.5rem 1rem; text-align: center; color: #94a3b8; font-size: .85rem; }
</style>

<% const _learnColor = typeof institutionColor !== 'undefined' ? institutionColor : '#0e7490'; %>
<% const _inst = typeof institution !== 'undefined' ? institution : null; %>

<nav class="learn-nav" style="--learn-brand: <%= _learnColor %>">
  <a href="/" class="learn-nav-home" title="Accueil AfroHK">
    <img src="/assets/img/afrohk_logo_2.png" alt="AfroHK">
  </a>
  <div class="learn-nav-divider"></div>
  <a href="/institution/learn/courses" class="learn-nav-back">
    <i class="bi bi-arrow-left"></i>
    <span>Mes cours</span>
  </a>

  <a href="/institution/learn/instructors" class="learn-nav-instructors">👨‍🏫 Instructeurs</a>

  <div class="learn-nav-brand">
    <span class="learn-nav-brand-dot"></span>
    <span class="learn-nav-brand-name"><%= _inst ? _inst.name : 'AfroHK' %></span>
  </div>

  <%
    const _nc  = typeof notifCount !== 'undefined' ? notifCount : 0;
    const _na  = typeof notifAnnouncements !== 'undefined' ? notifAnnouncements : [];
    const _ng  = typeof notifGradeCount !== 'undefined' ? notifGradeCount : 0;
    const _annIcons = { info: '📢', discount: '🎉', new_course: '📚', event: '📅', reminder: '⏰' };
  %>
  <div class="notif-wrap" id="notifWrap">
    <button class="notif-btn" id="notifBtn" aria-label="Notifications">
      <i class="bi bi-bell"></i>
      <% if (_nc > 0) { %>
        <span class="notif-badge" id="notifBadge"><%= _nc > 9 ? '9+' : _nc %></span>
      <% } %>
    </button>
    <div class="notif-dropdown" id="notifDropdown">
      <div class="notif-header">
        <span>Notifications</span>
        <% if (_nc > 0) { %><span style="color:var(--learn-brand,#0e7490);cursor:pointer;font-size:.72rem;font-weight:700;" id="notifMarkSeen">Tout marquer lu</span><% } %>
      </div>
      <% if (_nc === 0) { %>
        <div class="notif-empty">Aucune nouvelle notification</div>
      <% } else { %>
        <% if (_ng > 0) { %>
          <a href="#" class="notif-item" data-course-grades="1">
            <div class="notif-icon notif-icon-grade">🎓</div>
            <div class="notif-text">
              <strong><%= _ng %> correction<%= _ng > 1 ? 's' : '' %> disponible<%= _ng > 1 ? 's' : '' %></strong>
              <span>Consultez vos notes</span>
            </div>
          </a>
        <% } %>
        <% _na.forEach(ann => { %>
          <div class="notif-item">
            <div class="notif-icon notif-icon-ann"><%= _annIcons[ann.type] || '📢' %></div>
            <div class="notif-text">
              <strong><%= ann.title %></strong>
              <span><%= new Date(ann.createdAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' }) %></span>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <div class="learn-nav-user">
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <div class="learn-nav-avatar">
        <%= currentUser.name ? currentUser.name[0].toUpperCase() : currentUser.username[0].toUpperCase() %>
      </div>
      <a href="/user/<%= currentUser._id %>" class="learn-nav-username" style="text-decoration:none;color:inherit;"><%= currentUser.name %> <%= currentUser.surname %></a>
    <% } %>
    <a href="/logout" class="learn-nav-logout">Déconnexion</a>
  </div>
</nav>

<script>
(function () {
  const btn      = document.getElementById('notifBtn');
  const dropdown = document.getElementById('notifDropdown');
  const badge    = document.getElementById('notifBadge');
  const markSeen = document.getElementById('notifMarkSeen');

  if (!btn) return;

  btn.addEventListener('click', function (e) {
    e.stopPropagation();
    dropdown.classList.toggle('open');
  });

  document.addEventListener('click', function (e) {
    if (!document.getElementById('notifWrap').contains(e.target)) {
      dropdown.classList.remove('open');
    }
  });

  function markAllSeen() {
    fetch('/institution/learn/notifications/mark-seen', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
      .then(() => {
        if (badge) badge.remove();
        if (markSeen) markSeen.remove();
        const empty = document.createElement('div');
        empty.className = 'notif-empty';
        empty.textContent = 'Aucune nouvelle notification';
        dropdown.innerHTML = '<div class="notif-header"><span>Notifications</span></div>';
        dropdown.appendChild(empty);
      });
  }

  if (markSeen) markSeen.addEventListener('click', markAllSeen);
})();
</script>
