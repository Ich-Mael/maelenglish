<% const _inst  = typeof institution !== 'undefined' ? institution : null; %>
<% const _color = typeof institutionColor !== 'undefined' ? institutionColor : '#0e7490'; %>
<% const _initials = _inst ? (_inst.name || 'I').substring(0, 2).toUpperCase() : 'I'; %>

<style>
  .inst-footer {
    background: #0f172a;
    color: rgba(255,255,255,.75);
    padding: 3rem 0 1.5rem;
    margin-top: auto;
    font-size: .88rem;
  }
  .inst-footer-brand {
    display: flex; align-items: center; gap: .75rem; margin-bottom: 1rem;
  }
  .inst-footer-logo {
    width: 44px; height: 44px; border-radius: 10px; object-fit: contain;
    border: 2px solid rgba(255,255,255,.12);
  }
  .inst-footer-logo-fallback {
    width: 44px; height: 44px; border-radius: 10px;
    background: var(--inst-footer-brand);
    color: #fff; font-size: .85rem; font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; letter-spacing: .03em;
  }
  .inst-footer-name {
    font-size: 1.1rem; font-weight: 800; color: #fff; line-height: 1.2;
  }
  .inst-footer-tagline {
    font-size: .78rem; color: rgba(255,255,255,.4); margin-top: .1rem;
  }
  .inst-footer-desc {
    color: rgba(255,255,255,.55); line-height: 1.7; margin-bottom: 0;
    max-width: 340px;
  }
  .inst-footer-section-title {
    font-size: .7rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .08em; color: var(--inst-footer-brand);
    margin-bottom: .85rem;
  }
  .inst-footer-contact-item {
    display: flex; align-items: flex-start; gap: .6rem;
    color: rgba(255,255,255,.65); margin-bottom: .55rem; font-size: .87rem;
  }
  .inst-footer-contact-item i { color: var(--inst-footer-brand); flex-shrink: 0; margin-top: 2px; }
  .inst-footer-divider {
    border-top: 1px solid rgba(255,255,255,.07); margin: 2rem 0 1.25rem;
  }
  .inst-footer-bottom {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: .75rem;
    color: rgba(255,255,255,.3); font-size: .78rem;
  }
  .inst-footer-powered {
    display: flex; align-items: center; gap: .4rem;
  }
  .inst-footer-powered-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--inst-footer-brand); flex-shrink: 0;
  }
</style>

<footer class="inst-footer" style="--inst-footer-brand: <%= _color %>">
  <div class="container">
    <div class="row g-4">

      <!-- Brand column -->
      <div class="col-md-5">
        <div class="inst-footer-brand">
          <% if (_inst && _inst.logoUrl) { %>
            <img src="<%= _inst.logoUrl %>" alt="<%= _inst.name %>" class="inst-footer-logo">
          <% } else { %>
            <div class="inst-footer-logo-fallback"><%= _initials %></div>
          <% } %>
          <div>
            <div class="inst-footer-name"><%= _inst ? _inst.name : 'Institution' %></div>
            <div class="inst-footer-tagline">Portail d'apprentissage</div>
          </div>
        </div>
        <% if (_inst && _inst.description) { %>
          <p class="inst-footer-desc"><%= _inst.description.substring(0, 160) %><%= _inst.description.length > 160 ? '…' : '' %></p>
        <% } %>
      </div>

      <!-- Contact column -->
      <div class="col-md-4 offset-md-1">
        <div class="inst-footer-section-title">Contact</div>

        <% if (_inst && (_inst.city || _inst.country)) { %>
          <div class="inst-footer-contact-item">
            <i class="bi bi-geo-alt-fill"></i>
            <span><%= [_inst.city, _inst.country].filter(Boolean).join(', ') %></span>
          </div>
        <% } %>

        <% if (_inst && _inst.phone) { %>
          <div class="inst-footer-contact-item">
            <i class="bi bi-telephone-fill"></i>
            <span><%= _inst.phone %></span>
          </div>
        <% } %>

        <% if (_inst && _inst.contactEmail) { %>
          <div class="inst-footer-contact-item">
            <i class="bi bi-envelope-fill"></i>
            <a href="mailto:<%= _inst.contactEmail %>" style="color:inherit;text-decoration:none;">
              <%= _inst.contactEmail %>
            </a>
          </div>
        <% } %>
      </div>

    </div>

    <div class="inst-footer-divider"></div>

    <div class="inst-footer-bottom">
      <span>© <%= new Date().getFullYear() %> <%= _inst ? _inst.name : 'Institution' %>. Tous droits réservés.</span>
      <div class="inst-footer-powered">
        <div class="inst-footer-powered-dot"></div>
        <span>Propulsé par <a href="/" style="color:rgba(255,255,255,.5);text-decoration:none;font-weight:600;">AfroHK</a></span>
      </div>
    </div>
  </div>
</footer>
