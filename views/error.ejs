<% layout('layouts/boilerplate')%>
<div class="row my-5">
    <div class="col-md-6 offset-3">
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading text-center"> Erreur : Veuillez ressayer plus tard!!! </h4>
            <% if (process.env.NODE_ENV !== "production") { %>
            <h4 class="alert-heading text-center"><%=err.message%></h4>
            <p><%= err.stack %></p>
            <% } %>
        </div>
    </div>
</div>