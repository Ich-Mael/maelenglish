<% layout('layouts/engClubBoilerplate') %>
<!-- WORD Processor-->
<script src="https://cdn.tiny.cloud/1/p06f8vxdpje8xosyvnq48z68vc7n479iauh5s2jk9zx30qg2/tinymce/5/tinymce.min.js"
  referrerpolicy="origin"></script>
</script>
<script>
  tinymce.init({
    selector: '#mytextarea',
    height: 500,
    max_width: 500,
    min_height: 300,
    min_width: 400
  });
</script>

<div class="container col-md-8">
  <h1 class="text-center my-5"><%= club.acronym %> Board Members Dashboard</h1>

  <p>
    <button class="btn btn-primary me-5" type="button" data-bs-toggle="collapse" data-bs-target="#article"
      aria-expanded="false" aria-controls="collapseExample">
      Post an article
    </button>
    <a href="/englishlang4all/Clubs/:club_id/board_dashboard/articles" type="button"
      class="btn btn-outline-primary"> View all articles </a>
  </p>
  <div class="collapse" id="article">
    <form action="/englishlang4all/Clubs/<%= club._id %>/board_dashboard/article" method="POST">

      <!-- Article image url -->
      <label class="form-label my-3" for="articleImage">Image Link</label>
      <input type="text" class="form-control" name="englishClubArticle[articleImage]" id="articleImage" value="" />

      <!-- Title  -->
      <label class="form-label my-3" for="title">Title</label>
      <input type="text" class="form-control" name="englishClubArticle[title]" value="" id="title" />

      <!-- Article Summary  -->
      <label class="form-label my-3" for="articleSummary">Article Summary</label>
      <input type="text" class="form-control" name="englishClubArticle[articleSummary]" value="" id="title" />

      <!-- Author -->
      <label class="form-label my-3" for="author">Author</label>
      <input type="text" class="form-control" name="englishClubArticle[articleAuthor]" value="" id="articleAuthor" />

      <!-- Article Content -->
      <label class="form-label my-3" for="articleContent">Article content</label>
      <textarea type="text" class="form-control" name="englishClubArticle[articleContent]" value=""
        id="mytextarea"></textarea>
      <hr />
      <button class="btn btn-outline-success" type="submit">Post article</button>
    </form>
  </div>

  <hr>

  <p>
    <button class="btn btn-info" type="button" data-bs-toggle="collapse" data-bs-target="#wod" aria-expanded="false"
      aria-controls="collapseExample">
      Weekly Activities
    </button>
  </p>
  <div class="collapse" id="wod">
    <form action="/englishlang4all/Clubs/<%= club._id %>/board_dashboard/weeklyactivity" method="POST">

      <!-- Word of the day -->
      <label class="form-label fw-bold my-3" for="Word of the day">Word of the day</label>
      <input type="text" class="form-control" name="wordOfDay[word]" id="word" value="" />

      <!-- meaning  -->
      <label class="form-label fw-bold my-3" for="title">Meaning</label>
      <input type="text" class="form-control" name="wordOfDay[meaning]" value="" id="title" />

      <!-- Learn more  -->
      <label class="form-label fw-bold my-3" for="learnMoreWord">Learn more</label>
      <textarea type="text" class="form-control" name="wordOfDay[learnMoreWord]" value=""
        id="mytextarea"></textarea>
      <hr/>

      <button class="btn btn-outline-success" type="submit">Post article</button>
    </form>
  </div>
</div>