<!-- ours english clubs -->
<section class="our-englishclubs">
  <h2 class="program-title text-center">Apprenez naturellement l’Anglais</h2>
  <div class="container py-5">
    <!-- Button trigger modal -->
    <div class="d-flex flex-column justifify-content-center
    align-items-center">
      <button type="button" class="btn btn-lg btn-outline-primary" data-bs-toggle="modal"
        data-bs-target="#exampleModal">
        <h3 class="align-self-center year"> <span style="color:rgb(64, 10, 114);">Inscrivez-vous maintenant</span>
        </h3>
        <hr>
        <h2 class="py-1"> Formulaire d'inscription au Natural English Club</h2>
      </button>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="exampleModalLabel">Natural English Clubs enrollement forms</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <iframe
              src="https://docs.google.com/forms/d/e/1FAIpQLSdx9IUnxFLPgBvVIFpPWGz9ht_Mz9txW2OgMPd7bipWCMm7DA/viewform?embedded=true"
              width="100%" height="2917" frameborder="0" marginheight="0" marginwidth="0">Loading…</iframe>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="button" class="btn btn-primary">Save changes</button>
          </div>
        </div>
      </div>
    </div>

  </div>
  <div class="univ-eng-clubs">
    <div class="cards-wrapper">
      <h3 class="univ-eng-club-title">
        <span class="underline"></span>Club d'Anglais Universitaire<span class="underline"></span>
      </h3>
      <div class="d-flex justify-content-center align-items-center">
        <p>
          <button class="btn btn-lg btn-outline-dark" type="button" data-bs-toggle="collapse" data-bs-target="#ouaga"
            aria-expanded="false" aria-controls="collapseExample">
            OUAGADOUGOU
          </button>
        </p>
        <!-- 
        <p>
          <button class="btn btn-lg btn-info" type="button" data-bs-toggle="collapse" data-bs-target="#bobo" aria-expanded="false" aria-controls="collapseExample">
            Bobo-Dioulasso
          </button>
        </p>


        <p>
          <button class="btn btn-lg btn-info" type="button" data-bs-toggle="collapse" data-bs-target="#koudougou" aria-expanded="false" aria-controls="collapseExample">
            Koudougou
          </button>
        </p>-->
      </div>

      <!-- <div class="collapse" id="ouaga"> -->
      <div class="card card-body">
        <div class="container">
          <div class="row pb-5">
            <% for(let club of clubs) {%>
            <!-- english club 1 -->
            <div class="col-sm-6 col-md-3 m-3">
              <div class="eng-club-details">
                <!-- <div class="img-wrapper">
                    <img
                      src="<%= club.logoImageUrl %>"
                      class="img-thumbnail"
                      alt=""
                    />
                  </div> -->

                <h2 class="institution"><%=club.instituition %></h2>
                <div class="eng-clubs-description">
                  <h3 class="eng-club-name"><%=club.acronym %></h3>
                  <p class="definition"><%=club.name%></p>
                  <p class="found-date">Founded in <%=club.foundDate %></p>
                </div>
                <hr />
                <div class="pb-3">
                  <div class="d-flex justify-content-center">
                    <div>
                      <!-- Button trigger modal -->
                      <button type="button" class="btn mx-2 btn-outline-secondary" data-bs-toggle="modal"
                        data-bs-target="#N<%=club._id%>">
                        Learn more
                      </button>
                      <button class="btn mx-2 btn-outline-primary">
                        <a class="join-link" href="/englishlang4all/Clubs/<%=club._id%>">GET IN</a>
                      </button>
                    </div>
                  </div>

                  <!-- Modal -->
                  <div class="modal fade" id="N<%=club._id%>" tabindex="-1" aria-labelledby="exampleModalLabel"
                    aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title" id="exampleModalLabel">
                            All about this English Club
                          </h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body"><%-club.description%></div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Close
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <%}%>
            </div>
          </div>
        </div>
      <!-- </div> -->
    </div>
  </div>
</section>