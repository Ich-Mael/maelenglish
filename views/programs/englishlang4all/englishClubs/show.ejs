<!-- board section -->
<h1 class="common-heading">
	<span class="underline"></span>Board Members<span class="underline"></span>
</h1>
<div id="board-section">
	<div class="row d-flex justify-content-center" data-aos="zoom-in-up" data-aos-offset="200" data-aos-delay="150"
		data-aos-duration="600" data-aos-easing="ease-in-out" data-aos-mirror="true">
		<div class="slider owl-carousel">
			<% const positions = ["President", "Vice-President", "Treasurer", "Secretary", "Communication Manager", "Cultural Affairs Officer"] %>
			<% for(let i=0; i < club.boardMembers.length ; i++){ %>
			<div class="bm-card card">
				<div class="img">
					<img src="<%= club.boardMembers[i].imageUrl %>"
						alt="Board Member Picture" />
				</div>
				<div class="content">
					<div class="position"><%= positions[i] %></div>
					<div class="member-name"><%= club.boardMembers[i].name + " " + club.boardMembers[i].surname%> </div>
					<p>
						<%= club.boardMembers[i].about%>	
					</p>
					<!-- Social media -->
					<div class="social-media-icons align-self-center">
						<!-- Facebook -->
						<a class="btn btn-outline-light btn-floating" href="<%= club.boardMembers[i].facebookLink %>" id="m-facebook"
							role="button" target="_blank"><i
								class="engclub-sm-icon fab fa-facebook-f"></i></a>

						<!-- Twitter -->
						<a class="btn btn-outline-light btn-floating" href="<%= club.boardMembers[i].twitterLink %>" id="m-twitter"
							target="_blank" role="button"><i
								class="engclub-sm-icon fab fa-twitter"></i></a>

						<!-- Google -->
						<!-- <a
					      class="btn btn-outline-light btn-floating m-2"
					      href="#!"
					      target="_blank"
					      role="button"
					      ><i class="fab fa-google"></i
					    ></a> -->
						<!-- Linkedin -->
						<a class="btn btn-outline-light btn-floating" href="<%= club.boardMembers[i].linkedIn%>" target="_blank"
							role="button" id="m-linkedIn"><i
								class="engclub-sm-icon fab fa-linkedin-in"></i></a>
						<!-- whatsapp -->
						<a class="btn btn-outline-light btn-floating" href="<%= club.boardMembers[i].whatsAppLink %>" role="button"
							id="m-whatsapp" target="_blank"><i
								class="engclub-sm-icon fa fa-whatsapp"></i></a>
					</div>
				</div>
			</div>
			<% } %> 
		</div>
	</div>
</div>

