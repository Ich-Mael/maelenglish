      <!-- Media section -->
      <section id="top-stories-wrapper">
        <h1 class="activity-heading">Media</h1>
        <div class="row mt-4">
          <% for(let i = 0 ; i < 2 ; i++){ %>
          <div class="col-md-6 my-3">
            <div class="media-card py-1">
              <!--  <div class="card-body"> -->
              <div id="tv-container">
                <div id="monitor">
                  <div class="afrohk-TV">
                    <h3 class="text-center afrohk-text mb-2 py-0"><span class="afrohk">AfroHK</span><span
                        class="tv">Radar</span>
                    </h3>
                  </div>
                  <div id="monitorscreen">
                    <iframe id="vimeo-content" width="100%" height="100%" src="<%= club.media[i].videoLink %>"
                      title="YouTube video player" frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; fullscreen; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen>
                    </iframe>
                  </div>
                </div>
              </div>
              <div class="video-details-wrapper m-0">
                <h5 class="text-center"><%= club.media[i].mediaTitle %></h5>
              </div>
              <!-- Button trigger modal -->
              <button type="button" class="btn mx-2 my-2 btn-outline-primary" data-bs-toggle="modal"
                data-bs-target='#mediaComment<%= club.media[i]._id%>'>Leave your feeling 🙃
              </button>
              <!-- Modal -->
              <div class="modal fade" id='mediaComment<%= club.media[i]._id%>' tabindex="-1"
                aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title" id="exampleModalLabel">Club members' feeling</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <form action="/englishlang4all/clubs/<%= club._id %>/clubMedia/<%= club.media[i]._id %>/comment"
                        method="POST">
                        <fieldset id="stars" class="starability-heart mb-1">
                          <!-- <legend>Rating</legend> -->
                          <input type="radio" id="no-rate<%= club.media[i]._id %>" class="input-no-rate"
                            name="review[rating]" value="0" checked aria-label="No rating." />
                          <input type="radio" id="first-of-rate1<%= club.media[i]._id %>" name="review[rating]"
                            value="1" />
                          <label for="first-rate1<%= club.media[i]._id %>" title="Terrible">1 star</label>
                          <input type="radio" id="first-rate2<%= club.media[i]._id %>" name="review[rating]"
                            value="2" />
                          <label for="first-rate2<%= club.media[i]._id %>" title="Not good">2 stars</label>
                          <input type="radio" id="first-rate3<%= club.media[i]._id %>" name="review[rating]"
                            value="3" />
                          <label for="first-rate3<%= club.media[i]._id %>" title="Average">3 stars</label>
                          <input type="radio" id="first-rate4<%= club.media[i]._id %>" name="review[rating]"
                            value="4" />
                          <label for="first-rate4<%= club.media[i]._id %>" title="Very good">4 stars</label>
                          <input type="radio" id="first-rate5<%= club.media[i]._id %>" name="review[rating]"
                            value="5" />
                          <label for="first-rate5<%= club.media[i]._id %>" title="Amazing">5 stars</label>
                        </fieldset>
                        <div class="form-floating">
                          <textarea class="form-control" name="review[text]" placeholder="Leave a comment here"
                            id="floatingTextarea" style="height: 70px" required></textarea>
                          <label for="floatingTextarea">Leave a comment</label>
                        </div>
                        <button class="btn btn-outline-primary my-3">Post Comment</button>
                      </form>
                      <!-- all comments -->
                      <hr>

                      <h5 class="text-center py-3 mb-3" style="background: #34e89e;  
                      background: -webkit-linear-gradient(to right, #0f3443, #34e89e, #0f3443);  
                      background: linear-gradient(to right, #0f3443, #34e89e, #0f3443); color: rgb(43, 42, 41);
                      ">Previous Comments</h5>
                      <% for (let review of club.media[i].mediaComments){%>
                      <div class="card comment-card mb-3 ">
                        <div class="p-2 d-flex justifify-content-center">
                          <div class="p-2"><span class="rounded"><img class="img-thumbnail"
                                src="<%= review.author.imageUrl %>" alt="user" width="80"></span>
                          </div>
                          <div class="w-100 align-self-center">
                            <h5><%= review.author.username %> <span class="card-text mx-2"><small
                                  class="text-muted fst-italic"><%= days[review.createdAt.getDay()] %>,
                                  <%=review.createdAt.getDate()%>
                                  <%= months[review.createdAt.getMonth()] %>
                                  <%=review.createdAt.getFullYear()%></small> </span>
                            </h5>
                            <p class="starability-result" data-rating="<%=review.rating%>">
                              Rated: <%= review.rating %> stars
                            </p>
                          </div>
                        </div>
                        <p class="mx-3"><%= review.text %></p>
                      </div>
                      <% } %>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <% } %>
      </section>
    </div>

    <!-- Top events section -->
    <div class="col-lg-3 p-2 current-activity">
      <h1 class="current-activity-heading"><span>Top Events</span></h1>
      <div class="d-flex flex-column align-items-center
                            justify-content-center">
        <div class="student-OM">
          <div class="card m-2">
            <div class="card-header text-center
                                  student-month">
              Student of the Month
            </div>
            <div class="card-body">
              <div class="som-img-wrapper">
                <img src="<%= club.workersOfMonth[0].studentOfMonth.imageUrl %>" alt="" class="img-thumbnail img-fluid">
              </div>
              <h5 class="card-title fs-3 fw-bold"><%= club.workersOfMonth[0].studentOfMonth.fullname %></h5>
              <p class="card-text fs-4"><%= club.workersOfMonth[0].studentOfMonth.reasons %></p>
              <!-- Button trigger modal -->
              <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#som">
                Learn more about the SOM
              </button>

              <!-- Modal -->
              <div class="modal fade" id="som" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg
                                      modal-fullscreen-md-down">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title" id="exampleModalLabel">
                        All about the Student
                        of the Month
                      </h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <%- club.workersOfMonth[0].studentOfMonth.about %>

                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn
                                            btn-danger" data-bs-dismiss="modal">Close</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="instructor-OM">
          <div class="card m-2">
            <div class="card-header text-center
                                  instructor-month">
              Instructor of the Month
            </div>
            <div class="card-body">
              <div class="som-img-wrapper">
                <img src="<%= club.workersOfMonth[0].instructorOfMonth.imageUrl %>" alt=""
                  class="img-thumbnail img-fluid">
              </div>
              <h5 class="card-title fs-3 fw-bold"><%= club.workersOfMonth[0].instructorOfMonth.fullname%></h5>
              <p class="card-text fs-4"><%= club.workersOfMonth[0].instructorOfMonth.reasons %></p>
              <!-- Button trigger modal -->
              <button type="button" class="btn
                                    btn-secondary" data-bs-toggle="modal" data-bs-target="#iom">
                Learn more about the IOM
              </button>

              <!-- Modal -->
              <div class="modal fade" id="iom" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg
                                      modal-fullscreen-md-down">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title" id="exampleModalLabel">
                        All about the Instructor
                        of the Month
                      </h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <%- club.workersOfMonth[0].instructorOfMonth.about %>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn
                                            btn-danger" data-bs-dismiss="modal">Close</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
        <div class="daily-content">
          <div class="card m-2">
            <div class="card-header text-center word-day">
              Vocabulary Cookies
            </div>
            <div class="card-body">
              <div class="card-title word-day-title py-2 fs-4"><h4 class="fw-bold py-1">Word of the day </h4>
                <p><%= club.weeklyActivity[0].wordOfDay.word %></p></div>
              <p class="card-text word-day-meaning fs-4"><span class="fw-bold">Meaning : </span>
                <%= club.weeklyActivity[0].wordOfDay.wordMeaning %>
              </p>
              <hr>
              <div class="card-title idioms-title fs-4 py-2"><h4 class="fw-bold">Idiom of the day</h4>
                  <p class=""><%= club.weeklyActivity[0].IdiomDay.idiom %> </p>
              </div>
              <p class="card-text word-day-meaning fs-4"><span class="fw-bold">Meaning : </span>
                <%= club.weeklyActivity[0].IdiomDay.idiomMeaning %>
              </p>
              <!-- Button trigger modal -->
              <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#wod-1">
                Understand better with examples
              </button>

              <!-- Modal -->
              <div class="modal fade" id="wod-1" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg
                                      modal-fullscreen-md-down">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title " id="exampleModalLabel">
                        Understand better with examples
                      </h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <h3>Sentence examples for the WOD</h3>
                      <p class="fs-3"> <%- club.weeklyActivity[0].wordOfDay.learnMoreWord %>
                      </p>
                      <hr>
                      <h3>Sentence examples for the IOD</h3>
                      <p class="fs-3"> <%- club.weeklyActivity[0].IdiomDay.learnMoreIdiom %> </p>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn
                                            btn-danger" data-bs-dismiss="modal">Close</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="coming-activity">
          <div class="card m-2">
            <div class="card-header text-center incomming-activities">
              Incomming Activities
            </div>
            <div class="card-body">
              <div>
                <h3 class="card-title weekly-activity">Weekly English Club Meeting</h3>
                <h4 class="activity-date fs-4 text-center">
                  <%= days[club.weeklyActivity[0].englishClubMeeting.meetingDate.getDay()] %>,
                  <%=club.weeklyActivity[0].englishClubMeeting.meetingDate.getDate()%>
                  <%= months[club.weeklyActivity[0].englishClubMeeting.meetingDate.getMonth()] %>
                  <%=club.weeklyActivity[0].englishClubMeeting.meetingDate.getFullYear()%>
                </h4>
                <h4 class="activity-place fs-4"> <span class="fw-bold text-danger"><i
                      class="fas me-2 fa-map-marker-alt"></i>Venue</span> <br>
                  <%=club.weeklyActivity[0].englishClubMeeting.venue %> </h4>
                <h4 class="activity-time fs-4"> <span class="fw-bold text-danger"><i class="fas me-2 fa-clock"></i>Time:
                  </span> <%=club.weeklyActivity[0].englishClubMeeting.meetingTime %>
                </h4>
