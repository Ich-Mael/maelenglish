                <div class="modal fade" id="wec" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                  <div class="modal-dialog modal-lg
                                        modal-fullscreen-md-down">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabel">
                          Weekly English Club Meeting Agenda
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <div class="modal-body">
                        <p class="fs-4"> <%- club.weeklyActivity[0].englishClubMeeting.about %>
                        </p>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn
                                              btn-danger" data-bs-dismiss="modal">Close</button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <hr>
              <div>
                <h3 class="card-title weekly-activity text-primary">Online Debates</h3>
                <ul class="list-group list-group-flush fs-3">
                  <li class="list-group-item"> <span class="">Topic 1
                      :</span><br>
                    <span class="text-success fw-bold"><%=club.weeklyActivity[0].OnlineDebate.topicOne %></span> <br>
                    <span class="">
                      <%= days[club.weeklyActivity[0].OnlineDebate.debateDateOne.getDay()]%>,
                      <%=club.weeklyActivity[0].OnlineDebate.debateDateOne.getDate()%>
                      <%= months[club.weeklyActivity[0].OnlineDebate.debateDateOne.getMonth()]%>
                      <%=club.weeklyActivity[0].OnlineDebate.debateDateOne.getFullYear()%></span>
                    <br>
                    <span class=""><%=club.weeklyActivity[0].OnlineDebate.debateTimeOne%></span>
                  </li>
                  <li class="list-group-item"><span class="">Topic 2 :</span>
                    <br>
                    <span class="text-success fw-bold"><%=club.weeklyActivity[0].OnlineDebate.topicTwo%></span>
                    <br>
                    <span class=""> <%= days[club.weeklyActivity[0].OnlineDebate.debateDateTwo.getDay()]%>,
                      <%=club.weeklyActivity[0].OnlineDebate.debateDateTwo.getDate()%>
                      <%= months[club.weeklyActivity[0].OnlineDebate.debateDateTwo.getMonth()]%>
                      <%=club.weeklyActivity[0].OnlineDebate.debateDateTwo.getFullYear()%>
                    </span>
                    <br>
                    <span class=""> <%=club.weeklyActivity[0].OnlineDebate.debateTimeTwo%></span>
                  </li>
                </ul>

                <!-- Button trigger modal -->
                <button type="button" class="btn mt-2
                                      btn-outline-success" data-bs-toggle="modal" data-bs-target="#oed">
                  Learn more
                </button>

                <!-- Modal -->
                <div class="modal fade" id="oed" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                  <div class="modal-dialog modal-lg
                                        modal-fullscreen-md-down">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabel">
                          Online English Debates
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <div class="modal-body">
                        <p>
                          <%- club.weeklyActivity[0].OnlineDebate.aboutTopic %>
                        </p>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>