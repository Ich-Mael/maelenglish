<!-- board section -->
<h1 class="common-heading">
  <span class="underline"></span>Board Members<span class="underline"></span>
</h1>
<div class="customer-section">
  <div class="container">
    <div id="customers-cards" class="carousel slide" data-bs-ride="carousel">
      <div class="carousel-inner">
        <div class="carousel-item active">
          <div class="carousel-caption">
            <div class="d-flex flex-column justifify-content-center
                    align-items-center">
              <h1 class="align-self-center year"> <span style="color:rgb(22, 155, 243);"><%= club.name %></span>
                <br>
                Board Members <br> Year 2021-2022</h1>
            </div>
          </div>
        </div>
        <% for(let i=0; i <club.boardMembers.length ; i++){ %>
        <div class="carousel-item">
          <div class="carousel-caption">
            <div class="py-3">
              <img src="<%= club.boardMembers[i].imageUrl %>" />
              <div id="image-caption" class="">
                <h3 class="position"><%= positions[i] %> <br><span class="member-name"><%=
                                  club.boardMembers[i].name +" "+
                                  club.boardMembers[i].surname%> </span></h3>
              </div>
            </div>
            <p>
              <%= club.boardMembers[i].about%>
              Lorem Ipsum is simply dummy text of the printing
              and
              typesetting industry.
            </p>
            <!-- Social media -->
            <div class="social-media-icons align-self-center">
              <!-- Mail -->
              <a class="btn btn-outline-light btn-floating m-2" href="mailto:<%= club.boardMembers[i].email %>"
                target="_blank" role="button" id="user_mail"><i class="fas fa-at"></i></a>

              <!-- Facebook -->
              <a class="btn btn-outline-light btn-floating" href="<%=
                                club.boardMembers[i].facebookLink %>" id="m-facebook" role="button" target="_blank"><i
                  class="engclub-sm-icon fab fa-facebook-f"></i></a>
              <!-- Twitter -->
              <a class="btn btn-outline-light btn-floating" href="<%=
                                club.boardMembers[i].twitterLink %>" id="m-twitter" target="_blank" role="button"><i
                  class="engclub-sm-icon fab fa-twitter"></i></a>
              <!--  Linkedin -->
              <a class="btn btn-outline-light btn-floating" href="<%=
                                club.boardMembers[i].linkedIn%>" target="_blank" role="button" id="m-linkedIn"><i
                  class="engclub-sm-icon fab fa-linkedin-in"></i></a>
              <!-- whatsapp -->
              <a class="btn btn-outline-light btn-floating" href="<%=
                                club.boardMembers[i].whatsAppLink %>" role="button" id="m-whatsapp" target="_blank"><i
                  class="engclub-sm-icon fa fa-whatsapp"></i></a>
            </div>
          </div>
        </div>
        <% } %>
      </div>
      <a class="carousel-control-prev" href="#customers-cards" data-bs-slide="prev">
        <i class="fas carousel-button fa-arrow-left"></i>
      </a>
      <a class="carousel-control-next" href="#customers-cards" data-bs-slide="next">
        <i class="fas carousel-button fa-arrow-right"></i>
      </a>
    </div>
  </div>
</div>

<!-- Clubs Activities -->
<h1 class="common-heading">
  <span class="underline"></span>English Club Activities<span class="underline"></span>
</h1>
<div class="main-content-wrapper">
  <div class="row">
    <div class="col-lg-9 activities-wrapper py-3">
      <section id="news-wrapper">
        <h1 class="activity-heading">News</h1>
        <div class="d-flex justifify-content-center">
          <div class="row">
            <% for(let i =0; i < 3 ; i++){ %>
            <div class="col-md-6 col-lg-4">
              <div class="card news-card">
                <img src="<%= club.articles[i].articleImage %>" class="card-img-top img-thumbnail" alt="">
                <div class="card-body">
                  <h5 class="card-title news-title"><%=club.articles[i].title %></h5>
                  <p class="card-text news-summary"><%= club.articles[i].articleSummary %></p>
                  <!-- Button trigger modal -->
                  <button type="button" class="btn btn-small
                                      btn-primary" data-bs-toggle="modal" data-bs-target="#N<%= club.articles[i]._id %>">
                    Read more
                  </button>

                  <!-- Modal -->
                  <div class="modal fade" id="N<%= club.articles[i]._id %>" tabindex="-1" aria-labelledby="exampleModalLabel"
                    aria-hidden="true">
                    <div class="modal-dialog modal-lg
                                        modal-fullscreen-md-down">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title" id="exampleModalLabel">
                            <%= club.articles[i].title %>
                          </h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                          <div>

                            <%- club.articles[i].articleContent%>


                          </div>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn
                                              btn-danger" data-bs-dismiss="modal">Close</button>
                        </div>
                      </div>
                    </div>
                  </div>
                  <hr>
                  <p class="card-text"><small class="text-muted"><%= days[club.articles[i].postedAT.getDay()] %>,
                      <%=club.articles[i].postedAT.getDate()%>
                      <%= months[club.articles[i].postedAT.getMonth()] %>
                      <%=club.articles[i].postedAT.getFullYear()%></small><em class="mx-3"> <br> By
                      <%= club.articles[i].articleAuthor %></em></p>
                </div>
              </div>
            </div>
            <% } %>
          </div>
      </section>

