</div>

<!-- nav section -->
<ul id="activities" class="english-club-nav nav py-3 justify-content-around">
	<li class="nav-item">
		<a class="nav-link engClub-nav-link active" aria-current="page" href="#news-wrapper">News</a>
	</li>
