<% layout('layouts/engClubBoilerplate') %>
<!-- WORD Processor-->
<script src="https://cdn.tiny.cloud/1/p06f8vxdpje8xosyvnq48z68vc7n479iauh5s2jk9zx30qg2/tinymce/5/tinymce.min.js"
  referrerpolicy="origin"></script>
</script>
<script>
  tinymce.init({
    selector: '#mytextarea'
  });
</script>

<link href="/stylesheets/englishforAll/englishClubs/show.css" rel="stylesheet" />
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />

<!-- Banner section -->
<div class="row">
  <div class="col-lg-4">
    <div class="english-club-info">
      <div class="club-logos-wrapper">
        <img class="school-logo img-thumbnail" src="<%= club.instituitionLogoUrl %> " alt="" />
        <img class="club-logo img-thumbnail" src="<%=club.logoImageUrl%>" alt="" />
      </div>
      <div class="club-info">
        <h1 class="club-name"><%=club.name%></h1>
        <p class="club-motto"><%=club.motto %></p>
      </div>
      <div class="social-links mb-1">
        <!-- Social media -->
        <h3 class="social-links-header" class="mb-2">
          Join us on social media
        </h3>
        <div class="social-media-icons">
          <!-- Facebook -->
          <a class="btn btn-outline-light btn-floating m-2" href="" id="facebook" role="button" target="_blank"><i
              class="engclub-sm-icon fab fa-facebook-f"></i></a>

          <!-- Twitter -->
          <a class="btn btn-outline-light btn-floating m-2" href="#!" id="twitter" target="_blank" role="button"><i
              class="engclub-sm-icon fab fa-twitter"></i></a>

          <!-- Google -->
          <!-- <a
			  class="btn btn-outline-light btn-floating m-2"
			  href="#!"
			  target="_blank"
			  role="button"
			  ><i class="fab fa-google"></i
			></a> -->
          <!-- Instagram -->
          <a class="btn btn-outline-light btn-floating m-2" href="#!" role="button" id="instagram" target="_blank"><i
              class="engclub-sm-icon fab fa-instagram"></i></a>

          <!-- Linkedin -->
          <!-- <a
          class="btn btn-outline-light btn-floating m-2"
          href="#!"
          target="_blank"
          role="button"
          id="linkedIn"
          ><i class="engclub-sm-icon fab fa-linkedin-in"></i
        ></a> -->
          <!-- Youtube -->
          <a class="btn btn-outline-light btn-floating m-2" href="" role="button" id="youtube" target="_blank"><i
              class="engclub-sm-icon bi bi-youtube"></i></a>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-8">
    <div id="banner">
      <div class="bg-img-wrapper">
        <img class="img-small"
          src="https://images.unsplash.com/photo-1573166953836-06864dc70a21?ixid=MnwxMjA3fDB8MHxzZWFyY2h8ODV8fGFmcmljYW4lMjBnaXJsfGVufDB8fDB8fA%3D%3D&ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=60"
          alt="" />
        <img class="img-medium"
          src="https://images.unsplash.com/photo-1516182823370-7a5fa91445c3?ixlib=rb-1.2.1&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=1770&q=80"
          alt="" />
      </div>
    </div>
  </div>
</div>

<!-- nav section -->
<ul id="activities" class="english-club-nav nav py-3
        justify-content-around">
  <li class="nav-item">
    <a class="nav-link engClub-nav-link active" aria-current="page" href="#news-wrapper">News</a>
  </li>
  <li class="nav-item">
    <a class="nav-link engClub-nav-link" href="#lesson-wrapper">Lessons</a>
  </li>
  <li class="nav-item">
    <a class="nav-link engClub-nav-link" href="#weekly-activities-wrapper">Weekly
      Activities</a>
  </li>
  <li class="nav-item">
    <a class="nav-link engClub-nav-link" href="#media-wrapper">Media</a>
  </li>
</ul>

<!-- board section -->
<h1 class="common-heading">
  <span class="underline"></span>Board Members<span class="underline"></span>
</h1>
<div class="customer-section">
  <div class="container">
    <div id="customers-cards" class="carousel slide" data-bs-ride="carousel">
      <div class="carousel-inner">
        <div class="carousel-item active">
          <div class="carousel-caption">
            <div class="d-flex flex-column justifify-content-center
                    align-items-center">
              <h1 class="align-self-center year"> <span style="color:rgb(22, 155, 243);"><%= club.name %></span>
                <br>
                Board Members <br> Year 2021-2022</h1>
            </div>
          </div>
        </div>
        <% for(let i=0; i <club.boardMembers.length ; i++){ %>
        <div class="carousel-item">
          <div class="carousel-caption">
            <div class="py-3">
              <img src="<%= club.boardMembers[i].imageUrl %>" />
              <div id="image-caption" class="">
                <h3 class="position"><%= positions[i] %> <br><span class="member-name"><%=
                                  club.boardMembers[i].name +" "+
                                  club.boardMembers[i].surname%> </span></h3>
              </div>
            </div>
            <p>
              <%= club.boardMembers[i].about%>
              Lorem Ipsum is simply dummy text of the printing
              and
              typesetting industry.
            </p>
            <!-- Social media -->
            <div class="social-media-icons align-self-center">
              <!-- Mail -->
              <a class="btn btn-outline-light btn-floating m-2" href="mailto:<%= club.boardMembers[i].email %>"
                target="_blank" role="button" id="user_mail"><i class="fas fa-at"></i></a>

              <!-- Facebook -->
              <a class="btn btn-outline-light btn-floating" href="<%=
                                club.boardMembers[i].facebookLink %>" id="m-facebook" role="button" target="_blank"><i
                  class="engclub-sm-icon fab fa-facebook-f"></i></a>
              <!-- Twitter -->
              <a class="btn btn-outline-light btn-floating" href="<%=
                                club.boardMembers[i].twitterLink %>" id="m-twitter" target="_blank" role="button"><i
                  class="engclub-sm-icon fab fa-twitter"></i></a>
              <!--  Linkedin -->
              <a class="btn btn-outline-light btn-floating" href="<%=
                                club.boardMembers[i].linkedIn%>" target="_blank" role="button" id="m-linkedIn"><i
                  class="engclub-sm-icon fab fa-linkedin-in"></i></a>
              <!-- whatsapp -->
              <a class="btn btn-outline-light btn-floating" href="<%=
                                club.boardMembers[i].whatsAppLink %>" role="button" id="m-whatsapp" target="_blank"><i
                  class="engclub-sm-icon fa fa-whatsapp"></i></a>
            </div>
          </div>
        </div>
        <% } %>
      </div>
      <a class="carousel-control-prev" href="#customers-cards" data-bs-slide="prev">
        <i class="fas carousel-button fa-arrow-left"></i>
      </a>
      <a class="carousel-control-next" href="#customers-cards" data-bs-slide="next">
        <i class="fas carousel-button fa-arrow-right"></i>
      </a>
    </div>
  </div>
</div>

<!-- Clubs Activities -->
<h1 class="common-heading">
  <span class="underline"></span>English Club Activities<span class="underline"></span>
</h1>
<div class="main-content-wrapper">
  <div class="row">
    <div class="col-lg-9 activities-wrapper py-3">
      <section id="news-wrapper">
        <h1 class="activity-heading">News</h1>
        <div class="d-flex justifify-content-center">
          <div class="row">
            <% for(let article of club.articles ){ %>
            <div class="col-md-6 col-lg-4">
              <div class="card news-card">
                <img src="<%= article.articleImage %>" class="card-img-top img-thumbnail" alt="">
                <div class="card-body">
                  <h5 class="card-title news-title"><%= article.title %></h5>
                  <p class="card-text news-summary"><%= article.articleSummary %></p>
                  <!-- Button trigger modal -->
                  <button type="button" class="btn btn-small
                                      btn-primary" data-bs-toggle="modal" data-bs-target="#N<%= article._id %>">
                    Read more
                  </button>

                  <!-- Modal -->
                  <div class="modal fade" id="N<%= article._id %>" tabindex="-1" aria-labelledby="exampleModalLabel"
                    aria-hidden="true">
                    <div class="modal-dialog modal-lg
                                        modal-fullscreen-md-down">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title" id="exampleModalLabel">
                            <%= article.title %>
                          </h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                          <div>

                            <%- article.articleContent%>


                          </div>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn
                                              btn-danger" data-bs-dismiss="modal">Close</button>
                        </div>
                      </div>
                    </div>
                  </div>
                  <hr>
                  <p class="card-text"><small class="text-muted"><%= days[article.postedAT.getDay()] %>,
                      <%=article.postedAT.getDate()%>
                      <%= months[article.postedAT.getMonth()] %>
                      <%=article.postedAT.getFullYear()%></small><em class="mx-3"> <br> By
                      <%= article.articleAuthor %></em></p>
                </div>
              </div>
            </div>
            <% } %>
          </div>
      </section>

      <!-- Lessons section -->
      <section id="lesson-wrapper">
        <h1 class="activity-heading">Weekly Lessons</h1>
        <div class="container">
          <div class="lesson-links">
            <div>
              <div class="lesson-wrapper my-3">
                <h4 class="week-lesson-title"><%= club.weeklyVideoLesson[0].lessonTitle %> </h4>
                <p>
                  <%- club.weeklyVideoLesson[0].lessonSummary%>
                </p>
                <button type="button" class="btn ms-2 video-btn btn-outline-primary" data-bs-toggle="modal"
                  data-bs-target="#lesson-1-vid-1">
                  Click to watch the video lesson
                </button>
                <hr>
              </div>
              <div class="lesson-wrapper my-3">
                <h4 class="week-lesson-title"><%= club.weeklyVideoLesson[1].lessonTitle %></h4>
                <p>
                  <%- club.weeklyVideoLesson[1].lessonSummary%>
                </p>`
                <button type="button" class="btn video-btn ms-2 btn-outline-primary" data-bs-toggle="modal"
                  data-bs-target="#lesson-1-vid-2">
                  Click to watch the video lesson
                </button>
              </div>
            </div>
            <!-- Modal  for video 1-->
            <div class="modal fade" id="lesson-1-vid-1" tabindex="-1" aria-labelledby="exampleModalLabel"
              aria-hidden="true">
              <div class="modal-dialog modal-lg">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title text-primary" id="exampleModalLabel">
                      <%= club.weeklyVideoLesson[0].lessonTitle %>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body">
                    <div id="tv-container">
                      <div id="monitor">
                        <div class="afrohk-TV">
                          <h3 class="text-center afrohk-text mb-2 py-0"><span class="afrohk">AfroHK</span><span
                              class="tv">Radar</span>
                          </h3>
                        </div>
                        <div id="monitorscreen">
                          <iframe id="vimeo-content" src="<%= club.weeklyVideoLesson[0].videoLink %>" frameborder="0"
                            height="500px" width="1000px" allow="autoplay; fullscreen; picture-in-picture"
                            allow="fullscreen" title="High-intensity Classes"></iframe>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">
                      Close
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Modal  for video 2-->
            <div class="modal fade" id="lesson-1-vid-2" tabindex="-1" aria-labelledby="exampleModalLabel"
              aria-hidden="true">
              <div class="modal-dialog modal-lg">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title text-primary" id="exampleModalLabel">
                      <%= club.weeklyVideoLesson[1].lessonTitle %>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body">
                    <div id="tv-container">
                      <div id="monitor">
                        <div class="afrohk-TV">
                          <h3 class="text-center afrohk-text mb-2 py-0"><span class="afrohk">AfroHK</span><span
                              class="tv">Radar</span>
                          </h3>
                        </div>
                        <div id="monitorscreen">
                          <iframe id="vimeo-content" src="<%= club.weeklyVideoLesson[1].videoLink %>" frameborder="0"
                            height="500px" width="1000px" allow="autoplay; fullscreen; picture-in-picture"
                            allow="fullscreen" title="High-intensity Classes"></iframe>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">
                      Close
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Weekly activities section -->
      <section id="weekly-activities-wrapper">
        <h1 class="activity-heading">Weekly Activities</h1>
        <div class="accordion my-5" id="accordionExample">
          <div class="accordion-item">
            <h2 class="accordion-header" id="headingOne">
              <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne"
                aria-expanded="true" aria-controls="collapseOne">
                Grammar Check Point
              </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne"
              data-bs-parent="#accordionExample">
              <div class="accordion-body">
                <strong>Work in progress.</strong> 
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header" id="headingTwo">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                Vocabulary Builder
              </button>
            </h2>
            <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo"
              data-bs-parent="#accordionExample">
              <div class="accordion-body">
                <strong>Work in progress.</strong> 
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header" id="headingThree">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                Listening Challenge
              </button>
            </h2>
            <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree"
              data-bs-parent="#accordionExample">
              <div class="accordion-body">
                <strong>Work in progress.</strong> 
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header" id="headingFour">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                Reading Practice
              </button>
            </h2>
            <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour"
              data-bs-parent="#accordionExample">
              <div class="accordion-body">
                <strong>Work in progress.</strong> 
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Top stories section -->
      <!-- <section id="top-stories-wrapper">
        <h1 class="activity-heading">Top Stories</h1>
      </section> -->

      <!-- Media section -->
      <section id="top-stories-wrapper">
        <h1 class="activity-heading">Media</h1>
        <div class="row mt-4">
          <% for(let i = 0 ; i < 2 ; i++){ %> 
          <div class="col-md-6 my-3">
            <div class="media-card py-1">
              <!--  <div class="card-body"> -->
              <div id="tv-container">
                <div id="monitor">
                  <div class="afrohk-TV">
                    <h3 class="text-center afrohk-text mb-2 py-0"><span class="afrohk">AfroHK</span><span
                        class="tv">Radar</span>
                    </h3>
                  </div>
                  <div id="monitorscreen">
                    <iframe id="vimeo-content" width="100%" height="100%" src="<%= club.media[i].videoLink %>"
                      title="YouTube video player" frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; fullscreen; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen>
                    </iframe>
                  </div>
                </div>
              </div>
              <div class="video-details-wrapper m-0">
                <h5 class="text-center"><%= club.media[i].mediaTitle %></h5>
              </div>
              <!-- Button trigger modal -->
              <button type="button" class="btn mx-2 my-2 btn-outline-primary" data-bs-toggle="modal"
                data-bs-target="#mediaComment">Leave your feeling 🙃 </button>
              <!-- Modal -->
              <div class="modal fade" id="mediaComment" tabindex="-1" aria-labelledby="exampleModalLabel"
                aria-hidden="true">
                <div class="modal-dialog modal-lg">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title" id="exampleModalLabel">Club members' feeling</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      ...
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <% } %>
          <!--  </div> -->
        </div>
      </section>
    </div>

    <!-- Top events section -->
    <div class="col-lg-3 p-2 current-activity">
      <h1 class="current-activity-heading"><span>Top Events</span></h1>
      <div class="d-flex flex-column align-items-center
                            justify-content-center">
        <div class="student-OM">
          <div class="card m-2">
            <div class="card-header text-center
                                  student-month">
              Student of the Month
            </div>
            <div class="card-body">
              <div class="som-img-wrapper">
                <img src="<%= club.workersOfMonth[0].studentOfMonth.imageUrl %>" alt="" class="img-thumbnail img-fluid">
              </div>
              <h5 class="card-title"><%= club.workersOfMonth[0].studentOfMonth.fullname %></h5>
              <p class="card-text"><%= club.workersOfMonth[0].studentOfMonth.reasons %></p>
              <!-- Button trigger modal -->
              <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#som">
                Learn more about the SOM
              </button>

              <!-- Modal -->
              <div class="modal fade" id="som" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg
                                      modal-fullscreen-md-down">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title" id="exampleModalLabel">
                        All about the Student
                        of the Month
                      </h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <%- club.workersOfMonth[0].studentOfMonth.about %>

                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn
                                            btn-danger" data-bs-dismiss="modal">Close</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="instructor-OM">
          <div class="card m-2">
            <div class="card-header text-center
                                  instructor-month">
              Instructor of the Month
            </div>
            <div class="card-body">
              <div class="som-img-wrapper">
                <img src="<%= club.workersOfMonth[0].instructorOfMonth.imageUrl %>" alt=""
                  class="img-thumbnail img-fluid">
              </div>
              <h5 class="card-title"><%= club.workersOfMonth[0].instructorOfMonth.fullname%></h5>
              <p class="card-text"><%= club.workersOfMonth[0].instructorOfMonth.reasons %></p>
              <!-- Button trigger modal -->
              <button type="button" class="btn
                                    btn-secondary" data-bs-toggle="modal" data-bs-target="#iom">
                Learn more about the IOM
              </button>

              <!-- Modal -->
              <div class="modal fade" id="iom" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg
                                      modal-fullscreen-md-down">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title" id="exampleModalLabel">
                        All about the Instructor
                        of the Month
                      </h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <%- club.workersOfMonth[0].instructorOfMonth.about %>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn
                                            btn-danger" data-bs-dismiss="modal">Close</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
        <div class="daily-content">
          <div class="card m-2">
            <div class="card-header text-center word-day">
              Vocabulary Cookies
            </div>
            <div class="card-body">
              <h5 class="card-title word-day-title py-2"><span class="fw-bold">Word :</span>
                <%= club.weeklyActivity[0].wordOfDay.word %> </h5>
              <p class="card-text word-day-meaning"><span class="fw-bold">Meaning : </span>
                <%= club.weeklyActivity[0].wordOfDay.wordMeaning %>
              </p>
              <hr>
              <h5 class="card-title idioms-title py-2"><span class="fw-bold">Idioms :
                  <%= club.weeklyActivity[0].IdiomDay.idiom %> </span>
              </h5>
              <p class="card-text word-day-meaning"><span class="fw-bold">Meaning : </span>
                <%= club.weeklyActivity[0].IdiomDay.idiomMeaning %>
              </p>
              <!-- Button trigger modal -->
              <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#wod-1">
                Practice with examples
              </button>

              <!-- Modal -->
              <div class="modal fade" id="wod-1" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg
                                      modal-fullscreen-md-down">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title" id="exampleModalLabel">
                        Practice with examples
                      </h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <p> <%- club.weeklyActivity[0].wordOfDay.learnMoreWord %>
                      </p>
                      <hr>
                      <p> <%- club.weeklyActivity[0].IdiomDay.learnMoreIdiom %> </p>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn
                                            btn-danger" data-bs-dismiss="modal">Close</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="coming-activity">
          <div class="card m-2">
            <div class="card-header text-center incomming-activities">
              Incomming Activities
            </div>
            <div class="card-body">
              <div>
                <h3 class="card-title weekly-activity">Weekly English Club Meeting</h3>
                <h4 class="activity-date">
                  <%= days[club.weeklyActivity[0].englishClubMeeting.meetingDate.getDay()] %>,
                  <%=club.weeklyActivity[0].englishClubMeeting.meetingDate.getDate()%>
