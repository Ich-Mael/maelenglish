  <h1 class="section-title">Club Best Moments</h1>
  <div class="container p-3">
    <div class="gallery-container">
      <div class="gallery-card">
        <img
          src="https://images.pexels.com/photos/936048/pexels-photo-936048.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2">
