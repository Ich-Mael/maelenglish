<% layout('layouts/boilerplate') %>
<link href="/stylesheets/englishforAll/englishClubs/clubHome.css" rel="stylesheet" />
<!-- swiper-->
<link rel="stylesheet" href="https://unpkg.com/swiper@8/swiper-bundle.min.css" />

<div class="">
  <div id="banner">
    <div class="bg-img-wrapper">
      <img class="img-medium" src="<%= club.bannerImageUrlMedium %>" alt="" />
    </div>
    <div class="club-info">
      <h1 class="club-name">
        <%=club.name%>
      </h1>
      <p class="club-motto">
        <%=club.motto %>
      </p>
      <div class="d-flex justify-content-center py-3">
        <a class="btn btn-outline-success fs-5"
          href="/englishlang4all/clubs/<%= hub.cityName %>/hub/<%= hub._id %>/club/<%= club._id %>">Get in</a>
      </div>
    </div>
  </div>
</div>

<!-- Team -->
<section id="team">
  <h1 class="section-title">Meet Our Staff Members</h1>
  <!-- Swiper -->
  <div class="swiper col-lg-10 container myTeamSwiper">
    <div class="swiper-wrapper">
      <% for(let i=0; i < club.boardMembers.length ; i++){ %>
      <!--President-->
      <div class="swiper-slide">
        <div class="team-image-wrapper">
          <img class="team-img img-fluid" src="<%= club.boardMembers[i].clubMember.imageUrl %>" alt="">
          <div>
            <div class="team-member-info">
              <h6 class="position"><%= club.boardMembers[i].position %></h6>
              <div class="d-flex justifify-content-center ">
                <div class="team-position-line"></div>
              </div>
              <p class="team-member-name"><%=
                club.boardMembers[i].clubMember.name +" "+
                club.boardMembers[i].clubMember.surname%></p>
              <div class="d-flex w-100 member-social justify-content-around">
                <a target="_blank" class="d-block" href="mailto:ismaelzerbo_18@outlook.com?"><i
                    class="fa-solid fa-envelope"></i></a>

                <a target="_blank" class="d-block" href="https://www.linkedin.com/in/ismael-zerbo-0839a3174/"><i
                    class="fa-brands fa-linkedin"></i></a>

                <a target="_blank" class="d-block" href="https://wa.me/22664350101"><i
                    class="fa-brands fa-whatsapp"></i></a>
              </div>
            </div>

          </div>
        </div>
      </div>
      <%}%>
    </div>
    <div class="swiper-pagination"></div>
  </div>
  <hr>
  <div class="d-flex py-3 justify-content-around">
  <!-- Button trigger modal -->
<button type="button" class="btn club-dean mx-2 btn-primary" data-bs-toggle="modal" data-bs-target="#mentor">
  Mentor
</button>
<button type="button" class="btn club-dean mx-2 btn-primary" data-bs-toggle="modal" data-bs-target="#engCoach">
English Coach
</button>
</div>

<!-- Modal -->
<div class="modal fade" id="mentor" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">Mentor</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
      <div class="row mx-2"  style="background: #6190E8;  /* fallback for old browsers */
      background: -webkit-linear-gradient(to right, #A7BFE8, #6190E8);  /* Chrome 10-25, Safari 5.1-6 */
      background: linear-gradient(to right, #A7BFE8, #6190E8); /* W3C, IE 10+/ Edge, Firefox 16+, Chrome 26+, Opera 12+, Safari 7+ */
      ">
<div class="col-md-5 px-0">
  <div class="dean-img-wrapper">
    <img class="img-medium" src="https://images.unsplash.com/photo-1573496799652-408c2ac9fe98?ixlib=rb-1.2.1&ixid=MnwxMjA3fDB8MHxzZWFyY2h8MTB8fHRlYWNoZXJ8ZW58MHx8MHx8&auto=format&fit=crop&w=800&q=60" alt="" />
    </div>
  </div>
  <div class="col-md-7">

  </div>
  </div>
  </div>
  <div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
  </div>
  </div>
  </div>
  </div>

  <!-- Eng coach-->
  <div class="modal fade" id="engCoach" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog  modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="exampleModalLabel">English Coaches</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="row mx-2"  style="background: #6190E8;  /* fallback for old browsers */
          background: -webkit-linear-gradient(to right, #A7BFE8, #6190E8);  /* Chrome 10-25, Safari 5.1-6 */
          background: linear-gradient(to right, #A7BFE8, #6190E8); /* W3C, IE 10+/ Edge, Firefox 16+, Chrome 26+, Opera 12+, Safari 7+ */
          ">
    <div class="col-md-5 px-0">
      <div class="dean-img-wrapper">
        <img class="img-medium" src="https://images.unsplash.com/photo-1632678548683-b6c77b8e40bc?ixlib=rb-1.2.1&ixid=MnwxMjA3fDB8MHxzZWFyY2h8OXx8YmxhY2slMjB0ZWFjaGVyfGVufDB8fDB8fA%3D%3D&auto=format&fit=crop&w=800&q=60" alt="" />
        </div>
      </div>
      <div class="col-md-7">
    
      </div>
      </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- English club rules -->
<section class="club-info">
  <h1 class="section-title">About us</h1>
  <div class="container">
    <div id="tv-container">
      <div id="monitor">
        <div class="afrohk-TV">
          <h3 class="text-center afrohk-text mb-2 py-0"><span class="afrohk">AfroHK</span><span class="tv">Radar</span>
          </h3>
        </div>
        <div id="monitorscreen">
          <iframe id="vimeo-content" width="100%" height="100%" src="" title="YouTube video player" frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; fullscreen; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen>
          </iframe>
        </div>
      </div>
    </div>
  </div>
  <h2 class="need-to-know">What you need to know</h2>
  <div class="club-description">
    <div class="container col-md-8 py-5">
      <%-club.description%>
    </div>
  </div>
</section>

<section id="Coming-Events" class="">
  <h1 class="section-title">Upcoming Public Events</h1>
  <div class="container pt-5">
    <div class="row mb-5">
      <div class="col-lg-6" data-aos="fade-right" data-aos-easing="linear" data-aos-duration="500">
        <h2 class="event-title px-4">Female Leadership in action</h2>
        <div>
          <h4 class="event-summary">Know more</h4>
          <p class="event-paragraph">The Front-end Queens Coding Bootcamp is a beginner-friendly bootcamp
            for girls
            aiming at breaking the myth about coding. It focuses on web design and introduces smoothly
            participants to the world of programming. <br> The bootcamp is intensive and lasts one
            month. At the end,
            participants will be able to use the knowledge they have gained to work on real world
            projects</p>

        </div>
      </div>
      <div class="col-lg-6">
        <div class="event-img-wrapper" data-aos="fade-left" data-aos-easing="linear" data-aos-duration="500">
          <img src="https://images.pexels.com/photos/1181609/pexels-photo-1181609.jpeg?auto=compress&cs=tinysrgb&w=800"
            class="img-fluid event-img" alt="">
        </div>
      </div>
    </div>
    <div class="event-info-details">
      <div class="container">
        <h3 class="registration-info">Event Details</h3>
        <div class="event-info-wrapper">
          <h5 class="event-date"> <span class="start-date ">Date</span> Sunday, April
            24, 2022
          </h5>
          <h5 class="event-date"> <span class="start-date "> Time</span> 3:00 pm </h5>
          <h5 class="event-date"> <span class="start-date "> Venue</span> American Corner</h5>
          <h5 class="event-date"> <span class="start-date "> Entry</span> Free</h5>

        </div>
        <p class="event-line"></p>
      </div>
    </div>
  </div>
</section>

