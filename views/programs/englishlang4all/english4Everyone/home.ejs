<% layout('layouts/boilerplate') %>


<style>
    html {
        font-size: 90%;
    }

    .wrapper {
        background: url("https://www.goatsontheroad.com/wp-content/uploads/2020/02/online-english-lesson-plan.jpg");
        background-size: cover;
        -webkit-background-size: cover;
        -moz-background-size: cover;
        -o-background-size: cover;
        background-position: center center;
        height: 56vh;
    }

    .eng-title {
        color: rgb(58, 57, 56);
        text-transform: uppercase;
        text-align: center;
        padding: 3rem 0;
        font-size: 2rem;
        font-family: Georgia, 'Times New Roman', Times, serif;
    }

    .card-wrapper {
        box-shadow: rgba(0, 0, 0, 0.16) 0px 3px 6px, rgba(0, 0, 0, 0.23) 0px 3px 6px;
        margin: 0 1rem;
        border-radius: 0.3rem;
    }

    .card-wrapper img {
        height: 15rem;
        width: 100%;
    }

    .level {
        font-family: Georgia, 'Times New Roman', Times, serif;
        color: rgb(255, 255, 255);
        text-align: center;
        padding: 1rem 0;
        text-transform: uppercase;
        letter-spacing: 0.2rem;
    }

    .beg {
        background: #007991;
        /* fallback for old browsers */
        background: -webkit-linear-gradient(to right, #007991, rgb(66, 141, 119)6, #007991);
        /* Chrome 10-25, Safari 5.1-6 */
        background: linear-gradient(to right, #007991, #2b6352, #007991);
        /* W3C, IE 10+/ Edge, Firefox 16+, Chrome 26+, Opera 12+, Safari 7+ */
    }

    .int {
        background: #4568DC;
        /* fallback for old browsers */
        background: -webkit-linear-gradient(to right, #4568DC, #79487a, #4568DC);
        /* Chrome 10-25, Safari 5.1-6 */
        background: linear-gradient(to right, #4568DC, #613a63, #4568DC);
        /* W3C, IE 10+/ Edge, Firefox 16+, Chrome 26+, Opera 12+, Safari 7+ */
    }

    .adv {
        background: #C04848;
        /* fallback for old browsers */
        background: -webkit-linear-gradient(to right, #480048, #C04848);
        /* Chrome 10-25, Safari 5.1-6 */
        background: linear-gradient(to right, #480048, #C04848);
        /* W3C, IE 10+/ Edge, Firefox 16+, Chrome 26+, Opera 12+, Safari 7+ */
    }
</style>
<div class="wrapper">
</div>
<h1 class="eng-title">Anglais Pour tous les niveaux</h1>
<div class="container mb-5">
    <div class="row">
        <div class="col-md-4">
            <div class="card-wrapper">
                <img class="img-fluid img-thumbnail"
                    src="https://hh-certificates.sgp1.digitaloceanspaces.com/blog/wp-content/uploads/2020/05/12111240/Teach-English-To-Beginners.jpg"
                    alt="">
                <h3 class="level beg">Débutant</h3>
                <a href="" class="mb-2 mx-2 btn btn-primary">En savoir plus</a>
                <hr>
                <!-- <a href="" class="mb-2 mx-2 btn btn-outline-success">Témoignage</a> -->
                <a href="" class="mb-2 mx-2 btn btn-outline-success">Etudier</a>
                <a href="" class="mb-2 mx-2 btn btn-outline-success">S'inscrire</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-wrapper">
                <img class="img-fluid img-thumbnail"
                    src="https://heritageinstitute.in/wp-content/uploads/2019/01/Pre-Intermediate-English.png" alt="">
                <h3 class="level int">Intermediare</h3>
                <a href="" class="mb-2 mx-2 btn btn-primary">En savoir plus</a>
                <hr>
                <!-- <a href="" class="mb-2 mx-2 btn btn-outline-success">Témoignage</a> -->
                <a href="" class="mb-2 mx-2 btn btn-outline-success">Etudier</a>
                <a href="" class="mb-2 mx-2 btn btn-outline-success">S'inscrire</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-wrapper">
                <img class="img-fluid img-thumbnail" src="https://www.ohipopo.org/my_media/2020/05/ENGLISH-AL.jpg"
                    alt="">
                <h3 class="level adv">Avancé</h3>
                <a href="" class="mb-2 mx-2 btn btn-primary">En savoir plus</a>
                <hr>
                <!-- <a href="" class="mb-2 mx-2 btn btn-outline-success">Témoignage</a> -->
                <a href="" class="mb-2 mx-2 btn btn-outline-success">Etudier</a>
                <a href="" class="mb-2 mx-2 btn btn-outline-success">S'inscrire</a>
            </div>
        </div>
    </div>
</div>