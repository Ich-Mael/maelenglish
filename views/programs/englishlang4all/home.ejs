<% layout('layouts/boilerplate') %>
<link rel="preconnect" href="https://fonts.gstatic.com" />
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
<link href="/stylesheets/englishforAll/home.css" rel="stylesheet" />
<div data-aos="zoom-out" data-aos-delay="100" data-aos-duration="1800" class="header-wrapper">
  <div class="bg-img-wrapper">
    <img class="img-small"
      src="https://images.unsplash.com/photo-1593698054469-2bb6fdf4b512?ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&ixlib=rb-1.2.1&auto=format&fit=crop&w=774&q=80"
      alt="" />
    <img class="img-medium"
      src="https://images.pexels.com/photos/3810795/pexels-photo-3810795.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=750&w=1260"
      alt="" />
  </div>
  <div class="banner-wrapper d-flex align-items-center flex-column">
    <h1 class="banner-heading">House Of English Lovers</h1>
    <p class="banner-paragraph">
      Master English Now Than Ever Before
    </p>
    <div class="account-wrapper">
      <% if (!currentUser || currentUser === undefined) {%>
      <a class="get-account" href="/register">Get Started Now</a>

      <%} else { %>
      <a class="check-programs" href="#program"> Our English Programs</a>
      <%}%>
      </div>
  </div>
</div>

