      <!-- Cercle trigonométrique (Trigonométrie mode only) -->
      <div class="ml-card" id="trig-circle-card" hidden>
        <h2><i class="bi bi-record-circle"></i> Cercle trigonométrique</h2>
        <div class="ml-hint" style="margin:-.3rem 0 1rem">Déplacez la souris (ou le doigt) sur le cercle : le point suit l'angle et affiche cos, sin et tan. Les valeurs exactes apparaissent sur les angles remarquables (30°, 45°, 60°…).</div>
        <div class="trig-wrap">
          <svg id="trig-svg" viewBox="0 0 340 340" role="img" aria-label="Cercle trigonométrique interactif">
