      return res;
    }

    // Synthetic (Horner) division of f(z)=a z³+b z²+c z+d by (z − z₀).
    // Returns the quotient coefficients {q0,q1,q2} (Q = q0 z² + q1 z + q2) and remainder.
    function syntheticDiv(z0str){
      var a = coefVal(eqaInput.value), b = coefVal(eqbInput.value), c = coefVal(eqcInput.value), d = coefVal(eqdInput.value);
      var z = coefVal(z0str);
      var q0 = a;
      var q1 = cAdd(b, cMul(q0, z));
      var q2 = cAdd(c, cMul(q1, z));
      var rem = cAdd(d, cMul(q2, z));
      return { q0: q0, q1: q1, q2: q2, rem: rem };
    }
    function solveQuad(q0, q1, q2){
      if(cIsZero(q0)){ // degree 1: q1 z + q2 = 0
        if(cIsZero(q1)) return [];
        return [cDiv({ re: -q2.re, im: -q2.im }, q1)];
      }
      var disc = cSub(cMul(q1, q1), cMul({ re: 4, im: 0 }, cMul(q0, q2)));
      var sq = cSqrt(disc), twoA = cMul({ re: 2, im: 0 }, q0);
      var negB = { re: -q1.re, im: -q1.im };
      return [cDiv(cAdd(negB, sq), twoA), cDiv(cSub(negB, sq), twoA)];
    }
    // Exact roots of a quadratic with INTEGER real coefficients — keeps the √ symbol.
    // Returns an array of plain expression strings (toLatex-renderable) or null.
    function igcd(x, y){ x = Math.abs(Math.round(x)); y = Math.abs(Math.round(y)); while(y){ var t = y; y = x % y; x = t; } return x; }
    function simplifyRadical(n){ var coef = 1, rad = n; for(var k = 2; k * k <= rad; k++){ while(rad % (k * k) === 0){ rad = rad / (k * k); coef = coef * k; } } return { coef: coef, rad: rad }; }
    function plainFrac(num, den){ var g = igcd(num, den) || 1; num = num / g; den = den / g; if(den < 0){ num = -num; den = -den; } return (den === 1) ? String(num) : (num + '/' + den); }
    function radRoot(nb, sgn, coef, rad, den, unit){ // (nb ± coef·unit·√rad)/den  (unit = '' real or 'i' complex)
      var g = igcd(igcd(Math.abs(nb), coef), den) || 1;
      var n2 = nb / g, c2 = coef / g, d2 = den / g;
      var r="";
      if(rad > 1) r = (c2 !== 1 ? (c2 + ' ') : '') + (unit ? unit + ' ' : '') + 'sqrt(' + rad + ')';
      else r = (c2 !== 1 ? (c2 + (unit ? ' ' : '')) : '') + (unit || (c2 === 1 ? '1' : ''));
      var num = (n2 === 0) ? ((sgn < 0 ? '-' : '') + r) : (n2 + (sgn < 0 ? ' - ' : ' + ') + r);
      return (d2 === 1) ? num : ('(' + num + ')/' + d2);
    }
    function exactQuadRoots(q0, q1, q2){
      function ni(x){ return Math.abs(x - Math.round(x)) < 1e-7; }
      if(Math.abs(q0.im) > 1e-7 || Math.abs(q1.im) > 1e-7 || Math.abs(q2.im) > 1e-7) return null;
      if(!ni(q0.re) || !ni(q1.re) || !ni(q2.re)) return null;
      var a = Math.round(q0.re), b = Math.round(q1.re), c = Math.round(q2.re);
      if(a === 0) return null;
      var D = b * b - 4 * a * c, den = 2 * a, nb = -b;
      if(den < 0){ den = -den; nb = -nb; }
      if(D === 0) return [ plainFrac(nb, den) ];
      if(D > 0){
        var sr = simplifyRadical(D);
        if(sr.rad === 1) return [ plainFrac(nb + sr.coef, den), plainFrac(nb - sr.coef, den) ];
        return [ radRoot(nb, 1, sr.coef, sr.rad, den, ''), radRoot(nb, -1, sr.coef, sr.rad, den, '') ];
      }
      var sr2 = simplifyRadical(-D);
      return [ radRoot(nb, 1, sr2.coef, sr2.rad, den, 'i'), radRoot(nb, -1, sr2.coef, sr2.rad, den, 'i') ];
    }
    function termStr(c, v){
      var cv = fmtComplexVal(c.re, c.im);
      if(v === '') return cv;
      if(cv === '1') return v;
      if(cv === '-1') return '-' + v;
      return (cv.indexOf(' ') >= 0 ? '(' + cv + ') ' : cv + ' ') + v;
    }
    function joinPoly(parts){
      if(parts.length === 0) return '0';
      var out = parts[0];
      for(var i = 1; i < parts.length; i++){ var p = parts[i]; out += (p.charAt(0) === '-') ? (' - ' + p.slice(1)) : (' + ' + p); }
      return out;
    }
    function fmtQuotient(q){
      var parts = [];
