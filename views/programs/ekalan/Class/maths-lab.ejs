<% layout('layouts/main') %>
<% title = 'Kalan Maths Lab' %>

<% headContent = `
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous">
  <style>
    #main { margin-top: 0 !important; padding-top: 0 !important; }
    .ml-page { margin-top:72px; background:#f6f7fb; min-height:calc(100vh - 72px); padding-bottom:4rem;
      font-family: system-ui,-apple-system,'Segoe UI',Roboto,sans-serif; color:#1f2937; }
    .ml-hero { color:#fff; padding:2.4rem clamp(1rem,4vw,3rem) 3.6rem; position:relative; overflow:hidden;
      background: radial-gradient(900px 480px at 88% -25%, rgba(168,85,247,.38), transparent 60%),
                  radial-gradient(680px 420px at 6% 125%, rgba(255,184,0,.16), transparent 58%),
                  linear-gradient(135deg,#160a33 0%,#2d0370 52%,#5d06ba 100%); }
    .ml-hero__glyphs { position:absolute; inset:0; pointer-events:none; overflow:hidden; z-index:0; }
    .ml-hero__glyphs span { position:absolute; font-family:'Times New Roman','Cambria Math',serif; font-weight:700;
      color:rgba(255,255,255,.06); line-height:1; user-select:none; animation:mlfloat 9s ease-in-out infinite; }
    .ml-hero__glyphs span:nth-child(2){ animation-delay:-1.5s; }
    .ml-hero__glyphs span:nth-child(3){ animation-delay:-3s; }
    .ml-hero__glyphs span:nth-child(4){ animation-delay:-4.5s; }
    .ml-hero__glyphs span:nth-child(5){ animation-delay:-6s; }
    .ml-hero__glyphs span:nth-child(6){ animation-delay:-7.5s; }
    @keyframes mlfloat { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-16px)} }
    .ml-hero__inner { max-width:1180px; margin:0 auto; position:relative; z-index:1; }
    .ml-crumb { display:inline-flex; align-items:center; gap:.45rem; color:rgba(255,255,255,.85); text-decoration:none;
      font-size:.9rem; font-weight:600; padding:.4rem .85rem; border-radius:999px; background:rgba(255,255,255,.12);
      border:1px solid rgba(255,255,255,.22); transition:background .2s, transform .2s; }
    .ml-crumb:hover { background:rgba(255,255,255,.22); color:#fff; transform:translateX(-3px); }
    .ml-hero__head { display:flex; align-items:flex-start; justify-content:space-between; gap:1.6rem;
      flex-wrap:wrap; margin-top:1.15rem; }
    .ml-hero__text { max-width:660px; }
    .ml-badge { display:inline-flex; align-items:center; gap:.4rem; font-size:.72rem; font-weight:800; letter-spacing:.05em;
      text-transform:uppercase; padding:.34rem .82rem; border-radius:999px;
      background:linear-gradient(135deg,#ffe680,#ffb800); color:#2d0370; box-shadow:0 4px 16px rgba(255,184,0,.45); }
    .ml-badge i { color:#2d0370; }
    .ml-hero__title { margin:.9rem 0 .55rem; font-size:clamp(1.9rem,4.6vw,3rem); font-weight:800;
      letter-spacing:-.02em; line-height:1.04; }
    .ml-hero__title .accent { background:linear-gradient(135deg,#ffe680,#ffb800); -webkit-background-clip:text;
      background-clip:text; -webkit-text-fill-color:transparent; color:transparent; }
    .ml-hero__sub { margin:0; font-size:clamp(.95rem,1.5vw,1.08rem); line-height:1.55; color:rgba(255,255,255,.82); max-width:560px; }
    .ml-hero__chips { display:flex; flex-wrap:wrap; gap:.5rem; margin-top:1.25rem; }
    .ml-chip { display:inline-flex; align-items:center; gap:.42rem; font-size:.82rem; font-weight:600;
      padding:.44rem .9rem; border-radius:999px; background:rgba(255,255,255,.1);
      border:1px solid rgba(255,255,255,.2); color:rgba(255,255,255,.92);
      -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px); }
    .ml-chip i { color:#ffd24a; font-size:.9rem; }
    .ml-hero__ai { display:inline-flex; align-items:center; gap:.7rem; padding:.85rem 1.1rem; border-radius:16px;
      background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.16);
      -webkit-backdrop-filter:blur(10px); backdrop-filter:blur(10px); font-size:.8rem; color:rgba(255,255,255,.82);
      box-shadow:0 8px 28px rgba(0,0,0,.18); line-height:1.25; }
    .ml-hero__ai i { font-size:1.55rem; color:#ffd24a; }
    .ml-hero__ai strong { display:block; color:#fff; font-weight:700; font-size:.95rem; }
    @media (max-width:560px){ .ml-hero__ai{ display:none; } }
    @media (prefers-reduced-motion:reduce){ .ml-hero__glyphs span{ animation:none; } }
    .ml-wrap { max-width:1180px; margin:0 auto; padding:0 clamp(1rem,4vw,3rem); }
    .ml-grid { display:flex; flex-direction:column; gap:1.5rem; margin-top:-1.5rem; position:relative; z-index:2; }
    .ml-card { background:#fff; border-radius:18px; box-shadow:0 10px 30px rgba(45,3,112,.1); padding:1.25rem; }
    .ml-card h2 { font-size:1.05rem; font-weight:700; color:#2d0370; margin:0 0 .9rem; display:flex; align-items:center; gap:.5rem; }
    .ml-modes { display:inline-flex; gap:.3rem; padding:.3rem; background:#f1ecfb; border:1px solid #e5dbf7;
      border-radius:12px; margin-bottom:1.1rem; flex-wrap:wrap; }
    .ml-mode { display:inline-flex; align-items:center; gap:.45rem; border:none; cursor:pointer; background:transparent;
      color:#5d06ba; font-weight:700; font-size:.9rem; padding:.55rem 1rem; border-radius:9px; transition:all .2s; }
    .ml-mode:hover { background:rgba(93,6,186,.08); }
    .ml-mode.is-active { background:linear-gradient(135deg,#ffe680,#ffb800); color:#2d0370;
      box-shadow:0 4px 14px rgba(255,184,0,.4); }
    .geo-row { display:flex; align-items:center; gap:.6rem; margin-bottom:.55rem; }
    .geo-row .geo-label { font-weight:700; color:#5d06ba; min-width:3.4rem; }
    .geo-row input { flex:1; min-width:140px; padding:.6rem .8rem; border:2px solid #e0e0e0; border-radius:10px;
      font-size:1rem; font-family:'Courier New',monospace; background:#fafafa; }
    .geo-row input:focus { outline:none; border-color:#5d06ba; background:#fff; }
    .geo-del { border:none; background:#f3effc; color:#9b87c4; width:2rem; height:2rem; border-radius:8px; cursor:pointer;
      font-size:1.1rem; line-height:1; flex:0 0 auto; transition:all .15s; }
    .geo-del:hover { background:#ffe0e0; color:#d33; }
    .geo-add { display:inline-flex; align-items:center; gap:.4rem; border:1px dashed #d9ccf5; background:#fbf9ff;
      color:#5d06ba; border-radius:10px; padding:.5rem .85rem; font-weight:600; font-size:.85rem; cursor:pointer; margin-bottom:1rem; }
    .geo-add:hover { background:#f1ecfb; }
    .geo-add:disabled { opacity:.45; cursor:not-allowed; }
    #ggb { width:100%; min-height:480px; border-radius:12px; overflow:hidden; }
    .ml-input-row { display:flex; gap:.6rem; align-items:center; margin-bottom:1rem; flex-wrap:wrap; }
    .ml-input-row label { font-weight:700; color:#5d06ba; }
    .ml-input-row input { flex:1; min-width:180px; padding:.7rem .9rem; border:2px solid #e0e0e0; border-radius:10px;
      font-size:1.05rem; font-family:'Courier New',monospace; background:#fafafa; }
    .ml-input-row input:focus { outline:none; border-color:#5d06ba; background:#fff; }
    .ml-plot { display:inline-flex; align-items:center; gap:.4rem; border:none; cursor:pointer;
      background:linear-gradient(135deg,#2d0370,#5d06ba); color:#fff; font-weight:700; font-size:.92rem;
      padding:.7rem 1.1rem; border-radius:10px; transition:filter .2s; white-space:nowrap; }
    .ml-plot:hover { filter:brightness(1.12); }
    .ml-plot:disabled { opacity:.5; cursor:not-allowed; }
    .ml-preview { min-height:2.4rem; margin:-.2rem 0 1rem; padding:.55rem .9rem; background:#faf7ff;
      border:1px dashed #d9ccf5; border-radius:10px; color:#2d0370; font-size:1.2rem; overflow-x:auto; }
    .ml-preview.is-empty { color:#b9a9dd; font-style:italic; font-size:.85rem; }
    .ml-keys { display:flex; flex-wrap:wrap; gap:.35rem; margin:-.4rem 0 1rem; }
    .ml-key { border:1px solid #e0d7f4; background:#fbf9ff; color:#3d2a66; border-radius:8px;
      min-width:2.2rem; padding:.4rem .5rem; font-size:1rem; line-height:1; cursor:pointer; transition:all .15s;
      font-family:'Times New Roman',serif; }
    .ml-key:hover { background:#5d06ba; color:#fff; border-color:#5d06ba; }
    .ml-key.is-fn { font-family:system-ui,sans-serif; font-size:.82rem; font-style:italic; }
    .ml-key.is-util { font-family:system-ui,sans-serif; font-size:.78rem; color:#9b87c4; }
    .ml-ops { display:flex; flex-wrap:wrap; gap:.5rem; }
    .ml-op { border:1px solid #d9ccf5; background:#f4eefe; color:#5d06ba; border-radius:10px; padding:.55rem .9rem;
      font-weight:600; font-size:.9rem; cursor:pointer; transition:all .2s; display:inline-flex; align-items:center; gap:.4rem; }
    .ml-op:hover { background:linear-gradient(135deg,#ffd700,#ffb800); color:#2d0370; border-color:#ffb800;
      box-shadow:0 4px 14px rgba(255,184,0,.35); }
    .ml-op:disabled { opacity:.5; cursor:not-allowed; }
    .ml-answer { margin-top:1rem; background:linear-gradient(135deg,#2d0370,#5d06ba); color:#fff; border-radius:14px;
      padding:1rem 1.2rem; border-left:4px solid #ffc400; box-shadow:0 6px 22px rgba(45,3,112,.18); }
    .ml-answer .lbl { font-size:.75rem; text-transform:uppercase; letter-spacing:.05em; font-weight:700; color:#ffd24a;
      display:inline-flex; align-items:center; gap:.35rem; }
    .ml-answer .val { font-size:1.4rem; margin-top:.25rem; }
    .ml-steps { margin-top:1rem; }
    .ml-step { border:1px solid #eee; border-left:4px solid #5d06ba; border-radius:10px; padding:.9rem 1.1rem; margin-bottom:.8rem; background:#fff; }
    .ml-step__title { font-weight:700; color:#2d0370; font-size:.95rem; margin-bottom:.4rem; }
    .ml-step__latex { margin:.3rem 0; font-size:1.05rem; }
    .ml-step__exp { color:#4b5563; font-size:.92rem; line-height:1.5; }
    .ml-state { color:#6b7280; font-size:.92rem; padding:.6rem 0; }
    .ml-spinner { display:inline-block; width:16px; height:16px; border:2px solid #d9ccf5; border-top-color:#5d06ba; border-radius:50%; animation:mlspin .7s linear infinite; vertical-align:-3px; margin-right:.4rem; }
    @keyframes mlspin { to { transform:rotate(360deg); } }
    .ml-warn { margin-top:1rem; display:flex; gap:.6rem; align-items:flex-start; background:#f3effc; border:1px solid #d9ccf5;
      border-radius:12px; padding:.7rem .9rem; color:#4a3a6b; font-size:.82rem; line-height:1.45; }
    .ml-warn i { color:#5d06ba; font-size:1.05rem; flex-shrink:0; margin-top:.05rem; }
    .ml-hint { font-size:.82rem; color:#6b7280; margin-top:.4rem; }
  </style>
` %>

<div class="ml-page">
  <header class="ml-hero">
    <div class="ml-hero__glyphs" aria-hidden="true">
      <span style="top:14%;left:5%;font-size:clamp(3rem,7vw,5.5rem)">&#8747;</span>
      <span style="top:58%;left:13%;font-size:clamp(2rem,4vw,3.2rem)">&#960;</span>
      <span style="top:16%;right:9%;font-size:clamp(3.5rem,8vw,6.5rem)">&#8706;</span>
      <span style="bottom:16%;right:24%;font-size:clamp(2.2rem,5vw,3.8rem)">&#8730;</span>
      <span style="top:60%;right:5%;font-size:clamp(2.8rem,6vw,4.6rem)">&#8734;</span>
      <span style="bottom:12%;left:42%;font-size:clamp(1.8rem,4vw,2.8rem)">&#931;</span>
    </div>
    <div class="ml-hero__inner">
      <a class="ml-crumb" href="/programs/ekalan/kalan/class/<%= schoolClass._id %>"><i class="bi bi-arrow-left"></i> Retour à la classe</a>
      <div class="ml-hero__head">
        <div class="ml-hero__text">
          <span class="ml-badge"><i class="bi bi-gem"></i> Kalan Ba · Kalan Naaba</span>
          <h1 class="ml-hero__title">Kalan <span class="accent">Maths Lab</span></h1>
          <p class="ml-hero__sub">Dérivées, asymptotes, limites, intégrales… résolues pas à pas, avec le raisonnement expliqué par l'IA. Un avantage réservé aux membres premium.</p>
          <div class="ml-hero__chips">
            <span class="ml-chip"><i class="bi bi-slash-lg"></i> Dérivées</span>
            <span class="ml-chip"><i class="bi bi-arrows-collapse"></i> Asymptotes</span>
            <span class="ml-chip"><i class="bi bi-infinity"></i> Limites</span>
            <span class="ml-chip"><i class="bi bi-integral"></i> Intégrales</span>
            <span class="ml-chip"><i class="bi bi-diagram-2"></i> Factorisation</span>
          </div>
        </div>
        <div class="ml-hero__ai">
          <i class="bi bi-stars"></i>
          <span>Étapes générées<br><strong>par l'IA</strong></span>
        </div>
      </div>
    </div>
  </header>

  <div class="ml-wrap">
    <div class="ml-grid">
      <!-- Controls + results -->
      <div class="ml-card">
        <div class="ml-modes" id="modes">
          <button type="button" class="ml-mode is-active" data-mode="function"><i class="bi bi-graph-up"></i> Fonctions</button>
          <button type="button" class="ml-mode" data-mode="complex"><i class="bi bi-asterisk"></i> Nombres complexes</button>
          <button type="button" class="ml-mode" data-mode="geometry"><i class="bi bi-triangle"></i> Géométrie</button>
        </div>

        <div id="mode-function">
        <h2><i class="bi bi-input-cursor-text"></i> Votre fonction</h2>
        <div class="ml-input-row">
          <label for="fx">f(x) =</label>
          <input id="fx" type="text" value="x^2" placeholder="ex : (x^2+1)/(x-1)" autocomplete="off" />
          <button type="button" class="ml-plot" id="plotBtn"><i class="bi bi-graph-up"></i> Tracer</button>
        </div>

        <div class="ml-preview is-empty" id="fxPreview">Aperçu de la fonction…</div>

        <div class="ml-keys" id="keys">
          <button type="button" class="ml-key" data-ins="x">x</button>
          <button type="button" class="ml-key" data-ins="x^2">x²</button>
          <button type="button" class="ml-key" data-ins="^">xⁿ</button>
          <button type="button" class="ml-key" data-ins="(|)/(|)">a⁄b</button>
          <button type="button" class="ml-key" data-ins="sqrt(|)">√</button>
          <button type="button" class="ml-key" data-ins="(|)">(&nbsp;)</button>
          <button type="button" class="ml-key" data-ins="+">+</button>
          <button type="button" class="ml-key" data-ins="-">−</button>
          <button type="button" class="ml-key" data-ins="*">×</button>
          <button type="button" class="ml-key" data-ins="pi">π</button>
          <button type="button" class="ml-key" data-ins="exp(|)">eˣ</button>
          <button type="button" class="ml-key is-fn" data-ins="ln(|)">ln</button>
          <button type="button" class="ml-key is-fn" data-ins="log(|)">log</button>
          <button type="button" class="ml-key is-fn" data-ins="abs(|)">|x|</button>
          <button type="button" class="ml-key is-fn" data-ins="sin(|)">sin</button>
          <button type="button" class="ml-key is-fn" data-ins="cos(|)">cos</button>
          <button type="button" class="ml-key is-fn" data-ins="tan(|)">tan</button>
          <button type="button" class="ml-key is-util" data-act="back">⌫</button>
          <button type="button" class="ml-key is-util" data-act="clear">C</button>
        </div>

        <div class="ml-ops" id="ops">
          <button class="ml-op" data-op="derivative"><i class="bi bi-slash-lg"></i> Dérivée f'(x)</button>
          <button class="ml-op" data-op="asymptotes"><i class="bi bi-arrows-collapse"></i> Asymptotes</button>
          <button class="ml-op" data-op="limit"><i class="bi bi-infinity"></i> Limite en +∞</button>
          <button class="ml-op" data-op="integral"><i class="bi bi-integral"></i> Intégrale</button>
          <button class="ml-op" data-op="solve"><i class="bi bi-check2-square"></i> Résoudre = 0</button>
          <button class="ml-op" data-op="factor"><i class="bi bi-diagram-2"></i> Factoriser</button>
          <button class="ml-op" data-op="expand"><i class="bi bi-arrows-angle-expand"></i> Développer</button>
        </div>
        </div><%# /mode-function %>

        <div id="mode-complex" hidden>
          <h2><i class="bi bi-asterisk"></i> Vos nombres complexes</h2>
          <div class="ml-input-row">
            <label for="z1">z₁ =</label>
            <input id="z1" type="text" value="3+4i" placeholder="ex : 3+4i" autocomplete="off" />
          </div>
          <div class="ml-input-row" id="z2-row" hidden>
            <label for="z2">z₂ =</label>
            <input id="z2" type="text" value="1-2i" placeholder="ex : 1-2i" autocomplete="off" />
          </div>
          <div class="ml-input-row" id="n-row" hidden>
            <label for="cn">n =</label>
            <input id="cn" type="number" value="3" min="2" max="12" step="1" style="flex:0 0 auto; min-width:0; max-width:120px" />
          </div>

          <div class="ml-preview is-empty" id="zPreview">Aperçu du nombre complexe…</div>

          <div class="ml-keys" id="ckeys">
            <button type="button" class="ml-key" data-cins="i">i</button>
            <button type="button" class="ml-key" data-cins="+">+</button>
            <button type="button" class="ml-key" data-cins="-">−</button>
            <button type="button" class="ml-key" data-cins="*">×</button>
            <button type="button" class="ml-key" data-cins="/">÷</button>
            <button type="button" class="ml-key" data-cins="(|)">(&nbsp;)</button>
            <button type="button" class="ml-key" data-cins="^">^</button>
            <button type="button" class="ml-key" data-cins="sqrt(|)">√</button>
            <button type="button" class="ml-key is-util" data-cact="back">⌫</button>
            <button type="button" class="ml-key is-util" data-cact="clear">C</button>
          </div>

          <div class="ml-ops" id="cops">
            <button class="ml-op" data-cop="modulus"><i class="bi bi-rulers"></i> Module |z|</button>
            <button class="ml-op" data-cop="argument"><i class="bi bi-compass"></i> Argument</button>
            <button class="ml-op" data-cop="conjugate"><i class="bi bi-arrow-left-right"></i> Conjugué</button>
            <button class="ml-op" data-cop="exp_form"><i class="bi bi-arrow-repeat"></i> Forme exp.</button>
            <button class="ml-op" data-cop="power" data-needs="n"><i class="bi bi-superscript"></i> Puissance zⁿ</button>
            <button class="ml-op" data-cop="nth_roots" data-needs="n"><i class="bi bi-diagram-3"></i> Racines n-ièmes</button>
            <button class="ml-op" data-cop="arithmetic" data-arith="sum" data-needs="z2"><i class="bi bi-plus-lg"></i> z₁+z₂</button>
            <button class="ml-op" data-cop="arithmetic" data-arith="product" data-needs="z2"><i class="bi bi-x-lg"></i> z₁×z₂</button>
            <button class="ml-op" data-cop="arithmetic" data-arith="quotient" data-needs="z2"><i class="bi bi-slash-lg"></i> z₁÷z₂</button>
          </div>

          <div class="ml-hint">Notez l'unité imaginaire <strong>i</strong> (ex : <code>3+4i</code>). « n » sert aux puissances et racines ; z₂ apparaît pour les opérations entre deux nombres.</div>
        </div><%# /mode-complex %>

        <div id="mode-geometry" hidden>
          <h2><i class="bi bi-triangle"></i> Points &amp; figures du plan complexe</h2>
          <div id="geo-points">
            <div class="geo-row" data-name="A">
              <label class="geo-label">z<sub>A</sub> =</label>
              <input type="text" value="1+i" placeholder="ex : 1+2i" autocomplete="off" />
              <button type="button" class="geo-del" title="Retirer" style="visibility:hidden">×</button>
            </div>
            <div class="geo-row" data-name="B">
              <label class="geo-label">z<sub>B</sub> =</label>
              <input type="text" value="4+2i" placeholder="ex : 1+2i" autocomplete="off" />
              <button type="button" class="geo-del" title="Retirer" style="visibility:hidden">×</button>
            </div>
            <div class="geo-row" data-name="C">
              <label class="geo-label">z<sub>C</sub> =</label>
              <input type="text" value="2+5i" placeholder="ex : 1+2i" autocomplete="off" />
              <button type="button" class="geo-del" title="Retirer" style="visibility:hidden">×</button>
            </div>
          </div>
          <button type="button" class="geo-add" id="geo-add"><i class="bi bi-plus-circle"></i> Ajouter un point</button>

          <div class="ml-preview is-empty" id="gPreview">Aperçu des affixes…</div>

          <div class="ml-keys" id="gkeys">
            <button type="button" class="ml-key" data-cins="i">i</button>
            <button type="button" class="ml-key" data-cins="+">+</button>
            <button type="button" class="ml-key" data-cins="-">−</button>
            <button type="button" class="ml-key" data-cins="*">×</button>
            <button type="button" class="ml-key" data-cins="/">÷</button>
            <button type="button" class="ml-key" data-cins="(|)">(&nbsp;)</button>
            <button type="button" class="ml-key" data-cins="sqrt(|)">√</button>
            <button type="button" class="ml-key is-util" data-cact="back">⌫</button>
            <button type="button" class="ml-key is-util" data-cact="clear">C</button>
          </div>

          <div class="ml-ops" id="gops">
            <button class="ml-op" data-gop="plot"><i class="bi bi-bounding-box-circles"></i> Tracer la figure</button>
            <button class="ml-op" data-gop="triangle_nature"><i class="bi bi-triangle"></i> Nature du triangle</button>
            <button class="ml-op" data-gop="quad_nature"><i class="bi bi-square"></i> Nature du quadrilatère</button>
          </div>

          <div class="ml-hint">Saisissez les affixes des points (A, B, C, …) puis tracez la figure. La nature se détermine pour <strong>3 points</strong> (triangle) ou <strong>4 points</strong> pris dans l'ordre (quadrilatère).</div>
        </div><%# /mode-geometry %>

        <div id="answer"></div>
        <div id="steps" class="ml-steps"></div>
        <div id="state" class="ml-state"></div>

        <div class="ml-warn">
          <i class="bi bi-shield-exclamation"></i>
          <span><strong>Aide à l'étude, usage personnel.</strong> Vérifiez toujours les résultats vous-même — l'IA peut se tromper dans les explications, mais le résultat affiché provient du moteur de calcul.</span>
        </div>
      </div>

      <!-- Graph (below) -->
      <div class="ml-card">
        <h2><i class="bi bi-graph-up"></i> <span id="graph-title">Représentation graphique</span></h2>
        <div id="ggb"></div>
        <div class="ml-hint" id="graph-hint">La courbe se met à jour quand vous tracez ou lancez un calcul. Utilisez « Tracer » après avoir modifié la fonction.</div>
      </div>
    </div>
  </div>
</div>

<% scripts = `
  <script src="https://www.geogebra.org/apps/deployggb.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js" crossorigin="anonymous"></script>
  <script>
  (function () {
    var EXPLAIN_URL = "/programs/ekalan/kalan/class/${schoolClass._id}/maths-lab/explain";
    var ggb = null;
    var fxInput = document.getElementById('fx');
    var keysEl = document.getElementById('keys');
    var previewEl = document.getElementById('fxPreview');
    var plotBtn = document.getElementById('plotBtn');
    var opsEl = document.getElementById('ops');

    // --- Live LaTeX preview: convert the GeoGebra-style input to LaTeX ---
    // NB: this script is emitted from an EJS template literal, which strips one
    // level of backslashes — so build LaTeX with BS (a literal backslash) instead
    // of '\\' string escapes, which would arrive mangled in the browser.
    var BS = String.fromCharCode(92);
    var FUN = { sqrt:1, abs:1, exp:1, ln:1, log:1, sin:1, cos:1, tan:1, cot:1, sec:1, csc:1, asin:1, acos:1, atan:1 };
    function toLatex(src){
      var toks = [], n = src.length, j = 0;
      while(j < n){
        var c = src[j];
        if(c === ' '){ j++; continue; }
        if(/[0-9.]/.test(c)){ var num=''; while(j<n && /[0-9.]/.test(src[j])){ num+=src[j++]; } toks.push({t:'num',v:num}); continue; }
        if(/[a-zA-Z]/.test(c)){ var id=''; while(j<n && /[a-zA-Z]/.test(src[j])){ id+=src[j++]; } toks.push({t:'id',v:id}); continue; }
        if('+-*/^(),'.indexOf(c) >= 0){ toks.push({t:'op',v:c}); j++; continue; }
        throw new Error('bad char');
      }
      var p = 0;
      function peek(){ return toks[p]; }
      function eat(v){ if(toks[p] && toks[p].v===v){ p++; return true; } return false; }
      function startsFactor(tk){ return tk && (tk.t==='num' || tk.t==='id' || tk.v==='('); }
      function stripParens(x){ return (x.indexOf(BS+'left(')===0 && x.slice(-7)===BS+'right)') ? x.slice(6,-7) : x; }
      function emitFun(name, arg){
        switch(name){
          case 'sqrt': return BS+'sqrt{'+arg+'}';
          case 'abs':  return BS+'left|'+arg+BS+'right|';
          case 'exp':  return 'e^{'+arg+'}';
          case 'ln':   return BS+'ln'+BS+'left('+arg+BS+'right)';
          case 'log':  return BS+'log'+BS+'left('+arg+BS+'right)';
          default:     return BS+name+BS+'left('+arg+BS+'right)';
        }
      }
      function parseExpr(){
        var left = parseTerm();
        while(peek() && (peek().v==='+' || peek().v==='-')){
          var op = toks[p++].v; left = left + (op==='+' ? ' + ' : ' - ') + parseTerm();
        }
        return left;
      }
      function parseTerm(){
        var left = parseFactor();
        while(peek()){
          var tk = peek();
          if(tk.v==='*'){ p++; left = left + ' '+BS+'cdot ' + parseFactor(); }
          else if(tk.v==='/'){ p++; left = BS+'frac{'+stripParens(left)+'}{'+stripParens(parseFactor())+'}'; }
          else if(startsFactor(tk)){ left = left + ' ' + parseFactor(); }
          else break;
        }
        return left;
      }
      function parseFactor(){
        var base = parseBase();
        if(peek() && peek().v==='^'){ p++; base = base + '^{' + stripParens(parseFactor()) + '}'; }
        return base;
      }
      function parseBase(){
        var tk = peek();
        if(!tk) throw new Error('eof');
        if(tk.v==='-'){ p++; return '-' + parseBase(); }
        if(tk.v==='+'){ p++; return parseBase(); }
        if(tk.t==='num'){ p++; return tk.v; }
        if(tk.v==='('){ p++; var e = parseExpr(); eat(')'); return BS+'left(' + e + BS+'right)'; }
        if(tk.t==='id'){
          p++;
          var name = tk.v;
          if(FUN[name] && peek() && peek().v==='('){ p++; var arg = parseExpr(); eat(')'); return emitFun(name, arg); }
          if(name==='pi') return BS+'pi';
          return name;
        }
        throw new Error('unexpected');
      }
      var out = parseExpr();
      if(p < toks.length) throw new Error('trailing');
      return out;
    }

    function updatePreview(){
      var raw = (fxInput.value||'').trim();
      if(!raw){ previewEl.className='ml-preview is-empty'; previewEl.textContent='Aperçu de la fonction…'; return; }
      var latex = null;
      try { latex = toLatex(raw); } catch(e){ latex = null; }
      if(latex == null){ previewEl.className='ml-preview is-empty'; previewEl.textContent='…en cours de saisie'; return; }
      try { katex.render('f(x) = ' + latex, previewEl, { throwOnError:true, displayMode:false }); previewEl.className='ml-preview'; }
      catch(e){ previewEl.className='ml-preview is-empty'; previewEl.textContent='…en cours de saisie'; }
    }
    fxInput.addEventListener('input', updatePreview);

    // Insert a token at the caret. A '|' in the token marks where the caret lands.
    function insertToken(tok){
      var val = fxInput.value;
      var s = fxInput.selectionStart, e = fxInput.selectionEnd;
      if(s == null){ s = e = val.length; }
      var caret = tok.indexOf('|');
      var clean = tok.replace('|','');
      fxInput.value = val.slice(0, s) + clean + val.slice(e);
      var pos = s + (caret >= 0 ? caret : clean.length);
      fxInput.focus();
      fxInput.setSelectionRange(pos, pos);
    }

    keysEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-key'); if(!btn) return;
      var act = btn.getAttribute('data-act');
      if(act === 'clear'){ fxInput.value=''; fxInput.focus(); }
      else if(act === 'back'){
        var v = fxInput.value, s = fxInput.selectionStart, e = fxInput.selectionEnd;
        if(s == null){ fxInput.value = v.slice(0,-1); }
        else if(s !== e){ fxInput.value = v.slice(0,s) + v.slice(e); fxInput.setSelectionRange(s,s); }
        else if(s > 0){ fxInput.value = v.slice(0,s-1) + v.slice(s); fxInput.setSelectionRange(s-1,s-1); }
        fxInput.focus();
      }
      else { insertToken(btn.getAttribute('data-ins')); }
      updatePreview();
    });
    var answerEl = document.getElementById('answer');
    var stepsEl = document.getElementById('steps');
    var stateEl = document.getElementById('state');

    function setOpsEnabled(on){ opsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }
    function renderKatex(el, latex){ try { katex.render(latex, el, { throwOnError:false, displayMode:false }); } catch(e){ el.textContent = latex; } }

    // CAS command per operation, against the raw expression
    function casCommand(op, expr){
      switch(op){
        case 'derivative': return 'Derivative(' + expr + ')';
        case 'asymptotes': return 'Asymptote(' + expr + ')';
        case 'limit':      return 'Limit(' + expr + ', Infinity)';
        case 'integral':   return 'Integral(' + expr + ')';
        case 'solve':      return 'Solve(' + expr + '=0)';
        case 'factor':     return 'Factor(' + expr + ')';
        case 'expand':     return 'Expand(' + expr + ')';
        default: return null;
      }
    }

    function plot(expr){
      if(!ggb) return;
      try {
        ggb.evalCommand('f(x)=' + expr);
        ggb.setColor('f', 93, 6, 186);
      } catch(e){}
    }

    function escapeHtml(s){ return String(s).replace(/[&<>]/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;'})[c]; }); }

    function showSteps(data){
      stepsEl.innerHTML = '';
      if(data.finalAnswerLatex){
        answerEl.innerHTML = '<div class="ml-answer"><div class="lbl"><i class="bi bi-stars"></i> Résultat</div><div class="val" id="ml-final"></div></div>';
        renderKatex(document.getElementById('ml-final'), data.finalAnswerLatex);
      } else if (data.casResult){
        answerEl.innerHTML = '<div class="ml-answer"><div class="lbl"><i class="bi bi-stars"></i> Résultat</div><div class="val">' + escapeHtml(data.casResult) + '</div></div>';
      }
      if(Array.isArray(data.steps) && data.steps.length){
        data.steps.forEach(function(st){
          var div = document.createElement('div');
          div.className = 'ml-step';
          var t = document.createElement('div'); t.className = 'ml-step__title'; t.textContent = st.title || '';
          var l = document.createElement('div'); l.className = 'ml-step__latex';
          var e = document.createElement('div'); e.className = 'ml-step__exp'; e.textContent = st.explanation || '';
          div.appendChild(t); div.appendChild(l); div.appendChild(e);
          stepsEl.appendChild(div);
          if(st.latex) renderKatex(l, st.latex);
        });
      }
    }

    async function run(op){
      var expr = (fxInput.value || '').trim();
      if(!expr){ stateEl.textContent = 'Saisissez une fonction.'; return; }
      var cmd = casCommand(op, expr);
      if(!cmd || !ggb){ return; }

      plot(expr);
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul en cours…';
      setOpsEnabled(false);

      var casResult = '';
      try { casResult = ggb.evalCommandCAS(cmd); } catch(e){ casResult = ''; }
      if(!casResult){ stateEl.textContent = "Impossible de calculer — vérifiez la syntaxe de la fonction."; setOpsEnabled(true); return; }

      // Show the CAS result immediately (source of truth)
      answerEl.innerHTML = '<div class="ml-answer"><div class="lbl"><i class="bi bi-stars"></i> Résultat</div><div class="val">' + escapeHtml(casResult) + '</div></div>';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';

      try {
        var resp = await fetch(EXPLAIN_URL, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ function: expr, operation: op, casResult: casResult })
        });
        var data = await resp.json();
        if(data.ok){ showSteps(data); stateEl.textContent = data.cached ? '' : ''; }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){
        stateEl.textContent = 'Connexion impossible — réessayez.';
      } finally {
        setOpsEnabled(true);
      }
    }

    opsEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return;
      run(btn.getAttribute('data-op'));
    });

    // Manual "Tracer" — redraw the curve from the current input.
    function doPlot(){
      updatePreview();
      var expr = (fxInput.value || '').trim();
      if(!expr){ stateEl.textContent = 'Saisissez une fonction.'; return; }
      if(!ggb){ return; }
      plot(expr);
      stateEl.textContent = '';
    }
    plotBtn.addEventListener('click', doPlot);
    fxInput.addEventListener('keydown', function(ev){ if(ev.key === 'Enter'){ ev.preventDefault(); doPlot(); } });

    /* ============ NOMBRES COMPLEXES (complex mode) ============ */
    var modesEl   = document.getElementById('modes');
    var modeFunc  = document.getElementById('mode-function');
    var modeCplx  = document.getElementById('mode-complex');
    var graphTitle= document.getElementById('graph-title');
    var graphHint = document.getElementById('graph-hint');
    var z1Input   = document.getElementById('z1');
    var z2Input   = document.getElementById('z2');
    var cnInput   = document.getElementById('cn');
    var z2Row     = document.getElementById('z2-row');
    var nRow      = document.getElementById('n-row');
    var zPreviewEl= document.getElementById('zPreview');
    var ckeysEl   = document.getElementById('ckeys');
    var copsEl    = document.getElementById('cops');
    var activeZ   = z1Input;
    var currentMode = 'function';
    var complexObjs = [];

    function setCOpsEnabled(on){ copsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }

    function updateZPreview(){
      var raw = (z1Input.value || '').trim();
      if(!raw){ zPreviewEl.className='ml-preview is-empty'; zPreviewEl.textContent='Aperçu du nombre complexe…'; return; }
      var latex = null;
      try { latex = toLatex(raw); } catch(e){ latex = null; }
      if(latex == null){ zPreviewEl.className='ml-preview is-empty'; zPreviewEl.textContent='…en cours de saisie'; return; }
      try { katex.render('z_1 = ' + latex, zPreviewEl, { throwOnError:true, displayMode:false }); zPreviewEl.className='ml-preview'; }
      catch(e){ zPreviewEl.className='ml-preview is-empty'; zPreviewEl.textContent='…en cours de saisie'; }
    }

    [z1Input, z2Input].forEach(function(inp){
      inp.addEventListener('focus', function(){ activeZ = inp; });
      inp.addEventListener('input', updateZPreview);
    });

    function insertInto(inp, tok){
      var val = inp.value, s = inp.selectionStart, e = inp.selectionEnd;
      if(s == null){ s = e = val.length; }
      var caret = tok.indexOf('|'); var clean = tok.replace('|','');
      inp.value = val.slice(0, s) + clean + val.slice(e);
      var pos = s + (caret >= 0 ? caret : clean.length);
      inp.focus(); inp.setSelectionRange(pos, pos);
    }
    ckeysEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-key'); if(!btn) return;
      var inp = activeZ || z1Input;
      var act = btn.getAttribute('data-cact');
      if(act === 'clear'){ inp.value=''; inp.focus(); }
      else if(act === 'back'){
        var v=inp.value, s=inp.selectionStart, e=inp.selectionEnd;
        if(s == null){ inp.value = v.slice(0,-1); }
        else if(s !== e){ inp.value = v.slice(0,s)+v.slice(e); inp.setSelectionRange(s,s); }
        else if(s > 0){ inp.value = v.slice(0,s-1)+v.slice(s); inp.setSelectionRange(s-1,s-1); }
        inp.focus();
      }
      else { insertInto(inp, btn.getAttribute('data-cins')); }
      updateZPreview();
    });

    // Canonical expression (cache key + sent to server)
    function complexExpr(op, z1, z2, n, arith){
      switch(op){
        case 'power':      return '(' + z1 + ')^' + n;
        case 'arithmetic':
          var sym = arith==='sum' ? '+' : arith==='product' ? '*' : '/';
          return '(' + z1 + ')' + sym + '(' + z2 + ')';
        default:           return z1;
      }
    }
    // GeoGebra CAS command for the operation (exp_form handled separately)
    function complexCAS(op, z1, z2, n, arith){
      var Z = '(' + z1 + ')';
      switch(op){
        case 'modulus':   return 'abs(' + Z + ')';
        case 'argument':  return 'arg(' + Z + ')';
        case 'conjugate': return 'Conjugate(' + Z + ')';
        case 'power':     return Z + '^(' + n + ')';
        case 'nth_roots': return 'CSolutions(x^(' + n + ')=' + Z + ', x)';
        case 'arithmetic':
          var sym = arith==='sum' ? '+' : arith==='product' ? '*' : '/';
          return Z + sym + '(' + z2 + ')';
        default: return null;
      }
    }

    function clearComplexPlot(){
      complexObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} });
      complexObjs = [];
    }
    function defObj(name, cmd){ try { ggb.evalCommand(name + '=' + cmd); complexObjs.push(name); } catch(e){} }
    function colour(name, r, g, b){ try { ggb.setColor(name, r, g, b); } catch(e){} }

    // Argand diagram: plot z₁ (+ vector from origin) and any result point(s).
    function plotComplex(op, z1, z2, n, arith){
      if(!ggb) return;
      clearComplexPlot();
      try { ggb.deleteObject('f'); } catch(e){}
      defObj('z_1', '(' + z1 + ')');
      defObj('v_1', 'Vector(z_1)');
      colour('z_1', 93, 6, 186); colour('v_1', 93, 6, 186);
      if(op === 'arithmetic'){
        defObj('z_2', '(' + z2 + ')');
        var sym = arith==='sum' ? '+' : arith==='product' ? '*' : '/';
        defObj('z_3', '(' + z1 + ')' + sym + '(' + z2 + ')');
        colour('z_2', 168, 85, 247); colour('z_3', 255, 184, 0);
      } else if(op === 'conjugate'){
        defObj('z_c', 'Conjugate(z_1)'); colour('z_c', 255, 184, 0);
      } else if(op === 'power'){
        defObj('z_p', 'z_1^(' + n + ')'); colour('z_p', 255, 184, 0);
      } else if(op === 'nth_roots'){
        defObj('R', 'CSolutions(x^(' + n + ')=z_1, x)'); colour('R', 255, 184, 0);
      }
      fitComplex();
    }

    // Fit the view around the origin + every plotted point (stable API, no ZoomFit command).
    function fitComplex(){
      var xs = [0], ys = [0];
      complexObjs.forEach(function(nm){
        try {
          var x = ggb.getXcoord(nm), y = ggb.getYcoord(nm);
          if(isFinite(x) && isFinite(y) && !(x === 0 && y === 0)){ xs.push(x); ys.push(y); }
        } catch(e){}
      });
      var minX = Math.min.apply(null, xs), maxX = Math.max.apply(null, xs);
      var minY = Math.min.apply(null, ys), maxY = Math.max.apply(null, ys);
      var padX = Math.max(2, (maxX - minX) * 0.25), padY = Math.max(2, (maxY - minY) * 0.25);
      try { ggb.setCoordSystem(minX - padX, maxX + padX, minY - padY, maxY + padY); } catch(e){}
    }

    async function runComplex(op, arith, needs){
      var z1 = (z1Input.value || '').trim();
      if(!z1){ stateEl.textContent = 'Saisissez z₁.'; return; }
      if(needs === 'z2'){ z2Row.hidden = false; }
      if(needs === 'n'){ nRow.hidden = false; }
      var z2 = (z2Input.value || '').trim();
      var n  = parseInt(cnInput.value, 10);
      if(needs === 'z2' && !z2){ stateEl.textContent = 'Saisissez z₂.'; z2Input.focus(); return; }
      if(needs === 'n' && !(n >= 2 && n <= 12)){ stateEl.textContent = 'n doit être un entier entre 2 et 12.'; cnInput.focus(); return; }
      if(!ggb){ return; }

      plotComplex(op, z1, z2, n, arith);
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul en cours…';
      setCOpsEnabled(false);

      var casResult = '';
      try {
        if(op === 'exp_form'){
          var r  = ggb.evalCommandCAS('abs((' + z1 + '))');
          var th = ggb.evalCommandCAS('arg((' + z1 + '))');
          if(r && th){ casResult = r + '*e^(i*(' + th + ')) = ' + r + '*(cos(' + th + ') + i*sin(' + th + '))'; }
        } else {
          var cmd = complexCAS(op, z1, z2, n, arith);
          if(cmd){ casResult = ggb.evalCommandCAS(cmd); }
        }
      } catch(e){ casResult = ''; }
      if(!casResult){ stateEl.textContent = "Impossible de calculer — vérifiez l'écriture (ex : 3+4i)."; setCOpsEnabled(true); return; }

      answerEl.innerHTML = '<div class="ml-answer"><div class="lbl"><i class="bi bi-stars"></i> Résultat</div><div class="val">' + escapeHtml(casResult) + '</div></div>';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';

      var payload = { domain:'complex', operation: op, expression: complexExpr(op, z1, z2, n, arith), casResult: casResult };
      if(op === 'arithmetic'){ payload.z2 = z2; payload.arithOp = arith; }
      if(op === 'power' || op === 'nth_roots'){ payload.n = n; }

      try {
        var resp = await fetch(EXPLAIN_URL, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify(payload)
        });
        var data = await resp.json();
        if(data.ok){ showSteps(data); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){
        stateEl.textContent = 'Connexion impossible — réessayez.';
      } finally {
        setCOpsEnabled(true);
      }
    }

    copsEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return;
      runComplex(btn.getAttribute('data-cop'), btn.getAttribute('data-arith'), btn.getAttribute('data-needs'));
    });

    /* ============ GÉOMÉTRIE (points, triangles, quadrilatères) ============ */
    var modeGeo   = document.getElementById('mode-geometry');
    var geoListEl = document.getElementById('geo-points');
    var geoAddBtn = document.getElementById('geo-add');
    var gkeysEl   = document.getElementById('gkeys');
    var gopsEl    = document.getElementById('gops');
    var gPreviewEl= document.getElementById('gPreview');
    var geoObjs   = [];
    var activeGeo = null;
    var GEO_LETTERS = ['A','B','C','D','E','F'];
    var GEO_MIN = 3, GEO_MAX = 6;

    function setGOpsEnabled(on){ gopsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }
    function geoInputs(){ return Array.prototype.slice.call(geoListEl.querySelectorAll('input')); }
    function geoRows(){ return Array.prototype.slice.call(geoListEl.querySelectorAll('.geo-row')); }
    function geoData(){
      return geoInputs().map(function(inp, i){ return { name: GEO_LETTERS[i], affix: (inp.value || '').trim() }; })
                        .filter(function(p){ return p.affix; });
    }
    function renumberGeo(){
      var rows = geoRows();
      rows.forEach(function(row, i){
        var name = GEO_LETTERS[i];
        row.setAttribute('data-name', name);
        var lab = row.querySelector('.geo-label'); if(lab) lab.innerHTML = 'z<sub>' + name + '</sub> =';
        var del = row.querySelector('.geo-del'); if(del) del.style.visibility = (rows.length > GEO_MIN) ? 'visible' : 'hidden';
      });
      geoAddBtn.disabled = rows.length >= GEO_MAX;
    }
    function attachGeoInput(inp){
      inp.addEventListener('focus', function(){ activeGeo = inp; });
      inp.addEventListener('input', updateGeoPreview);
    }
    geoInputs().forEach(attachGeoInput);
    geoRows().forEach(function(row){
      var del = row.querySelector('.geo-del');
      if(del) del.addEventListener('click', function(){
        if(geoRows().length > GEO_MIN){ row.remove(); renumberGeo(); updateGeoPreview(); }
      });
    });
    geoAddBtn.addEventListener('click', function(){
      if(geoRows().length >= GEO_MAX) return;
      var row = document.createElement('div'); row.className = 'geo-row';
      var lab = document.createElement('label'); lab.className = 'geo-label';
      var inp = document.createElement('input'); inp.type = 'text'; inp.placeholder = 'ex : 1+2i'; inp.autocomplete = 'off';
      var del = document.createElement('button'); del.type = 'button'; del.className = 'geo-del'; del.title = 'Retirer'; del.textContent = '×';
      del.addEventListener('click', function(){ if(geoRows().length > GEO_MIN){ row.remove(); renumberGeo(); updateGeoPreview(); } });
      row.appendChild(lab); row.appendChild(inp); row.appendChild(del);
      geoListEl.appendChild(row);
      attachGeoInput(inp); renumberGeo(); inp.focus();
    });

    gkeysEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-key'); if(!btn) return;
      var inp = activeGeo || geoInputs()[0]; if(!inp) return;
      var act = btn.getAttribute('data-cact');
      if(act === 'clear'){ inp.value = ''; inp.focus(); }
      else if(act === 'back'){
        var v = inp.value, s = inp.selectionStart, e = inp.selectionEnd;
        if(s == null){ inp.value = v.slice(0,-1); }
        else if(s !== e){ inp.value = v.slice(0,s) + v.slice(e); inp.setSelectionRange(s,s); }
        else if(s > 0){ inp.value = v.slice(0,s-1) + v.slice(s); inp.setSelectionRange(s-1,s-1); }
        inp.focus();
      }
      else { insertInto(inp, btn.getAttribute('data-cins')); }
      updateGeoPreview();
    });

    function updateGeoPreview(){
      var inputs = geoInputs();
      var inp = (activeGeo && inputs.indexOf(activeGeo) >= 0) ? activeGeo : inputs[0];
      var idx = inputs.indexOf(inp); var name = GEO_LETTERS[idx >= 0 ? idx : 0];
      var raw = inp ? (inp.value || '').trim() : '';
      if(!raw){ gPreviewEl.className = 'ml-preview is-empty'; gPreviewEl.textContent = 'Aperçu des affixes…'; return; }
      var latex = null; try { latex = toLatex(raw); } catch(e){ latex = null; }
      if(latex == null){ gPreviewEl.className = 'ml-preview is-empty'; gPreviewEl.textContent = '…en cours de saisie'; return; }
      try { katex.render('z_' + name + ' = ' + latex, gPreviewEl, { throwOnError:true, displayMode:false }); gPreviewEl.className = 'ml-preview'; }
      catch(e){ gPreviewEl.className = 'ml-preview is-empty'; gPreviewEl.textContent = '…en cours de saisie'; }
    }

    function clearGeoPlot(){ geoObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} }); geoObjs = []; }
    function defGeo(name, cmd){ try { ggb.evalCommand(name + '=' + cmd); geoObjs.push(name); } catch(e){} }
    function fitGeo(names){
      var xs = [0], ys = [0];
      names.forEach(function(nm){ try { var x = ggb.getXcoord(nm), y = ggb.getYcoord(nm); if(isFinite(x) && isFinite(y)){ xs.push(x); ys.push(y); } } catch(e){} });
      var minX = Math.min.apply(null, xs), maxX = Math.max.apply(null, xs);
      var minY = Math.min.apply(null, ys), maxY = Math.max.apply(null, ys);
      var padX = Math.max(2, (maxX - minX) * 0.25), padY = Math.max(2, (maxY - minY) * 0.25);
      try { ggb.setCoordSystem(minX - padX, maxX + padX, minY - padY, maxY + padY); } catch(e){}
    }

    // Plot the points as real GeoGebra Points (so Polygon works) + the polygon. Returns {coords, ok}.
    function plotGeo(points){
      if(!ggb) return { coords:[], ok:false };
      clearGeoPlot(); try { ggb.deleteObject('f'); } catch(e){}
      var coords = [], names = [], ok = true;
      points.forEach(function(pt){
        var tmp = 'zz_' + pt.name, x = NaN, y = NaN;
        try { ggb.evalCommand(tmp + '=(' + pt.affix + ')'); x = ggb.getXcoord(tmp); y = ggb.getYcoord(tmp); } catch(e){}
        try { ggb.deleteObject(tmp); } catch(e){}
        coords.push({ name: pt.name, x: x, y: y });
        if(isFinite(x) && isFinite(y)){
          defGeo(pt.name, '(' + x + ',' + y + ')'); colour(pt.name, 93, 6, 186);
          try { ggb.setLabelVisible(pt.name, true); } catch(e){}
          names.push(pt.name);
        } else { ok = false; }
      });
      if(names.length >= 3){ defGeo('poly1', 'Polygon(' + names.join(',') + ')'); colour('poly1', 168, 85, 247); }
      else if(names.length === 2){ defGeo('seg1', 'Segment(' + names[0] + ',' + names[1] + ')'); colour('seg1', 168, 85, 247); }
      fitGeo(names);
      return { coords: coords, ok: ok };
    }

    function approxEq(a, b){ return Math.abs(a - b) <= 1e-7 * Math.max(1, Math.abs(a), Math.abs(b)); }
    function rnd(v){ return String(Math.round(v * 1000) / 1000); }
    function dist(u, v){ return Math.hypot(u.x - v.x, u.y - v.y); }
    function rightAngleAt(V, U, W){ // angle U-V-W ; V is the vertex
      var v1x = U.x - V.x, v1y = U.y - V.y, v2x = W.x - V.x, v2y = W.y - V.y;
      var dot = v1x * v2x + v1y * v2y, m = Math.hypot(v1x, v1y) * Math.hypot(v2x, v2y);
      return m > 0 && Math.abs(dot) <= 1e-7 * m;
    }
    function parallelSeg(p1, p2, q1, q2){
      var ux = p2.x - p1.x, uy = p2.y - p1.y, vx = q2.x - q1.x, vy = q2.y - q1.y;
      var cross = ux * vy - uy * vx, m = Math.hypot(ux, uy) * Math.hypot(vx, vy);
      return m > 0 && Math.abs(cross) <= 1e-7 * m;
    }

    function classifyTriangle(P){
      var A = P[0], B = P[1], C = P[2];
      var AB = dist(A,B), BC = dist(B,C), CA = dist(C,A);
      var lengths = { AB:AB, BC:BC, CA:CA };
      var area = Math.abs((B.x-A.x)*(C.y-A.y) - (C.x-A.x)*(B.y-A.y)) / 2;
      if(area <= 1e-9 * Math.max(1, AB*BC)) return { nature:"Points alignés — ce n'est pas un triangle", lengths:lengths };
      var equilateral = approxEq(AB,BC) && approxEq(BC,CA) && approxEq(CA,AB);
      var rA = rightAngleAt(A,B,C), rB = rightAngleAt(B,A,C), rC = rightAngleAt(C,A,B);
      var right = rA || rB || rC, rightVertex = rA ? 'A' : rB ? 'B' : rC ? 'C' : null;
      var apex = approxEq(CA,AB) ? 'A' : approxEq(AB,BC) ? 'B' : approxEq(BC,CA) ? 'C' : null;
      var iso = !!apex;
      var nature;
      if(equilateral) nature = 'Triangle équilatéral';
      else if(right && iso) nature = 'Triangle rectangle isocèle' + (rightVertex ? (' en ' + rightVertex) : '');
      else if(right) nature = 'Triangle rectangle' + (rightVertex ? (' en ' + rightVertex) : '');
      else if(iso) nature = 'Triangle isocèle' + (apex ? (' en ' + apex) : '');
      else nature = 'Triangle quelconque';
      return { nature: nature, lengths: lengths };
    }

    function classifyQuad(P){
      var A = P[0], B = P[1], C = P[2], D = P[3];
      var AB = dist(A,B), BC = dist(B,C), CD = dist(C,D), DA = dist(D,A), AC = dist(A,C), BD = dist(B,D);
      var lengths = { AB:AB, BC:BC, CD:CD, DA:DA, AC:AC, BD:BD };
      var mAC = { x:(A.x+C.x)/2, y:(A.y+C.y)/2 }, mBD = { x:(B.x+D.x)/2, y:(B.y+D.y)/2 };
      var isParallelogram = approxEq(mAC.x, mBD.x) && approxEq(mAC.y, mBD.y);
      var nature;
      if(isParallelogram){
        var equalSides = approxEq(AB, BC);
        var equalDiag  = approxEq(AC, BD);
        var rightAngle = rightAngleAt(B, A, C);
        if(equalSides && (equalDiag || rightAngle)) nature = 'Carré';
        else if(equalDiag || rightAngle) nature = 'Rectangle';
        else if(equalSides) nature = 'Losange';
        else nature = 'Parallélogramme';
      } else {
        var abCD = parallelSeg(A,B,D,C), bcDA = parallelSeg(B,C,A,D);
        if(abCD || bcDA){
          var isoLegs = abCD ? approxEq(BC, DA) : approxEq(AB, CD);
          var hasRight = rightAngleAt(A,B,C) || rightAngleAt(B,C,D) || rightAngleAt(C,D,A) || rightAngleAt(D,A,B);
          nature = 'Trapèze' + (hasRight ? ' rectangle' : (isoLegs ? ' isocèle' : ''));
        } else nature = 'Quadrilatère quelconque';
      }
      return { nature: nature, lengths: lengths };
    }

    function buildGeoResult(op, res){
      var L = res.lengths;
      if(op === 'triangle_nature'){
        return res.nature + ' — longueurs : AB ≈ ' + rnd(L.AB) + ', BC ≈ ' + rnd(L.BC) + ', CA ≈ ' + rnd(L.CA) + '.';
      }
      return res.nature + ' — côtés : AB ≈ ' + rnd(L.AB) + ', BC ≈ ' + rnd(L.BC) + ', CD ≈ ' + rnd(L.CD) + ', DA ≈ ' + rnd(L.DA) +
             ' ; diagonales : AC ≈ ' + rnd(L.AC) + ', BD ≈ ' + rnd(L.BD) + '.';
    }

    async function runGeo(op){
      var pts = geoData();
      if(op === 'plot'){
        if(pts.length < 1){ stateEl.textContent = 'Saisissez au moins un point.'; return; }
        var r0 = plotGeo(pts);
        answerEl.innerHTML = ''; stepsEl.innerHTML = '';
        stateEl.textContent = r0.ok ? ('Figure tracée (' + pts.length + ' point' + (pts.length > 1 ? 's' : '') + ').')
                                    : "Certains affixes sont invalides — vérifiez l'écriture (ex : 1+2i).";
        return;
      }
      var need = (op === 'triangle_nature') ? 3 : 4;
      var label = (need === 3) ? 'triangle' : 'quadrilatère';
      if(pts.length !== need){ stateEl.textContent = 'Renseignez exactement ' + need + ' points pour un ' + label + '.'; return; }
      if(!ggb){ return; }

      var r = plotGeo(pts);
      if(!r.ok){ stateEl.textContent = "Impossible de lire les affixes — vérifiez l'écriture (ex : 1+2i)."; return; }
      var res = (need === 3) ? classifyTriangle(r.coords) : classifyQuad(r.coords);
      var casResult = buildGeoResult(op, res);

      answerEl.innerHTML = '<div class="ml-answer"><div class="lbl"><i class="bi bi-stars"></i> Résultat</div><div class="val">' + escapeHtml(res.nature) + '</div></div>';
      stepsEl.innerHTML = ''; stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';
      setGOpsEnabled(false);

      var expression = pts.map(function(p){ return 'z_' + p.name + ' = ' + p.affix; }).join(' ; ');
      try {
        var resp = await fetch(EXPLAIN_URL, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ domain:'complex', operation: op, expression: expression, casResult: casResult })
        });
        var data = await resp.json();
        if(data.ok){ showSteps(data); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){
        stateEl.textContent = 'Connexion impossible — réessayez.';
      } finally {
        setGOpsEnabled(true);
      }
    }

    gopsEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return;
      runGeo(btn.getAttribute('data-gop'));
    });
    renumberGeo();

    function switchMode(m){
      if(m === currentMode) return;
      currentMode = m;
      modesEl.querySelectorAll('.ml-mode').forEach(function(b){ b.classList.toggle('is-active', b.getAttribute('data-mode') === m); });
      modeFunc.hidden = (m !== 'function');
      modeCplx.hidden = (m !== 'complex');
      modeGeo.hidden  = (m !== 'geometry');
      answerEl.innerHTML = ''; stepsEl.innerHTML = ''; stateEl.textContent = '';
      if(ggb){
        try { ggb.setPerspective(m === 'function' ? 'AG' : 'G'); } catch(e){}
        clearComplexPlot(); clearGeoPlot();
        if(m === 'function'){
          graphTitle.textContent = 'Représentation graphique';
          graphHint.textContent = 'La courbe se met à jour quand vous tracez ou lancez un calcul. Utilisez « Tracer » après avoir modifié la fonction.';
          plot((fxInput.value || '').trim());
        } else if(m === 'complex'){
          graphTitle.textContent = 'Plan complexe (Argand)';
          graphHint.textContent = 'Le point z₁ et le vecteur depuis l’origine apparaissent quand vous lancez un calcul.';
          try { ggb.deleteObject('f'); } catch(e){}
          updateZPreview();
        } else {
          graphTitle.textContent = 'Plan complexe — figure';
          graphHint.textContent = 'Placez les affixes des points puis « Tracer la figure » ou déterminez la nature de la figure.';
          try { ggb.deleteObject('f'); } catch(e){}
          updateGeoPreview();
        }
        setTimeout(fitGraph, 60);
      }
    }
    modesEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-mode'); if(!btn) return;
      switchMode(btn.getAttribute('data-mode'));
    });

    // Keep the GeoGebra applet sized to its (now full-width) container.
    var ggbHost = document.getElementById('ggb');
    function fitGraph(){
      if(!ggb) return;
      var w = Math.max(320, ggbHost.clientWidth || 700);
      var h = Math.min(540, Math.max(420, Math.round(w * 0.52)));
      try { ggb.setSize(w, h); } catch(e){}
    }
    var ggbResizeTimer = null;
    window.addEventListener('resize', function(){ clearTimeout(ggbResizeTimer); ggbResizeTimer = setTimeout(fitGraph, 200); });

    // GeoGebra applet
    setOpsEnabled(false); setCOpsEnabled(false); setGOpsEnabled(false);
    var initW = Math.max(320, ggbHost.clientWidth || 700);
    var initH = Math.min(540, Math.max(420, Math.round(initW * 0.52)));
    var applet = new GGBApplet({
      appName: 'classic',
      width: initW, height: initH,
      showToolBar: false, showAlgebraInput: false, showMenuBar: false,
      enableRightClick: false, showResetIcon: true,
      perspective: 'AG',
      appletOnLoad: function(api){ ggb = api; setOpsEnabled(true); setCOpsEnabled(true); setGOpsEnabled(true); fitGraph(); plot((fxInput.value||'').trim()); }
    }, true);
    applet.inject('ggb');
    updatePreview();
    updateZPreview();
    updateGeoPreview();
  })();
  </script>
` %>
