        f = factor();
        if(!f){ if(k && fZero(k)) return []; throw 'terme'; }
        if(peek() === '/'){ pos++; var d2 = num(); if(!d2 || fZero(d2)) throw 'fraction'; f = scale(f, fDiv(fr(1), d2)); }
        return k ? scale(f, k) : f;
