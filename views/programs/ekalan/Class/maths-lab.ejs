    // ---- GeoGebra figure: draggable free points, dependent constructed points ----
    var VC_POS = { 2: [[0, 0], [4, 0]], 3: [[0, 0], [5, 0], [1.5, 3.5]], 4: [[0, 0], [5, -0.5], [6, 3.5], [1, 3]], 5: [[0, 0], [5, 0], [6, 3], [2.5, 5], [-1, 3]] };
    function vcDraw(F, qs){
