    function defLim(name, fullCmd){ try { ggb.evalCommand(fullCmd); limObjs.push(name); } catch(e){} }
    function clearLimPlot(){ limObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} }); limObjs = []; }

    async function runLimit(){
      var f = (lfxInput.value || '').trim();
      if(!f){ stateEl.textContent = 'Saisissez une fonction.'; return; }
      var pRaw = (lpointInput.value || '').trim();
      if(!pRaw){ stateEl.textContent = 'Indiquez la valeur vers laquelle x tend.'; lpointInput.focus(); return; }
      if(!ggb) return;
      var P = normalizePoint(pRaw);
      var inf = (P === 'Infinity' || P === '-Infinity');
      var side = inf ? '' : limSide;

      clearLimPlot();
      plot(f);
      if(!inf){ defLim('lpt', 'lpt: x = ' + P); colour('lpt', 255, 184, 0); }

      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul en cours…';
      setLOpsEnabled(false);

      var casResult = '';
      try { casResult = ggb.evalCommandCAS(limitCAS(f, P, side)); } catch(e){ casResult = ''; }
      if(!casResult){ stateEl.textContent = 'Impossible de calculer — vérifiez la fonction et le point.'; setLOpsEnabled(true); return; }

      if(isPlainNumber(casResult)){ defLim('lhz', 'lhz: y = ' + casResult); colour('lhz', 93, 6, 186); }

      answerEl.innerHTML = '<div class="ml-answer"><div class="lbl"><i class="bi bi-stars"></i> Résultat</div><div class="val">' + escapeHtml(casResult) + '</div></div>';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';

      var displayPoint = inf ? (P === 'Infinity' ? '+∞' : '-∞') : pRaw;
      try {
        var resp = await fetch(EXPLAIN_URL, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ function: f, operation: 'limit', casResult: casResult, point: displayPoint, side: side })
        });
        var data = await resp.json();
        if(data.ok){ showSteps(data); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){
        stateEl.textContent = 'Connexion impossible — réessayez.';
      } finally {
        setLOpsEnabled(true);
      }
    }

    lopsEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return;
      runLimit();
    });
    setLimSide(''); refreshSideButtons();

    /* ============ INTÉGRALES ============ */
    var modeIntegral = document.getElementById('mode-integral');
    var ifxInput   = document.getElementById('ifx');
    var iaInput    = document.getElementById('ia');
    var ibInput    = document.getElementById('ib');
    var ikeysEl    = document.getElementById('ikeys');
    var iopsEl     = document.getElementById('iops');
    var iPreviewEl = document.getElementById('iPreview');
    var isideEl    = document.getElementById('iside');
    var iboundsEl  = document.getElementById('ibounds');
    var intObjs    = [];
    var intType    = 'indef';
    var activeInt  = ifxInput;

    function setIOpsEnabled(on){ iopsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }
    function defInt(name, fullCmd){ try { ggb.evalCommand(fullCmd); intObjs.push(name); } catch(e){} }
    function clearIntPlot(){ intObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} }); intObjs = []; }

    function integralLatex(){
      var f = (ifxInput.value || '').trim();
      var fTex = null; try { fTex = toLatex(f); } catch(e){ return null; }
      if(fTex == null) return null;
      if(intType === 'def'){
        var a = (iaInput.value || '').trim() || 'a', b = (ibInput.value || '').trim() || 'b';
        var aTex, bTex;
        try { aTex = toLatex(a); } catch(e){ aTex = a; }
        try { bTex = toLatex(b); } catch(e){ bTex = b; }
        return BS + 'int_{' + aTex + '}^{' + bTex + '} ' + fTex + BS + ',dx';
      }
      return BS + 'int ' + fTex + BS + ',dx';
    }
    function updateIntPreview(){
      var raw = (ifxInput.value || '').trim();
      if(!raw){ iPreviewEl.className = 'ml-preview is-empty'; iPreviewEl.textContent = 'Aperçu de l’intégrale…'; return; }
      var tex = null; try { tex = integralLatex(); } catch(e){ tex = null; }
      if(tex == null){ iPreviewEl.className = 'ml-preview is-empty'; iPreviewEl.textContent = '…en cours de saisie'; return; }
      try { katex.render(tex, iPreviewEl, { throwOnError:true, displayMode:false }); iPreviewEl.className = 'ml-preview'; }
      catch(e){ iPreviewEl.className = 'ml-preview is-empty'; iPreviewEl.textContent = '…en cours de saisie'; }
    }

    function setIType(t){
      intType = t;
