      qs.forEach(function(q){ try { if(q.type === 'show' || q.type === 'colin') vcNorm(q.p).split('=').forEach(function(s){ vcParseExpr(s.split('.').join('')).forEach(function(t){ addV(t.X, t.Y); }); }); } catch(e){} });
