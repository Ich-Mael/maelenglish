    function vcDefPlain(d){ return d.name + ': ' + (d.type === 'rel' ? d.param : d.type === 'mid' ? 'milieu de [' + d.of.join('') + ']' : d.type === 'grav' ? 'centre de gravite de ' + d.of.join('') : d.type === 'sym' ? 'symetrique de ' + d.of[0] + ' par rapport a ' + d.of[1] : 'image de ' + d.of[0] + ' par la translation de vecteur ' + d.of[1] + d.of[2]); }
