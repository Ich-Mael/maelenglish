      if(fZero(u) && !fZero(be)) return null;
      var l1 = [fMul(fr(2), A), fSub(B, u), fSub(D, v)], l2 = [fMul(fr(2), A), fAdd(B, u), fAdd(D, v)];
      var out = [l1, l2].map(function(L){ return swap ? [L[1], L[0], L[2]] : L; });
      if(fZero(fSub(out[0][0], out[1][0])) && fZero(fSub(out[0][1], out[1][1])) && fZero(fSub(out[0][2], out[1][2]))) out = [out[0]];
