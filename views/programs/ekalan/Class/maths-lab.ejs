      } catch(e){ stateEl.textContent = computed ? 'Connexion impossible — réessayez.' : 'Calcul impossible — vérifiez f(z).'; }
      finally { setZfOpsEnabled(true); }
    }
    zfOpsEl.addEventListener('click', function(ev){ var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return; runZf(btn.getAttribute('data-zfop')); });

    function zfPlot(E, poles, pts, set){
      clearZfPlot(); clearComplexPlot(); try { ggb.deleteObject('f'); } catch(e){}
      function add(nm, cmd){ try { ggb.evalCommand(nm + '=' + cmd); zfObjs.push(nm); return true; } catch(e){ return false; } }
      var xs = [0], ys = [0];
      if(E && !bpZero(E) && bpDeg(E) > 0){
        try { ggb.evalCommand('zfSet:' + bpGgb(E) + '=0'); ggb.setColor('zfSet', 94, 23, 235); ggb.setLineThickness('zfSet', 6); ggb.setLabelVisible('zfSet', false); zfObjs.push('zfSet'); } catch(e){}
        (set && set.parts || []).forEach(function(pt){
          if(pt.kind === 'circle'){ var r = Math.sqrt(fVal(pt.r2)); xs.push(fVal(pt.cx) - r, fVal(pt.cx) + r); ys.push(fVal(pt.cy) - r, fVal(pt.cy) + r);
            if(add('ZfC', '(' + fVal(pt.cx) + ',' + fVal(pt.cy) + ')')){ try { ggb.setColor('ZfC', 50, 44, 77); ggb.setPointSize('ZfC', 4); ggb.setCaption('ZfC', 'Ω'); ggb.setLabelStyle('ZfC', 3); ggb.setLabelVisible('ZfC', true); } catch(e){} } }
          if(pt.kind === 'point'){ xs.push(fVal(pt.cx)); ys.push(fVal(pt.cy)); if(add('ZfPt', '(' + fVal(pt.cx) + ',' + fVal(pt.cy) + ')')){ try { ggb.setColor('ZfPt', 94, 23, 235); ggb.setPointSize('ZfPt', 6); } catch(e){} } }
        });
      }
      (poles || []).forEach(function(p, i){
        var nm = 'ZfP' + (i + 1);
        if(add(nm, '(' + p.x + ',' + p.y + ')')){ try { ggb.setColor(nm, 220, 38, 38); ggb.setPointSize(nm, 5); ggb.setPointStyle(nm, 2); ggb.setCaption(nm, 'exclu'); ggb.setLabelStyle(nm, 3); ggb.setLabelVisible(nm, true); } catch(e){} }
        xs.push(p.x); ys.push(p.y);
      });
      (pts || []).forEach(function(p, i){
        var nm = 'ZfS' + (i + 1);
        if(add(nm, '(' + p.x + ',' + p.y + ')')){ try { ggb.setColor(nm, 255, 194, 58); ggb.setPointSize(nm, 7); ggb.setCaption(nm, 'z' + (i + 1)); ggb.setLabelStyle(nm, 3); ggb.setLabelVisible(nm, true); } catch(e){} }
        xs.push(p.x); ys.push(p.y);
      });
      var xmin = Math.min.apply(null, xs), xmax = Math.max.apply(null, xs), ymin = Math.min.apply(null, ys), ymax = Math.max.apply(null, ys);
      var pad = Math.max(2, 0.25 * Math.max(xmax - xmin, ymax - ymin));
      var host = document.getElementById('ggb'), W = (host && host.clientWidth) || 800, H = (host && host.clientHeight) || 480;
      var xr = (xmax - xmin) + 2 * pad, yr = (ymax - ymin) + 2 * pad, upp = Math.max(xr / W, yr / H), cx = (xmin + xmax) / 2, cy = (ymin + ymax) / 2;
      try { ggb.setCoordSystem(cx - upp * W / 2, cx + upp * W / 2, cy - upp * H / 2, cy + upp * H / 2); } catch(e){}
    }

