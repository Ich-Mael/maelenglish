    /* ============ STATISTIQUES ============ */
    var modeStats   = document.getElementById('mode-stats');
    var statsTypeEl = document.getElementById('stats-type');
    var statsSeriesF = document.getElementById('stats-series-fields');
    var statsRegF   = document.getElementById('stats-reg-fields');
    var statsPrevEl = document.getElementById('stats-preview');
    var statsOpsEl  = document.getElementById('stats-ops');
    var stVals = document.getElementById('st-vals'), stEff = document.getElementById('st-eff');
    var stX = document.getElementById('st-x'), stY = document.getElementById('st-y');
    var statsType = 'series';
    var statsObjs = [];

    function setStatsOpsEnabled(on){ statsOpsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }
    function parseNums(s){
      s = (s || '').trim();
      s = s.split(';').join(',').split(String.fromCharCode(10)).join(',').split(String.fromCharCode(9)).join(',').split(' ').join(',');
      return s.split(',').map(function(t){ return t.trim(); }).filter(function(t){ return t !== ''; }).map(Number).filter(function(v){ return isFinite(v); });
    }
    function setStatsType(t){
      statsType = t;
      statsTypeEl.querySelectorAll('.ml-sidebtn').forEach(function(b){ b.classList.toggle('is-active', b.getAttribute('data-stype') === t); });
      statsSeriesF.hidden = (t !== 'series'); statsRegF.hidden = (t !== 'reg');
      updateStatsPreview();
    }
    statsTypeEl.addEventListener('click', function(ev){ var b = ev.target.closest('.ml-sidebtn'); if(b) setStatsType(b.getAttribute('data-stype')); });
    function updateStatsPreview(){
      var txt;
      if(statsType === 'series'){ var v = parseNums(stVals.value); txt = v.length ? (v.length + ' valeur(s) — min ' + pf(Math.min.apply(null, v)) + ', max ' + pf(Math.max.apply(null, v))) : 'Saisissez la série…'; }
      else { var xs = parseNums(stX.value), ys = parseNums(stY.value); txt = (xs.length && ys.length) ? (xs.length + ' valeur(s) en x, ' + ys.length + ' en y' + (xs.length !== ys.length ? ' — tailles différentes !' : '')) : 'Saisissez les couples (x, y)…'; }
      statsPrevEl.className = 'ml-preview is-empty'; statsPrevEl.textContent = txt;
    }
    [stVals, stEff, stX, stY].forEach(function(inp){ inp.addEventListener('input', updateStatsPreview); });

    function seriesStats(vals, effs){
      var ns = (effs && effs.length === vals.length) ? effs.slice() : vals.map(function(){ return 1; });
      var N = 0; for(var i = 0; i < ns.length; i++) N += ns[i];
      if(N <= 0) return null;
      var sum = 0, sum2 = 0; for(var i2 = 0; i2 < vals.length; i2++){ sum += ns[i2] * vals[i2]; sum2 += ns[i2] * vals[i2] * vals[i2]; }
      var mean = sum / N, V = Math.max(0, sum2 / N - mean * mean), sd = Math.sqrt(V);
      var flat = [], cap = 200000;
      for(var i3 = 0; i3 < vals.length && flat.length < cap; i3++){ var c = Math.round(ns[i3]); for(var j = 0; j < c && flat.length < cap; j++) flat.push(vals[i3]); }
      flat.sort(function(a, b){ return a - b; });
      var n = flat.length;
      function rankVal(q){ var r = Math.ceil(q * n); if(r < 1) r = 1; if(r > n) r = n; return flat[r - 1]; }
      var med = n % 2 ? flat[(n - 1) / 2] : (flat[n / 2 - 1] + flat[n / 2]) / 2;
      return { N: N, mean: mean, V: V, sd: sd, med: med, Q1: rankVal(0.25), Q3: rankVal(0.75), min: flat[0], max: flat[n - 1], etendue: flat[n - 1] - flat[0] };
    }
    function regStats(xs, ys){
      var n = xs.length; if(n < 2 || ys.length !== n) return null;
      var mx = 0, my = 0; for(var i = 0; i < n; i++){ mx += xs[i]; my += ys[i]; } mx /= n; my /= n;
      var cov = 0, vx = 0, vy = 0; for(var i2 = 0; i2 < n; i2++){ var dx = xs[i2] - mx, dy = ys[i2] - my; cov += dx * dy; vx += dx * dx; vy += dy * dy; } cov /= n; vx /= n; vy /= n;
      if(vx === 0) return null;
      return { n: n, a: cov / vx, b: my - (cov / vx) * mx, r: (vx > 0 && vy > 0) ? cov / Math.sqrt(vx * vy) : 0, mx: mx, my: my };
    }

    function clearStatsPlot(){ statsObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} }); statsObjs = []; }
    function sDefS(name, cmd){ try { ggb.evalCommand(name + '=' + cmd); statsObjs.push(name); return true; } catch(e){ return false; } }
    function plotReg(xs, ys, a, b){
      clearStatsPlot(); try { ggb.deleteObject('f'); } catch(e){}
      // Individual named points (a list {…} doesn't render reliably in this embed).
      for(var i = 0; i < xs.length && i < 80; i++){
        var nm = 'stP' + i;
        if(sDefS(nm, '(' + xs[i] + ',' + ys[i] + ')')){ try { ggb.setColor(nm, 93, 6, 186); ggb.setPointSize(nm, 4); ggb.setLabelVisible(nm, false); } catch(e){} }
      }
      if(sDefS('stLine', 'y = ' + a + '*x + ' + b)){ try { ggb.setColor('stLine', 245, 158, 11); ggb.setLineThickness('stLine', 4); } catch(e){} }
      var minx = Math.min.apply(null, xs), maxx = Math.max.apply(null, xs), miny = Math.min.apply(null, ys), maxy = Math.max.apply(null, ys);
      var px = (maxx - minx) * 0.15 + 1, py = (maxy - miny) * 0.15 + 1;
      try { ggb.setCoordSystem(minx - px, maxx + px, miny - py, maxy + py); } catch(e){}
      setTimeout(fitGraph, 50);
    }
    function plotBox(s){
      clearStatsPlot(); try { ggb.deleteObject('f'); } catch(e){}
      var y0 = 0.7, y1 = 1.3, ym = 1;
      if(sDefS('stBox', 'Polygon((' + s.Q1 + ',' + y0 + '),(' + s.Q3 + ',' + y0 + '),(' + s.Q3 + ',' + y1 + '),(' + s.Q1 + ',' + y1 + '))')){ try { ggb.setColor('stBox', 93, 6, 186); ggb.setFilling('stBox', 0.12); } catch(e){} }
      if(sDefS('stMed', 'Segment((' + s.med + ',' + y0 + '),(' + s.med + ',' + y1 + '))')){ try { ggb.setColor('stMed', 220, 38, 38); ggb.setLineThickness('stMed', 4); } catch(e){} }
      if(sDefS('stW1', 'Segment((' + s.min + ',' + ym + '),(' + s.Q1 + ',' + ym + '))')){ try { ggb.setColor('stW1', 120, 120, 120); } catch(e){} }
      if(sDefS('stW2', 'Segment((' + s.Q3 + ',' + ym + '),(' + s.max + ',' + ym + '))')){ try { ggb.setColor('stW2', 120, 120, 120); } catch(e){} }
      var pad = (s.max - s.min) * 0.15 + 1;
      try { ggb.setCoordSystem(s.min - pad, s.max + pad, -0.6, 2.6); } catch(e){}
      setTimeout(fitGraph, 50);
    }

    async function runStats(){
      if(!ggb){ return; }
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul…';
      setStatsOpsEnabled(false);
      var kq = [], kid = 0;
      function km(l){ var id = 'sxk' + (kid++); kq.push({ id: id, latex: l }); return '<span class="study-math" id="' + id + '"></span>'; }
      function line(label, l){ var s = '<div class="study-line">'; if(label) s += '<span class="study-lbl">' + label + '</span> '; if(l) s += km(l); return s + '</div>'; }
      var title, body = '', op, defStr, summary;

      if(statsType === 'series'){
        var vals = parseNums(stVals.value), effs = parseNums(stEff.value);
        if(vals.length < 1){ stateEl.textContent = 'Saisissez au moins une valeur.'; setStatsOpsEnabled(true); return; }
        if(effs.length && effs.length !== vals.length){ stateEl.textContent = 'Valeurs et effectifs doivent avoir le même nombre.'; setStatsOpsEnabled(true); return; }
        var s = seriesStats(vals, effs.length ? effs : null);
        if(!s){ stateEl.textContent = 'Série invalide.'; setStatsOpsEnabled(true); return; }
        plotBox(s);
        title = 'Série statistique (N = ' + s.N + ')';
        body += line('Moyenne :', BS + 'bar{x} = ' + pf(s.mean));
        body += line('Variance :', 'V = ' + pf(s.V));
        body += line('Écart-type :', BS + 'sigma = ' + BS + 'sqrt{V} = ' + pf(s.sd));
        body += line('Médiane :', 'M_e = ' + pf(s.med));
        body += line('Quartiles :', 'Q_1 = ' + pf(s.Q1) + ', ' + BS + 'quad Q_3 = ' + pf(s.Q3) + ', ' + BS + 'quad Q_3 - Q_1 = ' + pf(s.Q3 - s.Q1));
        body += line('Étendue :', BS + 'max - ' + BS + 'min = ' + pf(s.max) + ' - ' + pf(s.min) + ' = ' + pf(s.etendue));
        op = 'stats_series'; defStr = 'valeurs : ' + vals.join(', ') + (effs.length ? ' ; effectifs : ' + effs.join(', ') : '');
        summary = ('moyenne=' + pf(s.mean) + ' ; variance=' + pf(s.V) + ' ; ecart-type=' + pf(s.sd) + ' ; mediane=' + pf(s.med) + ' ; Q1=' + pf(s.Q1) + ' ; Q3=' + pf(s.Q3) + ' ; etendue=' + pf(s.etendue)).slice(0, 480);
      } else {
        var xs = parseNums(stX.value), ys = parseNums(stY.value);
        if(xs.length < 2 || ys.length !== xs.length){ stateEl.textContent = 'x et y doivent avoir le même nombre de valeurs (≥ 2).'; setStatsOpsEnabled(true); return; }
        var r = regStats(xs, ys);
        if(!r){ stateEl.textContent = 'Régression impossible (x constant ?).'; setStatsOpsEnabled(true); return; }
        plotReg(xs, ys, r.a, r.b);
        var bsign = r.b >= 0 ? ' + ' + pf(r.b) : ' - ' + pf(-r.b);
        title = 'Ajustement affine (' + r.n + ' points)';
        body += line('Moyennes :', BS + 'bar{x} = ' + pf(r.mx) + ', ' + BS + 'quad ' + BS + 'bar{y} = ' + pf(r.my));
        body += line('Droite de régression :', 'y = ' + pf(r.a) + 'x' + bsign);
        body += line('Coefficient a :', 'a = ' + BS + 'dfrac{' + BS + 'mathrm{Cov}(x,y)}{V(x)} = ' + pf(r.a));
        body += line('Corrélation :', 'r = ' + pf(r.r) + ' ' + BS + 'quad (r^2 = ' + pf(r.r * r.r) + ')');
        op = 'stats_regression'; defStr = 'x : ' + xs.join(', ') + ' ; y : ' + ys.join(', ');
        summary = ('droite : y=' + pf(r.a) + 'x' + (r.b >= 0 ? '+' : '') + pf(r.b) + ' ; a=' + pf(r.a) + ' ; b=' + pf(r.b) + ' ; r=' + pf(r.r) + ' ; moyennes x=' + pf(r.mx) + ' y=' + pf(r.my)).slice(0, 480);
      }

      answerEl.innerHTML = '<div class="ml-study" style="padding:.9rem 1.1rem"><div class="study-head"><i class="bi bi-bar-chart-line"></i> ' + escapeHtml(title) + '</div><div class="study-body">' + body + '</div></div>';
      kq.forEach(function(it){ var el = document.getElementById(it.id); if(el){ try { renderKatex(el, it.latex); } catch(e){} } });
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';
      try {
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ function: defStr.slice(0, 190), operation: op, casResult: summary }) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){ stateEl.textContent = 'Connexion impossible — réessayez.'; }
      finally { setStatsOpsEnabled(true); }
    }
    statsOpsEl.addEventListener('click', function(ev){ var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return; runStats(); });

    /* ============ ÉQUATIONS DIFFÉRENTIELLES ============ */
    var modeDiffeq  = document.getElementById('mode-diffeq');
    var deqTypeEl   = document.getElementById('deq-type');
    var deqFirstF   = document.getElementById('deq-first-fields');
    var deqSecondF  = document.getElementById('deq-second-fields');
    var deqPrevEl   = document.getElementById('deq-preview');
    var deqOpsEl    = document.getElementById('deq-ops');
    var dqA = document.getElementById('dq-a'), dqB = document.getElementById('dq-b'), dqX0 = document.getElementById('dq-x0'), dqY0 = document.getElementById('dq-y0');
    var dqW = document.getElementById('dq-w'), dqSy0 = document.getElementById('dq-sy0'), dqSy1 = document.getElementById('dq-sy1');
    var deqType = 'first';

    function setDeqOpsEnabled(on){ deqOpsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }
    function dNum(s){ s = (s || '').trim(); if(s.indexOf('/') > 0){ var p = s.split('/'); return Number(p[0]) / Number(p[1]); } return Number(s); }
    function termPM(v){ if(Math.abs(v) < 1e-12) return ''; return v > 0 ? ' + ' + vtFmt(v) : ' - ' + vtFmt(-v); }
    function fmtAx(a){ if(Math.abs(a - 1) < 1e-12) return 'x'; if(Math.abs(a + 1) < 1e-12) return '-x'; return vtFmt(a) + 'x'; }
    function expTerm(c, ax){ if(Math.abs(c) < 1e-12) return '0'; var coef = Math.abs(Math.abs(c) - 1) < 1e-12 ? (c < 0 ? '-' : '') : vtFmt(c) + BS + ','; return coef + 'e^{' + ax + '}'; }
    function twoTerms(c1, b1, c2, b2){
      function t(c, b){ if(Math.abs(c) < 1e-12) return null; var a = Math.abs(c); var coef = Math.abs(a - 1) < 1e-12 ? '' : vtFmt(a) + BS + ','; return { s: c < 0 ? '-' : '+', str: coef + b }; }
      var arr = [t(c1, b1), t(c2, b2)], out = '';
      arr.forEach(function(x){ if(!x) return; out = out === '' ? (x.s === '-' ? '-' : '') + x.str : out + ' ' + x.s + ' ' + x.str; });
      return out || '0';
    }

    function setDeqType(t){
      deqType = t;
      deqTypeEl.querySelectorAll('.ml-sidebtn').forEach(function(b){ b.classList.toggle('is-active', b.getAttribute('data-dtype') === t); });
      deqFirstF.hidden = (t !== 'first'); deqSecondF.hidden = (t !== 'second');
      updateDeqPreview();
    }
    deqTypeEl.addEventListener('click', function(ev){ var b = ev.target.closest('.ml-sidebtn'); if(b) setDeqType(b.getAttribute('data-dtype')); });
    function updateDeqPreview(){
      var tex = null;
      try {
        if(deqType === 'first'){ var a = dNum(dqA.value), b = dNum(dqB.value); if(!isFinite(a) || !isFinite(b)) throw 0; tex = "y' = " + vtFmt(a) + 'y' + termPM(b); }
        else { var w = dNum(dqW.value); if(!(w > 0)) throw 0; tex = "y'' + " + vtFmt(w * w) + 'y = 0'; }
      } catch(e){ tex = null; }
      if(tex == null){ deqPrevEl.className = 'ml-preview is-empty'; deqPrevEl.textContent = '…'; return; }
      try { renderKatex(deqPrevEl, tex); deqPrevEl.className = 'ml-preview'; }
      catch(e){ deqPrevEl.className = 'ml-preview is-empty'; deqPrevEl.textContent = '…'; }
    }
    [dqA, dqB, dqX0, dqY0, dqW, dqSy0, dqSy1].forEach(function(inp){ inp.addEventListener('input', updateDeqPreview); });

    async function runDiffEq(){
      if(!ggb){ return; }
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Résolution…';
      setDeqOpsEnabled(false);
      var kq = [], kid = 0;
      function km(l){ var id = 'dqk' + (kid++); kq.push({ id: id, latex: l }); return '<span class="study-math" id="' + id + '"></span>'; }
      function line(label, l){ var s = '<div class="study-line">'; if(label) s += '<span class="study-lbl">' + label + '</span> '; if(l) s += km(l); return s + '</div>'; }
      var title, body = '', defStr, summary, plotF = '', cx0 = 0;

      if(deqType === 'first'){
        var a = dNum(dqA.value), b = dNum(dqB.value), x0 = dNum(dqX0.value), y0 = dNum(dqY0.value);
        if(![a, b, x0, y0].every(isFinite)){ stateEl.textContent = 'Vérifiez a, b et la condition initiale.'; setDeqOpsEnabled(true); return; }
        title = 'y′ = a·y + b'; cx0 = x0;
        body += line('Équation :', "y' = " + vtFmt(a) + 'y' + termPM(b));
        if(Math.abs(a) > 1e-12){
          var ba = b / a, ax = fmtAx(a), C = (y0 + ba) * Math.exp(-a * x0);
          body += line('Solution générale :', 'y = C' + BS + ',e^{' + ax + '}' + termPM(-ba) + ',' + BS + 'quad C ' + BS + 'in ' + BS + 'mathbb{R}');
          body += line('Solution particulière :', 'y = ' + expTerm(C, ax) + termPM(-ba));
          plotF = C + '*exp(' + a + '*x)+(' + (-ba) + ')';
          summary = ('y=' + vtFmt(C) + 'e^(' + ax + ')' + termPM(-ba) + ' ; gen: y=Ce^(' + ax + ')' + termPM(-ba) + ' ; CI y(' + vtFmt(x0) + ')=' + vtFmt(y0)).slice(0, 480);
        } else {
          var K = y0 - b * x0;
          body += line('Solution générale :', 'y = ' + vtFmt(b) + 'x + C');
          body += line('Solution particulière :', 'y = ' + (Math.abs(b) < 1e-12 ? vtFmt(K) : vtFmt(b) + 'x' + termPM(K)));
          plotF = b + '*x+(' + K + ')';
          summary = ('a=0 : y=' + vtFmt(b) + 'x' + termPM(K) + ' ; CI y(' + vtFmt(x0) + ')=' + vtFmt(y0)).slice(0, 480);
        }
        defStr = "y' = " + vtFmt(a) + 'y' + termPM(b) + ', y(' + vtFmt(x0) + ')=' + vtFmt(y0);
      } else {
        var w = dNum(dqW.value), sy0 = dNum(dqSy0.value), sy1 = dNum(dqSy1.value);
        if(!(w > 0) || ![sy0, sy1].every(isFinite)){ stateEl.textContent = 'ω doit être > 0 ; vérifiez les conditions initiales.'; setDeqOpsEnabled(true); return; }
        title = 'y″ + ω²·y = 0'; cx0 = 0;
        var wx = (Math.abs(w - 1) < 1e-12 ? '' : vtFmt(w)) + 'x', B2 = sy1 / w;
        body += line('Équation :', "y'' + " + vtFmt(w * w) + 'y = 0' + BS + 'quad (' + BS + 'omega = ' + vtFmt(w) + ')');
        body += line('Solution générale :', 'y = A' + BS + 'cos(' + wx + ') + B' + BS + 'sin(' + wx + ')');
        body += line('Solution particulière :', 'y = ' + twoTerms(sy0, BS + 'cos(' + wx + ')', B2, BS + 'sin(' + wx + ')'));
        plotF = sy0 + '*cos(' + w + '*x)+(' + B2 + ')*sin(' + w + '*x)';
        defStr = "y'' + " + vtFmt(w * w) + "y = 0, y(0)=" + vtFmt(sy0) + ", y'(0)=" + vtFmt(sy1);
        summary = ('y=' + twoTerms(sy0, 'cos(' + wx + ')', B2, 'sin(' + wx + ')') + ' ; omega=' + vtFmt(w) + ' ; y(0)=' + vtFmt(sy0) + " ; y'(0)=" + vtFmt(sy1)).slice(0, 480);
      }

      // plot the particular solution
      try { ggb.deleteObject('f'); } catch(e){}
      try { ggb.evalCommand('f(x)=' + plotF); ggb.setColor('f', 93, 6, 186); ggb.setLineThickness('f', 4); } catch(e){}
      try { ggb.evalCommand('dqP=(' + cx0 + ', f(' + cx0 + '))'); ggb.setColor('dqP', 245, 158, 11); ggb.setPointSize('dqP', 4); ggb.setLabelVisible('dqP', false); } catch(e){}
      try { ggb.setCoordSystem(cx0 - 5, cx0 + 5, -8, 8); } catch(e){}
      setTimeout(fitGraph, 50);

      answerEl.innerHTML = '<div class="ml-study" style="padding:.9rem 1.1rem"><div class="study-head"><i class="bi bi-arrow-left-right"></i> Équation différentielle — ' + escapeHtml(title) + '</div><div class="study-body">' + body + '</div></div>';
      kq.forEach(function(it){ var el = document.getElementById(it.id); if(el){ try { renderKatex(el, it.latex); } catch(e){} } });
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';
      try {
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ function: defStr.slice(0, 190), operation: 'diff_eq', casResult: summary }) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){ stateEl.textContent = 'Connexion impossible — réessayez.'; }
      finally { setDeqOpsEnabled(true); }
    }
    deqOpsEl.addEventListener('click', function(ev){ var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return; runDiffEq(); });

    /* ============ ARITHMÉTIQUE (série C) ============ */
    var modeArith   = document.getElementById('mode-arith');
    var arithPrevEl = document.getElementById('arith-preview');
    var arithOpsEl  = document.getElementById('arith-ops');
    var arA = document.getElementById('ar-a'), arB = document.getElementById('ar-b'), arN = document.getElementById('ar-n');

    function setArithOpsEnabled(on){ arithOpsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }
    function intVal(s){ s = (s || '').trim(); var v = Number(s); return (isFinite(v) && Math.abs(v) < 1e15 && Math.floor(v) === v) ? v : NaN; }
    function gcdN(a, b){ a = Math.abs(a); b = Math.abs(b); while(b){ var t = a % b; a = b; b = t; } return a; }
    function euclidSteps(x, y){ var st = [], guard = 0; while(y !== 0 && guard++ < 100){ var q = Math.floor(x / y), r = x - q * y; st.push(x + ' = ' + y + ' ' + BS + 'times ' + q + ' + ' + r); x = y; y = r; } return st; }
    function extGcd(a, b){ var or = Math.abs(a), r = Math.abs(b), os = 1, s = 0, ot = 0, t = 1; while(r !== 0){ var q = Math.floor(or / r), tmp; tmp = or - q * r; or = r; r = tmp; tmp = os - q * s; os = s; s = tmp; tmp = ot - q * t; ot = t; t = tmp; } return { g: or, u: os * (a < 0 ? -1 : 1), v: ot * (b < 0 ? -1 : 1) }; }
    function factorize(x){ x = Math.abs(x); var f = []; if(x < 2) return f; for(var d = 2; d * d <= x; d++){ if(x % d === 0){ var e = 0; while(x % d === 0){ x = x / d; e++; } f.push([d, e]); } } if(x > 1) f.push([x, 1]); return f; }
    function factorLatex(f){ if(!f.length) return '1'; return f.map(function(pr){ return pr[1] === 1 ? String(pr[0]) : pr[0] + '^{' + pr[1] + '}'; }).join(' ' + BS + 'times '); }
    function modpow(a, b, n){ var m = BigInt(n); if(m === 1n) return 0n; var base = ((BigInt(a) % m) + m) % m, e = BigInt(b), r = 1n; while(e > 0n){ if(e & 1n) r = (r * base) % m; base = (base * base) % m; e >>= 1n; } return r; }

    function updateArithPreview(){
      var a = intVal(arA.value), b = intVal(arB.value);
      arithPrevEl.className = 'ml-preview is-empty';
      arithPrevEl.textContent = (isFinite(a) && isFinite(b)) ? ('a = ' + a + ',  b = ' + b + (isFinite(intVal(arN.value)) ? ',  n = ' + intVal(arN.value) : '')) : 'Saisissez des entiers a et b…';
    }
    [arA, arB, arN].forEach(function(inp){ inp.addEventListener('input', updateArithPreview); });

    async function runArith(aop){
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul…';
      setArithOpsEnabled(false);
      var a = intVal(arA.value), b = intVal(arB.value), n = intVal(arN.value);
      var kq = [], kid = 0;
      function km(l){ var id = 'ark' + (kid++); kq.push({ id: id, latex: l }); return '<span class="study-math" id="' + id + '"></span>'; }
      function line(label, l){ var s = '<div class="study-line">'; if(label) s += '<span class="study-lbl">' + label + '</span> '; if(l) s += km(l); return s + '</div>'; }
      var title, body = '', defStr, summary;

      if(aop === 'gcd' || aop === 'bezout' || aop === 'diveucl'){
        if(!isFinite(a) || !isFinite(b)){ stateEl.textContent = 'Saisissez des entiers a et b.'; setArithOpsEnabled(true); return; }
      }

      if(aop === 'gcd'){
        if(a === 0 && b === 0){ stateEl.textContent = 'a et b non tous deux nuls.'; setArithOpsEnabled(true); return; }
        var g = gcdN(a, b), l = g ? Math.abs(a / g * b) : 0;
        title = 'PGCD & PPCM';
        euclidSteps(Math.abs(a), Math.abs(b)).forEach(function(stp){ body += line('', stp); });
        body += line('PGCD :', BS + 'mathrm{PGCD}(' + a + ', ' + b + ') = ' + g);
        body += line('PPCM :', BS + 'mathrm{PPCM}(' + a + ', ' + b + ') = ' + BS + 'dfrac{|a ' + BS + 'times b|}{' + BS + 'mathrm{PGCD}} = ' + l);
        defStr = 'PGCD et PPCM de ' + a + ' et ' + b; summary = ('PGCD(' + a + ',' + b + ')=' + g + ' ; PPCM=' + l).slice(0, 480);
      } else if(aop === 'bezout'){
        var e = extGcd(a, b);
        title = 'Identité de Bézout';
        body += line('PGCD :', BS + 'mathrm{PGCD}(' + a + ', ' + b + ') = ' + e.g);
        body += line('Coefficients :', 'u = ' + e.u + ', ' + BS + 'quad v = ' + e.v);
        body += line('Vérification :', a + ' ' + BS + 'times (' + e.u + ') + ' + b + ' ' + BS + 'times (' + e.v + ') = ' + e.g);
        defStr = 'Coefficients de Bézout pour ' + a + ' et ' + b; summary = ('u=' + e.u + ' ; v=' + e.v + ' ; ' + a + 'u+' + b + 'v=' + e.g).slice(0, 480);
      } else if(aop === 'diveucl'){
        if(b === 0){ stateEl.textContent = 'b doit être non nul.'; setArithOpsEnabled(true); return; }
        var ab = Math.abs(b), r2 = ((a % ab) + ab) % ab, q2 = (a - r2) / b;
        title = 'Division euclidienne';
        body += line('', a + ' = ' + b + ' ' + BS + 'times ' + q2 + ' + ' + r2);
        body += line('', 'q = ' + q2 + ', ' + BS + 'quad r = ' + r2 + ' ' + BS + 'quad (0 ' + BS + 'le r < ' + ab + ')');
        defStr = 'Division euclidienne de ' + a + ' par ' + b; summary = (a + '=' + b + '*' + q2 + '+' + r2 + ' ; q=' + q2 + ' ; r=' + r2).slice(0, 480);
      } else if(aop === 'factor'){
        if(!isFinite(a) || Math.abs(a) < 2){ stateEl.textContent = 'Saisissez un entier a (|a| ≥ 2) à décomposer.'; setArithOpsEnabled(true); return; }
        var f = factorize(a);
        title = 'Décomposition en facteurs premiers';
        body += line('', (a < 0 ? '-' : '') + Math.abs(a) + ' = ' + (a < 0 ? '-' : '') + factorLatex(f));
        if(f.length === 1 && f[0][1] === 1) body += line('', Math.abs(a) + ' ' + BS + 'text{ est premier.}');
        defStr = 'Décomposition en facteurs premiers de ' + a; summary = (Math.abs(a) + ' = ' + f.map(function(pr){ return pr[1] === 1 ? pr[0] : pr[0] + '^' + pr[1]; }).join(' x ')).slice(0, 480);
      } else { // modpow
        if(!isFinite(a) || !isFinite(b) || !isFinite(n) || b < 0 || n < 1){ stateEl.textContent = 'Pour aᵇ mod n : b ≥ 0 et n ≥ 1.'; setArithOpsEnabled(true); return; }
        var res = modpow(a, b, n).toString();
        title = 'Puissance modulaire';
        body += line('', a + '^{' + b + '} ' + BS + 'equiv ' + res + ' ' + BS + 'pmod{' + n + '}');
        body += line('', a + '^{' + b + '} ' + BS + 'bmod ' + n + ' = ' + res);
        defStr = a + '^' + b + ' mod ' + n; summary = (a + '^' + b + ' = ' + res + ' (mod ' + n + ')').slice(0, 480);
      }

      answerEl.innerHTML = '<div class="ml-study" style="padding:.9rem 1.1rem"><div class="study-head"><i class="bi bi-123"></i> ' + escapeHtml(title) + '</div><div class="study-body">' + body + '</div></div>';
      kq.forEach(function(it){ var el = document.getElementById(it.id); if(el){ try { renderKatex(el, it.latex); } catch(e){} } });
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';
      try {
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ function: defStr.slice(0, 190), operation: 'arithmetique', casResult: summary }) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){ stateEl.textContent = 'Connexion impossible — réessayez.'; }
      finally { setArithOpsEnabled(true); }
    }
    arithOpsEl.addEventListener('click', function(ev){ var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return; runArith(btn.getAttribute('data-aop')); });

    /* ============ FORMULAIRES (per-topic dropdowns) ============ */
    (function(){
      function fxL(s){ return s.split('#').join(BS); } // '#' stands in for backslash (EJS-safe)
      var FORMULAS = {
