    // ---- parsing ----
    function vcNorm(s){ return String(s || '').split(String.fromCharCode(8722)).join('-').split(String.fromCharCode(8242)).join("'").split(String.fromCharCode(8217)).join("'").split(',').join('.').split('[').join('').split(']').join(''); }
    function vcIsUp(c){ return c >= 'A' && c <= 'Z'; }
    function vcIsDig(c){ return c >= '0' && c <= '9'; }
    function vcPointList(s){ // "A, B" / "ABC" / "A'B" → ['A','B',…]
      s = String(s || '').split(String.fromCharCode(8242)).join("'").split(String.fromCharCode(8217)).join("'");
      var out = [], i = 0;
      while(i < s.length){ var c = s.charAt(i); if(vcIsUp(c)){ var j = i + 1; while(j < s.length && (vcIsDig(s.charAt(j)) || s.charAt(j) === "'")) j++; out.push(s.slice(i, j)); i = j; } else i++; }
