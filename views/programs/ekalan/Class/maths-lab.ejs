              <div class="sys-row"><span class="sys-lbl">B</span><input id="tf-b" type="text" class="sysf-in" value="1+i" autocomplete="off" /><span class="sys-op">↦</span><span class="sys-lbl">B′</span><input id="tf-b2" type="text" class="sysf-in" value="-1+2i" autocomplete="off" /></div>
