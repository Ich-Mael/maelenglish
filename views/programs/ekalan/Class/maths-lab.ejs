        .split(BS + '[').join('$').split(BS + ']').join('$');
      var parts = s.split('$');
      for(var i = 0; i < parts.length; i++){
        if(i % 2 === 1 && parts[i] !== ''){
          var span = document.createElement('span');
          try { katex.render(parts[i], span, { throwOnError:false, displayMode:false }); }
          catch(e){ span.textContent = parts[i]; }
          el.appendChild(span);
        } else if(parts[i] !== ''){
          el.appendChild(document.createTextNode(parts[i]));
        }
      }
    }

    // CAS command per operation, against the raw expression
