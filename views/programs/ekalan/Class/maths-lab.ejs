    // Keep the GeoGebra applet sized to its (now full-width) container.
    var ggbHost = document.getElementById('ggb');
    // Applet size, clamped to the viewport so it never overflows on phones.
    function ggbSize(){
      var vw = window.innerWidth || 700;
      var w = Math.max(300, Math.min(ggbHost.clientWidth || (vw - 32), vw - 16));
      var h = Math.min(540, Math.max(400, Math.round(w * 0.55)));
      return { w: w, h: h };
    }
    function fitGraph(){
      if(!ggb) return;
      var s = ggbSize();
      try { ggb.setSize(s.w, s.h); } catch(e){}
    }
    var ggbResizeTimer = null;
    window.addEventListener('resize', function(){ clearTimeout(ggbResizeTimer); ggbResizeTimer = setTimeout(fitGraph, 200); });
    window.addEventListener('orientationchange', function(){ setTimeout(fitGraph, 300); });

    // GeoGebra applet
    setOpsEnabled(false); setCOpsEnabled(false); setGOpsEnabled(false); setLOpsEnabled(false); setIOpsEnabled(false); setSuiteOpsEnabled(false); setProbaOpsEnabled(false); setStatsOpsEnabled(false); setDeqOpsEnabled(false);
    setSuiteType('explicit'); setProbaType('binom'); setStatsType('series'); setDeqType('first');
    if(eqSolveBtn) eqSolveBtn.disabled = true;
    setEqStepsEnabled(false);
    var _s0 = ggbSize();
    var applet = new GGBApplet({
      appName: 'classic',
      width: _s0.w, height: _s0.h,
      showToolBar: false, showAlgebraInput: false, showMenuBar: false,
