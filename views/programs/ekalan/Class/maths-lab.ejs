      if(!s) throw 'vide';
      function peek(){ return s.charAt(pos); }
      function num(){ var j = pos; while(pos < s.length && (vcIsDig(s.charAt(pos)) || s.charAt(pos) === '.')) pos++; if(j === pos) return null; var f = fFromNum(Number(s.slice(j, pos))); if(!f) throw 'nombre'; return f; }
      function point(){ var c = peek(); if(!vcIsUp(c)) return null; var j = pos; pos++; while(pos < s.length && (vcIsDig(s.charAt(pos)) || s.charAt(pos) === "'")) pos++; return s.slice(j, pos); }
      function scale(list, k){ return list.map(function(t){ return t.V ? { k: fMul(t.k, k), V: t.V } : { k: fMul(t.k, k), X: t.X, Y: t.Y }; }); }
      function factor(){
        if(peek() === '('){ pos++; var e = expr(); if(peek() !== ')') throw 'parenthèse'; pos++; return e; }
        var lc = peek(); if(lc >= 'a' && lc <= 'z' && !vcIsUp(s.charAt(pos + 1))){ pos++; return [{ k: fr(1), V: lc }]; } // named vector u, v, w (dans un repère)
        var X = point(); if(!X) return null; var Y = point(); if(!Y) throw 'vecteur'; return [{ k: fr(1), X: X, Y: Y }];
      }
