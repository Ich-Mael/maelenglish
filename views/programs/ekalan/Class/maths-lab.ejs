    function buildEquation(){
      var a = (eqaInput.value || '').trim() || '0';
      var b = (eqbInput.value || '').trim() || '0';
      var c = (eqcInput.value || '').trim() || '0';
      var d = (eqdInput.value || '').trim() || '0';
      return '(' + a + ')*z^3 + (' + b + ')*z^2 + (' + c + ')*z + (' + d + ')';
    }

    // Shown only for degree ≤ 2 (a = 0). Solved with the reliable JS quadratic formula.
    function eqIsCubic(){ return !cIsZero(coefVal(eqaInput.value)); }
    function refreshDirectSolve(){
      var cubic = eqIsCubic();
      document.getElementById('eq-direct-row').hidden = cubic;
      document.getElementById('eq-cubic-hint').hidden = !cubic;
    }
    eqaInput.addEventListener('input', refreshDirectSolve);

    async function runSolve(){
      if(eqIsCubic()){ return; } // direct solve is for degree ≤ 2 only
      var b = (eqbInput.value || '').trim(), c = (eqcInput.value || '').trim(), d = (eqdInput.value || '').trim();
      if(!ggb){ return; }
      var qb = coefVal(eqbInput.value), qc = coefVal(eqcInput.value), qd = coefVal(eqdInput.value);
      if(cIsZero(qb) && cIsZero(qc)){ stateEl.textContent = 'Renseignez au moins le coefficient b ou c (équation en z).'; return; }

      clearComplexPlot(); try { ggb.deleteObject('f'); } catch(e){}
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Résolution en cours…';
      eqSolveBtn.disabled = true; setCOpsEnabled(false);

      var roots = solveQuad(qb, qc, qd); // numeric, for plotting
      var exact = exactQuadRoots(qb, qc, qd); // exact with √, if integer coeffs
      var rootStrs = exact || roots.map(function(r){ return fmtComplexVal(r.re, r.im); });
      var casResult = rootStrs.length ? ('{' + rootStrs.join(', ') + '}') : '';
      if(!casResult){ stateEl.textContent = 'Impossible de résoudre — vérifiez les coefficients.'; eqSolveBtn.disabled = false; setCOpsEnabled(true); return; }

      // Plot the roots on the Argand plane.
      roots.forEach(function(r, idx){ var nm = 'rqs' + (idx + 1); defObj(nm, '(' + r.re + ',' + r.im + ')'); colour(nm, 255, 184, 0); });

      setEqAnswer('Solutions dans ℂ', casResult);
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';

      var expr = '(' + (b || '0') + ')*z^2 + (' + (c || '0') + ')*z + (' + (d || '0') + ')';
      try {
        var resp = await fetch(EXPLAIN_URL, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ domain:'complex', operation:'solve_poly', expression: expr, casResult: casResult })
        });
        var data = await resp.json();
        if(data.ok){ showSteps(data); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){
        stateEl.textContent = 'Connexion impossible — réessayez.';
      } finally {
        setEqAnswer('Solutions dans ℂ', casResult); // authoritative computed roots
        eqSolveBtn.disabled = false; setCOpsEnabled(true);
      }
    }
    eqSolveBtn.addEventListener('click', runSolve);
    refreshDirectSolve();

    /* --- Résolution guidée pas à pas : f(z₀), racine évidente, Q(z), Q(z)=0 --- */
    var eqz0Input = document.getElementById('eqz0');
    var eqStepsEl = document.getElementById('eqsteps');
    eqz0Input.addEventListener('focus', function(){ activeZ = eqz0Input; });
    eqz0Input.addEventListener('keydown', function(ev){ if(ev.key === 'Enter'){ ev.preventDefault(); runEqStep('quotient'); } });
    function setEqStepsEnabled(on){ eqStepsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }

    // GeoGebra may print the imaginary unit as ί (U+03AF) or ⅈ (U+2148); show plain "i".
    function ggbToText(s){ return String(s == null ? '' : s).split(String.fromCharCode(0x3AF)).join('i').split(String.fromCharCode(0x2148)).join('i'); }

    // Insert explicit multiplication so GeoGebra never reads implicit products as
    // function calls — e.g. "4i(1-i)^4" → "4i*(1-i)^4" (else "i(…)" throws "Unknown command : i").
    function normCplx(s){
      s = String(s == null ? '' : s).split(String.fromCharCode(0x2212)).join('-');
      function dig(c){ return c >= '0' && c <= '9'; }
      var out = '';
      for(var k = 0; k < s.length; k++){
        var c = s.charAt(k), n = (k + 1 < s.length) ? s.charAt(k + 1) : '';
        out += c;
        if(n === '') continue;
        var ins = false;
        if(n === '(' && (dig(c) || c === ')' || c === 'i')) ins = true;        // 4( , )( , i(
        else if(c === ')' && (dig(n) || n === 'i' || n === '(')) ins = true;   // )4 , )i , )(
        else if(c === 'i' && dig(n)) ins = true;                               // i2
        if(ins) out += '*';
      }
      return out;
    }

    // Evaluate a complex expression via the graphics view (native complex support,
    // reliable even when evalCommandCAS chokes on the imaginary unit). Returns {re,im} or null.
    function evalComplex(expr){
      expr = normCplx(expr);
      var re = NaN, im = NaN;
      // real()/imaginary() handle BOTH real numbers and complex values uniformly
      // (getXcoord returns 0 for a real Number, which silently dropped real coefficients).
      try {
        ggb.evalCommand('cEvR=real(' + expr + ')');
        ggb.evalCommand('cEvI=imaginary(' + expr + ')');
        re = ggb.getValue('cEvR'); im = ggb.getValue('cEvI');
        if(!isFinite(re) || !isFinite(im)){
          ggb.evalCommand('cEvR=Real(' + expr + ')');
          ggb.evalCommand('cEvI=Imaginary(' + expr + ')');
          re = ggb.getValue('cEvR'); im = ggb.getValue('cEvI');
        }
      } catch(e){}
      try { ggb.deleteObject('cEvR'); ggb.deleteObject('cEvI'); } catch(e){}
      if(isFinite(re) && isFinite(im)) return { re: re, im: im };
      // Fallback: read as a graphics-view point (real()/imaginary() unavailable).
      re = NaN; im = NaN;
      try {
        ggb.evalCommand('cEvP=' + expr);
        re = ggb.getXcoord('cEvP'); im = ggb.getYcoord('cEvP');
        if(!isFinite(im)) im = 0;
      } catch(e){}
      try { ggb.deleteObject('cEvP'); } catch(e){}
      return (isFinite(re) && isFinite(im)) ? { re: re, im: im } : null;
    }
    function fmtComplexVal(re, im){
      function clean(x){ var r = Math.round(x * 1e6) / 1e6; if(Math.abs(r - Math.round(r)) < 1e-9) r = Math.round(r); return r; }
      re = clean(re); im = clean(im);
      if(im === 0) return String(re);
      var ia = Math.abs(im), imStr = (ia === 1 ? 'i' : (ia + 'i'));
      if(re === 0) return (im < 0 ? '-' : '') + imStr;
