    }
    function sysfSnap(v){
      if(Math.abs(v) < 1e-10) return { tex: '0', plain: '0', exact: true };
      var r = pwSnap(v);
      if(r.exact && r.tex.indexOf('sqrt') < 0) return r;
      var qd = sysfQuad(v); if(qd) return qd;
      var saved = ippExtraBases;
      ippExtraBases = [{ v: Math.sqrt(Math.E), n: BS + 'sqrt{e}', d: '', p: 'sqrt(e)' }, { v: Math.exp(1.5), n: 'e^{3/2}', d: '', p: 'exp(3/2)' }, { v: Math.exp(3), n: 'e^{3}', d: '', p: 'exp(3)' }, { v: Math.exp(4), n: 'e^{4}', d: '', p: 'exp(4)' }, { v: Math.log(5), n: BS + 'ln 5', d: '', p: 'ln(5)' }, { v: Math.log(6), n: BS + 'ln 6', d: '', p: 'ln(6)' }];
      var ip = ippSnap(v); ippExtraBases = saved;
      if(ip.exact) return ip;
      if(r.exact) return r;
      return { tex: BS + 'approx ' + (Math.round(v * 10000) / 10000), plain: '~' + (Math.round(v * 10000) / 10000), exact: false };
    }
    function sysfConds(eqs){
      var out = [], seen = {};
      function push(s, rel, relP){ var k = s + rel; if(seen[k]) return; seen[k] = 1; out.push({ tex: sysfTex(s) + ' ' + rel, plain: s + ' ' + relP }); }
      eqs.forEach(function(e){ [e.L, e.R].forEach(function walk(n){ if(!n) return;
        if(n.t === 'fn' && (n.name === 'ln' || n.name === 'log') && sysfHasVar(n.a)) push(sysfPrint(n.a), '> 0', '> 0');
        if(n.t === 'fn' && n.name === 'sqrt' && sysfHasVar(n.a)) push(sysfPrint(n.a), BS + 'geq 0', '>= 0');
        if(n.t === '/' && sysfHasVar(n.r)) push(sysfPrint(n.r), BS + 'neq 0', '!= 0');
        ['a', 'l', 'r'].forEach(function(k){ if(n[k] && typeof n[k] === 'object') walk(n[k]); });
      }); });
      return out;
    }
    function sysfHasVar(n){ if(!n) return false; if(n.t === 'var' || n.t === 'const') return true; return ['a', 'l', 'r'].some(function(k){ return n[k] && typeof n[k] === 'object' && sysfHasVar(n[k]); }); }
    function sysfTuple(tx){ return BS + 'left(' + tx.join(' ; ') + BS + 'right)'; }

    // Method chosen from the shape of the system (imposed on Claude so the explanation follows the
    // textbook approach: substitution y = k/x, somme-produit, ln → exp…, never an exotic change of variables).
    function sysfPoly(n, V){ // polynomial in the unknowns → { "i,j(,k)": coef } or null
      var z = V.map(function(){ return 0; });
      function mono(e, c){ var o = {}; o[e.join(',')] = c; return o; }
      function add(a, b, s){ var o = {}; Object.keys(a).forEach(function(k){ o[k] = a[k]; }); Object.keys(b).forEach(function(k){ o[k] = (o[k] || 0) + s * b[k]; }); return o; }
      function mul(a, b){ var o = {}; Object.keys(a).forEach(function(ka){ var ea = ka.split(',').map(Number); Object.keys(b).forEach(function(kb){ var eb = kb.split(',').map(Number), k = ea.map(function(x, i){ return x + eb[i]; }).join(','); o[k] = (o[k] || 0) + a[ka] * b[kb]; }); }); return o; }
      function isC(p){ return Object.keys(p).every(function(k){ return k === z.join(','); }); }
      function rec(n){
        if(!n) return null;
        switch(n.t){
          case 'num': return mono(z, n.v);
          case 'var': { var e = z.slice(); e[0] = 1; return mono(e, 1); }
          case 'const': { var i = V.indexOf(n.name); if(i < 0) return null; var e2 = z.slice(); e2[i] = 1; return mono(e2, 1); }
          case 'neg': { var a = rec(n.a); return a ? add({}, a, -1) : null; }
          case '+': case '-': { var l = rec(n.l), r = rec(n.r); return (l && r) ? add(l, r, n.t === '+' ? 1 : -1) : null; }
          case '*': { var l2 = rec(n.l), r2 = rec(n.r); return (l2 && r2) ? mul(l2, r2) : null; }
          case '/': { var l3 = rec(n.l), r3 = rec(n.r); if(!l3 || !r3 || !isC(r3)) return null; var d = r3[z.join(',')] || 0; if(!d) return null; return add({}, l3, 1 / d); }
          case '^': { var b = rec(n.l), ex = rec(n.r); if(!b || !ex || !isC(ex)) return null; var k = ex[z.join(',')] || 0; if(k < 0 || k > 6 || k !== Math.round(k)) return null; var res = mono(z, 1); for(var t = 0; t < k; t++) res = mul(res, b); return res; }
        }
        return null;
      }
      var p = rec(n); if(!p) return null;
      Object.keys(p).forEach(function(k){ if(Math.abs(p[k]) < 1e-12) delete p[k]; });
      return p;
    }
    function sysfHasFn(n, name){ if(!n) return false; if(n.t === 'fn' && n.name === name && sysfHasVar(n.a)) return true; if(n.t === '^' && n.l.t === 'num' && Math.abs(n.l.v - Math.E) < 1e-12 && name === 'exp' && sysfHasVar(n.r)) return true; return ['a', 'l', 'r'].some(function(k){ return n[k] && typeof n[k] === 'object' && sysfHasFn(n[k], name); }); }
    var SYSF_METHODS = {
      ln: 'Conditions d’existence, puis regrouper les logarithmes (ln a + ln b = ln(ab), ln a − ln b = ln(a/b)) et passer à l’exponentielle pour obtenir un système sans ln ; le résoudre ensuite (somme-produit ou substitution) et garder seulement les solutions qui respectent les conditions.',
      exp: 'Changement de variable X = eˣ et Y = eʸ (X > 0, Y > 0) : on obtient un système en X et Y, on le résout, puis on revient à x = ln X et y = ln Y.',
      sumprod: 'Somme et produit : x et y sont les solutions de l’équation X² − S·X + P = 0 (S = x + y, P = xy) ; on la résout avec le discriminant.',
      linear: 'Substitution : on isole une inconnue dans l’équation du premier degré, puis on la remplace dans l’autre équation.',
      product: 'Substitution : de xy = k on tire y = k / x (x ≠ 0), on remplace dans l’autre équation, on multiplie par x² et on pose X = x² (équation bicarrée) si nécessaire ; puis on calcule y = k / x.',
      sym3: 'x, y et z sont les racines de t³ − S·t² + Q·t − P = 0 (S = x + y + z, Q = xy + yz + zx, P = xyz) : on cherche une racine évidente puis on factorise.',
      linear3: 'Substitution : on exprime deux inconnues en fonction de la troisième grâce aux équations simples, puis on remplace dans l’équation restante.',
      generic: 'Substitution : on exprime une inconnue en fonction des autres à partir de l’équation la plus simple, puis on remplace dans les autres équations.'
    };
    function sysfMethod(eqs, V){
      var n = V.length, polys = eqs.map(function(e){ return sysfPoly({ t:'-', l:e.L, r:e.R }, V); });
      if(eqs.some(function(e){ return sysfHasFn(e.L, 'ln') || sysfHasFn(e.R, 'ln') || sysfHasFn(e.L, 'log') || sysfHasFn(e.R, 'log'); })) return 'ln';
      if(eqs.some(function(e){ return sysfHasFn(e.L, 'exp') || sysfHasFn(e.R, 'exp'); })) return 'exp';
      function monos(p){ return p ? Object.keys(p).filter(function(k){ return k.split(',').some(function(x){ return x !== '0'; }); }).sort() : null; }
      function deg(p){ return p ? Math.max.apply(null, Object.keys(p).map(function(k){ return k.split(',').map(Number).reduce(function(a, b){ return a + b; }, 0); })) : 99; }
      function key(arr){ var e = V.map(function(){ return 0; }); arr.forEach(function(i){ e[i]++; }); return e.join(','); }
      function isSym(p, ks){ var m = monos(p); if(!m || m.length !== ks.length) return false; var c = p[ks[0]]; return ks.every(function(k){ return m.indexOf(k) >= 0 && Math.abs(p[k] - c) < 1e-12; }); }
      if(n === 2){
        var hasSum = polys.some(function(p){ return isSym(p, [key([0]), key([1])]); }), hasProd = polys.some(function(p){ return isSym(p, [key([0, 1])]); });
        if(hasSum && hasProd) return 'sumprod';
        if(polys.some(function(p){ return p && deg(p) <= 1; })) return 'linear';
        if(hasProd) return 'product';
        return 'generic';
      }
      var s1 = polys.some(function(p){ return isSym(p, [key([0]), key([1]), key([2])]); }), s2 = polys.some(function(p){ return isSym(p, [key([0, 1]), key([1, 2]), key([0, 2])]); }), s3 = polys.some(function(p){ return isSym(p, [key([0, 1, 2])]); });
      if(s1 && s2 && s3) return 'sym3';
      if(polys.filter(function(p){ return p && deg(p) <= 1; }).length >= 2) return 'linear3';
      return 'generic';
    }

    async function runSysFree(){
      var rd = sysfRead();
      if(rd.err){ stateEl.textContent = rd.err; return; }
      var eqs = rd.eqs, V = rd.V, n = V.length;
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Résolution…';
      setSysOpsEnabled(false);
      await new Promise(function(res){ setTimeout(res, 20); }); // let the spinner paint
      var R = e1Report(), body = '', res = sysfSolve(eqs, n), conds = sysfConds(eqs);
      var methodId = sysfMethod(eqs, V);
      body += R.sec('Système', R.line('', sysfSysTex(eqs)));
      body += R.sec('Méthode', '<div class="study-work">' + escapeHtml(SYSF_METHODS[methodId]) + '</div>');
      if(conds.length){
        body += R.sec('Conditions d’existence', R.line('', conds.map(function(c){ return c.tex; }).join(',' + BS + 'quad ')) + '<div class="study-work">Une solution n’est acceptée que si elle vérifie toutes ces conditions.</div>');
      }
      var solTex = [], solPlain = [], allExact = true, sumSol = '';
      if(res.infinite){
        body += R.sec('Solutions', '<div class="study-work">Les équations sont dépendantes : le système admet une <strong>infinité de solutions</strong> (une courbe de points).</div>');
        sumSol = 'infinite de solutions (equations dependantes)';
      } else if(!res.sols.length){
        body += R.sec('Solutions', R.line('', 'S = ' + BS + 'varnothing') + '<div class="study-work">Aucun couple de réels ne vérifie toutes les équations (et les conditions d’existence).</div>');
        sumSol = 'S = ensemble vide';
      } else {
        res.sols.forEach(function(s){ var sn = s.v.map(sysfSnap); if(sn.some(function(q){ return !q.exact; })) allExact = false; solTex.push(sysfTuple(sn.map(function(q){ return q.tex.split(BS + 'approx ').join(''); }))); solPlain.push('(' + sn.map(function(q){ return q.plain; }).join(' ; ') + ')'); });
        var t = R.line('', 'S = ' + BS + '{' + solTex.join(' ; ') + BS + '}');
        t += R.line('Nombre de solutions :', String(res.sols.length));
        if(!allExact) t += '<div class="study-work">Certaines valeurs sont approchées (≈) : leur forme exacte n’a pas été reconnue.</div>';
        t += '<div class="study-work">Vérification : chaque ' + (n === 2 ? 'couple' : 'triplet') + ' remplacé dans (E₁)' + (n === 3 ? ', (E₂) et (E₃)' : ' et (E₂)') + ' donne bien des égalités vraies (contrôle numérique).</div>';
        body += R.sec('Solutions', t);
        sumSol = 'S = {' + solPlain.join(' ; ') + '}';
      }
      R.render('Système d’équations', body);

      // graph (2 unknowns): the two curves + the solution points
      clearSysPlot();
      if(n === 2 && ggb){
        eqs.forEach(function(e, i){
          var nm = 'sysC' + (i + 1), lt = sysfPrint(e.L), rt = sysfPrint(e.R);
          try { ggb.evalCommand(nm + ': ' + lt + ' = ' + rt); if(ggb.exists(nm)){ sysObjs.push(nm); colour(nm, i ? 255 : 94, i ? 140 : 23, i ? 0 : 235); try { ggb.setLineThickness(nm, 6); } catch(e2){} } } catch(e1){}
        });
        var xs = [], ys = [];
        if(!res.infinite) res.sols.forEach(function(s, k){ var nm = 'SysS' + (k + 1); try { var gx = function(v){ return (Math.abs(v) < 1e-9 ? 0 : v).toFixed(10); }; ggb.evalCommand(nm + ' = (' + gx(s.v[0]) + ', ' + gx(s.v[1]) + ')'); sysObjs.push(nm); colour(nm, 220, 38, 38); xs.push(s.v[0]); ys.push(s.v[1]); } catch(e3){} });
        if(xs.length){
          var x0 = Math.min.apply(null, xs), x1 = Math.max.apply(null, xs), y0 = Math.min.apply(null, ys), y1 = Math.max.apply(null, ys);
          var m = Math.max(2, (x1 - x0) * 0.35, (y1 - y0) * 0.35);
          try { ggb.setCoordSystem(x0 - m, x1 + m, y0 - m, y1 + m); } catch(e4){}
        }
      }

      var summary = (conds.length ? 'conditions: ' + conds.map(function(c){ return c.plain; }).join(', ') + ' ; ' : '') + sumSol;
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';
      try {
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ function: eqs.map(function(e){ return e.plain; }).join(' ; ').slice(0, 200), operation: 'system_free', method: methodId, casResult: summary.slice(0, 495) }) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); } else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){ stateEl.textContent = 'Connexion impossible — réessayez.'; }
      finally { setSysOpsEnabled(true); }
    }

    async function runSystem(){
      if(sysKind === 'free') return runSysFree();
      if(!ggb){ return; }
      var rd = sysRead();
      if(rd.err){ stateEl.textContent = rd.err; return; }
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Résolution…';
      setSysOpsEnabled(false);
      var computed = false;
      try {
        var M = rd.M, V = SYS_VARS[sysN], n = sysN, R = e1Report(), body = '', sm = [], solution = null, status = '';
        var labels = M.map(function(_, i){ return '(E_{' + (i + 1) + '})'; });
        body += R.sec('Système', R.line('', sysTex(M, V, labels)));

        var G = sysGauss(M, V);
        if(n === 2){
          var a1 = M[0][0], b1 = M[0][1], c1 = M[0][2], a2 = M[1][0], b2 = M[1][1], c2 = M[1][2];
          var det = fSub(fMul(a1, b2), fMul(a2, b1));
          if(!fZero(det)){
            var x = fDiv(fSub(fMul(c1, b2), fMul(c2, b1)), det), y = fDiv(fSub(fMul(a1, c2), fMul(a2, c1)), det);
            solution = [x, y]; status = 'unique';
            // Méthode 1 — substitution: pick a coefficient ±1 if possible
            var pick = null;
            [[0, 1], [0, 0], [1, 1], [1, 0]].forEach(function(ij){ if(!pick && Math.abs(M[ij[0]][ij[1]].n) === 1 && M[ij[0]][ij[1]].d === 1) pick = ij; });
            if(!pick){ pick = !fZero(a1) ? [0, 0] : [0, 1]; }
            var i0 = pick[0], j0 = pick[1], o0 = 1 - j0, k0 = 1 - i0, Ei = M[i0], Ek = M[k0];
            var p = fDiv(Ei[2], Ei[j0]), q = fDiv(fNeg(Ei[o0]), Ei[j0]); // v_j = p + q·v_o
            var exprT = pTex([p, q], V[o0]);
            var t1 = R.line('De (E' + (i0 + 1) + ') :', V[j0] + ' = ' + exprT);
            // left side of (Ek) with the substituted unknown replaced by (expr), in x-then-y order
            var subst = '', firstT = true;
            [0, 1].forEach(function(j){
              var c = Ek[j]; if(fZero(c)) return;
              var neg = c.n < 0, ab = fr(Math.abs(c.n), c.d), ct = (ab.n === 1 && ab.d === 1) ? '' : fTex(ab);
              var content = (j === j0) ? BS + 'left(' + exprT + BS + 'right)' : V[j];
              subst += firstT ? ((neg ? '-' : '') + ct + content) : ((neg ? ' - ' : ' + ') + ct + content); firstT = false;
            });
            var cy = fAdd(fMul(Ek[j0], q), Ek[o0]), ry = fSub(Ek[2], fMul(Ek[j0], p)), vo = fDiv(ry, cy);
            t1 += R.line('On remplace dans (E' + (k0 + 1) + ') :', (subst || '0') + ' = ' + fTex(Ek[2]) + BS + ';' + BS + 'iff' + BS + '; ' + sysK(cy) + V[o0] + ' = ' + fTex(ry) + BS + ';' + BS + 'iff' + BS + '; ' + V[o0] + ' = ' + fTex(vo));
            var qT = fZero(q) ? '' : (q.n === q.d ? fPar(vo) : q.n === -q.d ? '-' + fPar(vo) : fTex(q) + ' ' + BS + 'times ' + fPar(vo));
            var pT = fZero(p) ? '' : (p.n < 0 ? ' - ' + fTex(fNeg(p)) : (qT ? ' + ' : '') + fTex(p));
            t1 += R.line('Puis :', V[j0] + ' = ' + ((qT + pT) || '0') + ' = ' + fTex(fAdd(p, fMul(q, vo))));
            // Méthode 2 — combinaison: eliminate y, then x
            function comb(ci){ // eliminate variable ci (0 or 1) → solve for the other
              var A = M[0][ci], B = M[1][ci], m1, m2;
              if(isInt(A) && isInt(B)){ var g = igcd(A.n, B.n) || 1; m1 = fr(B.n / g); m2 = fr(A.n / g); } else { m1 = B; m2 = A; }
              if(m1.n < 0){ m1 = fNeg(m1); m2 = fNeg(m2); }
              var other = 1 - ci, co = fSub(fMul(m1, M[0][other]), fMul(m2, M[1][other])), rh = fSub(fMul(m1, M[0][2]), fMul(m2, M[1][2]));
              var opT = sysK(m1) + '(E_1)' + (m2.n < 0 ? ' + ' + sysK(fNeg(m2)) : ' - ' + sysK(m2)) + '(E_2)';
              return R.line('On élimine ' + V[ci] + ' : ' , opT + BS + ';' + BS + 'Rightarrow' + BS + '; ' + sysK(co) + V[other] + ' = ' + fTex(rh) + BS + ';' + BS + 'Rightarrow' + BS + '; ' + V[other] + ' = ' + fTex(fDiv(rh, co)));
            }
            var t2 = comb(1) + comb(0);
            // Méthode 3 — déterminants
            var vm = function(a, b, c, d){ return BS + 'begin{vmatrix} ' + fTex(a) + ' & ' + fTex(b) + ' ' + BS + BS + ' ' + fTex(c) + ' & ' + fTex(d) + ' ' + BS + 'end{vmatrix}'; };
            var Dx = fSub(fMul(c1, b2), fMul(c2, b1)), Dy = fSub(fMul(a1, c2), fMul(a2, c1));
            var t3 = R.line('', BS + 'det = ' + vm(a1, b1, a2, b2) + ' = ' + fPar(a1) + BS + 'times ' + fPar(b2) + ' - ' + fPar(a2) + BS + 'times ' + fPar(b1) + ' = ' + fTex(det) + ' ' + BS + 'neq 0');
            t3 += R.line('', 'x = ' + BS + 'dfrac{' + vm(c1, b1, c2, b2) + '}{' + BS + 'det} = ' + BS + 'dfrac{' + fTex(Dx) + '}{' + fTex(det) + '} = ' + fTex(x) + BS + 'qquad y = ' + BS + 'dfrac{' + vm(a1, c1, a2, c2) + '}{' + BS + 'det} = ' + BS + 'dfrac{' + fTex(Dy) + '}{' + fTex(det) + '} = ' + fTex(y));
            body += R.sec('Résolution — trois méthodes',
              '<div class="sys-meth"><div class="sys-meth__t">Méthode 1 — Substitution</div>' + t1 + '</div>' +
              '<div class="sys-meth"><div class="sys-meth__t">Méthode 2 — Combinaison linéaire</div>' + t2 + '</div>' +
              '<div class="sys-meth"><div class="sys-meth__t">Méthode 3 — Déterminants (Cramer)</div>' + t3 + '</div>');
            sm.push('det=' + fPlain(det) + ' ; substitution depuis E' + (i0 + 1) + ': ' + V[j0] + '=' + pPlain([p, q], V[o0]));
          } else {
            var t0 = R.line('Déterminant :', BS + 'det = ' + fPar(a1) + BS + 'times ' + fPar(b2) + ' - ' + fPar(a2) + BS + 'times ' + fPar(b1) + ' = 0');
            t0 += '<div class="study-work">Le déterminant est nul : les deux droites sont parallèles (ou confondues). On combine les équations pour conclure.</div>';
            G.stages.forEach(function(st){ t0 += R.line('', st.ops.join(BS + ';,' + BS + '; ') + BS + ';' + BS + 'Rightarrow' + BS + '; ' + sysTex(st.M, V)); });
            body += R.sec('Résolution', t0);
            sm.push('det=0');
          }
        }

        if(n > 2 || (n === 2 && !solution)){
          if(n > 2){
            var tg = '<div class="study-work">Méthode du pivot de Gauss : on élimine une inconnue après l’autre par combinaisons de lignes, pour obtenir un système triangulaire.</div>';
            G.stages.forEach(function(st, k){
              var onlySwap = st.ops.every(function(o){ return o.indexOf('leftrightarrow') >= 0; });
              var what = onlySwap ? 'on échange deux lignes (pivot non nul pour ' + V[st.col] + ')' : 'on élimine ' + V[st.col];
              tg += '<div class="sys-stage">' + R.line('Étape ' + (k + 1) + ' — ' + what + ' :', st.ops.join(BS + ';,' + BS + '; ')) + R.line('', sysTex(st.M, V)) + '</div>';
            });
            if(!G.stages.length) tg += '<div class="study-work">Le système est déjà triangulaire.</div>';
            body += R.sec('Pivot de Gauss', tg);
            sm.push('pivot de Gauss: ' + G.stages.map(function(st){ return st.ops.join(', '); }).join(' ; ').split(BS + 'leftarrow').join('<-').split(BS + 'leftrightarrow').join('<->').split(BS).join('').slice(0, 220));
          }
          if(G.contra){ status = 'none'; }
          else if(G.rank === n){
            status = 'unique';
            var bk = sysBack(G, V, R);
            solution = bk.sol;
            body += R.sec('Remontée (substitution)', bk.html);
          } else status = 'infinite';
        }

        var concl = '';
        if(status === 'unique'){
          concl += R.line('Solution :', 'S = ' + BS + 'left' + BS + '{' + BS + 'left(' + solution.map(fTex).join(' ; ') + BS + 'right)' + BS + 'right' + BS + '}');
          var chk = M.map(function(row, i){ var s = fr(0); for(var j = 0; j < n; j++) s = fAdd(s, fMul(row[j], solution[j])); return fZero(fSub(s, row[n])); });
          concl += '<div class="study-line ' + (chk.every(Boolean) ? 'study-ok">✓ Vérification : la solution satisfait les ' + n + ' équations de départ.' : 'study-ko">Vérification en échec.') + '</div>';
          sm.push('solution unique (' + V.join(';') + ')=(' + solution.map(fPlain).join(' ; ') + ')');
        } else if(status === 'none'){
          concl += '<div class="study-line study-ko">✗ Une ligne devient « 0 = nombre non nul » : le système est incompatible.</div>';
          concl += R.line('Solution :', 'S = ' + BS + 'varnothing');
          sm.push('aucune solution (incompatible)');
        } else {
          var pm = sysParam(G, V);
          concl += '<div class="study-work">Une équation est redondante (« 0 = 0 ») : il y a moins d’équations indépendantes que d’inconnues.</div>';
          concl += R.line('Infinité de solutions :', 'S = ' + BS + 'left' + BS + '{' + BS + 'left(' + pm.expr.join(' ; ') + BS + 'right) ' + BS + ';' + BS + 'big|' + BS + '; ' + pm.free.map(function(j){ return V[j]; }).join(', ') + ' ' + BS + 'in ' + BS + 'mathbb{R}' + BS + 'right' + BS + '}');
          sm.push('infinite de solutions: (' + pm.expr.join(' ; ').split(BS + 'frac{').join('(').split('}{').join('/').split('}').join(')') + '), ' + pm.free.map(function(j){ return V[j]; }).join(',') + ' reels');
        }
        body += R.sec('Conclusion', concl);
        R.render('Système de ' + n + ' équations à ' + n + ' inconnues', body);

        computed = true;
        if(n === 2) sysPlot(M, solution);
        stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';
        var defStr = M.map(function(r){ return sysPlain(r, V); }).join(' ; ');
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ function: ('[' + n + ' inconnues] ' + defStr).slice(0, 200), operation: 'system', casResult: sm.join(' | ').slice(0, 495) }) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); } else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){ stateEl.textContent = computed ? 'Connexion impossible — réessayez.' : 'Résolution impossible — vérifiez les coefficients.'; }
      finally { setSysOpsEnabled(true); }
    }
    sysOpsEl.addEventListener('click', function(ev){ var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return; runSystem(); });

    function sysPlot(M, solution){
      clearSysPlot(); try { ggb.deleteObject('f'); } catch(e){}
      var cols = [[94, 23, 235], [50, 44, 77]];
      M.forEach(function(r, i){
        var nm = 'sysD' + (i + 1), eq = '(' + r[0].n + '/' + r[0].d + ')*x+(' + r[1].n + '/' + r[1].d + ')*y=(' + r[2].n + '/' + r[2].d + ')';
        try { ggb.evalCommand(nm + ':' + eq); ggb.setColor(nm, cols[i][0], cols[i][1], cols[i][2]); ggb.setLineThickness(nm, 5); ggb.setLabelVisible(nm, false); sysObjs.push(nm); } catch(e){}
      });
      var cx = 0, cy = 0;
      if(solution){
        cx = fVal(solution[0]); cy = fVal(solution[1]);
        try { ggb.evalCommand('SysI=(' + cx + ',' + cy + ')'); ggb.setColor('SysI', 255, 194, 58); ggb.setPointSize('SysI', 7); ggb.setLabelVisible('SysI', false); sysObjs.push('SysI'); } catch(e){}
      }
      try { ggb.setCoordSystem(cx - 6, cx + 6, cy - 5, cy + 5); } catch(e){}
    }

    sysRenderExamples();
    sysBuildGrid(SYS_EX[2][0][1]);
    setSysOpsEnabled(false); // enabled once GeoGebra is ready (appletOnLoad)

    /* ============ BARYCENTRE (2, 3 ou 4 points pondérés) ============ */
    // Exact fractions (fr/fAdd/… from the Équation mode). G = bar{(Aᵢ, aᵢ)} exists iff Σaᵢ ≠ 0;
    // construction by associativity through partial barycentres; locus ‖Σ aᵢ·MAᵢ‖ = k.
    var modeBary    = document.getElementById('mode-bary');
    var baryCountEl = document.getElementById('bary-count');
    var baryGridEl  = document.getElementById('bary-grid');
    var baryExEl    = document.getElementById('bary-ex');
    var baryPrevEl  = document.getElementById('bary-preview');
    var baryOpsEl   = document.getElementById('bary-ops');
    var baryKEl     = document.getElementById('bary-k');
    var baryN = 2, baryObjs = [];
    var BARY_NAMES = ['A', 'B', 'C', 'D'];
    var BARY_EX = {
      2: [ ['Poids 1 et 2', [[1, 2, 1], [4, 5, 2]]], ['Poids opposés (somme 0)', [[0, 0, 1], [2, 0, -1]]], ['Poids 3 et −1', [[1, 1, 3], [3, 2, -1]]] ],
      3: [ ['Isobarycentre (centre de gravité)', [[0, 0, 1], [6, 0, 1], [0, 6, 1]]], ['Poids 2, −1, 1', [[1, 1, 2], [5, 3, -1], [2, 6, 1]]], ['Somme des poids nulle', [[0, 0, 1], [4, 0, 1], [2, 3, -2]]] ],
      4: [ ['Centre d’un carré', [[0, 0, 1], [4, 0, 1], [4, 4, 1], [0, 4, 1]]], ['Poids 1, 2, 3, 4', [[0, 0, 1], [5, 0, 2], [5, 5, 3], [0, 5, 4]]] ]
    };

    function setBaryOpsEnabled(on){ baryOpsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }
    function clearBaryPlot(){ baryObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} }); baryObjs = []; }

    function baryBuildGrid(values){
      var html = '';
      for(var i = 0; i < baryN; i++){
        var v = (values && values[i]) || [0, 0, 1];
        html += '<div class="sys-row"><span class="sys-lbl">' + BARY_NAMES[i] + '</span>'
          + '<span class="sys-op">x =</span><input type="text" data-r="' + i + '" data-c="0" value="' + v[0] + '" autocomplete="off" aria-label="abscisse de ' + BARY_NAMES[i] + '" />'
          + '<span class="sys-op">y =</span><input type="text" data-r="' + i + '" data-c="1" value="' + v[1] + '" autocomplete="off" aria-label="ordonnée de ' + BARY_NAMES[i] + '" />'
          + '<span class="sys-op">poids</span><input type="text" data-r="' + i + '" data-c="2" value="' + v[2] + '" autocomplete="off" aria-label="poids de ' + BARY_NAMES[i] + '" /></div>';
      }
      baryGridEl.innerHTML = html;
      updateBaryPreview();
    }
    baryGridEl.addEventListener('input', updateBaryPreview);
    function baryRenderExamples(){
      var html = '<span class="pw-ex__lbl"><i class="bi bi-lightbulb"></i> Exemples :</span>';
      BARY_EX[baryN].forEach(function(ex, i){ html += '<button type="button" class="ml-key is-util" data-baryex="' + i + '">' + escapeHtml(ex[0]) + '</button>'; });
      baryExEl.innerHTML = html;
    }
    baryExEl.addEventListener('click', function(ev){
      var b = ev.target.closest('[data-baryex]'); if(!b) return;
      var ex = BARY_EX[baryN][Number(b.getAttribute('data-baryex'))]; if(!ex) return;
      answerEl.innerHTML = ''; stepsEl.innerHTML = ''; stateEl.textContent = '';
      baryBuildGrid(ex[1]);
    });
    function setBaryN(n){
      baryN = n;
      baryCountEl.querySelectorAll('.ml-sidebtn').forEach(function(b){ b.classList.toggle('is-active', Number(b.getAttribute('data-baryn')) === n); });
      baryRenderExamples(); baryBuildGrid(BARY_EX[n][0][1]);
      answerEl.innerHTML = ''; stepsEl.innerHTML = ''; stateEl.textContent = '';
    }
    baryCountEl.addEventListener('click', function(ev){ var b = ev.target.closest('.ml-sidebtn'); if(b) setBaryN(Number(b.getAttribute('data-baryn'))); });

    function baryRead(){
      var P = [];
      for(var i = 0; i < baryN; i++){
        var row = [];
        for(var j = 0; j < 3; j++){
          var inp = baryGridEl.querySelector('input[data-r="' + i + '"][data-c="' + j + '"]');
          var p = e1Parse(inp ? inp.value : '0');
          if(!p || !pConst(p)) return { err: 'Valeur invalide pour le point ' + BARY_NAMES[i] + ' : entier ou fraction attendu.' };
          row.push(p[0]);
        }
        P.push({ name: BARY_NAMES[i], x: row[0], y: row[1], w: row[2] });
      }
      return { P: P };
    }
    function baryBarTex(P){ return BS + 'mathrm{bar}' + BS + 'left' + BS + '{' + P.map(function(p){ return '(' + p.name + ' ; ' + fTex(p.w) + ')'; }).join(',' + BS + ' ') + BS + 'right' + BS + '}'; }
    function baryPt(p){ return p.name + BS + 'left(' + fTex(p.x) + ' ; ' + fTex(p.y) + BS + 'right)'; }
    function updateBaryPreview(){
      var r = baryRead();
      if(r.err){ baryPrevEl.className = 'ml-preview is-empty'; baryPrevEl.textContent = r.err; return; }
      try { renderKatex(baryPrevEl, r.P.map(baryPt).join(',' + BS + 'quad ') + BS + 'qquad G = ' + baryBarTex(r.P)); baryPrevEl.className = 'ml-preview'; }
      catch(e){ baryPrevEl.className = 'ml-preview is-empty'; baryPrevEl.textContent = 'Aperçu indisponible.'; }
    }
    function vec(a, b){ return BS + 'overrightarrow{' + a + b + '}'; }
    // Σ aᵢ·(vector from X to Aᵢ) written with a leading-sign style: 2GA - GB + 3GC
    function barySumTex(P, from){
      var out = '', first = true;
      P.forEach(function(p){
        var w = p.w; if(fZero(w)) return;
        var neg = w.n < 0, ab = fr(Math.abs(w.n), w.d), ct = (ab.n === 1 && ab.d === 1) ? '' : fTex(ab);
        out += first ? ((neg ? '-' : '') + ct + vec(from, p.name)) : ((neg ? ' - ' : ' + ') + ct + vec(from, p.name)); first = false;
      });
      return out || BS + 'vec{0}';
    }
    // weighted mean of a coordinate with the substitution shown
    function baryCoordTex(P, key, S, label){
      var parts = P.map(function(p){ return fPar(p.w) + ' ' + BS + 'times ' + fPar(p[key]); }).join(' + ');
      var num = P.reduce(function(acc, p){ return fAdd(acc, fMul(p.w, p[key])); }, fr(0));
      return label + ' = ' + BS + 'dfrac{' + parts + '}{' + fTex(S) + '} = ' + BS + 'dfrac{' + fTex(num) + '}{' + fTex(S) + '} = ' + fTex(fDiv(num, S));
    }
    // An order of the points whose partial sums of weights (from 2 points on) are all ≠ 0.
    function baryOrder(P){
      var idx = P.map(function(_, i){ return i; }), best = null;
      function perm(a, k){
        if(best) return;
        if(k === a.length){
          var s = fr(0), ok = true;
          for(var i = 0; i < a.length; i++){ s = fAdd(s, P[a[i]].w); if(i >= 1 && fZero(s)) ok = false; if(i === 0 && fZero(P[a[0]].w)) ok = false; }
          if(ok) best = a.slice(); return;
        }
        for(var j = k; j < a.length; j++){ var t = a[k]; a[k] = a[j]; a[j] = t; perm(a, k + 1); t = a[k]; a[k] = a[j]; a[j] = t; }
      }
      perm(idx, 0);
      return best;
    }

    async function runBary(op){
      if(!ggb){ return; }
      var rd = baryRead();
      if(rd.err){ stateEl.textContent = rd.err; return; }
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul…';
      setBaryOpsEnabled(false);
      var computed = false;
      try {
        var P = rd.P, R = e1Report(), body = '', sm = [];
        var S = P.reduce(function(acc, p){ return fAdd(acc, p.w); }, fr(0));
        var Gx = null, Gy = null, partials = [], locus = null;
        body += R.sec('Données', R.line('', P.map(baryPt).join(',' + BS + 'quad ')) + R.line('Poids :', P.map(function(p){ return p.name + ' : ' + fTex(p.w); }).join(',' + BS + 'quad ')));
        var sumTex = P.map(function(p){ return fPar(p.w); }).join(' + ') + ' = ' + fTex(S);

        if(!fZero(S)){
          Gx = fDiv(P.reduce(function(a, p){ return fAdd(a, fMul(p.w, p.x)); }, fr(0)), S);
          Gy = fDiv(P.reduce(function(a, p){ return fAdd(a, fMul(p.w, p.y)); }, fr(0)), S);
          var t = R.line('Existence :', BS + 'textstyle' + BS + 'sum a_i = ' + sumTex + ' ' + BS + 'neq 0' + BS + ';' + BS + 'Rightarrow' + BS + '; G = ' + baryBarTex(P) + BS + 'text{ existe}');
          t += R.line('Définition :', barySumTex(P, 'G') + ' = ' + BS + 'vec{0}');
          t += R.line('Relation fondamentale :', BS + 'text{pour tout point } M,' + BS + '; ' + barySumTex(P, 'M') + ' = ' + (S.n === S.d ? '' : fPar(S)) + vec('M', 'G'));
          body += R.sec('Le barycentre G', t);
          var tc = R.line('', baryCoordTex(P, 'x', S, 'x_G')) + R.line('', baryCoordTex(P, 'y', S, 'y_G'));
          tc += R.line('Résultat :', 'G' + BS + 'left(' + fTex(Gx) + ' ; ' + fTex(Gy) + BS + 'right)');
          body += R.sec('Coordonnées de G', tc);
          sm.push('somme des poids=' + fPlain(S) + ' ; G(' + fPlain(Gx) + ' ; ' + fPlain(Gy) + ')');

          // construction
          var tcons = '';
          if(P.length === 2){
            var A = P[0], B = P[1], k = fDiv(B.w, S);
            var ABx = fSub(B.x, A.x), ABy = fSub(B.y, A.y);
            var irreducible = isInt(B.w) && isInt(S) && S.n > 0 && igcd(B.w.n, S.n) === 1;
            tcons += R.line('', vec('A', 'G') + ' = ' + BS + 'dfrac{b}{a + b}' + vec('A', 'B') + ' = ' + BS + 'dfrac{' + fTex(B.w) + '}{' + fTex(S) + '}' + vec('A', 'B') + (irreducible ? '' : ' = ' + fTex(k) + BS + ',' + vec('A', 'B')) + BS + 'quad ' + BS + 'text{avec } ' + vec('A', 'B') + BS + 'begin{pmatrix} ' + fTex(ABx) + ' ' + BS + BS + ' ' + fTex(ABy) + ' ' + BS + 'end{pmatrix}');
            var kv = fVal(k);
            tcons += '<div class="study-work">' + (kv > 0 && kv < 1 ? 'G est sur le segment [AB]' : 'G est sur la droite (AB), en dehors du segment [AB]') + (Math.abs(kv - 0.5) < 1e-12 ? ' : c’est le milieu de [AB] (poids égaux).' : '.') + '</div>';
            sm.push('AG=' + fPlain(k) + ' AB');
          } else {
            var ord = baryOrder(P);
            if(ord){
              var cur = { name: P[ord[0]].name, x: P[ord[0]].x, y: P[ord[0]].y, w: P[ord[0]].w };
              tcons += '<div class="study-work">Associativité : on remplace des points par leur barycentre partiel, affecté de la somme de leurs poids.</div>';
              for(var s2 = 1; s2 < ord.length; s2++){
                var nx = P[ord[s2]], ws = fAdd(cur.w, nx.w);
                var hx = fDiv(fAdd(fMul(cur.w, cur.x), fMul(nx.w, nx.x)), ws), hy = fDiv(fAdd(fMul(cur.w, cur.y), fMul(nx.w, nx.y)), ws);
                var last = (s2 === ord.length - 1), hname = last ? 'G' : 'H_' + s2, hplain = last ? 'G' : 'H' + s2;
                var kk = fDiv(nx.w, ws);
                tcons += R.line(last ? 'Enfin :' : 'Étape ' + s2 + ' :', hname + ' = ' + BS + 'mathrm{bar}' + BS + 'left' + BS + '{(' + cur.name + ' ; ' + fTex(cur.w) + '),' + BS + ' (' + nx.name + ' ; ' + fTex(nx.w) + ')' + BS + 'right' + BS + '}' + BS + ';' + BS + 'Rightarrow' + BS + '; ' + vec(cur.name, hname) + ' = ' + fTex(kk) + BS + ',' + vec(cur.name, nx.name) + ',' + BS + 'quad ' + hname + BS + 'left(' + fTex(hx) + ' ; ' + fTex(hy) + BS + 'right)');
                if(!last) partials.push({ name: 'H' + s2, x: hx, y: hy, from: cur, to: nx });
                else partials.push({ name: 'G', x: hx, y: hy, from: cur, to: nx, last: true });
                cur = { name: hname, x: hx, y: hy, w: ws, plain: hplain };
              }
              sm.push('construction par associativite: ' + ord.map(function(i){ return P[i].name; }).join(' puis '));
            } else tcons += '<div class="study-work">Aucun regroupement de points n’a une somme de poids non nulle : on utilise directement les coordonnées.</div>';
          }
          body += R.sec('Construction de G', tcons);
        } else {
          var ux = P.reduce(function(a, p){ return fAdd(a, fMul(p.w, p.x)); }, fr(0)), uy = P.reduce(function(a, p){ return fAdd(a, fMul(p.w, p.y)); }, fr(0));
          var tz = R.line('Existence :', BS + 'textstyle' + BS + 'sum a_i = ' + sumTex + BS + ';' + BS + 'Rightarrow' + BS + '; ' + BS + 'text{pas de barycentre}');
          tz += '<div class="study-work">Quand la somme des poids est nulle, le vecteur Σ aᵢ·MAᵢ ne dépend pas du point M : il est constant.</div>';
          tz += R.line('', BS + 'vec{u} = ' + barySumTex(P, 'M') + ' = ' + barySumTex(P, 'O') + ' = ' + BS + 'begin{pmatrix} ' + fTex(ux) + ' ' + BS + BS + ' ' + fTex(uy) + ' ' + BS + 'end{pmatrix}');
          body += R.sec('Somme des poids nulle', tz);
          sm.push('somme des poids nulle: pas de barycentre ; vecteur constant u(' + fPlain(ux) + ' ; ' + fPlain(uy) + ')');
          locus = { zero: true, ux: ux, uy: uy };
        }

        if(op === 'locus'){
          var kp = e1Parse(baryKEl.value);
          if(!kp || !pConst(kp)){ stateEl.textContent = 'Indiquez un nombre k.'; setBaryOpsEnabled(true); return; }
          var K = kp[0], tl = '';
          if(!fZero(S)){
            tl += R.line('', barySumTex(P, 'M') + ' = ' + (S.n === S.d ? '' : fPar(S)) + vec('M', 'G') + BS + ';' + BS + 'Rightarrow' + BS + '; ' + BS + 'left' + BS + '|' + barySumTex(P, 'M') + BS + 'right' + BS + '| = ' + fTex(fr(Math.abs(S.n), S.d)) + BS + ',MG');
            if(K.n < 0){ tl += R.line('', fTex(fr(Math.abs(S.n), S.d)) + BS + ',MG = ' + fTex(K) + ' < 0'); tl += '<div class="study-line study-ko">Une distance est positive : l’ensemble est vide.</div>'; sm.push('ligne de niveau k=' + fPlain(K) + ': ensemble vide'); }
            else if(fZero(K)){ tl += '<div class="study-line study-ok">MG = 0 : l’ensemble est réduit au point G.</div>'; sm.push('ligne de niveau k=0: le point G'); }
            else {
              var rad = fDiv(K, fr(Math.abs(S.n), S.d));
              tl += R.line('', fTex(fr(Math.abs(S.n), S.d)) + BS + ',MG = ' + fTex(K) + BS + ';' + BS + 'iff' + BS + '; MG = ' + fTex(rad));
              tl += '<div class="study-line study-ok">✓ L’ensemble des points M est le cercle de centre G et de rayon ' + escapeHtml(fPlain(rad)) + '.</div>';
              locus = { circle: true, r: rad };
              sm.push('ligne de niveau k=' + fPlain(K) + ': cercle de centre G et de rayon ' + fPlain(rad));
            }
          } else {
            var nu2 = fAdd(fMul(locus.ux, locus.ux), fMul(locus.uy, locus.uy));
            tl += R.line('', BS + 'left' + BS + '|' + BS + 'vec{u}' + BS + 'right' + BS + '|^{2} = ' + fTex(nu2) + BS + 'quad ' + BS + 'text{(constant)}');
            var same = (K.n >= 0) && fZero(fSub(fMul(K, K), nu2));
            tl += '<div class="study-line ' + (same ? 'study-ok">✓ ‖u‖ = k : tout point M du plan convient.' : 'study-ko">‖u‖ ≠ k : aucun point M ne convient (ensemble vide).') + '</div>';
            sm.push('ligne de niveau: ' + (same ? 'tout le plan' : 'ensemble vide'));
          }
          body += R.sec('Ensemble des points M tels que ‖Σ aᵢ·MAᵢ‖ = ' + escapeHtml(fPlain(K)), tl);
        }

        R.render(op === 'locus' ? 'Barycentre — ligne de niveau' : 'Barycentre de points pondérés', body);
        computed = true;
        baryPlot(P, Gx, Gy, partials, locus);
        stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';
        var defStr = P.map(function(p){ return p.name + '(' + fPlain(p.x) + ';' + fPlain(p.y) + ') poids ' + fPlain(p.w); }).join(', ') + (op === 'locus' ? ' ; k=' + baryKEl.value.trim() : '');
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ function: defStr.slice(0, 200), operation: op === 'locus' ? 'bary_locus' : 'barycentre', casResult: sm.join(' | ').slice(0, 495) }) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); } else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){ stateEl.textContent = computed ? 'Connexion impossible — réessayez.' : 'Calcul impossible — vérifiez les valeurs.'; }
      finally { setBaryOpsEnabled(true); }
    }
    baryOpsEl.addEventListener('click', function(ev){ var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return; runBary(btn.getAttribute('data-baryop')); });

    function baryPlot(P, Gx, Gy, partials, locus){
      clearBaryPlot(); try { ggb.deleteObject('f'); } catch(e){}
      function add(nm, cmd){ try { ggb.evalCommand(nm + '=' + cmd); baryObjs.push(nm); return true; } catch(e){ return false; } }
      var xs = [], ys = [];
      P.forEach(function(p){
        var nm = 'Bry' + p.name;
        if(add(nm, '(' + fVal(p.x) + ',' + fVal(p.y) + ')')){
          try { ggb.setColor(nm, 94, 23, 235); ggb.setPointSize(nm, 6); ggb.setCaption(nm, p.name + ' (' + fPlain(p.w) + ')'); ggb.setLabelStyle(nm, 3); ggb.setLabelVisible(nm, true); } catch(e){}
        }
        xs.push(fVal(p.x)); ys.push(fVal(p.y));
      });
      // polygon outline for 3–4 points
      if(P.length >= 3){
        if(add('bryPoly', 'Polygon(' + P.map(function(p){ return 'Bry' + p.name; }).join(',') + ')')){ try { ggb.setColor('bryPoly', 94, 23, 235); ggb.setFilling('bryPoly', 0.05); ggb.setLabelVisible('bryPoly', false); } catch(e){} }
      } else if(add('bryAB', 'Line(BryA,BryB)')){ try { ggb.setColor('bryAB', 180, 170, 210); ggb.setLabelVisible('bryAB', false); } catch(e){} }
      (partials || []).forEach(function(h, i){
        var nm = h.last ? 'BryG' : 'BryH' + (i + 1);
        if(!h.last && add(nm, '(' + fVal(h.x) + ',' + fVal(h.y) + ')')){
          try { ggb.setColor(nm, 50, 44, 77); ggb.setPointSize(nm, 4); ggb.setCaption(nm, 'H' + (i + 1)); ggb.setLabelStyle(nm, 3); ggb.setLabelVisible(nm, true); } catch(e){}
        }
        var sn = 'brySeg' + (i + 1), fx = fVal(h.from.x), fy = fVal(h.from.y), tx = fVal(h.to.x), ty = fVal(h.to.y);
        if(add(sn, 'Segment((' + fx + ',' + fy + '),(' + tx + ',' + ty + '))')){ try { ggb.setColor(sn, 50, 44, 77); ggb.setLineStyle(sn, 1); ggb.setLabelVisible(sn, false); } catch(e){} }
      });
      if(Gx !== null){
        if(add('BryG', '(' + fVal(Gx) + ',' + fVal(Gy) + ')')){
