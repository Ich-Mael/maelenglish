          graphHint.textContent = 'Les solutions de P(x) = 0 sont les abscisses des points d’intersection de la courbe avec l’axe des abscisses (en jaune).';
          try { ggb.deleteObject('f'); } catch(e){}
          updateE1Preview();
        } else if(m === 'piecewise'){
          graphTitle.textContent = 'Courbe par intervalles';
          graphHint.textContent = 'La fonction est tracée sur chaque intervalle ; point plein = valeur prise par f, point creux = valeur exclue. En jaune : tangente ou demi-tangentes au point de raccordement.';
          try { ggb.deleteObject('f'); } catch(e){}
          updatePwPreview();
        } else if(m === 'proba'){
          graphTitle.textContent = 'Distribution de probabilité';
          graphHint.textContent = 'Loi binomiale : le diagramme en bâtons de la distribution s’affiche (la barre du k demandé est en orange).';
          try { ggb.deleteObject('f'); } catch(e){}
          updateProbaPreview();
        } else if(m === 'stats'){
          graphTitle.textContent = 'Graphique statistique';
          graphHint.textContent = 'Série : la boîte à moustaches (Q₁, médiane, Q₃, min, max). Régression : le nuage de points et la droite d’ajustement.';
          try { ggb.deleteObject('f'); } catch(e){}
          updateStatsPreview();
        } else if(m === 'diffeq'){
          graphTitle.textContent = 'Courbe solution';
          graphHint.textContent = 'La courbe de la solution particulière (vérifiant la condition initiale) s’affiche après « Résoudre ».';
          try { ggb.deleteObject('f'); } catch(e){}
          updateDeqPreview();
        } else if(m === 'suite'){
          graphTitle.textContent = 'Termes & convergence';
          graphHint.textContent = 'Suite explicite : les termes (n, uₙ) sont tracés. Suite récurrente : l’escalier de convergence vers la limite.';
          try { ggb.deleteObject('f'); } catch(e){}
          updateSuitePreview();
        } else if(m === 'function'){
          graphTitle.textContent = 'Représentation graphique';
          graphHint.textContent = 'La courbe se met à jour quand vous tracez ou lancez un calcul. Utilisez « Tracer » après avoir modifié la fonction.';
          plot((fxInput.value || '').trim());
        } else if(m === 'complex'){
          graphTitle.textContent = 'Plan complexe (Argand)';
          graphHint.textContent = 'Le point z₁ et le vecteur depuis l’origine apparaissent quand vous lancez un calcul.';
          try { ggb.deleteObject('f'); } catch(e){}
          updateZPreview();
        } else if(m === 'geometry'){
          graphTitle.textContent = 'Plan complexe — figure';
          graphHint.textContent = 'Placez les affixes des points puis « Tracer la figure » ou déterminez la nature de la figure.';
          try { ggb.deleteObject('f'); } catch(e){}
          updateGeoPreview();
        } else {
          graphTitle.textContent = 'Aire & intégrale';
          graphHint.textContent = 'La courbe de f s’affiche ; pour une intégrale définie, l’aire entre a et b est colorée.';
          plot((ifxInput.value || '').trim());
          updateIntPreview();
        }
        setTimeout(fitGraph, 60);
      }
    }
    modesEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-mode'); if(!btn) return;
