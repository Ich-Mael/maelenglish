          eqs.forEach(function(e){
            var sides = e.split('='); if(sides.length !== 2) throw 'égalité';
            var L = vec(sides[0]), Rr = vec(sides[1]), cL = vcVecOf(F, L), cR = vcVecOf(F, Rr), ok = vcEq(cL, cR);
            all = all && ok;
            if(L.length === 1 && fVal(L[0].k) === 1){ var ch = vcChasles(F, L[0].X, L[0].Y); if(ch) txt += R.line('Chasles :', ch); }
            txt += R.line('', vcTermsTex(L) + ' = ' + vcBasisTex(F, cL));
