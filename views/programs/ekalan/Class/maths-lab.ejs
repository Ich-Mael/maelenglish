<% layout('layouts/main') %>
<% title = 'Kalan Maths Lab' %>

<% headContent = `
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    #main { margin-top: 0 !important; padding-top: 0 !important; }
    .ml-page { margin-top:72px; background:#f7f6fb; min-height:calc(100vh - 72px); padding-bottom:4rem;
      font-family: system-ui,-apple-system,'Segoe UI',Roboto,sans-serif; color:#1f2937; }
    /* Palette from the e-Kalan logo — Maths Lab is premium → navy hero + sun yellow (same as the Kalan Ba page) */
    .ml-hero { color:#fff; padding:1.75rem clamp(1rem,4vw,3rem) 3.6rem; position:relative; overflow:hidden; background:#322c4d; }
    .ml-hero::before { content:''; position:absolute; right:-150px; top:-190px; width:440px; height:440px; border-radius:50%;
      background:#ffc23a; opacity:.9; pointer-events:none; z-index:0; }
    .ml-hero::after { content:''; position:absolute; left:-90px; bottom:-150px; width:260px; height:260px; border-radius:50%;
      background:#5e17eb; opacity:.45; pointer-events:none; z-index:0; }
    .ml-hero__glyphs { position:absolute; inset:0; pointer-events:none; overflow:hidden; z-index:0; }
    .ml-hero__glyphs span { position:absolute; font-family:'Times New Roman','Cambria Math',serif; font-weight:700;
      color:rgba(255,255,255,.07); line-height:1; user-select:none; animation:mlfloat 9s ease-in-out infinite; }
    .ml-hero__glyphs span:nth-child(2){ animation-delay:-1.1s; }
    .ml-hero__glyphs span:nth-child(3){ animation-delay:-2.2s; }
    .ml-hero__glyphs span:nth-child(4){ animation-delay:-3.3s; }
    .ml-hero__glyphs span:nth-child(5){ animation-delay:-4.4s; }
    .ml-hero__glyphs span:nth-child(6){ animation-delay:-5.5s; }
    .ml-hero__glyphs span:nth-child(7){ animation-delay:-6.6s; }
    .ml-hero__glyphs span:nth-child(8){ animation-delay:-7.7s; }
    .ml-hero__glyphs span:nth-child(9){ animation-delay:-8.8s; }
    .ml-hero__glyphs span:nth-child(10){ animation-delay:-2.6s; }
    .ml-hero__glyphs span:nth-child(11){ animation-delay:-5.1s; }
    .ml-hero__glyphs span:nth-child(12){ animation-delay:-3.9s; }
    .ml-hero__glyphs span:nth-child(13){ animation-delay:-7.1s; }
    .ml-hero__glyphs span:nth-child(14){ animation-delay:-1.7s; }
    @keyframes mlfloat { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-16px)} }
    .ml-hero__inner { max-width:1180px; margin:0 auto; position:relative; z-index:1; }
    .ml-hero__top { display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
    .ml-crumb { display:inline-flex; align-items:center; gap:.45rem; color:#fff; text-decoration:none;
      font-size:.9rem; font-weight:600; padding:.5rem .95rem; border-radius:999px; background:rgba(255,255,255,.1);
      border:1px solid rgba(255,255,255,.22); transition:background .2s, transform .2s; }
    .ml-crumb:hover { background:rgba(255,255,255,.2); color:#fff; transform:translateX(-3px); }
    .ml-brand { display:inline-flex; align-items:center; background:#fff; border-radius:16px; padding:.45rem .95rem;
      box-shadow:0 12px 28px rgba(0,0,0,.25); transition:transform .2s; }
    .ml-brand:hover { transform:translateY(-2px); }
    .ml-brand img { display:block; height:42px; width:auto; }
    .ml-hero__head { display:flex; align-items:flex-end; justify-content:space-between; gap:1.6rem;
      flex-wrap:wrap; margin-top:1.8rem; }
    .ml-hero__text { max-width:660px; }
    .ml-badge { display:inline-flex; align-items:center; gap:.4rem; font-size:.76rem; font-weight:800; letter-spacing:.06em;
      text-transform:uppercase; padding:.35rem .85rem; border-radius:999px; background:#ffc23a; color:#322c4d; }
    .ml-badge i { color:#322c4d; }
    .ml-hero__title { margin:.8rem 0 .5rem; font-family:'Baloo 2',system-ui,sans-serif; font-size:clamp(2.1rem,5vw,3.3rem);
      font-weight:800; line-height:1.04; color:#fff; }
    .ml-hero__title .accent { color:#ffc23a; }
    .ml-hero__sub { margin:0; font-size:clamp(.95rem,1.5vw,1.06rem); line-height:1.6; color:rgba(255,255,255,.8); max-width:560px; }
    .ml-hero__ai { display:inline-flex; align-items:center; gap:.7rem; padding:.85rem 1.1rem; border-radius:16px;
      background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.18); font-size:.8rem; color:rgba(255,255,255,.82);
      line-height:1.25; }
    .ml-hero__ai i { font-size:1.55rem; color:#ffc23a; }
    .ml-hero__ai strong { display:block; color:#fff; font-weight:700; font-size:.95rem; }
    @media (max-width:560px){ .ml-hero__ai{ display:none; } }
    @media (max-width:768px){ .ml-hero::before { width:300px; height:300px; right:-140px; top:-150px; } .ml-brand img { height:32px; } }
    @media (prefers-reduced-motion:reduce){ .ml-hero__glyphs span{ animation:none; } }
    .ml-wrap { max-width:1180px; margin:0 auto; padding:0 clamp(1rem,4vw,3rem); }
    .ml-grid { display:flex; flex-direction:column; gap:1.5rem; margin-top:-1.5rem; position:relative; z-index:2; }
    .ml-card { background:#fff; border-radius:22px; border:1px solid #ece9f3; box-shadow:0 12px 34px rgba(50,44,77,.1); padding:1.35rem; }
    .ml-card h2 { font-family:'Baloo 2',system-ui,sans-serif; font-size:1.25rem; font-weight:700; color:#322c4d; margin:0 0 .9rem; display:flex; align-items:center; gap:.5rem; }
    /* ===== Main topics (domain tabs) — brand PURPLE ===== */
    .ml-modes { display:flex; flex-direction:column; gap:.55rem; margin-bottom:1.1rem; }
    .ml-modes__group { display:flex; flex-wrap:wrap; align-items:center; gap:.45rem; padding:.5rem .55rem;
      background:#f1ecfb; border:1px solid #e5dbf7; border-radius:18px; }
    .ml-modes__lbl { display:inline-flex; align-items:center; gap:.35rem; font-size:.72rem; font-weight:800; letter-spacing:.06em;
      text-transform:uppercase; color:#5e17eb; padding:0 .45rem 0 .3rem; white-space:nowrap; }
    /* Terminale-only topics: sun-tinted block + "Tle" badge on each tab */
    .ml-modes__group--tle { background:#fff8e6; border-color:#ffe3a3; }
    .ml-modes__group--tle .ml-modes__lbl { color:#322c4d; }
    .ml-modes__group--tle .ml-modes__lbl i { color:#d99a00; }
    .ml-tle { display:inline-flex; align-items:center; font-size:.62rem; font-weight:800; letter-spacing:.04em; line-height:1;
      padding:.2rem .4rem; border-radius:999px; background:#ffc23a; color:#322c4d; margin-left:.1rem; }
    .ml-modes__group--tle .ml-mode { border-color:#ffe3a3; }
    .ml-modes__group--tle .ml-mode:hover { border-color:#ffc23a; }
    .ml-mode { display:inline-flex; align-items:center; gap:.45rem; cursor:pointer;
      background:#fff; border:1px solid #d9caf6; color:#5e17eb; font-weight:700; font-size:.9rem;
      padding:.5rem .95rem; border-radius:999px; transition:all .18s; box-shadow:0 1px 2px rgba(50,44,77,.06); }
    .ml-mode:hover { background:#f6f1ff; border-color:#b99cf0; transform:translateY(-1px); box-shadow:0 4px 10px rgba(94,23,235,.16); }
    .ml-mode.is-active { background:#5e17eb; color:#fff; border-color:#5e17eb;
      box-shadow:0 5px 16px rgba(94,23,235,.38); transform:none; }
    .ml-mode.is-active:hover { transform:translateY(-1px); }
    .geo-row { display:flex; align-items:center; gap:.6rem; margin-bottom:.55rem; }
    .geo-row .geo-label { font-weight:700; color:#5e17eb; min-width:3.4rem; }
    .geo-row input { flex:1; min-width:140px; padding:.6rem .8rem; border:2px solid #e0e0e0; border-radius:10px;
      font-size:1rem; font-family:'Courier New',monospace; background:#fafafa; }
    .geo-row input:focus { outline:none; border-color:#5e17eb; background:#fff; }
    .geo-del { border:none; background:#f3effc; color:#9b87c4; width:2rem; height:2rem; border-radius:8px; cursor:pointer;
      font-size:1.1rem; line-height:1; flex:0 0 auto; transition:all .15s; }
    .geo-del:hover { background:#ffe0e0; color:#d33; }
    .geo-add { display:inline-flex; align-items:center; gap:.4rem; border:1px dashed #d9ccf5; background:#fbf9ff;
      color:#5e17eb; border-radius:10px; padding:.5rem .85rem; font-weight:600; font-size:.85rem; cursor:pointer; margin-bottom:1rem; }
    .geo-add:hover { background:#f1ecfb; }
    .geo-add:disabled { opacity:.45; cursor:not-allowed; }
    .ml-side { display:inline-flex; gap:.3rem; padding:.25rem; background:#f1ecfb; border:1px solid #e5dbf7;
      border-radius:10px; margin-bottom:1rem; flex-wrap:wrap; }
    .ml-sidebtn { border:none; background:transparent; color:#5e17eb; font-weight:600; font-size:.82rem;
      padding:.4rem .75rem; border-radius:7px; cursor:pointer; transition:all .15s; }
    .ml-sidebtn:hover { background:rgba(94,23,235,.08); }
    .ml-sidebtn.is-active { background:#5e17eb; color:#fff; }
    .ml-sidebtn:disabled { opacity:.4; cursor:not-allowed; }
    .ml-key[data-lpoint] { font-family:system-ui,sans-serif; font-size:.85rem; font-weight:700; }
    .ml-subsection { margin-top:1.4rem; padding-top:1.2rem; border-top:1px dashed #e0d7f4; }
    .ml-subtitle { font-size:.98rem; font-weight:700; color:#322c4d; margin:0 0 .2rem; display:flex; align-items:center; gap:.45rem; }
    .ml-block { background:#f7f4fe; border:1px solid #e9e0fb; border-radius:14px; padding:1.05rem 1.1rem .95rem; margin-bottom:1.1rem; }
    .ml-block--eq { background:#fff8ec; border-color:#f3e4c4; }
    .ml-block:last-child { margin-bottom:0; }
    .ml-block > h2:first-child, .ml-block > .ml-subtitle:first-child { margin-top:0; }
    /* Collapsible blocks (Opérations dans ℂ / Équation) */
    details.ml-block { padding:0; }
    details.ml-block > .ml-block-body { padding:0 1.1rem 1rem; }
    details.ml-block > summary { list-style:none; cursor:pointer; padding:.95rem 1.1rem; display:flex; align-items:center; gap:.5rem; font-weight:700; color:#322c4d; user-select:none; }
    details.ml-block > summary::-webkit-details-marker { display:none; }
    details.ml-block > summary h2, details.ml-block > summary .ml-subtitle { margin:0; flex:1; }
    details.ml-block > summary .ml-caret { margin-left:auto; transition:transform .2s; font-size:.9rem; color:#5e17eb; }
    details.ml-block[open] > summary .ml-caret { transform:rotate(180deg); }
    /* Tableau de variation */
    .vt-deriv { font-size:.92rem; color:#e9defb; margin:.1rem 0 .55rem; }
    .ml-vartable-wrap { overflow-x:auto; }
    .ml-vartable { border-collapse:collapse; font-size:.95rem; min-width:max-content; background:#fff; }
    .ml-vartable th { text-align:left; padding:.45rem .7rem; color:#322c4d; font-weight:700; border:1px solid #d9ccf2; background:#f7f4fe; white-space:nowrap; }
    .ml-vartable td { border:1px solid #d9ccf2; padding:.4rem .8rem; text-align:center; min-width:54px; }
    .vt-pt { font-weight:600; color:#1f2937; }
    .vt-sign { color:#5e17eb; font-weight:700; font-size:1.05rem; }
    /* f(x) row — taller so extrema/limits can sit high (max) or low (min) with long diagonal arrows */
    .ml-vartable td.vt-fpt, .ml-vartable tr:last-child td.vt-gap { height:104px; position:relative; padding:0 .8rem; }
    .ml-vartable tr:last-child td.vt-gap { min-width:64px; }
    .vt-fval { position:absolute; left:0; right:0; font-weight:600; color:#1f2937; }
    .vt-fval.vt-top { top:10px; }
    .vt-fval.vt-bottom { bottom:10px; }
    .vt-arr { display:block; width:54px; height:90px; margin:0 auto; }
    /* dotted vertical guide under each critical point (f'(x)=0 → f(x)) */
    .vt-crit { position:relative; }
    .vt-crit::after { content:''; position:absolute; top:0; bottom:0; left:50%; border-left:1px dotted #a98fe0; pointer-events:none; }
    /* vertical asymptote — red double bar + red x value */
    .vt-asym-x { color:#dc2626; font-weight:700; }
    .vt-asym-bar, .vt-asym-cell { position:relative; }
    .vt-asym-bar::after, .vt-asym-cell::after { content:''; position:absolute; top:0; bottom:0; left:50%; transform:translateX(-50%); width:5px; border-left:2px solid #dc2626; border-right:2px solid #dc2626; pointer-events:none; }
    .vt-asym-cell { min-width:136px; }
    /* limit values (vertical & horizontal asymptotes) shown in a red pill/circle */
    .vt-lim { display:inline-block; border:1.5px solid #dc2626; color:#dc2626; background:#fff5f5; border-radius:999px; padding:.03rem .45rem; font-size:.82rem; font-weight:700; line-height:1.4; }
    .vt-asym-cell .vt-lim { position:absolute; }
    .vt-lim-L { right:calc(50% + 8px); left:auto; }  /* left-hand limit ends just left of the bar */
    .vt-lim-R { left:calc(50% + 8px); right:auto; }  /* right-hand limit starts just right of the bar */
    .vt-asym-cell .vt-lim.vt-top { top:9px; }
    .vt-asym-cell .vt-lim.vt-bottom { bottom:9px; }
    /* Étude complète — flagship op button + report */
    .ml-op.ml-op--hero { background:#ffc23a; color:#322c4d; border-color:#ffc23a; font-weight:800;
      box-shadow:0 4px 12px rgba(255,194,58,.4); }
    .ml-op.ml-op--hero:hover:not(:disabled) { background:#ffc23a; color:#322c4d; border-color:#ffc23a;
      box-shadow:0 8px 20px rgba(255,194,58,.55); transform:translateY(-1px); }
    .ml-study { margin-top:1rem; background:#322c4d; color:#fff; border-radius:14px; padding:1rem 1.1rem 1.15rem;
                font-family:'Cambria','Times New Roman','Georgia',serif; }
    .study-head { color:#ffc23a; font-size:.98rem; font-weight:800; margin-bottom:.4rem; }
    .study-sec { padding:.7rem 0; border-top:1px solid rgba(255,255,255,.16); }
    .study-t { font-weight:700; color:#ffc23a; font-size:.78rem; text-transform:uppercase; letter-spacing:.04em; margin-bottom:.4rem; font-family:system-ui,sans-serif; }
    .study-body { color:#f1ebff; font-size:1rem; line-height:1.55; }
    .study-body strong { color:#fff; }
    .study-line { margin:.32rem 0; }
    .study-lbl { color:#efe7ff; }
    .study-math { color:#fff; }
    .study-line .katex, .study-math .katex, .study-work .katex { color:inherit; }
    .study-work { font-size:.9rem; color:#cdbff0; margin:.12rem 0 .25rem .3rem; }
    /* Mobile: long formulas scroll horizontally instead of clipping / overflowing the page. */
    .ml-step__latex, .ml-answer .val, .study-line, .study-math, .study-work {
      max-width:100%; overflow-x:auto; overflow-y:hidden; -webkit-overflow-scrolling:touch; }
    .katex-display { overflow-x:auto; overflow-y:hidden; margin:.3em 0; }
    .ml-step__exp { overflow-wrap:anywhere; }
    .study-hr { border:none; border-top:1px dashed rgba(255,255,255,.25); margin:.5rem 0; }
    .vt-domain { font-size:.92rem; color:#fff; font-weight:700; margin:.1rem 0 .5rem; }
    .vt-note { font-size:.82rem; color:#d9c9f5; margin-top:.5rem; }
    /* boundary limits, listed separately */
    .vt-lims { margin-top:.7rem; background:#f7f4fe; border:1px solid #e9e0fb; border-radius:10px; padding:.6rem .85rem; }
    .vt-lims-t { font-weight:700; color:#322c4d; font-size:.9rem; margin-bottom:.3rem; }
    .vt-lim-line { font-size:.9rem; color:#374151; padding:.1rem 0; }
    .ml-coefs { display:flex; flex-wrap:wrap; gap:.6rem; margin:.9rem 0; }
    .ml-coef { display:flex; align-items:center; gap:.4rem; flex:1 1 130px; }
    .ml-coef label { font-weight:800; color:#5e17eb; font-style:italic; min-width:1rem; }
    .ml-coef input { flex:1; min-width:0; padding:.6rem .7rem; border:2px solid #e0e0e0; border-radius:10px;
      font-size:1rem; font-family:'Courier New',monospace; background:#fafafa; }
    .ml-coef input:focus { outline:none; border-color:#5e17eb; background:#fff; }
    #ggb { width:100%; min-height:480px; border-radius:12px; overflow:hidden; }
    .ml-input-row { display:flex; gap:.6rem; align-items:center; margin-bottom:1rem; flex-wrap:wrap; }
    .ml-input-row label { font-weight:700; color:#5e17eb; }
    .ml-input-row input { flex:1; min-width:180px; padding:.7rem .9rem; border:2px solid #e0e0e0; border-radius:10px;
      font-size:1.05rem; font-family:'Courier New',monospace; background:#fafafa; }
    .ml-input-row input:focus { outline:none; border-color:#5e17eb; background:#fff; }
    .ml-plot { display:inline-flex; align-items:center; gap:.4rem; border:none; cursor:pointer;
      background:#5e17eb; color:#fff; font-weight:700; font-size:.92rem;
      padding:.7rem 1.2rem; border-radius:999px; transition:filter .2s; white-space:nowrap; }
    .ml-plot:hover { filter:brightness(1.12); }
    .ml-plot:disabled { opacity:.5; cursor:not-allowed; }
    .ml-preview { min-height:2.4rem; margin:-.2rem 0 1rem; padding:.55rem .9rem; background:#faf7ff;
      border:1px dashed #d9ccf5; border-radius:10px; color:#322c4d; font-size:1.2rem; overflow-x:auto; }
    .ml-preview.is-empty { color:#b9a9dd; font-style:italic; font-size:.85rem; }
    .ml-keys { display:flex; flex-wrap:wrap; gap:.35rem; margin:-.4rem 0 1rem; }
    .ml-key { border:1px solid #e0d7f4; background:#fbf9ff; color:#3d2a66; border-radius:8px;
      min-width:2.2rem; padding:.4rem .5rem; font-size:1rem; line-height:1; cursor:pointer; transition:all .15s;
      font-family:'Times New Roman',serif; }
    .ml-key:hover { background:#5e17eb; color:#fff; border-color:#5e17eb; }
    .ml-key.is-fn { font-family:system-ui,sans-serif; font-size:.82rem; font-style:italic; }
    .ml-key.is-util { font-family:system-ui,sans-serif; font-size:.78rem; color:#9b87c4; }
    /* ===== Features (operations) — brand GOLD/amber ===== */
    .ml-ops { display:flex; flex-wrap:wrap; gap:.5rem; }
    .ml-op { border:1px solid #ffe3a3; background:#fff3d6; color:#6b4a00; border-radius:999px; padding:.55rem .9rem;
      font-weight:600; font-size:.9rem; cursor:pointer; transition:all .2s; display:inline-flex; align-items:center; gap:.4rem; }
    .ml-op:hover:not(:disabled) { background:#ffc23a; color:#322c4d; border-color:#ffc23a;
      box-shadow:0 4px 14px rgba(255,194,58,.4); }
    .ml-op:disabled { opacity:.5; cursor:not-allowed; }
    .ml-op.is-open { box-shadow:inset 0 0 0 2px #ffc23a; background:#ffe9b3; }
    .ml-answer { margin-top:1rem; background:#322c4d; color:#fff; border-radius:16px;
      padding:1rem 1.2rem; border-left:4px solid #ffc23a; box-shadow:0 6px 22px rgba(50,44,77,.18); }
    .ml-answer .lbl { font-size:.75rem; text-transform:uppercase; letter-spacing:.05em; font-weight:700; color:#ffc23a;
      display:inline-flex; align-items:center; gap:.35rem; }
    .ml-answer .val { font-size:1.4rem; margin-top:.25rem; }
    .ml-steps { margin-top:1rem; }
    .ml-step { border:1px solid #eee; border-left:4px solid #5e17eb; border-radius:10px; padding:.9rem 1.1rem; margin-bottom:.8rem; background:#fff; }
    .ml-step__title { font-weight:700; color:#322c4d; font-size:.95rem; margin-bottom:.4rem; }
    .ml-step__latex { margin:.3rem 0; font-size:1.05rem; }
    .ml-step__exp { color:#4b5563; font-size:.92rem; line-height:1.5; }
    .ml-state { color:#6b7280; font-size:.92rem; padding:.6rem 0; }
    .ml-spinner { display:inline-block; width:16px; height:16px; border:2px solid #d9ccf5; border-top-color:#5e17eb; border-radius:50%; animation:mlspin .7s linear infinite; vertical-align:-3px; margin-right:.4rem; }
    @keyframes mlspin { to { transform:rotate(360deg); } }
    .ml-warn { margin-top:1rem; display:flex; gap:.6rem; align-items:flex-start; background:#fef2f2; border:1px solid #f4b4b4;
      border-left:4px solid #dc2626; border-radius:12px; padding:.7rem .9rem; color:#7f1d1d; font-size:.82rem; line-height:1.45; }
    .ml-warn i { color:#dc2626; font-size:1.05rem; flex-shrink:0; margin-top:.05rem; }
    .ml-warn strong { color:#991b1b; }
    .ml-hint { font-size:.82rem; color:#6b7280; margin-top:.4rem; }
    /* Cercle trigonométrique */
    .trig-wrap { display:flex; gap:1.5rem; flex-wrap:wrap; align-items:center; justify-content:center; }
    #trig-svg { width:min(360px,82vw); height:auto; touch-action:none; cursor:crosshair; user-select:none; flex:0 0 auto; }
    .trig-readout { flex:1 1 190px; min-width:180px; display:flex; flex-direction:column; gap:.55rem; }
    .trig-rv { background:#faf8ff; border:1px solid #ece4fb; border-radius:12px; padding:.6rem .9rem; }
    .trig-rv .lbl { font-size:.72rem; text-transform:uppercase; letter-spacing:.04em; font-weight:700; color:#6b7280; }
    .trig-rv .val { font-size:1.3rem; margin-top:.1rem; color:#1f2937; }
    .trig-rv.is-ang { border-left:4px solid #5e17eb; }
    .trig-rv.is-cos { border-left:4px solid #2563eb; }
    .trig-rv.is-sin { border-left:4px solid #dc2626; }
    .trig-rv.is-tan { border-left:4px solid #16a34a; }
    .trig-formulas { margin-top:1.4rem; padding-top:1.2rem; border-top:1px dashed #e0d7f4; }
    .trig-formulas h3 { font-size:1rem; font-weight:700; color:#322c4d; margin:0 0 .8rem; }
    .trig-fgrid { display:grid; grid-template-columns:repeat(2,1fr); gap:.6rem; }
    @media (max-width:640px){ .trig-fgrid { grid-template-columns:1fr; } }
    .trig-f { background:#fff8ec; border:1px solid #f3e4c4; border-radius:10px; padding:.7rem .9rem; overflow-x:auto; color:#374151; }
    .trig-f--cos { background:#eff6ff; border-color:#bfdbfe; }   /* cosinus → bleu */
    .trig-f--sin { background:#fef2f2; border-color:#fecaca; }   /* sinus → rouge */
    /* Formulaire dropdown (per topic) */
    .ml-form { margin-top:1rem; border:1px solid #e9e0fb; border-radius:12px; background:#faf8ff; overflow:hidden; transition:box-shadow .25s, transform .25s, border-color .25s; }
    .ml-form:hover { box-shadow:0 6px 18px rgba(94,23,235,.14); border-color:#cdb8f5; transform:translateY(-1px); }
    .ml-form > summary { cursor:pointer; padding:.8rem 1rem; font-weight:700; color:#322c4d; list-style:none; display:flex; align-items:center; gap:.6rem;
      user-select:none; background:#f7f4fe; transition:background .25s, padding-left .25s, letter-spacing .25s; }
    .ml-form > summary::-webkit-details-marker { display:none; }
    .ml-form > summary .bi-journal-text { font-size:1.05rem; color:#5e17eb; transition:transform .3s; }
    .ml-form > summary:hover { background:#efe7ff; padding-left:1.25rem; letter-spacing:.01em; }
    .ml-form > summary:hover .bi-journal-text { transform:scale(1.18) rotate(-8deg); }
    /* CSS chevron (no icon-font dependency) — rotates on open */
    .ml-form > summary::after { content:''; margin-left:auto; width:9px; height:9px; border-right:2.5px solid #5e17eb; border-bottom:2.5px solid #5e17eb;
      transform:rotate(45deg); transition:transform .3s; margin-right:4px; }
    .ml-form[open] > summary { border-bottom:1px solid #e9e0fb; }
    .ml-form[open] > summary::after { transform:rotate(225deg); }
    .ml-form[open]:hover { transform:none; }
    .ml-form-grid { padding:.7rem 1rem 1rem; }
    .ml-form-sec { font-size:.74rem; text-transform:uppercase; letter-spacing:.04em; font-weight:700; color:#5e17eb; margin:.9rem 0 .45rem; }
    .ml-form-sec:first-child { margin-top:0; }
    .ml-form-cards { display:grid; grid-template-columns:repeat(2,1fr); gap:.5rem; }
    @media (max-width:640px){ .ml-form-cards { grid-template-columns:1fr; } }
    /* Système d'équations */
    .sys-grid { display:flex; flex-direction:column; gap:.5rem; margin:0 0 .9rem; }
    .sys-row { display:flex; align-items:center; gap:.35rem; flex-wrap:wrap; background:#faf8ff; border:1px solid #ece4fb; border-radius:12px; padding:.45rem .6rem; }
    .sys-row .sys-lbl { font-weight:800; color:#5e17eb; font-size:.85rem; min-width:2.4rem; }
    .sys-row input { width:64px; padding:.42rem .5rem; border:2px solid #e0e0e0; border-radius:8px; font-family:'Courier New',monospace; font-size:.98rem; text-align:center; background:#fff; }
    .sys-row input:focus { outline:none; border-color:#5e17eb; }
    .sys-row .sys-v { font-family:'Times New Roman',serif; font-style:italic; font-weight:700; font-size:1.1rem; color:#322c4d; }
    .sys-row .sys-op { color:#6b6880; font-weight:700; }
    .sys-meth { margin:.55rem 0; padding:.55rem .8rem; border-radius:12px; background:rgba(255,255,255,.07); border-left:3px solid #ffc23a; }
    .sys-meth__t { font-family:system-ui,sans-serif; font-weight:800; color:#ffc23a; font-size:.82rem; text-transform:uppercase; letter-spacing:.04em; margin-bottom:.25rem; }
    .sys-stage { margin:.5rem 0; padding-left:.7rem; border-left:2px dashed rgba(255,255,255,.25); }

    /* Équation */
    .ml-study { font-variant-numeric: lining-nums; }
    .e1-table { border-collapse:collapse; background:#fff; color:#322c4d; font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif; font-size:.92rem; min-width:max-content; margin:.35rem 0 .2rem; border-radius:8px; overflow:hidden; }
    .e1-table th, .e1-table td { border:1px solid #ddd4f5; padding:.35rem .7rem; text-align:center; white-space:nowrap; }
    .e1-table th { background:#f7f4fe; font-weight:700; text-align:left; }
    .e1-table td.e1-zero { color:#5e17eb; font-weight:800; }
    .e1-table td.e1-pos { color:#15803d; font-weight:800; }
    .e1-table td.e1-neg { color:#dc2626; font-weight:800; }
    .e1-table td.e1-bar { background:repeating-linear-gradient(90deg,#fff,#fff 3px,#ffe3a3 3px,#ffe3a3 6px); }
    .e1-wrap { overflow-x:auto; -webkit-overflow-scrolling:touch; }
    .e1-case { margin:.4rem 0; padding:.45rem .7rem; border-radius:10px; background:rgba(255,255,255,.07); border-left:3px solid #ffc23a; }
    .e1-case--2 { border-left-color:#86efac; }
    .e1-case--0 { border-left-color:#fca5a5; }

    /* Fonctions définies par intervalles */
    .pw-ex { display:flex; flex-wrap:wrap; align-items:center; gap:.35rem; margin:0 0 1rem; }
    .pw-ex__lbl { font-size:.82rem; font-weight:700; color:#6b6880; margin-right:.2rem; }
    .pw-ex__lbl i { color:#d99a00; }
    .pw-row { display:flex; align-items:center; gap:.55rem; flex-wrap:wrap; margin-bottom:.6rem; }
    .pw-f { font-family:'Times New Roman',serif; font-style:italic; font-weight:700; font-size:1.08rem; color:#5e17eb; white-space:nowrap; }
    .pw-expr { flex:1 1 220px; min-width:150px; padding:.6rem .8rem; border:2px solid #e0e0e0; border-radius:10px;
      font-size:1rem; font-family:'Courier New',monospace; background:#fafafa; }
    .pw-expr:focus, .pw-junction input:focus, .pw-junction select:focus, .pw-params select:focus { outline:none; border-color:#5e17eb; background:#fff; }
    .pw-cond { font-size:.88rem; font-weight:700; color:#322c4d; background:#efe7ff; padding:.38rem .8rem; border-radius:999px; white-space:nowrap; }
    .pw-junction { display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; background:#fff8ec; border:1px dashed #ffe3a3;
      border-radius:12px; padding:.5rem .8rem; margin:0 0 .6rem; font-size:.9rem; color:#322c4d; }
    .pw-junction input { width:90px; padding:.42rem .6rem; border:2px solid #e0e0e0; border-radius:8px; font-family:'Courier New',monospace; background:#fff; }
    .pw-junction select, .pw-params select { padding:.42rem .6rem; border:2px solid #e0e0e0; border-radius:8px; background:#fff; font-size:.86rem; color:#322c4d; max-width:100%; }
    .pw-params { display:flex; align-items:center; gap:.45rem; flex-wrap:wrap; background:#efe7ff; border:1px solid #ddd0fb;
      border-radius:12px; padding:.6rem .85rem; margin:.2rem 0 .9rem; font-size:.9rem; color:#322c4d; }
    .pw-params > i { color:#5e17eb; }
    .pw-params strong { color:#5e17eb; }
    .study-ok { color:#86efac; font-weight:700; }
    .study-ko { color:#fca5a5; font-weight:700; }
    .study-sub { font-weight:700; color:#fff; margin:.55rem 0 .15rem; font-family:system-ui,sans-serif; font-size:.9rem; }

    /* Q(z) — two methods: long division (posée) + identification (system) */
    .eq-methods { display:grid; gap:1rem; margin-top:1rem; }
    .eq-meth { background:#fff; border:1px solid #ece9f3; border-radius:16px; padding:1rem 1.1rem; box-shadow:0 4px 16px rgba(50,44,77,.06); }
    .eq-meth__t { display:flex; align-items:center; gap:.5rem; font-weight:800; color:#322c4d; font-size:1rem; margin-bottom:.35rem; }
    .eq-meth__n { display:inline-flex; align-items:center; justify-content:center; width:26px; height:26px; border-radius:50%;
      background:#ffc23a; color:#322c4d; font-size:.85rem; font-weight:800; flex-shrink:0; }
    .eq-meth__n--v { background:#5e17eb; color:#fff; }
    .eq-meth__intro { font-size:.9rem; color:#6b6880; margin:0 0 .75rem; line-height:1.5; }
    .eq-div-wrap { overflow-x:auto; -webkit-overflow-scrolling:touch; }
    .eq-div { border-collapse:collapse; font-size:1rem; min-width:max-content; }
    .eq-div td { padding:.28rem .55rem; text-align:right; white-space:nowrap; vertical-align:middle; }
    .eq-div td.eq-dv { text-align:left; padding-left:.9rem; }
    .eq-div tr.eq-sub td.eq-l { color:#5e17eb; background:#f6f1ff; border-bottom:2px solid #322c4d; }
    .eq-div tr.eq-rem td.eq-l { color:#322c4d; font-weight:700; }
    .eq-div td.eq-dv-top { border-left:2px solid #322c4d; border-bottom:2px solid #322c4d; }
    .eq-div td.eq-dv-q { border-left:2px solid #322c4d; color:#5e17eb; font-weight:700; }
    .eq-div td.eq-lbl { font-size:.74rem; color:#a3a0b5; text-align:left; padding-left:.8rem; font-style:italic; }
    .eq-sys { overflow-x:auto; font-size:1.02rem; margin:.4rem 0 .6rem; }
    .eq-line { margin:.3rem 0; overflow-x:auto; }
    .eq-ok { margin-top:.5rem; font-size:.88rem; color:#15803d; font-weight:600; }
    .eq-ok.is-ko { color:#dc2626; }
    .ml-form-card { background:#fff; border:1px solid #ece4fb; border-radius:9px; padding:.5rem .7rem; overflow-x:auto; color:#374151; font-size:.95rem; }
  </style>
` %>

