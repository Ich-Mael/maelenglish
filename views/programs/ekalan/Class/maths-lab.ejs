    }
    // Pure-JS complex arithmetic — used for synthetic division & the quadratic formula,
    // because evalCommandCAS (Div/Simplify) is unreliable with the imaginary unit.
    function cAdd(p, q){ return { re: p.re + q.re, im: p.im + q.im }; }
    function cSub(p, q){ return { re: p.re - q.re, im: p.im - q.im }; }
    function cMul(p, q){ return { re: p.re * q.re - p.im * q.im, im: p.re * q.im + p.im * q.re }; }
    function cDiv(p, q){ var d = q.re * q.re + q.im * q.im; return { re: (p.re * q.re + p.im * q.im) / d, im: (p.im * q.re - p.re * q.im) / d }; }
    function cSqrt(w){ var m = Math.hypot(w.re, w.im); var re = Math.sqrt(Math.max(0, (m + w.re) / 2)); var im = Math.sqrt(Math.max(0, (m - w.re) / 2)); if(w.im < 0) im = -im; return { re: re, im: im }; }
    function cIsZero(c){ return Math.abs(c.re) < 1e-9 && Math.abs(c.im) < 1e-9; }
    // Parse simple complex inputs (a, bi, a+bi, -1-2i, 0.5i…) without GeoGebra. Returns {re,im} or null.
    function parseComplex(s){
      s = String(s == null ? '' : s).trim();
      if(s === '') return { re: 0, im: 0 };
      s = s.split(' ').join('').split('*').join('').split(String.fromCharCode(0x2212)).join('-');
      if(s.charAt(0) !== '+' && s.charAt(0) !== '-') s = '+' + s;
      var re = 0, im = 0, i = 0;
      while(i < s.length){
        var ch = s.charAt(i), sign;
        if(ch === '+'){ sign = 1; i++; } else if(ch === '-'){ sign = -1; i++; } else return null;
        var j = i; while(j < s.length && s.charAt(j) !== '+' && s.charAt(j) !== '-') j++;
        var term = s.slice(i, j); i = j;
        if(term === '') return null;
        if(term === 'i'){ im += sign; }
        else if(term.charAt(term.length - 1) === 'i'){
          var ns = term.slice(0, -1), num = (ns === '') ? 1 : Number(ns);
          if(!isFinite(num)) return null; im += sign * num;
        } else { var n2 = Number(term); if(!isFinite(n2)) return null; re += sign * n2; }
      }
      return { re: re, im: im };
    }
    function coefVal(s){ var p = parseComplex(s); if(p) return p; var v = evalComplex('(' + (((s || '').trim()) || '0') + ')'); return v || { re: 0, im: 0 }; }
    function fmtReal(x){ var r = Math.round(x * 1e6) / 1e6; if(Math.abs(r - Math.round(r)) < 1e-9) r = Math.round(r); return String(r); }
    function fmtImag(y){
      var r = Math.round(y * 1e6) / 1e6; if(Math.abs(r - Math.round(r)) < 1e-9) r = Math.round(r);
      if(r === 1) return 'i'; if(r === -1) return '-i'; return r + 'i';
