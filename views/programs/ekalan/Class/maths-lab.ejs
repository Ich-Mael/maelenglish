            <button type="button" class="ml-mode" data-mode="system"><i class="bi bi-grid-3x3-gap"></i> Système d’équations</button>
            <button type="button" class="ml-mode" data-mode="bary"><i class="bi bi-bullseye"></i> Barycentre</button>
            <button type="button" class="ml-mode" data-mode="suite"><i class="bi bi-list-ol"></i> Suites</button>
            <button type="button" class="ml-mode" data-mode="stats"><i class="bi bi-bar-chart-line"></i> Statistiques</button>
