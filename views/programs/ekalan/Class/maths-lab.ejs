    function integralCAS(f){
      if(intType === 'def'){
        var a = (iaInput.value || '').trim(), b = (ibInput.value || '').trim();
        return 'Integral(' + f + ', ' + a + ', ' + b + ')';
      }
      return 'Integral(' + f + ')';
    }

    async function runIntegral(){
      var f = (ifxInput.value || '').trim();
      if(!f){ stateEl.textContent = 'Saisissez une fonction.'; return; }
      if(!ggb) return;
      var a = '', b = '';
      if(intType === 'def'){
        a = (iaInput.value || '').trim(); b = (ibInput.value || '').trim();
        if(!a || !b){ stateEl.textContent = 'Renseignez les bornes a et b.'; return; }
      }

      clearIntPlot();
      plot(f);
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul en cours…';
      setIOpsEnabled(false);

      var casResult = '';
      try { casResult = ggb.evalCommandCAS(integralCAS(f)); } catch(e){ casResult = ''; }
      casResult = ggbToText(casResult).trim();
      if(!casResult || casResult === '?'){ stateEl.textContent = 'Impossible de calculer — vérifiez la fonction' + (intType === 'def' ? ' et les bornes.' : '.'); setIOpsEnabled(true); return; }

      // Shade the area under the curve for a definite integral.
      if(intType === 'def'){ defInt('iarea', 'iarea=Integral(f, ' + a + ', ' + b + ')'); colour('iarea', 255, 184, 0); }

      answerEl.innerHTML = '<div class="ml-answer"><div class="lbl"><i class="bi bi-stars"></i> Résultat</div><div class="val">' + escapeHtml(casResult) + '</div></div>';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';

      var op = (intType === 'def') ? 'integral_def' : 'integral';
      var body = { function: f, operation: op, casResult: casResult };
      if(intType === 'def'){ body.a = a; body.b = b; }
      try {
        var resp = await fetch(EXPLAIN_URL, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify(body)
        });
        var data = await resp.json();
        if(data.ok){ showSteps(data); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){
        stateEl.textContent = 'Connexion impossible — réessayez.';
      } finally {
        setIOpsEnabled(true);
      }
    }

    iopsEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return;
      runIntegral();
    });
    setIType('indef');

    /* ============ CERCLE TRIGONOMÉTRIQUE ============ */
    var modeTrig = document.getElementById('mode-trig');
    var tcSvg = document.getElementById('trig-svg');
    var TC_CX = 170, TC_CY = 170, TC_R = 130;
    var tcEls = {};
    ['tc-vproj','tc-hproj','tc-cos','tc-sin','tc-tan','tc-tanconn','tc-radius','tc-point','tc-tanpoint','tc-angle','tc-cosv','tc-sinv','tc-tanv'].forEach(function(id){ tcEls[id] = document.getElementById(id); });
    var tcDeg = 45;
    // Angle measured in ]-π, π]  (i.e. ]-180°, 180°]).
    function norm180(d){ d = ((d % 360) + 360) % 360; if(d > 180) d -= 360; return d; }
    var NICE_DEG = [0,30,45,60,90,120,135,150,180,-30,-45,-60,-90,-120,-135,-150];
    var RAD_LATEX = {
      0:'0', 30:BS+'frac{'+BS+'pi}{6}', 45:BS+'frac{'+BS+'pi}{4}', 60:BS+'frac{'+BS+'pi}{3}', 90:BS+'frac{'+BS+'pi}{2}',
      120:BS+'frac{2'+BS+'pi}{3}', 135:BS+'frac{3'+BS+'pi}{4}', 150:BS+'frac{5'+BS+'pi}{6}', 180:BS+'pi',
      '-30':'-'+BS+'frac{'+BS+'pi}{6}', '-45':'-'+BS+'frac{'+BS+'pi}{4}', '-60':'-'+BS+'frac{'+BS+'pi}{3}', '-90':'-'+BS+'frac{'+BS+'pi}{2}',
      '-120':'-'+BS+'frac{2'+BS+'pi}{3}', '-135':'-'+BS+'frac{3'+BS+'pi}{4}', '-150':'-'+BS+'frac{5'+BS+'pi}{6}'
    };
    function tcExact(x){
      var s3 = Math.sqrt(3), h = Math.SQRT1_2;
      var t = [[0,'0'],[1,'1'],[-1,'-1'],[0.5,BS+'frac{1}{2}'],[-0.5,'-'+BS+'frac{1}{2}'],
        [h,BS+'frac{'+BS+'sqrt{2}}{2}'],[-h,'-'+BS+'frac{'+BS+'sqrt{2}}{2}'],
        [s3/2,BS+'frac{'+BS+'sqrt{3}}{2}'],[-s3/2,'-'+BS+'frac{'+BS+'sqrt{3}}{2}'],
        [s3/3,BS+'frac{'+BS+'sqrt{3}}{3}'],[-s3/3,'-'+BS+'frac{'+BS+'sqrt{3}}{3}'],
        [s3,BS+'sqrt{3}'],[-s3,'-'+BS+'sqrt{3}']];
      for(var i=0;i<t.length;i++){ if(Math.abs(x - t[i][0]) < 1e-9) return t[i][1]; }
      return null;
    }
    function snapNice(deg){
      deg = norm180(deg);
      for(var i=0;i<NICE_DEG.length;i++){ var d = NICE_DEG[i], diff = Math.abs(deg - d); diff = Math.min(diff, 360 - diff); if(diff <= 4) return d; }
      return null;
    }
    function tcLine(el, x1, y1, x2, y2){ el.setAttribute('x1', x1); el.setAttribute('y1', y1); el.setAttribute('x2', x2); el.setAttribute('y2', y2); }
    function tcDot(el, x, y){ el.setAttribute('cx', x); el.setAttribute('cy', y); }
    function tcShow(el, on){ el.setAttribute('opacity', on ? '1' : '0'); }

    function tcRender(deg){
      var snap = snapNice(deg);
      var useDeg = (snap != null) ? snap : norm180(deg);
      var th = useDeg * Math.PI / 180, c = Math.cos(th), s = Math.sin(th);
      var px = TC_CX + TC_R * c, py = TC_CY - TC_R * s;
      tcLine(tcEls['tc-radius'], TC_CX, TC_CY, px, py);
      tcDot(tcEls['tc-point'], px, py);
      tcLine(tcEls['tc-cos'], TC_CX, TC_CY, px, TC_CY);
      tcLine(tcEls['tc-sin'], TC_CX, TC_CY, TC_CX, py);
      tcLine(tcEls['tc-vproj'], px, py, px, TC_CY);
      tcLine(tcEls['tc-hproj'], px, py, TC_CX, py);
      var tanVal = (Math.abs(c) < 1e-9) ? null : s / c;
      if(tanVal == null){ tcShow(tcEls['tc-tan'], false); tcShow(tcEls['tc-tanconn'], false); tcShow(tcEls['tc-tanpoint'], false); }
      else {
        var clampY = Math.max(34, Math.min(306, TC_CY - TC_R * tanVal));
        tcShow(tcEls['tc-tan'], true); tcShow(tcEls['tc-tanconn'], true); tcShow(tcEls['tc-tanpoint'], true);
        tcLine(tcEls['tc-tan'], TC_CX + TC_R, TC_CY, TC_CX + TC_R, clampY);
        tcLine(tcEls['tc-tanconn'], TC_CX, TC_CY, TC_CX + TC_R, clampY);
        tcDot(tcEls['tc-tanpoint'], TC_CX + TC_R, clampY);
      }
      if(snap != null){
        renderKatex(tcEls['tc-angle'], BS + 'theta = ' + (RAD_LATEX[snap] || '0') + BS + ';(' + snap + '^' + BS + 'circ)');
        renderKatex(tcEls['tc-cosv'], tcExact(c) || c.toFixed(3));
        renderKatex(tcEls['tc-sinv'], tcExact(s) || s.toFixed(3));
        if(tanVal == null) tcEls['tc-tanv'].textContent = 'non défini';
        else renderKatex(tcEls['tc-tanv'], tcExact(tanVal) || tanVal.toFixed(3));
      } else {
        tcEls['tc-angle'].textContent = useDeg.toFixed(1) + '°  (' + (useDeg * Math.PI / 180).toFixed(2) + ' rad)';
        tcEls['tc-cosv'].textContent = c.toFixed(3);
        tcEls['tc-sinv'].textContent = s.toFixed(3);
        tcEls['tc-tanv'].textContent = (tanVal == null) ? 'non défini' : tanVal.toFixed(3);
      }
    }
    function tcAngleFromEvent(ev){
      var rect = tcSvg.getBoundingClientRect();
      if(!rect.width) return tcDeg;
      var sx = (ev.clientX - rect.left) / rect.width * 340, sy = (ev.clientY - rect.top) / rect.height * 340;
      return Math.atan2(-(sy - TC_CY), sx - TC_CX) * 180 / Math.PI;
    }
    tcSvg.addEventListener('pointermove', function(ev){ tcDeg = tcAngleFromEvent(ev); tcRender(tcDeg); });
    tcSvg.addEventListener('pointerdown', function(ev){ tcDeg = tcAngleFromEvent(ev); tcRender(tcDeg); });

    // Interleaved cos/sin so the 2-column grid puts cos (blue) left, sin (red) right.
    var TC_FORMULAS = [
      { k:'gen', t: BS+'cos^2'+BS+'theta + '+BS+'sin^2'+BS+'theta = 1' },
      { k:'gen', t: BS+'tan'+BS+'theta = '+BS+'frac{'+BS+'sin'+BS+'theta}{'+BS+'cos'+BS+'theta}' },
      { k:'cos', t: BS+'cos(-'+BS+'theta) = '+BS+'cos'+BS+'theta' },
      { k:'sin', t: BS+'sin(-'+BS+'theta) = -'+BS+'sin'+BS+'theta' },
      { k:'cos', t: BS+'cos('+BS+'pi - '+BS+'theta) = -'+BS+'cos'+BS+'theta' },
      { k:'sin', t: BS+'sin('+BS+'pi - '+BS+'theta) = '+BS+'sin'+BS+'theta' },
      { k:'cos', t: BS+'cos('+BS+'tfrac{'+BS+'pi}{2} - '+BS+'theta) = '+BS+'sin'+BS+'theta' },
      { k:'sin', t: BS+'sin('+BS+'tfrac{'+BS+'pi}{2} - '+BS+'theta) = '+BS+'cos'+BS+'theta' },
      { k:'cos', t: BS+'cos('+BS+'tfrac{'+BS+'pi}{2} + '+BS+'theta) = -'+BS+'sin'+BS+'theta' },
      { k:'sin', t: BS+'sin('+BS+'tfrac{'+BS+'pi}{2} + '+BS+'theta) = '+BS+'cos'+BS+'theta' },
      { k:'cos', t: BS+'cos(a+b) = '+BS+'cos a'+BS+'cos b - '+BS+'sin a'+BS+'sin b' },
      { k:'sin', t: BS+'sin(a+b) = '+BS+'sin a'+BS+'cos b + '+BS+'cos a'+BS+'sin b' },
      { k:'cos', t: BS+'cos(a-b) = '+BS+'cos a'+BS+'cos b + '+BS+'sin a'+BS+'sin b' },
      { k:'sin', t: BS+'sin(a-b) = '+BS+'sin a'+BS+'cos b - '+BS+'cos a'+BS+'sin b' },
      { k:'cos', t: BS+'cos(2a) = 2'+BS+'cos^2 a - 1' },
      { k:'sin', t: BS+'sin(2a) = 2'+BS+'sin a'+BS+'cos a' }
    ];
    // Produit → Somme (cos·cos / sin·sin → cos ; sin·cos → sin)
    var TC_PROD2SUM = [
      { k:'cos', t: BS+'cos a'+BS+'cos b = '+BS+'tfrac{1}{2}'+BS+'big['+BS+'cos(a-b) + '+BS+'cos(a+b)'+BS+'big]' },
      { k:'sin', t: BS+'sin a'+BS+'sin b = '+BS+'tfrac{1}{2}'+BS+'big['+BS+'cos(a-b) - '+BS+'cos(a+b)'+BS+'big]' },
      { k:'cos', t: BS+'sin a'+BS+'cos b = '+BS+'tfrac{1}{2}'+BS+'big['+BS+'sin(a+b) + '+BS+'sin(a-b)'+BS+'big]' },
      { k:'sin', t: BS+'cos a'+BS+'sin b = '+BS+'tfrac{1}{2}'+BS+'big['+BS+'sin(a+b) - '+BS+'sin(a-b)'+BS+'big]' }
    ];
    // Somme → Produit
    var TC_SUM2PROD = [
      { k:'cos', t: BS+'cos p + '+BS+'cos q = 2'+BS+'cos'+BS+'tfrac{p+q}{2}'+BS+'cos'+BS+'tfrac{p-q}{2}' },
      { k:'sin', t: BS+'sin p + '+BS+'sin q = 2'+BS+'sin'+BS+'tfrac{p+q}{2}'+BS+'cos'+BS+'tfrac{p-q}{2}' },
      { k:'cos', t: BS+'cos p - '+BS+'cos q = -2'+BS+'sin'+BS+'tfrac{p+q}{2}'+BS+'sin'+BS+'tfrac{p-q}{2}' },
      { k:'sin', t: BS+'sin p - '+BS+'sin q = 2'+BS+'cos'+BS+'tfrac{p+q}{2}'+BS+'sin'+BS+'tfrac{p-q}{2}' }
    ];
    function renderFormulaGrid(boxId, arr){
      var box = document.getElementById(boxId); if(!box) return;
      arr.forEach(function(f){ var d = document.createElement('div'); d.className = 'trig-f trig-f--' + f.k; box.appendChild(d); renderKatex(d, f.t); });
    }
    renderFormulaGrid('tc-formulas', TC_FORMULAS);
    renderFormulaGrid('tc-prod2sum', TC_PROD2SUM);
    renderFormulaGrid('tc-sum2prod', TC_SUM2PROD);
    tcRender(tcDeg);

    /* --- Trigonométrie : opérations (équation / linéarisation / duplication) --- */
    var trigCircleCard = document.getElementById('trig-circle-card');
    var trigOptype = document.getElementById('trig-optype');
    var trigEqFields = document.getElementById('trig-eq-fields');
    var trigExprFields = document.getElementById('trig-expr-fields');
    var trigEq = document.getElementById('trig-eq');
    var trigInt = document.getElementById('trig-int');
    var trigExpr = document.getElementById('trig-expr');
    var trigKeysEl = document.getElementById('trig-keys');
    var trigRun = document.getElementById('trig-run');
    var trigHint = document.getElementById('trig-hint');
    var trigPrev = document.getElementById('trig-preview');
    var trigOp = 'equation';
    var activeTrig = trigEq;

    function intervalLatex(iv){ return (iv || '').split('π').join('pi').split('pi').join(BS + 'pi'); }
    function eqToLatex(eq){
      var i = eq.indexOf('=');
      if(i < 0) return toLatex(eq);
      var L = toLatex(eq.slice(0, i).trim());
      var rr = eq.slice(i + 1).trim();
      return L + ' = ' + (rr === '' ? '' : toLatex(rr));
    }
    function updateTrigPreview(){
      var raw = (trigOp === 'equation') ? (trigEq.value || '').trim() : (trigExpr.value || '').trim();
      if(!raw){ trigPrev.className = 'ml-preview is-empty'; trigPrev.textContent = 'Aperçu…'; return; }
      var tex = null;
      try {
        if(trigOp === 'equation'){
          tex = eqToLatex(raw);
          var iv = (trigInt.value || '').trim();
          if(iv) tex += BS + 'quad x ' + BS + 'in ' + intervalLatex(iv);
        } else { tex = toLatex(raw); }
      } catch(e){ tex = null; }
      if(tex == null){ trigPrev.className = 'ml-preview is-empty'; trigPrev.textContent = '…en cours de saisie'; return; }
      try { katex.render(tex, trigPrev, { throwOnError:true, displayMode:false }); trigPrev.className = 'ml-preview'; }
      catch(e){ trigPrev.className = 'ml-preview is-empty'; trigPrev.textContent = '…en cours de saisie'; }
    }

    function setTrigOp(t){
      trigOp = t;
      trigOptype.querySelectorAll('.ml-sidebtn').forEach(function(b){ b.classList.toggle('is-active', b.getAttribute('data-top') === t); });
      trigEqFields.hidden = (t !== 'equation');
      trigExprFields.hidden = (t === 'equation');
      activeTrig = (t === 'equation') ? trigEq : trigExpr;
      trigHint.textContent = (t === 'equation')
        ? 'Résous une équation trigonométrique sur un intervalle (ex : cos(x) = 1/2 sur ]-π ; π]).'
        : (t === 'linearize')
        ? 'Linéarise : exprime cosⁿx, sinⁿx comme combinaison de cos(kx) et sin(kx) (ex : cos(x)^2, sin(x)^3).'
        : 'Développe avec les formules de duplication / d’addition, en fonction de cos x et sin x (ex : cos(2x)).';
      updateTrigPreview();
    }
    trigOptype.addEventListener('click', function(ev){ var b = ev.target.closest('.ml-sidebtn'); if(b) setTrigOp(b.getAttribute('data-top')); });

    [trigEq, trigInt, trigExpr].forEach(function(inp){
      inp.addEventListener('focus', function(){ activeTrig = inp; });
      inp.addEventListener('input', updateTrigPreview);
      inp.addEventListener('keydown', function(ev){ if(ev.key === 'Enter'){ ev.preventDefault(); runTrigOp(); } });
    });

    trigKeysEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-key'); if(!btn) return;
      var inp = activeTrig || trigEq;
      var act = btn.getAttribute('data-act');
      if(act === 'clear'){ inp.value = ''; inp.focus(); }
      else if(act === 'back'){
        var v = inp.value, s = inp.selectionStart, e = inp.selectionEnd;
        if(s == null){ inp.value = v.slice(0,-1); }
        else if(s !== e){ inp.value = v.slice(0,s) + v.slice(e); inp.setSelectionRange(s,s); }
        else if(s > 0){ inp.value = v.slice(0,s-1) + v.slice(s); inp.setSelectionRange(s-1,s-1); }
        inp.focus();
      } else { insertInto(inp, btn.getAttribute('data-ins')); }
      updateTrigPreview();
    });

    async function runTrigOp(){
      var op = (trigOp === 'equation') ? 'trig_equation' : (trigOp === 'linearize') ? 'trig_linearize' : 'trig_duplicate';
      var body = { domain:'trig', operation: op };
      if(trigOp === 'equation'){
        var eq = (trigEq.value || '').trim();
        if(!eq){ stateEl.textContent = 'Saisissez une équation.'; return; }
        body.expression = eq; body.interval = (trigInt.value || '').trim();
      } else {
        var ex = (trigExpr.value || '').trim();
        if(!ex){ stateEl.textContent = 'Saisissez une expression.'; return; }
        body.expression = ex;
      }
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul en cours…';
      trigRun.disabled = true;
      try {
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
        var data = await resp.json();
        if(data.ok){ showSteps(data); }
        else { stateEl.textContent = data.error || 'Indisponible pour le moment.'; }
      } catch(e){ stateEl.textContent = 'Connexion impossible — réessayez.'; }
      finally { trigRun.disabled = false; }
    }
    trigRun.addEventListener('click', runTrigOp);
    setTrigOp('equation');

    function switchMode(m){
      if(m === currentMode) return;
      currentMode = m;
      modesEl.querySelectorAll('.ml-mode').forEach(function(b){ b.classList.toggle('is-active', b.getAttribute('data-mode') === m); });
      modeFunc.hidden     = (m !== 'function');
      modeCplx.hidden     = (m !== 'complex');
      modeGeo.hidden      = (m !== 'geometry');
      modeLimit.hidden    = (m !== 'limit');
      modeIntegral.hidden = (m !== 'integral');
      modeTrig.hidden     = (m !== 'trig');
      answerEl.innerHTML = ''; stepsEl.innerHTML = ''; stateEl.textContent = '';
      var isTrig = (m === 'trig');
      // Trigonométrie: hide the GeoGebra graph, show the unit-circle card below.
      var gcard = document.getElementById('graph-card'); if(gcard) gcard.hidden = isTrig;
      if(trigCircleCard) trigCircleCard.hidden = !isTrig;
      if(isTrig){ tcRender(tcDeg); return; }
      if(ggb){
        try { ggb.setPerspective((m === 'function' || m === 'limit' || m === 'integral') ? 'AG' : 'G'); } catch(e){}
        clearComplexPlot(); clearGeoPlot(); clearLimPlot(); clearIntPlot();
        if(m === 'function'){
          graphTitle.textContent = 'Représentation graphique';
          graphHint.textContent = 'La courbe se met à jour quand vous tracez ou lancez un calcul. Utilisez « Tracer » après avoir modifié la fonction.';
          plot((fxInput.value || '').trim());
        } else if(m === 'complex'){
          graphTitle.textContent = 'Plan complexe (Argand)';
          graphHint.textContent = 'Le point z₁ et le vecteur depuis l’origine apparaissent quand vous lancez un calcul.';
          try { ggb.deleteObject('f'); } catch(e){}
          updateZPreview();
        } else if(m === 'geometry'){
          graphTitle.textContent = 'Plan complexe — figure';
          graphHint.textContent = 'Placez les affixes des points puis « Tracer la figure » ou déterminez la nature de la figure.';
          try { ggb.deleteObject('f'); } catch(e){}
          updateGeoPreview();
        } else if(m === 'limit'){
          graphTitle.textContent = 'Courbe & limite';
          graphHint.textContent = 'La courbe de f et l’asymptote au point étudié apparaissent quand vous lancez le calcul.';
          plot((lfxInput.value || '').trim());
          updateLimPreview();
        } else {
          graphTitle.textContent = 'Aire & intégrale';
          graphHint.textContent = 'La courbe de f s’affiche ; pour une intégrale définie, l’aire entre a et b est colorée.';
          plot((ifxInput.value || '').trim());
          updateIntPreview();
        }
        setTimeout(fitGraph, 60);
      }
    }
    modesEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-mode'); if(!btn) return;
      switchMode(btn.getAttribute('data-mode'));
    });

    // Keep the GeoGebra applet sized to its (now full-width) container.
    var ggbHost = document.getElementById('ggb');
    function fitGraph(){
      if(!ggb) return;
      var w = Math.max(320, ggbHost.clientWidth || 700);
      var h = Math.min(540, Math.max(420, Math.round(w * 0.52)));
      try { ggb.setSize(w, h); } catch(e){}
    }
    var ggbResizeTimer = null;
    window.addEventListener('resize', function(){ clearTimeout(ggbResizeTimer); ggbResizeTimer = setTimeout(fitGraph, 200); });

    // GeoGebra applet
    setOpsEnabled(false); setCOpsEnabled(false); setGOpsEnabled(false); setLOpsEnabled(false); setIOpsEnabled(false);
    if(eqSolveBtn) eqSolveBtn.disabled = true;
    setEqStepsEnabled(false);
    var initW = Math.max(320, ggbHost.clientWidth || 700);
    var initH = Math.min(540, Math.max(420, Math.round(initW * 0.52)));
    var applet = new GGBApplet({
      appName: 'classic',
      width: initW, height: initH,
      showToolBar: false, showAlgebraInput: false, showMenuBar: false,
      enableRightClick: false, showResetIcon: true,
      perspective: 'AG',
      appletOnLoad: function(api){ ggb = api; try { ggb.setErrorDialogsActive(false); } catch(e){} setOpsEnabled(true); setCOpsEnabled(true); setGOpsEnabled(true); setLOpsEnabled(true); setIOpsEnabled(true); if(eqSolveBtn) eqSolveBtn.disabled = false; setEqStepsEnabled(true); fitGraph(); plot((fxInput.value||'').trim()); }
    }, true);
    applet.inject('ggb');
    updatePreview();
    updateZPreview();
    updateGeoPreview();
    updateLimPreview();
    updateIntPreview();
    updateEqPreview();
  })();
  </script>
` %>
