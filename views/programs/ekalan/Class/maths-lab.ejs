          var core = depth > 0 ? tok : st.core;
          var kk = oqTokKind(core);
          if(kk === 'text' || core === '') break;
          if(kk === 'strong' || kk === 'op') strong = true;
          depth += depthOf(tok);
          j++;
          if(depth <= 0 && st.punct && depthOf(st.core) === depthOf(tok)){ punct = st.punct; break; }
