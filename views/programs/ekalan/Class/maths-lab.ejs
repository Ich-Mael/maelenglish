    gkeysEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-key'); if(!btn) return;
      var inp = activeGeo || geoInputs()[0]; if(!inp) return;
      var act = btn.getAttribute('data-cact');
      if(act === 'clear'){ inp.value = ''; inp.focus(); }
      else if(act === 'back'){
        var v = inp.value, s = inp.selectionStart, e = inp.selectionEnd;
        if(s == null){ inp.value = v.slice(0,-1); }
        else if(s !== e){ inp.value = v.slice(0,s) + v.slice(e); inp.setSelectionRange(s,s); }
        else if(s > 0){ inp.value = v.slice(0,s-1) + v.slice(s); inp.setSelectionRange(s-1,s-1); }
        inp.focus();
      }
      else { insertInto(inp, btn.getAttribute('data-cins')); }
      updateGeoPreview();
    });

    function updateGeoPreview(){
      var inputs = geoInputs();
      var inp = (activeGeo && inputs.indexOf(activeGeo) >= 0) ? activeGeo : inputs[0];
      var idx = inputs.indexOf(inp); var name = GEO_LETTERS[idx >= 0 ? idx : 0];
      var raw = inp ? (inp.value || '').trim() : '';
      if(!raw){ gPreviewEl.className = 'ml-preview is-empty'; gPreviewEl.textContent = 'Aperçu des affixes…'; return; }
      var latex = null; try { latex = toLatex(raw); } catch(e){ latex = null; }
      if(latex == null){ gPreviewEl.className = 'ml-preview is-empty'; gPreviewEl.textContent = '…en cours de saisie'; return; }
      try { katex.render('z_' + name + ' = ' + latex, gPreviewEl, { throwOnError:true, displayMode:false }); gPreviewEl.className = 'ml-preview'; }
      catch(e){ gPreviewEl.className = 'ml-preview is-empty'; gPreviewEl.textContent = '…en cours de saisie'; }
    }

    function clearGeoPlot(){ geoObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} }); geoObjs = []; }
    function defGeo(name, cmd){ try { ggb.evalCommand(name + '=' + cmd); geoObjs.push(name); } catch(e){} }
    function fitGeo(names){
      var xs = [0], ys = [0];
      names.forEach(function(nm){ try { var x = ggb.getXcoord(nm), y = ggb.getYcoord(nm); if(isFinite(x) && isFinite(y)){ xs.push(x); ys.push(y); } } catch(e){} });
      var minX = Math.min.apply(null, xs), maxX = Math.max.apply(null, xs);
      var minY = Math.min.apply(null, ys), maxY = Math.max.apply(null, ys);
      var padX = Math.max(2, (maxX - minX) * 0.25), padY = Math.max(2, (maxY - minY) * 0.25);
      try { ggb.setCoordSystem(minX - padX, maxX + padX, minY - padY, maxY + padY); } catch(e){}
    }

    // Plot the points as real GeoGebra Points (so Polygon works) + the polygon. Returns {coords, ok}.
    function plotGeo(points){
      if(!ggb) return { coords:[], ok:false };
      clearGeoPlot(); try { ggb.deleteObject('f'); } catch(e){}
      var coords = [], names = [], ok = true;
      points.forEach(function(pt){
        var tmp = 'zz_' + pt.name, x = NaN, y = NaN;
        try { ggb.evalCommand(tmp + '=(' + pt.affix + ')'); x = ggb.getXcoord(tmp); y = ggb.getYcoord(tmp); } catch(e){}
        try { ggb.deleteObject(tmp); } catch(e){}
        coords.push({ name: pt.name, x: x, y: y });
        if(isFinite(x) && isFinite(y)){
          defGeo(pt.name, '(' + x + ',' + y + ')'); colour(pt.name, 93, 6, 186);
          try { ggb.setLabelVisible(pt.name, true); } catch(e){}
          names.push(pt.name);
        } else { ok = false; }
      });
      if(names.length >= 3){ defGeo('poly1', 'Polygon(' + names.join(',') + ')'); colour('poly1', 168, 85, 247); }
      else if(names.length === 2){ defGeo('seg1', 'Segment(' + names[0] + ',' + names[1] + ')'); colour('seg1', 168, 85, 247); }
      fitGeo(names);
      return { coords: coords, ok: ok };
    }

    function approxEq(a, b){ return Math.abs(a - b) <= 1e-7 * Math.max(1, Math.abs(a), Math.abs(b)); }
    function rnd(v){ return String(Math.round(v * 1000) / 1000); }
    function dist(u, v){ return Math.hypot(u.x - v.x, u.y - v.y); }
    function rightAngleAt(V, U, W){ // angle U-V-W ; V is the vertex
      var v1x = U.x - V.x, v1y = U.y - V.y, v2x = W.x - V.x, v2y = W.y - V.y;
      var dot = v1x * v2x + v1y * v2y, m = Math.hypot(v1x, v1y) * Math.hypot(v2x, v2y);
      return m > 0 && Math.abs(dot) <= 1e-7 * m;
    }
    function parallelSeg(p1, p2, q1, q2){
      var ux = p2.x - p1.x, uy = p2.y - p1.y, vx = q2.x - q1.x, vy = q2.y - q1.y;
      var cross = ux * vy - uy * vx, m = Math.hypot(ux, uy) * Math.hypot(vx, vy);
      return m > 0 && Math.abs(cross) <= 1e-7 * m;
    }

    function classifyTriangle(P){
      var A = P[0], B = P[1], C = P[2];
      var AB = dist(A,B), BC = dist(B,C), CA = dist(C,A);
      var lengths = { AB:AB, BC:BC, CA:CA };
      var area = Math.abs((B.x-A.x)*(C.y-A.y) - (C.x-A.x)*(B.y-A.y)) / 2;
      if(area <= 1e-9 * Math.max(1, AB*BC)) return { nature:"Points alignés — ce n'est pas un triangle", lengths:lengths };
      var equilateral = approxEq(AB,BC) && approxEq(BC,CA) && approxEq(CA,AB);
      var rA = rightAngleAt(A,B,C), rB = rightAngleAt(B,A,C), rC = rightAngleAt(C,A,B);
      var right = rA || rB || rC, rightVertex = rA ? 'A' : rB ? 'B' : rC ? 'C' : null;
      var apex = approxEq(CA,AB) ? 'A' : approxEq(AB,BC) ? 'B' : approxEq(BC,CA) ? 'C' : null;
      var iso = !!apex;
      var nature;
      if(equilateral) nature = 'Triangle équilatéral';
      else if(right && iso) nature = 'Triangle rectangle isocèle' + (rightVertex ? (' en ' + rightVertex) : '');
      else if(right) nature = 'Triangle rectangle' + (rightVertex ? (' en ' + rightVertex) : '');
      else if(iso) nature = 'Triangle isocèle' + (apex ? (' en ' + apex) : '');
      else nature = 'Triangle quelconque';
      return { nature: nature, lengths: lengths };
    }

    function classifyQuad(P){
      var A = P[0], B = P[1], C = P[2], D = P[3];
      var AB = dist(A,B), BC = dist(B,C), CD = dist(C,D), DA = dist(D,A), AC = dist(A,C), BD = dist(B,D);
      var lengths = { AB:AB, BC:BC, CD:CD, DA:DA, AC:AC, BD:BD };
      var mAC = { x:(A.x+C.x)/2, y:(A.y+C.y)/2 }, mBD = { x:(B.x+D.x)/2, y:(B.y+D.y)/2 };
      var isParallelogram = approxEq(mAC.x, mBD.x) && approxEq(mAC.y, mBD.y);
      var nature;
      if(isParallelogram){
        var equalSides = approxEq(AB, BC);
        var equalDiag  = approxEq(AC, BD);
        var rightAngle = rightAngleAt(B, A, C);
        if(equalSides && (equalDiag || rightAngle)) nature = 'Carré';
        else if(equalDiag || rightAngle) nature = 'Rectangle';
        else if(equalSides) nature = 'Losange';
        else nature = 'Parallélogramme';
      } else {
        var abCD = parallelSeg(A,B,D,C), bcDA = parallelSeg(B,C,A,D);
        if(abCD || bcDA){
          var isoLegs = abCD ? approxEq(BC, DA) : approxEq(AB, CD);
          var hasRight = rightAngleAt(A,B,C) || rightAngleAt(B,C,D) || rightAngleAt(C,D,A) || rightAngleAt(D,A,B);
          nature = 'Trapèze' + (hasRight ? ' rectangle' : (isoLegs ? ' isocèle' : ''));
        } else nature = 'Quadrilatère quelconque';
      }
      return { nature: nature, lengths: lengths };
    }

    function buildGeoResult(op, res){
      var L = res.lengths;
      if(op === 'triangle_nature'){
        return res.nature + ' — longueurs : AB ≈ ' + rnd(L.AB) + ', BC ≈ ' + rnd(L.BC) + ', CA ≈ ' + rnd(L.CA) + '.';
      }
      return res.nature + ' — côtés : AB ≈ ' + rnd(L.AB) + ', BC ≈ ' + rnd(L.BC) + ', CD ≈ ' + rnd(L.CD) + ', DA ≈ ' + rnd(L.DA) +
             ' ; diagonales : AC ≈ ' + rnd(L.AC) + ', BD ≈ ' + rnd(L.BD) + '.';
    }

    async function runGeo(op){
      var pts = geoData();
      if(op === 'plot'){
        if(pts.length < 1){ stateEl.textContent = 'Saisissez au moins un point.'; return; }
        var r0 = plotGeo(pts);
        answerEl.innerHTML = ''; stepsEl.innerHTML = '';
        stateEl.textContent = r0.ok ? ('Figure tracée (' + pts.length + ' point' + (pts.length > 1 ? 's' : '') + ').')
                                    : "Certains affixes sont invalides — vérifiez l'écriture (ex : 1+2i).";
        return;
      }
      var need = (op === 'triangle_nature') ? 3 : 4;
      var label = (need === 3) ? 'triangle' : 'quadrilatère';
      if(pts.length !== need){ stateEl.textContent = 'Renseignez exactement ' + need + ' points pour un ' + label + '.'; return; }
      if(!ggb){ return; }

      var r = plotGeo(pts);
      if(!r.ok){ stateEl.textContent = "Impossible de lire les affixes — vérifiez l'écriture (ex : 1+2i)."; return; }
      var res = (need === 3) ? classifyTriangle(r.coords) : classifyQuad(r.coords);
      var casResult = buildGeoResult(op, res);

      answerEl.innerHTML = '<div class="ml-answer"><div class="lbl"><i class="bi bi-stars"></i> Résultat</div><div class="val">' + escapeHtml(res.nature) + '</div></div>';
      stepsEl.innerHTML = ''; stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';
      setGOpsEnabled(false);

      var expression = pts.map(function(p){ return 'z_' + p.name + ' = ' + p.affix; }).join(' ; ');
      try {
        var resp = await fetch(EXPLAIN_URL, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ domain:'complex', operation: op, expression: expression, casResult: casResult })
        });
        var data = await resp.json();
        if(data.ok){ showSteps(data); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){
        stateEl.textContent = 'Connexion impossible — réessayez.';
      } finally {
        setGOpsEnabled(true);
      }
    }

    gopsEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return;
      runGeo(btn.getAttribute('data-gop'));
    });
    renumberGeo();

    /* ============ LIMITES ============ */
    // Limite — now embedded in the Fonctions panel (uses fxInput as the function).
    var lfxInput    = fxInput;
    var fnLimitPanel = document.getElementById('fn-limit-panel');
    var lpointInput = document.getElementById('lpoint');
    var lopsEl      = document.getElementById('lops');
    var lPreviewEl  = document.getElementById('lPreview');
    var lsideEl     = document.getElementById('lside');
    var limObjs     = [];
    var limSide     = '';

    function setLOpsEnabled(on){ lopsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }

    // NB: no regex backslash escapes here — the EJS template literal would strip them.
    function infKind(p){
      var s = (p || '').trim().toLowerCase().split(' ').join('');
      if(s === '∞' || s === '+∞' || s === 'inf' || s === '+inf' || s === 'infinity' || s === '+infinity') return 1;
      if(s === '-∞' || s === '−∞' || s === '-inf' || s === '−inf' || s === '-infinity' || s === '−infinity') return -1;
      return 0;
    }
    function isInfPoint(p){ return infKind(p) !== 0; }
    function normalizePoint(p){
      var k = infKind(p);
      if(k === 1) return 'Infinity';
      if(k === -1) return '-Infinity';
      return (p || '').trim();
    }
    function isPlainNumber(s){ s = (s || '').trim(); if(s === '') return false; var n = Number(s); return isFinite(n); }
    function limitCAS(f, P, side){
      if(P === 'Infinity')  return 'Limit(' + f + ', Infinity)';
      if(P === '-Infinity') return 'Limit(' + f + ', -Infinity)';
      if(side === '+') return 'LimitAbove(' + f + ', ' + P + ')';
      if(side === '-') return 'LimitBelow(' + f + ', ' + P + ')';
      return 'Limit(' + f + ', ' + P + ')';
    }

    function limitLatex(){
      var f = (lfxInput.value || '').trim();
      var fTex = null; try { fTex = toLatex(f); } catch(e){ return null; }
      if(fTex == null) return null;
      var P = normalizePoint(lpointInput.value);
      var pTex;
      if(P === 'Infinity') pTex = '+' + BS + 'infty';
      else if(P === '-Infinity') pTex = '-' + BS + 'infty';
      else { try { pTex = toLatex(P); } catch(e){ pTex = P; } }
      var inf = (P === 'Infinity' || P === '-Infinity');
      var sup = (!inf && limSide === '+') ? '^+' : (!inf && limSide === '-') ? '^-' : '';
      return BS + 'lim_{x ' + BS + 'to ' + pTex + sup + '} ' + fTex;
    }
    function updateLimPreview(){
      var raw = (lfxInput.value || '').trim();
      if(!raw){ lPreviewEl.className='ml-preview is-empty'; lPreviewEl.textContent='Aperçu de la limite…'; return; }
      var tex = null; try { tex = limitLatex(); } catch(e){ tex = null; }
      if(tex == null){ lPreviewEl.className='ml-preview is-empty'; lPreviewEl.textContent='…en cours de saisie'; return; }
      try { katex.render(tex, lPreviewEl, { throwOnError:true, displayMode:false }); lPreviewEl.className='ml-preview'; }
      catch(e){ lPreviewEl.className='ml-preview is-empty'; lPreviewEl.textContent='…en cours de saisie'; }
    }

    function setLimSide(s){
      limSide = s;
      lsideEl.querySelectorAll('.ml-sidebtn').forEach(function(b){ b.classList.toggle('is-active', b.getAttribute('data-side') === s); });
    }
    function refreshSideButtons(){
      var inf = isInfPoint(lpointInput.value);
      lsideEl.querySelectorAll('.ml-sidebtn').forEach(function(b){ var s = b.getAttribute('data-side'); if(s === '+' || s === '-') b.disabled = inf; });
      if(inf && limSide !== '') setLimSide('');
    }
    lsideEl.addEventListener('click', function(ev){
      var b = ev.target.closest('.ml-sidebtn'); if(!b || b.disabled) return;
      setLimSide(b.getAttribute('data-side')); updateLimPreview();
    });

    lpointInput.addEventListener('keydown', function(ev){ if(ev.key === 'Enter'){ ev.preventDefault(); runLimit(); } });
    fxInput.addEventListener('input', updateLimPreview);
    lpointInput.addEventListener('input', function(){ refreshSideButtons(); updateLimPreview(); });
    Array.prototype.slice.call(fnLimitPanel.querySelectorAll('[data-lpoint]')).forEach(function(b){
      b.addEventListener('click', function(){ lpointInput.value = b.getAttribute('data-lpoint'); refreshSideButtons(); updateLimPreview(); });
    });

    function defLim(name, fullCmd){ try { ggb.evalCommand(fullCmd); limObjs.push(name); } catch(e){} }
    function clearLimPlot(){ limObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} }); limObjs = []; }

    async function runLimit(){
      var f = (lfxInput.value || '').trim();
      if(!f){ stateEl.textContent = 'Saisissez une fonction.'; return; }
      var pRaw = (lpointInput.value || '').trim();
      if(!pRaw){ stateEl.textContent = 'Indiquez la valeur vers laquelle x tend.'; lpointInput.focus(); return; }
      if(!ggb) return;
      var P = normalizePoint(pRaw);
      var inf = (P === 'Infinity' || P === '-Infinity');
      var side = inf ? '' : limSide;

      clearLimPlot();
      plot(f);
      if(!inf){ defLim('lpt', 'lpt: x = ' + P); colour('lpt', 255, 184, 0); }

      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul en cours…';
      setLOpsEnabled(false);

      var casResult = '';
      try { casResult = ggb.evalCommandCAS(limitCAS(f, P, side)); } catch(e){ casResult = ''; }
      if(!casResult){ stateEl.textContent = 'Impossible de calculer — vérifiez la fonction et le point.'; setLOpsEnabled(true); return; }

      if(isPlainNumber(casResult)){ defLim('lhz', 'lhz: y = ' + casResult); colour('lhz', 93, 6, 186); }

      answerEl.innerHTML = '<div class="ml-answer"><div class="lbl"><i class="bi bi-stars"></i> Résultat</div><div class="val">' + escapeHtml(casResult) + '</div></div>';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';

      var displayPoint = inf ? (P === 'Infinity' ? '+∞' : '-∞') : pRaw;
      try {
        var resp = await fetch(EXPLAIN_URL, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ function: f, operation: 'limit', casResult: casResult, point: displayPoint, side: side })
        });
        var data = await resp.json();
        if(data.ok){ showSteps(data); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){
        stateEl.textContent = 'Connexion impossible — réessayez.';
      } finally {
        setLOpsEnabled(true);
      }
    }

    lopsEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return;
      runLimit();
    });
    setLimSide(''); refreshSideButtons();

    /* ============ INTÉGRALES ============ */
    var modeIntegral = document.getElementById('mode-integral');
    var ifxInput   = document.getElementById('ifx');
    var iaInput    = document.getElementById('ia');
    var ibInput    = document.getElementById('ib');
    var ikeysEl    = document.getElementById('ikeys');
    var iopsEl     = document.getElementById('iops');
    var iPreviewEl = document.getElementById('iPreview');
    var isideEl    = document.getElementById('iside');
    var iboundsEl  = document.getElementById('ibounds');
    var iippNote   = document.getElementById('iipp-note');
    var intObjs    = [];
    var intType    = 'indef';
    var activeInt  = ifxInput;

    function setIOpsEnabled(on){ iopsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }
    function defInt(name, fullCmd){ try { ggb.evalCommand(fullCmd); intObjs.push(name); } catch(e){} }
    function clearIntPlot(){ intObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} }); intObjs = []; }

    function integralLatex(){
      var f = (ifxInput.value || '').trim();
      var fTex = null; try { fTex = toLatex(f); } catch(e){ return null; }
      if(fTex == null) return null;
      var ippDef = intType === 'ipp' && ((iaInput.value || '').trim() || (ibInput.value || '').trim());
      if(intType === 'def' || ippDef){
        var a = (iaInput.value || '').trim() || 'a', b = (ibInput.value || '').trim() || 'b';
        var aTex, bTex;
        try { aTex = toLatex(a); } catch(e){ aTex = a; }
        try { bTex = toLatex(b); } catch(e){ bTex = b; }
        return BS + 'int_{' + aTex + '}^{' + bTex + '} ' + fTex + BS + ',dx';
      }
      return BS + 'int ' + fTex + BS + ',dx';
    }
    function updateIntPreview(){
      var raw = (ifxInput.value || '').trim();
      if(!raw){ iPreviewEl.className = 'ml-preview is-empty'; iPreviewEl.textContent = 'Aperçu de l’intégrale…'; return; }
      var tex = null; try { tex = integralLatex(); } catch(e){ tex = null; }
      if(tex == null){ iPreviewEl.className = 'ml-preview is-empty'; iPreviewEl.textContent = '…en cours de saisie'; return; }
      try { katex.render(tex, iPreviewEl, { throwOnError:true, displayMode:false }); iPreviewEl.className = 'ml-preview'; }
      catch(e){ iPreviewEl.className = 'ml-preview is-empty'; iPreviewEl.textContent = '…en cours de saisie'; }
    }

    function setIType(t){
      intType = t;
      isideEl.querySelectorAll('.ml-sidebtn').forEach(function(b){ b.classList.toggle('is-active', b.getAttribute('data-itype') === t); });
      iboundsEl.hidden = (t !== 'def' && t !== 'ipp');
      iippNote.hidden = (t !== 'ipp');
      iaInput.placeholder = t === 'ipp' ? 'vide = primitive' : 'borne inf.'; ibInput.placeholder = t === 'ipp' ? 'vide = primitive' : 'borne sup.';
      if(t === 'ipp' && ['x^2', 'x', ''].indexOf((ifxInput.value || '').trim()) >= 0){ ifxInput.value = 'x*exp(x)'; }
      updateIntPreview();
    }
    isideEl.addEventListener('click', function(ev){ var b = ev.target.closest('.ml-sidebtn'); if(!b) return; setIType(b.getAttribute('data-itype')); });

    [ifxInput, iaInput, ibInput].forEach(function(inp){
      inp.addEventListener('focus', function(){ activeInt = inp; });
      inp.addEventListener('input', updateIntPreview);
      inp.addEventListener('keydown', function(ev){ if(ev.key === 'Enter'){ ev.preventDefault(); runIntegral(); } });
    });

    ikeysEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-key'); if(!btn) return;
      var inp = activeInt || ifxInput;
      var act = btn.getAttribute('data-act');
      if(act === 'clear'){ inp.value = ''; inp.focus(); }
      else if(act === 'back'){
        var v = inp.value, s = inp.selectionStart, e = inp.selectionEnd;
        if(s == null){ inp.value = v.slice(0,-1); }
        else if(s !== e){ inp.value = v.slice(0,s) + v.slice(e); inp.setSelectionRange(s,s); }
        else if(s > 0){ inp.value = v.slice(0,s-1) + v.slice(s); inp.setSelectionRange(s-1,s-1); }
        inp.focus();
      }
      else { insertInto(inp, btn.getAttribute('data-ins')); }
      updateIntPreview();
    });

    function integralCAS(f){
      if(intType === 'def'){
        var a = (iaInput.value || '').trim(), b = (ibInput.value || '').trim();
