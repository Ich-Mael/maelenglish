      perspective: 'G',
      appletOnLoad: function(api){ ggb = api; try { ggb.setErrorDialogsActive(false); } catch(e){} setOpsEnabled(true); setCOpsEnabled(true); setGOpsEnabled(true); setLOpsEnabled(true); setIOpsEnabled(true); setSuiteOpsEnabled(true); setProbaOpsEnabled(true); setStatsOpsEnabled(true); setDeqOpsEnabled(true); setPwOpsEnabled(true); setE1OpsEnabled(true); setSysOpsEnabled(true); setBaryOpsEnabled(true); setZfOpsEnabled(true); if(eqSolveBtn) eqSolveBtn.disabled = false; setEqStepsEnabled(true); fitGraph(); plot((fxInput.value||'').trim()); setTimeout(fitGraph, 400); }
    }, true);
    applet.inject('ggb');
    updatePreview();
    updateZPreview();
    updateGeoPreview();
    updateLimPreview();
    updateIntPreview();
    updateEqPreview();
  })();
