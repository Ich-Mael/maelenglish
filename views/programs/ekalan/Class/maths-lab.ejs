            <span class="ml-ipp-ex"><button type="button" class="ml-key" data-ippex="x*exp(x)|0|1">x·eˣ sur [0 ; 1]</button><button type="button" class="ml-key" data-ippex="x*sin(x)|0|pi">x·sin x sur [0 ; π]</button><button type="button" class="ml-key" data-ippex="ln(x)|1|e">ln x sur [1 ; e]</button><button type="button" class="ml-key" data-ippex="x^2*exp(-x)||">x²·e⁻ˣ</button><button type="button" class="ml-key" data-ippex="exp(x)*cos(x)||">eˣ·cos x</button></span>
