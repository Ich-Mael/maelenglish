            var tex = res.length ? res.map(function(z, j){ var inner = vcTermsTex(z.terms); var simple = z.terms.length === 1 && fVal(z.terms[0].k) === 1; return vcCoef(z.k, simple ? inner : BS + 'left(' + inner + BS + 'right)', j === 0); }).join('') : BS + 'vec{0}';
