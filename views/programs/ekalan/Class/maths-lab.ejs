          var len = 0.6;
          if(isFinite(r.dm.v)) seg('pwTg' + j, r.x0 - len, r.F - len * r.dm.v, r.x0, r.F); else seg('pwTg' + j, r.x0, r.F, r.x0, r.F + (r.dm.v > 0 ? -1.5 : 1.5));
