    })();

    /* ============ FONCTIONS DÉFINIES PAR MORCEAUX (continuité, dérivabilité, paramètres) ============ */
    // Everything is computed in pure JS: expressions are parsed with dxTok/dxParse, limits are taken
    // numerically (one-sided, with Richardson extrapolation) and snapped to exact values when possible.
    var modePw     = document.getElementById('mode-piecewise');
    var pwCountEl  = document.getElementById('pw-count');
    var pwOpsEl    = document.getElementById('pw-ops');
    var pwPrevEl   = document.getElementById('pw-preview');
    var pwParamsEl = document.getElementById('pw-params');
    var pwPlistEl  = document.getElementById('pw-plist');
    var pwGoalEl   = document.getElementById('pw-goal');
    var pwParamBtn = document.getElementById('pw-op-params');
    var pwThirdEl  = document.getElementById('pw-third');
    var pwExEl     = document.getElementById('pw-ex');
    var pwE  = [document.getElementById('pw-e1'), document.getElementById('pw-e2'), document.getElementById('pw-e3')];
    var pwC  = [document.getElementById('pw-c1'), document.getElementById('pw-c2'), document.getElementById('pw-c3')];
    var pwX  = [document.getElementById('pw-x1'), document.getElementById('pw-x2')];
    var pwAt = [document.getElementById('pw-at1'), document.getElementById('pw-at2')];
    var pwV  = [document.getElementById('pw-v1'), document.getElementById('pw-v2')];
    var pwN = 2;
    var PW_FN = ['sqrt', 'exp', 'ln', 'log', 'abs', 'sin', 'cos', 'tan'];
    var PW_PARAMS = ['a', 'b', 'k', 'm'];
    var pwObjs = [];

    function setPwOpsEnabled(on){ pwOpsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }
    function clearPwPlot(){ pwObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} }); pwObjs = []; }

    // Tokens with multi-letter names split into single letters ("ax" → a·x) unless they are functions.
    function pwTokens(s){
      s = String(s == null ? '' : s).split(String.fromCharCode(0x2212)).join('-').split(String.fromCharCode(0xB2)).join('^2').split(String.fromCharCode(0xB3)).join('^3');
      var t = dxTok(s); if(!t) return null;
      var out = [];
      for(var i = 0; i < t.length; i++){
        var tk = t[i];
        var isCall = t[i + 1] && t[i + 1].t === '(';
        if(tk.t === 'name' && tk.v.length > 1 && !isCall && tk.v !== 'pi'){
          for(var j = 0; j < tk.v.length; j++){
            var ch = tk.v.charAt(j);
            if(ch >= '0' && ch <= '9') out.push({ t:'num', v:Number(ch) }); else out.push({ t:'name', v:ch, split:true });
          }
        } else out.push(tk);
      }
      return out;
    }
    // Rebuild a string from tokens. sep = '*' for GeoGebra, ' ' for display; env substitutes parameter values.
    function pwStr(toks, sep, env){
      var s = '', prev = null;
      function isNumPiece(tk){ return tk.t === 'num' || (env && tk.t === 'name' && PW_PARAMS.indexOf(tk.v) >= 0 && env[tk.v] !== undefined); }
      toks.forEach(function(tk){
        var piece;
        if(tk.t === 'num') piece = String(tk.v);
        else if(tk.t === 'name'){
          if(env && env[tk.v] !== undefined && PW_PARAMS.indexOf(tk.v) >= 0){
            var v = env[tk.v]; piece = (v < 0) ? '(' + pwNumStr(v) + ')' : pwNumStr(v);
          } else piece = tk.v;
        } else piece = tk.t;
        var needSep = prev && ((prev.t === 'name' || prev.t === 'num' || prev.t === ')') && (tk.t === 'name' || tk.t === 'num' || tk.t === '('))
          && !(prev.t === 'name' && tk.t === '(' && PW_FN.indexOf(prev.v) >= 0);
        if(needSep) s += (sep === '*' || (isNumPiece(prev) && isNumPiece(tk))) ? '*' : sep;
        s += piece; prev = tk;
      });
      return s;
    }
    function pwNumStr(v){ var sn = pwSnap(v); return sn.plain; }
    function pwCollect(n, acc){
      if(!n) return acc;
      if(n.t === 'const' && acc.indexOf(n.name) < 0) acc.push(n.name);
      ['a', 'l', 'r'].forEach(function(k){ if(n[k] && typeof n[k] === 'object') pwCollect(n[k], acc); });
      return acc;
    }
    function pwCompile(src, needX){
      src = (src || '').trim(); if(!src) return { err: 'vide' };
      var tk = pwTokens(src); if(!tk || !tk.length) return { err: 'syntaxe' };
      var ast = null; try { ast = dxParse(tk); } catch(e){ ast = null; }
      if(!ast) return { err: 'syntaxe' };
      var names = pwCollect(ast, []);
      var bad = names.filter(function(nm){ return PW_PARAMS.indexOf(nm) < 0; });
      if(bad.length) return { err: 'inconnu', bad: bad };
      var dAst = null; try { dAst = dxSimp(dxSimp(dxDiff(ast))); } catch(e){ dAst = null; }
      return { src: src, toks: tk, ast: ast, dAst: dAst, params: names };
    }
    function pwEval(n, x, env){
      if(!n) return NaN;
      switch(n.t){
        case 'num': return n.v;
        case 'var': return x;
        case 'const': return (env && env[n.name] !== undefined) ? env[n.name] : NaN;
        case 'neg': return -pwEval(n.a, x, env);
        case '+': return pwEval(n.l, x, env) + pwEval(n.r, x, env);
        case '-': return pwEval(n.l, x, env) - pwEval(n.r, x, env);
        case '*': return pwEval(n.l, x, env) * pwEval(n.r, x, env);
        case '/': return pwEval(n.l, x, env) / pwEval(n.r, x, env);
        case '^': {
          var b = pwEval(n.l, x, env), e = pwEval(n.r, x, env);
          if(b < 0 && Math.abs(e - Math.round(e)) > 1e-12) return NaN;
          return Math.pow(b, e);
        }
        case 'fn': {
          var a = pwEval(n.a, x, env);
          switch(n.name){
            case 'sqrt': return a < 0 ? NaN : Math.sqrt(a);
            case 'exp': return Math.exp(a);
            case 'ln': case 'log': return a <= 0 ? NaN : Math.log(a);
            case 'abs': return Math.abs(a);
            case 'sin': return Math.sin(a);
            case 'cos': return Math.cos(a);
            case 'tan': return Math.tan(a);
          }
          return NaN;
        }
      }
      return NaN;
    }

    // One-sided limit of g at x0 (side −1 = left, +1 = right). Returns { ok, v, inf }.
    // Samples at h = 2^-k; Aitken's Δ² extrapolation handles any power-law convergence
    // (h, √h, h²…), e.g. √x → 0 as x → 0⁺. Divergence is tested before extrapolating.
    function pwLimit(g, x0, side){
      var vals = [];
      for(var k = 4; k <= 22; k++){ var h = Math.pow(2, -k); vals.push(g(x0 + side * h)); }
      var fin = vals.filter(isFinite), n = vals.length;
      if(fin.length < n - 2 || !isFinite(vals[n - 1]) || !isFinite(vals[n - 2]) || !isFinite(vals[n - 3])) return { ok: false };
      var v1 = vals[n - 3], v2 = vals[n - 2], v3 = vals[n - 1];
      if(Math.abs(v3 - v2) < 1e-10 * (1 + Math.abs(v3))) return { ok: true, v: v3, inf: 0 };
      var a8 = Math.abs(vals[n - 9]), aN = Math.abs(v3);
      if(aN > 50 && aN > 3 * a8) return { ok: true, v: v3 > 0 ? Infinity : -Infinity, inf: v3 > 0 ? 1 : -1 };
      function aitken(p, q, r){ var d1 = q - p, d2 = r - q, den = d2 - d1; if(Math.abs(den) < 1e-300) return NaN; return r - d2 * d2 / den; }
      var A1 = aitken(vals[n - 5], vals[n - 4], vals[n - 3]), A2 = aitken(vals[n - 4], vals[n - 3], v2), A3 = aitken(v1, v2, v3);
      var shrinking = Math.abs(v3 - v2) < Math.abs(v2 - v1);
      if(shrinking && isFinite(A3) && isFinite(A2) && Math.abs(A3 - A2) < 1e-6 * (1 + Math.abs(A3)) && Math.abs(A2 - A1) < 1e-4 * (1 + Math.abs(A2))) return { ok: true, v: A3, inf: 0 };
      if(shrinking && Math.abs(v3 - v2) < 1e-7 * (1 + Math.abs(v3))) return { ok: true, v: v3, inf: 0 };
      var tail = vals.slice(n - 6), tmax = Math.max.apply(null, tail), tmin = Math.min.apply(null, tail);
      if(tmax - tmin < 1e-5 * (1 + Math.abs(tmax))) return { ok: true, v: (tmax + tmin) / 2, inf: 0 }; // squeezed (e.g. x·sin(1/x))
      var mono = true;
      for(var i = n - 8; i < n; i++){ if(Math.abs(vals[i]) < Math.abs(vals[i - 1]) - 1e-12) { mono = false; break; } }
      if(mono && Math.abs(v3 - vals[n - 9]) > 1) return { ok: true, v: v3 > 0 ? Infinity : -Infinity, inf: v3 > 0 ? 1 : -1 };
      return { ok: false };
    }
    // Snap to an exact-looking value: integer, fraction p/q (q ≤ 12), ±√(p/q); else 4 decimals.
    function pwSnap(v){
      if(v === Infinity) return { tex: '+' + BS + 'infty', plain: '+inf', exact: true };
      if(v === -Infinity) return { tex: '-' + BS + 'infty', plain: '-inf', exact: true };
      if(!isFinite(v)) return { tex: '?', plain: '?', exact: false };
      var tol = 1e-6 * (1 + Math.abs(v));
      for(var q = 1; q <= 12; q++){
        var p = Math.round(v * q);
        if(Math.abs(p / q - v) < tol){
          var g = igcd(p, q) || 1, pp = p / g, qq = q / g;
          if(qq === 1) return { tex: String(pp), plain: String(pp), exact: true, num: pp };
          return { tex: (pp < 0 ? '-' : '') + BS + 'frac{' + Math.abs(pp) + '}{' + qq + '}', plain: pp + '/' + qq, exact: true, num: pp / qq };
        }
      }
      var v2 = v * v;
      for(var q2 = 1; q2 <= 12; q2++){
        var p2 = Math.round(v2 * q2);
        if(p2 > 0 && Math.abs(p2 / q2 - v2) < 1e-6 * (1 + v2)){
          var sg = v < 0 ? '-' : '';
          var g2 = igcd(p2, q2) || 1, a2 = p2 / g2, b2 = q2 / g2;
          var inner = b2 === 1 ? String(a2) : BS + 'frac{' + a2 + '}{' + b2 + '}';
          return { tex: sg + BS + 'sqrt{' + inner + '}', plain: sg + 'sqrt(' + (b2 === 1 ? a2 : a2 + '/' + b2) + ')', exact: true };
        }
      }
      var r = Math.round(v * 10000) / 10000;
      return { tex: BS + 'approx ' + r, plain: '~' + r, exact: false, num: r };
    }
    function pwTexNum(v){ return pwSnap(v).tex.split(BS + 'approx ').join(''); }

    function pwExprTex(c, env){ try { return toLatex(pwStr(c.toks, ' ', env)); } catch(e){ return pwStr(c.toks, ' ', env); } }
    // Read the form. Returns { err } or the definition object.
    function pwRead(){
      var pieces = [], juncs = [], params = [];
      for(var i = 0; i < pwN; i++){
        var c = pwCompile(pwE[i].value);
        if(c.err === 'vide') return { err: 'Intervalle ' + (i + 1) + ' : expression vide.' };
        if(c.err === 'inconnu') return { err: 'Intervalle ' + (i + 1) + ' : lettre inconnue « ' + c.bad.join(', ') + ' » (paramètres autorisés : a, b, k, m).' };
        if(c.err) return { err: 'Intervalle ' + (i + 1) + ' : expression invalide.' };
        pieces.push(c); c.params.forEach(function(p){ if(params.indexOf(p) < 0) params.push(p); });
      }
      for(var j = 0; j < pwN - 1; j++){
        var xs = (pwX[j].value || '').trim(), xc = pwCompile(xs);
        var x0 = xc.err ? NaN : pwEval(xc.ast, 0, {});
        if(!isFinite(x0)) return { err: 'x' + (j === 0 ? '₁' : '₂') + ' doit être un nombre.' };
        var at = pwAt[j].value, vc = null;
        if(at === 'V'){
          vc = pwCompile(pwV[j].value);
          if(vc.err === 'inconnu') return { err: 'f(x' + (j === 0 ? '₁' : '₂') + ') : lettre inconnue (paramètres autorisés : a, b, k, m).' };
          if(vc.err) return { err: 'Indiquez la valeur de f(x' + (j === 0 ? '₁' : '₂') + ').' };
          vc.params.forEach(function(p){ if(params.indexOf(p) < 0) params.push(p); });
        }
        juncs.push({ x0: x0, xs: xs, at: at, vc: vc });
      }
      if(pwN === 3 && !(juncs[0].x0 < juncs[1].x0)) return { err: 'Il faut x₁ < x₂.' };
      params.sort();
      return { pieces: pieces, juncs: juncs, params: params };
    }

    function pwCondTex(i, def){
      var J = def.juncs, BSl = BS + 'leq ', BSg = BS + 'geq ';
      function xs(j){ return pwTexNum(J[j].x0); }
      if(def.pieces.length === 2){
        if(i === 0) return 'x ' + (J[0].at === 'L' ? BSl : '< ') + xs(0);
        return 'x ' + (J[0].at === 'R' ? BSg : '> ') + xs(0);
      }
      if(i === 0) return 'x ' + (J[0].at === 'L' ? BSl : '< ') + xs(0);
      if(i === 1) return xs(0) + (J[0].at === 'R' ? ' ' + BSl : ' < ') + 'x' + (J[1].at === 'L' ? ' ' + BSl : ' < ') + xs(1);
      return 'x ' + (J[1].at === 'R' ? BSg : '> ') + xs(1);
    }
    function pwCondTxt(i){
      var at1 = pwAt[0].value, at2 = pwAt[1].value;
      if(pwN === 2){ return i === 0 ? (at1 === 'L' ? 'si x ≤ x₁' : 'si x < x₁') : (at1 === 'R' ? 'si x ≥ x₁' : 'si x > x₁'); }
      if(i === 0) return at1 === 'L' ? 'si x ≤ x₁' : 'si x < x₁';
      if(i === 1) return 'si x₁ ' + (at1 === 'R' ? '≤' : '<') + ' x ' + (at2 === 'L' ? '≤' : '<') + ' x₂';
      return at2 === 'R' ? 'si x ≥ x₂' : 'si x > x₂';
    }
    function pwDefTex(def, env){
      var rows = [], sameTwo = def.pieces.length === 2 && def.juncs[0].at === 'V' && pwStr(def.pieces[0].toks, ' ') === pwStr(def.pieces[1].toks, ' ');
      if(sameTwo){
        rows.push(pwExprTex(def.pieces[0], env) + ' & ' + BS + 'text{si } x ' + BS + 'neq ' + pwTexNum(def.juncs[0].x0));
      } else {
        def.pieces.forEach(function(c, i){ rows.push(pwExprTex(c, env) + ' & ' + BS + 'text{si } ' + pwCondTex(i, def)); });
      }
      def.juncs.forEach(function(J){ if(J.at === 'V') rows.push(pwExprTex(J.vc, env) + ' & ' + BS + 'text{si } x = ' + pwTexNum(J.x0)); });
      return 'f(x) = ' + BS + 'begin{cases} ' + rows.join(' ' + BS + BS + ' ') + ' ' + BS + 'end{cases}';
    }

    function updatePwPreview(){
      pwC.forEach(function(el, i){ if(el) el.textContent = pwCondTxt(i); });
      pwV.forEach(function(el, j){ el.hidden = (pwAt[j].value !== 'V'); });
      var def = pwRead();
      if(def.err){ pwParamsEl.hidden = true; pwParamBtn.hidden = true; pwPrevEl.className = 'ml-preview is-empty'; pwPrevEl.textContent = def.err; return; }
      var hasP = def.params.length > 0;
      pwParamsEl.hidden = !hasP; pwParamBtn.hidden = !hasP;
      if(hasP) pwPlistEl.textContent = def.params.join(', ');
      try { renderKatex(pwPrevEl, pwDefTex(def, null)); pwPrevEl.className = 'ml-preview'; }
      catch(e){ pwPrevEl.className = 'ml-preview is-empty'; pwPrevEl.textContent = 'Aperçu indisponible.'; }
    }

    function setPwCount(n){
      pwN = n;
      pwCountEl.querySelectorAll('.ml-sidebtn').forEach(function(b){ b.classList.toggle('is-active', Number(b.getAttribute('data-pwn')) === n); });
      pwThirdEl.hidden = (n !== 3);
      updatePwPreview();
    }
    pwCountEl.addEventListener('click', function(ev){ var b = ev.target.closest('.ml-sidebtn'); if(b) setPwCount(Number(b.getAttribute('data-pwn'))); });
    pwE.concat(pwX, pwV).forEach(function(inp){ if(inp) inp.addEventListener('input', updatePwPreview); });
    pwAt.forEach(function(sel){ sel.addEventListener('change', updatePwPreview); });

    var PW_EXAMPLES = {
      1: { n: 2, e: ['ax^2+1', 'bx+3'], x: ['1'], at: ['R'], v: [''], goal: 'CD' },
      2: { n: 2, e: ['(x^2-1)/(x-1)', '(x^2-1)/(x-1)'], x: ['1'], at: ['V'], v: ['a'], goal: 'C' },
      3: { n: 2, e: ['-2x+1', 'x+1'], x: ['0'], at: ['R'], v: [''], goal: 'CD' },
      4: { n: 2, e: ['-x^2', 'sqrt(x)'], x: ['0'], at: ['R'], v: [''], goal: 'CD' },
      5: { n: 3, e: ['x+2', 'x^2', '2x-1'], x: ['-1', '1'], at: ['R', 'L'], v: ['', ''], goal: 'CD' }
    };
    pwExEl.addEventListener('click', function(ev){
      var b = ev.target.closest('[data-pwex]'); if(!b) return;
      var ex = PW_EXAMPLES[b.getAttribute('data-pwex')]; if(!ex) return;
      ex.e.forEach(function(v, i){ pwE[i].value = v; });
      ex.x.forEach(function(v, j){ pwX[j].value = v; });
      ex.at.forEach(function(v, j){ pwAt[j].value = v; });
      ex.v.forEach(function(v, j){ pwV[j].value = v; });
      pwGoalEl.value = ex.goal;
      answerEl.innerHTML = ''; stepsEl.innerHTML = ''; stateEl.textContent = '';
      setPwCount(ex.n);
    });

    // ---- core analysis at one junction (concrete env, all parameters known) ----
    function pwJunction(def, j, env){
      var J = def.juncs[j], L = def.pieces[j], R = def.pieces[j + 1], x0 = J.x0;
      var gL = function(x){ return pwEval(L.ast, x, env); }, gR = function(x){ return pwEval(R.ast, x, env); };
      var F = (J.at === 'L') ? gL(x0) : (J.at === 'R') ? gR(x0) : pwEval(J.vc.ast, 0, env);
      var Lm = pwLimit(gL, x0, -1), Lp = pwLimit(gR, x0, 1);
      function near(a, b){ return isFinite(a) && isFinite(b) && Math.abs(a - b) < 1e-6 * (1 + Math.abs(a) + Math.abs(b)); }
      var contL = Lm.ok && near(Lm.v, F), contR = Lp.ok && near(Lp.v, F);
      var dm = null, dp = null;
      if(contL) dm = pwLimit(function(x){ return (gL(x) - F) / (x - x0); }, x0, -1);
      if(contR) dp = pwLimit(function(x){ return (gR(x) - F) / (x - x0); }, x0, 1);
      var cont = isFinite(F) && contL && contR;
      var kind = 'none'; // 'deriv' | 'angle' | 'vert' | 'none'
      if(cont && dm && dp && dm.ok && dp.ok){
        if(isFinite(dm.v) && isFinite(dp.v)) kind = near(dm.v, dp.v) ? 'deriv' : 'angle';
        else kind = 'vert';
      }
      return { J: J, L: L, R: R, x0: x0, F: F, Lm: Lm, Lp: Lp, contL: contL, contR: contR, cont: cont, dm: dm, dp: dp, kind: kind };
    }

    // ---- parameters: equations as functions of the parameter vector ----
    function pwEquations(def, goal){
      var P = def.params, eqs = [];
      function envOf(vec){ var e = {}; P.forEach(function(p, i){ e[p] = vec[i]; }); return e; }
      def.juncs.forEach(function(J, j){
        var L = def.pieces[j], R = def.pieces[j + 1], x0 = J.x0;
        var lim = function(c, side){ return function(vec){ var r = pwLimit(function(x){ return pwEval(c.ast, x, envOf(vec)); }, x0, side); return r.ok ? r.v : NaN; }; };
        var dlim = function(c, side){ return function(vec){ if(!c.dAst) return NaN; var r = pwLimit(function(x){ return pwEval(c.dAst, x, envOf(vec)); }, x0, side); return r.ok ? r.v : NaN; }; };
        var Fv = function(vec){ return J.at === 'V' ? pwEval(J.vc.ast, 0, envOf(vec)) : NaN; };
        var lm = lim(L, -1), lp = lim(R, 1);
        if(J.at === 'L') eqs.push({ j: j, kind: 'cont', lhs: lp, rhs: lm, lhsLbl: 'lim+', rhsLbl: 'F' });
        else if(J.at === 'R') eqs.push({ j: j, kind: 'cont', lhs: lm, rhs: lp, lhsLbl: 'lim-', rhsLbl: 'F' });
        else { eqs.push({ j: j, kind: 'cont', lhs: lm, rhs: Fv, lhsLbl: 'lim-', rhsLbl: 'F' }); eqs.push({ j: j, kind: 'cont', lhs: lp, rhs: Fv, lhsLbl: 'lim+', rhsLbl: 'F' }); }
        if(goal === 'CD') eqs.push({ j: j, kind: 'deriv', lhs: dlim(L, -1), rhs: dlim(R, 1), lhsLbl: "f'g", rhsLbl: "f'd" });
      });
      return eqs;
    }
    function pwAffine(fn, n){
      var z = []; for(var i = 0; i < n; i++) z.push(0);
      var c0 = fn(z); if(!isFinite(c0)) return null;
      var cs = [];
      for(var k = 0; k < n; k++){ var e = z.slice(); e[k] = 1; var v = fn(e); if(!isFinite(v)) return null; cs.push(v - c0); }
      var t = z.map(function(_, i){ return 0.37 + 0.91 * i; }), pred = c0;
      cs.forEach(function(c, i){ pred += c * t[i]; });
      var got = fn(t);
      if(!isFinite(got) || Math.abs(got - pred) > 1e-6 * (1 + Math.abs(got))) return null;
      return { c0: c0, c: cs };
    }
    function pwAffTex(aff, P){
      var out = '', first = true;
      aff.c.forEach(function(c, i){
        if(Math.abs(c) < 1e-9) return;
        var sn = pwSnap(Math.abs(c)), co = (sn.plain === '1') ? '' : sn.tex.split(BS + 'approx ').join('');
        out += (first ? (c < 0 ? '-' : '') : (c < 0 ? ' - ' : ' + ')) + co + P[i]; first = false;
      });
      if(Math.abs(aff.c0) > 1e-9 || first){
        var s0 = pwSnap(Math.abs(aff.c0)).tex.split(BS + 'approx ').join('');
        out += first ? ((aff.c0 < 0 ? '-' : '') + s0) : ((aff.c0 < 0 ? ' - ' : ' + ') + s0);
      }
      return out;
    }
    // Solve the parameter system. Returns { ok, env, rows:[{tex}], sys, msg }.
    function pwSolveParams(def, goal){
      var P = def.params, n = P.length, eqs = pwEquations(def, goal);
      var rows = [], lin = [], allAff = true;
      eqs.forEach(function(e){
        var A = pwAffine(e.lhs, n), B = pwAffine(e.rhs, n);
        if(!A || !B){ allAff = false; return; }
        var D = { c0: A.c0 - B.c0, c: A.c.map(function(c, i){ return c - B.c[i]; }) };
        e.A = A; e.B = B; e.D = D; lin.push(e);
      });
      if(!allAff) return { ok: false, msg: 'Les conditions ne sont pas affines en ' + P.join(', ') + ' : résolution non prise en charge ici.' };
      // keep informative equations
      var useful = lin.filter(function(e){ return e.D.c.some(function(c){ return Math.abs(c) > 1e-9; }); });
      var trivialBad = lin.filter(function(e){ return !e.D.c.some(function(c){ return Math.abs(c) > 1e-9; }) && Math.abs(e.D.c0) > 1e-7; });
      if(trivialBad.length) return { ok: false, eqs: lin, msg: 'Une condition ne dépend d’aucun paramètre et n’est pas vérifiée : aucune valeur ne convient.' };
      var sol = null;
      if(n === 1){
        if(!useful.length) return { ok: false, eqs: lin, msg: 'Aucune condition ne permet de déterminer ' + P[0] + '.' };
        var e0 = useful[0]; sol = [-e0.D.c0 / e0.D.c[0]];
      } else if(n === 2){
        for(var i = 0; i < useful.length && !sol; i++) for(var k = i + 1; k < useful.length && !sol; k++){
          var a1 = useful[i].D.c[0], b1 = useful[i].D.c[1], c1 = -useful[i].D.c0;
          var a2 = useful[k].D.c[0], b2 = useful[k].D.c[1], c2 = -useful[k].D.c0;
          var det = a1 * b2 - a2 * b1;
          if(Math.abs(det) > 1e-9) sol = [(c1 * b2 - c2 * b1) / det, (a1 * c2 - a2 * c1) / det];
        }
        if(!sol) return { ok: false, eqs: lin, msg: 'Le système n’a pas une solution unique (il manque une condition indépendante).' };
      } else return { ok: false, eqs: lin, msg: 'Au plus deux paramètres sont pris en charge.' };
      sol = sol.map(function(v){ var sn = pwSnap(v); return (sn.exact && sn.num !== undefined) ? sn.num : v; });
      var ok = lin.every(function(e){ var r = e.D.c0; e.D.c.forEach(function(c, i){ r += c * sol[i]; }); return Math.abs(r) < 1e-6 * (1 + Math.abs(e.D.c0)); });
      if(!ok) return { ok: false, eqs: lin, msg: 'Le système est incompatible : aucune valeur de ' + P.join(', ') + ' ne vérifie toutes les conditions.' };
      var env = {}; P.forEach(function(p, i){ env[p] = sol[i]; });
      return { ok: true, env: env, eqs: lin, sol: sol };
    }

    function pwFmtLim(r){ if(!r || !r.ok) return null; return pwTexNum(r.v); }
    function pwTangentTex(d, x0, F){ // y = d(x − x0) + F, expanded
      var b = F - d * x0, out = 'y = ';
      var ds = pwSnap(d), bs = pwSnap(b);
      var dt = ds.tex.split(BS + 'approx ').join('');
      if(Math.abs(d) < 1e-12) return out + bs.tex.split(BS + 'approx ').join('');
      out += (ds.plain === '1' ? '' : ds.plain === '-1' ? '-' : dt) + 'x';
      if(Math.abs(b) > 1e-12) out += (b < 0 ? ' - ' : ' + ') + pwSnap(Math.abs(b)).tex.split(BS + 'approx ').join('');
      return out;
    }

    async function runPiecewise(op){
      if(!ggb){ return; }
      var def = pwRead();
      if(def.err){ stateEl.textContent = def.err; return; }
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul…';
      setPwOpsEnabled(false);
      var kq = [], kid = 0;
      function km(l){ var id = 'pwk' + (kid++); kq.push({ id: id, latex: l }); return '<span class="study-math" id="' + id + '"></span>'; }
      function line(label, l){ var s = '<div class="study-line">'; if(label) s += '<span class="study-lbl">' + label + '</span> '; if(l) s += km(l); return s + '</div>'; }
      function sec(t, inner){ return '<div class="study-sec"><div class="study-t">' + t + '</div><div class="study-body">' + inner + '</div></div>'; }
      var goal = pwGoalEl.value, body = '', summary = [], env = {};

      // 1) parameters
      if(def.params.length){
        var sp = pwSolveParams(def, goal), P = def.params, ptxt = '';
        (sp.eqs || []).forEach(function(e){
          var J = def.juncs[e.j], xt = pwTexNum(J.x0);
          var lhsName = e.lhsLbl === 'lim-' ? BS + 'lim_{x ' + BS + 'to ' + xt + '^{-}} f(x)' : e.lhsLbl === 'lim+' ? BS + 'lim_{x ' + BS + 'to ' + xt + '^{+}} f(x)' : "f'_g(" + xt + ')';
          var rhsName = e.rhsLbl === 'F' ? 'f(' + xt + ')' : "f'_d(" + xt + ')';
          var lbl = e.kind === 'cont' ? 'Continuité en ' + escapeHtml(J.xs) + ' :' : 'Dérivabilité en ' + escapeHtml(J.xs) + ' :';
          ptxt += line(lbl, lhsName + ' = ' + pwAffTex(e.A, P) + BS + ';,' + BS + 'quad ' + rhsName + ' = ' + pwAffTex(e.B, P));
        });
        var sysRows = [];
        (sp.eqs || []).filter(function(e){ return e.D.c.some(function(c){ return Math.abs(c) > 1e-9; }); }).forEach(function(e){
          var c = e.D.c.slice(), c0 = e.D.c0, lead = c.filter(function(v){ return Math.abs(v) > 1e-9; })[0];
          if(lead < 0){ c = c.map(function(v){ return -v; }); c0 = -c0; }
          var row = pwAffTex({ c0: 0, c: c }, P) + ' = ' + pwTexNum(-c0);
          if(sysRows.indexOf(row) < 0) sysRows.push(row);
        });
        if(sysRows.length) ptxt += line('Système :', BS + 'left' + BS + '{' + BS + 'begin{array}{l} ' + sysRows.join(' ' + BS + BS + ' ') + ' ' + BS + 'end{array}' + BS + 'right.');
        if(goal === 'CD') ptxt += '<div class="study-work">Pour la dérivabilité, on utilise les limites des dérivées sur chaque intervalle (f étant continue en ce point).</div>';
        if(!sp.ok){
          ptxt += '<div class="study-line study-ko">' + escapeHtml(sp.msg) + '</div>';
          answerEl.innerHTML = '<div class="ml-study" style="padding:.9rem 1.1rem"><div class="study-head"><i class="bi bi-distribute-horizontal"></i> Fonction définie par intervalles</div><div class="study-body">' + line('', pwDefTex(def, null)) + '</div>' + sec('Paramètres', ptxt) + '</div>';
          kq.forEach(function(it){ var el = document.getElementById(it.id); if(el){ try { renderKatex(el, it.latex); } catch(e){} } });
          stateEl.textContent = ''; setPwOpsEnabled(true); return;
        }
        env = sp.env;
        ptxt += line('Solution :', P.map(function(p){ return p + ' = ' + pwTexNum(env[p]); }).join(',' + BS + 'quad '));
        body += sec('Paramètres — f ' + (goal === 'CD' ? 'continue et dérivable' : 'continue'), ptxt);
        summary.push('params: ' + P.map(function(p){ return p + '=' + pwSnap(env[p]).plain; }).join(', ') + ' (systeme: ' + sysRows.join(' ; ').split(BS).join('') + ')');
        if(op === 'params'){
          body = sec('Fonction', line('', pwDefTex(def, null))) + body + sec('Avec ces valeurs', line('', pwDefTex(def, env)));
        }
      }

      // 2) junction analysis (concrete)
      var results = def.juncs.map(function(_, j){ return pwJunction(def, j, env); });
      if(op !== 'params'){
        var head = line('', pwDefTex(def, def.params.length ? env : null));
        var inner = '';
        results.forEach(function(r, j){
          var xt = pwTexNum(r.x0), xs = escapeHtml(r.J.xs);
          var t = '<div class="study-sub">En x' + (j === 0 ? '₁' : '₂') + ' = ' + xs + '</div>';
          var Ft = isFinite(r.F) ? pwTexNum(r.F) : null;
          var src = r.J.at === 'L' ? '(intervalle de gauche)' : r.J.at === 'R' ? '(intervalle de droite)' : '(valeur donnée)';
          t += line('Image :', Ft !== null ? 'f(' + xt + ') = ' + Ft : 'f(' + xt + ')' + BS + 'text{ n’est pas définie}');
          t += '<div class="study-work">' + src + '</div>';
          var lmT = pwFmtLim(r.Lm), lpT = pwFmtLim(r.Lp);
          if(op === 'study' || op === 'cont' || op === 'deriv'){
            t += line('Limite à gauche :', BS + 'lim_{x ' + BS + 'to ' + xt + '^{-}} f(x) = ' + BS + 'lim_{x ' + BS + 'to ' + xt + '^{-}} ' + BS + 'left(' + pwExprTex(r.L, env) + BS + 'right) = ' + (lmT || '?'));
            t += line('Limite à droite :', BS + 'lim_{x ' + BS + 'to ' + xt + '^{+}} f(x) = ' + BS + 'lim_{x ' + BS + 'to ' + xt + '^{+}} ' + BS + 'left(' + pwExprTex(r.R, env) + BS + 'right) = ' + (lpT || '?'));
            if(r.cont) t += '<div class="study-line study-ok">✓ Les deux limites sont égales à f(' + xs + ') : f est continue en ' + xs + '.</div>';
            else {
              var why = !isFinite(r.F) ? 'f(' + xs + ') n’est pas définie'
                : !r.Lm.ok ? 'la limite à gauche n’existe pas (f non définie à gauche ou limite non finie)'
                : !r.Lp.ok ? 'la limite à droite n’existe pas (f non définie à droite ou limite non finie)'
                : (!r.contL && !r.contR) ? 'aucune des deux limites n’est égale à f(' + xs + ')'
                : !r.contL ? 'la limite à gauche est différente de f(' + xs + ')' : 'la limite à droite est différente de f(' + xs + ')';
              t += '<div class="study-line study-ko">✗ ' + why + ' : f n’est pas continue en ' + xs + '.</div>';
            }
          }
          if(op === 'study' || op === 'deriv'){
            var den = Math.abs(r.x0) < 1e-12 ? 'x' : r.x0 < 0 ? 'x + ' + pwTexNum(-r.x0) : 'x - ' + xt;
            var tq = BS + 'frac{f(x) - f(' + xt + ')}{' + den + '}';
            if(!r.cont){
              t += '<div class="study-line study-ko">Dérivabilité : f n’étant pas continue en ' + xs + ', elle n’y est pas dérivable.</div>';
            } else {
              var dmT = pwFmtLim(r.dm), dpT = pwFmtLim(r.dp);
              t += line('Nombre dérivé à gauche :', BS + 'lim_{x ' + BS + 'to ' + xt + '^{-}} ' + tq + ' = ' + (dmT || '?'));
              t += line('Nombre dérivé à droite :', BS + 'lim_{x ' + BS + 'to ' + xt + '^{+}} ' + tq + ' = ' + (dpT || '?'));
              if(r.kind === 'deriv'){
                t += '<div class="study-line study-ok">✓ Les nombres dérivés à gauche et à droite sont égaux : f est dérivable en ' + xs + '.</div>';
                t += line('', "f'(" + xt + ') = ' + dmT + BS + 'quad ' + BS + 'text{Tangente : } ' + pwTangentTex(r.dm.v, r.x0, r.F));
              } else if(r.kind === 'angle'){
                t += '<div class="study-line study-ko">✗ Nombres dérivés différents : f n’est pas dérivable en ' + xs + ' — point anguleux.</div>';
                t += line('Demi-tangentes :', pwTangentTex(r.dm.v, r.x0, r.F) + BS + 'text{ (à gauche)}' + BS + ';,' + BS + 'quad ' + pwTangentTex(r.dp.v, r.x0, r.F) + BS + 'text{ (à droite)}');
              } else if(r.kind === 'vert'){
                t += '<div class="study-line study-ko">✗ Un nombre dérivé est infini : f n’est pas dérivable en ' + xs + ' — demi-tangente verticale (x = ' + xs + ').</div>';
              } else {
                t += '<div class="study-line study-ko">Un des nombres dérivés n’existe pas : f n’est pas dérivable en ' + xs + '.</div>';
              }
            }
          }
          inner += t;
          // summary for the AI (compact, anchored)
          var sm = 'x0=' + r.J.xs + ': f(x0)=' + (isFinite(r.F) ? pwSnap(r.F).plain : 'non definie') + ', lim-=' + (r.Lm.ok ? pwSnap(r.Lm.v).plain : '?') + ', lim+=' + (r.Lp.ok ? pwSnap(r.Lp.v).plain : '?') + ', ' + (r.cont ? 'continue' : 'non continue');
          if(op !== 'cont'){
            if(r.cont) sm += ", f'g=" + (r.dm && r.dm.ok ? pwSnap(r.dm.v).plain : '?') + ", f'd=" + (r.dp && r.dp.ok ? pwSnap(r.dp.v).plain : '?') + ', ' + (r.kind === 'deriv' ? 'derivable, tangente ' + pwTangentTex(r.dm.v, r.x0, r.F).split(BS).join('') : r.kind === 'angle' ? 'point anguleux' : r.kind === 'vert' ? 'demi-tangente verticale' : 'non derivable');
            else sm += ', donc non derivable';
          }
          summary.push(sm);
        });
        var ttl = op === 'cont' ? 'Continuité' : op === 'deriv' ? 'Dérivabilité' : 'Continuité & dérivabilité';
        body = sec('Fonction', head) + body + sec(ttl + ' aux points de raccordement', inner);
      }

      answerEl.innerHTML = '<div class="ml-study" style="padding:.9rem 1.1rem"><div class="study-head"><i class="bi bi-distribute-horizontal"></i> Fonction définie par intervalles</div>' + body + '</div>';
      kq.forEach(function(it){ var el = document.getElementById(it.id); if(el){ try { renderKatex(el, it.latex); } catch(e){} } });

      // 3) graph
      try { pwPlot(def, env, results); } catch(e){}

      // 4) anchored explanation
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';
      var defStr = def.pieces.map(function(c, i){ return pwStr(c.toks, '*') + ' ' + pwCondTxt(i).split('x₁').join(def.juncs[0].xs).split('x₂').join(def.juncs[1] ? def.juncs[1].xs : ''); }).join(' ; ');
      def.juncs.forEach(function(J){ if(J.at === 'V') defStr += ' ; f(' + J.xs + ')=' + pwStr(J.vc.toks, '*'); });
      if(def.params.length) defStr += ' [parametres ' + def.params.join(',') + ' : f ' + (goal === 'CD' ? 'continue et derivable' : 'continue') + ']';
      var opName = { study: 'pw_study', cont: 'pw_cont', deriv: 'pw_deriv', params: 'pw_params' }[op];
      try {
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ function: defStr.slice(0, 200), operation: opName, casResult: summary.join(' | ').slice(0, 495) }) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){ stateEl.textContent = 'Connexion impossible — réessayez.'; }
      finally { setPwOpsEnabled(true); }
    }
    pwOpsEl.addEventListener('click', function(ev){ var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return; runPiecewise(btn.getAttribute('data-pwop')); });
    try { updatePwPreview(); } catch(e){}
    setPwOpsEnabled(false); // enabled once GeoGebra is ready (appletOnLoad)

    function pwPlot(def, env, results){
      clearPwPlot(); try { ggb.deleteObject('f'); } catch(e){}
      function add(nm, cmd, lhs){ try { ggb.evalCommand((lhs || nm) + '=' + cmd); pwObjs.push(nm); return true; } catch(e){ return false; } }
      var X = def.juncs.map(function(J){ return J.x0; });
      def.pieces.forEach(function(c, i){
        var e = pwStr(c.toks, '*', env), cond;
        if(i === 0) cond = 'x < ' + X[0];
        else if(i === def.pieces.length - 1) cond = 'x > ' + X[X.length - 1];
        else cond = 'x > ' + X[i - 1] + ' && x < ' + X[i];
        var nm = 'pwP' + (i + 1);
        if(add(nm, 'If(' + cond + ', ' + e + ')', nm + '(x)')){
          try { ggb.setColor(nm, 94, 23, 235); ggb.setLineThickness(nm, 5); ggb.setLabelVisible(nm, false); } catch(e2){}
        }
      });
      results.forEach(function(r, j){
        function pt(nm, y, filled){
          if(!isFinite(y)) return;
          if(add(nm, '(' + r.x0 + ',' + y + ')')){
            try { ggb.setColor(nm, 50, 44, 77); ggb.setPointSize(nm, 5); ggb.setPointStyle(nm, filled ? 0 : 2); ggb.setLabelVisible(nm, false); } catch(e){}
          }
        }
        var same = r.cont;
        // GeoGebra: a lowercase name + coordinates makes a VECTOR — points need an uppercase name.
        if(same){ pt('PwF' + j, r.F, true); }
        else {
          if(r.Lm.ok) pt('PwL' + j, r.Lm.v, r.J.at === 'L');
          if(r.Lp.ok) pt('PwR' + j, r.Lp.v, r.J.at === 'R');
          if(r.J.at === 'V') pt('PwV' + j, r.F, true);
        }
        // half-tangents
        function seg(nm, x1, y1, x2, y2){
          if(![x1, y1, x2, y2].every(isFinite)) return;
          if(add(nm, 'Segment((' + x1 + ',' + y1 + '),(' + x2 + ',' + y2 + '))')){
            try { ggb.setColor(nm, 255, 194, 58); ggb.setLineThickness(nm, 6); ggb.setLabelVisible(nm, false); } catch(e){}
          }
        }
        if(r.cont && r.dm && r.dp && r.dm.ok && r.dp.ok){
          var len = 0.6;
          if(isFinite(r.dm.v)) seg('pwTg' + j, r.x0 - len, r.F - len * r.dm.v, r.x0, r.F); else seg('pwTg' + j, r.x0, r.F, r.x0, r.F + (r.dm.v > 0 ? -1.5 : 1.5));
          if(isFinite(r.dp.v)) seg('pwTd' + j, r.x0, r.F, r.x0 + len, r.F + len * r.dp.v); else seg('pwTd' + j, r.x0, r.F, r.x0, r.F + (r.dp.v > 0 ? 1.5 : -1.5));
        }
      });
      // frame
      var xmin = Math.min.apply(null, X) - 3, xmax = Math.max.apply(null, X) + 3, ys = [];
      for(var k = 0; k <= 200; k++){
        var x = xmin + (xmax - xmin) * k / 200, idx = 0;
        while(idx < X.length && x > X[idx]) idx++;
        var y = pwEval(def.pieces[Math.min(idx, def.pieces.length - 1)].ast, x, env);
        if(isFinite(y) && Math.abs(y) < 1e6) ys.push(y);
      }
      results.forEach(function(r){ if(isFinite(r.F)) ys.push(r.F); });
      var ymin = ys.length ? Math.min.apply(null, ys) : -5, ymax = ys.length ? Math.max.apply(null, ys) : 5;
      ymin = Math.max(ymin, -15); ymax = Math.min(ymax, 15);
      var pad = Math.max(1, (ymax - ymin) * 0.15);
      try { ggb.setCoordSystem(xmin, xmax, ymin - pad, ymax + pad); } catch(e){}
    }

    /* ============ ÉQUATION : second degré, paramètre m, degré 3 ============ */
    // Exact arithmetic on fractions {n, d} (d > 0) and on polynomials with fraction coefficients
    // (array index = power). Everything here is pure JS — no GeoGebra CAS.
    var modeEq1     = document.getElementById('mode-equation');
    var e1TypeEl    = document.getElementById('e1-type');
    var e1ExEl      = document.getElementById('e1-ex');
    var e1OpsEl     = document.getElementById('e1-ops');
    var e1PrevEl    = document.getElementById('e1-preview');
    var e1HintEl    = document.getElementById('e1-hint');
    var e1X0Row     = document.getElementById('e1-x0row');
    var e1X0        = document.getElementById('e1x0');
    var e1X0Hint    = document.getElementById('e1x0-hint');
    var e1In = { a: document.getElementById('e1a'), b: document.getElementById('e1b'), c: document.getElementById('e1c'), d: document.getElementById('e1d') };
    var e1CD = document.getElementById('e1-cd');
    var e1Type = 'deg2';
    var e1Objs = [];

    function setE1OpsEnabled(on){ e1OpsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }
    function clearE1Plot(){ e1Objs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} }); e1Objs = []; }

    // ---- fractions ----
    function fr(n, d){ if(d === undefined) d = 1; if(d < 0){ n = -n; d = -d; } var g = igcd(n, d) || 1; return { n: n / g, d: d / g }; }
    function fAdd(p, q){ return fr(p.n * q.d + q.n * p.d, p.d * q.d); }
    function fSub(p, q){ return fr(p.n * q.d - q.n * p.d, p.d * q.d); }
    function fMul(p, q){ return fr(p.n * q.n, p.d * q.d); }
    function fDiv(p, q){ return fr(p.n * q.d, p.d * q.n); }
    function fNeg(p){ return { n: -p.n, d: p.d }; }
    function fZero(p){ return p.n === 0; }
    function fVal(p){ return p.n / p.d; }
    function fFromNum(x){
      if(!isFinite(x)) return null;
      for(var q = 1; q <= 1000; q++){ var p = Math.round(x * q); if(Math.abs(p / q - x) < 1e-9 * (1 + Math.abs(x))) return fr(p, q); }
      return null;
    }
    function fTex(p){ if(p.d === 1) return String(p.n); return (p.n < 0 ? '-' : '') + BS + 'frac{' + Math.abs(p.n) + '}{' + p.d + '}'; }
    function fPar(p){ var t = fTex(p); return p.n < 0 ? BS + 'left(' + t + BS + 'right)' : t; }
    function fPlain(p){ return p.d === 1 ? String(p.n) : p.n + '/' + p.d; }

    // ---- polynomials (index = power) with fraction coefficients ----
    function pTrim(p){ var r = p.slice(); while(r.length > 1 && fZero(r[r.length - 1])) r.pop(); if(!r.length) r = [fr(0)]; return r; }
    function pDeg(p){ p = pTrim(p); return (p.length === 1 && fZero(p[0])) ? -1 : p.length - 1; }
    function pAdd(p, q){ var r = []; for(var i = 0; i < Math.max(p.length, q.length); i++) r.push(fAdd(p[i] || fr(0), q[i] || fr(0))); return pTrim(r); }
    function pSub(p, q){ var r = []; for(var i = 0; i < Math.max(p.length, q.length); i++) r.push(fSub(p[i] || fr(0), q[i] || fr(0))); return pTrim(r); }
    function pMul(p, q){ var r = []; for(var i = 0; i < p.length + q.length - 1; i++) r.push(fr(0)); for(var a = 0; a < p.length; a++) for(var b = 0; b < q.length; b++) r[a + b] = fAdd(r[a + b], fMul(p[a], q[b])); return pTrim(r); }
    function pScale(p, k){ return pTrim(p.map(function(c){ return fMul(c, k); })); }
    function pEvalF(p, x){ var acc = fr(0); for(var i = p.length - 1; i >= 0; i--) acc = fAdd(fMul(acc, x), p[i]); return acc; }
    function pEvalN(p, x){ var acc = 0; for(var i = p.length - 1; i >= 0; i--) acc = acc * x + fVal(p[i]); return acc; }
    function pConst(p){ return pDeg(p) <= 0; }
    // LaTeX, descending powers, e.g. 2x² − x + 1/2 (fractions as LaTeX fractions)
    function pTex(p, v){
      p = pTrim(p); var out = '', first = true;
      for(var k = p.length - 1; k >= 0; k--){
        var c = p[k]; if(fZero(c)) continue;
        var neg = c.n < 0, ab = fr(Math.abs(c.n), c.d), body;
        var vp = k === 0 ? '' : (k === 1 ? v : v + '^{' + k + '}');
        var ct = (k > 0 && ab.n === 1 && ab.d === 1) ? '' : fTex(ab);
        body = ct + vp;
        out += first ? ((neg ? '-' : '') + body) : ((neg ? ' - ' : ' + ') + body);
        first = false;
      }
      return out || '0';
    }
    function pPlain(p, v){ // plain text for the AI summary, e.g. "m^2 - 8m + 1/2"
      p = pTrim(p); var out = '', first = true;
      for(var k = p.length - 1; k >= 0; k--){
        var c = p[k]; if(fZero(c)) continue;
        var neg = c.n < 0, ab = fr(Math.abs(c.n), c.d);
        var ct = (k > 0 && ab.n === 1 && ab.d === 1) ? '' : (ab.d === 1 ? String(ab.n) : (k > 0 ? '(' + fPlain(ab) + ')' : fPlain(ab)));
        var body = ct + (k === 0 ? '' : (k === 1 ? v : v + '^' + k));
        out += first ? ((neg ? '-' : '') + body) : ((neg ? ' - ' : ' + ') + body);
        first = false;
      }
      return out || '0';
    }
    function pGgb(p, v){ // GeoGebra syntax
      p = pTrim(p); var parts = [];
      for(var k = p.length - 1; k >= 0; k--){ var c = p[k]; if(fZero(c)) continue; parts.push('(' + c.n + '/' + c.d + ')' + (k === 0 ? '' : '*' + v + (k === 1 ? '' : '^' + k))); }
      return parts.length ? parts.join('+') : '0';
    }

    // ---- input → polynomial in m (coefficient inputs) ----
    function astToPolyM(n){
      if(!n) return null;
      switch(n.t){
        case 'num': { var f = fFromNum(n.v); return f ? [f] : null; }
        case 'const': return n.name === 'm' ? [fr(0), fr(1)] : null;
        case 'var': return null; // x is not allowed inside a coefficient
        case 'neg': { var a = astToPolyM(n.a); return a ? pScale(a, fr(-1)) : null; }
        case '+': case '-': case '*': {
          var l = astToPolyM(n.l), r = astToPolyM(n.r); if(!l || !r) return null;
          return n.t === '+' ? pAdd(l, r) : n.t === '-' ? pSub(l, r) : pMul(l, r);
        }
        case '/': { var l2 = astToPolyM(n.l), r2 = astToPolyM(n.r); if(!l2 || !r2 || !pConst(r2) || fZero(r2[0])) return null; return pScale(l2, fDiv(fr(1), r2[0])); }
        case '^': { var b = astToPolyM(n.l), e = astToPolyM(n.r); if(!b || !e || !pConst(e)) return null; var ev = fVal(e[0]); if(ev < 0 || ev > 6 || ev !== Math.floor(ev)) return null; var res = [fr(1)]; for(var i = 0; i < ev; i++) res = pMul(res, b); return res; }
      }
      return null;
    }
    function e1Parse(str){
      str = (str || '').trim(); if(str === '') str = '0';
      var tk = pwTokens(str); if(!tk) return null;
      var ast = null; try { ast = dxParse(tk); } catch(e){ ast = null; }
      return ast ? astToPolyM(ast) : null;
    }

    // ---- exact real roots ----
    // Root object: { num, tex, plain, f? (fraction when rational) }
    function rootRat(f){ return { num: fVal(f), tex: fTex(f), plain: fPlain(f), f: f }; }
    // A x² + B x + C = 0 with fraction coefficients (A ≠ 0) → { delta (fraction), roots: [...] ascending }
    function quadExact(A, B, C){
      var delta = fSub(fMul(B, B), fMul(fr(4), fMul(A, C)));
      var L = A.d * B.d * C.d, Ai = A.n * (L / A.d), Bi = B.n * (L / B.d), Ci = C.n * (L / C.d);
      var g = igcd(igcd(Ai, Bi), Ci) || 1; Ai /= g; Bi /= g; Ci /= g;
      var D = Bi * Bi - 4 * Ai * Ci, roots = [];
      if(D < 0) return { delta: delta, roots: [] };
      if(D === 0) return { delta: delta, roots: [rootRat(fr(-Bi, 2 * Ai))] };
      var sr = simplifyRadical(D);
      if(sr.rad === 1){ roots = [rootRat(fr(-Bi - sr.coef, 2 * Ai)), rootRat(fr(-Bi + sr.coef, 2 * Ai))]; }
      else {
        var n0 = -Bi, k = sr.coef, den = 2 * Ai, gg = igcd(igcd(Math.abs(n0), k), Math.abs(den)) || 1;
        n0 /= gg; k /= gg; den /= gg; if(den < 0){ den = -den; n0 = -n0; }
        function mk(sign){
          var num = (n0 !== 0 ? n0 + (sign > 0 ? ' + ' : ' - ') : (sign > 0 ? '' : '-')) + (k === 1 ? '' : k) + BS + 'sqrt{' + sr.rad + '}';
          var plainNum = (n0 !== 0 ? n0 + (sign > 0 ? '+' : '-') : (sign > 0 ? '' : '-')) + (k === 1 ? '' : k) + 'sqrt(' + sr.rad + ')';
          return { num: (n0 + sign * k * Math.sqrt(sr.rad)) / den, tex: den === 1 ? num : BS + 'frac{' + num + '}{' + den + '}', plain: den === 1 ? plainNum : '(' + plainNum + ')/' + den };
        }
        roots = [mk(-1), mk(1)];
      }
      roots.sort(function(x, y){ return x.num - y.num; });
      return { delta: delta, roots: roots };
    }
    function synthDivF(p, r){ // p (index = power) ÷ (t − r) → { q, rem }
      var n = p.length - 1, q = [], acc = fr(0), co = [];
      for(var k = n; k >= 0; k--){ acc = fAdd(fMul(acc, r), p[k]); co.push(acc); }
      var rem = co.pop(); co.reverse(); return { q: pTrim(co), rem: rem };
    }
    function divisors(n){ n = Math.abs(n); var r = []; for(var i = 1; i <= Math.min(n, 2000); i++) if(n % i === 0) r.push(i); return r; }
    // Rational candidates p/q for p(t) = 0 (rational root theorem), in "racine évidente" order.
    function ratCandidates(p){
      var L = 1; p.forEach(function(c){ L = L * c.d / (igcd(L, c.d) || 1); });
      var ints = p.map(function(c){ return c.n * (L / c.d); });
      var lo = 0; while(lo < ints.length && ints[lo] === 0) lo++;
      var a0 = ints[lo] || 0, an = ints[ints.length - 1];
      var out = [], seen = {};
      function add(f){ var k = f.n + '/' + f.d; if(!seen[k]){ seen[k] = 1; out.push(f); } }
      [1, -1, 2, -2, 3, -3].forEach(function(v){ add(fr(v)); });
      divisors(a0).forEach(function(pp){ divisors(an).forEach(function(qq){ add(fr(pp, qq)); add(fr(-pp, qq)); }); });
      out.sort(function(x, y){ var ax = Math.abs(fVal(x)), ay = Math.abs(fVal(y)); if(x.d === 1 && y.d !== 1) return -1; if(y.d === 1 && x.d !== 1) return 1; return ax - ay || fVal(y) - fVal(x); });
      return out.slice(0, 400);
    }
    // All distinct real roots of a polynomial in one variable (exact when possible).
    function exactRealRoots(p){
      p = pTrim(p); var deg = pDeg(p), out = [];
      if(deg <= 0) return [];
      if(deg === 1) return [rootRat(fDiv(fNeg(p[0]), p[1]))];
      if(deg === 2) return quadExact(p[2], p[1], p[0]).roots;
      if(fZero(p[0])){ var dv = synthDivF(p, fr(0)); out = [rootRat(fr(0))].concat(exactRealRoots(dv.q)); }
      else {
        var cands = ratCandidates(p), found = null;
        for(var i = 0; i < cands.length && !found; i++){ if(fZero(pEvalF(p, cands[i]))) found = cands[i]; }
        if(found){ out = [rootRat(found)].concat(exactRealRoots(synthDivF(p, found).q)); }
        else {
          var cz = p.slice().reverse().map(function(c){ return { re: fVal(c), im: 0 }; });
          polyRootsJS(cz).forEach(function(z){ if(Math.abs(z.im) < 1e-7) out.push({ num: z.re, tex: BS + 'approx ' + (Math.round(z.re * 1000) / 1000), plain: '~' + (Math.round(z.re * 1000) / 1000) }); });
        }
      }
      out.sort(function(x, y){ return x.num - y.num; });
      return out.filter(function(r, i){ return i === 0 || Math.abs(r.num - out[i - 1].num) > 1e-9; });
    }

    // ---- display helpers ----
    function e1EqTex(polys, v){ return pTex(polys, v) + ' = 0'; }
    // Equation with coefficients that are polynomials in m (A for x², B for x, C constant)
    function e1ParamTex(A, B, C){
      var out = '', first = true;
      [[A, 'x^{2}'], [B, 'x'], [C, '']].forEach(function(it){
        var co = pTrim(it[0]), xp = it[1], nz = co.filter(function(c){ return !fZero(c); }).length;
        if(nz === 0) return;
        if(nz === 1 || xp === ''){
          var t = pTex(co, 'm');
          if(xp && (t === '1' || t === '-1')) t = t === '1' ? '' : '-';
          var neg = t.charAt(0) === '-', body = (neg ? t.slice(1) : t) + (xp ? (t === '' || t === '-' ? '' : ' ') + xp : '');
          if(xp === '' && nz > 1){ out += first ? t : (' + ' + t).split('+ -').join('- '); }
          else out += first ? ((neg ? '-' : '') + body) : ((neg ? ' - ' : ' + ') + body);
        } else out += (first ? '' : ' + ') + '(' + pTex(co, 'm') + ')' + xp;
        first = false;
      });
      return (out || '0') + ' = 0';
    }
    function e1Interval(lo, hi){ // lo/hi: root objects or null (∞) — French notation ]a ; b[
      return BS + 'left]' + (lo ? lo.tex : '-' + BS + 'infty') + BS + ',;' + BS + ',' + (hi ? hi.tex : '+' + BS + 'infty') + BS + 'right[';
    }
    // Sign table HTML: columns −∞ | interval | r₁ | interval | … | +∞
    function e1SignTable(v, label, roots, evalN){
      var head = '<tr><th>' + v + '</th><td><span data-tex="-' + BS + 'infty"></span></td>', sign = '<tr><th>' + label + '</th><td></td>';
      var pts = [-Infinity].concat(roots.map(function(r){ return r.num; })).concat([Infinity]);
      for(var i = 0; i < pts.length - 1; i++){
        var lo = pts[i], hi = pts[i + 1];
        var t = (lo === -Infinity && hi === Infinity) ? 0 : lo === -Infinity ? hi - 1 : hi === Infinity ? lo + 1 : (lo + hi) / 2;
        var sv = evalN(t), sg = sv > 1e-12 ? '+' : sv < -1e-12 ? '−' : '0';
        head += '<td></td>';
        sign += '<td class="' + (sg === '+' ? 'e1-pos' : sg === '0' ? 'e1-zero' : 'e1-neg') + '">' + sg + '</td>';
        if(i < roots.length){ head += '<td><span data-tex="' + escapeHtml(roots[i].tex) + '"></span></td>'; sign += '<td class="e1-zero">0</td>'; }
      }
      head += '<td><span data-tex="+' + BS + 'infty"></span></td></tr>'; sign += '<td></td></tr>';
      return '<div class="e1-wrap"><table class="e1-table">' + head + sign + '</table></div>';
    }

    // ---- examples per type ----
    var E1_EX = {
      deg2: [ ['Δ > 0', ['2', '-3', '-2']], ['Δ = 0', ['1', '-6', '9']], ['Δ < 0', ['1', '1', '1']], ['Racines avec √', ['1', '-2', '-1']] ],
      param: [ ['(m−1)x² + 2mx + m + 3', ['m-1', '2m', 'm+3'], '1'], ['x² + (m−2)x + m + 1', ['1', 'm-2', 'm+1'], '2'], ['mx² − 4x + m', ['m', '-4', 'm'], '1'], ['x² − (m+1)x + m', ['1', '-(m+1)', 'm'], '2'] ],
      deg3: [ ['x³ − 2x² − 5x + 6', ['1', '-2', '-5', '6']], ['2x³ − 3x² − 3x + 2', ['2', '-3', '-3', '2']], ['x³ − 3x + 2', ['1', '0', '-3', '2']], ['x³ − x² + x − 1', ['1', '-1', '1', '-1']] ]
    };
    function e1RenderExamples(){
      var html = '<span class="pw-ex__lbl"><i class="bi bi-lightbulb"></i> Exemples :</span>';
      E1_EX[e1Type].forEach(function(ex, i){ html += '<button type="button" class="ml-key is-util" data-e1ex="' + i + '">' + escapeHtml(ex[0]) + '</button>'; });
      e1ExEl.innerHTML = html;
    }
    e1ExEl.addEventListener('click', function(ev){
      var b = ev.target.closest('[data-e1ex]'); if(!b) return;
      var ex = E1_EX[e1Type][Number(b.getAttribute('data-e1ex'))]; if(!ex) return;
      var keys = ['a', 'b', 'c', 'd'];
      ex[1].forEach(function(v, i){ e1In[keys[i]].value = v; });
      e1X0.value = ex[2] || '';
      answerEl.innerHTML = ''; stepsEl.innerHTML = ''; stateEl.textContent = '';
      updateE1Preview();
    });

    function setE1Type(t){
      e1Type = t;
      e1TypeEl.querySelectorAll('.ml-sidebtn').forEach(function(b){ b.classList.toggle('is-active', b.getAttribute('data-etype') === t); });
      e1CD.hidden = (t !== 'deg3');
      e1OpsEl.querySelectorAll('.ml-op').forEach(function(b){ b.hidden = (b.getAttribute('data-for') !== t); });
      e1X0Row.hidden = (t === 'deg2');
      document.getElementById('e1x0-lbl').textContent = 'x₀ =';
      e1X0Hint.textContent = t === 'param' ? 'pour « m tel que x₀ soit solution »' : 'racine évidente (remplie par l’étape 1, ou à saisir)';
      e1HintEl.innerHTML = t === 'deg2' ? 'Équation <strong>a·x² + b·x + c = 0</strong> — coefficients entiers ou fractions (ex. 1/2).'
        : t === 'param' ? 'Équation <strong>a·x² + b·x + c = 0</strong> où a, b, c peuvent dépendre de <strong>m</strong> (ex. « m-1 », « 2m », « m+3 »).'
        : 'Équation <strong>a·x³ + b·x² + c·x + d = 0</strong> (a ≠ 0) — démarche : racine évidente → Q(x) → résoudre Q(x) = 0.';
      var defaults = { deg2: ['2', '-3', '-2', ''], param: ['m-1', '2m', 'm+3', ''], deg3: ['1', '-2', '-5', '6'] }[t];
      e1In.a.value = defaults[0]; e1In.b.value = defaults[1]; e1In.c.value = defaults[2]; if(t === 'deg3') e1In.d.value = defaults[3];
      e1X0.value = t === 'param' ? '1' : '';
      e1RenderExamples();
      answerEl.innerHTML = ''; stepsEl.innerHTML = ''; stateEl.textContent = '';
      updateE1Preview();
    }
    e1TypeEl.addEventListener('click', function(ev){ var b = ev.target.closest('.ml-sidebtn'); if(b) setE1Type(b.getAttribute('data-etype')); });

    // Read the coefficients. Returns { err } or { A, B, C, D } (polynomials in m; constant for deg2/deg3).
    function e1Read(){
      var keys = e1Type === 'deg3' ? ['a', 'b', 'c', 'd'] : ['a', 'b', 'c'], out = {};
      for(var i = 0; i < keys.length; i++){
        var p = e1Parse(e1In[keys[i]].value);
        if(!p) return { err: 'Coefficient ' + keys[i] + ' invalide' + (e1Type === 'param' ? ' (nombres, fractions et m uniquement).' : ' (nombre entier ou fraction, ex. 3 ou 1/2).') };
        if(e1Type !== 'param' && !pConst(p)) return { err: 'Le paramètre m n’est utilisable que dans « Avec paramètre m ».' };
        out[keys[i]] = p;
      }
      return out;
    }
    function updateE1Preview(){
      var r = e1Read();
      if(r.err){ e1PrevEl.className = 'ml-preview is-empty'; e1PrevEl.textContent = r.err; return; }
      var tex;
      if(e1Type === 'param') tex = e1ParamTex(r.a, r.b, r.c);
      else if(e1Type === 'deg2') tex = e1EqTex([r.c[0], r.b[0], r.a[0]], 'x');
      else tex = e1EqTex([r.d[0], r.c[0], r.b[0], r.a[0]], 'x');
      try { renderKatex(e1PrevEl, tex); e1PrevEl.className = 'ml-preview'; } catch(e){ e1PrevEl.className = 'ml-preview is-empty'; e1PrevEl.textContent = 'Aperçu indisponible.'; }
    }
    ['a', 'b', 'c', 'd'].forEach(function(k){ e1In[k].addEventListener('input', updateE1Preview); });

    // ---- report helpers ----
    function e1Report(){
      var kq = [], kid = 0, html = '';
      function km(l){ var id = 'e1k' + (kid++); kq.push({ id: id, latex: l }); return '<span class="study-math" id="' + id + '"></span>'; }
      return {
        line: function(label, l){ var s = '<div class="study-line">'; if(label) s += '<span class="study-lbl">' + label + '</span> '; if(l) s += km(l); return s + '</div>'; },
        sec: function(t, inner){ return '<div class="study-sec"><div class="study-t">' + t + '</div><div class="study-body">' + inner + '</div></div>'; },
        render: function(title, body){
          answerEl.innerHTML = '<div class="ml-study" style="padding:.9rem 1.1rem"><div class="study-head"><i class="bi bi-calculator"></i> ' + title + '</div>' + body + '</div>';
          kq.forEach(function(it){ var el = document.getElementById(it.id); if(el){ try { renderKatex(el, it.latex); } catch(e){} } });
          Array.prototype.forEach.call(answerEl.querySelectorAll('[data-tex]'), function(el){ var t = el.getAttribute('data-tex'); if(t) renderKatex(el, t); });
        }
      };
    }
    async function e1Explain(op, defStr, summary){
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';
      try {
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ function: defStr.slice(0, 200), operation: op, casResult: summary.slice(0, 495) }) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){ stateEl.textContent = 'Connexion impossible — réessayez.'; }
      finally { setE1OpsEnabled(true); }
    }
    function e1Plot(poly, roots, extraPts){
      clearE1Plot(); try { ggb.deleteObject('f'); } catch(e){}
      try { ggb.evalCommand('f(x)=' + pGgb(poly, 'x')); ggb.setColor('f', 94, 23, 235); ggb.setLineThickness('f', 5); e1Objs.push('f'); } catch(e){}
      (roots || []).forEach(function(r, i){
        var nm = 'E1R' + (i + 1); // uppercase: a lowercase name + coordinates would be a vector
        try { ggb.evalCommand(nm + '=(' + r.num + ',0)'); ggb.setColor(nm, 255, 194, 58); ggb.setPointSize(nm, 6); ggb.setLabelVisible(nm, false); e1Objs.push(nm); } catch(e){}
      });
      (extraPts || []).forEach(function(pt, i){
        var nm = 'E1P' + (i + 1);
        try { ggb.evalCommand(nm + '=(' + pt[0] + ',' + pt[1] + ')'); ggb.setColor(nm, 50, 44, 77); ggb.setPointSize(nm, 5); ggb.setLabelVisible(nm, false); e1Objs.push(nm); } catch(e){}
      });
      var xs = (roots || []).map(function(r){ return r.num; }).concat((extraPts || []).map(function(p){ return p[0]; }));
      var xmin = xs.length ? Math.min.apply(null, xs) - 3 : -5, xmax = xs.length ? Math.max.apply(null, xs) + 3 : 5, ys = [];
      for(var k = 0; k <= 120; k++){ var x = xmin + (xmax - xmin) * k / 120, y = pEvalN(poly, x); if(isFinite(y)) ys.push(y); }
      var ymin = Math.max(-25, Math.min.apply(null, ys.concat([-1]))), ymax = Math.min(25, Math.max.apply(null, ys.concat([1])));
      var pad = Math.max(1, (ymax - ymin) * 0.12);
      try { ggb.setCoordSystem(xmin, xmax, ymin - pad, ymax + pad); } catch(e){}
    }

    // ---- second degré (no parameter): solve with Δ, factorised/canonical forms, sign ----
    function e1SolveQuadBlock(R, A, B, C, v, P){ // returns { html, roots, summary }
      var q = quadExact(A, B, C), d = q.delta, html = '', sm = [];
      var dSub = fPar(B) + '^{2} - 4 ' + BS + 'times ' + fPar(A) + ' ' + BS + 'times ' + fPar(C);
      html += R.line('Discriminant :', BS + 'Delta = b^{2} - 4ac = ' + dSub + ' = ' + fTex(d));
      sm.push('Delta=' + fPlain(d));
      var sqD = BS + 'sqrt{' + fTex(d) + '}', twoA = '2 ' + BS + 'times ' + fPar(A);
      if(d.n > 0){
        html += '<div class="study-work">Δ > 0 : l’équation admet deux solutions réelles distinctes.</div>';
        var r1 = q.roots[0], r2 = q.roots[1];
        var aPos = A.n > 0;
        // x1 = (−b − √Δ)/(2a) is the smaller root when a > 0
        var lo = aPos ? '-' : '+', hi = aPos ? '+' : '-';
        html += R.line('', v + '_1 = ' + BS + 'frac{-b ' + lo + ' ' + BS + 'sqrt{' + BS + 'Delta}}{2a} = ' + BS + 'frac{' + (B.n <= 0 ? fTex(fNeg(B)) : '-' + fTex(B)) + ' ' + lo + ' ' + sqD + '}{' + twoA + '} = ' + r1.tex);
        html += R.line('', v + '_2 = ' + BS + 'frac{-b ' + hi + ' ' + BS + 'sqrt{' + BS + 'Delta}}{2a} = ' + BS + 'frac{' + (B.n <= 0 ? fTex(fNeg(B)) : '-' + fTex(B)) + ' ' + hi + ' ' + sqD + '}{' + twoA + '} = ' + r2.tex);
        html += R.line('Solutions :', 'S = ' + BS + 'left' + BS + '{ ' + r1.tex + ' ; ' + r2.tex + ' ' + BS + 'right' + BS + '}');
        sm.push('x1=' + r1.plain + ', x2=' + r2.plain);
      } else if(d.n === 0){
        html += '<div class="study-work">Δ = 0 : l’équation admet une solution double.</div>';
        html += R.line('', v + '_0 = -' + BS + 'frac{b}{2a} = -' + BS + 'frac{' + fTex(B) + '}{' + twoA + '} = ' + q.roots[0].tex);
        html += R.line('Solution :', 'S = ' + BS + 'left' + BS + '{ ' + q.roots[0].tex + ' ' + BS + 'right' + BS + '}');
        sm.push('x0=' + q.roots[0].plain + ' (double)');
      } else {
        html += '<div class="study-work">Δ < 0 : l’équation n’admet aucune solution réelle.</div>';
        html += R.line('Solutions :', 'S = ' + BS + 'varnothing');
        sm.push('aucune solution reelle');
      }
      return { html: html, roots: q.roots, delta: d, summary: sm.join(', ') };
    }
    function e1Fac(r, v){ // (x − r) as LaTeX
      if(r.f){ var c = fNeg(r.f); return c.n === 0 ? v : BS + 'left(' + v + (c.n < 0 ? ' - ' + fTex(fNeg(c)) : ' + ' + fTex(c)) + BS + 'right)'; }
      return BS + 'left(' + v + ' - ' + r.tex + BS + 'right)';
    }
    function e1LeadTex(A){ return (A.n === A.d) ? '' : (A.n === -A.d ? '-' : fTex(A)); }
    function e1FacList(roots, v, delta){
      if(delta.n > 0) return e1Fac(roots[0], v) + e1Fac(roots[1], v);
      if(delta.n === 0) return e1Fac(roots[0], v) + '^{2}';
      return null;
    }
    function e1Factored(A, roots, v, delta){ var l = e1FacList(roots, v, delta); return l === null ? null : e1LeadTex(A) + l; }

    async function runEq1(op){
      if(!ggb){ return; }
      var r = e1Read();
      if(r.err){ stateEl.textContent = r.err; return; }
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul…';
      setE1OpsEnabled(false);
      try {
        if(op === 'deg2_solve') return await e1RunDeg2(r);
        if(op === 'param_discuss' || op === 'param_root') return await e1RunParam(r, op);
        return await e1RunDeg3(r, op);
      } catch(e){ stateEl.textContent = 'Calcul impossible — vérifiez les coefficients.'; setE1OpsEnabled(true); }
    }
    e1OpsEl.addEventListener('click', function(ev){ var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return; runEq1(btn.getAttribute('data-e1op')); });

    async function e1RunDeg2(r){
      var A = r.a[0], B = r.b[0], C = r.c[0], R = e1Report(), body = '';
      var P = [C, B, A], eqTex = e1EqTex(P, 'x');
      if(fZero(A)){
        // first-degree equation
        var lin = fZero(B) ? (fZero(C) ? 'S = ' + BS + 'mathbb{R}' : 'S = ' + BS + 'varnothing') : 'x = -' + BS + 'frac{c}{b} = ' + fTex(fDiv(fNeg(C), B));
        body = R.sec('Équation', R.line('', eqTex) + '<div class="study-work">a = 0 : ce n’est pas une équation du second degré, mais du premier degré.</div>' + R.line('', lin));
        R.render('Équation du premier degré', body); stateEl.textContent = ''; setE1OpsEnabled(true); return;
      }
      body += R.sec('Équation', R.line('', eqTex) + R.line('Coefficients :', 'a = ' + fTex(A) + ',' + BS + 'quad b = ' + fTex(B) + ',' + BS + 'quad c = ' + fTex(C)));
      var res = e1SolveQuadBlock(R, A, B, C, 'x', P);
      body += R.sec('Résolution par le discriminant', res.html);
      var fact = e1Factored(A, res.roots, 'x', res.delta), forms = '';
      if(fact) forms += R.line('Forme factorisée :', 'P(x) = ' + fact);
      else forms += '<div class="study-line">Forme factorisée : Δ < 0, le trinôme ne se factorise pas dans ℝ.</div>';
      var al = fDiv(fNeg(B), fMul(fr(2), A)), be = fDiv(fNeg(res.delta), fMul(fr(4), A));
      var atex = e1LeadTex(A);
      var sq = fZero(al) ? 'x^{2}' : BS + 'left(x ' + (al.n < 0 ? '+ ' + fTex(fNeg(al)) : '- ' + fTex(al)) + BS + 'right)^{2}';
      var cst = fZero(be) ? '' : (be.n < 0 ? ' - ' + fTex(fNeg(be)) : ' + ' + fTex(be));
      forms += R.line('Forme canonique :', 'P(x) = ' + atex + sq + cst + BS + 'quad ' + BS + 'text{(sommet } S' + BS + 'left(' + fTex(al) + ' ; ' + fTex(be) + BS + 'right)' + BS + 'text{)}');
      body += R.sec('Formes du trinôme', forms);
      var sgnTxt = res.delta.n > 0 ? 'P(x) est du signe de a (' + (A.n > 0 ? 'positif' : 'négatif') + ') à l’extérieur des racines, et du signe contraire entre les racines.'
        : 'P(x) est du signe de a (' + (A.n > 0 ? 'positif' : 'négatif') + ') pour tout x' + (res.delta.n === 0 ? ', et s’annule en x₀.' : '.');
      body += R.sec('Signe du trinôme', '<div class="study-work">' + sgnTxt + '</div>' + e1SignTable('x', 'P(x)', res.roots, function(x){ return pEvalN(P, x); }));
      R.render('Équation du second degré', body);
      e1Plot(P, res.roots, [[fVal(al), fVal(be)]]);
      setTimeout(fitGraph, 50);
      await e1Explain('eq2_solve', pPlain(P, 'x') + ' = 0', 'a=' + fPlain(A) + ', b=' + fPlain(B) + ', c=' + fPlain(C) + ' ; ' + res.summary + (res.roots.length ? ' ; forme factorisee: ' + (fVal(A) === 1 ? '' : fPlain(A)) + res.roots.map(function(z){ return z.plain.charAt(0) === '-' ? '(x + ' + z.plain.slice(1) + ')' : '(x - ' + z.plain + ')'; }).join('') + (res.delta.n === 0 ? '^2' : '') : ''));
    }

    async function e1RunParam(r, op){
      var A = r.a, B = r.b, C = r.c, R = e1Report(), body = '', sm = [];
      var hasM = !(pConst(A) && pConst(B) && pConst(C));
      if(!hasM){ stateEl.textContent = 'Aucun paramètre m dans les coefficients — utilisez « Second degré ».'; setE1OpsEnabled(true); return; }
      if(pDeg(A) < 0){ stateEl.textContent = 'a(m) = 0 pour tout m : ce n’est pas une équation du second degré.'; setE1OpsEnabled(true); return; }
      var eqTex = e1ParamTex(A, B, C);
      body += R.sec('Équation', R.line('', eqTex) + R.line('Coefficients :', 'a(m) = ' + pTex(A, 'm') + ',' + BS + 'quad b(m) = ' + pTex(B, 'm') + ',' + BS + 'quad c(m) = ' + pTex(C, 'm')));

      if(op === 'param_root'){
        var x0 = e1Parse(e1X0.value);
        if(!x0 || !pConst(x0)){ stateEl.textContent = 'Saisissez une valeur numérique pour x₀ (ex. -1 ou 1/2).'; setE1OpsEnabled(true); return; }
        var xv = x0[0], xx = fMul(xv, xv);
        var E = pAdd(pAdd(pScale(A, xx), pScale(B, xv)), C);
        var t = '<div class="study-work">x₀ est solution si et seulement si a(m)·x₀² + b(m)·x₀ + c(m) = 0.</div>';
        t += R.line('', 'a(m)' + BS + 'times ' + fPar(xv) + '^{2} + b(m)' + BS + 'times ' + fPar(xv) + ' + c(m) = 0 ' + BS + 'iff ' + pTex(E, 'm') + ' = 0');
        var ms = [];
        if(pDeg(E) < 0){ t += '<div class="study-line study-ok">✓ Cette égalité est vraie pour tout m : x₀ est solution quel que soit m.</div>'; sm.push('vrai pour tout m'); }
        else if(pDeg(E) === 0){ t += '<div class="study-line study-ko">✗ Égalité impossible : x₀ n’est jamais solution.</div>'; sm.push('aucun m'); }
        else {
          ms = exactRealRoots(E);
          if(!ms.length){ t += '<div class="study-line study-ko">✗ Aucune valeur réelle de m ne convient.</div>'; sm.push('aucun m reel'); }
          ms.forEach(function(mr){
            t += R.line('', 'm = ' + mr.tex);
            var mv = mr.f || fFromNum(mr.num);
            if(mv){
              var a0 = pEvalF(A, mv), b0 = pEvalF(B, mv), c0 = pEvalF(C, mv);
              if(fZero(a0)){ t += '<div class="study-work">Pour cette valeur, a(m) = 0 : l’équation est du premier degré et x₀ en est l’unique solution.</div>'; sm.push('m=' + mr.plain + ' (a=0, x0 seule solution)'); }
              else {
                var other = fSub(fDiv(fNeg(b0), a0), xv);
                t += R.line('Autre solution :', BS + 'text{somme des racines } x_0 + x_1 = -' + BS + 'frac{b}{a} = ' + fTex(fDiv(fNeg(b0), a0)) + BS + 'Rightarrow x_1 = ' + fTex(other));
                sm.push('m=' + mr.plain + ', autre racine x1=' + fPlain(other));
              }
            } else sm.push('m=' + mr.plain);
          });
        }
        body += R.sec('x₀ = ' + escapeHtml(fPlain(xv)) + ' solution', t);
        R.render('Équation avec paramètre m', body);
        e1PlotParam(A, B, C, ms.length && ms[0].num);
        await e1Explain('eq2_param_root', e1PlainParam(A, B, C) + ' ; x0=' + fPlain(xv), 'condition: ' + pPlain(E, 'm') + '=0 ; ' + sm.join(' ; '));
        return;
      }

      // ---- discussion selon m ----
      var Dm = pSub(pMul(B, B), pScale(pMul(A, C), fr(4)));
      var aRoots = exactRealRoots(A), dRoots = exactRealRoots(Dm);
      var t1 = '';
      if(pConst(A)) t1 += '<div class="study-work">a = ' + escapeHtml(fPlain(A[0])) + ' ≠ 0 : l’équation est du second degré pour tout m.</div>';
      else {
        t1 += R.line('Cas a(m) = 0 :', pTex(A, 'm') + ' = 0 ' + BS + 'iff m = ' + aRoots.map(function(x){ return x.tex; }).join(BS + 'text{ ou } m = '));
        aRoots.forEach(function(mr){
          var mv = mr.f || fFromNum(mr.num);
          if(!mv){ t1 += '<div class="study-work">m ≈ ' + mr.num.toFixed(3) + ' : équation du premier degré.</div>'; return; }
          var b0 = pEvalF(B, mv), c0 = pEvalF(C, mv), concl;
          if(!fZero(b0)){ var xs = fDiv(fNeg(c0), b0); concl = 'une seule solution x = ' + fPlain(xs); t1 += R.line('', 'm = ' + mr.tex + ' : ' + pTex([c0, b0], 'x') + ' = 0 ' + BS + 'iff x = ' + fTex(xs)); }
          else { concl = fZero(c0) ? 'tout réel est solution' : 'aucune solution'; t1 += R.line('', 'm = ' + mr.tex + ' : ' + fTex(c0) + ' = 0'); }
          t1 += '<div class="study-work">Pour m = ' + escapeHtml(mr.plain) + ', l’équation est du premier degré : ' + concl + '.</div>';
          sm.push('m=' + mr.plain + ': a=0, ' + concl);
        });
      }
      body += R.sec('Coefficient de x²', t1);

      var t2 = R.line('Pour a(m) ≠ 0 :', BS + 'Delta(m) = b(m)^{2} - 4a(m)c(m) = ' + pTex(Dm, 'm'));
      sm.push('Delta(m)=' + pPlain(Dm, 'm'));
      if(pDeg(Dm) >= 1){
        t2 += R.line('Racines de Δ(m) :', dRoots.length ? dRoots.map(function(x){ return 'm = ' + x.tex; }).join(',' + BS + 'quad ') : BS + 'Delta(m) ' + BS + 'text{ ne s’annule pas}');
        t2 += e1SignTable('m', 'Δ(m)', dRoots, function(m){ return pEvalN(Dm, m); });
      }
      body += R.sec('Discriminant Δ(m)', t2);

      // intervals of m between all critical values
      var crit = aRoots.concat(dRoots).sort(function(x, y){ return x.num - y.num; }).filter(function(x, i, arr){ return i === 0 || Math.abs(x.num - arr[i - 1].num) > 1e-9; });
      var groups = { 2: [], 1: [], 0: [] }, mTwo = null;
      var bounds = [null].concat(crit).concat([null]);
      for(var i = 0; i < bounds.length - 1; i++){
        var lo = bounds[i], hi = bounds[i + 1];
        var tm = (!lo && !hi) ? 0 : !lo ? hi.num - 1 : !hi ? lo.num + 1 : (lo.num + hi.num) / 2;
        var dv = pEvalN(Dm, tm), cnt = pDeg(Dm) < 0 ? 1 : (dv > 1e-12 ? 2 : dv < -1e-12 ? 0 : 1);
        groups[cnt].push(e1Interval(lo, hi));
        if(cnt === 2 && mTwo === null && Math.abs(tm) <= 5) mTwo = Math.round(tm * 10) / 10;
      }
      var t3 = '';
      if(groups[2].length){
        var sol = null; try { sol = e1ParamSolutions(A, B, Dm); } catch(e){ sol = null; }
        var solHtml = '';
        if(sol){
          var big = function(t){ return t.split(BS + 'frac{').join(BS + 'dfrac{'); };
          if(sol.square) solHtml += R.line('Δ(m) est un carré parfait :', BS + 'Delta(m) = ' + pTex(Dm, 'm') + ' = ' + sol.square);
          solHtml += R.line('Solutions en fonction de m :', 'x = ' + big(sol.general));
          solHtml += R.line('', 'x_1 = ' + big(sol.x1) + BS + 'quad ' + BS + 'text{et}' + BS + 'quad x_2 = ' + big(sol.x2));
          if(sol.rational) solHtml += '<div class="study-work">Δ(m) étant un carré parfait, les solutions s’écrivent sans racine carrée.</div>';
        }
        t3 += '<div class="e1-case e1-case--2">' + R.line('Δ(m) > 0 : deux solutions distinctes si', 'm ' + BS + 'in ' + groups[2].join(' ' + BS + 'cup ')) + solHtml + '</div>';
        sm.push('2 solutions si m dans ' + groups[2].join(' U ').split(BS).join('') + (sol ? ' : x1=' + sol.plain1 + ', x2=' + sol.plain2 : ''));
      }
      var doubles = dRoots.filter(function(x){ return !aRoots.some(function(a){ return Math.abs(a.num - x.num) < 1e-9; }); });
      doubles.forEach(function(mr){
        var mv = mr.f || fFromNum(mr.num), xd = '';
        if(mv){ var a0 = pEvalF(A, mv), b0 = pEvalF(B, mv); var x0d = fDiv(fNeg(b0), fMul(fr(2), a0)); xd = BS + ';' + BS + 'Rightarrow' + BS + '; x_0 = -' + BS + 'frac{b}{2a} = ' + fTex(x0d); sm.push('m=' + mr.plain + ': Delta=0, racine double x0=' + fPlain(x0d)); }
        else { var a1 = pEvalN(A, mr.num), b1 = pEvalN(B, mr.num); xd = BS + ';' + BS + 'Rightarrow' + BS + '; x_0 ' + BS + 'approx ' + (Math.round(-b1 / (2 * a1) * 1000) / 1000); sm.push('m=' + mr.plain + ': racine double'); }
        t3 += '<div class="e1-case">' + R.line('Δ(m) = 0 : une solution double si', 'm = ' + mr.tex + xd) + '</div>';
      });
      if(pDeg(Dm) < 0 && groups[1].length) t3 += '<div class="e1-case">' + R.line('Δ(m) = 0 pour tout m : une solution double si', 'm ' + BS + 'in ' + groups[1].join(' ' + BS + 'cup ')) + '</div>';
      if(groups[0].length){ t3 += '<div class="e1-case e1-case--0">' + R.line('Δ(m) < 0 : aucune solution réelle si', 'm ' + BS + 'in ' + groups[0].join(' ' + BS + 'cup ')) + '</div>'; sm.push('0 solution si m dans ' + groups[0].join(' U ').split(BS).join('')); }
      aRoots.forEach(function(mr){ t3 += '<div class="e1-case">' + R.line('a(m) = 0 :', 'm = ' + mr.tex + BS + 'text{ — équation du premier degré (voir ci-dessus)}') + '</div>'; });
      body += R.sec('Conclusion : nombre de solutions selon m', t3);
      R.render('Équation avec paramètre m — discussion', body);
      e1PlotParam(A, B, C, mTwo !== null ? mTwo : 0);
      await e1Explain('eq2_param', e1PlainParam(A, B, C), sm.join(' ; '));
    }
    // ---- solutions as functions of m (case Δ(m) > 0) ----
    function pLcmDen(list){ var L = 1; list.forEach(function(c){ L = L * c.d / (igcd(L, c.d) || 1); }); return L; }
    function pDivmod(A, B){ // polynomial long division with fractions
      A = pTrim(A); B = pTrim(B); var q = [], r = A.slice(), db = pDeg(B);
      for(var i = 0; i <= Math.max(0, pDeg(A) - db); i++) q.push(fr(0));
      while(pDeg(r) >= db && pDeg(r) >= 0){
        var k = pDeg(r) - db, co = fDiv(r[pDeg(r)], B[db]); q[k] = co;
        var sub = []; for(var j = 0; j < k; j++) sub.push(fr(0)); B.forEach(function(c){ sub.push(fMul(c, co)); });
        r = pSub(r, sub);
      }
      return { q: pTrim(q), r: pTrim(r) };
    }
    function pGcd(A, B){ A = pTrim(A); B = pTrim(B); var guard = 0; while(pDeg(B) >= 0 && guard++ < 10){ var t = pDivmod(A, B).r; A = B; B = t; } return pDeg(A) >= 0 ? pScale(A, fDiv(fr(1), A[pDeg(A)])) : A; }
    // Reduce num/den (polynomials in m) to lowest terms with integer coefficients, den leading > 0.
    function e1RatTex(num, den){
      var g = pGcd(num, den); if(pDeg(g) > 0){ num = pDivmod(num, g).q; den = pDivmod(den, g).q; }
      var L = pLcmDen(num.concat(den)), Ni = num.map(function(c){ return c.n * (L / c.d); }), Di = den.map(function(c){ return c.n * (L / c.d); });
      var cg = 0; Ni.concat(Di).forEach(function(v){ cg = igcd(cg, v); }); cg = cg || 1;
      if(Di[pDeg(den)] < 0) cg = -cg;
      var N = Ni.map(function(v){ return fr(v / cg); }), D = Di.map(function(v){ return fr(v / cg); });
      var nt = pTex(N, 'm'), dt = pTex(D, 'm');
      if(pDeg(D) === 0 && D[0].n === 1) return { tex: nt, plain: pPlain(N, 'm') };
      return { tex: BS + 'frac{' + nt + '}{' + dt + '}', plain: '(' + pPlain(N, 'm') + ')/(' + pPlain(D, 'm') + ')' };
    }
    // x = (−b(m) ± √Δ(m)) / (2a(m)), simplified. Returns { general, x1, x2, plain1, plain2 }.
    function e1ParamSolutions(A, B, Dm){
      var N = pScale(B, fr(-1)), D = pScale(A, fr(2));
      var general = BS + 'frac{-b(m) ' + BS + 'pm ' + BS + 'sqrt{' + BS + 'Delta(m)}}{2a(m)} = ' + BS + 'frac{' + (pDeg(N) < 0 ? '' : pTex(N, 'm') + ' ') + BS + 'pm ' + BS + 'sqrt{' + pTex(Dm, 'm') + '}}{' + (pDeg(D) === 0 ? pTex(D, 'm') : '2' + BS + 'left(' + pTex(A, 'm') + BS + 'right)') + '}';
      // √Δ = c·√R with R primitive (integer coefficients), c rational
      var L = pLcmDen(Dm), I = Dm.map(function(c){ return c.n * (L / c.d); }), g = 0;
      I.forEach(function(v){ g = igcd(g, v); }); g = g || 1;
      var sr = simplifyRadical(g * L), c = fr(sr.coef, L);
      var R = pScale(I.map(function(v){ return fr(v / g); }), fr(sr.rad));
      // perfect square R = (u·m + v)² (degree 2) or constant 1
      var S = null;
      if(pDeg(R) === 0 && R[0].n === 1 && R[0].d === 1) S = [fr(1)];
      if(pDeg(R) === 2){
        var p2 = R[2], p1 = R[1], p0 = R[0];
        if(fZero(fSub(fMul(p1, p1), fMul(fr(4), fMul(p2, p0)))) && p2.n > 0){
          var sp = simplifyRadical(p2.n * p2.d);
          if(sp.rad === 1){ var u = fr(sp.coef, p2.d); S = [fDiv(p1, fMul(fr(2), u)), u]; }
        }
      }
      if(S){
        var cS = pScale(S, c);
        var r1 = e1RatTex(pSub(N, cS), D), r2 = e1RatTex(pAdd(N, cS), D);
        var sq = pDeg(cS) >= 1 ? BS + 'left(' + pTex(cS, 'm') + BS + 'right)^{2}' : null;
        return { general: general, x1: r1.tex, x2: r2.tex, plain1: r1.plain, plain2: r2.plain, rational: true, square: sq };
      }
      // integer scaling of N, c, D together, then common factor
      var L2 = pLcmDen(N.concat(D).concat([c]));
      var Ni = N.map(function(x){ return x.n * (L2 / x.d); }), Di = D.map(function(x){ return x.n * (L2 / x.d); }), ci = c.n * (L2 / c.d);
      var cg = Math.abs(ci); Ni.concat(Di).forEach(function(v){ cg = igcd(cg, v); }); cg = cg || 1;
      if(Di[pDeg(D)] < 0) cg = -cg;
      var Nf = Ni.map(function(v){ return fr(v / cg); }), Df = Di.map(function(v){ return fr(v / cg); }), cf = Math.abs(ci / cg);
      var rad = (cf === 1 ? '' : cf) + BS + 'sqrt{' + pTex(R, 'm') + '}', radP = (cf === 1 ? '' : cf) + 'sqrt(' + pPlain(R, 'm') + ')';
      function one(sign){
        var numT = pDeg(Nf) < 0 ? (sign < 0 ? '-' : '') + rad : pTex(Nf, 'm') + (sign < 0 ? ' - ' : ' + ') + rad;
        var numP = pDeg(Nf) < 0 ? (sign < 0 ? '-' : '') + radP : pPlain(Nf, 'm') + (sign < 0 ? ' - ' : ' + ') + radP;
        if(pDeg(Df) === 0 && Df[0].n === 1) return { t: numT, p: numP };
        return { t: BS + 'frac{' + numT + '}{' + pTex(Df, 'm') + '}', p: '(' + numP + ')/(' + pPlain(Df, 'm') + ')' };
      }
      var a1 = one(-1), a2 = one(1);
      return { general: general, x1: a1.t, x2: a2.t, plain1: a1.p, plain2: a2.p, rational: false };
    }

    function e1PlainParam(A, B, C){ return '(' + pPlain(A, 'm') + ')x^2 + (' + pPlain(B, 'm') + ')x + (' + pPlain(C, 'm') + ') = 0'; }
    function e1PlotParam(A, B, C, m0){
      clearE1Plot(); try { ggb.deleteObject('f'); } catch(e){}
      var mInit = isFinite(m0) ? Math.max(-5, Math.min(5, Math.round(m0 * 10) / 10)) : 0;
      try { ggb.evalCommand('m=Slider(-5,5,0.1)'); ggb.setValue('m', mInit); ggb.setVisible('m', true); e1Objs.push('m'); } catch(e){}
      try { ggb.evalCommand('f(x)=(' + pGgb(A, 'm') + ')*x^2+(' + pGgb(B, 'm') + ')*x+(' + pGgb(C, 'm') + ')'); ggb.setColor('f', 94, 23, 235); ggb.setLineThickness('f', 5); e1Objs.push('f'); } catch(e){}
      try { ggb.setCoordSystem(-6, 6, -10, 10); } catch(e){}
      graphHint.textContent = 'Déplacez le curseur m : la parabole change et coupe l’axe des abscisses en 2, 1 ou 0 point(s), comme prévu par le signe de Δ(m).';
    }

    // ---- degré 3 ----
    async function e1RunDeg3(r, op){
      var A = r.a[0], B = r.b[0], C = r.c[0], D = r.d[0], R = e1Report(), body = '', sm = [];
      if(fZero(A)){ stateEl.textContent = 'a = 0 : ce n’est pas une équation de degré 3 (utilisez « Second degré »).'; setE1OpsEnabled(true); return; }
      var P = [D, C, B, A], eqTex = e1EqTex(P, 'x');
      body += R.sec('Équation', R.line('', 'P(x) = ' + pTex(P, 'x')) + R.line('', eqTex));
      var x0 = null, t;

      if(op === 'deg3_root' || op === 'deg3_solve'){
        t = '';
        if(fZero(D)){ x0 = fr(0); t += '<div class="study-work">d = 0 : on peut mettre x en facteur, donc x₀ = 0 est racine évidente.</div>'; }
        else {
          var cands = ratCandidates(P), tested = [];
          for(var i = 0; i < cands.length && !x0; i++){ var val = pEvalF(P, cands[i]); tested.push([cands[i], val]); if(fZero(val)) x0 = cands[i]; }
          var shown = tested.slice(0, 8), row1 = '<th>x</th>', row2 = '<th>P(x)</th>';
          shown.forEach(function(tv){ var z = fZero(tv[1]); row1 += '<td><span data-tex="' + escapeHtml(fTex(tv[0])) + '"></span></td>'; row2 += '<td class="' + (z ? 'e1-zero' : '') + '"><span data-tex="' + escapeHtml(fTex(tv[1])) + '"></span></td>'; });
          t += '<div class="study-work">On teste des valeurs simples (1, −1, 2, −2, …), puis les fractions p/q où p divise d et q divise a :</div>';
          t += '<div class="e1-wrap"><table class="e1-table"><tr>' + row1 + '</tr><tr>' + row2 + '</tr></table></div>';
          if(tested.length > 8 && x0) t += '<div class="study-work">(' + (tested.length - 8) + ' autres valeurs testées)</div>';
        }
        if(!x0){
          t += '<div class="study-line study-ko">✗ Aucune racine rationnelle : pas de racine évidente pour cette équation.</div>';
          body += R.sec('1. Racine évidente', t); R.render('Équation de degré 3', body); stateEl.textContent = ''; setE1OpsEnabled(true); return;
        }
        t += R.line('Racine évidente :', 'P' + BS + 'left(' + fTex(x0) + BS + 'right) = 0 ' + BS + 'quad ' + BS + 'Rightarrow ' + BS + 'quad x_0 = ' + fTex(x0));
        body += R.sec('1. Racine évidente', t);
        e1X0.value = fPlain(x0);
        sm.push('racine evidente x0=' + fPlain(x0));
      } else {
        var xp = e1Parse(e1X0.value);
        if(!xp || !pConst(xp)){ stateEl.textContent = 'Indiquez x₀ (ou lancez l’étape 1 « Racine évidente »).'; setE1OpsEnabled(true); return; }
        x0 = xp[0];
        var chk = pEvalF(P, x0);
        body += R.sec('Racine x₀', R.line('', 'P' + BS + 'left(' + fTex(x0) + BS + 'right) = ' + fTex(chk)) + (fZero(chk) ? '<div class="study-line study-ok">✓ x₀ est bien racine de P.</div>' : '<div class="study-line study-ko">✗ P(x₀) ≠ 0 : x₀ n’est pas racine — la factorisation par (x − x₀) est impossible.</div>'));
        if(!fZero(chk)){ R.render('Équation de degré 3', body); stateEl.textContent = ''; setE1OpsEnabled(true); return; }
        sm.push('x0=' + fPlain(x0));
      }

      var dv = synthDivF(P, x0), Q = dv.q; // Q = [γ, β, α]
      var showMethods = (op === 'deg3_quot' || op === 'deg3_solve');
      if(op !== 'deg3_root'){
        body += R.sec('2. Factorisation par (x − x₀)', R.line('', 'P(x) = ' + BS + 'left(x ' + (x0.n <= 0 ? '+ ' + fTex(fNeg(x0)) : '- ' + fTex(x0)) + BS + 'right)' + BS + 'left(' + pTex(Q, 'x') + BS + 'right)') + (showMethods ? '<div class="study-work">Q(x) est obtenu ci-dessous par les deux méthodes.</div>' : ''));
        sm.push('Q(x)=' + pPlain(Q, 'x'));
      }
      var allRoots = [rootRat(x0)];
      if(op === 'deg3_solveq' || op === 'deg3_solve'){
        var res = e1SolveQuadBlock(R, Q[2], Q[1], Q[0], 'x', Q);
        body += R.sec('3. Résolution de Q(x) = 0', R.line('', pTex(Q, 'x') + ' = 0') + res.html);
        sm.push('Q: ' + res.summary);
        res.roots.forEach(function(rr){ if(!allRoots.some(function(z){ return Math.abs(z.num - rr.num) < 1e-9; })) allRoots.push(rr); });
        allRoots.sort(function(x, y){ return x.num - y.num; });
        var concl = R.line('Solutions de P(x) = 0 :', 'S = ' + BS + 'left' + BS + '{ ' + allRoots.map(function(z){ return z.tex; }).join(' ; ') + ' ' + BS + 'right' + BS + '}');
        var qList = e1FacList(res.roots, 'x', res.delta);
        var lin = e1Fac(rootRat(x0), 'x');
        if(qList) concl += R.line('Forme factorisée :', 'P(x) = ' + e1LeadTex(A) + lin + qList);
        else concl += R.line('Forme factorisée :', 'P(x) = ' + e1LeadTex(A) + lin + BS + 'left(' + pTex(pScale(Q, fDiv(fr(1), A)), 'x') + BS + 'right)' + BS + 'quad ' + BS + 'text{(Q sans racine réelle)}');
        body += R.sec('Conclusion', concl);
        sm.push('S={' + allRoots.map(function(z){ return z.plain; }).join(' ; ') + '}');
      }
      var title = op === 'deg3_root' ? 'Degré 3 — racine évidente' : op === 'deg3_quot' ? 'Degré 3 — détermination de Q(x)' : op === 'deg3_solveq' ? 'Degré 3 — résolution de Q(x) = 0' : 'Équation de degré 3 — résolution complète';
      R.render(title, body);
      if(showMethods){
        var bx = document.createElement('div'); answerEl.appendChild(bx);
        var toC = function(f){ return { re: fVal(f), im: 0 }; };
        try { renderQuotientMethodsFor(bx, [toC(A), toC(B), toC(C), toC(D)], toC(x0), { v: 'x', f: 'P', r: 'x₀' }); } catch(e){ bx.innerHTML = ''; }
      }
      e1Plot(P, (op === 'deg3_solveq' || op === 'deg3_solve') ? allRoots : [rootRat(x0)]);
      setTimeout(fitGraph, 50);
      var opName = { deg3_root: 'eq3_root', deg3_quot: 'eq3_quotient', deg3_solveq: 'eq3_solveq', deg3_solve: 'eq3_solve' }[op];
      await e1Explain(opName, 'P(x) = ' + pPlain(P, 'x') + (op !== 'deg3_root' ? ' ; x0=' + fPlain(x0) : ''), sm.join(' ; '));
    }

    e1RenderExamples();
    try { updateE1Preview(); } catch(e){}
    setE1OpsEnabled(false); // enabled once GeoGebra is ready (appletOnLoad)

    /* ============ SYSTÈME D'ÉQUATIONS (2, 3 ou 4 inconnues) ============ */
    // Exact (fractions from the Équation mode: fr/fAdd/fSub/fMul/fDiv/fTex…). Methods:
    // 2 inconnues → substitution, combinaison linéaire, déterminants (Cramer) + graph of the two lines;
    // 3–4 inconnues → pivot de Gauss with the row operations written out, then back-substitution.
    var modeSys    = document.getElementById('mode-system');
    var sysCountEl = document.getElementById('sys-count');
    var sysGridEl  = document.getElementById('sys-grid');
    var sysExEl    = document.getElementById('sys-ex');
    var sysPrevEl  = document.getElementById('sys-preview');
    var sysOpsEl   = document.getElementById('sys-ops');
    var sysN = 2, sysObjs = [];
    var SYS_VARS = { 2: ['x', 'y'], 3: ['x', 'y', 'z'], 4: ['x', 'y', 'z', 't'] };
    var SYS_EX = {
      2: [ ['Solution unique', [[2, 3, 7], [1, -1, 1]]], ['3x − 2y = 4', [[3, -2, 4], [5, 3, 13]]], ['Aucune solution', [[1, 2, 4], [2, 4, 5]]], ['Infinité de solutions', [[1, 2, 4], [2, 4, 8]]] ],
      3: [ ['Solution unique', [[1, 1, 1, 6], [2, -1, 1, 3], [1, 2, -1, 2]]], ['Avec fractions', [[2, 1, -1, 1], [1, -1, 2, 4], [3, 2, 1, 7]]], ['Infinité de solutions', [[1, 1, 1, 3], [2, 2, 2, 6], [1, -1, 0, 0]]], ['Aucune solution', [[1, 1, 1, 1], [1, 1, 1, 2], [1, -1, 2, 0]]] ],
      4: [ ['Solution unique', [[1, 1, 1, 1, 10], [1, -1, 1, -1, -2], [2, 1, -1, 1, 5], [1, 2, 3, -1, 10]]], ['Système triangulaire', [[1, 2, -1, 1, 4], [0, 1, 1, -1, 1], [0, 0, 2, 1, 7], [0, 0, 0, 3, 6]]] ]
    };

    function setSysOpsEnabled(on){ sysOpsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }
    function clearSysPlot(){ sysObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} }); sysObjs = []; }

    function sysBuildGrid(values){
      var V = SYS_VARS[sysN], html = '';
      for(var i = 0; i < sysN; i++){
        html += '<div class="sys-row"><span class="sys-lbl">(E' + (i + 1) + ')</span>';
        for(var j = 0; j < sysN; j++){
          var v = values && values[i] ? values[i][j] : (i === j ? 1 : 0);
          html += (j ? '<span class="sys-op">+</span>' : '') + '<input type="text" data-r="' + i + '" data-c="' + j + '" value="' + v + '" autocomplete="off" aria-label="coefficient de ' + V[j] + ' dans E' + (i + 1) + '" /><span class="sys-v">' + V[j] + '</span>';
        }
        var rv = values && values[i] ? values[i][sysN] : 0;
        html += '<span class="sys-op">=</span><input type="text" data-r="' + i + '" data-c="' + sysN + '" value="' + rv + '" autocomplete="off" aria-label="second membre de E' + (i + 1) + '" /></div>';
      }
      sysGridEl.innerHTML = html;
      updateSysPreview();
    }
    sysGridEl.addEventListener('input', updateSysPreview);
    function sysRenderExamples(){
      var html = '<span class="pw-ex__lbl"><i class="bi bi-lightbulb"></i> Exemples :</span>';
      SYS_EX[sysN].forEach(function(ex, i){ html += '<button type="button" class="ml-key is-util" data-sysex="' + i + '">' + escapeHtml(ex[0]) + '</button>'; });
      sysExEl.innerHTML = html;
    }
    sysExEl.addEventListener('click', function(ev){
      var b = ev.target.closest('[data-sysex]'); if(!b) return;
      var ex = SYS_EX[sysN][Number(b.getAttribute('data-sysex'))]; if(!ex) return;
      answerEl.innerHTML = ''; stepsEl.innerHTML = ''; stateEl.textContent = '';
      sysBuildGrid(ex[1]);
    });
    function setSysN(n){
      sysN = n;
      sysCountEl.querySelectorAll('.ml-sidebtn').forEach(function(b){ b.classList.toggle('is-active', Number(b.getAttribute('data-sysn')) === n); });
      sysRenderExamples();
      sysBuildGrid(SYS_EX[n][0][1]);
      answerEl.innerHTML = ''; stepsEl.innerHTML = ''; stateEl.textContent = '';
      var gcard = document.getElementById('graph-card'); if(gcard && currentMode === 'system') gcard.hidden = (n !== 2);
      if(n !== 2) clearSysPlot();
    }
    sysCountEl.addEventListener('click', function(ev){ var b = ev.target.closest('.ml-sidebtn'); if(b) setSysN(Number(b.getAttribute('data-sysn'))); });

    // Read the grid → { err } or { M } (rows of fractions, last column = second membre)
    function sysRead(){
      var M = [];
      for(var i = 0; i < sysN; i++){
        var row = [];
        for(var j = 0; j <= sysN; j++){
          var inp = sysGridEl.querySelector('input[data-r="' + i + '"][data-c="' + j + '"]');
          var p = e1Parse(inp ? inp.value : '0');
          if(!p || !pConst(p)) return { err: 'Coefficient invalide dans (E' + (i + 1) + ') : entier ou fraction attendu (ex. -2, 1/2).' };
          row.push(p[0]);
        }
        M.push(row);
      }
      return { M: M };
    }
    // Linear equation as LaTeX: 2x - y + 3z = 5
    function sysLinTex(row, V){
      var out = '', first = true;
      for(var j = 0; j < V.length; j++){
        var c = row[j]; if(fZero(c)) continue;
        var neg = c.n < 0, ab = fr(Math.abs(c.n), c.d), ct = (ab.n === 1 && ab.d === 1) ? '' : fTex(ab);
        out += first ? ((neg ? '-' : '') + ct + V[j]) : ((neg ? ' - ' : ' + ') + ct + V[j]);
        first = false;
      }
      return (out || '0') + ' = ' + fTex(row[V.length]);
    }
    function sysPlain(row, V){ return sysLinTex(row, V).split(BS + 'frac{').join('(').split('}{').join('/').split('}').join(')'); }
    function sysTex(M, V, labels){
      return BS + 'left' + BS + '{' + BS + 'begin{array}{' + (labels ? 'll' : 'l') + '} ' + M.map(function(r, i){ return sysLinTex(r, V) + (labels ? ' & ' + BS + 'scriptsize ' + labels[i] : ''); }).join(' ' + BS + BS + ' ') + ' ' + BS + 'end{array}' + BS + 'right.';
    }
    function updateSysPreview(){
      var r = sysRead();
      if(r.err){ sysPrevEl.className = 'ml-preview is-empty'; sysPrevEl.textContent = r.err; return; }
      try { renderKatex(sysPrevEl, sysTex(r.M, SYS_VARS[sysN])); sysPrevEl.className = 'ml-preview'; }
      catch(e){ sysPrevEl.className = 'ml-preview is-empty'; sysPrevEl.textContent = 'Aperçu indisponible.'; }
    }

    // k·L as LaTeX coefficient prefix: 1 → "", −1 → "-", 2 → "2", 1/2 → (1/2) as a LaTeX fraction
    function sysK(f){ if(f.n === f.d) return ''; if(f.n === -f.d) return '-'; return f.d === 1 ? String(f.n) : fPar(f); }
    function isInt(f){ return f.d === 1; }

    // ---- Gauss elimination with recorded stages ----
    function sysGauss(M0, V){
      var M = M0.map(function(r){ return r.slice(); }), n = V.length, rows = M.length, stages = [], pr = 0, pivots = [];
      var lab = M.map(function(_, i){ return 'L_{' + (i + 1) + '}'; });
      for(var col = 0; col < n && pr < rows; col++){
        var r = -1;
        for(var i = pr; i < rows; i++){ if(!fZero(M[i][col])){ r = i; break; } }
        if(r < 0) continue;
        var ops = [];
        if(r !== pr){ var tmp = M[r]; M[r] = M[pr]; M[pr] = tmp; ops.push(lab[pr] + ' ' + BS + 'leftrightarrow ' + lab[r]); }
        for(var k = pr + 1; k < rows; k++){
          if(fZero(M[k][col])) continue;
          var a = M[pr][col], b = M[k][col], ma, mb;
          if(isInt(a) && isInt(b)){ var g = igcd(a.n, b.n) || 1; ma = fr(a.n / g); mb = fr(b.n / g); if(ma.n < 0){ ma = fNeg(ma); mb = fNeg(mb); } }
          else { ma = fr(1); mb = fDiv(b, a); }
          M[k] = M[k].map(function(v, j){ return fSub(fMul(ma, v), fMul(mb, M[pr][j])); });
          var opT = lab[k] + ' ' + BS + 'leftarrow ' + sysK(ma) + lab[k] + (mb.n < 0 ? ' + ' + sysK(fNeg(mb)) : ' - ' + sysK(mb)) + lab[pr];
          ops.push(opT);
        }
        pivots.push({ row: pr, col: col });
        if(ops.length) stages.push({ col: col, ops: ops, M: M.map(function(rr){ return rr.slice(); }) });
        pr++;
      }
      // contradictions / redundant rows
      var contra = M.some(function(rr){ return rr.slice(0, n).every(fZero) && !fZero(rr[n]); });
      return { M: M, stages: stages, pivots: pivots, rank: pivots.length, contra: contra };
    }
    // Back-substitution (unique solution) with displayed steps
    function sysBack(G, V, R){
      var n = V.length, sol = new Array(n), html = '';
      for(var t = G.pivots.length - 1; t >= 0; t--){
        var pv = G.pivots[t], row = G.M[pv.row], c = row[pv.col], sum = fr(0), parts = [];
        for(var j = pv.col + 1; j < n; j++){ if(!fZero(row[j])){ sum = fAdd(sum, fMul(row[j], sol[j])); parts.push(V[j] + ' = ' + fTex(sol[j])); } }
        var val = fDiv(fSub(row[n], sum), c);
        sol[pv.col] = val;
        var eqT = sysLinTex(row, V);
        var cT = sysK(c);
        if(parts.length){
          var lhs = (cT === '-' ? '-' : cT) + V[pv.col] + (fZero(sum) ? '' : (sum.n < 0 ? ' - ' + fTex(fNeg(sum)) : ' + ' + fTex(sum)));
          html += R.line('', eqT + BS + ';' + BS + 'text{ avec } ' + parts.join(',' + BS + '; ') + BS + ';' + BS + 'Rightarrow' + BS + '; ' + lhs + ' = ' + fTex(row[n]) + BS + ';' + BS + 'Rightarrow' + BS + '; ' + V[pv.col] + ' = ' + fTex(val));
        } else {
          html += R.line('', eqT + BS + ';' + BS + 'Rightarrow' + BS + '; ' + V[pv.col] + ' = ' + fTex(val));
        }
      }
      return { sol: sol, html: html };
    }
    // Infinite solutions: reduced echelon → pivot vars in terms of free vars
    function sysParam(G, V){
      var n = V.length, M = G.M.map(function(r){ return r.slice(); });
      for(var t = G.pivots.length - 1; t >= 0; t--){
        var pv = G.pivots[t], c = M[pv.row][pv.col];
        M[pv.row] = M[pv.row].map(function(v){ return fDiv(v, c); });
        for(var i = 0; i < pv.row; i++){
          var f = M[i][pv.col]; if(fZero(f)) continue;
          M[i] = M[i].map(function(v, j){ return fSub(v, fMul(f, M[pv.row][j])); });
        }
      }
      var pivCols = G.pivots.map(function(p){ return p.col; });
      var free = []; for(var j = 0; j < n; j++) if(pivCols.indexOf(j) < 0) free.push(j);
      var expr = new Array(n);
      free.forEach(function(j){ expr[j] = V[j]; });
      G.pivots.forEach(function(pv){
        var row = M[pv.row], out = fZero(row[n]) ? '' : fTex(row[n]), first = fZero(row[n]);
        free.forEach(function(j){
          var c = fNeg(row[j]); if(fZero(c)) return;
          var neg = c.n < 0, ab = fr(Math.abs(c.n), c.d), ct = (ab.n === 1 && ab.d === 1) ? '' : fTex(ab);
          out += first ? ((neg ? '-' : '') + ct + V[j]) : ((neg ? ' - ' : ' + ') + ct + V[j]); first = false;
        });
        expr[pv.col] = out || '0';
      });
      return { expr: expr, free: free };
    }

    async function runSystem(){
      if(!ggb){ return; }
      var rd = sysRead();
      if(rd.err){ stateEl.textContent = rd.err; return; }
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Résolution…';
      setSysOpsEnabled(false);
      var computed = false;
      try {
        var M = rd.M, V = SYS_VARS[sysN], n = sysN, R = e1Report(), body = '', sm = [], solution = null, status = '';
        var labels = M.map(function(_, i){ return '(E_{' + (i + 1) + '})'; });
        body += R.sec('Système', R.line('', sysTex(M, V, labels)));

        var G = sysGauss(M, V);
        if(n === 2){
          var a1 = M[0][0], b1 = M[0][1], c1 = M[0][2], a2 = M[1][0], b2 = M[1][1], c2 = M[1][2];
          var det = fSub(fMul(a1, b2), fMul(a2, b1));
          if(!fZero(det)){
            var x = fDiv(fSub(fMul(c1, b2), fMul(c2, b1)), det), y = fDiv(fSub(fMul(a1, c2), fMul(a2, c1)), det);
            solution = [x, y]; status = 'unique';
            // Méthode 1 — substitution: pick a coefficient ±1 if possible
            var pick = null;
            [[0, 1], [0, 0], [1, 1], [1, 0]].forEach(function(ij){ if(!pick && Math.abs(M[ij[0]][ij[1]].n) === 1 && M[ij[0]][ij[1]].d === 1) pick = ij; });
            if(!pick){ pick = !fZero(a1) ? [0, 0] : [0, 1]; }
            var i0 = pick[0], j0 = pick[1], o0 = 1 - j0, k0 = 1 - i0, Ei = M[i0], Ek = M[k0];
            var p = fDiv(Ei[2], Ei[j0]), q = fDiv(fNeg(Ei[o0]), Ei[j0]); // v_j = p + q·v_o
            var exprT = pTex([p, q], V[o0]);
            var t1 = R.line('De (E' + (i0 + 1) + ') :', V[j0] + ' = ' + exprT);
            // left side of (Ek) with the substituted unknown replaced by (expr), in x-then-y order
            var subst = '', firstT = true;
            [0, 1].forEach(function(j){
              var c = Ek[j]; if(fZero(c)) return;
              var neg = c.n < 0, ab = fr(Math.abs(c.n), c.d), ct = (ab.n === 1 && ab.d === 1) ? '' : fTex(ab);
              var content = (j === j0) ? BS + 'left(' + exprT + BS + 'right)' : V[j];
              subst += firstT ? ((neg ? '-' : '') + ct + content) : ((neg ? ' - ' : ' + ') + ct + content); firstT = false;
            });
            var cy = fAdd(fMul(Ek[j0], q), Ek[o0]), ry = fSub(Ek[2], fMul(Ek[j0], p)), vo = fDiv(ry, cy);
            t1 += R.line('On remplace dans (E' + (k0 + 1) + ') :', (subst || '0') + ' = ' + fTex(Ek[2]) + BS + ';' + BS + 'iff' + BS + '; ' + sysK(cy) + V[o0] + ' = ' + fTex(ry) + BS + ';' + BS + 'iff' + BS + '; ' + V[o0] + ' = ' + fTex(vo));
            var qT = fZero(q) ? '' : (q.n === q.d ? fPar(vo) : q.n === -q.d ? '-' + fPar(vo) : fTex(q) + ' ' + BS + 'times ' + fPar(vo));
            var pT = fZero(p) ? '' : (p.n < 0 ? ' - ' + fTex(fNeg(p)) : (qT ? ' + ' : '') + fTex(p));
            t1 += R.line('Puis :', V[j0] + ' = ' + ((qT + pT) || '0') + ' = ' + fTex(fAdd(p, fMul(q, vo))));
            // Méthode 2 — combinaison: eliminate y, then x
            function comb(ci){ // eliminate variable ci (0 or 1) → solve for the other
              var A = M[0][ci], B = M[1][ci], m1, m2;
              if(isInt(A) && isInt(B)){ var g = igcd(A.n, B.n) || 1; m1 = fr(B.n / g); m2 = fr(A.n / g); } else { m1 = B; m2 = A; }
              if(m1.n < 0){ m1 = fNeg(m1); m2 = fNeg(m2); }
              var other = 1 - ci, co = fSub(fMul(m1, M[0][other]), fMul(m2, M[1][other])), rh = fSub(fMul(m1, M[0][2]), fMul(m2, M[1][2]));
              var opT = sysK(m1) + '(E_1)' + (m2.n < 0 ? ' + ' + sysK(fNeg(m2)) : ' - ' + sysK(m2)) + '(E_2)';
              return R.line('On élimine ' + V[ci] + ' : ' , opT + BS + ';' + BS + 'Rightarrow' + BS + '; ' + sysK(co) + V[other] + ' = ' + fTex(rh) + BS + ';' + BS + 'Rightarrow' + BS + '; ' + V[other] + ' = ' + fTex(fDiv(rh, co)));
            }
            var t2 = comb(1) + comb(0);
            // Méthode 3 — déterminants
            var vm = function(a, b, c, d){ return BS + 'begin{vmatrix} ' + fTex(a) + ' & ' + fTex(b) + ' ' + BS + BS + ' ' + fTex(c) + ' & ' + fTex(d) + ' ' + BS + 'end{vmatrix}'; };
            var Dx = fSub(fMul(c1, b2), fMul(c2, b1)), Dy = fSub(fMul(a1, c2), fMul(a2, c1));
            var t3 = R.line('', BS + 'det = ' + vm(a1, b1, a2, b2) + ' = ' + fPar(a1) + BS + 'times ' + fPar(b2) + ' - ' + fPar(a2) + BS + 'times ' + fPar(b1) + ' = ' + fTex(det) + ' ' + BS + 'neq 0');
            t3 += R.line('', 'x = ' + BS + 'dfrac{' + vm(c1, b1, c2, b2) + '}{' + BS + 'det} = ' + BS + 'dfrac{' + fTex(Dx) + '}{' + fTex(det) + '} = ' + fTex(x) + BS + 'qquad y = ' + BS + 'dfrac{' + vm(a1, c1, a2, c2) + '}{' + BS + 'det} = ' + BS + 'dfrac{' + fTex(Dy) + '}{' + fTex(det) + '} = ' + fTex(y));
            body += R.sec('Résolution — trois méthodes',
              '<div class="sys-meth"><div class="sys-meth__t">Méthode 1 — Substitution</div>' + t1 + '</div>' +
              '<div class="sys-meth"><div class="sys-meth__t">Méthode 2 — Combinaison linéaire</div>' + t2 + '</div>' +
              '<div class="sys-meth"><div class="sys-meth__t">Méthode 3 — Déterminants (Cramer)</div>' + t3 + '</div>');
            sm.push('det=' + fPlain(det) + ' ; substitution depuis E' + (i0 + 1) + ': ' + V[j0] + '=' + pPlain([p, q], V[o0]));
          } else {
            var t0 = R.line('Déterminant :', BS + 'det = ' + fPar(a1) + BS + 'times ' + fPar(b2) + ' - ' + fPar(a2) + BS + 'times ' + fPar(b1) + ' = 0');
            t0 += '<div class="study-work">Le déterminant est nul : les deux droites sont parallèles (ou confondues). On combine les équations pour conclure.</div>';
            G.stages.forEach(function(st){ t0 += R.line('', st.ops.join(BS + ';,' + BS + '; ') + BS + ';' + BS + 'Rightarrow' + BS + '; ' + sysTex(st.M, V)); });
            body += R.sec('Résolution', t0);
            sm.push('det=0');
          }
        }

        if(n > 2 || (n === 2 && !solution)){
          if(n > 2){
            var tg = '<div class="study-work">Méthode du pivot de Gauss : on élimine une inconnue après l’autre par combinaisons de lignes, pour obtenir un système triangulaire.</div>';
            G.stages.forEach(function(st, k){
              var onlySwap = st.ops.every(function(o){ return o.indexOf('leftrightarrow') >= 0; });
              var what = onlySwap ? 'on échange deux lignes (pivot non nul pour ' + V[st.col] + ')' : 'on élimine ' + V[st.col];
              tg += '<div class="sys-stage">' + R.line('Étape ' + (k + 1) + ' — ' + what + ' :', st.ops.join(BS + ';,' + BS + '; ')) + R.line('', sysTex(st.M, V)) + '</div>';
            });
            if(!G.stages.length) tg += '<div class="study-work">Le système est déjà triangulaire.</div>';
            body += R.sec('Pivot de Gauss', tg);
            sm.push('pivot de Gauss: ' + G.stages.map(function(st){ return st.ops.join(', '); }).join(' ; ').split(BS + 'leftarrow').join('<-').split(BS + 'leftrightarrow').join('<->').split(BS).join('').slice(0, 220));
          }
          if(G.contra){ status = 'none'; }
          else if(G.rank === n){
            status = 'unique';
            var bk = sysBack(G, V, R);
            solution = bk.sol;
            body += R.sec('Remontée (substitution)', bk.html);
          } else status = 'infinite';
        }

        var concl = '';
        if(status === 'unique'){
          concl += R.line('Solution :', 'S = ' + BS + 'left' + BS + '{' + BS + 'left(' + solution.map(fTex).join(' ; ') + BS + 'right)' + BS + 'right' + BS + '}');
          var chk = M.map(function(row, i){ var s = fr(0); for(var j = 0; j < n; j++) s = fAdd(s, fMul(row[j], solution[j])); return fZero(fSub(s, row[n])); });
          concl += '<div class="study-line ' + (chk.every(Boolean) ? 'study-ok">✓ Vérification : la solution satisfait les ' + n + ' équations de départ.' : 'study-ko">Vérification en échec.') + '</div>';
          sm.push('solution unique (' + V.join(';') + ')=(' + solution.map(fPlain).join(' ; ') + ')');
        } else if(status === 'none'){
          concl += '<div class="study-line study-ko">✗ Une ligne devient « 0 = nombre non nul » : le système est incompatible.</div>';
          concl += R.line('Solution :', 'S = ' + BS + 'varnothing');
          sm.push('aucune solution (incompatible)');
        } else {
          var pm = sysParam(G, V);
          concl += '<div class="study-work">Une équation est redondante (« 0 = 0 ») : il y a moins d’équations indépendantes que d’inconnues.</div>';
          concl += R.line('Infinité de solutions :', 'S = ' + BS + 'left' + BS + '{' + BS + 'left(' + pm.expr.join(' ; ') + BS + 'right) ' + BS + ';' + BS + 'big|' + BS + '; ' + pm.free.map(function(j){ return V[j]; }).join(', ') + ' ' + BS + 'in ' + BS + 'mathbb{R}' + BS + 'right' + BS + '}');
          sm.push('infinite de solutions: (' + pm.expr.join(' ; ').split(BS + 'frac{').join('(').split('}{').join('/').split('}').join(')') + '), ' + pm.free.map(function(j){ return V[j]; }).join(',') + ' reels');
        }
        body += R.sec('Conclusion', concl);
        R.render('Système de ' + n + ' équations à ' + n + ' inconnues', body);

        computed = true;
        if(n === 2) sysPlot(M, solution);
        stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';
        var defStr = M.map(function(r){ return sysPlain(r, V); }).join(' ; ');
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ function: ('[' + n + ' inconnues] ' + defStr).slice(0, 200), operation: 'system', casResult: sm.join(' | ').slice(0, 495) }) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); } else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){ stateEl.textContent = computed ? 'Connexion impossible — réessayez.' : 'Résolution impossible — vérifiez les coefficients.'; }
      finally { setSysOpsEnabled(true); }
    }
    sysOpsEl.addEventListener('click', function(ev){ var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return; runSystem(); });

    function sysPlot(M, solution){
      clearSysPlot(); try { ggb.deleteObject('f'); } catch(e){}
      var cols = [[94, 23, 235], [50, 44, 77]];
      M.forEach(function(r, i){
        var nm = 'sysD' + (i + 1), eq = '(' + r[0].n + '/' + r[0].d + ')*x+(' + r[1].n + '/' + r[1].d + ')*y=(' + r[2].n + '/' + r[2].d + ')';
        try { ggb.evalCommand(nm + ':' + eq); ggb.setColor(nm, cols[i][0], cols[i][1], cols[i][2]); ggb.setLineThickness(nm, 5); ggb.setLabelVisible(nm, false); sysObjs.push(nm); } catch(e){}
      });
      var cx = 0, cy = 0;
      if(solution){
        cx = fVal(solution[0]); cy = fVal(solution[1]);
        try { ggb.evalCommand('SysI=(' + cx + ',' + cy + ')'); ggb.setColor('SysI', 255, 194, 58); ggb.setPointSize('SysI', 7); ggb.setLabelVisible('SysI', false); sysObjs.push('SysI'); } catch(e){}
      }
      try { ggb.setCoordSystem(cx - 6, cx + 6, cy - 5, cy + 5); } catch(e){}
    }

    sysRenderExamples();
    sysBuildGrid(SYS_EX[2][0][1]);
    setSysOpsEnabled(false); // enabled once GeoGebra is ready (appletOnLoad)

    /* ============ BARYCENTRE (2, 3 ou 4 points pondérés) ============ */
    // Exact fractions (fr/fAdd/… from the Équation mode). G = bar{(Aᵢ, aᵢ)} exists iff Σaᵢ ≠ 0;
    // construction by associativity through partial barycentres; locus ‖Σ aᵢ·MAᵢ‖ = k.
    var modeBary    = document.getElementById('mode-bary');
    var baryCountEl = document.getElementById('bary-count');
    var baryGridEl  = document.getElementById('bary-grid');
    var baryExEl    = document.getElementById('bary-ex');
    var baryPrevEl  = document.getElementById('bary-preview');
    var baryOpsEl   = document.getElementById('bary-ops');
    var baryKEl     = document.getElementById('bary-k');
    var baryN = 2, baryObjs = [];
    var BARY_NAMES = ['A', 'B', 'C', 'D'];
    var BARY_EX = {
      2: [ ['Poids 1 et 2', [[1, 2, 1], [4, 5, 2]]], ['Poids opposés (somme 0)', [[0, 0, 1], [2, 0, -1]]], ['Poids 3 et −1', [[1, 1, 3], [3, 2, -1]]] ],
      3: [ ['Isobarycentre (centre de gravité)', [[0, 0, 1], [6, 0, 1], [0, 6, 1]]], ['Poids 2, −1, 1', [[1, 1, 2], [5, 3, -1], [2, 6, 1]]], ['Somme des poids nulle', [[0, 0, 1], [4, 0, 1], [2, 3, -2]]] ],
      4: [ ['Centre d’un carré', [[0, 0, 1], [4, 0, 1], [4, 4, 1], [0, 4, 1]]], ['Poids 1, 2, 3, 4', [[0, 0, 1], [5, 0, 2], [5, 5, 3], [0, 5, 4]]] ]
    };

    function setBaryOpsEnabled(on){ baryOpsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }
    function clearBaryPlot(){ baryObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} }); baryObjs = []; }

    function baryBuildGrid(values){
      var html = '';
      for(var i = 0; i < baryN; i++){
        var v = (values && values[i]) || [0, 0, 1];
        html += '<div class="sys-row"><span class="sys-lbl">' + BARY_NAMES[i] + '</span>'
          + '<span class="sys-op">x =</span><input type="text" data-r="' + i + '" data-c="0" value="' + v[0] + '" autocomplete="off" aria-label="abscisse de ' + BARY_NAMES[i] + '" />'
          + '<span class="sys-op">y =</span><input type="text" data-r="' + i + '" data-c="1" value="' + v[1] + '" autocomplete="off" aria-label="ordonnée de ' + BARY_NAMES[i] + '" />'
          + '<span class="sys-op">poids</span><input type="text" data-r="' + i + '" data-c="2" value="' + v[2] + '" autocomplete="off" aria-label="poids de ' + BARY_NAMES[i] + '" /></div>';
      }
      baryGridEl.innerHTML = html;
      updateBaryPreview();
    }
    baryGridEl.addEventListener('input', updateBaryPreview);
    function baryRenderExamples(){
      var html = '<span class="pw-ex__lbl"><i class="bi bi-lightbulb"></i> Exemples :</span>';
      BARY_EX[baryN].forEach(function(ex, i){ html += '<button type="button" class="ml-key is-util" data-baryex="' + i + '">' + escapeHtml(ex[0]) + '</button>'; });
      baryExEl.innerHTML = html;
    }
    baryExEl.addEventListener('click', function(ev){
      var b = ev.target.closest('[data-baryex]'); if(!b) return;
      var ex = BARY_EX[baryN][Number(b.getAttribute('data-baryex'))]; if(!ex) return;
      answerEl.innerHTML = ''; stepsEl.innerHTML = ''; stateEl.textContent = '';
      baryBuildGrid(ex[1]);
    });
    function setBaryN(n){
      baryN = n;
      baryCountEl.querySelectorAll('.ml-sidebtn').forEach(function(b){ b.classList.toggle('is-active', Number(b.getAttribute('data-baryn')) === n); });
      baryRenderExamples(); baryBuildGrid(BARY_EX[n][0][1]);
      answerEl.innerHTML = ''; stepsEl.innerHTML = ''; stateEl.textContent = '';
    }
    baryCountEl.addEventListener('click', function(ev){ var b = ev.target.closest('.ml-sidebtn'); if(b) setBaryN(Number(b.getAttribute('data-baryn'))); });

    function baryRead(){
      var P = [];
      for(var i = 0; i < baryN; i++){
        var row = [];
        for(var j = 0; j < 3; j++){
          var inp = baryGridEl.querySelector('input[data-r="' + i + '"][data-c="' + j + '"]');
          var p = e1Parse(inp ? inp.value : '0');
          if(!p || !pConst(p)) return { err: 'Valeur invalide pour le point ' + BARY_NAMES[i] + ' : entier ou fraction attendu.' };
          row.push(p[0]);
        }
        P.push({ name: BARY_NAMES[i], x: row[0], y: row[1], w: row[2] });
      }
      return { P: P };
    }
    function baryBarTex(P){ return BS + 'mathrm{bar}' + BS + 'left' + BS + '{' + P.map(function(p){ return '(' + p.name + ' ; ' + fTex(p.w) + ')'; }).join(',' + BS + ' ') + BS + 'right' + BS + '}'; }
    function baryPt(p){ return p.name + BS + 'left(' + fTex(p.x) + ' ; ' + fTex(p.y) + BS + 'right)'; }
    function updateBaryPreview(){
      var r = baryRead();
      if(r.err){ baryPrevEl.className = 'ml-preview is-empty'; baryPrevEl.textContent = r.err; return; }
      try { renderKatex(baryPrevEl, r.P.map(baryPt).join(',' + BS + 'quad ') + BS + 'qquad G = ' + baryBarTex(r.P)); baryPrevEl.className = 'ml-preview'; }
      catch(e){ baryPrevEl.className = 'ml-preview is-empty'; baryPrevEl.textContent = 'Aperçu indisponible.'; }
    }
    function vec(a, b){ return BS + 'overrightarrow{' + a + b + '}'; }
    // Σ aᵢ·(vector from X to Aᵢ) written with a leading-sign style: 2GA - GB + 3GC
    function barySumTex(P, from){
      var out = '', first = true;
      P.forEach(function(p){
        var w = p.w; if(fZero(w)) return;
        var neg = w.n < 0, ab = fr(Math.abs(w.n), w.d), ct = (ab.n === 1 && ab.d === 1) ? '' : fTex(ab);
        out += first ? ((neg ? '-' : '') + ct + vec(from, p.name)) : ((neg ? ' - ' : ' + ') + ct + vec(from, p.name)); first = false;
      });
      return out || BS + 'vec{0}';
    }
    // weighted mean of a coordinate with the substitution shown
    function baryCoordTex(P, key, S, label){
      var parts = P.map(function(p){ return fPar(p.w) + ' ' + BS + 'times ' + fPar(p[key]); }).join(' + ');
      var num = P.reduce(function(acc, p){ return fAdd(acc, fMul(p.w, p[key])); }, fr(0));
      return label + ' = ' + BS + 'dfrac{' + parts + '}{' + fTex(S) + '} = ' + BS + 'dfrac{' + fTex(num) + '}{' + fTex(S) + '} = ' + fTex(fDiv(num, S));
    }
    // An order of the points whose partial sums of weights (from 2 points on) are all ≠ 0.
    function baryOrder(P){
      var idx = P.map(function(_, i){ return i; }), best = null;
      function perm(a, k){
        if(best) return;
        if(k === a.length){
          var s = fr(0), ok = true;
          for(var i = 0; i < a.length; i++){ s = fAdd(s, P[a[i]].w); if(i >= 1 && fZero(s)) ok = false; if(i === 0 && fZero(P[a[0]].w)) ok = false; }
          if(ok) best = a.slice(); return;
        }
        for(var j = k; j < a.length; j++){ var t = a[k]; a[k] = a[j]; a[j] = t; perm(a, k + 1); t = a[k]; a[k] = a[j]; a[j] = t; }
      }
      perm(idx, 0);
      return best;
    }

    async function runBary(op){
      if(!ggb){ return; }
      var rd = baryRead();
      if(rd.err){ stateEl.textContent = rd.err; return; }
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul…';
      setBaryOpsEnabled(false);
      var computed = false;
      try {
        var P = rd.P, R = e1Report(), body = '', sm = [];
        var S = P.reduce(function(acc, p){ return fAdd(acc, p.w); }, fr(0));
        var Gx = null, Gy = null, partials = [], locus = null;
        body += R.sec('Données', R.line('', P.map(baryPt).join(',' + BS + 'quad ')) + R.line('Poids :', P.map(function(p){ return p.name + ' : ' + fTex(p.w); }).join(',' + BS + 'quad ')));
        var sumTex = P.map(function(p){ return fPar(p.w); }).join(' + ') + ' = ' + fTex(S);

        if(!fZero(S)){
          Gx = fDiv(P.reduce(function(a, p){ return fAdd(a, fMul(p.w, p.x)); }, fr(0)), S);
          Gy = fDiv(P.reduce(function(a, p){ return fAdd(a, fMul(p.w, p.y)); }, fr(0)), S);
          var t = R.line('Existence :', BS + 'textstyle' + BS + 'sum a_i = ' + sumTex + ' ' + BS + 'neq 0' + BS + ';' + BS + 'Rightarrow' + BS + '; G = ' + baryBarTex(P) + BS + 'text{ existe}');
          t += R.line('Définition :', barySumTex(P, 'G') + ' = ' + BS + 'vec{0}');
          t += R.line('Relation fondamentale :', BS + 'text{pour tout point } M,' + BS + '; ' + barySumTex(P, 'M') + ' = ' + (S.n === S.d ? '' : fPar(S)) + vec('M', 'G'));
          body += R.sec('Le barycentre G', t);
          var tc = R.line('', baryCoordTex(P, 'x', S, 'x_G')) + R.line('', baryCoordTex(P, 'y', S, 'y_G'));
          tc += R.line('Résultat :', 'G' + BS + 'left(' + fTex(Gx) + ' ; ' + fTex(Gy) + BS + 'right)');
          body += R.sec('Coordonnées de G', tc);
          sm.push('somme des poids=' + fPlain(S) + ' ; G(' + fPlain(Gx) + ' ; ' + fPlain(Gy) + ')');

          // construction
          var tcons = '';
          if(P.length === 2){
            var A = P[0], B = P[1], k = fDiv(B.w, S);
            var ABx = fSub(B.x, A.x), ABy = fSub(B.y, A.y);
            var irreducible = isInt(B.w) && isInt(S) && S.n > 0 && igcd(B.w.n, S.n) === 1;
            tcons += R.line('', vec('A', 'G') + ' = ' + BS + 'dfrac{b}{a + b}' + vec('A', 'B') + ' = ' + BS + 'dfrac{' + fTex(B.w) + '}{' + fTex(S) + '}' + vec('A', 'B') + (irreducible ? '' : ' = ' + fTex(k) + BS + ',' + vec('A', 'B')) + BS + 'quad ' + BS + 'text{avec } ' + vec('A', 'B') + BS + 'begin{pmatrix} ' + fTex(ABx) + ' ' + BS + BS + ' ' + fTex(ABy) + ' ' + BS + 'end{pmatrix}');
            var kv = fVal(k);
            tcons += '<div class="study-work">' + (kv > 0 && kv < 1 ? 'G est sur le segment [AB]' : 'G est sur la droite (AB), en dehors du segment [AB]') + (Math.abs(kv - 0.5) < 1e-12 ? ' : c’est le milieu de [AB] (poids égaux).' : '.') + '</div>';
            sm.push('AG=' + fPlain(k) + ' AB');
          } else {
            var ord = baryOrder(P);
            if(ord){
              var cur = { name: P[ord[0]].name, x: P[ord[0]].x, y: P[ord[0]].y, w: P[ord[0]].w };
              tcons += '<div class="study-work">Associativité : on remplace des points par leur barycentre partiel, affecté de la somme de leurs poids.</div>';
              for(var s2 = 1; s2 < ord.length; s2++){
                var nx = P[ord[s2]], ws = fAdd(cur.w, nx.w);
                var hx = fDiv(fAdd(fMul(cur.w, cur.x), fMul(nx.w, nx.x)), ws), hy = fDiv(fAdd(fMul(cur.w, cur.y), fMul(nx.w, nx.y)), ws);
                var last = (s2 === ord.length - 1), hname = last ? 'G' : 'H_' + s2, hplain = last ? 'G' : 'H' + s2;
                var kk = fDiv(nx.w, ws);
                tcons += R.line(last ? 'Enfin :' : 'Étape ' + s2 + ' :', hname + ' = ' + BS + 'mathrm{bar}' + BS + 'left' + BS + '{(' + cur.name + ' ; ' + fTex(cur.w) + '),' + BS + ' (' + nx.name + ' ; ' + fTex(nx.w) + ')' + BS + 'right' + BS + '}' + BS + ';' + BS + 'Rightarrow' + BS + '; ' + vec(cur.name, hname) + ' = ' + fTex(kk) + BS + ',' + vec(cur.name, nx.name) + ',' + BS + 'quad ' + hname + BS + 'left(' + fTex(hx) + ' ; ' + fTex(hy) + BS + 'right)');
                if(!last) partials.push({ name: 'H' + s2, x: hx, y: hy, from: cur, to: nx });
                else partials.push({ name: 'G', x: hx, y: hy, from: cur, to: nx, last: true });
                cur = { name: hname, x: hx, y: hy, w: ws, plain: hplain };
              }
              sm.push('construction par associativite: ' + ord.map(function(i){ return P[i].name; }).join(' puis '));
            } else tcons += '<div class="study-work">Aucun regroupement de points n’a une somme de poids non nulle : on utilise directement les coordonnées.</div>';
          }
          body += R.sec('Construction de G', tcons);
        } else {
          var ux = P.reduce(function(a, p){ return fAdd(a, fMul(p.w, p.x)); }, fr(0)), uy = P.reduce(function(a, p){ return fAdd(a, fMul(p.w, p.y)); }, fr(0));
          var tz = R.line('Existence :', BS + 'textstyle' + BS + 'sum a_i = ' + sumTex + BS + ';' + BS + 'Rightarrow' + BS + '; ' + BS + 'text{pas de barycentre}');
          tz += '<div class="study-work">Quand la somme des poids est nulle, le vecteur Σ aᵢ·MAᵢ ne dépend pas du point M : il est constant.</div>';
          tz += R.line('', BS + 'vec{u} = ' + barySumTex(P, 'M') + ' = ' + barySumTex(P, 'O') + ' = ' + BS + 'begin{pmatrix} ' + fTex(ux) + ' ' + BS + BS + ' ' + fTex(uy) + ' ' + BS + 'end{pmatrix}');
          body += R.sec('Somme des poids nulle', tz);
          sm.push('somme des poids nulle: pas de barycentre ; vecteur constant u(' + fPlain(ux) + ' ; ' + fPlain(uy) + ')');
          locus = { zero: true, ux: ux, uy: uy };
        }

        if(op === 'locus'){
          var kp = e1Parse(baryKEl.value);
          if(!kp || !pConst(kp)){ stateEl.textContent = 'Indiquez un nombre k.'; setBaryOpsEnabled(true); return; }
          var K = kp[0], tl = '';
          if(!fZero(S)){
            tl += R.line('', barySumTex(P, 'M') + ' = ' + (S.n === S.d ? '' : fPar(S)) + vec('M', 'G') + BS + ';' + BS + 'Rightarrow' + BS + '; ' + BS + 'left' + BS + '|' + barySumTex(P, 'M') + BS + 'right' + BS + '| = ' + fTex(fr(Math.abs(S.n), S.d)) + BS + ',MG');
            if(K.n < 0){ tl += R.line('', fTex(fr(Math.abs(S.n), S.d)) + BS + ',MG = ' + fTex(K) + ' < 0'); tl += '<div class="study-line study-ko">Une distance est positive : l’ensemble est vide.</div>'; sm.push('ligne de niveau k=' + fPlain(K) + ': ensemble vide'); }
            else if(fZero(K)){ tl += '<div class="study-line study-ok">MG = 0 : l’ensemble est réduit au point G.</div>'; sm.push('ligne de niveau k=0: le point G'); }
            else {
              var rad = fDiv(K, fr(Math.abs(S.n), S.d));
              tl += R.line('', fTex(fr(Math.abs(S.n), S.d)) + BS + ',MG = ' + fTex(K) + BS + ';' + BS + 'iff' + BS + '; MG = ' + fTex(rad));
              tl += '<div class="study-line study-ok">✓ L’ensemble des points M est le cercle de centre G et de rayon ' + escapeHtml(fPlain(rad)) + '.</div>';
              locus = { circle: true, r: rad };
              sm.push('ligne de niveau k=' + fPlain(K) + ': cercle de centre G et de rayon ' + fPlain(rad));
            }
          } else {
            var nu2 = fAdd(fMul(locus.ux, locus.ux), fMul(locus.uy, locus.uy));
            tl += R.line('', BS + 'left' + BS + '|' + BS + 'vec{u}' + BS + 'right' + BS + '|^{2} = ' + fTex(nu2) + BS + 'quad ' + BS + 'text{(constant)}');
            var same = (K.n >= 0) && fZero(fSub(fMul(K, K), nu2));
            tl += '<div class="study-line ' + (same ? 'study-ok">✓ ‖u‖ = k : tout point M du plan convient.' : 'study-ko">‖u‖ ≠ k : aucun point M ne convient (ensemble vide).') + '</div>';
            sm.push('ligne de niveau: ' + (same ? 'tout le plan' : 'ensemble vide'));
          }
          body += R.sec('Ensemble des points M tels que ‖Σ aᵢ·MAᵢ‖ = ' + escapeHtml(fPlain(K)), tl);
        }

        R.render(op === 'locus' ? 'Barycentre — ligne de niveau' : 'Barycentre de points pondérés', body);
        computed = true;
        baryPlot(P, Gx, Gy, partials, locus);
        stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';
        var defStr = P.map(function(p){ return p.name + '(' + fPlain(p.x) + ';' + fPlain(p.y) + ') poids ' + fPlain(p.w); }).join(', ') + (op === 'locus' ? ' ; k=' + baryKEl.value.trim() : '');
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ function: defStr.slice(0, 200), operation: op === 'locus' ? 'bary_locus' : 'barycentre', casResult: sm.join(' | ').slice(0, 495) }) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); } else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){ stateEl.textContent = computed ? 'Connexion impossible — réessayez.' : 'Calcul impossible — vérifiez les valeurs.'; }
      finally { setBaryOpsEnabled(true); }
    }
    baryOpsEl.addEventListener('click', function(ev){ var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return; runBary(btn.getAttribute('data-baryop')); });

    function baryPlot(P, Gx, Gy, partials, locus){
      clearBaryPlot(); try { ggb.deleteObject('f'); } catch(e){}
      function add(nm, cmd){ try { ggb.evalCommand(nm + '=' + cmd); baryObjs.push(nm); return true; } catch(e){ return false; } }
      var xs = [], ys = [];
      P.forEach(function(p){
        var nm = 'Bry' + p.name;
        if(add(nm, '(' + fVal(p.x) + ',' + fVal(p.y) + ')')){
          try { ggb.setColor(nm, 94, 23, 235); ggb.setPointSize(nm, 6); ggb.setCaption(nm, p.name + ' (' + fPlain(p.w) + ')'); ggb.setLabelStyle(nm, 3); ggb.setLabelVisible(nm, true); } catch(e){}
        }
        xs.push(fVal(p.x)); ys.push(fVal(p.y));
      });
      // polygon outline for 3–4 points
      if(P.length >= 3){
        if(add('bryPoly', 'Polygon(' + P.map(function(p){ return 'Bry' + p.name; }).join(',') + ')')){ try { ggb.setColor('bryPoly', 94, 23, 235); ggb.setFilling('bryPoly', 0.05); ggb.setLabelVisible('bryPoly', false); } catch(e){} }
      } else if(add('bryAB', 'Line(BryA,BryB)')){ try { ggb.setColor('bryAB', 180, 170, 210); ggb.setLabelVisible('bryAB', false); } catch(e){} }
      (partials || []).forEach(function(h, i){
        var nm = h.last ? 'BryG' : 'BryH' + (i + 1);
        if(!h.last && add(nm, '(' + fVal(h.x) + ',' + fVal(h.y) + ')')){
          try { ggb.setColor(nm, 50, 44, 77); ggb.setPointSize(nm, 4); ggb.setCaption(nm, 'H' + (i + 1)); ggb.setLabelStyle(nm, 3); ggb.setLabelVisible(nm, true); } catch(e){}
        }
        var sn = 'brySeg' + (i + 1), fx = fVal(h.from.x), fy = fVal(h.from.y), tx = fVal(h.to.x), ty = fVal(h.to.y);
        if(add(sn, 'Segment((' + fx + ',' + fy + '),(' + tx + ',' + ty + '))')){ try { ggb.setColor(sn, 50, 44, 77); ggb.setLineStyle(sn, 1); ggb.setLabelVisible(sn, false); } catch(e){} }
      });
      if(Gx !== null){
        if(add('BryG', '(' + fVal(Gx) + ',' + fVal(Gy) + ')')){
          try { ggb.setColor('BryG', 255, 194, 58); ggb.setPointSize('BryG', 8); ggb.setCaption('BryG', 'G'); ggb.setLabelStyle('BryG', 3); ggb.setLabelVisible('BryG', true); } catch(e){}
        }
        xs.push(fVal(Gx)); ys.push(fVal(Gy));
        if(locus && locus.circle){
          var r = fVal(locus.r);
          if(add('bryCircle', 'Circle(BryG,' + r + ')')){ try { ggb.setColor('bryCircle', 255, 194, 58); ggb.setLineThickness('bryCircle', 6); ggb.setLabelVisible('bryCircle', false); } catch(e){} }
          xs.push(fVal(Gx) - r, fVal(Gx) + r); ys.push(fVal(Gy) - r, fVal(Gy) + r);
        }
      }
      var xmin = Math.min.apply(null, xs), xmax = Math.max.apply(null, xs), ymin = Math.min.apply(null, ys), ymax = Math.max.apply(null, ys);
      var pad = Math.max(1.5, 0.2 * Math.max(xmax - xmin, ymax - ymin));
      // Orthonormal frame (circles stay circles) that still contains every point:
      // same units-per-pixel on both axes, from the applet's pixel size.
      var host = document.getElementById('ggb'), W = (host && host.clientWidth) || 800, H = (host && host.clientHeight) || 480;
      var xr = (xmax - xmin) + 2 * pad, yr = (ymax - ymin) + 2 * pad, upp = Math.max(xr / W, yr / H);
      var cx = (xmin + xmax) / 2, cy = (ymin + ymax) / 2;
      try { ggb.setCoordSystem(cx - upp * W / 2, cx + upp * W / 2, cy - upp * H / 2, cy + upp * H / 2); } catch(e){}
    }

    baryRenderExamples();
    baryBuildGrid(BARY_EX[2][0][1]);
    setBaryOpsEnabled(false); // enabled once GeoGebra is ready (appletOnLoad)

    /* ============ NOMBRES COMPLEXES — TRANSFORMATION Z = f(z) ============ */
    // z = x + iy, Z = X + iY. Exact (fractions fr/fAdd/… from the Équation mode).
    // Two representations: (1) rational function in z — num/den complex polynomials (no z̄) —
    // gives poles, |Z| = k, invariant points, antecedents; (2) bivariate polynomials in x, y
    // giving X = P/D, Y = Q/D (also works with conj(z)). Sets of points are factorised and
    // classified (line, circle by completing the square, two lines, point, ∅, conic).
    var zfFEl = document.getElementById('zf-f'), zfKEl = document.getElementById('zf-k'), zfZ0El = document.getElementById('zf-z0');
    var zfPrevEl = document.getElementById('zf-preview'), zfOpsEl = document.getElementById('zf-ops'), zfExEl = document.getElementById('zf-ex');
    var zfObjs = [];
    function setZfOpsEnabled(on){ zfOpsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }
    function clearZfPlot(){ zfObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} }); zfObjs = []; }

    // ---- complex fractions ----
    function cf(re, im){ return { re: re || fr(0), im: im || fr(0) }; }
    function cfAdd(a, b){ return cf(fAdd(a.re, b.re), fAdd(a.im, b.im)); }
    function cfSub(a, b){ return cf(fSub(a.re, b.re), fSub(a.im, b.im)); }
    function cfMul(a, b){ return cf(fSub(fMul(a.re, b.re), fMul(a.im, b.im)), fAdd(fMul(a.re, b.im), fMul(a.im, b.re))); }
    function cfAbs2(a){ return fAdd(fMul(a.re, a.re), fMul(a.im, a.im)); }
    function cfDiv(a, b){ var d = cfAbs2(b); var n = cfMul(a, cf(b.re, fNeg(b.im))); return cf(fDiv(n.re, d), fDiv(n.im, d)); }
    function cfZero(a){ return fZero(a.re) && fZero(a.im); }
    function cfTex(a){
      if(fZero(a.im)) return fTex(a.re);
      var ab = fr(Math.abs(a.im.n), a.im.d), it = (ab.n === 1 && ab.d === 1) ? 'i' : fTex(ab) + 'i';
      if(fZero(a.re)) return (a.im.n < 0 ? '-' : '') + it;
      return fTex(a.re) + (a.im.n < 0 ? ' - ' : ' + ') + it;
    }
    function cfPlain(a){ return cfTex(a).split(BS + 'frac{').join('(').split('}{').join('/').split('}').join(')'); }

    // ---- complex polynomials in z (index = power) ----
    function czTrim(p){ var r = p.slice(); while(r.length > 1 && cfZero(r[r.length - 1])) r.pop(); return r.length ? r : [cf()]; }
    function czDeg(p){ p = czTrim(p); return (p.length === 1 && cfZero(p[0])) ? -1 : p.length - 1; }
    function czAdd(p, q){ var r = []; for(var i = 0; i < Math.max(p.length, q.length); i++) r.push(cfAdd(p[i] || cf(), q[i] || cf())); return czTrim(r); }
    function czSub(p, q){ var r = []; for(var i = 0; i < Math.max(p.length, q.length); i++) r.push(cfSub(p[i] || cf(), q[i] || cf())); return czTrim(r); }
    function czMul(p, q){ var r = []; for(var i = 0; i < p.length + q.length - 1; i++) r.push(cf()); for(var a = 0; a < p.length; a++) for(var b = 0; b < q.length; b++) r[a + b] = cfAdd(r[a + b], cfMul(p[a], q[b])); return czTrim(r); }
    function czEval(p, z){ var acc = cf(); for(var i = p.length - 1; i >= 0; i--) acc = cfAdd(cfMul(acc, z), p[i]); return acc; }
    // rational function in z: { n, d }  (null when conj is used)
    function zfRZ(n){
      if(!n) return null;
      switch(n.t){
        case 'num': { var f = fFromNum(n.v); return f ? { n: [cf(f)], d: [cf(fr(1))] } : null; }
        case 'const': if(n.name === 'z') return { n: [cf(), cf(fr(1))], d: [cf(fr(1))] }; if(n.name === 'i') return { n: [cf(fr(0), fr(1))], d: [cf(fr(1))] }; return null;
        case 'neg': { var a = zfRZ(n.a); return a ? { n: czMul(a.n, [cf(fr(-1))]), d: a.d } : null; }
        case '+': case '-': { var l = zfRZ(n.l), r = zfRZ(n.r); if(!l || !r) return null; var nl = czMul(l.n, r.d), nr = czMul(r.n, l.d); return { n: n.t === '+' ? czAdd(nl, nr) : czSub(nl, nr), d: czMul(l.d, r.d) }; }
        case '*': { var l2 = zfRZ(n.l), r2 = zfRZ(n.r); if(!l2 || !r2) return null; return { n: czMul(l2.n, r2.n), d: czMul(l2.d, r2.d) }; }
        case '/': { var l3 = zfRZ(n.l), r3 = zfRZ(n.r); if(!l3 || !r3 || czDeg(r3.n) < 0) return null; return { n: czMul(l3.n, r3.d), d: czMul(l3.d, r3.n) }; }
        case '^': {
          var b = zfRZ(n.l), e = zfRZ(n.r); if(!b || !e || czDeg(e.n) > 0 || czDeg(e.d) > 0) return null;
          var ev = cfDiv(e.n[0], e.d[0]); if(!fZero(ev.im) || ev.re.d !== 1 || Math.abs(ev.re.n) > 6) return null;
          var k = ev.re.n, res = { n: [cf(fr(1))], d: [cf(fr(1))] };
          for(var i = 0; i < Math.abs(k); i++) res = { n: czMul(res.n, b.n), d: czMul(res.d, b.d) };
          return k < 0 ? { n: res.d, d: res.n } : res;
        }
      }
      return null;
    }

    // ---- bivariate polynomials in x, y: { "i,j": fraction } ----
    function bpK(i, j){ return i + ',' + j; }
    function bpC(f){ var o = {}; if(!fZero(f)) o[bpK(0, 0)] = f; return o; }
    function bpAdd(a, b){ var o = {}; [a, b].forEach(function(p){ Object.keys(p).forEach(function(k){ var v = o[k] ? fAdd(o[k], p[k]) : p[k]; if(fZero(v)) delete o[k]; else o[k] = v; }); }); return o; }
    function bpScale(a, f){ var o = {}; if(fZero(f)) return o; Object.keys(a).forEach(function(k){ o[k] = fMul(a[k], f); }); return o; }
    function bpSub(a, b){ return bpAdd(a, bpScale(b, fr(-1))); }
    function bpMul(a, b){
      var o = {};
      Object.keys(a).forEach(function(ka){ var ia = ka.split(','); Object.keys(b).forEach(function(kb){ var ib = kb.split(','); var k = bpK(Number(ia[0]) + Number(ib[0]), Number(ia[1]) + Number(ib[1])); var v = fMul(a[ka], b[kb]); o[k] = o[k] ? fAdd(o[k], v) : v; if(fZero(o[k])) delete o[k]; }); });
      return o;
