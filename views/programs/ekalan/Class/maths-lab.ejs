          </div>
          <div class="ml-modes__group ml-modes__group--tle">
            <span class="ml-modes__lbl"><i class="bi bi-mortarboard-fill"></i> Terminale</span>
            <button type="button" class="ml-mode" data-mode="complex"><i class="bi bi-asterisk"></i> Nombres complexes <span class="ml-tle">Tle</span></button>
            <button type="button" class="ml-mode" data-mode="geometry"><i class="bi bi-triangle"></i> Géométrie <span class="ml-tle">Tle</span></button>
            <button type="button" class="ml-mode" data-mode="integral"><i class="bi bi-integral"></i> Intégrales <span class="ml-tle">Tle</span></button>
            <button type="button" class="ml-mode" data-mode="proba"><i class="bi bi-dice-5"></i> Probabilités <span class="ml-tle">Tle</span></button>
            <button type="button" class="ml-mode" data-mode="diffeq"><i class="bi bi-arrow-left-right"></i> Éq. différentielles <span class="ml-tle">Tle</span></button>
            <button type="button" class="ml-mode" data-mode="arith"><i class="bi bi-123"></i> Arithmétique <span class="ml-tle">Tle C</span></button>
          </div>
        </div>

        <div id="mode-function">
        <h2><i class="bi bi-input-cursor-text"></i> Votre fonction</h2>
        <div class="ml-input-row">
          <label for="fx">f(x) =</label>
          <input id="fx" type="text" value="x^2" placeholder="ex : (x^2+1)/(x-1)" autocomplete="off" />
          <button type="button" class="ml-plot" id="plotBtn"><i class="bi bi-graph-up"></i> Tracer</button>
        </div>

        <div class="ml-preview is-empty" id="fxPreview">Aperçu de la fonction…</div>

        <div class="ml-keys" id="keys">
          <button type="button" class="ml-key" data-ins="x">x</button>
          <button type="button" class="ml-key" data-ins="x^2">x²</button>
          <button type="button" class="ml-key" data-ins="^">xⁿ</button>
          <button type="button" class="ml-key" data-ins="(|)/(|)">a⁄b</button>
          <button type="button" class="ml-key" data-ins="sqrt(|)">√</button>
          <button type="button" class="ml-key" data-ins="(|)">(&nbsp;)</button>
          <button type="button" class="ml-key" data-ins="+">+</button>
          <button type="button" class="ml-key" data-ins="-">−</button>
          <button type="button" class="ml-key" data-ins="*">×</button>
          <button type="button" class="ml-key" data-ins="pi">π</button>
          <button type="button" class="ml-key" data-ins="exp(|)">eˣ</button>
          <button type="button" class="ml-key is-fn" data-ins="ln(|)">ln</button>
          <button type="button" class="ml-key is-fn" data-ins="log(|)">log</button>
          <button type="button" class="ml-key is-fn" data-ins="abs(|)">|x|</button>
          <button type="button" class="ml-key is-fn" data-ins="sin(|)">sin</button>
          <button type="button" class="ml-key is-fn" data-ins="cos(|)">cos</button>
          <button type="button" class="ml-key is-fn" data-ins="tan(|)">tan</button>
          <button type="button" class="ml-key is-util" data-act="back">⌫</button>
          <button type="button" class="ml-key is-util" data-act="clear">C</button>
        </div>

        <div class="ml-input-row" style="margin:.2rem 0 .1rem">
          <label for="tanx0">Point x₀ =</label>
          <input id="tanx0" type="text" value="1" autocomplete="off" style="flex:0 0 auto; min-width:0; max-width:130px" />
          <span class="ml-hint" style="margin:0">pour la tangente</span>
        </div>

        <div id="fn-limit-panel" class="ml-block" hidden style="margin:.2rem 0 .7rem">
          <h3 class="ml-subtitle"><i class="bi bi-arrow-bar-right"></i> Limite de f</h3>
          <div class="ml-input-row">
            <label for="lpoint">x →</label>
            <input id="lpoint" type="text" value="+∞" placeholder="ex : 0, 2, +∞" autocomplete="off" style="flex:0 0 auto; min-width:0; max-width:150px;" />
            <button type="button" class="ml-key" data-lpoint="+∞">+∞</button>
            <button type="button" class="ml-key" data-lpoint="-∞">−∞</button>
          </div>
          <div class="ml-side" id="lside">
            <button type="button" class="ml-sidebtn is-active" data-side="">↔ Bilatérale</button>
            <button type="button" class="ml-sidebtn" data-side="-">← À gauche (x→a⁻)</button>
            <button type="button" class="ml-sidebtn" data-side="+">→ À droite (x→a⁺)</button>
          </div>
          <div class="ml-preview is-empty" id="lPreview">Aperçu de la limite…</div>
          <div class="ml-ops" id="lops"><button class="ml-op" data-lop="limit"><i class="bi bi-arrow-bar-right"></i> Calculer la limite</button></div>
          <div class="ml-hint" style="margin-top:.3rem">Indiquez la valeur vers laquelle x tend (nombre, +∞ ou −∞). « à gauche / à droite » pour les asymptotes verticales et les formes indéterminées.</div>
        </div>

        <div class="ml-ops" id="ops">
          <button class="ml-op ml-op--hero" data-op="study"><i class="bi bi-clipboard2-data"></i> Étude complète</button>
          <button class="ml-op" data-op="domain"><i class="bi bi-bounding-box"></i> Domaine de définition</button>
           <button class="ml-op" data-op="limit"><i class="bi bi-arrow-bar-right"></i> Limite</button>
          <button class="ml-op" data-op="derivative"><i class="bi bi-slash-lg"></i> Dérivée f'(x)</button>
          <button class="ml-op" data-op="tangent"><i class="bi bi-rulers"></i> Tangente en x₀</button>
          <button class="ml-op" data-op="convexity"><i class="bi bi-graph-up-arrow"></i> Convexité</button>
          <button class="ml-op" data-op="variations"><i class="bi bi-table"></i> Tableau de variation</button>
          <button class="ml-op" data-op="asymptotes"><i class="bi bi-arrows-collapse"></i> Asymptotes</button>
          <button class="ml-op" data-op="integral"><i class="bi bi-integral"></i> Primitive</button>
          <button class="ml-op" data-op="solve"><i class="bi bi-check2-square"></i> Résoudre f(x)= 0</button>
          <button class="ml-op" data-op="factor"><i class="bi bi-diagram-2"></i> Factoriser</button>
          <button class="ml-op" data-op="expand"><i class="bi bi-arrows-angle-expand"></i> Développer</button>
        </div>
          <details class="ml-form">
            <summary><i class="bi bi-journal-text"></i> Formulaire — dérivées, limites, primitives</summary>
            <div class="ml-form-grid" id="form-grid-function"></div>
          </details>
        </div><%# /mode-function %>

        <div id="mode-equation" hidden>
          <h2><i class="bi bi-calculator"></i> Équation</h2>
          <div class="ml-side" id="e1-type">
            <button type="button" class="ml-sidebtn is-active" data-etype="deg2">Second degré</button>
            <button type="button" class="ml-sidebtn" data-etype="param">Avec paramètre m</button>
            <button type="button" class="ml-sidebtn" data-etype="deg3">Degré 3</button>
          </div>

          <div class="pw-ex" id="e1-ex"></div>

          <div class="ml-coefs" id="e1-coefs">
            <div class="ml-coef" id="e1-ca"><label for="e1a">a</label><input id="e1a" type="text" value="2" autocomplete="off" /></div>
            <div class="ml-coef" id="e1-cb"><label for="e1b">b</label><input id="e1b" type="text" value="-3" autocomplete="off" /></div>
            <div class="ml-coef" id="e1-cc"><label for="e1c">c</label><input id="e1c" type="text" value="-2" autocomplete="off" /></div>
            <div class="ml-coef" id="e1-cd" hidden><label for="e1d">d</label><input id="e1d" type="text" value="6" autocomplete="off" /></div>
          </div>
          <div class="ml-hint" id="e1-hint" style="margin:-.4rem 0 .8rem"></div>

          <div class="ml-preview is-empty" id="e1-preview">Aperçu de l'équation…</div>

          <div class="ml-input-row" id="e1-x0row" hidden>
            <label for="e1x0" id="e1x0-lbl">x₀ =</label>
            <input id="e1x0" type="text" value="" placeholder="ex : 1, -2, 1/2" autocomplete="off" style="flex:0 0 auto; min-width:0; max-width:150px;" />
            <span class="ml-hint" id="e1x0-hint" style="margin:0"></span>
          </div>

          <div class="ml-ops" id="e1-ops">
            <button class="ml-op ml-op--hero" data-e1op="deg2_solve" data-for="deg2"><i class="bi bi-check2-circle"></i> Résoudre</button>
            <button class="ml-op ml-op--hero" data-e1op="param_discuss" data-for="param" hidden><i class="bi bi-diagram-3"></i> Discuter selon m</button>
            <button class="ml-op" data-e1op="param_root" data-for="param" hidden><i class="bi bi-crosshair"></i> m tel que x₀ soit solution</button>
