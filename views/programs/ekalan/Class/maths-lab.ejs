      // supported aligned/gathered so multi-line worked steps render instead of erroring.
      s = s.split('{align*}').join('{aligned}').split('{align}').join('{aligned}')
           .split('{eqnarray*}').join('{aligned}').split('{eqnarray}').join('{aligned}')
