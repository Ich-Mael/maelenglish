    }
    function stripZeq(r){ var eq = r.indexOf('='); if(eq >= 0 && r.slice(0, eq).trim().toLowerCase() === 'z') return r.slice(eq + 1).trim(); return r; }
    // Scan the roots for a REAL (im≈0) or PURE-IMAGINARY (re≈0) one. Returns {value} or null.
    // Uses CSolutions for the list, then the reliable graphics view to read each root.
    function findSpecialRoot(poly){
      var raw = '';
      try { raw = ggbToText(ggb.evalCommandCAS('CSolutions(' + poly + ' = 0, z)')); } catch(e){ raw = ''; }
      if(!raw || raw === '{}') return null;
      var roots = splitTopLevel(raw), res = null;
      for(var k = 0; k < roots.length && !res; k++){
        var v = evalComplex(stripZeq(roots[k]));
        if(v){
          if(Math.abs(v.im) < 1e-6) res = { value: fmtReal(v.re) };
          else if(Math.abs(v.re) < 1e-6) res = { value: fmtImag(v.im) };
        }
