      if(n.t === '-'){ var a2 = dxPoly(n.l), b2 = dxPoly(n.r); return (a2 && b2) ? dxPAdd(a2, b2.map(function(c){ return -c; })) : null; }
      if(n.t === '*'){ var a3 = dxPoly(n.l), b3 = dxPoly(n.r); return (a3 && b3) ? dxPMul(a3, b3) : null; }
      if(n.t === '^'){ var ba = dxPoly(n.l); if(!ba || n.r.t !== 'num') return null; var e = n.r.v; if(e < 0 || Math.round(e) !== e) return null; var rr = [1]; for(var k = 0; k < e; k++) rr = dxPMul(rr, ba); return rr; }
      return null; }
    function dxPolyStr(c){ var d = c.length - 1; while(d > 0 && Math.abs(c[d]) < 1e-12) d--; if(d === 0) return vtFmt(c[0]);
      var out = ''; for(var k = d; k >= 0; k--){ var v = c[k]; if(Math.abs(v) < 1e-12) continue; var av = Math.abs(v), sign = v < 0 ? '-' : '+'; var coef = (Math.abs(av - 1) < 1e-12 && k > 0) ? '' : vtFmt(av); var xp = k === 0 ? '' : (k === 1 ? 'x' : 'x^' + k); var term = coef + xp; if(out === '') out = (sign === '-' ? '-' : '') + term; else out += ' ' + sign + ' ' + term; } return out || '0'; }
    function dxPretty(d){ if(d.t === '/'){ var nP = dxPoly(d.l); if(nP){ var ns = dxPolyStr(nP); if(ns === '0') return '0'; return '(' + ns + ')/' + dxStr(d.r); } return dxStr(d); } var p = dxPoly(d); if(p) return dxPolyStr(p); return dxStr(d); }

    // Symbolic derivative as a string. JS differentiator first (reliable), GeoGebra as fallback.
    function derivExpr(expr){
      try { var ast = dxParse(dxTok(expr)); if(ast){ var d = dxDiff(ast); if(d){ d = dxSimp(dxSimp(dxSimp(d))); var str = dxPretty(d); if(str && str.indexOf('?') < 0) return str; } } } catch(e){}
      var tries = ['Derivative(' + expr + ')', 'Derivative(f)', 'Derivative(f(x),x)'];
      for(var t = 0; t < tries.length; t++){
        var r = ''; try { r = ggbToText(ggb.evalCommandCAS(tries[t])); } catch(e){ r = ''; }
        r = (r || '').trim();
        if(r && r !== '?' && r.indexOf('?') < 0) return r;
      }
      try {
        ggb.evalCommand('gDrv(x)=Derivative(f)');
        var gs = ggbToText(ggb.getValueString('gDrv') || '');
        ggb.deleteObject('gDrv');
        var eqp = gs.indexOf('=');
        if(eqp >= 0) gs = gs.slice(eqp + 1).trim();
        if(gs && gs !== '?' && gs.indexOf('?') < 0) return gs;
      } catch(e){}
      return '';
    }
    function variationTableHTML(pts, fp, info){
      info = info || {};
      function segDir(i){ return pts[i + 1].inYn - pts[i].outYn; }
      // A regular point sits high (top) or low (bottom) depending on the adjacent variation.
      function place(i){
        if(i === 0) return segDir(0) < 0 ? 'top' : 'bottom';      // start high if it then decreases
        return segDir(i - 1) > 0 ? 'top' : 'bottom';              // arrived increasing → it's a peak
      }
      var xRow = '<tr><th>x</th>', fpRow = '<tr><th>f&#8242;(x)</th>', fRow = '<tr><th>f(x)</th>';
      var hasAsym = false;
      for(var i = 0; i < pts.length; i++){
        var atEnd = (i === 0 || i === pts.length - 1);
        if(pts[i].kind === 'asym'){
          hasAsym = true;
          // Vertical asymptote: x in red, red double bar; the LEFT limit sits left of the bar,
          // the RIGHT limit right of it — each high/low by its sign, in a red badge.
          var lP = pts[i].leftSign  > 0 ? 'top' : 'bottom', lT = pts[i].leftSign  > 0 ? '+∞' : '−∞';
          var rP = pts[i].rightSign > 0 ? 'top' : 'bottom', rT = pts[i].rightSign > 0 ? '+∞' : '−∞';
          xRow  += '<td class="vt-pt vt-asym-x">' + escapeHtml(pts[i].x) + '</td>';
          fpRow += '<td class="vt-asym-bar"></td>';
          fRow  += '<td class="vt-fpt vt-asym-cell">'
                +  '<span class="vt-lim vt-lim-L vt-' + lP + '">' + lT + '</span>'
                +  '<span class="vt-lim vt-lim-R vt-' + rP + '">' + rT + '</span></td>';
        } else {
          var critCls = atEnd ? '' : ' vt-crit';
          // A finite limit at ±∞ is a horizontal asymptote → highlight it in a red badge.
          var isHLim = atEnd && pts[i].y && pts[i].y !== '+∞' && pts[i].y !== '−∞' && pts[i].y !== '?';
          var valHtml = isHLim ? '<span class="vt-lim">' + escapeHtml(pts[i].y) + '</span>' : escapeHtml(pts[i].y);
          xRow  += '<td class="vt-pt">' + escapeHtml(pts[i].x) + '</td>';
          fpRow += '<td class="vt-pt' + critCls + '">' + (atEnd ? '' : '0') + '</td>';
          fRow  += '<td class="vt-fpt' + critCls + '"><div class="vt-fval vt-' + place(i) + '">' + valHtml + '</div></td>';
        }
        if(i < pts.length - 1){
          var d = segDir(i);
          xRow  += '<td class="vt-gap"></td>';
          fpRow += '<td class="vt-gap vt-sign">' + (d > 0 ? '+' : (d < 0 ? '−' : '')) + '</td>';
          fRow  += '<td class="vt-gap">' + vtArrow(d) + '</td>';
        }
      }
      var html = '';
      if(info.domain) html += '<div class="vt-domain">D<sub>f</sub> = ' + escapeHtml(info.domain) + '</div>';
      if(fp && fp !== '?' && fp.indexOf('?') < 0) html += '<div class="vt-deriv">f&#8242;(x) = ' + escapeHtml(fp) + '</div>';
      html += '<div class="ml-vartable-wrap"><table class="ml-vartable">' + xRow + '</tr>' + fpRow + '</tr>' + fRow + '</tr></table></div>';
      if(info.limLines && info.limLines.length){
        html += '<div class="vt-lims"><div class="vt-lims-t">Limites aux bornes du domaine</div>'
             + info.limLines.map(function(l){ return '<div class="vt-lim-line">' + escapeHtml(l) + '</div>'; }).join('') + '</div>';
      }
      var notes = (info.hNotes || []).slice();
      if(hasAsym) notes.push('Double barre rouge = asymptote verticale (valeur interdite) ; limites à gauche / à droite indiquées.');
      if(notes.length) html += '<div class="vt-note">' + notes.map(escapeHtml).join('<br>') + '</div>';
      return html;
    }
    function renderVariationTable(pts, fp, info){
      answerEl.innerHTML = '<div class="ml-answer"><div class="lbl"><i class="bi bi-table"></i> Tableau de variation</div>' + variationTableHTML(pts, fp, info) + '</div>';
    }

    async function runVariation(){
      var expr = (fxInput.value || '').trim();
      if(!expr){ stateEl.textContent = 'Saisissez une fonction.'; return; }
      if(!ggb){ return; }
      plot(expr); // defines f(x)=expr
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Construction du tableau…';
      setOpsEnabled(false);

      function ev(c){ try { ggb.evalCommand(c); return true; } catch(e){ return false; } }
      function gv(l){ try { return ggb.getValue(l); } catch(e){ return NaN; } }
      // Numeric evaluator: one free arg + one dependent result, updated via SetValue
      // (reliable — unlike GeoGebra Extremum/Limit which return undefined for ±∞ here).
      ev('vtArg=0'); ev('vtRes=f(vtArg)');
      function fAt(x){ ev('SetValue(vtArg,' + x + ')'); return gv('vtRes'); }

      // Derivative for display — try a few forms, drop GeoGebra's "?" (undefined).
      var fp = derivExpr(expr);

      // Sample f over [LO, HI].
      var LO = -50, HI = 50, N = 400, step = (HI - LO) / N;
      var ys = new Array(N + 1);
      for(var i = 0; i <= N; i++) ys[i] = fAt(LO + i * step);

      // Vertical asymptotes (poles): f flips sign with large magnitude, or jumps to/from undefined.
      // Locate via a root of g(x)=1/f(x) (continuous, → 0 at a pole), then read the one-sided limits.
      function poleRefine(xa, xb){
        function g(x){ var v = fAt(x); return (isFinite(v) && v !== 0) ? 1 / v : 0; }
        var ga = g(xa);
        for(var it = 0; it < 60; it++){
          var m = (xa + xb) / 2, gm = g(m);
          if(gm === 0) return m;
          if((ga < 0) !== (gm < 0)){ xb = m; } else { xa = m; ga = gm; }
        }
        return (xa + xb) / 2;
      }
      var poles = [], poleBracket = {};
      function addPole(loIdx, hiIdx, brackets){
        var a0 = poleRefine(LO + loIdx * step, LO + hiIdx * step);
        var lL = fAt(a0 - 1e-6), rL = fAt(a0 + 1e-6);
        if(Math.max(Math.abs(lL), Math.abs(rL)) <= 1e4) return;          // not actually a pole
        if(poles.some(function(p){ return Math.abs(p.x - a0) < step; })) return; // dedupe
        poles.push({ x: a0, leftSign: lL < 0 ? -1 : 1, rightSign: rL < 0 ? -1 : 1 });
        brackets.forEach(function(j){ poleBracket[j] = true; });
      }
      for(var j = 1; j <= N; j++){
        var a = ys[j - 1], b = ys[j];
        if(isFinite(a) && isFinite(b)){
          if(a * b < 0 && Math.min(Math.abs(a), Math.abs(b)) > 5) addPole(j - 1, j, [j]);       // sign flip across pole
        } else if(!isFinite(b) && isFinite(a) && j < N && isFinite(ys[j + 1]) &&
                  (Math.abs(a) > 3 || Math.abs(ys[j + 1]) > 3)){
          addPole(j - 1, j + 1, [j, j + 1]);                                                    // pole on a sampled point (f undefined)
        }
      }
      if(poles.length > 6) poles = poles.slice(0, 6);

      // Local extrema via monotony changes (refined by ternary search); skip pole brackets.
      function refine(xa, xb, wantMax){
        for(var it = 0; it < 50; it++){
          var m1 = xa + (xb - xa) / 3, m2 = xb - (xb - xa) / 3, f1 = fAt(m1), f2 = fAt(m2);
          if(wantMax ? (f1 < f2) : (f1 > f2)) xa = m1; else xb = m2;
        }
        var xm = (xa + xb) / 2; return { x: xm, y: fAt(xm) };
      }
      var crit = [], lastSign = 0;
      for(var j2 = 1; j2 <= N; j2++){
        if(poleBracket[j2] || !isFinite(ys[j2]) || !isFinite(ys[j2 - 1])){ lastSign = 0; continue; }
        var s = ys[j2] - ys[j2 - 1], sg = s > 1e-12 ? 1 : (s < -1e-12 ? -1 : 0);
        if(sg !== 0){
          if(lastSign !== 0 && sg !== lastSign){
            var wantMax = (lastSign > 0 && sg < 0);
            var ex = refine(LO + (j2 - 2) * step, LO + j2 * step, wantMax);
            if(isFinite(ex.x) && isFinite(ex.y)) crit.push({ x: ex.x, y: ex.y });
          }
          lastSign = sg;
        }
      }
      // Drop extrema too close to a pole (numeric noise around the asymptote).
      crit = crit.filter(function(c){ return !poles.some(function(p){ return Math.abs(c.x - p.x) < 2 * step; }); });
      crit = crit.filter(function(c, k){ return k === 0 || Math.abs(c.x - crit[k - 1].x) > 1e-3; });
      if(crit.length > 8) crit = crit.slice(0, 8);

      // End behaviour: compare two far samples. If f converges → horizontal asymptote
      // value; if it keeps moving → ±∞ (a slope like ~x stays below any fixed magnitude
      // cap at 1e7, so magnitude alone isn't enough — use convergence instead).
      function endBehavior(sgn){
        var fa = fAt(sgn * 1e4), fb = fAt(sgn * 1e8);
        if(!isFinite(fb)) return fb > 0 ? Infinity : (fb < 0 ? -Infinity : NaN);
        if(!isFinite(fa)) fa = fb;
        if(Math.abs(fb - fa) < 1e-3) return fb;     // converged → horizontal asymptote
        return fb > 0 ? Infinity : -Infinity;        // diverging → ±∞
      }
      var endNeg = endBehavior(-1), endPos = endBehavior(1);

      // Best-effort EXACT extrema via CAS (e.g. 4/3, ln(2)/3) — falls back to fraction/decimal.
      function exactCrit(){
        var raw = ''; try { raw = ggbToText(ggb.evalCommandCAS('Solutions(Derivative(f)=0,x)')); } catch(e){ raw = ''; }
        if(!raw || raw === '?' || raw.indexOf('?') >= 0 || raw === '{}') return [];
        var out = [];
        splitTopLevel(raw).forEach(function(r){
          r = (r || '').trim(); if(!r) return;
          var nx = NaN; try { ev('vtRn=' + r); nx = gv('vtRn'); ggb.deleteObject('vtRn'); } catch(e){}
          if(!isFinite(nx)) return;
          var ys2 = ''; try { ys2 = ggbToText(ggb.evalCommandCAS('f(' + r + ')')); } catch(e){ ys2 = ''; }
          ys2 = (ys2 || '').trim(); if(ys2 === '?' || ys2.indexOf('?') >= 0) ys2 = '';
          out.push({ n: nx, xs: r, ys: ys2 });
        });
        return out;
      }
      var exList = exactCrit();
      try { ggb.deleteObject('vtRes'); ggb.deleteObject('vtArg'); } catch(e){}
      function exClean(s){ return s && s.length <= 22 && s.indexOf('?') < 0; }
      function exMatch(numx){ for(var ei = 0; ei < exList.length; ei++){ if(Math.abs(exList[ei].n - numx) < 1e-2) return exList[ei]; } return null; }

      // Merge extrema + asymptotes into one sorted list of "stops".
      var stops = [];
      crit.forEach(function(c){ stops.push({ kind: 'pt', x: c.x, y: c.y }); });
      poles.forEach(function(p){ stops.push({ kind: 'asym', x: p.x, leftSign: p.leftSign, rightSign: p.rightSign }); });
      stops.sort(function(a2, b2){ return a2.x - b2.x; });

      var pts = [{ x: '−∞', y: vtFmtLim(endNeg), inYn: endNeg, outYn: endNeg, kind: 'pt' }];
      stops.forEach(function(st){
        if(st.kind === 'asym'){
          pts.push({ x: vtFmt(st.x), kind: 'asym', leftSign: st.leftSign, rightSign: st.rightSign,
                     inYn: st.leftSign * 1e15, outYn: st.rightSign * 1e15 });
        } else {
          var em = exMatch(st.x);
          var xD = (em && exClean(em.xs)) ? em.xs : vtFmt(st.x);
          var yD = (em && exClean(em.ys)) ? em.ys : vtFmt(st.y);
          pts.push({ x: xD, y: yD, inYn: st.y, outYn: st.y, kind: 'pt' });
        }
      });
      pts.push({ x: '+∞', y: vtFmtLim(endPos), inYn: endPos, outYn: endPos, kind: 'pt' });

      // Domain of definition (ℝ minus the poles) and horizontal asymptotes.
      function isFiniteLim(v){ return isFinite(v) && Math.abs(v) <= 1e8; }
      var poleXs = poles.map(function(p){ return p.x; }).sort(function(a3, b3){ return a3 - b3; });
      var domain;
      if(!poleXs.length){ domain = 'ℝ'; }
      else {
        var ds = [']−∞ ; ' + vtFmt(poleXs[0]) + '['];
        for(var di = 0; di < poleXs.length - 1; di++) ds.push(']' + vtFmt(poleXs[di]) + ' ; ' + vtFmt(poleXs[di + 1]) + '[');
        ds.push(']' + vtFmt(poleXs[poleXs.length - 1]) + ' ; +∞[');
        domain = ds.join(' ∪ ');
      }
      var hNotes = [], lnFin = isFiniteLim(endNeg), lpFin = isFiniteLim(endPos);
      if(lnFin && lpFin && vtFmt(endNeg) === vtFmt(endPos)) hNotes.push('Asymptote horizontale : y = ' + vtFmt(endNeg) + ' (en −∞ et +∞)');
      else { if(lnFin) hNotes.push('Asymptote horizontale : y = ' + vtFmt(endNeg) + ' (en −∞)'); if(lpFin) hNotes.push('Asymptote horizontale : y = ' + vtFmt(endPos) + ' (en +∞)'); }

      // Each boundary limit listed separately (−∞, both sides of every pole, +∞).
      var limLines = ['lim(x→−∞) f(x) = ' + vtFmtLim(endNeg)];
      poles.slice().sort(function(a4, b4){ return a4.x - b4.x; }).forEach(function(p){
        limLines.push('lim(x→' + vtFmt(p.x) + '⁻) f(x) = ' + (p.leftSign > 0 ? '+∞' : '−∞')
                    + '   ;   lim(x→' + vtFmt(p.x) + '⁺) f(x) = ' + (p.rightSign > 0 ? '+∞' : '−∞'));
      });
      limLines.push('lim(x→+∞) f(x) = ' + vtFmtLim(endPos));

      renderVariationTable(pts, fp, { domain: domain, hNotes: hNotes, limLines: limLines });
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';

      // Anchored summary for Claude (kept short for the 500-char cache limit).
      var parts = [];
      parts.push('Df = ' + domain);
      if(fp) parts.push("f'(x) = " + fp);
      if(poles.length) parts.push('asymptote(s) verticale(s) : ' + poles.map(function(p){
        return 'x=' + vtFmt(p.x) + ' (lim ' + (p.leftSign > 0 ? '+∞' : '−∞') + ' à gauche, ' + (p.rightSign > 0 ? '+∞' : '−∞') + ' à droite)'; }).join(', '));
      if(crit.length === 0) parts.push('aucun extremum, f monotone par morceaux');
      else parts.push('extrema : ' + crit.map(function(c){ return 'x=' + vtFmt(c.x) + ' (f=' + vtFmt(c.y) + ')'; }).join(', '));
      parts.push('limites : ' + vtFmtLim(endNeg) + ' en −∞, ' + vtFmtLim(endPos) + ' en +∞');
      if(hNotes.length) parts.push(hNotes.join(' ; '));
      var summary = parts.join(' ; ').slice(0, 480);

      try {
        var resp = await fetch(EXPLAIN_URL, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ function: expr, operation: 'variations', casResult: summary })
        });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){
        stateEl.textContent = 'Connexion impossible — réessayez.';
      } finally {
        setOpsEnabled(true);
      }
    }

    /* ---- Domaine de définition ---- */
    async function runDomain(){
      var expr = (fxInput.value || '').trim();
      if(!expr){ stateEl.textContent = 'Saisissez une fonction.'; return; }
      if(!ggb){ return; }
      plot(expr);
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul du domaine…';
      setOpsEnabled(false);

      function ev(c){ try { ggb.evalCommand(c); return true; } catch(e){ return false; } }
      function gv(l){ try { return ggb.getValue(l); } catch(e){ return NaN; } }
      ev('vtArg=0'); ev('vtRes=f(vtArg)');
      function fAt(x){ ev('SetValue(vtArg,' + x + ')'); return gv('vtRes'); }
      function snap(x){ return Math.abs(x - Math.round(x)) < 1e-4 ? Math.round(x) : x; }

      var LO = -100, HI = 100, N = 2000, step = (HI - LO) / N;
      var ys = [], dd = [];
      for(var i = 0; i <= N; i++){ var v = fAt(LO + i * step); ys[i] = v; dd[i] = isFinite(v); }

      // Cut points: closed=true → the point belongs to D_f (e.g. √ at 0); false → excluded (pole, ln bound).
      var cuts = [];
      function pushCut(x, closed){
        for(var k = 0; k < cuts.length; k++){ if(Math.abs(cuts[k].x - x) < 2 * step){ if(!closed) cuts[k].closed = false; return; } }
        cuts.push({ x: x, closed: closed });
      }
      // Definedness transitions (√/ln edges, and poles that land on a sampled point).
      for(var t = 1; t <= N; t++){
        if(dd[t] !== dd[t - 1]){
          var xa = LO + (t - 1) * step, xb = LO + t * step, want = dd[t - 1];
          for(var it = 0; it < 44; it++){ var m = (xa + xb) / 2; if(isFinite(fAt(m)) === want) xa = m; else xb = m; }
          var bx = snap((xa + xb) / 2);
          pushCut(bx, isFinite(fAt(bx)));
        }
      }
      // Poles between two finite samples (sign flip with large magnitude).
      function poleRefine(xa, xb){
        function g(x){ var v = fAt(x); return (isFinite(v) && v !== 0) ? 1 / v : 0; }
        var ga = g(xa);
        for(var it = 0; it < 50; it++){ var m = (xa + xb) / 2, gm = g(m); if(gm === 0) return m; if((ga < 0) !== (gm < 0)) xb = m; else { xa = m; ga = gm; } }
        return (xa + xb) / 2;
      }
      for(var p1 = 1; p1 <= N; p1++){
        var a = ys[p1 - 1], b = ys[p1];
        if(isFinite(a) && isFinite(b) && a * b < 0 && Math.min(Math.abs(a), Math.abs(b)) > 5){
          var px = poleRefine(LO + (p1 - 1) * step, LO + p1 * step);
          if(Math.max(Math.abs(fAt(px - 1e-6)), Math.abs(fAt(px + 1e-6))) > 1e4) pushCut(snap(px), false);
        }
      }
      cuts.sort(function(c1, c2){ return c1.x - c2.x; });
      if(cuts.length > 12) cuts = cuts.slice(0, 12);

      // Walk segments between cuts; a segment is in D_f if its interior point is defined.
      var bounds = [{ x: -Infinity }].concat(cuts).concat([{ x: Infinity }]);
      var intervals = [], excluded = [];
      for(var s = 0; s < bounds.length - 1; s++){
        var L = bounds[s], R = bounds[s + 1];
        var mx = (isFinite(L.x) && isFinite(R.x)) ? (L.x + R.x) / 2 : (isFinite(L.x) ? L.x + 1 : (isFinite(R.x) ? R.x - 1 : 0));
        if(!isFinite(fAt(mx))) continue;
        var lo = isFinite(L.x) ? ((L.closed ? '[' : ']') + vtFmt(L.x)) : ']−∞';
        var hi = isFinite(R.x) ? (vtFmt(R.x) + (R.closed ? ']' : '[')) : '+∞[';
        intervals.push(lo + ' ; ' + hi);
      }
      cuts.forEach(function(c){ if(!c.closed) excluded.push(vtFmt(c.x)); });
      try { ggb.deleteObject('vtRes'); ggb.deleteObject('vtArg'); } catch(e){}

      var domain;
      if(!intervals.length) domain = '∅';
      else if(intervals.length === 1 && !cuts.length) domain = 'ℝ';
      else domain = intervals.join(' ∪ ');

      var extra = excluded.length ? '<div class="vt-note">Valeur(s) exclue(s) : x ≠ ' + escapeHtml(excluded.join(', ')) + '</div>' : '';
      answerEl.innerHTML = '<div class="ml-answer"><div class="lbl"><i class="bi bi-bounding-box"></i> Domaine de définition</div>'
        + '<div class="vt-domain" style="font-size:1.1rem">D<sub>f</sub> = ' + escapeHtml(domain) + '</div>' + extra + '</div>';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';

      try {
        var resp = await fetch(EXPLAIN_URL, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ function: expr, operation: 'domain', casResult: domain.slice(0, 480) })
        });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){
        stateEl.textContent = 'Connexion impossible — réessayez.';
      } finally {
        setOpsEnabled(true);
      }
    }

    /* ---- Étude de fonction complète ---- */
    async function runStudy(){
      var expr = (fxInput.value || '').trim();
      if(!expr){ stateEl.textContent = 'Saisissez une fonction.'; return; }
      if(!ggb){ return; }
      plot(expr);
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Étude de la fonction…';
      setOpsEnabled(false);

      function ev(c){ try { ggb.evalCommand(c); return true; } catch(e){ return false; } }
      function gv(l){ try { return ggb.getValue(l); } catch(e){ return NaN; } }
      ev('vtArg=0'); ev('vtRes=f(vtArg)');
      function fAt(x){ ev('SetValue(vtArg,' + x + ')'); return gv('vtRes'); }
      function snap(x){ return Math.abs(x - Math.round(x)) < 1e-4 ? Math.round(x) : x; }

      var LO = -100, HI = 100, N = 1600, step = (HI - LO) / N;
      var ys = [], dd = [];
      for(var i = 0; i <= N; i++){ var v = fAt(LO + i * step); ys[i] = v; dd[i] = isFinite(v); }

      // ---- Domain (definedness edges + poles) ----
      var cuts = [];
      function pushCut(x, closed){ for(var k = 0; k < cuts.length; k++){ if(Math.abs(cuts[k].x - x) < 2 * step){ if(!closed) cuts[k].closed = false; return; } } cuts.push({ x: x, closed: closed }); }
      for(var t = 1; t <= N; t++){
        if(dd[t] !== dd[t - 1]){
          var xa = LO + (t - 1) * step, xb = LO + t * step, want = dd[t - 1];
          for(var it = 0; it < 44; it++){ var m = (xa + xb) / 2; if(isFinite(fAt(m)) === want) xa = m; else xb = m; }
          var bx = snap((xa + xb) / 2);
          pushCut(bx, isFinite(fAt(bx)));
        }
      }
      function poleRefine(xa, xb){ function g(x){ var v = fAt(x); return (isFinite(v) && v !== 0) ? 1 / v : 0; } var ga = g(xa); for(var i2 = 0; i2 < 50; i2++){ var m = (xa + xb) / 2, gm = g(m); if(gm === 0) return m; if((ga < 0) !== (gm < 0)) xb = m; else { xa = m; ga = gm; } } return (xa + xb) / 2; }
      var poles = [], poleBracket = {};
      function addPole(loI, hiI, br){ var a0 = poleRefine(LO + loI * step, LO + hiI * step); var lL = fAt(a0 - 1e-6), rL = fAt(a0 + 1e-6); if(Math.max(Math.abs(lL), Math.abs(rL)) <= 1e4) return; if(poles.some(function(p){ return Math.abs(p.x - a0) < step; })) return; poles.push({ x: snap(a0), leftSign: lL < 0 ? -1 : 1, rightSign: rL < 0 ? -1 : 1 }); br.forEach(function(j){ poleBracket[j] = true; }); pushCut(snap(a0), false); }
      for(var j = 1; j <= N; j++){
        var a = ys[j - 1], b = ys[j];
        if(isFinite(a) && isFinite(b)){ if(a * b < 0 && Math.min(Math.abs(a), Math.abs(b)) > 5) addPole(j - 1, j, [j]); }
        else if(!isFinite(b) && isFinite(a) && j < N && isFinite(ys[j + 1]) && (Math.abs(a) > 3 || Math.abs(ys[j + 1]) > 3)) addPole(j - 1, j + 1, [j, j + 1]);
      }
      cuts.sort(function(c1, c2){ return c1.x - c2.x; });
      var bounds = [{ x: -Infinity }].concat(cuts).concat([{ x: Infinity }]), intervals = [], excluded = [];
      for(var s = 0; s < bounds.length - 1; s++){
        var L = bounds[s], R = bounds[s + 1];
        var mx = (isFinite(L.x) && isFinite(R.x)) ? (L.x + R.x) / 2 : (isFinite(L.x) ? L.x + 1 : (isFinite(R.x) ? R.x - 1 : 0));
        if(!isFinite(fAt(mx))) continue;
        var lo = isFinite(L.x) ? ((L.closed ? '[' : ']') + vtFmt(L.x)) : ']−∞';
        var hi = isFinite(R.x) ? (vtFmt(R.x) + (R.closed ? ']' : '[')) : '+∞[';
        intervals.push(lo + ' ; ' + hi);
      }
      cuts.forEach(function(c){ if(!c.closed) excluded.push(vtFmt(c.x)); });
      var domain = !intervals.length ? '∅' : (intervals.length === 1 && !cuts.length ? 'ℝ' : intervals.join(' ∪ '));

      // ---- Extrema (skip pole brackets), refined ----
      function refine(xa, xb, wantMax){ for(var i3 = 0; i3 < 50; i3++){ var m1 = xa + (xb - xa) / 3, m2 = xb - (xb - xa) / 3, f1 = fAt(m1), f2 = fAt(m2); if(wantMax ? (f1 < f2) : (f1 > f2)) xa = m1; else xb = m2; } var xm = (xa + xb) / 2; return { x: xm, y: fAt(xm) }; }
      var crit = [], lastSign = 0;
      for(var j3 = 1; j3 <= N; j3++){
        if(poleBracket[j3] || !isFinite(ys[j3]) || !isFinite(ys[j3 - 1])){ lastSign = 0; continue; }
        var sl = ys[j3] - ys[j3 - 1], sg = sl > 1e-12 ? 1 : (sl < -1e-12 ? -1 : 0);
        if(sg !== 0){ if(lastSign !== 0 && sg !== lastSign){ var exr = refine(LO + (j3 - 2) * step, LO + j3 * step, lastSign > 0 && sg < 0); if(isFinite(exr.x) && isFinite(exr.y)) crit.push({ x: exr.x, y: exr.y }); } lastSign = sg; }
      }
      crit = crit.filter(function(c){ return !poles.some(function(p){ return Math.abs(c.x - p.x) < 2 * step; }); });
      crit = crit.filter(function(c, k){ return k === 0 || Math.abs(c.x - crit[k - 1].x) > 1e-3; });
      if(crit.length > 8) crit = crit.slice(0, 8);

      // ---- End behaviour, asymptotes (vertical / horizontal / oblique) ----
      function endBehavior(sgn){ var fa = fAt(sgn * 1e4), fb = fAt(sgn * 1e8); if(!isFinite(fb)) return fb > 0 ? Infinity : (fb < 0 ? -Infinity : NaN); if(!isFinite(fa)) fa = fb; if(Math.abs(fb - fa) < 1e-3) return fb; return fb > 0 ? Infinity : -Infinity; }
      var endNeg = endBehavior(-1), endPos = endBehavior(1);
      // Oblique asymptote by the textbook method: a = lim f(x)/x, b = lim [f(x) − a·x].
      // (a via the secant slope = de-biased lim f/x; b verified to converge, else parabolic.)
      function oblique(sgn){
        var X1 = sgn * 1e6, X2 = sgn * 1e8, X3 = sgn * 1e4;
        var f1 = fAt(X1), f2 = fAt(X2), f3 = fAt(X3);
        if(!isFinite(f1) || !isFinite(f2) || !isFinite(f3)) return null;
        var a = (f2 - f1) / (X2 - X1);             // a = lim f(x)/x (secant = de-biased)
        if(!isFinite(a)) return null;
        var aLo = (f1 - f3) / (X1 - X3);           // a on a different scale — must agree (else f/x diverges)
        if(Math.abs(a - aLo) > 1e-3 * Math.max(1, Math.abs(a))) return null;
        var bFar = f2 - a * X2, bNear = f3 - a * X3; // b = lim [f(x) − a·x] — must converge across scales
        if(!isFinite(bFar) || Math.abs(bFar - bNear) > 1e-3 * Math.max(1, Math.abs(bFar))) return null;
        return { a: snap(a), b: snap(bFar) };
      }
      function lineEq(aa, bb){ var sx = aa === 1 ? 'x' : (aa === -1 ? '−x' : vtFmt(aa) + 'x'); if(bb > 0) sx += ' + ' + vtFmt(bb); else if(bb < 0) sx += ' − ' + vtFmt(Math.abs(bb)); return sx; }
      function axTerm(aa){ return aa === 1 ? 'x' : (aa === -1 ? '−x' : vtFmt(aa) + 'x'); }
      var asymLines = [];
      poles.slice().sort(function(p1, p2){ return p1.x - p2.x; }).forEach(function(p){ asymLines.push('Asymptote verticale : x = ' + vtFmt(p.x)); });
      [{ s: -1, lbl: '−∞', end: endNeg }, { s: 1, lbl: '+∞', end: endPos }].forEach(function(o){
        var inf = !isFinite(o.end) || Math.abs(o.end) > 1e8;
        var ob = oblique(o.s);
        if(inf && ob && Math.abs(ob.a) > 1e-9){
          asymLines.push('Asymptote oblique en ' + o.lbl + ' : y = ' + lineEq(ob.a, ob.b)
            + '   (a = lim f(x)/x = ' + vtFmt(ob.a) + ' ; b = lim[f(x) − ' + axTerm(ob.a) + '] = ' + vtFmt(ob.b) + ')');
        } else if(!inf && ob) asymLines.push('Asymptote horizontale en ' + o.lbl + ' : y = ' + vtFmt(o.end));
        else if(inf) asymLines.push('Branche parabolique en ' + o.lbl + ' (lim f = ±∞, a = lim f(x)/x non finie — pas d\\'asymptote)');
      });

      // ---- Parity (needs a symmetric domain) ----
      function parity(){ var even = true, odd = true, n2 = 0; for(var k = 0; k < 12; k++){ var x = 0.7 + k * 1.3, fp1 = fAt(x), fm = fAt(-x); if(!isFinite(fp1) || !isFinite(fm)) return null; n2++; var sc = Math.max(1, Math.abs(fp1)); if(Math.abs(fm - fp1) > 1e-6 * sc) even = false; if(Math.abs(fm + fp1) > 1e-6 * sc) odd = false; } if(n2 < 4) return null; return even ? 'paire' : (odd ? 'impaire' : 'ni paire ni impaire'); }
      var par = parity();

      // ---- Intersections with the axes ----
      var y0 = isFinite(fAt(0)) ? vtFmt(fAt(0)) : null;
      var roots = [];
      for(var j4 = 1; j4 <= N; j4++){
        var a4 = ys[j4 - 1], b4 = ys[j4];
        if(isFinite(a4) && isFinite(b4) && a4 * b4 < 0){
          var xa4 = LO + (j4 - 1) * step, xb4 = LO + j4 * step, fa4 = a4;
          for(var i5 = 0; i5 < 46; i5++){ var m4 = (xa4 + xb4) / 2, fm4 = fAt(m4); if(!isFinite(fm4)){ xb4 = m4; continue; } if((fa4 < 0) !== (fm4 < 0)) xb4 = m4; else { xa4 = m4; fa4 = fm4; } }
          var rx = snap((xa4 + xb4) / 2);
          if(Math.abs(fAt(rx)) < 1e-3 && !poles.some(function(p){ return Math.abs(p.x - rx) < 2 * step; }) && !roots.some(function(r){ return Math.abs(r - rx) < 1e-3; })) roots.push(rx);
        }
      }
      if(roots.length > 8) roots = roots.slice(0, 8);

      // ---- Derivative + variation pts (exact extrema best-effort) ----
      var fp = derivExpr(expr);
      function exactCrit(){ var raw = ''; try { raw = ggbToText(ggb.evalCommandCAS('Solutions(Derivative(f)=0,x)')); } catch(e){ raw = ''; } if(!raw || raw === '?' || raw.indexOf('?') >= 0 || raw === '{}') return []; var out = []; splitTopLevel(raw).forEach(function(r){ r = (r || '').trim(); if(!r) return; var nx = NaN; try { ev('vtRn=' + r); nx = gv('vtRn'); ggb.deleteObject('vtRn'); } catch(e){} if(!isFinite(nx)) return; var ys2 = ''; try { ys2 = ggbToText(ggb.evalCommandCAS('f(' + r + ')')); } catch(e){ ys2 = ''; } ys2 = (ys2 || '').trim(); if(ys2 === '?' || ys2.indexOf('?') >= 0) ys2 = ''; out.push({ n: nx, xs: r, ys: ys2 }); }); return out; }
      var exList = exactCrit();
      try { ggb.deleteObject('vtRes'); ggb.deleteObject('vtArg'); } catch(e){}
      function exClean(s){ return s && s.length <= 22 && s.indexOf('?') < 0; }
      function exMatch(nx){ for(var e2 = 0; e2 < exList.length; e2++){ if(Math.abs(exList[e2].n - nx) < 1e-2) return exList[e2]; } return null; }

      var stops = [];
      crit.forEach(function(c){ stops.push({ kind: 'pt', x: c.x, y: c.y }); });
      poles.forEach(function(p){ stops.push({ kind: 'asym', x: p.x, leftSign: p.leftSign, rightSign: p.rightSign }); });
      stops.sort(function(a5, b5){ return a5.x - b5.x; });
      var pts = [{ x: '−∞', y: vtFmtLim(endNeg), inYn: endNeg, outYn: endNeg, kind: 'pt' }];
      stops.forEach(function(st){
        if(st.kind === 'asym'){ pts.push({ x: vtFmt(st.x), kind: 'asym', leftSign: st.leftSign, rightSign: st.rightSign, inYn: st.leftSign * 1e15, outYn: st.rightSign * 1e15 }); }
        else { var em = exMatch(st.x); pts.push({ x: (em && exClean(em.xs)) ? em.xs : vtFmt(st.x), y: (em && exClean(em.ys)) ? em.ys : vtFmt(st.y), inYn: st.y, outYn: st.y, kind: 'pt' }); }
      });
      pts.push({ x: '+∞', y: vtFmtLim(endPos), inYn: endPos, outYn: endPos, kind: 'pt' });

      var limLines = ['lim(x→−∞) f(x) = ' + vtFmtLim(endNeg)];
      poles.slice().sort(function(p1, p2){ return p1.x - p2.x; }).forEach(function(p){ limLines.push('lim(x→' + vtFmt(p.x) + '⁻) f(x) = ' + (p.leftSign > 0 ? '+∞' : '−∞') + '   ;   lim(x→' + vtFmt(p.x) + '⁺) f(x) = ' + (p.rightSign > 0 ? '+∞' : '−∞')); });
      limLines.push('lim(x→+∞) f(x) = ' + vtFmtLim(endPos));

      // ---- Render the étude report (math via KaTeX; French labels in a serif font) ----
      var kq = [], kid = 0;
      function km(latex){ var id = 'sk' + (kid++); kq.push({ id: id, latex: latex }); return '<span class="study-math" id="' + id + '"></span>'; }
      function line(label, latex, work){
        var s = '<div class="study-line">';
        if(label) s += '<span class="study-lbl">' + label + '</span> ';
        if(latex) s += km(latex);
        if(work) s += '<div class="study-work">' + km(work) + '</div>';
        return s + '</div>';
      }
      function sec(title, body){ return '<div class="study-sec"><div class="study-t">' + title + '</div><div class="study-body">' + body + '</div></div>'; }
      // Convert our unicode-math strings (∞, ∪, ≠, ;, ±superscripts…) to LaTeX.
      var IN = BS + 'infty', LIM = BS + 'lim' + BS + 'limits', TO = BS + 'to ', SEMI = BS + ',;' + BS + ',';
      function tx(s){ return String(s)
        .split('−∞').join('-' + IN).split('+∞').join('+' + IN).split('∞').join(IN)
        .split('∪').join(BS + 'cup ').split('≠').join(BS + 'neq ').split('×').join(BS + 'times ')
        .split('⁻').join('^{-}').split('⁺').join('^{+}').split('−').join('-').split(' ; ').join(SEMI); }
      function axLatex(aa){ return aa === 1 ? 'x' : (aa === -1 ? '-x' : tx(vtFmt(aa)) + 'x'); }
      function lineEqLatex(aa, bb){ var sx = axLatex(aa); if(bb > 0) sx += ' + ' + tx(vtFmt(bb)); else if(bb < 0) sx += ' - ' + tx(vtFmt(Math.abs(bb))); return sx; }

      // 1 · Domaine
      var domLatex = 'D_f = ' + tx(domain) + (excluded.length ? BS + 'quad (x ' + BS + 'neq ' + excluded.map(tx).join(', ') + ')' : '');
      var bodyDom = line('', domLatex);
      // 2 · Parité
      var bodyPar = par ? '<div class="study-line"><span class="study-lbl">f est <strong>' + par + '</strong>'
        + (par === 'paire' ? ' — courbe symétrique par rapport à l\\'axe des ordonnées.' : (par === 'impaire' ? ' — courbe symétrique par rapport à l\\'origine.' : '.')) + '</span></div>' : '';
      // 3 · Limites et asymptotes
      var bodyAsym = '';
      poles.slice().sort(function(p1, p2){ return p1.x - p2.x; }).forEach(function(p){ bodyAsym += line('Asymptote verticale :', 'x = ' + tx(vtFmt(p.x))); });
      [{ s: -1, lbl: '−∞', sL: '-' + IN, end: endNeg }, { s: 1, lbl: '+∞', sL: '+' + IN, end: endPos }].forEach(function(o){
        var inf = !isFinite(o.end) || Math.abs(o.end) > 1e8, ob = oblique(o.s);
        if(inf && ob && Math.abs(ob.a) > 1e-9){
          var work = 'a = ' + LIM + '_{x ' + TO + o.sL + '}' + BS + 'dfrac{f(x)}{x} = ' + tx(vtFmt(ob.a))
            + ' ' + BS + 'quad b = ' + LIM + '_{x ' + TO + o.sL + '}' + BS + 'big(f(x) - ' + axLatex(ob.a) + BS + 'big) = ' + tx(vtFmt(ob.b));
          bodyAsym += line('Asymptote oblique en ' + o.lbl + ' :', 'y = ' + lineEqLatex(ob.a, ob.b), work);
        } else if(!inf && ob) bodyAsym += line('Asymptote horizontale en ' + o.lbl + ' :', 'y = ' + tx(vtFmt(o.end)));
        else if(inf) bodyAsym += '<div class="study-line"><span class="study-lbl">Branche parabolique en ' + o.lbl + ' (pas d\\'asymptote linéaire).</span></div>';
      });
      bodyAsym += '<hr class="study-hr">';
      bodyAsym += line('', LIM + '_{x ' + TO + '-' + IN + '} f(x) = ' + tx(vtFmtLim(endNeg)));
      poles.slice().sort(function(p1, p2){ return p1.x - p2.x; }).forEach(function(p){
        bodyAsym += line('', LIM + '_{x ' + TO + tx(vtFmt(p.x)) + '^{-}} f(x) = ' + (p.leftSign > 0 ? '+' + IN : '-' + IN)
          + ' ' + BS + 'qquad ' + LIM + '_{x ' + TO + tx(vtFmt(p.x)) + '^{+}} f(x) = ' + (p.rightSign > 0 ? '+' + IN : '-' + IN));
      });
      bodyAsym += line('', LIM + '_{x ' + TO + '+' + IN + '} f(x) = ' + tx(vtFmtLim(endPos)));
      // 4 · Dérivée
      var fpLatex = ''; if(fp){ try { fpLatex = toLatex(fp.split(' ').join('')); } catch(e){ fpLatex = ''; } }
      var bodyDer = fp ? line('', "f'(x) = " + (fpLatex || (BS + 'text{' + fp + '}'))) : '<div class="study-line"><span class="study-lbl">Voir le signe dans le tableau ci-dessous.</span></div>';
      // 6 · Points caractéristiques
      var bodyPts = '';
      if(y0 !== null) bodyPts += line('Ordonnée à l\\'origine :', 'f(0) = ' + tx(y0));
      if(roots.length) bodyPts += line('Intersections avec (Ox) :', 'x = ' + roots.map(function(r){ return tx(vtFmt(r)); }).join(' ' + BS + ';;' + BS + '; '));
      else bodyPts += '<div class="study-line"><span class="study-lbl">Pas d\\'intersection simple avec (Ox) détectée.</span></div>';

      var report = '<div class="ml-study"><div class="study-head"><i class="bi bi-clipboard2-data"></i> Étude complète — <span id="study-fx">f(x) = ' + escapeHtml(expr) + '</span></div>'
        + sec('1 · Domaine de définition', bodyDom)
        + (bodyPar ? sec('2 · Parité', bodyPar) : '')
        + sec('3 · Limites et asymptotes', bodyAsym)
        + sec('4 · Dérivée', bodyDer)
        + '<div class="study-sec"><div class="study-t">5 · Tableau de variation</div>' + variationTableHTML(pts, '', {}) + '</div>'
        + sec('6 · Points caractéristiques', bodyPts)
        + '</div>';
      answerEl.innerHTML = report;
      try { var fxEl = document.getElementById('study-fx'); if(fxEl) renderKatex(fxEl, 'f(x) = ' + toLatex(expr)); } catch(e){}
      kq.forEach(function(it){ var el = document.getElementById(it.id); if(el){ try { renderKatex(el, it.latex); } catch(e){} } });
      stateEl.innerHTML = '<span class="ml-spinner"></span> Rédaction de l\\'étude…';

      // ---- Anchored summary for Claude ----
      var parts = ['Df = ' + domain];
      if(par) parts.push('parité : ' + par);
      if(asymLines.length) parts.push('asymptotes : ' + asymLines.join(' ; '));
      parts.push('limites : ' + vtFmtLim(endNeg) + ' en −∞, ' + vtFmtLim(endPos) + ' en +∞');
      if(fp) parts.push("f'(x) = " + fp);
      if(crit.length) parts.push('extrema : ' + crit.map(function(c){ return 'x=' + vtFmt(c.x) + ' (f=' + vtFmt(c.y) + ')'; }).join(', '));
      if(y0 !== null) parts.push('f(0) = ' + y0);
      if(roots.length) parts.push('racines : ' + roots.map(vtFmt).join(', '));
      var summary = parts.join(' ; ').slice(0, 490);

      try {
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ function: expr, operation: 'study', casResult: summary }) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){ stateEl.textContent = 'Connexion impossible — réessayez.'; }
      finally { setOpsEnabled(true); }
    }

    /* ---- Tangente en x₀ ---- */
    async function runTangent(){
      var expr = (fxInput.value || '').trim();
      if(!expr){ stateEl.textContent = 'Saisissez une fonction.'; return; }
      if(!ggb){ return; }
      var x0s = (document.getElementById('tanx0').value || '').trim();
      if(!x0s){ stateEl.textContent = 'Indiquez le point x₀.'; return; }
      plot(expr);
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul de la tangente…';
      setOpsEnabled(false);

      function ev(c){ try { ggb.evalCommand(c); return true; } catch(e){ return false; } }
      function gv(l){ try { return ggb.getValue(l); } catch(e){ return NaN; } }
      ev('vtArg=0'); ev('vtRes=f(vtArg)');
      function fAt(x){ ev('SetValue(vtArg,' + x + ')'); return gv('vtRes'); }
      var x0 = Number(x0s);
      if(!isFinite(x0)){ if(ev('vtX0=' + x0s)){ x0 = gv('vtX0'); try { ggb.deleteObject('vtX0'); } catch(e){} } }
      if(!isFinite(x0)){ stateEl.textContent = 'Point x₀ invalide.'; try { ggb.deleteObject('vtRes'); ggb.deleteObject('vtArg'); } catch(e){} setOpsEnabled(true); return; }
      var y0 = fAt(x0);
      if(!isFinite(y0)){ stateEl.textContent = "f n'est pas définie en x₀ = " + vtFmt(x0) + '.'; try { ggb.deleteObject('vtRes'); ggb.deleteObject('vtArg'); } catch(e){} setOpsEnabled(true); return; }
      var h = 1e-5, m = (fAt(x0 + h) - fAt(x0 - h)) / (2 * h);
      try { ggb.deleteObject('vtRes'); ggb.deleteObject('vtArg'); } catch(e){}
      // snap to clean values for display
      function sn(v){ var r = Math.round(v * 1e4) / 1e4; if(Math.abs(r - Math.round(r)) < 1e-3) r = Math.round(r); return r; }
      m = sn(m); y0 = sn(y0); var bb = sn(y0 - m * x0);
      // plot tangent + point
      try { ggb.deleteObject('TLine'); } catch(e){}
      try { ggb.deleteObject('TPt'); } catch(e){}
      try { ggb.evalCommand('TLine: y = ' + m + '*(x - ' + x0 + ') + ' + y0); ggb.setColor('TLine', 245, 158, 11); ggb.setLineThickness('TLine', 4); } catch(e){}
      try { ggb.evalCommand('TPt = (' + x0 + ', ' + y0 + ')'); ggb.setColor('TPt', 93, 6, 186); ggb.setPointSize('TPt', 5); } catch(e){}

      function lineEqL(a2, b2){ var sx = a2 === 1 ? 'x' : (a2 === -1 ? '-x' : vtFmt(a2) + 'x'); if(b2 > 0) sx += ' + ' + vtFmt(b2); else if(b2 < 0) sx += ' - ' + vtFmt(Math.abs(b2)); else if(a2 === 0) sx = vtFmt(b2); return sx; }
      var eqStr = 'y = ' + lineEqL(m, bb);
      answerEl.innerHTML = '<div class="ml-answer"><div class="lbl"><i class="bi bi-rulers"></i> Tangente en x₀ = ' + escapeHtml(vtFmt(x0)) + '</div>'
        + '<div class="val" id="tan-eq"></div>'
        + '<div class="vt-deriv" id="tan-det"></div></div>';
      try { renderKatex(document.getElementById('tan-eq'), eqStr); } catch(e){}
      try { renderKatex(document.getElementById('tan-det'), "f(" + vtFmt(x0) + ") = " + vtFmt(y0) + " " + BS + "qquad f'(" + vtFmt(x0) + ") = " + vtFmt(m)); } catch(e){}
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';

      try {
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ function: expr, operation: 'tangent', x0: x0s, casResult: eqStr }) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){ stateEl.textContent = 'Connexion impossible — réessayez.'; }
      finally { setOpsEnabled(true); }
    }

    /* ---- Convexité / points d'inflexion (f'') ---- */
    async function runConvexity(){
      var expr = (fxInput.value || '').trim();
      if(!expr){ stateEl.textContent = 'Saisissez une fonction.'; return; }
      if(!ggb){ return; }
      plot(expr);
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Étude de la convexité…';
      setOpsEnabled(false);

      // f''(x) symbolic (for display) via the JS differentiator, twice.
      var fpp = '';
      try { var ast = dxParse(dxTok(expr)); if(ast){ var d2 = dxDiff(dxDiff(ast)); if(d2){ d2 = dxSimp(dxSimp(dxSimp(d2))); var s2 = dxPretty(d2); if(s2 && s2.indexOf('?') < 0) fpp = s2; } } } catch(e){}

      function ev(c){ try { ggb.evalCommand(c); return true; } catch(e){ return false; } }
      function gv(l){ try { return ggb.getValue(l); } catch(e){ return NaN; } }
      ev('vtArg=0'); ev('vtRes=f(vtArg)');
      function fAt(x){ ev('SetValue(vtArg,' + x + ')'); return gv('vtRes'); }
      var hh = 1e-3;
      function f2(x){ var a = fAt(x - hh), b = fAt(x), c = fAt(x + hh); if(!isFinite(a) || !isFinite(b) || !isFinite(c)) return NaN; return (a - 2 * b + c) / (hh * hh); }
      function snap(x){ return Math.abs(x - Math.round(x)) < 1e-4 ? Math.round(x) : x; }

      var LO = -50, HI = 50, N = 800, step = (HI - LO) / N;
      var s2v = []; for(var i = 0; i <= N; i++) s2v[i] = f2(LO + i * step);
      // inflection points: f'' changes sign between two FINITE, moderate samples (not a pole).
      // Bracket from the last definite-sign sample (handles f''=0 landing on a grid point).
      var infl = [], lastSign = 0, prevIdx = 0;
      for(var j = 1; j <= N; j++){
        var a = s2v[j - 1], b = s2v[j];
        if(!isFinite(a) || !isFinite(b) || Math.abs(a) > 1e6 || Math.abs(b) > 1e6){ lastSign = 0; continue; }
        var sg = b > 1e-9 ? 1 : (b < -1e-9 ? -1 : 0);
        if(sg !== 0){
          if(lastSign !== 0 && sg !== lastSign){
            var xa = LO + prevIdx * step, xb = LO + j * step, fa = s2v[prevIdx];
            for(var it = 0; it < 44; it++){ var mx = (xa + xb) / 2, fm = f2(mx); if(!isFinite(fm)){ xb = mx; continue; } if((fa < 0) !== (fm < 0)) xb = mx; else { xa = mx; fa = fm; } }
            var rx = snap((xa + xb) / 2);
            var yr = fAt(rx);
            if(isFinite(yr) && !infl.some(function(p){ return Math.abs(p.x - rx) < 1e-2; })) infl.push({ x: rx, y: snap(yr) });
          }
          lastSign = sg; prevIdx = j;
        }
      }
      if(infl.length > 8) infl = infl.slice(0, 8);
      try { ggb.deleteObject('vtRes'); ggb.deleteObject('vtArg'); } catch(e){}

      // Convexity intervals between consecutive inflection points (sample the midpoint sign).
      var cuts = infl.map(function(p){ return p.x; }).sort(function(a, b){ return a - b; });
      ev('vtArg=0'); ev('vtRes=f(vtArg)');
      var bounds = [-Infinity].concat(cuts).concat([Infinity]), convLines = [];
      for(var s = 0; s < bounds.length - 1; s++){
        var L = bounds[s], R = bounds[s + 1];
        var mid = (isFinite(L) && isFinite(R)) ? (L + R) / 2 : (isFinite(L) ? L + 1 : (isFinite(R) ? R - 1 : 0));
        var v = f2(mid); if(!isFinite(v) || v === 0) continue;
        var lo = isFinite(L) ? vtFmt(L) : '-∞', hi = isFinite(R) ? vtFmt(R) : '+∞';
        convLines.push({ conv: v > 0, lo: lo, hi: hi });
      }
      try { ggb.deleteObject('vtRes'); ggb.deleteObject('vtArg'); } catch(e){}

      // Render (KaTeX; BS for backslashes)
      var IN2 = BS + 'infty', SEMI2 = BS + ',;' + BS + ',';
      function tx2(s){ return String(s).split('-∞').join('-' + IN2).split('+∞').join('+' + IN2).split('−').join('-'); }
      var kq = [], kid = 0;
      function km(latex){ var id = 'cvk' + (kid++); kq.push({ id: id, latex: latex }); return '<span class="study-math" id="' + id + '"></span>'; }
      function line(label, latex){ var s = '<div class="study-line">'; if(label) s += '<span class="study-lbl">' + label + '</span> '; if(latex) s += km(latex); return s + '</div>'; }
      var body = '';
      if(fpp){ var fppL = ''; try { fppL = toLatex(fpp.split(' ').join('')); } catch(e){ fppL = ''; } body += line('', "f''(x) = " + (fppL || (BS + 'text{' + fpp + '}'))); }
      if(!convLines.length) body += '<div class="study-line"><span class="study-lbl">f a une convexité constante sur son domaine.</span></div>';
      convLines.forEach(function(c){ body += line(c.conv ? 'f est convexe sur' : 'f est concave sur', ']' + tx2(c.lo) + SEMI2 + tx2(c.hi) + '['); });
      infl.forEach(function(p){ body += line('Point d\\'inflexion :', 'x = ' + tx2(vtFmt(p.x)) + ', ' + BS + 'quad f(x) = ' + tx2(vtFmt(p.y))); });

      answerEl.innerHTML = '<div class="ml-study" style="padding:.9rem 1.1rem"><div class="study-head"><i class="bi bi-graph-up-arrow"></i> Convexité &amp; points d\\'inflexion</div><div class="study-body">' + body + '</div></div>';
      kq.forEach(function(it){ var el = document.getElementById(it.id); if(el){ try { renderKatex(el, it.latex); } catch(e){} } });
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';

      var parts = [];
      if(fpp) parts.push("f''(x) = " + fpp);
      convLines.forEach(function(c){ parts.push((c.conv ? 'convexe' : 'concave') + ' sur ]' + c.lo + ';' + c.hi + '['); });
      if(infl.length) parts.push('inflexion : ' + infl.map(function(p){ return 'x=' + vtFmt(p.x) + ' (f=' + vtFmt(p.y) + ')'; }).join(', '));
      var summary = parts.join(' ; ').slice(0, 480) || 'convexité constante';

      try {
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ function: expr, operation: 'convexity', casResult: summary }) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){ stateEl.textContent = 'Connexion impossible — réessayez.'; }
      finally { setOpsEnabled(true); }
    }

    opsEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return;
      var op = btn.getAttribute('data-op');
      if(op === 'study'){ runStudy(); return; }
      if(op === 'variations'){ runVariation(); return; }
      if(op === 'domain'){ runDomain(); return; }
      if(op === 'tangent'){ runTangent(); return; }
      if(op === 'convexity'){ runConvexity(); return; }
      if(op === 'limit'){ fnLimitPanel.hidden = !fnLimitPanel.hidden; if(!fnLimitPanel.hidden){ refreshSideButtons(); updateLimPreview(); lpointInput.focus(); } btn.classList.toggle('is-open', !fnLimitPanel.hidden); return; }
      run(op);
    });

    // Manual "Tracer" — redraw the curve from the current input.
    function doPlot(){
      updatePreview();
      var expr = (fxInput.value || '').trim();
      if(!expr){ stateEl.textContent = 'Saisissez une fonction.'; return; }
      if(!ggb){ return; }
      plot(expr);
      stateEl.textContent = '';
    }
    plotBtn.addEventListener('click', doPlot);
    fxInput.addEventListener('keydown', function(ev){ if(ev.key === 'Enter'){ ev.preventDefault(); doPlot(); } });

    /* ============ NOMBRES COMPLEXES (complex mode) ============ */
    var modesEl   = document.getElementById('modes');
    var modeFunc  = document.getElementById('mode-function');
    var modeCplx  = document.getElementById('mode-complex');
    var graphTitle= document.getElementById('graph-title');
    var graphHint = document.getElementById('graph-hint');
    var z1Input   = document.getElementById('z1');
    var z2Input   = document.getElementById('z2');
    var cnInput   = document.getElementById('cn');
    var z2Row     = document.getElementById('z2-row');
    var z1Label   = document.getElementById('z1-label');
    var nRow      = document.getElementById('n-row');
    var zPreviewEl= document.getElementById('zPreview');
    var ckeysEl   = document.getElementById('ckeys');
    var copsEl    = document.getElementById('cops');
    var activeZ   = z1Input;
    var currentMode = 'function';
    var complexObjs = [];

    function setCOpsEnabled(on){ copsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }

    // Single operand "z" by default; binary ops (z₁∘z₂) reveal z₂ and relabel z₁.
    function setComplexArity(binary){
      z2Row.hidden = !binary;
      if(z1Label) z1Label.textContent = binary ? 'z₁ =' : 'z =';
      updateZPreview();
    }

    function updateZPreview(){
      var raw = (z1Input.value || '').trim();
      if(!raw){ zPreviewEl.className='ml-preview is-empty'; zPreviewEl.textContent='Aperçu du nombre complexe…'; return; }
      var latex = null;
      try { latex = toLatex(raw); } catch(e){ latex = null; }
      if(latex == null){ zPreviewEl.className='ml-preview is-empty'; zPreviewEl.textContent='…en cours de saisie'; return; }
      var binary = !z2Row.hidden;
      var tex = (binary ? 'z_1' : 'z') + ' = ' + latex;
      if(binary){
        var raw2 = (z2Input.value || '').trim();
        if(raw2){ var l2 = null; try { l2 = toLatex(raw2); } catch(e){ l2 = null; } if(l2 != null) tex += BS + 'quad z_2 = ' + l2; }
      }
      try { katex.render(tex, zPreviewEl, { throwOnError:true, displayMode:false }); zPreviewEl.className='ml-preview'; }
      catch(e){ zPreviewEl.className='ml-preview is-empty'; zPreviewEl.textContent='…en cours de saisie'; }
    }

    [z1Input, z2Input].forEach(function(inp){
      inp.addEventListener('focus', function(){ activeZ = inp; });
      inp.addEventListener('input', updateZPreview);
    });

    function insertInto(inp, tok){
      var val = inp.value, s = inp.selectionStart, e = inp.selectionEnd;
      if(s == null){ s = e = val.length; }
      var caret = tok.indexOf('|'); var clean = tok.replace('|','');
      inp.value = val.slice(0, s) + clean + val.slice(e);
      var pos = s + (caret >= 0 ? caret : clean.length);
      inp.focus(); inp.setSelectionRange(pos, pos);
    }
    ckeysEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-key'); if(!btn) return;
      var inp = activeZ || z1Input;
      var act = btn.getAttribute('data-cact');
      if(act === 'clear'){ inp.value=''; inp.focus(); }
      else if(act === 'back'){
        var v=inp.value, s=inp.selectionStart, e=inp.selectionEnd;
        if(s == null){ inp.value = v.slice(0,-1); }
        else if(s !== e){ inp.value = v.slice(0,s)+v.slice(e); inp.setSelectionRange(s,s); }
        else if(s > 0){ inp.value = v.slice(0,s-1)+v.slice(s); inp.setSelectionRange(s-1,s-1); }
        inp.focus();
      }
      else { insertInto(inp, btn.getAttribute('data-cins')); }
      updateZPreview();
    });

    // Canonical expression (cache key + sent to server)
    function complexExpr(op, z1, z2, n, arith){
      switch(op){
        case 'power':      return '(' + z1 + ')^' + n;
        case 'arithmetic':
          var sym = arith==='sum' ? '+' : arith==='product' ? '*' : '/';
          return '(' + z1 + ')' + sym + '(' + z2 + ')';
        default:           return z1;
      }
    }
    // GeoGebra CAS command for the operation (exp_form handled separately)
    function complexCAS(op, z1, z2, n, arith){
      var Z = '(' + z1 + ')';
      switch(op){
        case 'modulus':   return 'abs(' + Z + ')';
        case 'argument':  return 'arg(' + Z + ')';
        case 'conjugate': return 'Conjugate(' + Z + ')';
        case 'power':     return Z + '^(' + n + ')';
        case 'nth_roots': return 'CSolutions(x^(' + n + ')=' + Z + ', x)';
        case 'arithmetic':
          var sym = arith==='sum' ? '+' : arith==='product' ? '*' : '/';
          return Z + sym + '(' + z2 + ')';
        default: return null;
      }
    }

    function clearComplexPlot(){
      complexObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} });
      complexObjs = [];
    }
    function defObj(name, cmd){ try { ggb.evalCommand(name + '=' + cmd); complexObjs.push(name); } catch(e){} }
    function colour(name, r, g, b){ try { ggb.setColor(name, r, g, b); } catch(e){} }

    // Argand diagram: plot z₁ (+ vector from origin) and any result point(s).
    function plotComplex(op, z1, z2, n, arith){
      if(!ggb) return;
      clearComplexPlot();
      try { ggb.deleteObject('f'); } catch(e){}
      defObj('z_1', '(' + z1 + ')');
      defObj('v_1', 'Vector(z_1)');
      colour('z_1', 93, 6, 186); colour('v_1', 93, 6, 186);
      if(op === 'arithmetic'){
        defObj('z_2', '(' + z2 + ')');
        var sym = arith==='sum' ? '+' : arith==='product' ? '*' : '/';
        defObj('z_3', '(' + z1 + ')' + sym + '(' + z2 + ')');
        colour('z_2', 168, 85, 247); colour('z_3', 255, 184, 0);
      } else if(op === 'conjugate'){
        defObj('z_c', '(x(z_1), -y(z_1))'); colour('z_c', 255, 184, 0);
      } else if(op === 'power'){
        defObj('z_p', 'z_1^(' + n + ')'); colour('z_p', 255, 184, 0);
      } else if(op === 'nth_roots'){
        defObj('R', 'CSolutions(x^(' + n + ')=z_1, x)'); colour('R', 255, 184, 0);
      }
      fitComplex();
    }

    // Fit the view around the origin + every plotted point (stable API, no ZoomFit command).
    function fitComplex(){
      var xs = [0], ys = [0];
      complexObjs.forEach(function(nm){
        try {
          var x = ggb.getXcoord(nm), y = ggb.getYcoord(nm);
          if(isFinite(x) && isFinite(y) && !(x === 0 && y === 0)){ xs.push(x); ys.push(y); }
        } catch(e){}
      });
      var minX = Math.min.apply(null, xs), maxX = Math.max.apply(null, xs);
      var minY = Math.min.apply(null, ys), maxY = Math.max.apply(null, ys);
      var padX = Math.max(2, (maxX - minX) * 0.25), padY = Math.max(2, (maxY - minY) * 0.25);
      try { ggb.setCoordSystem(minX - padX, maxX + padX, minY - padY, maxY + padY); } catch(e){}
    }

    async function runComplex(op, arith, needs){
      var z1 = (z1Input.value || '').trim();
      if(!z1){ stateEl.textContent = 'Saisissez z₁.'; return; }
      if(needs === 'z2'){ z2Row.hidden = false; }
      if(needs === 'n'){ nRow.hidden = false; }
      var z2 = (z2Input.value || '').trim();
      var n  = parseInt(cnInput.value, 10);
      if(needs === 'z2' && !z2){ stateEl.textContent = 'Saisissez z₂.'; z2Input.focus(); return; }
      if(needs === 'n' && !(n >= 2 && n <= 12)){ stateEl.textContent = 'n doit être un entier entre 2 et 12.'; cnInput.focus(); return; }
      if(!ggb){ return; }

      var gz1 = normCplx(z1), gz2 = normCplx(z2); // GeoGebra-safe (explicit multiplication)
      plotComplex(op, gz1, gz2, n, arith);
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul en cours…';
      setCOpsEnabled(false);

      var casResult = '';
      try {
        if(op === 'exp_form'){
          var r  = ggb.evalCommandCAS('abs((' + gz1 + '))');
          var th = ggb.evalCommandCAS('arg((' + gz1 + '))');
          if(r && th){ casResult = r + '*e^(i*(' + th + ')) = ' + r + '*(cos(' + th + ') + i*sin(' + th + '))'; }
        } else if(op === 'algebraic_form'){
          var v = evalComplex('(' + gz1 + ')'); // reliable real/imag extraction
          if(v){ casResult = fmtComplexVal(v.re, v.im); }
        } else if(op === 'conjugate'){
          var vc = evalComplex('(' + gz1 + ')'); // conjugate = a − bi (no GeoGebra Conjugate command)
          if(vc){ casResult = fmtComplexVal(vc.re, -vc.im); }
        } else if(op === 'trig_form'){
          var rt = ggb.evalCommandCAS('abs((' + gz1 + '))');
          var tt = ggb.evalCommandCAS('arg((' + gz1 + '))');
          if(rt && tt){ casResult = rt + '*(cos(' + tt + ') + i*sin(' + tt + '))'; }
        } else {
          var cmd = complexCAS(op, gz1, gz2, n, arith);
          if(cmd){ casResult = ggb.evalCommandCAS(cmd); }
        }
      } catch(e){ casResult = ''; }
      if(!casResult){ stateEl.textContent = "Impossible de calculer — vérifiez l'écriture (ex : 3+4i)."; setCOpsEnabled(true); return; }

      answerEl.innerHTML = '<div class="ml-answer"><div class="lbl"><i class="bi bi-stars"></i> Résultat</div><div class="val">' + escapeHtml(casResult) + '</div></div>';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';

      var payload = { domain:'complex', operation: op, expression: complexExpr(op, z1, z2, n, arith), casResult: casResult };
      if(op === 'arithmetic'){ payload.z2 = z2; payload.arithOp = arith; }
      if(op === 'power' || op === 'nth_roots'){ payload.n = n; }

      try {
        var resp = await fetch(EXPLAIN_URL, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify(payload)
        });
        var data = await resp.json();
        if(data.ok){ showSteps(data); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){
        stateEl.textContent = 'Connexion impossible — réessayez.';
      } finally {
        setCOpsEnabled(true);
      }
    }

    copsEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return;
      setComplexArity(btn.getAttribute('data-needs') === 'z2');
      runComplex(btn.getAttribute('data-cop'), btn.getAttribute('data-arith'), btn.getAttribute('data-needs'));
    });

    /* --- Équation polynomiale dans ℂ : a z^3 + b z^2 + c z + d = 0 --- */
    var eqaInput = document.getElementById('eqa');
    var eqbInput = document.getElementById('eqb');
    var eqcInput = document.getElementById('eqc');
    var eqdInput = document.getElementById('eqd');
    var eqPreviewEl = document.getElementById('eqPreview');
    var eqSolveBtn = document.getElementById('eq-solve');
    var eqInputs = [eqaInput, eqbInput, eqcInput, eqdInput];

    eqInputs.forEach(function(inp){
      inp.addEventListener('focus', function(){ activeZ = inp; });
      inp.addEventListener('input', updateEqPreview);
      inp.addEventListener('keydown', function(ev){ if(ev.key === 'Enter'){ ev.preventDefault(); runSolve(); } });
    });

    function eqLatex(){
      var tex = [];
      for(var i = 0; i < 4; i++){
        var raw = (eqInputs[i].value || '').trim() || '0';
        try { tex.push(toLatex(raw)); } catch(e){ return null; }
      }
      return '(' + tex[0] + ') z^3 + (' + tex[1] + ') z^2 + (' + tex[2] + ') z + (' + tex[3] + ') = 0';
    }
    function updateEqPreview(){
      var tex = null; try { tex = eqLatex(); } catch(e){ tex = null; }
      if(tex == null){ eqPreviewEl.className = 'ml-preview is-empty'; eqPreviewEl.textContent = '…en cours de saisie'; return; }
      try { katex.render(tex, eqPreviewEl, { throwOnError:true, displayMode:false }); eqPreviewEl.className = 'ml-preview'; }
      catch(e){ eqPreviewEl.className = 'ml-preview is-empty'; eqPreviewEl.textContent = '…en cours de saisie'; }
    }
    function buildEquation(){
      var a = (eqaInput.value || '').trim() || '0';
      var b = (eqbInput.value || '').trim() || '0';
      var c = (eqcInput.value || '').trim() || '0';
      var d = (eqdInput.value || '').trim() || '0';
      return '(' + a + ')*z^3 + (' + b + ')*z^2 + (' + c + ')*z + (' + d + ')';
    }

    // Shown only for degree ≤ 2 (a = 0). Solved with the reliable JS quadratic formula.
    function eqIsCubic(){ return !cIsZero(coefVal(eqaInput.value)); }
    function refreshDirectSolve(){
      var cubic = eqIsCubic();
      document.getElementById('eq-direct-row').hidden = cubic;
      document.getElementById('eq-cubic-hint').hidden = !cubic;
    }
    eqaInput.addEventListener('input', refreshDirectSolve);

    async function runSolve(){
      if(eqIsCubic()){ return; } // direct solve is for degree ≤ 2 only
      var b = (eqbInput.value || '').trim(), c = (eqcInput.value || '').trim(), d = (eqdInput.value || '').trim();
      if(!ggb){ return; }
      var qb = coefVal(eqbInput.value), qc = coefVal(eqcInput.value), qd = coefVal(eqdInput.value);
      if(cIsZero(qb) && cIsZero(qc)){ stateEl.textContent = 'Renseignez au moins le coefficient b ou c (équation en z).'; return; }

      clearComplexPlot(); try { ggb.deleteObject('f'); } catch(e){}
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
