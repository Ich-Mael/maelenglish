    // ---- exact linear solve (fractions): A (rows) · x = b → { x } | { none } | { many } ----
    function vcSolve(A, b){
      var m = A[0] ? A[0].length : 0, M = A.map(function(r, i){ return r.concat([b[i]]); }), row = 0, piv = [];
