    }

    // ---- roots of a complex polynomial (exact when they snap to fractions) ----
    function czRoots(p){
      p = czTrim(p); var deg = czDeg(p);
      if(deg <= 0) return [];
      if(deg === 1){ var r = cfDiv(cf(fNeg(p[0].re), fNeg(p[0].im)), p[1]); return [{ z: r, exact: true, x: fVal(r.re), y: fVal(r.im) }]; }
      if(deg === 2){ var ex = czQuadExact(p[2], p[1], p[0]); if(ex) return ex; }
      var coefs = p.slice().reverse().map(function(c){ return { re: fVal(c.re), im: fVal(c.im) }; });
      return polyRootsJS(coefs).map(function(z){
        var a = fFromNum(Math.round(z.re * 1e9) / 1e9), b = fFromNum(Math.round(z.im * 1e9) / 1e9);
        if(a && b && cfZero(czEval(p, cf(a, b)))) return { z: cf(a, b), exact: true, x: fVal(a), y: fVal(b) };
        return { approx: true, x: z.re, y: z.im };
      });
    }
    // a z² + b z + c = 0 with exact roots when Δ is real, or a perfect square in ℂ. Roots: w ± s·v (s = √r or 1)
    function czQuadExact(a, b, c){
      var delta = cfSub(cfMul(b, b), cfMul(cf(fr(4)), cfMul(a, c))), twoA = cfMul(cf(fr(2)), a);
      var w = cfDiv(cf(fNeg(b.re), fNeg(b.im)), twoA), v, rad = 1, k = fr(1);
      if(fZero(delta.im)){
        var D = delta.re, neg = D.n < 0, ab = fr(Math.abs(D.n), D.d);
        var sr = simplifyRadical(ab.n * ab.d); rad = sr.rad; k = fr(sr.coef, ab.d); // √|Δ| = k·√rad
        v = cfDiv(neg ? cf(fr(0), fr(1)) : cf(fr(1)), twoA);
      } else {
        var mod = fSqrt(cfAbs2(delta)); if(!mod) return null;
        var pp = fSqrt(fDiv(fAdd(delta.re, mod), fr(2))); if(!pp || fZero(pp)) return null;
        var qq = fDiv(delta.im, fMul(fr(2), pp));
        v = cfDiv(cf(pp, qq), twoA);
      }
      function part(c0, c1){ // c0 ± k·c1·√rad  → tex for both signs
        var c1k = fMul(c1, k);
        if(rad === 1){ return [fAdd(c0, c1k), fSub(c0, c1k)].map(function(f){ return { tex: fTex(f), val: fVal(f), zero: fZero(f), frac: f }; }); }
        var L = c0.d * c1k.d / (igcd(c0.d, c1k.d) || 1), n0 = c0.n * (L / c0.d), n1 = c1k.n * (L / c1k.d);
        return [1, -1].map(function(sg){
          var m = sg * n1, g = igcd(igcd(n0, Math.abs(m)), L) || 1, a0 = n0 / g, a1 = m / g, den = L / g;
          var rt = (Math.abs(a1) === 1 ? '' : Math.abs(a1)) + BS + 'sqrt{' + rad + '}';
          var num = a1 === 0 ? String(a0) : (a0 !== 0 ? a0 + (a1 < 0 ? ' - ' : ' + ') + rt : (a1 < 0 ? '-' : '') + rt);
          return { tex: den === 1 ? num : BS + 'dfrac{' + num + '}{' + den + '}', val: (a0 + a1 * Math.sqrt(rad)) / den, zero: false, frac: null, compound: den === 1 && a0 !== 0 && a1 !== 0 };
        });
      }
      var re = part(w.re, v.re), im = part(w.im, v.im), out = [];
      for(var i = 0; i < 2; i++){
        var R0 = re[i], I0 = im[i], reZero = rad === 1 ? R0.zero : (Math.abs(R0.val) < 1e-15), imZero = rad === 1 ? I0.zero : (Math.abs(I0.val) < 1e-15);
        var tex;
        if(imZero) tex = reZero ? '0' : R0.tex;
        else {
          var itx = I0.tex === '1' ? 'i' : I0.tex === '-1' ? '-i' : (I0.compound ? BS + 'left(' + I0.tex + BS + 'right)' : I0.tex) + BS + ',i';
          tex = reZero ? itx : R0.tex + (itx.charAt(0) === '-' ? ' - ' + itx.slice(1) : ' + ' + itx);
        }
        var exactZ = (rad === 1) ? cf(R0.frac, I0.frac) : null;
        out.push({ exact: true, tex: tex, z: exactZ, x: R0.val, y: I0.val, plain: tex.split(BS + 'dfrac{').join('(').split(BS + 'sqrt{').join('sqrt(').split('}{').join(')/(').split('}').join(')').split(BS + 'left(').join('(').split(BS + 'right)').join(')').split(BS + ',').join('') });
      }
      if(Math.abs(out[0].x - out[1].x) < 1e-12 && Math.abs(out[0].y - out[1].y) < 1e-12) out = [out[0]];
      return out;
    }
    function zfRootTex(r){
      if(r.tex) return r.tex;
      if(r.exact) return cfTex(r.z);
      var re = Math.round(r.x * 1000) / 1000, im = Math.round(r.y * 1000) / 1000;
      return BS + 'approx ' + (re !== 0 ? re + (im ? (im < 0 ? ' - ' : ' + ') + Math.abs(im) + 'i' : '') : (im ? im + 'i' : '0'));
    }
    function zfRootPlain(r){ if(r.plain) return r.plain; return r.exact ? cfPlain(r.z) : '~' + (Math.round(r.x * 1000) / 1000) + (r.y >= 0 ? '+' : '-') + Math.abs(Math.round(r.y * 1000) / 1000) + 'i'; }
    function zfCzTex(p){ // complex polynomial in z as LaTeX
      p = czTrim(p); var out = '', first = true;
      for(var k = p.length - 1; k >= 0; k--){
        var c = p[k]; if(cfZero(c)) continue;
        var m = k === 0 ? '' : (k === 1 ? 'z' : 'z^{' + k + '}'), t, sign = '+';
        if(!fZero(c.re) && !fZero(c.im)) t = BS + 'left(' + cfTex(c) + BS + 'right)' + m;
        else { var s = cfTex(c); if(s.charAt(0) === '-'){ sign = '-'; s = s.slice(1); } if(m && s === '1') s = ''; t = s + m; }
        out += first ? (sign === '-' ? '-' : '') + t : ' ' + sign + ' ' + t; first = false;
      }
      return out || '0';
    }

    // ---- parse + preview ----
    function zfParse(){
      var src = (zfFEl.value || '').trim(); if(!src) return { err: 'Saisissez f(z).' };
      var tk = pwTokens(src); if(!tk) return { err: 'Expression invalide.' };
      var ast = null; try { ast = dxParse(tk); } catch(e){ ast = null; }
      if(!ast) return { err: 'Expression invalide.' };
      var cr; try { cr = zfCR(ast); } catch(e){ return { err: e.message === 'x' ? 'Utilisez z (et non x) : z = x + iy est posé automatiquement.' : 'Expression non prise en charge (z, i, nombres, + − × ÷, puissances entières, conj(z)).' }; }
      var rz = zfRZ(ast);
      return { src: src, ast: ast, cr: cr, rz: rz, usesConj: !rz };
    }
    function zfFTex(src){ try { return toLatex(src.split('conj(z)').join('cz')).split('cz').join(BS + 'overline{z}'); } catch(e){ return null; } }
    function updateZfPreview(){
      var r = zfParse();
      if(r.err){ zfPrevEl.className = 'ml-preview is-empty'; zfPrevEl.textContent = r.err; return; }
      var t = zfFTex(r.src);
      if(!t){ zfPrevEl.className = 'ml-preview is-empty'; zfPrevEl.textContent = 'Z = ' + r.src; return; }
      try { renderKatex(zfPrevEl, 'Z = f(z) = ' + t); zfPrevEl.className = 'ml-preview'; } catch(e){ zfPrevEl.className = 'ml-preview is-empty'; zfPrevEl.textContent = 'Z = ' + r.src; }
    }
    zfFEl.addEventListener('input', updateZfPreview);
    zfExEl.addEventListener('click', function(ev){ var b = ev.target.closest('[data-zfex]'); if(!b) return; zfFEl.value = b.getAttribute('data-zfex'); answerEl.innerHTML = ''; stepsEl.innerHTML = ''; stateEl.textContent = ''; updateZfPreview(); });

    // P + iQ as LaTeX: "x - 1 + iy", "2x + i(2y + 1)", "x^2 - y^2 + 1 + 2ixy"
    function zfCbt(u){
      var re = bpZero(u.P) ? '' : bpTex(u.P);
      if(bpZero(u.Q)) return re || '0';
      var im;
      if(bpTerms(u.Q) === 1){
        var t = bpSorted(u.Q)[0], neg = t.c.n < 0, ab = fr(Math.abs(t.c.n), t.c.d), m = bpMono(t.i, t.j);
        var ct = (ab.n === 1 && ab.d === 1) ? '' : fTex(ab);
        im = (neg ? '-' : '') + ct + 'i' + m;
      } else im = 'i' + BS + 'left(' + bpTex(u.Q) + BS + 'right)';
      if(!re) return im;
      return re + (im.charAt(0) === '-' ? ' - ' + im.slice(1) : ' + ' + im);
    }
    function zfSq(u){ // u² with brackets only when needed
      if(bpTerms(u) === 1){ var t = bpSorted(u)[0]; if(t.c.n === 1 && t.c.d === 1 && t.i + t.j === 1) return bpMono(t.i, t.j) + '^{2}'; }
      return BS + 'left(' + bpTex(u) + BS + 'right)^{2}';
    }
    // X = P/D, Y = Q/D (with the steps), and the poles
    function zfAlgebraic(parsed, R){
      var html = R.line('', 'z = x + iy,' + BS + 'quad Z = X + iY'), P, Q, D, poles = [], polesKnown = true;
      if(parsed.rz && czDeg(parsed.rz.d) > 0){
        var A = czToBP(parsed.rz.n), B = czToBP(parsed.rz.d);
        var cbt = zfCbt;
        html += R.line('', 'Z = ' + BS + 'dfrac{' + zfCzTex(parsed.rz.n) + '}{' + zfCzTex(parsed.rz.d) + '} = ' + BS + 'dfrac{' + cbt(A) + '}{' + cbt(B) + '}');
        P = bpAdd(bpMul(A.P, B.P), bpMul(A.Q, B.Q)); Q = bpSub(bpMul(A.Q, B.P), bpMul(A.P, B.Q)); D = bpAdd(bpMul(B.P, B.P), bpMul(B.Q, B.Q));
        var red = zfReduce(P, Q, D); P = red.P; Q = red.Q; D = red.D;
        html += '<div class="study-work">On multiplie le numérateur et le dénominateur par le conjugué du dénominateur :</div>';
        html += R.line('', 'Z = ' + BS + 'dfrac{' + BS + 'left(' + cbt(A) + BS + 'right)' + BS + 'left(' + zfCbt({ P: B.P, Q: bpScale(B.Q, fr(-1)) }) + BS + 'right)}{' + zfSq(B.P) + ' + ' + zfSq(B.Q) + '}');
        poles = czRoots(parsed.rz.d);
      } else {
        var cr = parsed.cr; P = cr.P; Q = cr.Q; D = cr.D;
        var red2 = zfReduce(P, Q, D); P = red2.P; Q = red2.Q; D = red2.D;
        if(bpDeg(D) > 0) polesKnown = false;
        if(parsed.rz) html += R.line('', 'Z = ' + zfCzTex(czMul(parsed.rz.n, [cfDiv(cf(fr(1)), parsed.rz.d[0])])) + BS + 'quad ' + BS + 'text{(on remplace z par } x + iy ' + BS + 'text{ et on développe)}');
        else html += '<div class="study-work">On remplace z par x + iy et z̄ par x − iy, puis on développe.</div>';
      }
      var constD = bpDeg(D) <= 0, dval = constD ? bpGet(D, 0, 0) : null;
      var Xt = constD ? bpTex(bpScale(P, fDiv(fr(1), dval))) : BS + 'dfrac{' + bpTex(P) + '}{' + bpTex(D) + '}';
      var Yt = constD ? bpTex(bpScale(Q, fDiv(fr(1), dval))) : BS + 'dfrac{' + bpTex(Q) + '}{' + bpTex(D) + '}';
      if(constD){ P = bpScale(P, fDiv(fr(1), dval)); Q = bpScale(Q, fDiv(fr(1), dval)); D = bpC(fr(1)); }
      html += R.line('Partie réelle :', 'X(x, y) = ' + Xt);
      html += R.line('Partie imaginaire :', 'Y(x, y) = ' + Yt);
      return { html: html, P: P, Q: Q, D: D, poles: poles, polesKnown: polesKnown, constD: constD };
    }
    function zfPolesLine(alg, R){
      if(!alg.poles.length) return alg.polesKnown ? '' : '<div class="study-work">On exclut les points où le dénominateur s’annule.</div>';
      return R.line('f est définie pour', alg.poles.map(function(p){ return 'z ' + BS + 'neq ' + zfRootTex(p); }).join(',' + BS + '; ') + BS + ';(' + BS + 'text{point' + (alg.poles.length > 1 ? 's' : '') + ' exclu' + (alg.poles.length > 1 ? 's' : '') + '})');
    }
    // describe the set {E = 0} minus the poles
    function zfSetHtml(E, alg, R, sm){
      var cl = zfClassify(E), html = '';
      html += R.line('', cl.factTex);
      if(cl.parts.length > 1) html += '<div class="study-work">Un produit est nul si et seulement si l’un des facteurs est nul.</div>';
      var descs = [];
      cl.parts.forEach(function(pt){
        if(pt.kind === 'circle'){ html += R.line('', pt.tex + BS + ';' + BS + 'Rightarrow' + BS + '; ' + BS + 'text{cercle de centre } ' + pt.cenTex + BS + 'text{ et de rayon } ' + pt.rTex); descs.push(pt.desc); }
        else if(pt.kind === 'point' || pt.kind === 'empty'){ if(pt.tex) html += R.line('', pt.tex); descs.push(pt.desc); }
        else if(pt.kind === 'line' && pt.tex){ if(!(cl.parts.length === 1 && cl.factTex === pt.tex)) html += R.line('', pt.tex); descs.push(pt.desc); }
        else descs.push(pt.desc);
      });
      // excluded points that lie on the set
      var excl = [];
      alg.poles.forEach(function(p){
        var on = (p.exact && p.z) ? fZero(bpEvalF(E, p.z.re, p.z.im)) : Math.abs(bpEvalN(E, p.x, p.y)) < 1e-9;
        if(on) excl.push(p);
      });
      var concl = 'L’ensemble des points M est ' + descs.join(' et ') + (excl.length ? ', privé' + (cl.parts.length > 1 ? '' : '') + ' du point d’affixe ' + excl.map(zfRootPlain).join(' et ') : '') + '.';
      html += '<div class="study-line study-ok">✓ ' + escapeHtml(concl) + '</div>';
      sm.push(concl);
      return { html: html, parts: cl.parts, excl: excl };
    }

    async function runZf(op){
      if(!ggb){ return; }
      var parsed = zfParse();
      if(parsed.err){ stateEl.textContent = parsed.err; return; }
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul…';
      setZfOpsEnabled(false);
      var computed = false;
      try {
        var R = e1Report(), body = '', sm = [], E = null, set = null, extraPts = [];
        var ft = zfFTex(parsed.src) || parsed.src;
        var alg = zfAlgebraic(parsed, R);
        body += R.sec('Forme algébrique X + iY', R.line('', 'Z = ' + ft) + alg.html + zfPolesLine(alg, R));
        sm.push('X=' + (alg.constD ? bpPlain(alg.P) : '(' + bpPlain(alg.P) + ')/(' + bpPlain(alg.D) + ')') + ' ; Y=' + (alg.constD ? bpPlain(alg.Q) : '(' + bpPlain(alg.Q) + ')/(' + bpPlain(alg.D) + ')'));
        if(alg.poles.length) sm.push('poles exclus: ' + alg.poles.map(zfRootPlain).join(', '));
        var title = 'Transformation Z = f(z)';

        if(op === 'real' || op === 'imag'){
          var isReal = op === 'real';
          E = isReal ? alg.Q : alg.P;
          var t = R.line('', BS + 'text{Z est ' + (isReal ? 'réel' : 'imaginaire pur') + '} ' + BS + 'iff ' + (isReal ? 'Y' : 'X') + '(x, y) = 0' + (alg.constD ? '' : BS + 'iff ' + bpTex(E) + ' = 0 ' + BS + 'text{ (avec } z ' + BS + 'neq ' + BS + 'text{ pôle)}'));
          set = zfSetHtml(E, alg, R, sm);
          body += R.sec('Ensemble des points M tels que Z soit ' + (isReal ? 'réel' : 'imaginaire pur'), t + set.html + (isReal ? '' : '<div class="study-work">(Z = 0 est compté comme imaginaire pur.)</div>'));
          title = isReal ? 'Z = f(z) — Z réel' : 'Z = f(z) — Z imaginaire pur';
        } else if(op === 'mod'){
          var kp = e1Parse(zfKEl.value);
          if(!kp || !pConst(kp) || kp[0].n < 0){ stateEl.textContent = 'Indiquez k ≥ 0.'; setZfOpsEnabled(true); return; }
          var K = kp[0], tm = '';
          if(parsed.rz){
            var Ab = czToBP(parsed.rz.n), Bb = czToBP(parsed.rz.d);
            var A2 = bpAdd(bpMul(Ab.P, Ab.P), bpMul(Ab.Q, Ab.Q)), B2 = bpAdd(bpMul(Bb.P, Bb.P), bpMul(Bb.Q, Bb.Q));
            E = bpSub(A2, bpScale(B2, fMul(K, K)));
            tm += R.line('', '|Z| = ' + fTex(K) + BS + 'iff ' + BS + 'left|' + zfCzTex(parsed.rz.n) + BS + 'right| = ' + (K.n === K.d ? '' : fTex(K)) + BS + 'left|' + zfCzTex(parsed.rz.d) + BS + 'right|' + BS + 'iff ' + BS + 'left|' + zfCzTex(parsed.rz.n) + BS + 'right|^{2} = ' + (K.n === K.d ? '' : fTex(fMul(K, K))) + BS + 'left|' + zfCzTex(parsed.rz.d) + BS + 'right|^{2}');
            if(czDeg(parsed.rz.n) === 1 && czDeg(parsed.rz.d) === 1){
              var a0 = czRoots(parsed.rz.n)[0], b0 = czRoots(parsed.rz.d)[0];
              var ratio2 = fDiv(fMul(fMul(K, K), cfAbs2(parsed.rz.d[1])), cfAbs2(parsed.rz.n[1]));
              var rr = fSqrt(ratio2);
              tm += R.line('Interprétation :', BS + 'text{avec } A(' + zfRootTex(a0) + ')' + BS + 'text{ et } B(' + zfRootTex(b0) + '),' + BS + '; ' + (fZero(fSub(ratio2, fr(1))) ? 'AM = BM' : 'AM = ' + (rr ? fTex(rr) : sqrtTex(ratio2)) + BS + ',BM'));
              if(fZero(fSub(ratio2, fr(1)))) tm += '<div class="study-work">AM = BM : M est équidistant de A et B, donc sur la médiatrice de [AB].</div>';
            }
          } else {
            E = bpSub(bpAdd(bpMul(alg.P, alg.P), bpMul(alg.Q, alg.Q)), bpScale(bpMul(alg.D, alg.D), fMul(K, K)));
            tm += R.line('', '|Z| = ' + fTex(K) + BS + 'iff X^{2} + Y^{2} = ' + fTex(fMul(K, K)));
          }
          tm += R.line('En développant :', bpTex(E) + ' = 0');
          set = zfSetHtml(E, alg, R, sm);
          body += R.sec('Ensemble des points M tels que |Z| = ' + escapeHtml(fPlain(K)), tm + set.html);
          title = 'Z = f(z) — |Z| = ' + fPlain(K);
        } else if(op === 'inv' || op === 'ante'){
          if(!parsed.rz){ stateEl.textContent = 'Non disponible quand f contient z̄ (conj).'; setZfOpsEnabled(true); return; }
          var target, lbl;
          if(op === 'inv'){ target = [cf(), cf(fr(1))]; lbl = 'z'; }
          else {
            var z0t = pwTokens(zfZ0El.value || ''), z0a = null; try { z0a = z0t && dxParse(z0t); } catch(e){ z0a = null; }
            var z0r = z0a && zfRZ(z0a);
            if(!z0r || czDeg(z0r.n) > 0 || czDeg(z0r.d) > 0){ stateEl.textContent = 'Indiquez une valeur numérique Z₀ (ex. i, 2, 1+i).'; setZfOpsEnabled(true); return; }
            var z0 = cfDiv(z0r.n[0], z0r.d[0]); target = [z0]; lbl = cfTex(z0);
          }
          // f(z) = target ⇔ N(z) − target·D(z) = 0, z not a pole
          var eqP = czSub(parsed.rz.n, czMul(target, parsed.rz.d));
          var ti = R.line('', 'f(z) = ' + lbl + BS + 'iff ' + (czDeg(parsed.rz.d) > 0 ? zfCzTex(parsed.rz.n) + ' = ' + (op === 'inv' ? 'z' : BS + 'left(' + lbl + BS + 'right)') + BS + 'left(' + zfCzTex(parsed.rz.d) + BS + 'right)' + BS + 'iff ' : '') + zfCzTex(eqP) + ' = 0');
          var roots = [];
          if(czDeg(eqP) < 0) ti += '<div class="study-line study-ok">Égalité vraie pour tout z (hors pôles).</div>';
          else if(czDeg(eqP) === 0) ti += '<div class="study-line study-ko">✗ Égalité impossible : aucune solution.</div>';
          else {
            roots = czRoots(eqP).filter(function(r){ return !alg.poles.some(function(p){ return Math.abs(p.x - r.x) < 1e-9 && Math.abs(p.y - r.y) < 1e-9; }); });
            if(!roots.length) ti += '<div class="study-line study-ko">✗ Les solutions trouvées sont des pôles : aucune solution.</div>';
            else ti += R.line(op === 'inv' ? 'Points invariants :' : 'Antécédent(s) :', roots.map(function(r, i){ var t = zfRootTex(r); return 'z_{' + (i + 1) + '} ' + (t.indexOf(BS + 'approx') === 0 ? t : '= ' + t); }).join(',' + BS + 'quad '));
          }
          sm.push((op === 'inv' ? 'points invariants: ' : 'antecedents de ' + cfPlain(target[0]) + ': ') + (roots.length ? roots.map(zfRootPlain).join(', ') : 'aucun'));
          roots.forEach(function(r){ extraPts.push(r); });
          body += R.sec(op === 'inv' ? 'Points invariants : f(z) = z' : 'Antécédent de Z₀ = ' + escapeHtml(cfPlain(target[0])), ti);
          title = op === 'inv' ? 'Z = f(z) — points invariants' : 'Z = f(z) — antécédent';
        }

        R.render(title, body);
        computed = true;
        zfPlot(E, alg.poles, extraPts, set);
        var defStr = 'Z = ' + parsed.src + (op === 'mod' ? ' ; |Z| = ' + zfKEl.value.trim() : op === 'ante' ? ' ; Z0 = ' + zfZ0El.value.trim() : '');
        stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ domain: 'complex', operation: 'zf_' + op, expression: defStr.slice(0, 390), casResult: sm.join(' | ').slice(0, 495) }) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); } else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){ stateEl.textContent = computed ? 'Connexion impossible — réessayez.' : 'Calcul impossible — vérifiez f(z).'; }
      finally { setZfOpsEnabled(true); }
    }
    zfOpsEl.addEventListener('click', function(ev){ var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return; runZf(btn.getAttribute('data-zfop')); });

    function zfPlot(E, poles, pts, set){
      clearZfPlot(); clearComplexPlot(); try { ggb.deleteObject('f'); } catch(e){}
      function add(nm, cmd){ try { ggb.evalCommand(nm + '=' + cmd); zfObjs.push(nm); return true; } catch(e){ return false; } }
      var xs = [0], ys = [0];
      if(E && !bpZero(E) && bpDeg(E) > 0){
        try { ggb.evalCommand('zfSet:' + bpGgb(E) + '=0'); ggb.setColor('zfSet', 94, 23, 235); ggb.setLineThickness('zfSet', 6); ggb.setLabelVisible('zfSet', false); zfObjs.push('zfSet'); } catch(e){}
        (set && set.parts || []).forEach(function(pt){
          if(pt.kind === 'circle'){ var r = Math.sqrt(fVal(pt.r2)); xs.push(fVal(pt.cx) - r, fVal(pt.cx) + r); ys.push(fVal(pt.cy) - r, fVal(pt.cy) + r);
            if(add('ZfC', '(' + fVal(pt.cx) + ',' + fVal(pt.cy) + ')')){ try { ggb.setColor('ZfC', 50, 44, 77); ggb.setPointSize('ZfC', 4); ggb.setCaption('ZfC', 'Ω'); ggb.setLabelStyle('ZfC', 3); ggb.setLabelVisible('ZfC', true); } catch(e){} } }
          if(pt.kind === 'point'){ xs.push(fVal(pt.cx)); ys.push(fVal(pt.cy)); if(add('ZfPt', '(' + fVal(pt.cx) + ',' + fVal(pt.cy) + ')')){ try { ggb.setColor('ZfPt', 94, 23, 235); ggb.setPointSize('ZfPt', 6); } catch(e){} } }
        });
      }
      (poles || []).forEach(function(p, i){
        var nm = 'ZfP' + (i + 1);
        if(add(nm, '(' + p.x + ',' + p.y + ')')){ try { ggb.setColor(nm, 220, 38, 38); ggb.setPointSize(nm, 5); ggb.setPointStyle(nm, 2); ggb.setCaption(nm, 'exclu'); ggb.setLabelStyle(nm, 3); ggb.setLabelVisible(nm, true); } catch(e){} }
        xs.push(p.x); ys.push(p.y);
      });
      (pts || []).forEach(function(p, i){
        var nm = 'ZfS' + (i + 1);
        if(add(nm, '(' + p.x + ',' + p.y + ')')){ try { ggb.setColor(nm, 255, 194, 58); ggb.setPointSize(nm, 7); ggb.setCaption(nm, 'z' + (i + 1)); ggb.setLabelStyle(nm, 3); ggb.setLabelVisible(nm, true); } catch(e){} }
        xs.push(p.x); ys.push(p.y);
      });
      var xmin = Math.min.apply(null, xs), xmax = Math.max.apply(null, xs), ymin = Math.min.apply(null, ys), ymax = Math.max.apply(null, ys);
      var pad = Math.max(2, 0.25 * Math.max(xmax - xmin, ymax - ymin));
      var host = document.getElementById('ggb'), W = (host && host.clientWidth) || 800, H = (host && host.clientHeight) || 480;
      var xr = (xmax - xmin) + 2 * pad, yr = (ymax - ymin) + 2 * pad, upp = Math.max(xr / W, yr / H), cx = (xmin + xmax) / 2, cy = (ymin + ymax) / 2;
      try { ggb.setCoordSystem(cx - upp * W / 2, cx + upp * W / 2, cy - upp * H / 2, cy + upp * H / 2); } catch(e){}
    }

    try { updateZfPreview(); } catch(e){}
    setZfOpsEnabled(false); // enabled once GeoGebra is ready (appletOnLoad)

    /* ============ INÉQUATIONS ============ */
    // « A ⋄ B » with ⋄ ∈ {<, ≤, >, ≥} → h(x) = A − B ⋄ 0. Rational h (polynomials / quotients): exact
    // factorisation (roots via exactRealRoots, multiplicities by synthetic division) and a sign table with one
    // row per factor. Otherwise (ln, exp, √…): numeric study — domain edges, zeros and poles found by sampling
    // + bisection and snapped to exact values (sysfSnap). Solution set = union of intervals (French notation).
    var modeIneq = document.getElementById('mode-ineq');
    var iqInput = document.getElementById('iq-in'), iqPrevEl = document.getElementById('iq-preview');
    var iqKeysEl = document.getElementById('iq-keys'), iqExEl = document.getElementById('iq-ex'), iqOpsEl = document.getElementById('iq-ops');
    var iqObjs = [];
    var IQ_EX = [
      ['1er degré', '3x - 5 > 2x + 1'], ['2nd degré', 'x^2 - 5x + 6 <= 0'], ['Produit', '(2x - 1)(x + 3) >= 0'],
      ['Quotient', '(x + 1)/(x - 2) < 0'], ['Quotient ≥ 1', '(x + 4)/(x - 1) >= 1'], ['Degré 3', 'x^3 - 4x > 0'],
      ['Logarithme', 'ln(x) < 1'], ['Exponentielle', 'exp(2x) - 3 > 0'], ['ln et domaine', 'ln(2x - 1) >= ln(x + 2)']
    ];
    var IQ_REL = { '<': { tex: '<', strict: true, sign: -1 }, '<=': { tex: BS + 'leq', strict: false, sign: -1 }, '>': { tex: '>', strict: true, sign: 1 }, '>=': { tex: BS + 'geq', strict: false, sign: 1 } };
    function clearIqPlot(){ iqObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} }); iqObjs = []; }
    function setIqOpsEnabled(on){ iqOpsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }

    (function(){
      var html = '<span class="pw-ex__lbl"><i class="bi bi-lightbulb"></i> Exemples :</span>';
      IQ_EX.forEach(function(e, i){ html += '<button type="button" class="ml-key is-util" data-iqex="' + i + '">' + escapeHtml(e[0]) + '</button>'; });
      iqExEl.innerHTML = html;
    })();
    iqExEl.addEventListener('click', function(ev){ var b = ev.target.closest('[data-iqex]'); if(!b) return; iqInput.value = IQ_EX[Number(b.getAttribute('data-iqex'))][1]; answerEl.innerHTML = ''; stepsEl.innerHTML = ''; stateEl.textContent = ''; updateIqPreview(); });
    iqInput.addEventListener('input', updateIqPreview);
    iqInput.addEventListener('keydown', function(ev){ if(ev.key === 'Enter'){ ev.preventDefault(); runIneq(); } });
    iqKeysEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-key'); if(!btn) return;
      var act = btn.getAttribute('data-act');
      if(act === 'clear'){ iqInput.value = ''; iqInput.focus(); }
      else if(act === 'back'){ var v = iqInput.value, s = iqInput.selectionStart, e = iqInput.selectionEnd; if(s == null){ iqInput.value = v.slice(0, -1); } else if(s !== e){ iqInput.value = v.slice(0, s) + v.slice(e); iqInput.setSelectionRange(s, s); } else if(s > 0){ iqInput.value = v.slice(0, s - 1) + v.slice(s); iqInput.setSelectionRange(s - 1, s - 1); } iqInput.focus(); }
      else insertInto(iqInput, btn.getAttribute('data-ins'));
      updateIqPreview();
    });

    // Parse « A rel B » → { L, R, rel } or { err }
    function iqRead(){
      var raw = (iqInput.value || '').trim().split(String.fromCharCode(8804)).join('<=').split(String.fromCharCode(8805)).join('>=');
      if(!raw) return { err: 'Écrivez une inéquation, par ex. x^2 - 5x + 6 <= 0.' };
      var found = [], i = 0;
      while(i < raw.length){ var c = raw.charAt(i); if(c === '<' || c === '>'){ var op = c + (raw.charAt(i + 1) === '=' ? '=' : ''); found.push({ at: i, op: op }); i += op.length; } else i++; }
      if(found.length !== 1) return { err: found.length ? 'Une seule inégalité à la fois (<, ≤, >, ≥).' : 'Il manque le symbole d’inégalité (<, ≤, >, ≥).' };
      if(raw.indexOf('=') >= 0 && raw.split('=').length - 1 !== (found[0].op.length === 2 ? 1 : 0)) return { err: 'Utilisez <, ≤, > ou ≥ (pas de « = » seul).' };
      var A = raw.slice(0, found[0].at), B = raw.slice(found[0].at + found[0].op.length);
      function side(s){ var tk = pwTokens(s); if(!tk || !tk.length) return null; var a = null; try { a = dxParse(tk); } catch(e){ a = null; } return a; }
      var L = side(A), R = side(B);
      if(!L || !R) return { err: 'Expression invalide — vérifiez les parenthèses (ex. (x+1)/(x-2) < 0, ln(x) < 1).' };
      var bad = [];
      [L, R].forEach(function walk(n){ if(!n) return; if(n.t === 'const' && bad.indexOf(n.name) < 0) bad.push(n.name); if(n.t === 'fn' && SYSF_FN.indexOf(n.name) < 0) bad.push(n.name + '()'); ['a', 'l', 'r'].forEach(function(k){ if(n[k] && typeof n[k] === 'object') walk(n[k]); }); });
      if(bad.length) return { err: '« ' + bad.join(', ') + ' » inconnu : l’inconnue est x (fonctions : ln, exp, sqrt…).' };
      return { L: L, R: R, rel: found[0].op };
    }
    function iqSideTex(n){ try { return toLatex(sysfPrint(n)); } catch(e){ return sysfPrint(n); } }
    function updateIqPreview(){
      var r = iqRead();
      if(r.err){ iqPrevEl.className = 'ml-preview is-empty'; iqPrevEl.textContent = (iqInput.value || '').trim() ? r.err : 'Aperçu de l’inéquation…'; return; }
      try { renderKatex(iqPrevEl, iqSideTex(r.L) + ' ' + IQ_REL[r.rel].tex + ' ' + iqSideTex(r.R)); iqPrevEl.className = 'ml-preview'; }
      catch(e){ iqPrevEl.className = 'ml-preview is-empty'; iqPrevEl.textContent = 'Aperçu indisponible.'; }
    }

    // ---- rational functions N/D with fraction-coefficient polynomials ----
    function iqRat(n){
      if(!n) return null;
      switch(n.t){
        case 'num': { var f = fFromNum(n.v); return f ? { N: [f], D: [fr(1)] } : null; }
        case 'var': return { N: [fr(0), fr(1)], D: [fr(1)] };
        case 'neg': { var a = iqRat(n.a); return a ? { N: pScale(a.N, fr(-1)), D: a.D } : null; }
        case '+': case '-': { var l = iqRat(n.l), r = iqRat(n.r); if(!l || !r) return null; var t1 = pMul(l.N, r.D), t2 = pMul(r.N, l.D); return { N: n.t === '+' ? pAdd(t1, t2) : pSub(t1, t2), D: pMul(l.D, r.D) }; }
        case '*': { var l2 = iqRat(n.l), r2 = iqRat(n.r); return (l2 && r2) ? { N: pMul(l2.N, r2.N), D: pMul(l2.D, r2.D) } : null; }
        case '/': { var l3 = iqRat(n.l), r3 = iqRat(n.r); if(!l3 || !r3 || pDeg(r3.N) < 0) return null; return { N: pMul(l3.N, r3.D), D: pMul(l3.D, r3.N) }; }
        case '^': { var b = iqRat(n.l), e = iqRat(n.r); if(!b || !e || !pConst(e.N) || !pConst(e.D)) return null; var ev = fVal(e.N[0]) / fVal(e.D[0]); if(ev < 0 || ev > 8 || ev !== Math.floor(ev)) return null; var res = { N: [fr(1)], D: [fr(1)] }; for(var i = 0; i < ev; i++) res = { N: pMul(res.N, b.N), D: pMul(res.D, b.D) }; return res; }
      }
      return null;
    }
    // P = c · Π (q x − p)^k · R  (rational roots pulled out; R has no rational root)
    function iqFactor(P){
      P = pTrim(P); var lin = [], R = P, scale = fr(1);
      var guard = 0;
      while(pDeg(R) >= 1 && guard++ < 20){
        var roots = exactRealRoots(R).filter(function(r){ return r.f; });
        if(!roots.length) break;
        var r = roots[0].f, k = 0;
        while(pDeg(R) >= 1){ var dv = synthDivF(R, r); if(!fZero(dv.rem)) break; R = dv.q; k++; }
        lin.push({ r: r, k: k }); scale = fMul(scale, fr(Math.pow(r.d, k)));
      }
      R = pScale(R, fDiv(fr(1), scale)); // P = Π (q x − p)^k · R
      var c = fr(1);
      if(pDeg(R) === 0){ c = R[0]; R = null; }
      else if(pDeg(R) > 0){ var lead = R[pDeg(R)]; if(lead.n < 0){ c = fr(-1); R = pScale(R, fr(-1)); } }
      return { c: c, lin: lin, R: R };
    }
    function iqLinTex(r){ var q = r.d, p = r.n; if(p === 0) return q === 1 ? 'x' : q + 'x'; return (q === 1 ? 'x' : q + 'x') + (p > 0 ? ' - ' + p : ' + ' + (-p)); }
    function iqFacTex(F){ // product as LaTeX, without the constant
      var parts = [];
      F.lin.forEach(function(L){ var t = iqLinTex(L.r), atom = (L.r.n === 0); var b = atom ? t : BS + 'left(' + t + BS + 'right)'; parts.push(b + (L.k > 1 ? '^{' + L.k + '}' : '')); });
      if(F.R) parts.push(BS + 'left(' + pTex(F.R, 'x') + BS + 'right)');
      return parts.join('');
    }
    function iqFacPlain(F){ var parts = F.lin.map(function(L){ return '(' + iqLinTex(L.r) + ')' + (L.k > 1 ? '^' + L.k : ''); }); if(F.R) parts.push('(' + pPlain(F.R, 'x') + ')'); return parts.join('*') || '1'; }
    function iqCritFromFactor(F){ // exact critical points of a factored polynomial
      var pts = F.lin.map(function(L){ return rootRat(L.r); });
      if(F.R) exactRealRoots(F.R).forEach(function(r){ pts.push(r); });
      return pts;
    }

    // ---- numeric study (non-rational) ----
    function iqNumeric(h){
      var A = -60, B = 60, N = 12000, step = (B - A) / N, xs = [], ys = [];
      for(var i = 0; i <= N; i++){ var x = A + i * step; xs.push(x); ys.push(h(x)); }
      var crit = [];
      function bis(a, b, test){ for(var k = 0; k < 80; k++){ var m = (a + b) / 2; if(test(m)) b = m; else a = m; } return (a + b) / 2; }
      for(var j = 0; j < N; j++){
        var y0 = ys[j], y1 = ys[j + 1], f0 = isFinite(y0), f1 = isFinite(y1);
        if(f0 !== f1){ // domain edge
          var e = f0 ? bis(xs[j], xs[j + 1], function(m){ return !isFinite(h(m)); }) : bis(xs[j], xs[j + 1], function(m){ return isFinite(h(m)); });
          crit.push({ num: e, kind: 'edge' });
        } else if(f0 && f1){
          if(y0 === 0 && (j === 0 || ys[j - 1] !== 0)) crit.push({ num: xs[j], kind: 'zero' });
          else if(y0 * y1 < 0){
            if(Math.abs(y0) > 1e4 && Math.abs(y1) > 1e4) crit.push({ num: bis(xs[j], xs[j + 1], function(m){ return h(m) * y0 < 0; }), kind: 'pole' });
            else crit.push({ num: bis(xs[j], xs[j + 1], function(m){ var v = h(m); return !isFinite(v) || v * y0 <= 0; }), kind: 'zero' });
          }
        }
      }
      var out = [];
      crit.forEach(function(c){
        var s = sysfSnap(c.num), v = c.num;
        if(s.exact){ try { var vv = pwEval(itCompile(s.plain.split(' ').join('')), 0, {}); if(isFinite(vv) && Math.abs(vv - v) < 1e-6 * (1 + Math.abs(v))) v = vv; } catch(e){} }
        if(out.length && Math.abs(out[out.length - 1].num - v) < 1e-7) return;
        out.push({ num: v, tex: s.tex.split(BS + 'approx ').join(''), approx: !s.exact, plain: s.plain, kind: c.kind });
      });
      return out;
    }

    // Build solution pieces and the union of intervals
    function iqSolve(h, crit, rel){
      var R = IQ_REL[rel], pts = crit.slice().sort(function(a, b){ return a.num - b.num; });
      function ok(v){ if(!isFinite(v)) return false; if(Math.abs(v) < 1e-10) return !R.strict; return R.sign > 0 ? v > 0 : v < 0; }
      var items = [];
      for(var i = 0; i <= pts.length; i++){
        var lo = i ? pts[i - 1].num : -Infinity, hi = i < pts.length ? pts[i].num : Infinity;
        var t = (lo === -Infinity && hi === Infinity) ? 0 : lo === -Infinity ? hi - 1 : hi === Infinity ? lo + 1 : (lo + hi) / 2;
        var v = h(t);
        items.push({ type: 'int', lo: i ? pts[i - 1] : null, hi: i < pts.length ? pts[i] : null, val: v, defined: isFinite(v), ok: isFinite(v) && (R.sign > 0 ? v > 0 : v < 0) });
        if(i < pts.length){ var pv = h(pts[i].num); if(pts[i].kind === 'zero') pv = 0; if(pts[i].kind === 'pole') pv = NaN; items.push({ type: 'pt', p: pts[i], val: pv, defined: isFinite(pv), ok: ok(pv) }); }
      }
      var runs = [], cur = null;
      items.forEach(function(it){ if(it.ok){ if(!cur){ cur = { first: it, last: it }; runs.push(cur); } else cur.last = it; } else cur = null; });
      var tex = runs.map(function(r){
        if(r.first === r.last && r.first.type === 'pt') return BS + '{' + r.first.p.tex + BS + '}';
        var left = r.first.type === 'pt' ? BS + 'left[' + r.first.p.tex : (r.first.lo ? BS + 'left]' + r.first.lo.tex : BS + 'left]-' + BS + 'infty');
        var right = r.last.type === 'pt' ? r.last.p.tex + BS + 'right]' : (r.last.hi ? r.last.hi.tex + BS + 'right[' : '+' + BS + 'infty' + BS + 'right[');
        return left + ' ;' + BS + ', ' + right;
      });
      var plain = runs.map(function(r){
        if(r.first === r.last && r.first.type === 'pt') return '{' + r.first.p.plain + '}';
        var left = r.first.type === 'pt' ? '[' + r.first.p.plain : (r.first.lo ? ']' + r.first.lo.plain : ']-inf');
        var right = r.last.type === 'pt' ? r.last.p.plain + ']' : (r.last.hi ? r.last.hi.plain + '[' : '+inf[');
        return left + ' ; ' + right;
      });
      var segs = runs.map(function(r){ return { a: r.first.type === 'pt' ? r.first.p.num : (r.first.lo ? r.first.lo.num : -Infinity), b: r.last.type === 'pt' ? r.last.p.num : (r.last.hi ? r.last.hi.num : Infinity), point: r.first === r.last && r.first.type === 'pt' }; });
      return { pts: pts, items: items, tex: tex.length ? tex.join(' ' + BS + 'cup ') : BS + 'varnothing', plain: plain.length ? plain.join(' U ') : 'ensemble vide', all: runs.length === 1 && runs[0].first.type === 'int' && !runs[0].first.lo && !runs[0].last.hi, segs: segs };
    }

    // Sign table: optional factor rows + the h(x) row (zeros 0, poles ||, outside the domain hatched)
    function iqTable(sol, rows, hLabel){
      var pts = sol.pts, head = '<tr><th>x</th><td><span data-tex="-' + BS + 'infty"></span></td>';
      pts.forEach(function(p){ head += '<td></td><td><span data-tex="' + escapeHtml(p.tex) + '"></span></td>'; });
      head += '<td></td><td><span data-tex="+' + BS + 'infty"></span></td></tr>';
      function cell(sv){ return sv > 1e-12 ? '<td class="e1-pos">+</td>' : sv < -1e-12 ? '<td class="e1-neg">−</td>' : '<td class="e1-zero">0</td>'; }
      var body = '';
      rows.forEach(function(r){
        var tr = '<tr><th><span data-tex="' + escapeHtml(r.tex) + '"></span></th><td></td>';
        sol.items.forEach(function(it){
          if(it.type === 'int'){ var lo = it.lo ? it.lo.num : -Infinity, hi = it.hi ? it.hi.num : Infinity, t = (lo === -Infinity && hi === Infinity) ? 0 : lo === -Infinity ? hi - 1 : hi === Infinity ? lo + 1 : (lo + hi) / 2; tr += cell(r.f(t)); }
          else tr += r.zeros.some(function(z){ return Math.abs(z - it.p.num) < 1e-9; }) ? '<td class="e1-zero">0</td>' : '<td></td>';
        });
        body += tr + '<td></td></tr>';
      });
      var hr = '<tr class="iq-hrow"><th><span data-tex="' + escapeHtml(hLabel) + '"></span></th><td></td>';
      sol.items.forEach(function(it){
        if(it.type === 'int') hr += it.defined ? cell(it.val) : '<td class="e1-bar" title="hors du domaine"></td>';
        else hr += it.p.kind === 'pole' || !it.defined ? '<td class="iq-bar">||</td>' : (Math.abs(it.val) < 1e-10 ? '<td class="e1-zero">0</td>' : '<td></td>');
      });
      hr += '<td></td></tr>';
      return '<div class="e1-wrap"><table class="e1-table">' + head + body + hr + '</table></div>';
    }

    function iqHasFn(n, names){ if(!n) return false; if(n.t === 'fn' && names.indexOf(n.name) >= 0 && sysfHasVar(n.a)) return true; if(n.t === '^' && n.l.t === 'num' && Math.abs(n.l.v - Math.E) < 1e-12 && names.indexOf('exp') >= 0 && sysfHasVar(n.r)) return true; return ['a', 'l', 'r'].some(function(k){ return n[k] && typeof n[k] === 'object' && iqHasFn(n[k], names); }); }
    var IQ_METHODS = {
      deg1: 'Inéquation du premier degré : on regroupe les termes en x d’un côté, puis on divise par le coefficient de x — en changeant le sens de l’inégalité s’il est négatif.',
      deg2: 'Signe du trinôme ax² + bx + c : on calcule Δ et les racines ; le trinôme est du signe de a à l’extérieur des racines et du signe contraire entre elles.',
      product: 'On ramène tout à « … comparé à 0 », on factorise, puis on étudie le signe de chaque facteur dans un tableau de signes.',
      quotient: 'On ramène tout à « … comparé à 0 » sur un seul dénominateur, on cherche les valeurs interdites (dénominateur nul), puis on fait un tableau de signes (double barre aux valeurs interdites).',
      ln: 'Conditions d’existence (argument du ln strictement positif), puis on utilise la stricte croissance de ln (ln a < ln b ⇔ a < b) ou de exp (ln x < k ⇔ x < eᵏ), et on intersecte avec le domaine.',
      exp: 'On isole l’exponentielle, puis on utilise la stricte croissance de ln (eᵘ > k ⇔ u > ln k pour k > 0 ; si k ≤ 0, eᵘ > k est toujours vrai).',
      sqrt: 'Conditions d’existence (expression sous la racine ≥ 0), puis on étudie le signe en distinguant les cas avant d’élever au carré (les deux membres doivent être positifs).',
      generic: 'On ramène tout à « h(x) comparé à 0 », on cherche le domaine, les zéros de h, puis on étudie le signe de h sur chaque intervalle.'
    };

    async function runIneq(){
      var rd = iqRead();
      if(rd.err){ stateEl.textContent = rd.err; return; }
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      setIqOpsEnabled(false);
      stateEl.innerHTML = '<span class="ml-spinner"></span> Résolution…';
      await new Promise(function(res){ setTimeout(res, 20); });
      var hAst = { t: '-', l: rd.L, r: rd.R }, rel = IQ_REL[rd.rel];
      var h = function(x){ return pwEval(hAst, x, {}); };
      var Rp = e1Report(), body = '', methodId = 'generic', crit = [], rows = [], hLabel = 'h(x)', sum = [];
      var origTex = iqSideTex(rd.L) + ' ' + rel.tex + ' ' + iqSideTex(rd.R);
