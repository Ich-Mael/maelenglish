        var k0 = oqTokKind(strip(toks[i]).core);
        if(k0 === 'text' || (k0 === 'op' && i === 0)){ out.push(toks[i]); i++; continue; }
        // grow a run of math-ish tokens; inside parentheses, commas belong to the formula
        var j = i, strong = false, punct = '', depth = 0;
        while(j < toks.length){
