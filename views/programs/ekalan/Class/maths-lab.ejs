    });
    var answerEl = document.getElementById('answer');
    var stepsEl = document.getElementById('steps');
    var stateEl = document.getElementById('state');

    function setOpsEnabled(on){ opsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }
    function renderKatex(el, latex){
      var s = String(latex == null ? '' : latex).trim();
      // The model sometimes wraps LaTeX in code fences or $…$ / \(…\) / \[…\]
      // delimiters — strip them so KaTeX gets a clean expression instead of showing raw.
      // (Backtick built from a char code: literal backticks would end this EJS literal.)
      var BT3 = String.fromCharCode(96) + String.fromCharCode(96) + String.fromCharCode(96);
      s = s.split(BT3 + 'math').join('').split(BT3 + 'latex').join('').split(BT3).join('').trim();
      if(s.indexOf(BS + '(') === 0) s = s.slice(2);
      else if(s.indexOf(BS + '[') === 0) s = s.slice(2);
      var _tail = s.slice(-2);
      if(_tail === BS + ')' || _tail === BS + ']') s = s.slice(0, -2);
      s = s.trim();
      while(s.length > 1 && s.charAt(0) === '$'){ s = s.slice(1); }
      while(s.length > 1 && s.charAt(s.length - 1) === '$'){ s = s.slice(0, -1); }
