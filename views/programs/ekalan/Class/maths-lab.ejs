            <label for="ar-b" style="margin-left:.6rem">b =</label><input id="ar-b" type="text" value="36" autocomplete="off" style="flex:0 0 auto; min-width:0; max-width:110px" />
            <label for="ar-n" style="margin-left:.6rem">n =</label><input id="ar-n" type="text" value="7" autocomplete="off" style="flex:0 0 auto; min-width:0; max-width:90px" />
          </div>
