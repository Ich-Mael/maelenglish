      if(!cIsZero(q.q1)) parts.push(termStr(q.q1, 'z'));
      if(!cIsZero(q.q2) || parts.length === 0) parts.push(termStr(q.q2, ''));
      return joinPoly(parts);
    }
    // Render an equation result (number, polynomial, or {set}) as LaTeX for KaTeX.
    function eqResultLatex(s){
      s = String(s == null ? '' : s).trim();
      if(s.charAt(0) === '{' && s.charAt(s.length - 1) === '}'){
        var items = splitTopLevel(s).map(function(it){ try { return toLatex(it); } catch(e){ return it; } });
        return BS + '{ ' + items.join(', ') + ' ' + BS + '}';
      }
      try { return toLatex(s); } catch(e){ return s; }
    }
    function setEqAnswer(label, value){
      answerEl.innerHTML = '<div class="ml-answer"><div class="lbl"><i class="bi bi-stars"></i> ' + label + '</div><div class="val" id="eq-final"></div></div>';
      renderKatex(document.getElementById('eq-final'), eqResultLatex(value));
    }

    async function runEqStep(op){
      var poly = buildEquation();
      var z0 = (eqz0Input.value || '').trim();
      var needsZ0 = (op === 'eval_at' || op === 'quotient' || op === 'solve_quotient');
      if(!ggb){ return; }
      if(needsZ0 && !z0){ stateEl.textContent = 'Indiquez z₀ (ou utilisez « Racine réelle / imaginaire pure »).'; eqz0Input.focus(); return; }

      function reenable(){ setEqStepsEnabled(true); eqSolveBtn.disabled = false; setCOpsEnabled(true); }
      setEqStepsEnabled(false); eqSolveBtn.disabled = true; setCOpsEnabled(false);
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul en cours…';

      var casResult = '', label = 'Résultat', plotAll = false, eqRoots = null, eqNote = '';
      try {
        if(op === 'eval_at'){
          // Remainder theorem: f(z₀) is exactly the remainder of f(z)/(z−z₀). Pure JS.
          var fv = syntheticDiv(z0).rem;
          casResult = fmtComplexVal(fv.re, fv.im);
          label = 'f(z₀)';
        } else if(op === 'find_root'){
          var fr = findSpecialRoot(poly);
          if(!fr){ stateEl.textContent = 'Aucune racine réelle ou imaginaire pure évidente pour cette équation.'; reenable(); return; }
          eqz0Input.value = fr.value; z0 = fr.value; casResult = fr.value; label = 'Racine évidente z₀'; plotAll = true;
          var frv = evalComplex('(' + fr.value + ')'); if(frv) eqRoots = [frv];
        } else if(op === 'quotient'){
          // Synthetic division in JS (CAS Div is unreliable with the imaginary unit).
          var qd0 = syntheticDiv(z0);
          casResult = fmtQuotient(qd0);
          label = 'Q(z)';
          if(!cIsZero(qd0.rem)){ eqNote = 'Remarque : le reste de la division vaut ' + fmtComplexVal(qd0.rem.re, qd0.rem.im) + ' (non nul) — z₀ ne semble pas être une racine de f.'; }
        } else if(op === 'solve_quotient'){
          var qd = syntheticDiv(z0);
          eqRoots = solveQuad(qd.q0, qd.q1, qd.q2); // numeric, for plotting
          var exact = exactQuadRoots(qd.q0, qd.q1, qd.q2); // exact with √, if integer coeffs
          var rootStrs = exact || eqRoots.map(function(r){ return fmtComplexVal(r.re, r.im); });
          casResult = rootStrs.length ? ('{' + rootStrs.join(', ') + '}') : '';
          label = 'Solutions de Q(z) = 0'; plotAll = true;
        }
      } catch(e){ casResult = ''; }
      casResult = ggbToText(casResult).trim();
      if(!casResult || casResult === '{}' || casResult === '?'){ stateEl.textContent = 'Calcul impossible — vérifiez les coefficients et z₀.'; reenable(); return; }

      if(plotAll){
        clearComplexPlot(); try { ggb.deleteObject('f'); } catch(e){}
        if(eqRoots && eqRoots.length){
          eqRoots.forEach(function(r, idx){ var nm = 'rqt' + (idx + 1); defObj(nm, '(' + r.re + ',' + r.im + ')'); colour(nm, 255, 184, 0); });
        }
      }

      setEqAnswer(label, casResult);
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';

      var payload = { domain:'complex', operation: op, expression: poly, casResult: casResult };
      if(op === 'eval_at' || op === 'quotient' || op === 'solve_quotient'){ payload.z0 = z0; }

      try {
        var resp = await fetch(EXPLAIN_URL, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify(payload)
        });
        var data = await resp.json();
        if(data.ok){ showSteps(data); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){
        stateEl.textContent = 'Connexion impossible — réessayez.';
      } finally {
        // Authoritative computed answer always wins (model may abbreviate the solution set).
        setEqAnswer(label, casResult);
        if(eqNote) stateEl.textContent = eqNote;
        reenable();
      }
    }
    eqStepsEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return;
      runEqStep(btn.getAttribute('data-eqop'));
    });

    /* ============ GÉOMÉTRIE (points, triangles, quadrilatères) ============ */
    var modeGeo   = document.getElementById('mode-geometry');
    var geoListEl = document.getElementById('geo-points');
    var geoAddBtn = document.getElementById('geo-add');
    var gkeysEl   = document.getElementById('gkeys');
    var gopsEl    = document.getElementById('gops');
    var gPreviewEl= document.getElementById('gPreview');
    var geoObjs   = [];
    var activeGeo = null;
    var GEO_LETTERS = ['A','B','C','D','E','F'];
    var GEO_MIN = 3, GEO_MAX = 6;

    function setGOpsEnabled(on){ gopsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }
    function geoInputs(){ return Array.prototype.slice.call(geoListEl.querySelectorAll('input')); }
    function geoRows(){ return Array.prototype.slice.call(geoListEl.querySelectorAll('.geo-row')); }
    function geoData(){
      return geoInputs().map(function(inp, i){ return { name: GEO_LETTERS[i], affix: (inp.value || '').trim() }; })
                        .filter(function(p){ return p.affix; });
    }
    function renumberGeo(){
      var rows = geoRows();
      rows.forEach(function(row, i){
        var name = GEO_LETTERS[i];
        row.setAttribute('data-name', name);
        var lab = row.querySelector('.geo-label'); if(lab) lab.innerHTML = 'z<sub>' + name + '</sub> =';
        var del = row.querySelector('.geo-del'); if(del) del.style.visibility = (rows.length > GEO_MIN) ? 'visible' : 'hidden';
      });
      geoAddBtn.disabled = rows.length >= GEO_MAX;
    }
    function attachGeoInput(inp){
      inp.addEventListener('focus', function(){ activeGeo = inp; });
      inp.addEventListener('input', updateGeoPreview);
    }
    geoInputs().forEach(attachGeoInput);
    geoRows().forEach(function(row){
      var del = row.querySelector('.geo-del');
      if(del) del.addEventListener('click', function(){
        if(geoRows().length > GEO_MIN){ row.remove(); renumberGeo(); updateGeoPreview(); }
      });
    });
    geoAddBtn.addEventListener('click', function(){
      if(geoRows().length >= GEO_MAX) return;
      var row = document.createElement('div'); row.className = 'geo-row';
      var lab = document.createElement('label'); lab.className = 'geo-label';
      var inp = document.createElement('input'); inp.type = 'text'; inp.placeholder = 'ex : 1+2i'; inp.autocomplete = 'off';
      var del = document.createElement('button'); del.type = 'button'; del.className = 'geo-del'; del.title = 'Retirer'; del.textContent = '×';
      del.addEventListener('click', function(){ if(geoRows().length > GEO_MIN){ row.remove(); renumberGeo(); updateGeoPreview(); } });
      row.appendChild(lab); row.appendChild(inp); row.appendChild(del);
      geoListEl.appendChild(row);
      attachGeoInput(inp); renumberGeo(); inp.focus();
    });

    gkeysEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-key'); if(!btn) return;
      var inp = activeGeo || geoInputs()[0]; if(!inp) return;
      var act = btn.getAttribute('data-cact');
      if(act === 'clear'){ inp.value = ''; inp.focus(); }
      else if(act === 'back'){
        var v = inp.value, s = inp.selectionStart, e = inp.selectionEnd;
        if(s == null){ inp.value = v.slice(0,-1); }
        else if(s !== e){ inp.value = v.slice(0,s) + v.slice(e); inp.setSelectionRange(s,s); }
        else if(s > 0){ inp.value = v.slice(0,s-1) + v.slice(s); inp.setSelectionRange(s-1,s-1); }
        inp.focus();
      }
      else { insertInto(inp, btn.getAttribute('data-cins')); }
      updateGeoPreview();
    });

    function updateGeoPreview(){
      var inputs = geoInputs();
      var inp = (activeGeo && inputs.indexOf(activeGeo) >= 0) ? activeGeo : inputs[0];
      var idx = inputs.indexOf(inp); var name = GEO_LETTERS[idx >= 0 ? idx : 0];
      var raw = inp ? (inp.value || '').trim() : '';
      if(!raw){ gPreviewEl.className = 'ml-preview is-empty'; gPreviewEl.textContent = 'Aperçu des affixes…'; return; }
      var latex = null; try { latex = toLatex(raw); } catch(e){ latex = null; }
      if(latex == null){ gPreviewEl.className = 'ml-preview is-empty'; gPreviewEl.textContent = '…en cours de saisie'; return; }
      try { katex.render('z_' + name + ' = ' + latex, gPreviewEl, { throwOnError:true, displayMode:false }); gPreviewEl.className = 'ml-preview'; }
      catch(e){ gPreviewEl.className = 'ml-preview is-empty'; gPreviewEl.textContent = '…en cours de saisie'; }
    }

    function clearGeoPlot(){ geoObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} }); geoObjs = []; }
    function defGeo(name, cmd){ try { ggb.evalCommand(name + '=' + cmd); geoObjs.push(name); } catch(e){} }
    function fitGeo(names){
      var xs = [0], ys = [0];
      names.forEach(function(nm){ try { var x = ggb.getXcoord(nm), y = ggb.getYcoord(nm); if(isFinite(x) && isFinite(y)){ xs.push(x); ys.push(y); } } catch(e){} });
      var minX = Math.min.apply(null, xs), maxX = Math.max.apply(null, xs);
      var minY = Math.min.apply(null, ys), maxY = Math.max.apply(null, ys);
      var padX = Math.max(2, (maxX - minX) * 0.25), padY = Math.max(2, (maxY - minY) * 0.25);
      try { ggb.setCoordSystem(minX - padX, maxX + padX, minY - padY, maxY + padY); } catch(e){}
    }

    // Plot the points as real GeoGebra Points (so Polygon works) + the polygon. Returns {coords, ok}.
    function plotGeo(points){
      if(!ggb) return { coords:[], ok:false };
      clearGeoPlot(); try { ggb.deleteObject('f'); } catch(e){}
      var coords = [], names = [], ok = true;
      points.forEach(function(pt){
        var tmp = 'zz_' + pt.name, x = NaN, y = NaN;
        try { ggb.evalCommand(tmp + '=(' + pt.affix + ')'); x = ggb.getXcoord(tmp); y = ggb.getYcoord(tmp); } catch(e){}
        try { ggb.deleteObject(tmp); } catch(e){}
        coords.push({ name: pt.name, x: x, y: y });
        if(isFinite(x) && isFinite(y)){
          defGeo(pt.name, '(' + x + ',' + y + ')'); colour(pt.name, 93, 6, 186);
          try { ggb.setLabelVisible(pt.name, true); } catch(e){}
          names.push(pt.name);
        } else { ok = false; }
      });
      if(names.length >= 3){ defGeo('poly1', 'Polygon(' + names.join(',') + ')'); colour('poly1', 168, 85, 247); }
      else if(names.length === 2){ defGeo('seg1', 'Segment(' + names[0] + ',' + names[1] + ')'); colour('seg1', 168, 85, 247); }
      fitGeo(names);
      return { coords: coords, ok: ok };
    }

    function approxEq(a, b){ return Math.abs(a - b) <= 1e-7 * Math.max(1, Math.abs(a), Math.abs(b)); }
    function rnd(v){ return String(Math.round(v * 1000) / 1000); }
    function dist(u, v){ return Math.hypot(u.x - v.x, u.y - v.y); }
    function rightAngleAt(V, U, W){ // angle U-V-W ; V is the vertex
      var v1x = U.x - V.x, v1y = U.y - V.y, v2x = W.x - V.x, v2y = W.y - V.y;
      var dot = v1x * v2x + v1y * v2y, m = Math.hypot(v1x, v1y) * Math.hypot(v2x, v2y);
      return m > 0 && Math.abs(dot) <= 1e-7 * m;
    }
    function parallelSeg(p1, p2, q1, q2){
      var ux = p2.x - p1.x, uy = p2.y - p1.y, vx = q2.x - q1.x, vy = q2.y - q1.y;
      var cross = ux * vy - uy * vx, m = Math.hypot(ux, uy) * Math.hypot(vx, vy);
      return m > 0 && Math.abs(cross) <= 1e-7 * m;
    }

    function classifyTriangle(P){
      var A = P[0], B = P[1], C = P[2];
      var AB = dist(A,B), BC = dist(B,C), CA = dist(C,A);
      var lengths = { AB:AB, BC:BC, CA:CA };
      var area = Math.abs((B.x-A.x)*(C.y-A.y) - (C.x-A.x)*(B.y-A.y)) / 2;
      if(area <= 1e-9 * Math.max(1, AB*BC)) return { nature:"Points alignés — ce n'est pas un triangle", lengths:lengths };
      var equilateral = approxEq(AB,BC) && approxEq(BC,CA) && approxEq(CA,AB);
      var rA = rightAngleAt(A,B,C), rB = rightAngleAt(B,A,C), rC = rightAngleAt(C,A,B);
      var right = rA || rB || rC, rightVertex = rA ? 'A' : rB ? 'B' : rC ? 'C' : null;
      var apex = approxEq(CA,AB) ? 'A' : approxEq(AB,BC) ? 'B' : approxEq(BC,CA) ? 'C' : null;
      var iso = !!apex;
      var nature;
      if(equilateral) nature = 'Triangle équilatéral';
      else if(right && iso) nature = 'Triangle rectangle isocèle' + (rightVertex ? (' en ' + rightVertex) : '');
      else if(right) nature = 'Triangle rectangle' + (rightVertex ? (' en ' + rightVertex) : '');
      else if(iso) nature = 'Triangle isocèle' + (apex ? (' en ' + apex) : '');
      else nature = 'Triangle quelconque';
      return { nature: nature, lengths: lengths };
    }

    function classifyQuad(P){
      var A = P[0], B = P[1], C = P[2], D = P[3];
      var AB = dist(A,B), BC = dist(B,C), CD = dist(C,D), DA = dist(D,A), AC = dist(A,C), BD = dist(B,D);
      var lengths = { AB:AB, BC:BC, CD:CD, DA:DA, AC:AC, BD:BD };
      var mAC = { x:(A.x+C.x)/2, y:(A.y+C.y)/2 }, mBD = { x:(B.x+D.x)/2, y:(B.y+D.y)/2 };
      var isParallelogram = approxEq(mAC.x, mBD.x) && approxEq(mAC.y, mBD.y);
      var nature;
      if(isParallelogram){
        var equalSides = approxEq(AB, BC);
        var equalDiag  = approxEq(AC, BD);
        var rightAngle = rightAngleAt(B, A, C);
        if(equalSides && (equalDiag || rightAngle)) nature = 'Carré';
        else if(equalDiag || rightAngle) nature = 'Rectangle';
        else if(equalSides) nature = 'Losange';
        else nature = 'Parallélogramme';
      } else {
        var abCD = parallelSeg(A,B,D,C), bcDA = parallelSeg(B,C,A,D);
        if(abCD || bcDA){
          var isoLegs = abCD ? approxEq(BC, DA) : approxEq(AB, CD);
          var hasRight = rightAngleAt(A,B,C) || rightAngleAt(B,C,D) || rightAngleAt(C,D,A) || rightAngleAt(D,A,B);
          nature = 'Trapèze' + (hasRight ? ' rectangle' : (isoLegs ? ' isocèle' : ''));
        } else nature = 'Quadrilatère quelconque';
      }
      return { nature: nature, lengths: lengths };
    }

    function buildGeoResult(op, res){
      var L = res.lengths;
      if(op === 'triangle_nature'){
        return res.nature + ' — longueurs : AB ≈ ' + rnd(L.AB) + ', BC ≈ ' + rnd(L.BC) + ', CA ≈ ' + rnd(L.CA) + '.';
      }
      return res.nature + ' — côtés : AB ≈ ' + rnd(L.AB) + ', BC ≈ ' + rnd(L.BC) + ', CD ≈ ' + rnd(L.CD) + ', DA ≈ ' + rnd(L.DA) +
             ' ; diagonales : AC ≈ ' + rnd(L.AC) + ', BD ≈ ' + rnd(L.BD) + '.';
    }

    async function runGeo(op){
      var pts = geoData();
      if(op === 'plot'){
        if(pts.length < 1){ stateEl.textContent = 'Saisissez au moins un point.'; return; }
        var r0 = plotGeo(pts);
        answerEl.innerHTML = ''; stepsEl.innerHTML = '';
        stateEl.textContent = r0.ok ? ('Figure tracée (' + pts.length + ' point' + (pts.length > 1 ? 's' : '') + ').')
                                    : "Certains affixes sont invalides — vérifiez l'écriture (ex : 1+2i).";
        return;
      }
      var need = (op === 'triangle_nature') ? 3 : 4;
      var label = (need === 3) ? 'triangle' : 'quadrilatère';
      if(pts.length !== need){ stateEl.textContent = 'Renseignez exactement ' + need + ' points pour un ' + label + '.'; return; }
      if(!ggb){ return; }

      var r = plotGeo(pts);
      if(!r.ok){ stateEl.textContent = "Impossible de lire les affixes — vérifiez l'écriture (ex : 1+2i)."; return; }
      var res = (need === 3) ? classifyTriangle(r.coords) : classifyQuad(r.coords);
      var casResult = buildGeoResult(op, res);

      answerEl.innerHTML = '<div class="ml-answer"><div class="lbl"><i class="bi bi-stars"></i> Résultat</div><div class="val">' + escapeHtml(res.nature) + '</div></div>';
      stepsEl.innerHTML = ''; stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';
      setGOpsEnabled(false);

      var expression = pts.map(function(p){ return 'z_' + p.name + ' = ' + p.affix; }).join(' ; ');
      try {
        var resp = await fetch(EXPLAIN_URL, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ domain:'complex', operation: op, expression: expression, casResult: casResult })
        });
        var data = await resp.json();
        if(data.ok){ showSteps(data); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){
        stateEl.textContent = 'Connexion impossible — réessayez.';
      } finally {
        setGOpsEnabled(true);
      }
    }

