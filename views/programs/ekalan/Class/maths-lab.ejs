    // Wrap the maths found in a sentence into $…$ (text already containing $…$ is kept as is)
    function oqMathify(text){
      text = String(text == null ? '' : text);
      if(text.indexOf('$') >= 0) return text;
      text = text.split(String.fromCharCode(0x2212)).join('-').split(String.fromCharCode(0xD7)).join('*');
