    }
    // Pure-JS complex arithmetic — used for synthetic division & the quadratic formula,
    // because evalCommandCAS (Div/Simplify) is unreliable with the imaginary unit.
    function cAdd(p, q){ return { re: p.re + q.re, im: p.im + q.im }; }
    function cSub(p, q){ return { re: p.re - q.re, im: p.im - q.im }; }
    function cMul(p, q){ return { re: p.re * q.re - p.im * q.im, im: p.re * q.im + p.im * q.re }; }
    function cDiv(p, q){ var d = q.re * q.re + q.im * q.im; return { re: (p.re * q.re + p.im * q.im) / d, im: (p.im * q.re - p.re * q.im) / d }; }
    function cSqrt(w){ var m = Math.hypot(w.re, w.im); var re = Math.sqrt(Math.max(0, (m + w.re) / 2)); var im = Math.sqrt(Math.max(0, (m - w.re) / 2)); if(w.im < 0) im = -im; return { re: re, im: im }; }
    function cIsZero(c){ return Math.abs(c.re) < 1e-9 && Math.abs(c.im) < 1e-9; }
    // Parse simple complex inputs (a, bi, a+bi, -1-2i, 0.5i…) without GeoGebra. Returns {re,im} or null.
    function parseComplex(s){
      s = String(s == null ? '' : s).trim();
      if(s === '') return { re: 0, im: 0 };
      s = s.split(' ').join('').split('*').join('').split(String.fromCharCode(0x2212)).join('-');
      if(s.charAt(0) !== '+' && s.charAt(0) !== '-') s = '+' + s;
      var re = 0, im = 0, i = 0;
      while(i < s.length){
        var ch = s.charAt(i), sign;
        if(ch === '+'){ sign = 1; i++; } else if(ch === '-'){ sign = -1; i++; } else return null;
        var j = i; while(j < s.length && s.charAt(j) !== '+' && s.charAt(j) !== '-') j++;
        var term = s.slice(i, j); i = j;
        if(term === '') return null;
        if(term === 'i'){ im += sign; }
        else if(term.charAt(term.length - 1) === 'i'){
          var ns = term.slice(0, -1), num = (ns === '') ? 1 : Number(ns);
          if(!isFinite(num)) return null; im += sign * num;
        } else { var n2 = Number(term); if(!isFinite(n2)) return null; re += sign * n2; }
      }
      return { re: re, im: im };
    }
    function coefVal(s){ var p = parseComplex(s); if(p) return p; var v = evalComplex('(' + (((s || '').trim()) || '0') + ')'); return v || { re: 0, im: 0 }; }
    function fmtReal(x){ var r = Math.round(x * 1e6) / 1e6; if(Math.abs(r - Math.round(r)) < 1e-9) r = Math.round(r); return String(r); }
    function fmtImag(y){
      var r = Math.round(y * 1e6) / 1e6; if(Math.abs(r - Math.round(r)) < 1e-9) r = Math.round(r);
      if(r === 1) return 'i'; if(r === -1) return '-i'; return r + 'i';
    }
    // Split a GeoGebra list string "{a, b, c}" into top-level parts (respecting parens).
    function splitTopLevel(s){
      s = String(s).trim();
      if(s.charAt(0) === '{') s = s.slice(1);
      if(s.charAt(s.length - 1) === '}') s = s.slice(0, -1);
      var parts = [], depth = 0, cur = '';
      for(var i = 0; i < s.length; i++){
        var ch = s.charAt(i);
        if(ch === '(' || ch === '{' || ch === '[') depth++;
        else if(ch === ')' || ch === '}' || ch === ']') depth--;
        if(ch === ',' && depth === 0){ parts.push(cur); cur = ''; }
        else cur += ch;
      }
      if(cur.trim() !== '') parts.push(cur);
      return parts.map(function(p){ return p.trim(); }).filter(function(p){ return p !== ''; });
    }
    function stripZeq(r){ var eq = r.indexOf('='); if(eq >= 0 && r.slice(0, eq).trim().toLowerCase() === 'z') return r.slice(eq + 1).trim(); return r; }
    // Scan the roots for a REAL (im≈0) or PURE-IMAGINARY (re≈0) one. Returns {value} or null.
    // Uses CSolutions for the list, then the reliable graphics view to read each root.
    function findSpecialRoot(poly){
      var raw = '';
      try { raw = ggbToText(ggb.evalCommandCAS('CSolutions(' + poly + ' = 0, z)')); } catch(e){ raw = ''; }
      if(!raw || raw === '{}') return null;
      var roots = splitTopLevel(raw), res = null;
      for(var k = 0; k < roots.length && !res; k++){
        var v = evalComplex(stripZeq(roots[k]));
        if(v){
          if(Math.abs(v.im) < 1e-6) res = { value: fmtReal(v.re) };
          else if(Math.abs(v.re) < 1e-6) res = { value: fmtImag(v.im) };
        }
      }
      return res;
    }

    // Synthetic (Horner) division of f(z)=a z³+b z²+c z+d by (z − z₀).
    // Returns the quotient coefficients {q0,q1,q2} (Q = q0 z² + q1 z + q2) and remainder.
    function syntheticDiv(z0str){
      var a = coefVal(eqaInput.value), b = coefVal(eqbInput.value), c = coefVal(eqcInput.value), d = coefVal(eqdInput.value);
      var z = coefVal(z0str);
      var q0 = a;
      var q1 = cAdd(b, cMul(q0, z));
      var q2 = cAdd(c, cMul(q1, z));
      var rem = cAdd(d, cMul(q2, z));
      return { q0: q0, q1: q1, q2: q2, rem: rem };
    }
    function solveQuad(q0, q1, q2){
      if(cIsZero(q0)){ // degree 1: q1 z + q2 = 0
        if(cIsZero(q1)) return [];
        return [cDiv({ re: -q2.re, im: -q2.im }, q1)];
      }
      var disc = cSub(cMul(q1, q1), cMul({ re: 4, im: 0 }, cMul(q0, q2)));
      var sq = cSqrt(disc), twoA = cMul({ re: 2, im: 0 }, q0);
      var negB = { re: -q1.re, im: -q1.im };
      return [cDiv(cAdd(negB, sq), twoA), cDiv(cSub(negB, sq), twoA)];
    }
    // Exact roots of a quadratic with INTEGER real coefficients — keeps the √ symbol.
    // Returns an array of plain expression strings (toLatex-renderable) or null.
    function igcd(x, y){ x = Math.abs(Math.round(x)); y = Math.abs(Math.round(y)); while(y){ var t = y; y = x % y; x = t; } return x; }
    function simplifyRadical(n){ var coef = 1, rad = n; for(var k = 2; k * k <= rad; k++){ while(rad % (k * k) === 0){ rad = rad / (k * k); coef = coef * k; } } return { coef: coef, rad: rad }; }
    function plainFrac(num, den){ var g = igcd(num, den) || 1; num = num / g; den = den / g; if(den < 0){ num = -num; den = -den; } return (den === 1) ? String(num) : (num + '/' + den); }
    function radRoot(nb, sgn, coef, rad, den, unit){ // (nb ± coef·unit·√rad)/den  (unit = '' real or 'i' complex)
      var g = igcd(igcd(Math.abs(nb), coef), den) || 1;
      var n2 = nb / g, c2 = coef / g, d2 = den / g;
      var r="";
      if(rad > 1) r = (c2 !== 1 ? (c2 + ' ') : '') + (unit ? unit + ' ' : '') + 'sqrt(' + rad + ')';
      else r = (c2 !== 1 ? (c2 + (unit ? ' ' : '')) : '') + (unit || (c2 === 1 ? '1' : ''));
      var num = (n2 === 0) ? ((sgn < 0 ? '-' : '') + r) : (n2 + (sgn < 0 ? ' - ' : ' + ') + r);
      return (d2 === 1) ? num : ('(' + num + ')/' + d2);
    }
    function exactQuadRoots(q0, q1, q2){
      function ni(x){ return Math.abs(x - Math.round(x)) < 1e-7; }
      if(Math.abs(q0.im) > 1e-7 || Math.abs(q1.im) > 1e-7 || Math.abs(q2.im) > 1e-7) return null;
      if(!ni(q0.re) || !ni(q1.re) || !ni(q2.re)) return null;
      var a = Math.round(q0.re), b = Math.round(q1.re), c = Math.round(q2.re);
      if(a === 0) return null;
      var D = b * b - 4 * a * c, den = 2 * a, nb = -b;
      if(den < 0){ den = -den; nb = -nb; }
      if(D === 0) return [ plainFrac(nb, den) ];
      if(D > 0){
        var sr = simplifyRadical(D);
        if(sr.rad === 1) return [ plainFrac(nb + sr.coef, den), plainFrac(nb - sr.coef, den) ];
        return [ radRoot(nb, 1, sr.coef, sr.rad, den, ''), radRoot(nb, -1, sr.coef, sr.rad, den, '') ];
      }
      var sr2 = simplifyRadical(-D);
      return [ radRoot(nb, 1, sr2.coef, sr2.rad, den, 'i'), radRoot(nb, -1, sr2.coef, sr2.rad, den, 'i') ];
    }
    function termStr(c, v){
      var cv = fmtComplexVal(c.re, c.im);
      if(v === '') return cv;
      if(cv === '1') return v;
      if(cv === '-1') return '-' + v;
      return (cv.indexOf(' ') >= 0 ? '(' + cv + ') ' : cv + ' ') + v;
    }
    function joinPoly(parts){
      if(parts.length === 0) return '0';
      var out = parts[0];
