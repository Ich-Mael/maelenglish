      var rows = vcPtsEl.querySelectorAll('.vc-row');
      for(var r = 0; r < rows.length; r++){
        var name = vcPointList(rows[r].querySelector('.vc-name').value)[0], type = rows[r].querySelector('.vc-type').value, param = rows[r].querySelector('.vc-param').value.trim();
