          FORMULAS[key].forEach(function(group){
            var h = document.createElement('div'); h.className = 'ml-form-sec'; h.textContent = group.t; grid.appendChild(h);
            var cards = document.createElement('div'); cards.className = 'ml-form-cards'; grid.appendChild(cards);
            group.f.forEach(function(item){ var c = document.createElement('div'); c.className = 'ml-form-card'; cards.appendChild(c); try { renderKatex(c, fxL(item)); } catch(e){ c.textContent = item; } });
