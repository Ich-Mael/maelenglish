          }
          summary.push(sm);
        });
        var ttl = op === 'cont' ? 'Continuité' : op === 'deriv' ? 'Dérivabilité' : 'Continuité & dérivabilité';
        body = sec('Fonction', head) + body + sec(ttl + ' aux points de raccordement', inner);
      }

      answerEl.innerHTML = '<div class="ml-study" style="padding:.9rem 1.1rem"><div class="study-head"><i class="bi bi-distribute-horizontal"></i> Fonction définie par intervalles</div>' + body + '</div>';
      kq.forEach(function(it){ var el = document.getElementById(it.id); if(el){ try { renderKatex(el, it.latex); } catch(e){} } });

