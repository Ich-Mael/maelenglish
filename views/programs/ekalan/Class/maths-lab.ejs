        var p = -1; for(var r = row; r < M.length; r++) if(!fZero(M[r][c])){ p = r; break; }
        if(p < 0) continue;
        var t = M[row]; M[row] = M[p]; M[p] = t;
        var inv = fDiv(fr(1), M[row][c]); M[row] = M[row].map(function(x){ return fMul(x, inv); });
