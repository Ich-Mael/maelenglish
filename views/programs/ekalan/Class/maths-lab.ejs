            pl.push(vcTermsPlain(L) + ' = ' + vcTermsPlain(Rr) + ' : ' + (ok ? 'VRAI' : 'FAUX') + ' (gauche = ' + vcBasisPlain(F, cL) + ' ; droite = ' + vcBasisPlain(F, cR) + ')');
