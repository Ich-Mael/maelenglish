      try { renderKatex(document.getElementById('suite-def'), suiteType === 'explicit' ? ('u_n = ' + toLatex((suiteUn.value || '').trim())) : ('u_{n+1} = ' + toLatex((suiteFu.value || '').trim()).split('u').join('u_n'))); } catch(e){}
      kq.forEach(function(it){ var el = document.getElementById(it.id); if(el){ try { renderKatex(el, it.latex); } catch(e){} } });

      if(op !== 'study'){ stateEl.textContent = ''; setSuiteOpsEnabled(true); return; }

      // ---- Claude explanation for the full study ----
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';
