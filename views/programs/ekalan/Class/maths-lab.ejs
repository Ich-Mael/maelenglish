    setIType('indef');

    /* ============ CERCLE TRIGONOMÉTRIQUE ============ */
    var modeTrig = document.getElementById('mode-trig');
    var tcSvg = document.getElementById('trig-svg');
    var TC_CX = 170, TC_CY = 170, TC_R = 130;
    var tcEls = {};
    ['tc-vproj','tc-hproj','tc-cos','tc-sin','tc-tan','tc-tanconn','tc-radius','tc-point','tc-tanpoint','tc-angle','tc-cosv','tc-sinv','tc-tanv'].forEach(function(id){ tcEls[id] = document.getElementById(id); });
    var tcDeg = 45;
    // Angle measured in ]-π, π]  (i.e. ]-180°, 180°]).
    function norm180(d){ d = ((d % 360) + 360) % 360; if(d > 180) d -= 360; return d; }
    var NICE_DEG = [0,30,45,60,90,120,135,150,180,-30,-45,-60,-90,-120,-135,-150];
    var RAD_LATEX = {
      0:'0', 30:BS+'frac{'+BS+'pi}{6}', 45:BS+'frac{'+BS+'pi}{4}', 60:BS+'frac{'+BS+'pi}{3}', 90:BS+'frac{'+BS+'pi}{2}',
      120:BS+'frac{2'+BS+'pi}{3}', 135:BS+'frac{3'+BS+'pi}{4}', 150:BS+'frac{5'+BS+'pi}{6}', 180:BS+'pi',
      '-30':'-'+BS+'frac{'+BS+'pi}{6}', '-45':'-'+BS+'frac{'+BS+'pi}{4}', '-60':'-'+BS+'frac{'+BS+'pi}{3}', '-90':'-'+BS+'frac{'+BS+'pi}{2}',
      '-120':'-'+BS+'frac{2'+BS+'pi}{3}', '-135':'-'+BS+'frac{3'+BS+'pi}{4}', '-150':'-'+BS+'frac{5'+BS+'pi}{6}'
    };
    function tcExact(x){
      var s3 = Math.sqrt(3), h = Math.SQRT1_2;
      var t = [[0,'0'],[1,'1'],[-1,'-1'],[0.5,BS+'frac{1}{2}'],[-0.5,'-'+BS+'frac{1}{2}'],
        [h,BS+'frac{'+BS+'sqrt{2}}{2}'],[-h,'-'+BS+'frac{'+BS+'sqrt{2}}{2}'],
        [s3/2,BS+'frac{'+BS+'sqrt{3}}{2}'],[-s3/2,'-'+BS+'frac{'+BS+'sqrt{3}}{2}'],
        [s3/3,BS+'frac{'+BS+'sqrt{3}}{3}'],[-s3/3,'-'+BS+'frac{'+BS+'sqrt{3}}{3}'],
        [s3,BS+'sqrt{3}'],[-s3,'-'+BS+'sqrt{3}']];
      for(var i=0;i<t.length;i++){ if(Math.abs(x - t[i][0]) < 1e-9) return t[i][1]; }
      return null;
    }
    function snapNice(deg){
      deg = norm180(deg);
      for(var i=0;i<NICE_DEG.length;i++){ var d = NICE_DEG[i], diff = Math.abs(deg - d); diff = Math.min(diff, 360 - diff); if(diff <= 4) return d; }
      return null;
    }
    function tcLine(el, x1, y1, x2, y2){ el.setAttribute('x1', x1); el.setAttribute('y1', y1); el.setAttribute('x2', x2); el.setAttribute('y2', y2); }
    function tcDot(el, x, y){ el.setAttribute('cx', x); el.setAttribute('cy', y); }
    function tcShow(el, on){ el.setAttribute('opacity', on ? '1' : '0'); }

    function tcRender(deg){
      var snap = snapNice(deg);
      var useDeg = (snap != null) ? snap : norm180(deg);
      var th = useDeg * Math.PI / 180, c = Math.cos(th), s = Math.sin(th);
      var px = TC_CX + TC_R * c, py = TC_CY - TC_R * s;
      tcLine(tcEls['tc-radius'], TC_CX, TC_CY, px, py);
      tcDot(tcEls['tc-point'], px, py);
      tcLine(tcEls['tc-cos'], TC_CX, TC_CY, px, TC_CY);
      tcLine(tcEls['tc-sin'], TC_CX, TC_CY, TC_CX, py);
      tcLine(tcEls['tc-vproj'], px, py, px, TC_CY);
      tcLine(tcEls['tc-hproj'], px, py, TC_CX, py);
      var tanVal = (Math.abs(c) < 1e-9) ? null : s / c;
      if(tanVal == null){ tcShow(tcEls['tc-tan'], false); tcShow(tcEls['tc-tanconn'], false); tcShow(tcEls['tc-tanpoint'], false); }
      else {
        var clampY = Math.max(34, Math.min(306, TC_CY - TC_R * tanVal));
        tcShow(tcEls['tc-tan'], true); tcShow(tcEls['tc-tanconn'], true); tcShow(tcEls['tc-tanpoint'], true);
        tcLine(tcEls['tc-tan'], TC_CX + TC_R, TC_CY, TC_CX + TC_R, clampY);
        tcLine(tcEls['tc-tanconn'], TC_CX, TC_CY, TC_CX + TC_R, clampY);
        tcDot(tcEls['tc-tanpoint'], TC_CX + TC_R, clampY);
      }
      if(snap != null){
        renderKatex(tcEls['tc-angle'], BS + 'theta = ' + (RAD_LATEX[snap] || '0') + BS + ';(' + snap + '^' + BS + 'circ)');
        renderKatex(tcEls['tc-cosv'], tcExact(c) || c.toFixed(3));
        renderKatex(tcEls['tc-sinv'], tcExact(s) || s.toFixed(3));
        if(tanVal == null) tcEls['tc-tanv'].textContent = 'non défini';
        else renderKatex(tcEls['tc-tanv'], tcExact(tanVal) || tanVal.toFixed(3));
      } else {
        tcEls['tc-angle'].textContent = useDeg.toFixed(1) + '°  (' + (useDeg * Math.PI / 180).toFixed(2) + ' rad)';
        tcEls['tc-cosv'].textContent = c.toFixed(3);
        tcEls['tc-sinv'].textContent = s.toFixed(3);
        tcEls['tc-tanv'].textContent = (tanVal == null) ? 'non défini' : tanVal.toFixed(3);
      }
    }
    function tcAngleFromEvent(ev){
      var rect = tcSvg.getBoundingClientRect();
      if(!rect.width) return tcDeg;
      var sx = (ev.clientX - rect.left) / rect.width * 340, sy = (ev.clientY - rect.top) / rect.height * 340;
      return Math.atan2(-(sy - TC_CY), sx - TC_CX) * 180 / Math.PI;
    }
    tcSvg.addEventListener('pointermove', function(ev){ tcDeg = tcAngleFromEvent(ev); tcRender(tcDeg); });
    tcSvg.addEventListener('pointerdown', function(ev){ tcDeg = tcAngleFromEvent(ev); tcRender(tcDeg); });

    // Interleaved cos/sin so the 2-column grid puts cos (blue) left, sin (red) right.
    var TC_FORMULAS = [
      { k:'gen', t: BS+'cos^2'+BS+'theta + '+BS+'sin^2'+BS+'theta = 1' },
      { k:'gen', t: BS+'tan'+BS+'theta = '+BS+'frac{'+BS+'sin'+BS+'theta}{'+BS+'cos'+BS+'theta}' },
      { k:'cos', t: BS+'cos(-'+BS+'theta) = '+BS+'cos'+BS+'theta' },
      { k:'sin', t: BS+'sin(-'+BS+'theta) = -'+BS+'sin'+BS+'theta' },
      { k:'cos', t: BS+'cos('+BS+'pi - '+BS+'theta) = -'+BS+'cos'+BS+'theta' },
      { k:'sin', t: BS+'sin('+BS+'pi - '+BS+'theta) = '+BS+'sin'+BS+'theta' },
      { k:'cos', t: BS+'cos('+BS+'tfrac{'+BS+'pi}{2} - '+BS+'theta) = '+BS+'sin'+BS+'theta' },
      { k:'sin', t: BS+'sin('+BS+'tfrac{'+BS+'pi}{2} - '+BS+'theta) = '+BS+'cos'+BS+'theta' },
      { k:'cos', t: BS+'cos('+BS+'tfrac{'+BS+'pi}{2} + '+BS+'theta) = -'+BS+'sin'+BS+'theta' },
      { k:'sin', t: BS+'sin('+BS+'tfrac{'+BS+'pi}{2} + '+BS+'theta) = '+BS+'cos'+BS+'theta' },
      { k:'cos', t: BS+'cos(a+b) = '+BS+'cos a'+BS+'cos b - '+BS+'sin a'+BS+'sin b' },
      { k:'sin', t: BS+'sin(a+b) = '+BS+'sin a'+BS+'cos b + '+BS+'cos a'+BS+'sin b' },
      { k:'cos', t: BS+'cos(a-b) = '+BS+'cos a'+BS+'cos b + '+BS+'sin a'+BS+'sin b' },
      { k:'sin', t: BS+'sin(a-b) = '+BS+'sin a'+BS+'cos b - '+BS+'cos a'+BS+'sin b' },
      { k:'cos', t: BS+'cos(2a) = 2'+BS+'cos^2 a - 1' },
      { k:'sin', t: BS+'sin(2a) = 2'+BS+'sin a'+BS+'cos a' }
    ];
    // Produit → Somme (cos·cos / sin·sin → cos ; sin·cos → sin)
    var TC_PROD2SUM = [
      { k:'cos', t: BS+'cos a'+BS+'cos b = '+BS+'tfrac{1}{2}'+BS+'big['+BS+'cos(a-b) + '+BS+'cos(a+b)'+BS+'big]' },
      { k:'sin', t: BS+'sin a'+BS+'sin b = '+BS+'tfrac{1}{2}'+BS+'big['+BS+'cos(a-b) - '+BS+'cos(a+b)'+BS+'big]' },
      { k:'cos', t: BS+'sin a'+BS+'cos b = '+BS+'tfrac{1}{2}'+BS+'big['+BS+'sin(a+b) + '+BS+'sin(a-b)'+BS+'big]' },
      { k:'sin', t: BS+'cos a'+BS+'sin b = '+BS+'tfrac{1}{2}'+BS+'big['+BS+'sin(a+b) - '+BS+'sin(a-b)'+BS+'big]' }
    ];
    // Somme → Produit
    var TC_SUM2PROD = [
      { k:'cos', t: BS+'cos p + '+BS+'cos q = 2'+BS+'cos'+BS+'tfrac{p+q}{2}'+BS+'cos'+BS+'tfrac{p-q}{2}' },
      { k:'sin', t: BS+'sin p + '+BS+'sin q = 2'+BS+'sin'+BS+'tfrac{p+q}{2}'+BS+'cos'+BS+'tfrac{p-q}{2}' },
      { k:'cos', t: BS+'cos p - '+BS+'cos q = -2'+BS+'sin'+BS+'tfrac{p+q}{2}'+BS+'sin'+BS+'tfrac{p-q}{2}' },
      { k:'sin', t: BS+'sin p - '+BS+'sin q = 2'+BS+'cos'+BS+'tfrac{p+q}{2}'+BS+'sin'+BS+'tfrac{p-q}{2}' }
