      else if(act === 'back'){
        var v = inp.value, s = inp.selectionStart, e = inp.selectionEnd;
        if(s == null){ inp.value = v.slice(0,-1); }
        else if(s !== e){ inp.value = v.slice(0,s) + v.slice(e); inp.setSelectionRange(s,s); }
        else if(s > 0){ inp.value = v.slice(0,s-1) + v.slice(s); inp.setSelectionRange(s-1,s-1); }
        inp.focus();
      } else { insertInto(inp, btn.getAttribute('data-ins')); }
      updateTrigPreview();
    });

    async function runTrigOp(){
      var op = (trigOp === 'equation') ? 'trig_equation' : (trigOp === 'linearize') ? 'trig_linearize' : 'trig_duplicate';
      var body = { domain:'trig', operation: op };
      if(trigOp === 'equation'){
        var eq = (trigEq.value || '').trim();
        if(!eq){ stateEl.textContent = 'Saisissez une équation.'; return; }
        body.expression = eq; body.interval = (trigInt.value || '').trim();
      } else {
        var ex = (trigExpr.value || '').trim();
        if(!ex){ stateEl.textContent = 'Saisissez une expression.'; return; }
        body.expression = ex;
      }
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul en cours…';
      trigRun.disabled = true;
      try {
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
        var data = await resp.json();
        if(data.ok){ showSteps(data); }
        else { stateEl.textContent = data.error || 'Indisponible pour le moment.'; }
      } catch(e){ stateEl.textContent = 'Connexion impossible — réessayez.'; }
      finally { trigRun.disabled = false; }
    }
    trigRun.addEventListener('click', runTrigOp);
    setTrigOp('equation');

    /* ============ SUITES NUMÉRIQUES ============ */
    var modeSuite     = document.getElementById('mode-suite');
    var suiteTypeEl   = document.getElementById('suite-type');
    var suiteUn       = document.getElementById('suite-un');
    var suiteFu       = document.getElementById('suite-fu');
    var suiteU0       = document.getElementById('suite-u0');
    var suiteNEl      = document.getElementById('suite-n');
    var suiteExpF     = document.getElementById('suite-exp-fields');
    var suiteRecF     = document.getElementById('suite-rec-fields');
    var suitePrevEl   = document.getElementById('suite-preview');
    var suiteKeysEl   = document.getElementById('suite-keys');
    var suiteOpsEl    = document.getElementById('suite-ops');
