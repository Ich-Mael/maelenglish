            <label for="z1" id="z1-label">z =</label>
            <input id="z1" type="text" value="3+4i" placeholder="ex : 3+4i" autocomplete="off" />
          </div>
          <div class="ml-input-row" id="z2-row" hidden>
            <label for="z2">z₂ =</label>
            <input id="z2" type="text" value="1-2i" placeholder="ex : 1-2i" autocomplete="off" />
          </div>
          <div class="ml-input-row" id="n-row" hidden>
            <label for="cn">n =</label>
            <input id="cn" type="number" value="3" min="2" max="12" step="1" style="flex:0 0 auto; min-width:0; max-width:120px" />
          </div>

          <div class="ml-preview is-empty" id="zPreview">Aperçu du nombre complexe…</div>

          <div class="ml-keys" id="ckeys">
            <button type="button" class="ml-key" data-cins="i">i</button>
            <button type="button" class="ml-key" data-cins="+">+</button>
            <button type="button" class="ml-key" data-cins="-">−</button>
            <button type="button" class="ml-key" data-cins="*">×</button>
            <button type="button" class="ml-key" data-cins="/">÷</button>
