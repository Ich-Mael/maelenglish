        var t = '', valTex, valPlain;
        if(prim){
          var Ft2 = itTex(prim), Fast = itCompile(itStr(prim));
          var aF = fFromNum(av), bF = fFromNum(bv), polyF = null;
          var pX = astToPolyX(fAst);
          if(pX && aF && bF){ // exact for polynomials with rational bounds
            var Pp = [fr(0)]; for(var j = 0; j <= pDeg(pX); j++) Pp[j + 1] = fDiv(pX[j], fr(j + 1));
            var Fb = pEvalF(Pp, bF), Fa = pEvalF(Pp, aF), I = fSub(Fb, Fa);
            valTex = fTex(I); valPlain = fPlain(I);
            t += R.line('Primitive :', 'F(x) = ' + Ft2);
            t += R.line('', BS + 'int_{' + aTex + '}^{' + bTex + '} ' + BS + 'left(' + fTexStr + BS + 'right)' + BS + ',dx = ' + BS + 'Big[F(x)' + BS + 'Big]_{' + aTex + '}^{' + bTex + '} = F' + BS + 'left(' + bTex + BS + 'right) - F' + BS + 'left(' + aTex + BS + 'right)');
            t += R.line('', '= ' + fTex(Fb) + ' - ' + fPar(Fa) + ' = ' + valTex);
          } else {
            var Fbn = pwEval(Fast, bv, {}), Fan = pwEval(Fast, av, {}), In = Fbn - Fan;
            if(!isFinite(In)) In = num;
            var sn = pwSnap(In); valTex = sn.tex; valPlain = sn.plain;
            t += R.line('Primitive :', 'F(x) = ' + Ft2);
            t += R.line('', BS + 'int_{' + aTex + '}^{' + bTex + '} ' + BS + 'left(' + fTexStr + BS + 'right)' + BS + ',dx = ' + BS + 'Big[F(x)' + BS + 'Big]_{' + aTex + '}^{' + bTex + '} = F' + BS + 'left(' + bTex + BS + 'right) - F' + BS + 'left(' + aTex + BS + 'right) = ' + valTex);
          }
          casResult = 'F(x) = ' + itPlain(prim) + ' ; integrale de ' + a + ' a ' + b + ' = ' + valPlain;
        } else {
          if(!isFinite(num)) return fail('Intégrale non calculable sur cet intervalle.');
          var sn2 = pwSnap(num); valTex = sn2.tex; valPlain = sn2.plain;
          t += '<div class="study-work">Pas de primitive usuelle reconnue : valeur obtenue par calcul numérique (méthode de Simpson).</div>';
          t += R.line('', BS + 'int_{' + aTex + '}^{' + bTex + '} ' + BS + 'left(' + fTexStr + BS + 'right)' + BS + ',dx ' + (valTex.indexOf(BS + 'approx') === 0 ? valTex : '= ' + valTex));
          casResult = 'integrale de ' + a + ' a ' + b + ' = ' + valPlain + ' (calcul numerique)';
        }
        // interpretation as an area
        var allPos = true, allNeg = true;
        for(var q = 1; q < 200; q++){ var yv = pwEval(fAst, lo + (hi - lo) * q / 200, {}); if(yv < -1e-12) allPos = false; if(yv > 1e-12) allNeg = false; }
        if(av > bv) t += '<div class="study-work">Ici a > b : ∫ₐᵇ f = −∫ᵦᵃ f (les bornes sont « dans le mauvais sens »).</div>';
        else if(allPos) t += '<div class="study-work">f ≥ 0 sur [a ; b] : l’intégrale est l’aire (en unités d’aire) du domaine sous la courbe.</div>';
        else if(allNeg) t += '<div class="study-work">f ≤ 0 sur [a ; b] : l’intégrale est l’opposé de l’aire du domaine entre la courbe et l’axe.</div>';
        else t += '<div class="study-work">f change de signe sur [a ; b] : l’intégrale est la somme algébrique des aires (au-dessus de l’axe comptées +, en dessous −).</div>';
        body += R.sec('Intégrale définie', t);
        R.render('Calcul d’intégrale', body);
        defInt('iarea', 'iarea=Integral(f, ' + a + ', ' + b + ')'); colour('iarea', 255, 184, 0);
      }

      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';
      var op = (intType === 'def') ? 'integral_def' : 'integral';
      var reqBody = { function: f, operation: op, casResult: casResult.slice(0, 495) };
      if(intType === 'def'){ reqBody.a = a; reqBody.b = b; }
      try {
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(reqBody) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){
        stateEl.textContent = 'Connexion impossible — réessayez.';
      } finally {
        setIOpsEnabled(true);
      }
    }

    iopsEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return;
      runIntegral();
    });
    setIType('indef');
    document.getElementById('iipp-note').addEventListener('click', function(ev){ var b = ev.target.closest('[data-ippex]'); if(!b) return; var p = b.getAttribute('data-ippex').split('|'); ifxInput.value = p[0]; iaInput.value = p[1]; ibInput.value = p[2]; updateIntPreview(); runIPP(); });

    /* ============ CERCLE TRIGONOMÉTRIQUE ============ */
    var modeTrig = document.getElementById('mode-trig');
    var tcSvg = document.getElementById('trig-svg');
    var TC_CX = 170, TC_CY = 170, TC_R = 130;
    var tcEls = {};
    ['tc-vproj','tc-hproj','tc-cos','tc-sin','tc-tan','tc-tanconn','tc-radius','tc-point','tc-tanpoint','tc-angle','tc-cosv','tc-sinv','tc-tanv'].forEach(function(id){ tcEls[id] = document.getElementById(id); });
    var tcDeg = 45;
    // Angle measured in ]-π, π]  (i.e. ]-180°, 180°]).
    function norm180(d){ d = ((d % 360) + 360) % 360; if(d > 180) d -= 360; return d; }
    var NICE_DEG = [0,30,45,60,90,120,135,150,180,-30,-45,-60,-90,-120,-135,-150];
    var RAD_LATEX = {
      0:'0', 30:BS+'frac{'+BS+'pi}{6}', 45:BS+'frac{'+BS+'pi}{4}', 60:BS+'frac{'+BS+'pi}{3}', 90:BS+'frac{'+BS+'pi}{2}',
      120:BS+'frac{2'+BS+'pi}{3}', 135:BS+'frac{3'+BS+'pi}{4}', 150:BS+'frac{5'+BS+'pi}{6}', 180:BS+'pi',
      '-30':'-'+BS+'frac{'+BS+'pi}{6}', '-45':'-'+BS+'frac{'+BS+'pi}{4}', '-60':'-'+BS+'frac{'+BS+'pi}{3}', '-90':'-'+BS+'frac{'+BS+'pi}{2}',
      '-120':'-'+BS+'frac{2'+BS+'pi}{3}', '-135':'-'+BS+'frac{3'+BS+'pi}{4}', '-150':'-'+BS+'frac{5'+BS+'pi}{6}'
    };
    function tcExact(x){
      var s3 = Math.sqrt(3), h = Math.SQRT1_2;
      var t = [[0,'0'],[1,'1'],[-1,'-1'],[0.5,BS+'frac{1}{2}'],[-0.5,'-'+BS+'frac{1}{2}'],
        [h,BS+'frac{'+BS+'sqrt{2}}{2}'],[-h,'-'+BS+'frac{'+BS+'sqrt{2}}{2}'],
        [s3/2,BS+'frac{'+BS+'sqrt{3}}{2}'],[-s3/2,'-'+BS+'frac{'+BS+'sqrt{3}}{2}'],
        [s3/3,BS+'frac{'+BS+'sqrt{3}}{3}'],[-s3/3,'-'+BS+'frac{'+BS+'sqrt{3}}{3}'],
        [s3,BS+'sqrt{3}'],[-s3,'-'+BS+'sqrt{3}']];
      for(var i=0;i<t.length;i++){ if(Math.abs(x - t[i][0]) < 1e-9) return t[i][1]; }
      return null;
    }
    function snapNice(deg){
      deg = norm180(deg);
      for(var i=0;i<NICE_DEG.length;i++){ var d = NICE_DEG[i], diff = Math.abs(deg - d); diff = Math.min(diff, 360 - diff); if(diff <= 4) return d; }
      return null;
    }
    function tcLine(el, x1, y1, x2, y2){ el.setAttribute('x1', x1); el.setAttribute('y1', y1); el.setAttribute('x2', x2); el.setAttribute('y2', y2); }
    function tcDot(el, x, y){ el.setAttribute('cx', x); el.setAttribute('cy', y); }
    function tcShow(el, on){ el.setAttribute('opacity', on ? '1' : '0'); }

    function tcRender(deg){
      var snap = snapNice(deg);
      var useDeg = (snap != null) ? snap : norm180(deg);
      var th = useDeg * Math.PI / 180, c = Math.cos(th), s = Math.sin(th);
      var px = TC_CX + TC_R * c, py = TC_CY - TC_R * s;
      tcLine(tcEls['tc-radius'], TC_CX, TC_CY, px, py);
      tcDot(tcEls['tc-point'], px, py);
      tcLine(tcEls['tc-cos'], TC_CX, TC_CY, px, TC_CY);
      tcLine(tcEls['tc-sin'], TC_CX, TC_CY, TC_CX, py);
      tcLine(tcEls['tc-vproj'], px, py, px, TC_CY);
      tcLine(tcEls['tc-hproj'], px, py, TC_CX, py);
      var tanVal = (Math.abs(c) < 1e-9) ? null : s / c;
      if(tanVal == null){ tcShow(tcEls['tc-tan'], false); tcShow(tcEls['tc-tanconn'], false); tcShow(tcEls['tc-tanpoint'], false); }
      else {
        var clampY = Math.max(34, Math.min(306, TC_CY - TC_R * tanVal));
        tcShow(tcEls['tc-tan'], true); tcShow(tcEls['tc-tanconn'], true); tcShow(tcEls['tc-tanpoint'], true);
        tcLine(tcEls['tc-tan'], TC_CX + TC_R, TC_CY, TC_CX + TC_R, clampY);
        tcLine(tcEls['tc-tanconn'], TC_CX, TC_CY, TC_CX + TC_R, clampY);
        tcDot(tcEls['tc-tanpoint'], TC_CX + TC_R, clampY);
      }
      if(snap != null){
        renderKatex(tcEls['tc-angle'], BS + 'theta = ' + (RAD_LATEX[snap] || '0') + BS + ';(' + snap + '^' + BS + 'circ)');
        renderKatex(tcEls['tc-cosv'], tcExact(c) || c.toFixed(3));
        renderKatex(tcEls['tc-sinv'], tcExact(s) || s.toFixed(3));
        if(tanVal == null) tcEls['tc-tanv'].textContent = 'non défini';
        else renderKatex(tcEls['tc-tanv'], tcExact(tanVal) || tanVal.toFixed(3));
      } else {
        tcEls['tc-angle'].textContent = useDeg.toFixed(1) + '°  (' + (useDeg * Math.PI / 180).toFixed(2) + ' rad)';
        tcEls['tc-cosv'].textContent = c.toFixed(3);
        tcEls['tc-sinv'].textContent = s.toFixed(3);
        tcEls['tc-tanv'].textContent = (tanVal == null) ? 'non défini' : tanVal.toFixed(3);
      }
    }
    function tcAngleFromEvent(ev){
      var rect = tcSvg.getBoundingClientRect();
      if(!rect.width) return tcDeg;
      var sx = (ev.clientX - rect.left) / rect.width * 340, sy = (ev.clientY - rect.top) / rect.height * 340;
      return Math.atan2(-(sy - TC_CY), sx - TC_CX) * 180 / Math.PI;
    }
    tcSvg.addEventListener('pointermove', function(ev){ tcDeg = tcAngleFromEvent(ev); tcRender(tcDeg); });
    tcSvg.addEventListener('pointerdown', function(ev){ tcDeg = tcAngleFromEvent(ev); tcRender(tcDeg); });

    // Interleaved cos/sin so the 2-column grid puts cos (blue) left, sin (red) right.
    var TC_FORMULAS = [
      { k:'gen', t: BS+'cos^2'+BS+'theta + '+BS+'sin^2'+BS+'theta = 1' },
      { k:'gen', t: BS+'tan'+BS+'theta = '+BS+'frac{'+BS+'sin'+BS+'theta}{'+BS+'cos'+BS+'theta}' },
      { k:'cos', t: BS+'cos(-'+BS+'theta) = '+BS+'cos'+BS+'theta' },
      { k:'sin', t: BS+'sin(-'+BS+'theta) = -'+BS+'sin'+BS+'theta' },
      { k:'cos', t: BS+'cos('+BS+'pi - '+BS+'theta) = -'+BS+'cos'+BS+'theta' },
      { k:'sin', t: BS+'sin('+BS+'pi - '+BS+'theta) = '+BS+'sin'+BS+'theta' },
      { k:'cos', t: BS+'cos('+BS+'tfrac{'+BS+'pi}{2} - '+BS+'theta) = '+BS+'sin'+BS+'theta' },
      { k:'sin', t: BS+'sin('+BS+'tfrac{'+BS+'pi}{2} - '+BS+'theta) = '+BS+'cos'+BS+'theta' },
      { k:'cos', t: BS+'cos('+BS+'tfrac{'+BS+'pi}{2} + '+BS+'theta) = -'+BS+'sin'+BS+'theta' },
      { k:'sin', t: BS+'sin('+BS+'tfrac{'+BS+'pi}{2} + '+BS+'theta) = '+BS+'cos'+BS+'theta' },
      { k:'cos', t: BS+'cos(a+b) = '+BS+'cos a'+BS+'cos b - '+BS+'sin a'+BS+'sin b' },
      { k:'sin', t: BS+'sin(a+b) = '+BS+'sin a'+BS+'cos b + '+BS+'cos a'+BS+'sin b' },
      { k:'cos', t: BS+'cos(a-b) = '+BS+'cos a'+BS+'cos b + '+BS+'sin a'+BS+'sin b' },
      { k:'sin', t: BS+'sin(a-b) = '+BS+'sin a'+BS+'cos b - '+BS+'cos a'+BS+'sin b' },
      { k:'cos', t: BS+'cos(2a) = 2'+BS+'cos^2 a - 1' },
      { k:'sin', t: BS+'sin(2a) = 2'+BS+'sin a'+BS+'cos a' }
    ];
    // Produit → Somme (cos·cos / sin·sin → cos ; sin·cos → sin)
    var TC_PROD2SUM = [
      { k:'cos', t: BS+'cos a'+BS+'cos b = '+BS+'tfrac{1}{2}'+BS+'big['+BS+'cos(a-b) + '+BS+'cos(a+b)'+BS+'big]' },
      { k:'sin', t: BS+'sin a'+BS+'sin b = '+BS+'tfrac{1}{2}'+BS+'big['+BS+'cos(a-b) - '+BS+'cos(a+b)'+BS+'big]' },
      { k:'cos', t: BS+'sin a'+BS+'cos b = '+BS+'tfrac{1}{2}'+BS+'big['+BS+'sin(a+b) + '+BS+'sin(a-b)'+BS+'big]' },
      { k:'sin', t: BS+'cos a'+BS+'sin b = '+BS+'tfrac{1}{2}'+BS+'big['+BS+'sin(a+b) - '+BS+'sin(a-b)'+BS+'big]' }
    ];
    // Somme → Produit
    var TC_SUM2PROD = [
      { k:'cos', t: BS+'cos p + '+BS+'cos q = 2'+BS+'cos'+BS+'tfrac{p+q}{2}'+BS+'cos'+BS+'tfrac{p-q}{2}' },
      { k:'sin', t: BS+'sin p + '+BS+'sin q = 2'+BS+'sin'+BS+'tfrac{p+q}{2}'+BS+'cos'+BS+'tfrac{p-q}{2}' },
      { k:'cos', t: BS+'cos p - '+BS+'cos q = -2'+BS+'sin'+BS+'tfrac{p+q}{2}'+BS+'sin'+BS+'tfrac{p-q}{2}' },
      { k:'sin', t: BS+'sin p - '+BS+'sin q = 2'+BS+'cos'+BS+'tfrac{p+q}{2}'+BS+'sin'+BS+'tfrac{p-q}{2}' }
    ];
    function renderFormulaGrid(boxId, arr){
      var box = document.getElementById(boxId); if(!box) return;
      arr.forEach(function(f){ var d = document.createElement('div'); d.className = 'trig-f trig-f--' + f.k; box.appendChild(d); renderKatex(d, f.t); });
    }
    renderFormulaGrid('tc-formulas', TC_FORMULAS);
    renderFormulaGrid('tc-prod2sum', TC_PROD2SUM);
    renderFormulaGrid('tc-sum2prod', TC_SUM2PROD);
    tcRender(tcDeg);

    /* --- Trigonométrie : opérations (équation / linéarisation / duplication) --- */
    var trigCircleCard = document.getElementById('trig-circle-card');
    var trigOptype = document.getElementById('trig-optype');
    var trigEqFields = document.getElementById('trig-eq-fields');
    var trigExprFields = document.getElementById('trig-expr-fields');
    var trigEq = document.getElementById('trig-eq');
    var trigInt = document.getElementById('trig-int');
    var trigExpr = document.getElementById('trig-expr');
    var trigKeysEl = document.getElementById('trig-keys');
    var trigRun = document.getElementById('trig-run');
    var trigHint = document.getElementById('trig-hint');
    var trigPrev = document.getElementById('trig-preview');
    var trigOp = 'equation';
    var activeTrig = trigEq;

    function intervalLatex(iv){ return (iv || '').split('π').join('pi').split('pi').join(BS + 'pi'); }
    function eqToLatex(eq){
      var i = eq.indexOf('=');
      if(i < 0) return toLatex(eq);
      var L = toLatex(eq.slice(0, i).trim());
      var rr = eq.slice(i + 1).trim();
      return L + ' = ' + (rr === '' ? '' : toLatex(rr));
    }
    function updateTrigPreview(){
      var raw = (trigOp === 'equation') ? (trigEq.value || '').trim() : (trigExpr.value || '').trim();
      if(!raw){ trigPrev.className = 'ml-preview is-empty'; trigPrev.textContent = 'Aperçu…'; return; }
      var tex = null;
      try {
        if(trigOp === 'equation'){
          tex = eqToLatex(raw);
          var iv = (trigInt.value || '').trim();
          if(iv) tex += BS + 'quad x ' + BS + 'in ' + intervalLatex(iv);
        } else { tex = toLatex(raw); }
      } catch(e){ tex = null; }
      if(tex == null){ trigPrev.className = 'ml-preview is-empty'; trigPrev.textContent = '…en cours de saisie'; return; }
      try { katex.render(tex, trigPrev, { throwOnError:true, displayMode:false }); trigPrev.className = 'ml-preview'; }
      catch(e){ trigPrev.className = 'ml-preview is-empty'; trigPrev.textContent = '…en cours de saisie'; }
    }

    function setTrigOp(t){
      trigOp = t;
      trigOptype.querySelectorAll('.ml-sidebtn').forEach(function(b){ b.classList.toggle('is-active', b.getAttribute('data-top') === t); });
