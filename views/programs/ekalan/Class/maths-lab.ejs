          <div class="ml-input-row"><label for="tf-pts">Images de</label><input id="tf-pts" type="text" value="A = 1 ; B = 3 + i ; C = 1 + 2i" autocomplete="off" spellcheck="false" placeholder="ex. A = 1 ; B = 3 + i ; C = 1 + 2i" /></div>
          <div class="ml-input-row"><label for="tf-line">Image de la droite</label><input id="tf-line" type="text" value="" autocomplete="off" spellcheck="false" placeholder="facultatif — ex. y = 2x + 1, x = 3, ou deux points 1 ; 2+i" /></div>
          <div class="ml-input-row"><label for="tf-cc">Image du cercle : centre</label><input id="tf-cc" type="text" value="" autocomplete="off" spellcheck="false" placeholder="facultatif — ex. 1+i" style="flex:1" /><label for="tf-cr">rayon</label><input id="tf-cr" type="text" value="" autocomplete="off" spellcheck="false" placeholder="ex. 2" style="flex:0 0 5.5rem;width:5.5rem;min-width:5.5rem" /></div>
