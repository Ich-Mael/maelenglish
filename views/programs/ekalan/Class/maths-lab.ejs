    function integralCAS(f){
      if(intType === 'def'){
        var a = (iaInput.value || '').trim(), b = (ibInput.value || '').trim();
        return 'Integral(' + f + ', ' + a + ', ' + b + ')';
      }
      return 'Integral(' + f + ')';
    }

    /* --- Pure-JS integration (GeoGebra's CAS answers "?" to Integral(…) in this deployment) ---
       Primitive as a sum of terms { c: fraction, body: string in x }: exact for polynomials, plus
       linearity and the classic forms 1/(ax+b), (ax+b)^n, e^(ax+b), sin/cos(ax+b), √(ax+b). */
    function astToPolyX(n){
      if(!n) return null;
      switch(n.t){
        case 'num': { var f = fFromNum(n.v); return f ? [f] : null; }
        case 'var': return [fr(0), fr(1)];
        case 'const': return null;
        case 'neg': { var a = astToPolyX(n.a); return a ? pScale(a, fr(-1)) : null; }
        case '+': case '-': case '*': {
          var l = astToPolyX(n.l), r = astToPolyX(n.r); if(!l || !r) return null;
          return n.t === '+' ? pAdd(l, r) : n.t === '-' ? pSub(l, r) : pMul(l, r);
        }
        case '/': { var l2 = astToPolyX(n.l), r2 = astToPolyX(n.r); if(!l2 || !r2 || !pConst(r2) || fZero(r2[0])) return null; return pScale(l2, fDiv(fr(1), r2[0])); }
        case '^': { var b = astToPolyX(n.l), e = astToPolyX(n.r); if(!b || !e || !pConst(e)) return null; var ev = fVal(e[0]); if(ev < 0 || ev > 12 || ev !== Math.floor(ev)) return null; var res = [fr(1)]; for(var i = 0; i < ev; i++) res = pMul(res, b); return res; }
      }
      return null;
    }
    function itConst(n){ var p = astToPolyX(n); return (p && pConst(p)) ? p[0] : null; }
    function itLin(n){ var p = astToPolyX(n); if(!p || pDeg(p) !== 1) return null; return { a: p[1], b: p[0], s: pPlain([p[0], p[1]], 'x'), isX: fZero(p[0]) && p[1].n === p[1].d }; }
    function itScale(terms, k){ return terms ? terms.map(function(t){ return { c: fMul(t.c, k), body: t.body }; }) : null; }
    function itPow(L, n){ // ∫ (ax+b)^n dx
      if(fZero(fAdd(n, fr(1)))) return [{ c: fDiv(fr(1), L.a), body: 'ln(abs(' + L.s + '))' }];
      var np = fAdd(n, fr(1)), base = L.isX ? 'x' : '(' + L.s + ')';
      return [{ c: fDiv(fr(1), fMul(L.a, np)), body: base + '^' + (np.d === 1 ? String(np.n) : '(' + fPlain(np) + ')') }];
    }
    function itInt(n){
      if(!n) return null;
      var poly = astToPolyX(n);
      if(poly){
        var out = [];
        for(var k = pDeg(poly); k >= 0; k--){ if(!fZero(poly[k])) out.push({ c: fDiv(poly[k], fr(k + 1)), body: k + 1 === 1 ? 'x' : 'x^' + (k + 1) }); }
        return out;
      }
      switch(n.t){
        case '+': { var a = itInt(n.l), b = itInt(n.r); return (a && b) ? a.concat(b) : null; }
        case '-': { var a2 = itInt(n.l), b2 = itInt(n.r); return (a2 && b2) ? a2.concat(itScale(b2, fr(-1))) : null; }
        case 'neg': return itScale(itInt(n.a), fr(-1));
        case '*': { var kl = itConst(n.l); if(kl) return itScale(itInt(n.r), kl); var kr = itConst(n.r); if(kr) return itScale(itInt(n.l), kr); return null; }
        case '/': {
          var kd = itConst(n.r); if(kd && !fZero(kd)) return itScale(itInt(n.l), fDiv(fr(1), kd));
          var kn = itConst(n.l); if(!kn) return null;
          var L = itLin(n.r); if(L) return itScale(itPow(L, fr(-1)), kn);
          if(n.r.t === '^'){ var Lp = itLin(n.r.l), ep = itConst(n.r.r); if(Lp && ep) return itScale(itPow(Lp, fNeg(ep)), kn); }
          if(n.r.t === 'fn' && n.r.name === 'sqrt'){ var Ls = itLin(n.r.a); if(Ls) return itScale(itPow(Ls, fr(-1, 2)), kn); }
          return null;
        }
        case '^': { var Lb = itLin(n.l), e = itConst(n.r); if(Lb && e) return itPow(Lb, e); return null; }
        case 'fn': {
          var Lf = itLin(n.a); if(!Lf) return null;
          var inv = fDiv(fr(1), Lf.a), arg = Lf.s;
          if(n.name === 'exp') return [{ c: inv, body: 'exp(' + arg + ')' }];
          if(n.name === 'sin') return [{ c: fNeg(inv), body: 'cos(' + arg + ')' }];
          if(n.name === 'cos') return [{ c: inv, body: 'sin(' + arg + ')' }];
          if(n.name === 'sqrt') return itPow(Lf, fr(1, 2));
          return null;
        }
      }
      return null;
    }
    function itBodyTex(body){ try { return toLatex(body); } catch(e){ return body; } }
    function itTex(terms){
      var out = '', first = true;
      terms.forEach(function(t){
        if(fZero(t.c)) return;
        var neg = t.c.n < 0, ab = fr(Math.abs(t.c.n), t.c.d), ct = (ab.n === 1 && ab.d === 1) ? '' : fTex(ab) + BS + ',';
        out += first ? ((neg ? '-' : '') + ct + itBodyTex(t.body)) : ((neg ? ' - ' : ' + ') + ct + itBodyTex(t.body)); first = false;
      });
      return out || '0';
    }
    function itStr(terms){ var s = terms.filter(function(t){ return !fZero(t.c); }).map(function(t){ return '(' + t.c.n + '/' + t.c.d + ')*(' + t.body + ')'; }).join('+'); return s || '0'; }
    function itPlain(terms){ return terms.filter(function(t){ return !fZero(t.c); }).map(function(t, i){ var neg = t.c.n < 0, ab = fr(Math.abs(t.c.n), t.c.d); return (i ? (neg ? ' - ' : ' + ') : (neg ? '-' : '')) + ((ab.n === 1 && ab.d === 1) ? '' : fPlain(ab)) + t.body; }).join('') || '0'; }
    function itCompile(str){ var tk = dxTok(str); if(!tk) return null; try { return dxParse(tk); } catch(e){ return null; } }
    function itSimpson(fAst, a, b){ // composite Simpson; endpoints nudged inward if f is undefined there
      var N = 2000, h = (b - a) / N, s = 0, eps = 1e-9 * (b > a ? 1 : -1);
      for(var i = 0; i <= N; i++){
        var x = a + i * h, y = pwEval(fAst, x, {});
        if(!isFinite(y) && (i === 0 || i === N)) y = pwEval(fAst, i === 0 ? a + eps : b - eps, {});
        if(!isFinite(y)) return NaN;
        s += y * (i === 0 || i === N ? 1 : (i % 2 ? 4 : 2));
      }
      return s * h / 3;
    }

    async function runIntegral(){
      var f = (ifxInput.value || '').trim();
      if(!f){ stateEl.textContent = 'Saisissez une fonction.'; return; }
      if(!ggb) return;
      var a = '', b = '';
      if(intType === 'def'){
        a = (iaInput.value || '').trim(); b = (ibInput.value || '').trim();
        if(!a || !b){ stateEl.textContent = 'Renseignez les bornes a et b.'; return; }
      }
      clearIntPlot();
      plot(f);
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul en cours…';
      setIOpsEnabled(false);
      function fail(msg){ answerEl.innerHTML = '<div class="ml-warn" style="margin-top:1rem"><i class="bi bi-exclamation-triangle"></i><span>' + escapeHtml(msg) + '</span></div>'; stateEl.textContent = ''; setIOpsEnabled(true); }

      var fAst = itCompile(f);
      if(!fAst){ return fail('Fonction invalide — vérifiez la syntaxe (ex. x^2 - 3x, 1/x, exp(2x), cos(x)).'); }
      var prim = null; try { prim = itInt(fAst); } catch(e){ prim = null; }
      var R = e1Report(), body = '', casResult = '';
      var fTexStr = null; try { fTexStr = toLatex(f); } catch(e){ fTexStr = f; }

      if(intType !== 'def'){
        if(!prim){
          // last resort: GeoGebra CAS
          var cas = ''; try { cas = ggbToText(ggb.evalCommandCAS(integralCAS(f))).trim(); } catch(e){ cas = ''; }
          if(!cas || cas === '?') return fail('Primitive non calculable automatiquement pour cette fonction. Formes prises en charge : polynômes, 1/x, 1/(ax+b), (ax+b)ⁿ, e^(ax+b), sin(ax+b), cos(ax+b), √(ax+b), et leurs combinaisons linéaires.');
          casResult = cas;
          body += R.sec('Primitive', R.line('', BS + 'int ' + fTexStr + BS + ',dx = ' + escapeHtml(cas)));
        } else {
          var Ft = itTex(prim);
          body += R.sec('Primitive', R.line('', BS + 'int ' + BS + 'left(' + fTexStr + BS + 'right)' + BS + ',dx = ' + Ft + ' + C,' + BS + 'quad C ' + BS + 'in ' + BS + 'mathbb{R}'));
          casResult = 'F(x) = ' + itPlain(prim) + ' + C';
        }
        R.render('Primitive', body);
      } else {
        var aAst = itCompile(a), bAst = itCompile(b);
        var av = aAst ? pwEval(aAst, 0, {}) : NaN, bv = bAst ? pwEval(bAst, 0, {}) : NaN;
        if(!isFinite(av) || !isFinite(bv)) return fail('Bornes a et b invalides (nombres, fractions, pi…).');
        // f must be defined (and finite) on [a, b]
        var lo = Math.min(av, bv), hi = Math.max(av, bv), okDom = true;
        for(var k = 0; k <= 400 && okDom; k++){ var xs = lo + (hi - lo) * k / 400; if(!isFinite(pwEval(fAst, xs, {}))) okDom = false; }
        if(!okDom) return fail('f n’est pas définie (ou pas continue) sur tout l’intervalle [' + a + ' ; ' + b + '] : l’intégrale n’est pas calculable ici.');
        var num = itSimpson(fAst, av, bv);
        var aTex = (function(){ try { return toLatex(a); } catch(e){ return a; } })(), bTex = (function(){ try { return toLatex(b); } catch(e){ return b; } })();
        var t = '', valTex, valPlain;
        if(prim){
          var Ft2 = itTex(prim), Fast = itCompile(itStr(prim));
          var aF = fFromNum(av), bF = fFromNum(bv), polyF = null;
          var pX = astToPolyX(fAst);
          if(pX && aF && bF){ // exact for polynomials with rational bounds
            var Pp = [fr(0)]; for(var j = 0; j <= pDeg(pX); j++) Pp[j + 1] = fDiv(pX[j], fr(j + 1));
            var Fb = pEvalF(Pp, bF), Fa = pEvalF(Pp, aF), I = fSub(Fb, Fa);
            valTex = fTex(I); valPlain = fPlain(I);
            t += R.line('Primitive :', 'F(x) = ' + Ft2);
            t += R.line('', BS + 'int_{' + aTex + '}^{' + bTex + '} ' + BS + 'left(' + fTexStr + BS + 'right)' + BS + ',dx = ' + BS + 'Big[F(x)' + BS + 'Big]_{' + aTex + '}^{' + bTex + '} = F' + BS + 'left(' + bTex + BS + 'right) - F' + BS + 'left(' + aTex + BS + 'right)');
            t += R.line('', '= ' + fTex(Fb) + ' - ' + fPar(Fa) + ' = ' + valTex);
          } else {
            var Fbn = pwEval(Fast, bv, {}), Fan = pwEval(Fast, av, {}), In = Fbn - Fan;
            if(!isFinite(In)) In = num;
            var sn = pwSnap(In); valTex = sn.tex; valPlain = sn.plain;
            t += R.line('Primitive :', 'F(x) = ' + Ft2);
            t += R.line('', BS + 'int_{' + aTex + '}^{' + bTex + '} ' + BS + 'left(' + fTexStr + BS + 'right)' + BS + ',dx = ' + BS + 'Big[F(x)' + BS + 'Big]_{' + aTex + '}^{' + bTex + '} = F' + BS + 'left(' + bTex + BS + 'right) - F' + BS + 'left(' + aTex + BS + 'right) = ' + valTex);
          }
          casResult = 'F(x) = ' + itPlain(prim) + ' ; integrale de ' + a + ' a ' + b + ' = ' + valPlain;
        } else {
          if(!isFinite(num)) return fail('Intégrale non calculable sur cet intervalle.');
          var sn2 = pwSnap(num); valTex = sn2.tex; valPlain = sn2.plain;
          t += '<div class="study-work">Pas de primitive usuelle reconnue : valeur obtenue par calcul numérique (méthode de Simpson).</div>';
          t += R.line('', BS + 'int_{' + aTex + '}^{' + bTex + '} ' + BS + 'left(' + fTexStr + BS + 'right)' + BS + ',dx ' + (valTex.indexOf(BS + 'approx') === 0 ? valTex : '= ' + valTex));
          casResult = 'integrale de ' + a + ' a ' + b + ' = ' + valPlain + ' (calcul numerique)';
        }
        // interpretation as an area
        var allPos = true, allNeg = true;
        for(var q = 1; q < 200; q++){ var yv = pwEval(fAst, lo + (hi - lo) * q / 200, {}); if(yv < -1e-12) allPos = false; if(yv > 1e-12) allNeg = false; }
        if(av > bv) t += '<div class="study-work">Ici a > b : ∫ₐᵇ f = −∫ᵦᵃ f (les bornes sont « dans le mauvais sens »).</div>';
        else if(allPos) t += '<div class="study-work">f ≥ 0 sur [a ; b] : l’intégrale est l’aire (en unités d’aire) du domaine sous la courbe.</div>';
        else if(allNeg) t += '<div class="study-work">f ≤ 0 sur [a ; b] : l’intégrale est l’opposé de l’aire du domaine entre la courbe et l’axe.</div>';
        else t += '<div class="study-work">f change de signe sur [a ; b] : l’intégrale est la somme algébrique des aires (au-dessus de l’axe comptées +, en dessous −).</div>';
        body += R.sec('Intégrale définie', t);
        R.render('Calcul d’intégrale', body);
        defInt('iarea', 'iarea=Integral(f, ' + a + ', ' + b + ')'); colour('iarea', 255, 184, 0);
      }

      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';
      var op = (intType === 'def') ? 'integral_def' : 'integral';
      var reqBody = { function: f, operation: op, casResult: casResult.slice(0, 495) };
      if(intType === 'def'){ reqBody.a = a; reqBody.b = b; }
      try {
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(reqBody) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){
        stateEl.textContent = 'Connexion impossible — réessayez.';
      } finally {
        setIOpsEnabled(true);
      }
    }

    iopsEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return;
      runIntegral();
    });
    setIType('indef');

    /* ============ CERCLE TRIGONOMÉTRIQUE ============ */
    var modeTrig = document.getElementById('mode-trig');
    var tcSvg = document.getElementById('trig-svg');
    var TC_CX = 170, TC_CY = 170, TC_R = 130;
    var tcEls = {};
    ['tc-vproj','tc-hproj','tc-cos','tc-sin','tc-tan','tc-tanconn','tc-radius','tc-point','tc-tanpoint','tc-angle','tc-cosv','tc-sinv','tc-tanv'].forEach(function(id){ tcEls[id] = document.getElementById(id); });
    var tcDeg = 45;
    // Angle measured in ]-π, π]  (i.e. ]-180°, 180°]).
    function norm180(d){ d = ((d % 360) + 360) % 360; if(d > 180) d -= 360; return d; }
    var NICE_DEG = [0,30,45,60,90,120,135,150,180,-30,-45,-60,-90,-120,-135,-150];
    var RAD_LATEX = {
      0:'0', 30:BS+'frac{'+BS+'pi}{6}', 45:BS+'frac{'+BS+'pi}{4}', 60:BS+'frac{'+BS+'pi}{3}', 90:BS+'frac{'+BS+'pi}{2}',
      120:BS+'frac{2'+BS+'pi}{3}', 135:BS+'frac{3'+BS+'pi}{4}', 150:BS+'frac{5'+BS+'pi}{6}', 180:BS+'pi',
      '-30':'-'+BS+'frac{'+BS+'pi}{6}', '-45':'-'+BS+'frac{'+BS+'pi}{4}', '-60':'-'+BS+'frac{'+BS+'pi}{3}', '-90':'-'+BS+'frac{'+BS+'pi}{2}',
      '-120':'-'+BS+'frac{2'+BS+'pi}{3}', '-135':'-'+BS+'frac{3'+BS+'pi}{4}', '-150':'-'+BS+'frac{5'+BS+'pi}{6}'
    };
    function tcExact(x){
      var s3 = Math.sqrt(3), h = Math.SQRT1_2;
      var t = [[0,'0'],[1,'1'],[-1,'-1'],[0.5,BS+'frac{1}{2}'],[-0.5,'-'+BS+'frac{1}{2}'],
        [h,BS+'frac{'+BS+'sqrt{2}}{2}'],[-h,'-'+BS+'frac{'+BS+'sqrt{2}}{2}'],
        [s3/2,BS+'frac{'+BS+'sqrt{3}}{2}'],[-s3/2,'-'+BS+'frac{'+BS+'sqrt{3}}{2}'],
        [s3/3,BS+'frac{'+BS+'sqrt{3}}{3}'],[-s3/3,'-'+BS+'frac{'+BS+'sqrt{3}}{3}'],
        [s3,BS+'sqrt{3}'],[-s3,'-'+BS+'sqrt{3}']];
      for(var i=0;i<t.length;i++){ if(Math.abs(x - t[i][0]) < 1e-9) return t[i][1]; }
      return null;
    }
    function snapNice(deg){
      deg = norm180(deg);
      for(var i=0;i<NICE_DEG.length;i++){ var d = NICE_DEG[i], diff = Math.abs(deg - d); diff = Math.min(diff, 360 - diff); if(diff <= 4) return d; }
      return null;
    }
    function tcLine(el, x1, y1, x2, y2){ el.setAttribute('x1', x1); el.setAttribute('y1', y1); el.setAttribute('x2', x2); el.setAttribute('y2', y2); }
    function tcDot(el, x, y){ el.setAttribute('cx', x); el.setAttribute('cy', y); }
    function tcShow(el, on){ el.setAttribute('opacity', on ? '1' : '0'); }

    function tcRender(deg){
      var snap = snapNice(deg);
      var useDeg = (snap != null) ? snap : norm180(deg);
      var th = useDeg * Math.PI / 180, c = Math.cos(th), s = Math.sin(th);
      var px = TC_CX + TC_R * c, py = TC_CY - TC_R * s;
      tcLine(tcEls['tc-radius'], TC_CX, TC_CY, px, py);
      tcDot(tcEls['tc-point'], px, py);
      tcLine(tcEls['tc-cos'], TC_CX, TC_CY, px, TC_CY);
      tcLine(tcEls['tc-sin'], TC_CX, TC_CY, TC_CX, py);
      tcLine(tcEls['tc-vproj'], px, py, px, TC_CY);
      tcLine(tcEls['tc-hproj'], px, py, TC_CX, py);
      var tanVal = (Math.abs(c) < 1e-9) ? null : s / c;
      if(tanVal == null){ tcShow(tcEls['tc-tan'], false); tcShow(tcEls['tc-tanconn'], false); tcShow(tcEls['tc-tanpoint'], false); }
      else {
        var clampY = Math.max(34, Math.min(306, TC_CY - TC_R * tanVal));
        tcShow(tcEls['tc-tan'], true); tcShow(tcEls['tc-tanconn'], true); tcShow(tcEls['tc-tanpoint'], true);
        tcLine(tcEls['tc-tan'], TC_CX + TC_R, TC_CY, TC_CX + TC_R, clampY);
        tcLine(tcEls['tc-tanconn'], TC_CX, TC_CY, TC_CX + TC_R, clampY);
        tcDot(tcEls['tc-tanpoint'], TC_CX + TC_R, clampY);
      }
      if(snap != null){
        renderKatex(tcEls['tc-angle'], BS + 'theta = ' + (RAD_LATEX[snap] || '0') + BS + ';(' + snap + '^' + BS + 'circ)');
        renderKatex(tcEls['tc-cosv'], tcExact(c) || c.toFixed(3));
        renderKatex(tcEls['tc-sinv'], tcExact(s) || s.toFixed(3));
        if(tanVal == null) tcEls['tc-tanv'].textContent = 'non défini';
        else renderKatex(tcEls['tc-tanv'], tcExact(tanVal) || tanVal.toFixed(3));
      } else {
        tcEls['tc-angle'].textContent = useDeg.toFixed(1) + '°  (' + (useDeg * Math.PI / 180).toFixed(2) + ' rad)';
        tcEls['tc-cosv'].textContent = c.toFixed(3);
        tcEls['tc-sinv'].textContent = s.toFixed(3);
        tcEls['tc-tanv'].textContent = (tanVal == null) ? 'non défini' : tanVal.toFixed(3);
      }
    }
    function tcAngleFromEvent(ev){
      var rect = tcSvg.getBoundingClientRect();
      if(!rect.width) return tcDeg;
      var sx = (ev.clientX - rect.left) / rect.width * 340, sy = (ev.clientY - rect.top) / rect.height * 340;
      return Math.atan2(-(sy - TC_CY), sx - TC_CX) * 180 / Math.PI;
    }
    tcSvg.addEventListener('pointermove', function(ev){ tcDeg = tcAngleFromEvent(ev); tcRender(tcDeg); });
    tcSvg.addEventListener('pointerdown', function(ev){ tcDeg = tcAngleFromEvent(ev); tcRender(tcDeg); });

    // Interleaved cos/sin so the 2-column grid puts cos (blue) left, sin (red) right.
    var TC_FORMULAS = [
      { k:'gen', t: BS+'cos^2'+BS+'theta + '+BS+'sin^2'+BS+'theta = 1' },
      { k:'gen', t: BS+'tan'+BS+'theta = '+BS+'frac{'+BS+'sin'+BS+'theta}{'+BS+'cos'+BS+'theta}' },
      { k:'cos', t: BS+'cos(-'+BS+'theta) = '+BS+'cos'+BS+'theta' },
      { k:'sin', t: BS+'sin(-'+BS+'theta) = -'+BS+'sin'+BS+'theta' },
      { k:'cos', t: BS+'cos('+BS+'pi - '+BS+'theta) = -'+BS+'cos'+BS+'theta' },
      { k:'sin', t: BS+'sin('+BS+'pi - '+BS+'theta) = '+BS+'sin'+BS+'theta' },
      { k:'cos', t: BS+'cos('+BS+'tfrac{'+BS+'pi}{2} - '+BS+'theta) = '+BS+'sin'+BS+'theta' },
      { k:'sin', t: BS+'sin('+BS+'tfrac{'+BS+'pi}{2} - '+BS+'theta) = '+BS+'cos'+BS+'theta' },
      { k:'cos', t: BS+'cos('+BS+'tfrac{'+BS+'pi}{2} + '+BS+'theta) = -'+BS+'sin'+BS+'theta' },
      { k:'sin', t: BS+'sin('+BS+'tfrac{'+BS+'pi}{2} + '+BS+'theta) = '+BS+'cos'+BS+'theta' },
      { k:'cos', t: BS+'cos(a+b) = '+BS+'cos a'+BS+'cos b - '+BS+'sin a'+BS+'sin b' },
      { k:'sin', t: BS+'sin(a+b) = '+BS+'sin a'+BS+'cos b + '+BS+'cos a'+BS+'sin b' },
      { k:'cos', t: BS+'cos(a-b) = '+BS+'cos a'+BS+'cos b + '+BS+'sin a'+BS+'sin b' },
      { k:'sin', t: BS+'sin(a-b) = '+BS+'sin a'+BS+'cos b - '+BS+'cos a'+BS+'sin b' },
      { k:'cos', t: BS+'cos(2a) = 2'+BS+'cos^2 a - 1' },
      { k:'sin', t: BS+'sin(2a) = 2'+BS+'sin a'+BS+'cos a' }
    ];
    // Produit → Somme (cos·cos / sin·sin → cos ; sin·cos → sin)
    var TC_PROD2SUM = [
      { k:'cos', t: BS+'cos a'+BS+'cos b = '+BS+'tfrac{1}{2}'+BS+'big['+BS+'cos(a-b) + '+BS+'cos(a+b)'+BS+'big]' },
      { k:'sin', t: BS+'sin a'+BS+'sin b = '+BS+'tfrac{1}{2}'+BS+'big['+BS+'cos(a-b) - '+BS+'cos(a+b)'+BS+'big]' },
      { k:'cos', t: BS+'sin a'+BS+'cos b = '+BS+'tfrac{1}{2}'+BS+'big['+BS+'sin(a+b) + '+BS+'sin(a-b)'+BS+'big]' },
      { k:'sin', t: BS+'cos a'+BS+'sin b = '+BS+'tfrac{1}{2}'+BS+'big['+BS+'sin(a+b) - '+BS+'sin(a-b)'+BS+'big]' }
    ];
    // Somme → Produit
    var TC_SUM2PROD = [
      { k:'cos', t: BS+'cos p + '+BS+'cos q = 2'+BS+'cos'+BS+'tfrac{p+q}{2}'+BS+'cos'+BS+'tfrac{p-q}{2}' },
      { k:'sin', t: BS+'sin p + '+BS+'sin q = 2'+BS+'sin'+BS+'tfrac{p+q}{2}'+BS+'cos'+BS+'tfrac{p-q}{2}' },
      { k:'cos', t: BS+'cos p - '+BS+'cos q = -2'+BS+'sin'+BS+'tfrac{p+q}{2}'+BS+'sin'+BS+'tfrac{p-q}{2}' },
      { k:'sin', t: BS+'sin p - '+BS+'sin q = 2'+BS+'cos'+BS+'tfrac{p+q}{2}'+BS+'sin'+BS+'tfrac{p-q}{2}' }
    ];
    function renderFormulaGrid(boxId, arr){
      var box = document.getElementById(boxId); if(!box) return;
      arr.forEach(function(f){ var d = document.createElement('div'); d.className = 'trig-f trig-f--' + f.k; box.appendChild(d); renderKatex(d, f.t); });
    }
    renderFormulaGrid('tc-formulas', TC_FORMULAS);
    renderFormulaGrid('tc-prod2sum', TC_PROD2SUM);
    renderFormulaGrid('tc-sum2prod', TC_SUM2PROD);
    tcRender(tcDeg);

    /* --- Trigonométrie : opérations (équation / linéarisation / duplication) --- */
    var trigCircleCard = document.getElementById('trig-circle-card');
    var trigOptype = document.getElementById('trig-optype');
    var trigEqFields = document.getElementById('trig-eq-fields');
    var trigExprFields = document.getElementById('trig-expr-fields');
    var trigEq = document.getElementById('trig-eq');
    var trigInt = document.getElementById('trig-int');
    var trigExpr = document.getElementById('trig-expr');
    var trigKeysEl = document.getElementById('trig-keys');
    var trigRun = document.getElementById('trig-run');
    var trigHint = document.getElementById('trig-hint');
    var trigPrev = document.getElementById('trig-preview');
    var trigOp = 'equation';
    var activeTrig = trigEq;

    function intervalLatex(iv){ return (iv || '').split('π').join('pi').split('pi').join(BS + 'pi'); }
    function eqToLatex(eq){
      var i = eq.indexOf('=');
      if(i < 0) return toLatex(eq);
      var L = toLatex(eq.slice(0, i).trim());
      var rr = eq.slice(i + 1).trim();
      return L + ' = ' + (rr === '' ? '' : toLatex(rr));
    }
    function updateTrigPreview(){
      var raw = (trigOp === 'equation') ? (trigEq.value || '').trim() : (trigExpr.value || '').trim();
      if(!raw){ trigPrev.className = 'ml-preview is-empty'; trigPrev.textContent = 'Aperçu…'; return; }
      var tex = null;
      try {
        if(trigOp === 'equation'){
          tex = eqToLatex(raw);
          var iv = (trigInt.value || '').trim();
          if(iv) tex += BS + 'quad x ' + BS + 'in ' + intervalLatex(iv);
        } else { tex = toLatex(raw); }
      } catch(e){ tex = null; }
      if(tex == null){ trigPrev.className = 'ml-preview is-empty'; trigPrev.textContent = '…en cours de saisie'; return; }
      try { katex.render(tex, trigPrev, { throwOnError:true, displayMode:false }); trigPrev.className = 'ml-preview'; }
      catch(e){ trigPrev.className = 'ml-preview is-empty'; trigPrev.textContent = '…en cours de saisie'; }
    }

    function setTrigOp(t){
      trigOp = t;
      trigOptype.querySelectorAll('.ml-sidebtn').forEach(function(b){ b.classList.toggle('is-active', b.getAttribute('data-top') === t); });
      trigEqFields.hidden = (t !== 'equation');
      trigExprFields.hidden = (t === 'equation');
      activeTrig = (t === 'equation') ? trigEq : trigExpr;
      trigHint.textContent = (t === 'equation')
        ? 'Résous une équation trigonométrique sur un intervalle (ex : cos(x) = 1/2 sur ]-π ; π]).'
        : (t === 'linearize')
        ? 'Linéarise : exprime cosⁿx, sinⁿx comme combinaison de cos(kx) et sin(kx) (ex : cos(x)^2, sin(x)^3).'
        : 'Développe avec les formules de duplication / d’addition, en fonction de cos x et sin x (ex : cos(2x)).';
      updateTrigPreview();
    }
    trigOptype.addEventListener('click', function(ev){ var b = ev.target.closest('.ml-sidebtn'); if(b) setTrigOp(b.getAttribute('data-top')); });

    [trigEq, trigInt, trigExpr].forEach(function(inp){
      inp.addEventListener('focus', function(){ activeTrig = inp; });
      inp.addEventListener('input', updateTrigPreview);
      inp.addEventListener('keydown', function(ev){ if(ev.key === 'Enter'){ ev.preventDefault(); runTrigOp(); } });
    });

    trigKeysEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-key'); if(!btn) return;
      var inp = activeTrig || trigEq;
      var act = btn.getAttribute('data-act');
      if(act === 'clear'){ inp.value = ''; inp.focus(); }
      else if(act === 'back'){
        var v = inp.value, s = inp.selectionStart, e = inp.selectionEnd;
        if(s == null){ inp.value = v.slice(0,-1); }
        else if(s !== e){ inp.value = v.slice(0,s) + v.slice(e); inp.setSelectionRange(s,s); }
        else if(s > 0){ inp.value = v.slice(0,s-1) + v.slice(s); inp.setSelectionRange(s-1,s-1); }
        inp.focus();
      } else { insertInto(inp, btn.getAttribute('data-ins')); }
      updateTrigPreview();
    });

    async function runTrigOp(){
      var op = (trigOp === 'equation') ? 'trig_equation' : (trigOp === 'linearize') ? 'trig_linearize' : 'trig_duplicate';
      var body = { domain:'trig', operation: op };
      if(trigOp === 'equation'){
        var eq = (trigEq.value || '').trim();
        if(!eq){ stateEl.textContent = 'Saisissez une équation.'; return; }
        body.expression = eq; body.interval = (trigInt.value || '').trim();
      } else {
        var ex = (trigExpr.value || '').trim();
        if(!ex){ stateEl.textContent = 'Saisissez une expression.'; return; }
        body.expression = ex;
      }
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul en cours…';
      trigRun.disabled = true;
      try {
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
        var data = await resp.json();
        if(data.ok){ showSteps(data); }
        else { stateEl.textContent = data.error || 'Indisponible pour le moment.'; }
      } catch(e){ stateEl.textContent = 'Connexion impossible — réessayez.'; }
      finally { trigRun.disabled = false; }
    }
    trigRun.addEventListener('click', runTrigOp);
    setTrigOp('equation');

    /* ============ SUITES NUMÉRIQUES ============ */
    var modeSuite     = document.getElementById('mode-suite');
    var suiteTypeEl   = document.getElementById('suite-type');
    var suiteUn       = document.getElementById('suite-un');
    var suiteFu       = document.getElementById('suite-fu');
    var suiteU0       = document.getElementById('suite-u0');
    var suiteNEl      = document.getElementById('suite-n');
    var suiteExpF     = document.getElementById('suite-exp-fields');
    var suiteRecF     = document.getElementById('suite-rec-fields');
    var suitePrevEl   = document.getElementById('suite-preview');
    var suiteKeysEl   = document.getElementById('suite-keys');
    var suiteOpsEl    = document.getElementById('suite-ops');
    var suiteType     = 'explicit';
    var activeSuite   = suiteUn;
    var suiteObjs     = [];

    function setSuiteOpsEnabled(on){ suiteOpsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }
    function setSuiteType(t){
      suiteType = t;
      suiteTypeEl.querySelectorAll('.ml-sidebtn').forEach(function(b){ b.classList.toggle('is-active', b.getAttribute('data-stype') === t); });
      suiteExpF.hidden = (t !== 'explicit'); suiteRecF.hidden = (t !== 'recurrent');
      activeSuite = (t === 'explicit') ? suiteUn : suiteFu;
      updateSuitePreview();
    }
    suiteTypeEl.addEventListener('click', function(ev){ var b = ev.target.closest('.ml-sidebtn'); if(b) setSuiteType(b.getAttribute('data-stype')); });

    function updateSuitePreview(){
      var tex = null;
      try {
        if(suiteType === 'explicit'){ var f = (suiteUn.value || '').trim(); if(!f) throw 0; tex = 'u_n = ' + toLatex(f); }
        else { var g = (suiteFu.value || '').trim(); if(!g) throw 0; tex = 'u_{n+1} = ' + toLatex(g).split('u').join('u_n'); }
      } catch(e){ tex = null; }
      if(tex == null){ suitePrevEl.className = 'ml-preview is-empty'; suitePrevEl.textContent = (suiteType === 'explicit' ? 'Aperçu de la suite…' : '…en cours de saisie'); return; }
      try { renderKatex(suitePrevEl, tex); suitePrevEl.className = 'ml-preview'; }
      catch(e){ suitePrevEl.className = 'ml-preview is-empty'; suitePrevEl.textContent = '…en cours de saisie'; }
    }
    [suiteUn, suiteFu, suiteU0].forEach(function(inp){
      inp.addEventListener('focus', function(){ if(inp !== suiteU0) activeSuite = inp; });
      inp.addEventListener('input', updateSuitePreview);
    });
    suiteKeysEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-key'); if(!btn) return;
      var inp = activeSuite || suiteUn, act = btn.getAttribute('data-sact');
      if(act === 'clear'){ inp.value = ''; inp.focus(); }
      else if(act === 'back'){ var v = inp.value, s = inp.selectionStart, e = inp.selectionEnd; if(s == null){ inp.value = v.slice(0, -1); } else if(s !== e){ inp.value = v.slice(0, s) + v.slice(e); inp.setSelectionRange(s, s); } else if(s > 0){ inp.value = v.slice(0, s - 1) + v.slice(s); inp.setSelectionRange(s - 1, s - 1); } inp.focus(); }
      else { insertInto(inp, btn.getAttribute('data-sins')); }
      updateSuitePreview();
    });

    // --- numeric evaluator: define the sequence function in GeoGebra, evaluate via SetValue ---
    function sEv(c){ try { ggb.evalCommand(c); return true; } catch(e){ return false; } }
    function sGv(l){ try { return ggb.getValue(l); } catch(e){ return NaN; } }
    function suiteCleanup(){ try { ggb.deleteObject('suRes'); } catch(e){} try { ggb.deleteObject('suArg'); } catch(e){} try { ggb.deleteObject('suFn'); } catch(e){} }
    function suiteEvaluator(){
      suiteCleanup();
      var formula, vn;
      if(suiteType === 'explicit'){ formula = (suiteUn.value || '').trim(); vn = 'n'; }
      else { formula = (suiteFu.value || '').trim(); vn = 'u'; }
      if(!formula) return null;
      if(!sEv('suFn(' + vn + ')=' + formula)) return null;
      sEv('suArg=0'); sEv('suRes=suFn(suArg)');
      return function(x){ sEv('SetValue(suArg,' + x + ')'); return sGv('suRes'); };
    }
    function suiteU0val(){ var u0 = Number((suiteU0.value || '').trim()); if(!isFinite(u0)){ if(sEv('suU0=' + ((suiteU0.value || '0').trim() || '0'))){ u0 = sGv('suU0'); try { ggb.deleteObject('suU0'); } catch(e){} } } return isFinite(u0) ? u0 : 0; }
    function suiteTerms(count){
      var f = suiteEvaluator(); if(!f) return null;
      var t = [];
      if(suiteType === 'explicit'){ var start = isFinite(f(0)) ? 0 : 1; for(var k = 0; k <= count; k++) t.push({ n: start + k, v: f(start + k) }); }
      else { var u = suiteU0val(); t.push({ n: 0, v: u }); for(var k = 1; k <= count; k++){ u = f(u); t.push({ n: k, v: u }); if(!isFinite(u)) break; } }
      suiteCleanup();
      return t;
    }
    function suiteVals(t){ return t.map(function(x){ return x.v; }).filter(function(v){ return isFinite(v); }); }
    function suiteNature(t){
      var vs = suiteVals(t); if(vs.length < 3) return { type: 'none' };
      // constant sequence (e.g. uₙ₊₁=0.5uₙ with u₀=0 → all 0) — report as constant, not arithmétique r=0
      if(vs.every(function(v){ return Math.abs(v - vs[0]) < 1e-9 * Math.max(1, Math.abs(vs[0])); })) return { type: 'const', c: vs[0] };
      var d = vs[1] - vs[0], ar = true;
      for(var k = 1; k < vs.length - 1; k++){ if(Math.abs((vs[k + 1] - vs[k]) - d) > 1e-6 * Math.max(1, Math.abs(d))){ ar = false; break; } }
      if(ar) return { type: 'arith', r: d };
      var ge = vs[0] !== 0, q = vs[0] !== 0 ? vs[1] / vs[0] : 0;
      for(var k2 = 0; ge && k2 < vs.length - 1; k2++){ if(vs[k2] === 0){ ge = false; break; } if(Math.abs(vs[k2 + 1] / vs[k2] - q) > 1e-6 * Math.max(1, Math.abs(q))){ ge = false; break; } }
      if(ge) return { type: 'geo', q: q };
      return { type: 'none' };
    }
    function suiteSens(t){
      var vs = suiteVals(t), inc = true, dec = true;
      for(var k = 0; k < vs.length - 1; k++){ if(vs[k + 1] > vs[k] + 1e-9) dec = false; if(vs[k + 1] < vs[k] - 1e-9) inc = false; }
      return inc && dec ? 'constante' : (inc ? 'croissante' : (dec ? 'décroissante' : 'non monotone'));
    }
    function suiteLimit(){
      var f = suiteEvaluator(); if(!f){ return { kind: '?' }; }
      var res = null;
      if(suiteType === 'explicit'){
        var a = f(2000), b = f(200000);
        if(!isFinite(b)) res = { kind: 'inf', s: b > 0 ? 1 : -1 };
        else if(Math.abs(b - a) < 1e-4) res = { kind: 'fin', v: b };
        else if(Math.abs(b) > 1e8) res = { kind: 'inf', s: b > 0 ? 1 : -1 };
        else res = (Math.abs(b) > Math.abs(a) + 1e-3) ? { kind: 'inf', s: b > 0 ? 1 : -1 } : { kind: 'fin', v: b };
      } else {
        var u = suiteU0val(), ok = true;
        for(var k = 0; k < 3000; k++){ u = f(u); if(!isFinite(u)){ ok = false; break; } if(Math.abs(u) > 1e10){ ok = false; res = { kind: 'inf', s: u > 0 ? 1 : -1 }; break; } }
        if(ok){ var u2 = f(u); res = (isFinite(u2) && Math.abs(u2 - u) < 1e-6) ? { kind: 'fin', v: u } : { kind: 'div' }; }
        else if(!res) res = { kind: 'div' };
      }
      suiteCleanup();
      return res;
    }
    function suiteSum(t, nat){
      var vs = suiteVals(t), c = vs.length - 1;
      if(nat.type === 'arith') return { tex: 'S_n = ' + BS + 'dfrac{(n+1)(u_0 + u_n)}{2} = ' + vtFmt((c + 1) * (vs[0] + vs[c]) / 2), n: c };
      if(nat.type === 'geo' && Math.abs(nat.q - 1) > 1e-9){ var q = nat.q; return { tex: 'S_n = u_0' + BS + 'dfrac{1 - q^{n+1}}{1 - q} = ' + vtFmt(vs[0] * (1 - Math.pow(q, c + 1)) / (1 - q)), n: c }; }
      return null;
    }

    function clearSuitePlot(){ suiteObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} }); suiteObjs = []; }
    function plotSuite(t){
      if(!ggb || !t) return;
      clearSuitePlot();
      try { ggb.deleteObject('f'); } catch(e){}
      try {
        if(suiteType === 'explicit'){
          var pts = t.filter(function(x){ return isFinite(x.v); }).map(function(x){ return '(' + x.n + ',' + x.v + ')'; });
          if(pts.length){ ggb.evalCommand('suPts={' + pts.join(',') + '}'); suiteObjs.push('suPts'); ggb.setColor('suPts', 93, 6, 186); ggb.setPointSize('suPts', 4); }
        } else {
          var plotF = (suiteFu.value || '').trim().split('u').join('x');
          ggb.evalCommand('suCurve(x)=' + plotF); suiteObjs.push('suCurve'); ggb.setColor('suCurve', 93, 6, 186);
          ggb.evalCommand('suLine(x)=x'); suiteObjs.push('suLine'); ggb.setColor('suLine', 150, 150, 150);
          var vals = suiteVals(t), web = [];
          if(vals.length){ web.push('(' + vals[0] + ',0)'); for(var k = 0; k < vals.length - 1 && k < 14; k++){ web.push('(' + vals[k] + ',' + vals[k + 1] + ')'); web.push('(' + vals[k + 1] + ',' + vals[k + 1] + ')'); } ggb.evalCommand('suWeb=Polyline({' + web.join(',') + '})'); suiteObjs.push('suWeb'); ggb.setColor('suWeb', 245, 158, 11); }
        }
