    var activeLim   = lfxInput;

    function setLOpsEnabled(on){ lopsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }

    // NB: no regex backslash escapes here — the EJS template literal would strip them.
    function infKind(p){
      var s = (p || '').trim().toLowerCase().split(' ').join('');
      if(s === '∞' || s === '+∞' || s === 'inf' || s === '+inf' || s === 'infinity' || s === '+infinity') return 1;
      if(s === '-∞' || s === '−∞' || s === '-inf' || s === '−inf' || s === '-infinity' || s === '−infinity') return -1;
      return 0;
    }
    function isInfPoint(p){ return infKind(p) !== 0; }
    function normalizePoint(p){
      var k = infKind(p);
      if(k === 1) return 'Infinity';
      if(k === -1) return '-Infinity';
      return (p || '').trim();
    }
    function isPlainNumber(s){ s = (s || '').trim(); if(s === '') return false; var n = Number(s); return isFinite(n); }
    function limitCAS(f, P, side){
      if(P === 'Infinity')  return 'Limit(' + f + ', Infinity)';
      if(P === '-Infinity') return 'Limit(' + f + ', -Infinity)';
      if(side === '+') return 'LimitAbove(' + f + ', ' + P + ')';
      if(side === '-') return 'LimitBelow(' + f + ', ' + P + ')';
      return 'Limit(' + f + ', ' + P + ')';
    }

    function limitLatex(){
      var f = (lfxInput.value || '').trim();
      var fTex = null; try { fTex = toLatex(f); } catch(e){ return null; }
      if(fTex == null) return null;
      var P = normalizePoint(lpointInput.value);
      var pTex;
      if(P === 'Infinity') pTex = '+' + BS + 'infty';
      else if(P === '-Infinity') pTex = '-' + BS + 'infty';
      else { try { pTex = toLatex(P); } catch(e){ pTex = P; } }
      var inf = (P === 'Infinity' || P === '-Infinity');
      var sup = (!inf && limSide === '+') ? '^+' : (!inf && limSide === '-') ? '^-' : '';
      return BS + 'lim_{x ' + BS + 'to ' + pTex + sup + '} ' + fTex;
    }
    function updateLimPreview(){
      var raw = (lfxInput.value || '').trim();
      if(!raw){ lPreviewEl.className='ml-preview is-empty'; lPreviewEl.textContent='Aperçu de la limite…'; return; }
      var tex = null; try { tex = limitLatex(); } catch(e){ tex = null; }
      if(tex == null){ lPreviewEl.className='ml-preview is-empty'; lPreviewEl.textContent='…en cours de saisie'; return; }
      try { katex.render(tex, lPreviewEl, { throwOnError:true, displayMode:false }); lPreviewEl.className='ml-preview'; }
      catch(e){ lPreviewEl.className='ml-preview is-empty'; lPreviewEl.textContent='…en cours de saisie'; }
    }

    function setLimSide(s){
      limSide = s;
      lsideEl.querySelectorAll('.ml-sidebtn').forEach(function(b){ b.classList.toggle('is-active', b.getAttribute('data-side') === s); });
    }
    function refreshSideButtons(){
      var inf = isInfPoint(lpointInput.value);
      lsideEl.querySelectorAll('.ml-sidebtn').forEach(function(b){ var s = b.getAttribute('data-side'); if(s === '+' || s === '-') b.disabled = inf; });
      if(inf && limSide !== '') setLimSide('');
