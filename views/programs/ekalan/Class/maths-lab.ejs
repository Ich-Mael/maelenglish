    async function runVect(){
      var rd = vcRead();
      if(rd.err){ stateEl.textContent = rd.err; return; }
      var F = rd.F, qs = Array.prototype.map.call(vcQsEl.querySelectorAll('.vc-row'), function(r){ return { type: r.querySelector('.vc-type').value, p: r.querySelector('.vc-param').value, p2: r.querySelector('.vc-param2').value }; }).filter(function(q){ return q.p.trim(); });
      if(!qs.length){ stateEl.textContent = 'Ajoutez au moins une question.'; return; }
      answerEl.innerHTML = ''; stepsEl.innerHTML = ''; setVcOpsEnabled(false);
      var R = e1Report(), body = '', sums = [];
