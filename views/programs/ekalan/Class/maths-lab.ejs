    }

    // ---- questions ----
    function vcQuestion(F, R, q, idx){
      var t = q.type, p = q.p.trim(), out = { lines: '', plain: '' }, head = '<div class="vc-q">' + (idx + 1) + ') ' + escapeHtml(VC_Q_TYPES.filter(function(x){ return x[0] === t; })[0][1]) + ' ' + escapeHtml(p) + (t === 'express' ? ' en fonction de ' + escapeHtml(q.p2) : '') + '</div>';
