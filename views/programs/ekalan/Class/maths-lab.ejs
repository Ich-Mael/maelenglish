      width: initW, height: initH,
      showToolBar: false, showAlgebraInput: false, showMenuBar: false,
      enableRightClick: false, showResetIcon: true,
      perspective: 'AG',
      appletOnLoad: function(api){ ggb = api; try { ggb.setErrorDialogsActive(false); } catch(e){} setOpsEnabled(true); setCOpsEnabled(true); setGOpsEnabled(true); setLOpsEnabled(true); setIOpsEnabled(true); setSuiteOpsEnabled(true); setProbaOpsEnabled(true); setStatsOpsEnabled(true); setDeqOpsEnabled(true); if(eqSolveBtn) eqSolveBtn.disabled = false; setEqStepsEnabled(true); fitGraph(); plot((fxInput.value||'').trim()); }
    }, true);
    applet.inject('ggb');
    updatePreview();
    updateZPreview();
    updateGeoPreview();
    updateLimPreview();
    updateIntPreview();
    updateEqPreview();
  })();
