    // Is a whitespace-separated token "maths"? strong = surely maths, weak = a single letter/number
    var OQ_ALLOWED = /^[0-9a-zA-Z+*/^().,|√²³π∞=<>≤≥≠∈ℝ→!_-]+$/;
    function oqTokKind(tok){
      if(!tok || !OQ_ALLOWED.test(tok)) return 'text';
