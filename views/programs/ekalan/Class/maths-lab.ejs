    }
    eqSolveBtn.addEventListener('click', runSolve);
    refreshDirectSolve();

    /* --- Résolution guidée pas à pas : f(z₀), racine évidente, Q(z), Q(z)=0 --- */
    var eqz0Input = document.getElementById('eqz0');
    var eqStepsEl = document.getElementById('eqsteps');
    eqz0Input.addEventListener('focus', function(){ activeZ = eqz0Input; });
    eqz0Input.addEventListener('keydown', function(ev){ if(ev.key === 'Enter'){ ev.preventDefault(); runEqStep('quotient'); } });
    function setEqStepsEnabled(on){ eqStepsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }

    // GeoGebra may print the imaginary unit as ί (U+03AF) or ⅈ (U+2148); show plain "i".
    function ggbToText(s){ return String(s == null ? '' : s).split(String.fromCharCode(0x3AF)).join('i').split(String.fromCharCode(0x2148)).join('i'); }

    // Insert explicit multiplication so GeoGebra never reads implicit products as
    // function calls — e.g. "4i(1-i)^4" → "4i*(1-i)^4" (else "i(…)" throws "Unknown command : i").
    function normCplx(s){
      s = String(s == null ? '' : s).split(String.fromCharCode(0x2212)).join('-');
      function dig(c){ return c >= '0' && c <= '9'; }
      var out = '';
      for(var k = 0; k < s.length; k++){
        var c = s.charAt(k), n = (k + 1 < s.length) ? s.charAt(k + 1) : '';
        out += c;
        if(n === '') continue;
        var ins = false;
        if(n === '(' && (dig(c) || c === ')' || c === 'i')) ins = true;        // 4( , )( , i(
        else if(c === ')' && (dig(n) || n === 'i' || n === '(')) ins = true;   // )4 , )i , )(
        else if(c === 'i' && dig(n)) ins = true;                               // i2
        if(ins) out += '*';
      }
      return out;
    }

    // Evaluate a complex expression via the graphics view (native complex support,
    // reliable even when evalCommandCAS chokes on the imaginary unit). Returns {re,im} or null.
    function evalComplex(expr){
      expr = normCplx(expr);
      var re = NaN, im = NaN;
      // real()/imaginary() handle BOTH real numbers and complex values uniformly
      // (getXcoord returns 0 for a real Number, which silently dropped real coefficients).
      try {
        ggb.evalCommand('cEvR=real(' + expr + ')');
        ggb.evalCommand('cEvI=imaginary(' + expr + ')');
        re = ggb.getValue('cEvR'); im = ggb.getValue('cEvI');
        if(!isFinite(re) || !isFinite(im)){
          ggb.evalCommand('cEvR=Real(' + expr + ')');
          ggb.evalCommand('cEvI=Imaginary(' + expr + ')');
          re = ggb.getValue('cEvR'); im = ggb.getValue('cEvI');
        }
      } catch(e){}
      try { ggb.deleteObject('cEvR'); ggb.deleteObject('cEvI'); } catch(e){}
      if(isFinite(re) && isFinite(im)) return { re: re, im: im };
      // Fallback: read as a graphics-view point (real()/imaginary() unavailable).
      re = NaN; im = NaN;
      try {
        ggb.evalCommand('cEvP=' + expr);
        re = ggb.getXcoord('cEvP'); im = ggb.getYcoord('cEvP');
        if(!isFinite(im)) im = 0;
      } catch(e){}
      try { ggb.deleteObject('cEvP'); } catch(e){}
      return (isFinite(re) && isFinite(im)) ? { re: re, im: im } : null;
    }
    function fmtComplexVal(re, im){
      function clean(x){ var r = Math.round(x * 1e6) / 1e6; if(Math.abs(r - Math.round(r)) < 1e-9) r = Math.round(r); return r; }
      re = clean(re); im = clean(im);
      if(im === 0) return String(re);
      var ia = Math.abs(im), imStr = (ia === 1 ? 'i' : (ia + 'i'));
