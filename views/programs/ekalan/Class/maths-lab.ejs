      var stops = [];
      crit.forEach(function(c){ stops.push({ kind: 'pt', x: c.x, y: c.y }); });
      poles.forEach(function(p){ stops.push({ kind: 'asym', x: p.x, leftSign: p.leftSign, rightSign: p.rightSign }); });
      stops.sort(function(a5, b5){ return a5.x - b5.x; });
      var pts = [{ x: '−∞', y: vtFmtLim(endNeg), inYn: endNeg, outYn: endNeg, kind: 'pt' }];
      stops.forEach(function(st){
        if(st.kind === 'asym'){ pts.push({ x: vtFmt(st.x), kind: 'asym', leftSign: st.leftSign, rightSign: st.rightSign, inYn: st.leftSign * 1e15, outYn: st.rightSign * 1e15 }); }
        else { var em = exMatch(st.x); pts.push({ x: (em && exClean(em.xs)) ? em.xs : vtFmt(st.x), y: (em && exClean(em.ys)) ? em.ys : vtFmt(st.y), inYn: st.y, outYn: st.y, kind: 'pt' }); }
      });
      pts.push({ x: '+∞', y: vtFmtLim(endPos), inYn: endPos, outYn: endPos, kind: 'pt' });

      var limLines = ['lim(x→−∞) f(x) = ' + vtFmtLim(endNeg)];
      poles.slice().sort(function(p1, p2){ return p1.x - p2.x; }).forEach(function(p){ limLines.push('lim(x→' + vtFmt(p.x) + '⁻) f(x) = ' + (p.leftSign > 0 ? '+∞' : '−∞') + '   ;   lim(x→' + vtFmt(p.x) + '⁺) f(x) = ' + (p.rightSign > 0 ? '+∞' : '−∞')); });
      limLines.push('lim(x→+∞) f(x) = ' + vtFmtLim(endPos));

      // ---- Render the étude report (math via KaTeX; French labels in a serif font) ----
      var kq = [], kid = 0;
      function km(latex){ var id = 'sk' + (kid++); kq.push({ id: id, latex: latex }); return '<span class="study-math" id="' + id + '"></span>'; }
      function line(label, latex, work){
        var s = '<div class="study-line">';
        if(label) s += '<span class="study-lbl">' + label + '</span> ';
        if(latex) s += km(latex);
        if(work) s += '<div class="study-work">' + km(work) + '</div>';
        return s + '</div>';
      }
      function sec(title, body){ return '<div class="study-sec"><div class="study-t">' + title + '</div><div class="study-body">' + body + '</div></div>'; }
      // Convert our unicode-math strings (∞, ∪, ≠, ;, ±superscripts…) to LaTeX.
      var IN = BS + 'infty', LIM = BS + 'lim' + BS + 'limits', TO = BS + 'to ', SEMI = BS + ',;' + BS + ',';
      function tx(s){ return String(s)
        .split('−∞').join('-' + IN).split('+∞').join('+' + IN).split('∞').join(IN)
        .split('∪').join(BS + 'cup ').split('≠').join(BS + 'neq ').split('×').join(BS + 'times ')
        .split('⁻').join('^{-}').split('⁺').join('^{+}').split('−').join('-').split(' ; ').join(SEMI); }
      function axLatex(aa){ return aa === 1 ? 'x' : (aa === -1 ? '-x' : tx(vtFmt(aa)) + 'x'); }
      function lineEqLatex(aa, bb){ var sx = axLatex(aa); if(bb > 0) sx += ' + ' + tx(vtFmt(bb)); else if(bb < 0) sx += ' - ' + tx(vtFmt(Math.abs(bb))); return sx; }

      // 1 · Domaine
      var domLatex = 'D_f = ' + tx(domain) + (excluded.length ? BS + 'quad (x ' + BS + 'neq ' + excluded.map(tx).join(', ') + ')' : '');
      var bodyDom = line('', domLatex);
      // 2 · Parité
      var bodyPar = par ? '<div class="study-line"><span class="study-lbl">f est <strong>' + par + '</strong>'
        + (par === 'paire' ? ' — courbe symétrique par rapport à l\\'axe des ordonnées.' : (par === 'impaire' ? ' — courbe symétrique par rapport à l\\'origine.' : '.')) + '</span></div>' : '';
      // 3 · Limites et asymptotes
      var bodyAsym = '';
      poles.slice().sort(function(p1, p2){ return p1.x - p2.x; }).forEach(function(p){ bodyAsym += line('Asymptote verticale :', 'x = ' + tx(vtFmt(p.x))); });
      [{ s: -1, lbl: '−∞', sL: '-' + IN, end: endNeg }, { s: 1, lbl: '+∞', sL: '+' + IN, end: endPos }].forEach(function(o){
        var inf = !isFinite(o.end) || Math.abs(o.end) > 1e8, ob = oblique(o.s);
        if(inf && ob && Math.abs(ob.a) > 1e-9){
          var work = 'a = ' + LIM + '_{x ' + TO + o.sL + '}' + BS + 'dfrac{f(x)}{x} = ' + tx(vtFmt(ob.a))
            + ' ' + BS + 'quad b = ' + LIM + '_{x ' + TO + o.sL + '}' + BS + 'big(f(x) - ' + axLatex(ob.a) + BS + 'big) = ' + tx(vtFmt(ob.b));
          bodyAsym += line('Asymptote oblique en ' + o.lbl + ' :', 'y = ' + lineEqLatex(ob.a, ob.b), work);
        } else if(!inf && ob) bodyAsym += line('Asymptote horizontale en ' + o.lbl + ' :', 'y = ' + tx(vtFmt(o.end)));
        else if(inf) bodyAsym += '<div class="study-line"><span class="study-lbl">Branche parabolique en ' + o.lbl + ' (pas d\\'asymptote linéaire).</span></div>';
      });
      bodyAsym += '<hr class="study-hr">';
      bodyAsym += line('', LIM + '_{x ' + TO + '-' + IN + '} f(x) = ' + tx(vtFmtLim(endNeg)));
      poles.slice().sort(function(p1, p2){ return p1.x - p2.x; }).forEach(function(p){
        bodyAsym += line('', LIM + '_{x ' + TO + tx(vtFmt(p.x)) + '^{-}} f(x) = ' + (p.leftSign > 0 ? '+' + IN : '-' + IN)
          + ' ' + BS + 'qquad ' + LIM + '_{x ' + TO + tx(vtFmt(p.x)) + '^{+}} f(x) = ' + (p.rightSign > 0 ? '+' + IN : '-' + IN));
      });
      bodyAsym += line('', LIM + '_{x ' + TO + '+' + IN + '} f(x) = ' + tx(vtFmtLim(endPos)));
      // 4 · Dérivée
      var fpLatex = ''; if(fp){ try { fpLatex = toLatex(fp.split(' ').join('')); } catch(e){ fpLatex = ''; } }
      var bodyDer = fp ? line('', "f'(x) = " + (fpLatex || (BS + 'text{' + fp + '}'))) : '<div class="study-line"><span class="study-lbl">Voir le signe dans le tableau ci-dessous.</span></div>';
      // 6 · Points caractéristiques
      var bodyPts = '';
      if(y0 !== null) bodyPts += line('Ordonnée à l\\'origine :', 'f(0) = ' + tx(y0));
      if(roots.length) bodyPts += line('Intersections avec (Ox) :', 'x = ' + roots.map(function(r){ return tx(vtFmt(r)); }).join(' ' + BS + ';;' + BS + '; '));
      else bodyPts += '<div class="study-line"><span class="study-lbl">Pas d\\'intersection simple avec (Ox) détectée.</span></div>';

      var report = '<div class="ml-study"><div class="study-head"><i class="bi bi-clipboard2-data"></i> Étude complète — <span id="study-fx">f(x) = ' + escapeHtml(expr) + '</span></div>'
        + sec('1 · Domaine de définition', bodyDom)
        + (bodyPar ? sec('2 · Parité', bodyPar) : '')
        + sec('3 · Limites et asymptotes', bodyAsym)
        + sec('4 · Dérivée', bodyDer)
        + '<div class="study-sec"><div class="study-t">5 · Tableau de variation</div>' + variationTableHTML(pts, '', {}) + '</div>'
        + sec('6 · Points caractéristiques', bodyPts)
        + '</div>';
      answerEl.innerHTML = report;
      try { var fxEl = document.getElementById('study-fx'); if(fxEl) renderKatex(fxEl, 'f(x) = ' + toLatex(expr)); } catch(e){}
      kq.forEach(function(it){ var el = document.getElementById(it.id); if(el){ try { renderKatex(el, it.latex); } catch(e){} } });
      stateEl.innerHTML = '<span class="ml-spinner"></span> Rédaction de l\\'étude…';

      // ---- Anchored summary for Claude ----
      var parts = ['Df = ' + domain];
      if(par) parts.push('parité : ' + par);
      if(asymLines.length) parts.push('asymptotes : ' + asymLines.join(' ; '));
      parts.push('limites : ' + vtFmtLim(endNeg) + ' en −∞, ' + vtFmtLim(endPos) + ' en +∞');
      if(fp) parts.push("f'(x) = " + fp);
      if(crit.length) parts.push('extrema : ' + crit.map(function(c){ return 'x=' + vtFmt(c.x) + ' (f=' + vtFmt(c.y) + ')'; }).join(', '));
      if(y0 !== null) parts.push('f(0) = ' + y0);
      if(roots.length) parts.push('racines : ' + roots.map(vtFmt).join(', '));
      var summary = parts.join(' ; ').slice(0, 490);

      try {
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ function: expr, operation: 'study', casResult: summary }) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){ stateEl.textContent = 'Connexion impossible — réessayez.'; }
      finally { setOpsEnabled(true); }
    }

    /* ---- Tangente en x₀ ---- */
    async function runTangent(){
      var expr = (fxInput.value || '').trim();
      if(!expr){ stateEl.textContent = 'Saisissez une fonction.'; return; }
      if(!ggb){ return; }
      var x0s = (document.getElementById('tanx0').value || '').trim();
      if(!x0s){ stateEl.textContent = 'Indiquez le point x₀.'; return; }
      plot(expr);
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul de la tangente…';
      setOpsEnabled(false);

      function ev(c){ try { ggb.evalCommand(c); return true; } catch(e){ return false; } }
      function gv(l){ try { return ggb.getValue(l); } catch(e){ return NaN; } }
      ev('vtArg=0'); ev('vtRes=f(vtArg)');
      function fAt(x){ ev('SetValue(vtArg,' + x + ')'); return gv('vtRes'); }
      var x0 = Number(x0s);
      if(!isFinite(x0)){ if(ev('vtX0=' + x0s)){ x0 = gv('vtX0'); try { ggb.deleteObject('vtX0'); } catch(e){} } }
      if(!isFinite(x0)){ stateEl.textContent = 'Point x₀ invalide.'; try { ggb.deleteObject('vtRes'); ggb.deleteObject('vtArg'); } catch(e){} setOpsEnabled(true); return; }
      var y0 = fAt(x0);
      if(!isFinite(y0)){ stateEl.textContent = "f n'est pas définie en x₀ = " + vtFmt(x0) + '.'; try { ggb.deleteObject('vtRes'); ggb.deleteObject('vtArg'); } catch(e){} setOpsEnabled(true); return; }
      var h = 1e-5, m = (fAt(x0 + h) - fAt(x0 - h)) / (2 * h);
      try { ggb.deleteObject('vtRes'); ggb.deleteObject('vtArg'); } catch(e){}
      // snap to clean values for display
      function sn(v){ var r = Math.round(v * 1e4) / 1e4; if(Math.abs(r - Math.round(r)) < 1e-3) r = Math.round(r); return r; }
      m = sn(m); y0 = sn(y0); var bb = sn(y0 - m * x0);
      // plot tangent + point
      try { ggb.deleteObject('TLine'); } catch(e){}
      try { ggb.deleteObject('TPt'); } catch(e){}
      try { ggb.evalCommand('TLine: y = ' + m + '*(x - ' + x0 + ') + ' + y0); ggb.setColor('TLine', 245, 158, 11); ggb.setLineThickness('TLine', 4); } catch(e){}
      try { ggb.evalCommand('TPt = (' + x0 + ', ' + y0 + ')'); ggb.setColor('TPt', 93, 6, 186); ggb.setPointSize('TPt', 5); } catch(e){}

      function lineEqL(a2, b2){ var sx = a2 === 1 ? 'x' : (a2 === -1 ? '-x' : vtFmt(a2) + 'x'); if(b2 > 0) sx += ' + ' + vtFmt(b2); else if(b2 < 0) sx += ' - ' + vtFmt(Math.abs(b2)); else if(a2 === 0) sx = vtFmt(b2); return sx; }
      var eqStr = 'y = ' + lineEqL(m, bb);
      answerEl.innerHTML = '<div class="ml-answer"><div class="lbl"><i class="bi bi-rulers"></i> Tangente en x₀ = ' + escapeHtml(vtFmt(x0)) + '</div>'
        + '<div class="val" id="tan-eq"></div>'
        + '<div class="vt-deriv" id="tan-det"></div></div>';
      try { renderKatex(document.getElementById('tan-eq'), eqStr); } catch(e){}
      try { renderKatex(document.getElementById('tan-det'), "f(" + vtFmt(x0) + ") = " + vtFmt(y0) + " " + BS + "qquad f'(" + vtFmt(x0) + ") = " + vtFmt(m)); } catch(e){}
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';

      try {
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ function: expr, operation: 'tangent', x0: x0s, casResult: eqStr }) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){ stateEl.textContent = 'Connexion impossible — réessayez.'; }
      finally { setOpsEnabled(true); }
    }

    /* ---- Convexité / points d'inflexion (f'') ---- */
    async function runConvexity(){
      var expr = (fxInput.value || '').trim();
      if(!expr){ stateEl.textContent = 'Saisissez une fonction.'; return; }
      if(!ggb){ return; }
      plot(expr);
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Étude de la convexité…';
      setOpsEnabled(false);

      // f''(x) symbolic (for display) via the JS differentiator, twice.
      var fpp = '';
      try { var ast = dxParse(dxTok(expr)); if(ast){ var d2 = dxDiff(dxDiff(ast)); if(d2){ d2 = dxSimp(dxSimp(dxSimp(d2))); var s2 = dxPretty(d2); if(s2 && s2.indexOf('?') < 0) fpp = s2; } } } catch(e){}

      function ev(c){ try { ggb.evalCommand(c); return true; } catch(e){ return false; } }
      function gv(l){ try { return ggb.getValue(l); } catch(e){ return NaN; } }
      ev('vtArg=0'); ev('vtRes=f(vtArg)');
      function fAt(x){ ev('SetValue(vtArg,' + x + ')'); return gv('vtRes'); }
      var hh = 1e-3;
      function f2(x){ var a = fAt(x - hh), b = fAt(x), c = fAt(x + hh); if(!isFinite(a) || !isFinite(b) || !isFinite(c)) return NaN; return (a - 2 * b + c) / (hh * hh); }
      function snap(x){ return Math.abs(x - Math.round(x)) < 1e-4 ? Math.round(x) : x; }

      var LO = -50, HI = 50, N = 800, step = (HI - LO) / N;
      var s2v = []; for(var i = 0; i <= N; i++) s2v[i] = f2(LO + i * step);
      // inflection points: f'' changes sign between two FINITE, moderate samples (not a pole).
      // Bracket from the last definite-sign sample (handles f''=0 landing on a grid point).
      var infl = [], lastSign = 0, prevIdx = 0;
      for(var j = 1; j <= N; j++){
        var a = s2v[j - 1], b = s2v[j];
        if(!isFinite(a) || !isFinite(b) || Math.abs(a) > 1e6 || Math.abs(b) > 1e6){ lastSign = 0; continue; }
        var sg = b > 1e-9 ? 1 : (b < -1e-9 ? -1 : 0);
        if(sg !== 0){
          if(lastSign !== 0 && sg !== lastSign){
            var xa = LO + prevIdx * step, xb = LO + j * step, fa = s2v[prevIdx];
            for(var it = 0; it < 44; it++){ var mx = (xa + xb) / 2, fm = f2(mx); if(!isFinite(fm)){ xb = mx; continue; } if((fa < 0) !== (fm < 0)) xb = mx; else { xa = mx; fa = fm; } }
            var rx = snap((xa + xb) / 2);
            var yr = fAt(rx);
            if(isFinite(yr) && !infl.some(function(p){ return Math.abs(p.x - rx) < 1e-2; })) infl.push({ x: rx, y: snap(yr) });
          }
          lastSign = sg; prevIdx = j;
        }
      }
      if(infl.length > 8) infl = infl.slice(0, 8);
      try { ggb.deleteObject('vtRes'); ggb.deleteObject('vtArg'); } catch(e){}

      // Convexity intervals between consecutive inflection points (sample the midpoint sign).
      var cuts = infl.map(function(p){ return p.x; }).sort(function(a, b){ return a - b; });
      ev('vtArg=0'); ev('vtRes=f(vtArg)');
      var bounds = [-Infinity].concat(cuts).concat([Infinity]), convLines = [];
      for(var s = 0; s < bounds.length - 1; s++){
        var L = bounds[s], R = bounds[s + 1];
        var mid = (isFinite(L) && isFinite(R)) ? (L + R) / 2 : (isFinite(L) ? L + 1 : (isFinite(R) ? R - 1 : 0));
        var v = f2(mid); if(!isFinite(v) || v === 0) continue;
        var lo = isFinite(L) ? vtFmt(L) : '-∞', hi = isFinite(R) ? vtFmt(R) : '+∞';
        convLines.push({ conv: v > 0, lo: lo, hi: hi });
      }
      try { ggb.deleteObject('vtRes'); ggb.deleteObject('vtArg'); } catch(e){}

      // Render (KaTeX; BS for backslashes)
      var IN2 = BS + 'infty', SEMI2 = BS + ',;' + BS + ',';
      function tx2(s){ return String(s).split('-∞').join('-' + IN2).split('+∞').join('+' + IN2).split('−').join('-'); }
      var kq = [], kid = 0;
      function km(latex){ var id = 'cvk' + (kid++); kq.push({ id: id, latex: latex }); return '<span class="study-math" id="' + id + '"></span>'; }
      function line(label, latex){ var s = '<div class="study-line">'; if(label) s += '<span class="study-lbl">' + label + '</span> '; if(latex) s += km(latex); return s + '</div>'; }
      var body = '';
      if(fpp){ var fppL = ''; try { fppL = toLatex(fpp.split(' ').join('')); } catch(e){ fppL = ''; } body += line('', "f''(x) = " + (fppL || (BS + 'text{' + fpp + '}'))); }
      if(!convLines.length) body += '<div class="study-line"><span class="study-lbl">f a une convexité constante sur son domaine.</span></div>';
      convLines.forEach(function(c){ body += line(c.conv ? 'f est convexe sur' : 'f est concave sur', ']' + tx2(c.lo) + SEMI2 + tx2(c.hi) + '['); });
      infl.forEach(function(p){ body += line('Point d\\'inflexion :', 'x = ' + tx2(vtFmt(p.x)) + ', ' + BS + 'quad f(x) = ' + tx2(vtFmt(p.y))); });

      answerEl.innerHTML = '<div class="ml-study" style="padding:.9rem 1.1rem"><div class="study-head"><i class="bi bi-graph-up-arrow"></i> Convexité &amp; points d\\'inflexion</div><div class="study-body">' + body + '</div></div>';
      kq.forEach(function(it){ var el = document.getElementById(it.id); if(el){ try { renderKatex(el, it.latex); } catch(e){} } });
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';

      var parts = [];
      if(fpp) parts.push("f''(x) = " + fpp);
      convLines.forEach(function(c){ parts.push((c.conv ? 'convexe' : 'concave') + ' sur ]' + c.lo + ';' + c.hi + '['); });
      if(infl.length) parts.push('inflexion : ' + infl.map(function(p){ return 'x=' + vtFmt(p.x) + ' (f=' + vtFmt(p.y) + ')'; }).join(', '));
      var summary = parts.join(' ; ').slice(0, 480) || 'convexité constante';

      try {
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ function: expr, operation: 'convexity', casResult: summary }) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){ stateEl.textContent = 'Connexion impossible — réessayez.'; }
      finally { setOpsEnabled(true); }
    }

    opsEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return;
      var op = btn.getAttribute('data-op');
      if(op === 'study'){ runStudy(); return; }
      if(op === 'variations'){ runVariation(); return; }
      if(op === 'domain'){ runDomain(); return; }
      if(op === 'tangent'){ runTangent(); return; }
      if(op === 'convexity'){ runConvexity(); return; }
      if(op === 'limit'){ fnLimitPanel.hidden = !fnLimitPanel.hidden; if(!fnLimitPanel.hidden){ refreshSideButtons(); updateLimPreview(); lpointInput.focus(); } btn.classList.toggle('is-open', !fnLimitPanel.hidden); return; }
      run(op);
    });

    // Manual "Tracer" — redraw the curve from the current input.
    function doPlot(){
      updatePreview();
      var expr = (fxInput.value || '').trim();
      if(!expr){ stateEl.textContent = 'Saisissez une fonction.'; return; }
      if(!ggb){ return; }
      plot(expr);
      stateEl.textContent = '';
    }
    plotBtn.addEventListener('click', doPlot);
    fxInput.addEventListener('keydown', function(ev){ if(ev.key === 'Enter'){ ev.preventDefault(); doPlot(); } });

    /* ============ NOMBRES COMPLEXES (complex mode) ============ */
    var modesEl   = document.getElementById('modes');
    var modeFunc  = document.getElementById('mode-function');
    var modeCplx  = document.getElementById('mode-complex');
    var graphTitle= document.getElementById('graph-title');
    var graphHint = document.getElementById('graph-hint');
    var z1Input   = document.getElementById('z1');
    var z2Input   = document.getElementById('z2');
    var cnInput   = document.getElementById('cn');
    var z2Row     = document.getElementById('z2-row');
    var z1Label   = document.getElementById('z1-label');
    var nRow      = document.getElementById('n-row');
    var zPreviewEl= document.getElementById('zPreview');
    var ckeysEl   = document.getElementById('ckeys');
    var copsEl    = document.getElementById('cops');
    var activeZ   = z1Input;
    var currentMode = 'function', lastToolMode = 'function';
    var spacesEl = document.getElementById('ml-spaces');
    var complexObjs = [];

    function setCOpsEnabled(on){ copsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }

    // Single operand "z" by default; binary ops (z₁∘z₂) reveal z₂ and relabel z₁.
    function setComplexArity(binary){
      z2Row.hidden = !binary;
      if(z1Label) z1Label.textContent = binary ? 'z₁ =' : 'z =';
      updateZPreview();
    }

    function updateZPreview(){
      var raw = (z1Input.value || '').trim();
      if(!raw){ zPreviewEl.className='ml-preview is-empty'; zPreviewEl.textContent='Aperçu du nombre complexe…'; return; }
      var latex = null;
      try { latex = toLatex(raw); } catch(e){ latex = null; }
      if(latex == null){ zPreviewEl.className='ml-preview is-empty'; zPreviewEl.textContent='…en cours de saisie'; return; }
      var binary = !z2Row.hidden;
      var tex = (binary ? 'z_1' : 'z') + ' = ' + latex;
      if(binary){
        var raw2 = (z2Input.value || '').trim();
        if(raw2){ var l2 = null; try { l2 = toLatex(raw2); } catch(e){ l2 = null; } if(l2 != null) tex += BS + 'quad z_2 = ' + l2; }
      }
      try { katex.render(tex, zPreviewEl, { throwOnError:true, displayMode:false }); zPreviewEl.className='ml-preview'; }
      catch(e){ zPreviewEl.className='ml-preview is-empty'; zPreviewEl.textContent='…en cours de saisie'; }
    }

    [z1Input, z2Input].forEach(function(inp){
      inp.addEventListener('focus', function(){ activeZ = inp; });
      inp.addEventListener('input', updateZPreview);
    });

    function insertInto(inp, tok){
      var val = inp.value, s = inp.selectionStart, e = inp.selectionEnd;
      if(s == null){ s = e = val.length; }
      var caret = tok.indexOf('|'); var clean = tok.replace('|','');
      inp.value = val.slice(0, s) + clean + val.slice(e);
      var pos = s + (caret >= 0 ? caret : clean.length);
      inp.focus(); inp.setSelectionRange(pos, pos);
    }
    ckeysEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-key'); if(!btn) return;
      var inp = activeZ || z1Input;
      var act = btn.getAttribute('data-cact');
      if(act === 'clear'){ inp.value=''; inp.focus(); }
      else if(act === 'back'){
        var v=inp.value, s=inp.selectionStart, e=inp.selectionEnd;
        if(s == null){ inp.value = v.slice(0,-1); }
        else if(s !== e){ inp.value = v.slice(0,s)+v.slice(e); inp.setSelectionRange(s,s); }
        else if(s > 0){ inp.value = v.slice(0,s-1)+v.slice(s); inp.setSelectionRange(s-1,s-1); }
        inp.focus();
      }
      else { insertInto(inp, btn.getAttribute('data-cins')); }
      updateZPreview();
    });

    // Canonical expression (cache key + sent to server)
    function complexExpr(op, z1, z2, n, arith){
      switch(op){
        case 'power':      return '(' + z1 + ')^' + n;
        case 'arithmetic':
          var sym = arith==='sum' ? '+' : arith==='product' ? '*' : '/';
          return '(' + z1 + ')' + sym + '(' + z2 + ')';
        default:           return z1;
      }
    }
    // GeoGebra CAS command for the operation (exp_form handled separately)
    function complexCAS(op, z1, z2, n, arith){
      var Z = '(' + z1 + ')';
      switch(op){
        case 'modulus':   return 'abs(' + Z + ')';
        case 'argument':  return 'arg(' + Z + ')';
        case 'conjugate': return 'Conjugate(' + Z + ')';
        case 'power':     return Z + '^(' + n + ')';
        case 'nth_roots': return 'CSolutions(x^(' + n + ')=' + Z + ', x)';
        case 'arithmetic':
          var sym = arith==='sum' ? '+' : arith==='product' ? '*' : '/';
          return Z + sym + '(' + z2 + ')';
        default: return null;
      }
    }

    function clearComplexPlot(){
      complexObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} });
      complexObjs = [];
    }
    function defObj(name, cmd){ try { ggb.evalCommand(name + '=' + cmd); complexObjs.push(name); } catch(e){} }
    function colour(name, r, g, b){ try { ggb.setColor(name, r, g, b); } catch(e){} }

    // Argand diagram: plot z₁ (+ vector from origin) and any result point(s).
    function plotComplex(op, z1, z2, n, arith){
      if(!ggb) return;
      clearComplexPlot();
      try { ggb.deleteObject('f'); } catch(e){}
      defObj('z_1', '(' + z1 + ')');
      defObj('v_1', 'Vector(z_1)');
      colour('z_1', 93, 6, 186); colour('v_1', 93, 6, 186);
      if(op === 'arithmetic'){
        defObj('z_2', '(' + z2 + ')');
        var sym = arith==='sum' ? '+' : arith==='product' ? '*' : '/';
        defObj('z_3', '(' + z1 + ')' + sym + '(' + z2 + ')');
        colour('z_2', 168, 85, 247); colour('z_3', 255, 184, 0);
      } else if(op === 'conjugate'){
        defObj('z_c', '(x(z_1), -y(z_1))'); colour('z_c', 255, 184, 0);
      } else if(op === 'power'){
        defObj('z_p', 'z_1^(' + n + ')'); colour('z_p', 255, 184, 0);
      } else if(op === 'nth_roots'){
        defObj('R', 'CSolutions(x^(' + n + ')=z_1, x)'); colour('R', 255, 184, 0);
      }
      fitComplex();
    }

    // Fit the view around the origin + every plotted point (stable API, no ZoomFit command).
    function fitComplex(){
      var xs = [0], ys = [0];
      complexObjs.forEach(function(nm){
        try {
          var x = ggb.getXcoord(nm), y = ggb.getYcoord(nm);
          if(isFinite(x) && isFinite(y) && !(x === 0 && y === 0)){ xs.push(x); ys.push(y); }
        } catch(e){}
      });
      var minX = Math.min.apply(null, xs), maxX = Math.max.apply(null, xs);
      var minY = Math.min.apply(null, ys), maxY = Math.max.apply(null, ys);
      var padX = Math.max(2, (maxX - minX) * 0.25), padY = Math.max(2, (maxY - minY) * 0.25);
      try { ggb.setCoordSystem(minX - padX, maxX + padX, minY - padY, maxY + padY); } catch(e){}
    }

    async function runComplex(op, arith, needs){
      var z1 = (z1Input.value || '').trim();
      if(!z1){ stateEl.textContent = 'Saisissez z₁.'; return; }
      if(needs === 'z2'){ z2Row.hidden = false; }
      if(needs === 'n'){ nRow.hidden = false; }
      var z2 = (z2Input.value || '').trim();
      var n  = parseInt(cnInput.value, 10);
      if(needs === 'z2' && !z2){ stateEl.textContent = 'Saisissez z₂.'; z2Input.focus(); return; }
      if(needs === 'n' && !(n >= 2 && n <= 12)){ stateEl.textContent = 'n doit être un entier entre 2 et 12.'; cnInput.focus(); return; }
      if(!ggb){ return; }

      var gz1 = normCplx(z1), gz2 = normCplx(z2); // GeoGebra-safe (explicit multiplication)
      plotComplex(op, gz1, gz2, n, arith);
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul en cours…';
      setCOpsEnabled(false);

      var casResult = '';
      try {
        if(op === 'exp_form'){
          var r  = ggb.evalCommandCAS('abs((' + gz1 + '))');
          var th = ggb.evalCommandCAS('arg((' + gz1 + '))');
          if(r && th){ casResult = r + '*e^(i*(' + th + ')) = ' + r + '*(cos(' + th + ') + i*sin(' + th + '))'; }
        } else if(op === 'algebraic_form'){
          var v = evalComplex('(' + gz1 + ')'); // reliable real/imag extraction
          if(v){ casResult = fmtComplexVal(v.re, v.im); }
        } else if(op === 'conjugate'){
          var vc = evalComplex('(' + gz1 + ')'); // conjugate = a − bi (no GeoGebra Conjugate command)
          if(vc){ casResult = fmtComplexVal(vc.re, -vc.im); }
        } else if(op === 'trig_form'){
          var rt = ggb.evalCommandCAS('abs((' + gz1 + '))');
          var tt = ggb.evalCommandCAS('arg((' + gz1 + '))');
          if(rt && tt){ casResult = rt + '*(cos(' + tt + ') + i*sin(' + tt + '))'; }
        } else {
          var cmd = complexCAS(op, gz1, gz2, n, arith);
          if(cmd){ casResult = ggb.evalCommandCAS(cmd); }
        }
      } catch(e){ casResult = ''; }
      if(!casResult){ stateEl.textContent = "Impossible de calculer — vérifiez l'écriture (ex : 3+4i)."; setCOpsEnabled(true); return; }

      answerEl.innerHTML = '<div class="ml-answer"><div class="lbl"><i class="bi bi-stars"></i> Résultat</div><div class="val">' + escapeHtml(casResult) + '</div></div>';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';

      var payload = { domain:'complex', operation: op, expression: complexExpr(op, z1, z2, n, arith), casResult: casResult };
      if(op === 'arithmetic'){ payload.z2 = z2; payload.arithOp = arith; }
      if(op === 'power' || op === 'nth_roots'){ payload.n = n; }

      try {
        var resp = await fetch(EXPLAIN_URL, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify(payload)
        });
        var data = await resp.json();
        if(data.ok){ showSteps(data); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){
        stateEl.textContent = 'Connexion impossible — réessayez.';
      } finally {
        setCOpsEnabled(true);
      }
    }

    copsEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return;
      setComplexArity(btn.getAttribute('data-needs') === 'z2');
      runComplex(btn.getAttribute('data-cop'), btn.getAttribute('data-arith'), btn.getAttribute('data-needs'));
    });

    /* --- Équation polynomiale dans ℂ : a z^3 + b z^2 + c z + d = 0 --- */
    var eqaInput = document.getElementById('eqa');
    var eqbInput = document.getElementById('eqb');
    var eqcInput = document.getElementById('eqc');
    var eqdInput = document.getElementById('eqd');
    var eqPreviewEl = document.getElementById('eqPreview');
    var eqSolveBtn = document.getElementById('eq-solve');
    var eqInputs = [eqaInput, eqbInput, eqcInput, eqdInput];

    eqInputs.forEach(function(inp){
      inp.addEventListener('focus', function(){ activeZ = inp; });
      inp.addEventListener('input', updateEqPreview);
      inp.addEventListener('keydown', function(ev){ if(ev.key === 'Enter'){ ev.preventDefault(); runSolve(); } });
    });

    function eqLatex(){
      var tex = [];
      for(var i = 0; i < 4; i++){
        var raw = (eqInputs[i].value || '').trim() || '0';
        try { tex.push(toLatex(raw)); } catch(e){ return null; }
      }
      return '(' + tex[0] + ') z^3 + (' + tex[1] + ') z^2 + (' + tex[2] + ') z + (' + tex[3] + ') = 0';
    }
    function updateEqPreview(){
      var tex = null; try { tex = eqLatex(); } catch(e){ tex = null; }
      if(tex == null){ eqPreviewEl.className = 'ml-preview is-empty'; eqPreviewEl.textContent = '…en cours de saisie'; return; }
      try { katex.render(tex, eqPreviewEl, { throwOnError:true, displayMode:false }); eqPreviewEl.className = 'ml-preview'; }
      catch(e){ eqPreviewEl.className = 'ml-preview is-empty'; eqPreviewEl.textContent = '…en cours de saisie'; }
    }
    function buildEquation(){
      var a = (eqaInput.value || '').trim() || '0';
      var b = (eqbInput.value || '').trim() || '0';
      var c = (eqcInput.value || '').trim() || '0';
      var d = (eqdInput.value || '').trim() || '0';
      return '(' + a + ')*z^3 + (' + b + ')*z^2 + (' + c + ')*z + (' + d + ')';
    }

    // Shown only for degree ≤ 2 (a = 0). Solved with the reliable JS quadratic formula.
    function eqIsCubic(){ return !cIsZero(coefVal(eqaInput.value)); }
    function refreshDirectSolve(){
      var cubic = eqIsCubic();
      document.getElementById('eq-direct-row').hidden = cubic;
      document.getElementById('eq-cubic-hint').hidden = !cubic;
    }
    eqaInput.addEventListener('input', refreshDirectSolve);

    async function runSolve(){
      if(eqIsCubic()){ return; } // direct solve is for degree ≤ 2 only
      var b = (eqbInput.value || '').trim(), c = (eqcInput.value || '').trim(), d = (eqdInput.value || '').trim();
      if(!ggb){ return; }
      var qb = coefVal(eqbInput.value), qc = coefVal(eqcInput.value), qd = coefVal(eqdInput.value);
      if(cIsZero(qb) && cIsZero(qc)){ stateEl.textContent = 'Renseignez au moins le coefficient b ou c (équation en z).'; return; }

      clearComplexPlot(); try { ggb.deleteObject('f'); } catch(e){}
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Résolution en cours…';
      eqSolveBtn.disabled = true; setCOpsEnabled(false);

      var roots = solveQuad(qb, qc, qd); // numeric, for plotting
      var exact = exactQuadRoots(qb, qc, qd); // exact with √, if integer coeffs
      var rootStrs = exact || roots.map(function(r){ return fmtComplexVal(r.re, r.im); });
      var casResult = rootStrs.length ? ('{' + rootStrs.join(', ') + '}') : '';
      if(!casResult){ stateEl.textContent = 'Impossible de résoudre — vérifiez les coefficients.'; eqSolveBtn.disabled = false; setCOpsEnabled(true); return; }

      // Plot the roots on the Argand plane.
      roots.forEach(function(r, idx){ var nm = 'rqs' + (idx + 1); defObj(nm, '(' + r.re + ',' + r.im + ')'); colour(nm, 255, 184, 0); });

      setEqAnswer('Solutions dans ℂ', casResult);
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';

      var expr = '(' + (b || '0') + ')*z^2 + (' + (c || '0') + ')*z + (' + (d || '0') + ')';
      try {
        var resp = await fetch(EXPLAIN_URL, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ domain:'complex', operation:'solve_poly', expression: expr, casResult: casResult })
        });
        var data = await resp.json();
        if(data.ok){ showSteps(data); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){
        stateEl.textContent = 'Connexion impossible — réessayez.';
      } finally {
        setEqAnswer('Solutions dans ℂ', casResult); // authoritative computed roots
        eqSolveBtn.disabled = false; setCOpsEnabled(true);
      }
    }
    eqSolveBtn.addEventListener('click', runSolve);
    refreshDirectSolve();

    /* --- Résolution guidée pas à pas : f(z₀), racine évidente, Q(z), Q(z)=0 --- */
    var eqz0Input = document.getElementById('eqz0');
    var eqStepsEl = document.getElementById('eqsteps');
    eqz0Input.addEventListener('focus', function(){ activeZ = eqz0Input; });
    eqz0Input.addEventListener('keydown', function(ev){ if(ev.key === 'Enter'){ ev.preventDefault(); runEqStep('quotient'); } });
    function setEqStepsEnabled(on){ eqStepsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }

    // GeoGebra may print the imaginary unit as ί (U+03AF) or ⅈ (U+2148); show plain "i".
    function ggbToText(s){ return String(s == null ? '' : s).split(String.fromCharCode(0x3AF)).join('i').split(String.fromCharCode(0x2148)).join('i'); }

    // Insert explicit multiplication so GeoGebra never reads implicit products as
    // function calls — e.g. "4i(1-i)^4" → "4i*(1-i)^4" (else "i(…)" throws "Unknown command : i").
    function normCplx(s){
      s = String(s == null ? '' : s).split(String.fromCharCode(0x2212)).join('-');
      function dig(c){ return c >= '0' && c <= '9'; }
      var out = '';
      for(var k = 0; k < s.length; k++){
        var c = s.charAt(k), n = (k + 1 < s.length) ? s.charAt(k + 1) : '';
        out += c;
        if(n === '') continue;
        var ins = false;
        if(n === '(' && (dig(c) || c === ')' || c === 'i')) ins = true;        // 4( , )( , i(
        else if(c === ')' && (dig(n) || n === 'i' || n === '(')) ins = true;   // )4 , )i , )(
        else if(c === 'i' && dig(n)) ins = true;                               // i2
        if(ins) out += '*';
      }
      return out;
    }

    // Evaluate a complex expression via the graphics view (native complex support,
    // reliable even when evalCommandCAS chokes on the imaginary unit). Returns {re,im} or null.
    function evalComplex(expr){
      expr = normCplx(expr);
      var re = NaN, im = NaN;
      // real()/imaginary() handle BOTH real numbers and complex values uniformly
      // (getXcoord returns 0 for a real Number, which silently dropped real coefficients).
      try {
        ggb.evalCommand('cEvR=real(' + expr + ')');
        ggb.evalCommand('cEvI=imaginary(' + expr + ')');
        re = ggb.getValue('cEvR'); im = ggb.getValue('cEvI');
        if(!isFinite(re) || !isFinite(im)){
          ggb.evalCommand('cEvR=Real(' + expr + ')');
          ggb.evalCommand('cEvI=Imaginary(' + expr + ')');
          re = ggb.getValue('cEvR'); im = ggb.getValue('cEvI');
        }
      } catch(e){}
      try { ggb.deleteObject('cEvR'); ggb.deleteObject('cEvI'); } catch(e){}
      if(isFinite(re) && isFinite(im)) return { re: re, im: im };
      // Fallback: read as a graphics-view point (real()/imaginary() unavailable).
      re = NaN; im = NaN;
      try {
        ggb.evalCommand('cEvP=' + expr);
        re = ggb.getXcoord('cEvP'); im = ggb.getYcoord('cEvP');
        if(!isFinite(im)) im = 0;
      } catch(e){}
      try { ggb.deleteObject('cEvP'); } catch(e){}
      return (isFinite(re) && isFinite(im)) ? { re: re, im: im } : null;
    }
    function fmtComplexVal(re, im){
      function clean(x){ var r = Math.round(x * 1e6) / 1e6; if(Math.abs(r - Math.round(r)) < 1e-9) r = Math.round(r); return r; }
      re = clean(re); im = clean(im);
      if(im === 0) return String(re);
      var ia = Math.abs(im), imStr = (ia === 1 ? 'i' : (ia + 'i'));
      if(re === 0) return (im < 0 ? '-' : '') + imStr;
      return re + (im < 0 ? ' - ' : ' + ') + imStr;
    }
    // Pure-JS complex arithmetic — used for synthetic division & the quadratic formula,
    // because evalCommandCAS (Div/Simplify) is unreliable with the imaginary unit.
    function cAdd(p, q){ return { re: p.re + q.re, im: p.im + q.im }; }
    function cSub(p, q){ return { re: p.re - q.re, im: p.im - q.im }; }
    function cMul(p, q){ return { re: p.re * q.re - p.im * q.im, im: p.re * q.im + p.im * q.re }; }
    function cDiv(p, q){ var d = q.re * q.re + q.im * q.im; return { re: (p.re * q.re + p.im * q.im) / d, im: (p.im * q.re - p.re * q.im) / d }; }
    function cSqrt(w){ var m = Math.hypot(w.re, w.im); var re = Math.sqrt(Math.max(0, (m + w.re) / 2)); var im = Math.sqrt(Math.max(0, (m - w.re) / 2)); if(w.im < 0) im = -im; return { re: re, im: im }; }
    function cIsZero(c){ return Math.abs(c.re) < 1e-9 && Math.abs(c.im) < 1e-9; }
    // Parse simple complex inputs (a, bi, a+bi, -1-2i, 0.5i…) without GeoGebra. Returns {re,im} or null.
    function parseComplex(s){
      s = String(s == null ? '' : s).trim();
      if(s === '') return { re: 0, im: 0 };
      s = s.split(' ').join('').split('*').join('').split(String.fromCharCode(0x2212)).join('-');
      if(s.charAt(0) !== '+' && s.charAt(0) !== '-') s = '+' + s;
      var re = 0, im = 0, i = 0;
      while(i < s.length){
        var ch = s.charAt(i), sign;
        if(ch === '+'){ sign = 1; i++; } else if(ch === '-'){ sign = -1; i++; } else return null;
        var j = i; while(j < s.length && s.charAt(j) !== '+' && s.charAt(j) !== '-') j++;
        var term = s.slice(i, j); i = j;
        if(term === '') return null;
        if(term === 'i'){ im += sign; }
        else if(term.charAt(term.length - 1) === 'i'){
          var ns = term.slice(0, -1), num = (ns === '') ? 1 : Number(ns);
          if(!isFinite(num)) return null; im += sign * num;
        } else { var n2 = Number(term); if(!isFinite(n2)) return null; re += sign * n2; }
      }
      return { re: re, im: im };
    }
    function coefVal(s){ var p = parseComplex(s); if(p) return p; var v = evalComplex('(' + (((s || '').trim()) || '0') + ')'); return v || { re: 0, im: 0 }; }
    function fmtReal(x){ var r = Math.round(x * 1e6) / 1e6; if(Math.abs(r - Math.round(r)) < 1e-9) r = Math.round(r); return String(r); }
    function fmtImag(y){
      var r = Math.round(y * 1e6) / 1e6; if(Math.abs(r - Math.round(r)) < 1e-9) r = Math.round(r);
      if(r === 1) return 'i'; if(r === -1) return '-i'; return r + 'i';
    }
    // Split a GeoGebra list string "{a, b, c}" into top-level parts (respecting parens).
    function splitTopLevel(s){
      s = String(s).trim();
      if(s.charAt(0) === '{') s = s.slice(1);
      if(s.charAt(s.length - 1) === '}') s = s.slice(0, -1);
      var parts = [], depth = 0, cur = '';
      for(var i = 0; i < s.length; i++){
        var ch = s.charAt(i);
        if(ch === '(' || ch === '{' || ch === '[') depth++;
        else if(ch === ')' || ch === '}' || ch === ']') depth--;
        if(ch === ',' && depth === 0){ parts.push(cur); cur = ''; }
        else cur += ch;
      }
      if(cur.trim() !== '') parts.push(cur);
      return parts.map(function(p){ return p.trim(); }).filter(function(p){ return p !== ''; });
    }
    function stripZeq(r){ var eq = r.indexOf('='); if(eq >= 0 && r.slice(0, eq).trim().toLowerCase() === 'z') return r.slice(eq + 1).trim(); return r; }
    // Evaluate f(z) = Σ coefs[k]·z^(n−k) (Horner, pure-JS complex arithmetic).
    function cHorner(coefs, z){ var acc = { re: 0, im: 0 }; for(var k = 0; k < coefs.length; k++){ acc = cAdd(cMul(acc, z), coefs[k]); } return acc; }
    // All complex roots of a polynomial (Durand–Kerner). Pure JS — GeoGebra's CSolutions is
    // unreliable with the imaginary unit and implicit products (e.g. "2(6i-11)").
    function polyRootsJS(coefs){
      while(coefs.length > 1 && cIsZero(coefs[0])) coefs = coefs.slice(1);
      var n = coefs.length - 1; if(n < 1) return [];
      var lead = coefs[0], m = coefs.map(function(c){ return cDiv(c, lead); });
      var zs = [], seed = { re: 0.4, im: 0.9 }, cur = { re: 1, im: 0 };
      for(var k = 0; k < n; k++){ cur = cMul(cur, seed); zs.push(cur); }
      for(var it = 0; it < 800; it++){
        var moved = 0;
        for(var i = 0; i < n; i++){
          var den = { re: 1, im: 0 };
          for(var j = 0; j < n; j++){ if(j !== i) den = cMul(den, cSub(zs[i], zs[j])); }
          if(cIsZero(den)) den = { re: 1e-12, im: 1e-12 };
          var step = cDiv(cHorner(m, zs[i]), den);
          zs[i] = cSub(zs[i], step); moved = Math.max(moved, Math.hypot(step.re, step.im));
        }
        if(moved < 1e-14) break;
      }
      return zs;
    }
    // Snap a real number to a simple fraction p/q (q ≤ 12) when it is an EXACT root along dir
    // (dir = {1,0} for z = x, {0,1} for z = i·y). Returns { num, str } with str parseable later.
    function snapRoot(coefs, x, dir){
      var scale = coefs.reduce(function(s, c){ return s + Math.hypot(c.re, c.im); }, 0) || 1;
      for(var q = 1; q <= 12; q++){
        var p = Math.round(x * q), v = p / q;
        var r = cHorner(coefs, { re: v * dir.re, im: v * dir.im });
        if(Math.hypot(r.re, r.im) < 1e-9 * scale) return { num: v, str: (q === 1 || p % q === 0) ? String(p / q) : plainFrac(p, q) };
      }
      return { num: x, str: fmtReal(x) };
    }
    // kind = 'real' (z = x) or 'imag' (z = i·y). Returns the distinct roots of that kind as
    // strings usable as z₀ (e.g. "-2", "-3i", "(2/3)i"), or [] if there is none.
    function findSpecialRoots(kind){
      var coefs = [coefVal(eqaInput.value), coefVal(eqbInput.value), coefVal(eqcInput.value), coefVal(eqdInput.value)];
      var roots = polyRootsJS(coefs), out = [], seen = [];
      var tol = 1e-6 * Math.max(1, roots.reduce(function(s, r){ return Math.max(s, Math.hypot(r.re, r.im)); }, 0));
      roots.forEach(function(r){
        var isKind = (kind === 'real') ? (Math.abs(r.im) < tol) : (Math.abs(r.re) < tol && Math.abs(r.im) >= tol);
        if(!isKind) return;
        var sn = (kind === 'real') ? snapRoot(coefs, r.re, { re: 1, im: 0 }) : snapRoot(coefs, r.im, { re: 0, im: 1 });
        if(seen.some(function(v){ return Math.abs(v - sn.num) < 1e-7; })) return;
        seen.push(sn.num);
        if(kind === 'real') out.push(sn.str);
        else out.push(sn.str === '1' ? 'i' : (sn.str === '-1' ? '-i' : (sn.str.indexOf('/') >= 0 ? '(' + sn.str + ')i' : sn.str + 'i')));
      });
      return out;
    }

    // Synthetic (Horner) division of f(z)=a z³+b z²+c z+d by (z − z₀).
    // Returns the quotient coefficients {q0,q1,q2} (Q = q0 z² + q1 z + q2) and remainder.
    function syntheticDiv(z0str){
      var a = coefVal(eqaInput.value), b = coefVal(eqbInput.value), c = coefVal(eqcInput.value), d = coefVal(eqdInput.value);
      var z = coefVal(z0str);
      var q0 = a;
      var q1 = cAdd(b, cMul(q0, z));
      var q2 = cAdd(c, cMul(q1, z));
      var rem = cAdd(d, cMul(q2, z));
      return { q0: q0, q1: q1, q2: q2, rem: rem };
    }
    function solveQuad(q0, q1, q2){
      if(cIsZero(q0)){ // degree 1: q1 z + q2 = 0
        if(cIsZero(q1)) return [];
        return [cDiv({ re: -q2.re, im: -q2.im }, q1)];
      }
      var disc = cSub(cMul(q1, q1), cMul({ re: 4, im: 0 }, cMul(q0, q2)));
      var sq = cSqrt(disc), twoA = cMul({ re: 2, im: 0 }, q0);
      var negB = { re: -q1.re, im: -q1.im };
      return [cDiv(cAdd(negB, sq), twoA), cDiv(cSub(negB, sq), twoA)];
    }
    // Exact roots of a quadratic with INTEGER real coefficients — keeps the √ symbol.
    // Returns an array of plain expression strings (toLatex-renderable) or null.
    function igcd(x, y){ x = Math.abs(Math.round(x)); y = Math.abs(Math.round(y)); while(y){ var t = y; y = x % y; x = t; } return x; }
    function simplifyRadical(n){ var coef = 1, rad = n; for(var k = 2; k * k <= rad; k++){ while(rad % (k * k) === 0){ rad = rad / (k * k); coef = coef * k; } } return { coef: coef, rad: rad }; }
    function plainFrac(num, den){ var g = igcd(num, den) || 1; num = num / g; den = den / g; if(den < 0){ num = -num; den = -den; } return (den === 1) ? String(num) : (num + '/' + den); }
    function radRoot(nb, sgn, coef, rad, den, unit){ // (nb ± coef·unit·√rad)/den  (unit = '' real or 'i' complex)
      var g = igcd(igcd(Math.abs(nb), coef), den) || 1;
      var n2 = nb / g, c2 = coef / g, d2 = den / g;
      var r="";
      if(rad > 1) r = (c2 !== 1 ? (c2 + ' ') : '') + (unit ? unit + ' ' : '') + 'sqrt(' + rad + ')';
      else r = (c2 !== 1 ? (c2 + (unit ? ' ' : '')) : '') + (unit || (c2 === 1 ? '1' : ''));
      var num = (n2 === 0) ? ((sgn < 0 ? '-' : '') + r) : (n2 + (sgn < 0 ? ' - ' : ' + ') + r);
      return (d2 === 1) ? num : ('(' + num + ')/' + d2);
    }
    function exactQuadRoots(q0, q1, q2){
      function ni(x){ return Math.abs(x - Math.round(x)) < 1e-7; }
      if(Math.abs(q0.im) > 1e-7 || Math.abs(q1.im) > 1e-7 || Math.abs(q2.im) > 1e-7) return null;
      if(!ni(q0.re) || !ni(q1.re) || !ni(q2.re)) return null;
      var a = Math.round(q0.re), b = Math.round(q1.re), c = Math.round(q2.re);
      if(a === 0) return null;
      var D = b * b - 4 * a * c, den = 2 * a, nb = -b;
      if(den < 0){ den = -den; nb = -nb; }
      if(D === 0) return [ plainFrac(nb, den) ];
      if(D > 0){
        var sr = simplifyRadical(D);
        if(sr.rad === 1) return [ plainFrac(nb + sr.coef, den), plainFrac(nb - sr.coef, den) ];
        return [ radRoot(nb, 1, sr.coef, sr.rad, den, ''), radRoot(nb, -1, sr.coef, sr.rad, den, '') ];
      }
      var sr2 = simplifyRadical(-D);
      return [ radRoot(nb, 1, sr2.coef, sr2.rad, den, 'i'), radRoot(nb, -1, sr2.coef, sr2.rad, den, 'i') ];
    }
    function termStr(c, v){
      var cv = fmtComplexVal(c.re, c.im);
      if(v === '') return cv;
      if(cv === '1') return v;
      if(cv === '-1') return '-' + v;
      return (cv.indexOf(' ') >= 0 ? '(' + cv + ') ' : cv + ' ') + v;
    }
    function joinPoly(parts){
      if(parts.length === 0) return '0';
      var out = parts[0];
      for(var i = 1; i < parts.length; i++){ var p = parts[i]; out += (p.charAt(0) === '-') ? (' - ' + p.slice(1)) : (' + ' + p); }
      return out;
    }
    function fmtQuotient(q){
      var parts = [];
      if(!cIsZero(q.q0)) parts.push(termStr(q.q0, 'z^2'));
      if(!cIsZero(q.q1)) parts.push(termStr(q.q1, 'z'));
      if(!cIsZero(q.q2) || parts.length === 0) parts.push(termStr(q.q2, ''));
      return joinPoly(parts);
    }
    // Render an equation result (number, polynomial, or {set}) as LaTeX for KaTeX.
    function eqResultLatex(s){
      s = String(s == null ? '' : s).trim();
      if(s.charAt(0) === '{' && s.charAt(s.length - 1) === '}'){
        var items = splitTopLevel(s).map(function(it){ try { return toLatex(it); } catch(e){ return it; } });
        return BS + '{ ' + items.join(', ') + ' ' + BS + '}';
      }
      try { return toLatex(s); } catch(e){ return s; }
    }
    /* ---------- Q(z) : deux méthodes illustrées (division posée + identification) ---------- */
    var eqExtra = null; // optional renderer called after the answer box (used by the quotient op)
    var qmVar = 'z'; // variable letter used by termTex (z for ℂ, x for the real equations of the Équation mode)
    // Real values that are simple fractions render as a LaTeX fraction; everything else as a+bi.
    function cTxt(c){
      if(Math.abs(c.im) < 1e-12){
        for(var q = 2; q <= 100; q++){ var p = Math.round(c.re * q); if(Math.abs(p / q - c.re) < 1e-9 && Math.abs(c.re - Math.round(c.re)) > 1e-9){ var g = igcd(p, q) || 1; p = p / g; var qq = q / g; return (p < 0 ? '-' : '') + BS + 'frac{' + Math.abs(p) + '}{' + qq + '}'; } }
      }
      return fmtComplexVal(c.re, c.im);
    }
    function cCompound(c){ var r = Math.round(c.re * 1e6) / 1e6, i = Math.round(c.im * 1e6) / 1e6; return r !== 0 && i !== 0; }
    // A paren-wrapped value for products: (−2), (−2 + 9i), 3, 9i
    function cPar(c){ var t = cTxt(c); return (cCompound(c) || t.charAt(0) === '-') ? '(' + t + ')' : t; }
    // One term c·z^p as LaTeX. first=true → no leading "+".
    function termTex(c, p, first){
      if(cIsZero(c)) return '';
      var v = p === 0 ? '' : (p === 1 ? qmVar : qmVar + '^{' + p + '}');
      var t = cTxt(c), sign = '+', body;
      if(cCompound(c)){ body = '(' + t + ')' + v; }
      else {
        if(t.charAt(0) === '-'){ sign = '-'; t = t.slice(1); }
        if(v && t === '1') t = '';
        body = t + v;
      }
      if(first) return (sign === '-' ? '-' : '') + body;
      return sign + ' ' + body;
    }
    function polyTex(list){ // list of [c, p]
      var out = '', first = true;
      list.forEach(function(it){ var t = termTex(it[0], it[1], first); if(t){ out += (first ? '' : ' ') + t; first = false; } });
      return out || '0';
    }
    function neg(c){ return { re: -c.re, im: -c.im }; }
    // m·sym with a simplified sign, e.g. m=2 → "+ 2α", m=-1 → "- β", m=2-9i → "+ (2 - 9i)γ"
    function scaledSym(m, sym, first){
      if(cIsZero(m)) return '';
      var t = cTxt(m);
      if(cCompound(m)) return (first ? '' : '+ ') + '(' + t + ')' + sym;
      var ng = t.charAt(0) === '-', ab = ng ? t.slice(1) : t;
      if(ab === '1') ab = '';
      return first ? ((ng ? '-' : '') + ab + sym) : ((ng ? '- ' : '+ ') + ab + sym);
    }

    function renderQuotientMethods(box, z0str){
      renderQuotientMethodsFor(box, [coefVal(eqaInput.value), coefVal(eqbInput.value), coefVal(eqcInput.value), coefVal(eqdInput.value)], coefVal(z0str), { v: 'z', f: 'f', r: 'z₀' });
    }
    // Generic version: coefs = [a, b, c, d] ({re,im}), z0 = root; o = { v: variable, f: polynomial name, r: root label }.
    function renderQuotientMethodsFor(box, coefs, z0, o){
      var savedVar = qmVar; qmVar = o.v;
      var a = coefs[0], b = coefs[1], c = coefs[2], d = coefs[3];
      var q0 = a, q1 = cAdd(b, cMul(q0, z0)), q2 = cAdd(c, cMul(q1, z0)), rem = cAdd(d, cMul(q2, z0));
      var V = o.v, F = o.f + '(' + V + ')', R = o.r;
      var divisor = polyTex([[{ re: 1, im: 0 }, 1], [neg(z0), 0]]);
      var quot = polyTex([[q0, 2], [q1, 1], [q2, 0]]);
      var fz = polyTex([[a, 3], [b, 2], [c, 1], [d, 0]]);
      var remOk = cIsZero(rem);

      // ---- Méthode 1 : division euclidienne posée (colonnes z³ | z² | z | 1) ----
      // Each "sub" row is the OPPOSITE of (quotient term)·(z − z₀), added to the line above.
      function cell(c, p, first, cls){ var t = termTex(c, p, first); return '<td class="eq-l' + (cls ? ' ' + cls : '') + '"><span data-tex="' + escapeHtml(t) + '"></span></td>'; }
      function empty(){ return '<td class="eq-l"></td>'; }
      function rowCells(map, startFirst){ // map: {3: c3, 2: c2, 1: c1, 0: c0}
        var html = '', first = true;
        [3, 2, 1, 0].forEach(function(p){
          if(map[p] === undefined){ html += empty(); return; }
          html += cell(map[p], p, first); first = false;
        });
        return html;
      }
      var rows = [];
      rows.push('<tr>' + rowCells({3: a, 2: b, 1: c, 0: d}) + '<td class="eq-dv eq-dv-top"><span data-tex="' + escapeHtml(divisor) + '"></span></td></tr>');
      rows.push('<tr class="eq-sub">' + rowCells({3: neg(q0), 2: cMul(q0, z0)}) + '<td class="eq-dv eq-dv-q"><span data-tex="' + escapeHtml(quot) + '"></span></td></tr>');
      rows.push('<tr>' + rowCells({2: q1, 1: c, 0: d}) + '<td class="eq-lbl">' + (cIsZero(q0) ? '' : 'on abaisse c·' + V + ' et d') + '</td></tr>');
      rows.push('<tr class="eq-sub">' + rowCells({2: neg(q1), 1: cMul(q1, z0)}) + '<td></td></tr>');
      rows.push('<tr>' + rowCells({1: q2, 0: d}) + '<td></td></tr>');
      rows.push('<tr class="eq-sub">' + rowCells({1: neg(q2), 0: cMul(q2, z0)}) + '<td></td></tr>');
      rows.push('<tr class="eq-rem"><td class="eq-l"></td><td class="eq-l"></td><td class="eq-l"></td><td class="eq-l"><span data-tex="' + escapeHtml(cIsZero(rem) ? '0' : cTxt(rem)) + '"></span></td><td class="eq-lbl">reste</td></tr>');

      var z0t = cPar(z0);
      var m1 = '<div class="eq-meth">'
        + '<div class="eq-meth__t"><span class="eq-meth__n">1</span> Méthode 1 — Division euclidienne de ' + F + ' par (' + V + ' − ' + R + ')</div>'
        + '<p class="eq-meth__intro">On divise le terme de plus haut degré par ' + V + ', on multiplie le diviseur par ce terme, on retranche (lignes colorées = opposé du produit), puis on abaisse le terme suivant. On recommence jusqu’au reste.</p>'
        + '<div class="eq-div-wrap"><table class="eq-div">' + rows.join('') + '</table></div>'
        + '<div class="eq-line" data-tex="' + escapeHtml(termTex(a, 3, true) + ' ' + BS + 'div ' + V + ' = ' + termTex(q0, 2, true) + ',' + BS + 'quad ' + termTex(q1, 2, true) + ' ' + BS + 'div ' + V + ' = ' + termTex(q1, 1, true) + ',' + BS + 'quad ' + termTex(q2, 1, true) + ' ' + BS + 'div ' + V + ' = ' + termTex(q2, 0, true)) + '"></div>'
        + '<div class="eq-ok' + (remOk ? '' : ' is-ko') + '">' + (remOk ? 'Le reste est nul : ' + R + ' est bien racine, et Q(' + V + ') est le quotient.' : 'Le reste n’est pas nul : ' + R + ' n’est pas racine de ' + o.f + '.') + '</div>'
        + '</div>';

      // ---- Méthode 2 : identification des coefficients (système) ----
      var al = BS + 'alpha', be = BS + 'beta', ga = BS + 'gamma';
      var mz = neg(z0);
      var expand = '(' + divisor + ')(' + al + ' ' + V + '^{2} + ' + be + ' ' + V + ' + ' + ga + ') = ' + al + ' ' + V + '^{3} + (' + be + ' ' + scaledSym(mz, al, false) + ') ' + V + '^{2} + (' + ga + ' ' + scaledSym(mz, be, false) + ') ' + V + ' ' + scaledSym(mz, ga, false);
      var sys = BS + 'left' + BS + '{' + BS + 'begin{array}{l}'
        + al + ' = ' + cPar(a) + BS + BS
        + be + ' ' + scaledSym(mz, al, false) + ' = ' + cPar(b) + BS + BS
        + ga + ' ' + scaledSym(mz, be, false) + ' = ' + cPar(c) + BS + BS
        + scaledSym(mz, ga, true) + ' = ' + cPar(d)
        + BS + 'end{array}' + BS + 'right.';
      var s1 = al + ' = ' + cTxt(q0);
      var s2 = be + ' = ' + cPar(b) + ' - ' + cPar(mz) + ' ' + BS + 'times ' + cPar(q0) + ' = ' + cTxt(q1);
      var s3 = ga + ' = ' + cPar(c) + ' - ' + cPar(mz) + ' ' + BS + 'times ' + cPar(q1) + ' = ' + cTxt(q2);
      var chk = cMul(neg(z0), q2);
      var s4 = cPar(mz) + ' ' + BS + 'times ' + cPar(q2) + ' = ' + cTxt(chk) + (cIsZero(cSub(chk, d)) ? ' = d' + BS + ';' + BS + 'checkmark' : BS + 'neq d');
      var m2 = '<div class="eq-meth">'
        + '<div class="eq-meth__t"><span class="eq-meth__n eq-meth__n--v">2</span> Méthode 2 — Identification des coefficients</div>'
        + '<p class="eq-meth__intro">On cherche Q(' + V + ') = α' + V + '² + β' + V + ' + γ tel que ' + F + ' = (' + V + ' − ' + R + ')·Q(' + V + '). On développe, puis on identifie avec ' + F + ' = a·' + V + '³ + b·' + V + '² + c·' + V + ' + d : deux polynômes égaux ont les mêmes coefficients.</p>'
        + '<div class="eq-line" data-tex="' + escapeHtml(expand) + '"></div>'
        + '<p class="eq-meth__intro" style="margin:.6rem 0 .2rem">Par identification, on obtient le système :</p>'
        + '<div class="eq-sys" data-tex="' + escapeHtml(sys) + '"></div>'
        + '<p class="eq-meth__intro" style="margin:.4rem 0 .2rem">On le résout de proche en proche :</p>'
        + '<div class="eq-line" data-tex="' + escapeHtml(s1) + '"></div>'
        + '<div class="eq-line" data-tex="' + escapeHtml(s2) + '"></div>'
        + '<div class="eq-line" data-tex="' + escapeHtml(s3) + '"></div>'
        + '<p class="eq-meth__intro" style="margin:.4rem 0 .2rem">Vérification avec la 4ᵉ équation :</p>'
        + '<div class="eq-line" data-tex="' + escapeHtml(s4) + '"></div>'
        + '<div class="eq-line" data-tex="' + escapeHtml('Q(' + V + ') = ' + quot) + '"></div>'
        + '</div>';

      box.innerHTML = '<div class="eq-methods">' + m1 + m2 + '</div>';
      Array.prototype.forEach.call(box.querySelectorAll('[data-tex]'), function(el){
        var t = el.getAttribute('data-tex'); if(t) renderKatex(el, t);
      });
      qmVar = savedVar;
    }
    function setEqAnswer(label, value){
      answerEl.innerHTML = '<div class="ml-answer"><div class="lbl"><i class="bi bi-stars"></i> ' + label + '</div><div class="val" id="eq-final"></div></div>';
      renderKatex(document.getElementById('eq-final'), eqResultLatex(value));
      if(eqExtra){ var bx = document.createElement('div'); answerEl.appendChild(bx); try { eqExtra(bx); } catch(e){ bx.innerHTML = ''; } }
    }

    async function runEqStep(op){
      var poly = buildEquation();
      var z0 = (eqz0Input.value || '').trim();
      var needsZ0 = (op === 'eval_at' || op === 'quotient' || op === 'solve_quotient');
      if(!ggb){ return; }
      if(needsZ0 && !z0){ stateEl.textContent = 'Indiquez z₀ (ou utilisez « Racine réelle / imaginaire pure »).'; eqz0Input.focus(); return; }

      function reenable(){ setEqStepsEnabled(true); eqSolveBtn.disabled = false; setCOpsEnabled(true); }
      setEqStepsEnabled(false); eqSolveBtn.disabled = true; setCOpsEnabled(false);
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul en cours…';

      var casResult = '', label = 'Résultat', plotAll = false, eqRoots = null, eqNote = '';
      eqExtra = null;
      try {
        if(op === 'eval_at'){
          // Remainder theorem: f(z₀) is exactly the remainder of f(z)/(z−z₀). Pure JS.
          var fv = syntheticDiv(z0).rem;
          casResult = fmtComplexVal(fv.re, fv.im);
          label = 'f(z₀)';
        } else if(op === 'find_real_root' || op === 'find_imag_root'){
          var kindReal = (op === 'find_real_root');
          var found = findSpecialRoots(kindReal ? 'real' : 'imag');
          if(!found.length){
            answerEl.innerHTML = '';
            stateEl.textContent = kindReal
              ? 'Cette équation n’a pas de racine réelle. Essayez « Racine imaginaire pure », ou saisissez une racine z₀ connue.'
              : 'Cette équation n’a pas de racine imaginaire pure. Essayez « Racine réelle », ou saisissez une racine z₀ connue.';
            reenable(); return;
          }
          eqz0Input.value = found[0]; z0 = found[0];
          casResult = (found.length === 1) ? found[0] : ('{' + found.join(', ') + '}');
          label = kindReal ? 'Racine réelle z₀' : 'Racine imaginaire pure z₀'; plotAll = true;
          eqRoots = found.map(function(v){ return coefVal(v); });
        } else if(op === 'quotient'){
          // Synthetic division in JS (CAS Div is unreliable with the imaginary unit).
          var qd0 = syntheticDiv(z0);
          casResult = fmtQuotient(qd0);
          label = 'Q(z)';
          eqExtra = function(bx){ renderQuotientMethods(bx, z0); };
          if(!cIsZero(qd0.rem)){ eqNote = 'Remarque : le reste de la division vaut ' + fmtComplexVal(qd0.rem.re, qd0.rem.im) + ' (non nul) — z₀ ne semble pas être une racine de f.'; }
        } else if(op === 'solve_quotient'){
          var qd = syntheticDiv(z0);
          eqRoots = solveQuad(qd.q0, qd.q1, qd.q2); // numeric, for plotting
          var exact = exactQuadRoots(qd.q0, qd.q1, qd.q2); // exact with √, if integer coeffs
          var rootStrs = exact || eqRoots.map(function(r){ return fmtComplexVal(r.re, r.im); });
          casResult = rootStrs.length ? ('{' + rootStrs.join(', ') + '}') : '';
          label = 'Solutions de Q(z) = 0'; plotAll = true;
        }
      } catch(e){ casResult = ''; }
      casResult = ggbToText(casResult).trim();
      if(!casResult || casResult === '{}' || casResult === '?'){ stateEl.textContent = 'Calcul impossible — vérifiez les coefficients et z₀.'; reenable(); return; }

      if(plotAll){
        clearComplexPlot(); try { ggb.deleteObject('f'); } catch(e){}
        if(eqRoots && eqRoots.length){
          eqRoots.forEach(function(r, idx){ var nm = 'rqt' + (idx + 1); defObj(nm, '(' + r.re + ',' + r.im + ')'); colour(nm, 255, 184, 0); });
        }
      }

      setEqAnswer(label, casResult);
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';

      var payload = { domain:'complex', operation: op, expression: poly, casResult: casResult };
      if(op === 'eval_at' || op === 'quotient' || op === 'solve_quotient'){ payload.z0 = z0; }

      try {
        var resp = await fetch(EXPLAIN_URL, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify(payload)
        });
        var data = await resp.json();
        if(data.ok){ showSteps(data); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
      } catch(e){
        stateEl.textContent = 'Connexion impossible — réessayez.';
      } finally {
        // Authoritative computed answer always wins (model may abbreviate the solution set).
        setEqAnswer(label, casResult);
        if(eqNote) stateEl.textContent = eqNote;
        reenable();
      }
    }
    eqStepsEl.addEventListener('click', function(ev){
      var btn = ev.target.closest('.ml-op'); if(!btn || btn.disabled) return;
      runEqStep(btn.getAttribute('data-eqop'));
    });

    /* ============ GÉOMÉTRIE (points, triangles, quadrilatères) ============ */
    var modeGeo   = document.getElementById('mode-geometry');
    var geoListEl = document.getElementById('geo-points');
    var geoAddBtn = document.getElementById('geo-add');
    var gkeysEl   = document.getElementById('gkeys');
    var gopsEl    = document.getElementById('gops');
    var gPreviewEl= document.getElementById('gPreview');
    var geoObjs   = [];
    var activeGeo = null;
    var GEO_LETTERS = ['A','B','C','D','E','F'];
    var GEO_MIN = 3, GEO_MAX = 6;

    function setGOpsEnabled(on){ gopsEl.querySelectorAll('.ml-op').forEach(function(b){ b.disabled = !on; }); }
    function geoInputs(){ return Array.prototype.slice.call(geoListEl.querySelectorAll('input')); }
    function geoRows(){ return Array.prototype.slice.call(geoListEl.querySelectorAll('.geo-row')); }
    function geoData(){
      return geoInputs().map(function(inp, i){ return { name: GEO_LETTERS[i], affix: (inp.value || '').trim() }; })
                        .filter(function(p){ return p.affix; });
    }
    function renumberGeo(){
      var rows = geoRows();
      rows.forEach(function(row, i){
        var name = GEO_LETTERS[i];
        row.setAttribute('data-name', name);
        var lab = row.querySelector('.geo-label'); if(lab) lab.innerHTML = 'z<sub>' + name + '</sub> =';
