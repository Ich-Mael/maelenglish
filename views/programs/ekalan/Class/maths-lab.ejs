            <circle id="tc-point" r="7" fill="#5e17eb" stroke="#fff" stroke-width="2"/>
          </svg>
          <div class="trig-readout">
            <div class="trig-rv is-ang"><div class="lbl">Angle θ</div><div class="val" id="tc-angle"></div></div>
            <div class="trig-rv is-cos"><div class="lbl">cosinus</div><div class="val" id="tc-cosv"></div></div>
            <div class="trig-rv is-sin"><div class="lbl">sinus</div><div class="val" id="tc-sinv"></div></div>
