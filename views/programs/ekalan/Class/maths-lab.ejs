    function vcTermsPlain(terms){ if(!terms.length) return '0'; return terms.map(function(t, i){ var ab = fr(Math.abs(t.k.n), t.k.d); return (i ? (t.k.n < 0 ? ' - ' : ' + ') : (t.k.n < 0 ? '-' : '')) + (ab.n === 1 && ab.d === 1 ? '' : fPlain(ab) + ' ') + (t.V || t.X + t.Y); }).join(''); }
