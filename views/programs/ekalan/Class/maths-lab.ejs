      var latex = null;
      try { latex = toLatex(raw); } catch(e){ latex = null; }
      if(latex == null){ previewEl.className='ml-preview is-empty'; previewEl.textContent='…en cours de saisie'; return; }
      try { katex.render('f(x) = ' + latex, previewEl, { throwOnError:true, displayMode:false }); previewEl.className='ml-preview'; }
      catch(e){ previewEl.className='ml-preview is-empty'; previewEl.textContent='…en cours de saisie'; }
    }
