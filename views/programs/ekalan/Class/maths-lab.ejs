      return parts.length ? parts.join('+') : '0';
    }

    // ---- input → polynomial in m (coefficient inputs) ----
    function astToPolyM(n){
      if(!n) return null;
      switch(n.t){
        case 'num': { var f = fFromNum(n.v); return f ? [f] : null; }
        case 'const': return n.name === 'm' ? [fr(0), fr(1)] : null;
        case 'var': return null; // x is not allowed inside a coefficient
        case 'neg': { var a = astToPolyM(n.a); return a ? pScale(a, fr(-1)) : null; }
        case '+': case '-': case '*': {
          var l = astToPolyM(n.l), r = astToPolyM(n.r); if(!l || !r) return null;
          return n.t === '+' ? pAdd(l, r) : n.t === '-' ? pSub(l, r) : pMul(l, r);
        }
        case '/': { var l2 = astToPolyM(n.l), r2 = astToPolyM(n.r); if(!l2 || !r2 || !pConst(r2) || fZero(r2[0])) return null; return pScale(l2, fDiv(fr(1), r2[0])); }
        case '^': { var b = astToPolyM(n.l), e = astToPolyM(n.r); if(!b || !e || !pConst(e)) return null; var ev = fVal(e[0]); if(ev < 0 || ev > 6 || ev !== Math.floor(ev)) return null; var res = [fr(1)]; for(var i = 0; i < ev; i++) res = pMul(res, b); return res; }
      }
      return null;
    }
    function e1Parse(str){
      str = (str || '').trim(); if(str === '') str = '0';
      var tk = pwTokens(str); if(!tk) return null;
      var ast = null; try { ast = dxParse(tk); } catch(e){ ast = null; }
      return ast ? astToPolyM(ast) : null;
    }

    // ---- exact real roots ----
    // Root object: { num, tex, plain, f? (fraction when rational) }
    function rootRat(f){ return { num: fVal(f), tex: fTex(f), plain: fPlain(f), f: f }; }
    // A x² + B x + C = 0 with fraction coefficients (A ≠ 0) → { delta (fraction), roots: [...] ascending }
    function quadExact(A, B, C){
      var delta = fSub(fMul(B, B), fMul(fr(4), fMul(A, C)));
      var L = A.d * B.d * C.d, Ai = A.n * (L / A.d), Bi = B.n * (L / B.d), Ci = C.n * (L / C.d);
      var g = igcd(igcd(Ai, Bi), Ci) || 1; Ai /= g; Bi /= g; Ci /= g;
      var D = Bi * Bi - 4 * Ai * Ci, roots = [];
      if(D < 0) return { delta: delta, roots: [] };
      if(D === 0) return { delta: delta, roots: [rootRat(fr(-Bi, 2 * Ai))] };
