      parts.push('nature : ' + (nat.type === 'const' ? 'constante (uₙ=' + vtFmt(nat.c) + ')' : (nat.type === 'arith' ? 'arithmétique r=' + vtFmt(nat.r) : (nat.type === 'geo' ? 'géométrique q=' + vtFmt(nat.q) : 'ni arithmétique ni géométrique'))));
      parts.push('sens : ' + sens);
      parts.push('limite : ' + BSlim);
