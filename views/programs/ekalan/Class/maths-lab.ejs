    // ---- display helpers ----
    function e1EqTex(polys, v){ return pTex(polys, v) + ' = 0'; }
    // Equation with coefficients that are polynomials in m (A for x², B for x, C constant)
    function e1ParamTex(A, B, C){
      var out = '', first = true;
      [[A, 'x^{2}'], [B, 'x'], [C, '']].forEach(function(it){
        var co = pTrim(it[0]), xp = it[1], nz = co.filter(function(c){ return !fZero(c); }).length;
        if(nz === 0) return;
        if(nz === 1 || xp === ''){
          var t = pTex(co, 'm');
          if(xp && (t === '1' || t === '-1')) t = t === '1' ? '' : '-';
          var neg = t.charAt(0) === '-', body = (neg ? t.slice(1) : t) + (xp ? (t === '' || t === '-' ? '' : ' ') + xp : '');
          if(xp === '' && nz > 1){ out += first ? t : (' + ' + t).split('+ -').join('- '); }
          else out += first ? ((neg ? '-' : '') + body) : ((neg ? ' - ' : ' + ') + body);
