          ]},
          { t:'Suite géométrique (raison q)', f:[
            "u_n = u_0#,q^{#,n}",
            "u_n = u_p#,q^{#,n-p}",
            "u_0 + #cdots + u_n = u_0#,#frac{1 - q^{#,n+1}}{1 - q}#quad(q #neq 1)",
            "#lim_{n #to +#infty} q^n = 0#quad(|q| < 1)"
