<% scripts = `
  <script src="https://www.geogebra.org/apps/deployggb.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js" crossorigin="anonymous"></script>
  <script>
  (function () {
    var EXPLAIN_URL = "/programs/ekalan/kalan/class/${schoolClass._id}/maths-lab/explain";
    var ggb = null;
    var fxInput = document.getElementById('fx');
    var keysEl = document.getElementById('keys');
    var previewEl = document.getElementById('fxPreview');
    var plotBtn = document.getElementById('plotBtn');
    var opsEl = document.getElementById('ops');

    // --- Live LaTeX preview: convert the GeoGebra-style input to LaTeX ---
    // NB: this script is emitted from an EJS template literal, which strips one
    // level of backslashes — so build LaTeX with BS (a literal backslash) instead
    // of '\\' string escapes, which would arrive mangled in the browser.
    var BS = String.fromCharCode(92);
    var FUN = { sqrt:1, abs:1, exp:1, ln:1, log:1, sin:1, cos:1, tan:1, cot:1, sec:1, csc:1, asin:1, acos:1, atan:1 };
    function toLatex(src){
      var toks = [], n = src.length, j = 0;
      while(j < n){
        var c = src[j];
        if(c === ' '){ j++; continue; }
        if(/[0-9.]/.test(c)){ var num=''; while(j<n && /[0-9.]/.test(src[j])){ num+=src[j++]; } toks.push({t:'num',v:num}); continue; }
        if(/[a-zA-Z]/.test(c)){ var id=''; while(j<n && /[a-zA-Z]/.test(src[j])){ id+=src[j++]; } toks.push({t:'id',v:id}); continue; }
        if('+-*/^(),'.indexOf(c) >= 0){ toks.push({t:'op',v:c}); j++; continue; }
        throw new Error('bad char');
      }
      var p = 0;
      function peek(){ return toks[p]; }
      function eat(v){ if(toks[p] && toks[p].v===v){ p++; return true; } return false; }
      function startsFactor(tk){ return tk && (tk.t==='num' || tk.t==='id' || tk.v==='('); }
      function stripParens(x){ return (x.indexOf(BS+'left(')===0 && x.slice(-7)===BS+'right)') ? x.slice(6,-7) : x; }
      function emitFun(name, arg){
        switch(name){
          case 'sqrt': return BS+'sqrt{'+arg+'}';
          case 'abs':  return BS+'left|'+arg+BS+'right|';
          case 'exp':  return 'e^{'+arg+'}';
          case 'ln':   return BS+'ln'+BS+'left('+arg+BS+'right)';
          case 'log':  return BS+'log'+BS+'left('+arg+BS+'right)';
          default:     return BS+name+BS+'left('+arg+BS+'right)';
        }
      }
      function parseExpr(){
        var left = parseTerm();
        while(peek() && (peek().v==='+' || peek().v==='-')){
          var op = toks[p++].v; left = left + (op==='+' ? ' + ' : ' - ') + parseTerm();
        }
        return left;
      }
      function parseTerm(){
        var left = parseFactor();
        while(peek()){
          var tk = peek();
          if(tk.v==='*'){ p++; left = left + ' '+BS+'cdot ' + parseFactor(); }
          else if(tk.v==='/'){ p++; left = BS+'frac{'+stripParens(left)+'}{'+stripParens(parseFactor())+'}'; }
          else if(startsFactor(tk)){ left = left + ' ' + parseFactor(); }
          else break;
        }
        return left;
      }
      function parseFactor(){
        var base = parseBase();
        if(peek() && peek().v==='^'){ p++; base = base + '^{' + stripParens(parseFactor()) + '}'; }
        return base;
      }
      function parseBase(){
        var tk = peek();
        if(!tk) throw new Error('eof');
        if(tk.v==='-'){ p++; return '-' + parseBase(); }
        if(tk.v==='+'){ p++; return parseBase(); }
        if(tk.t==='num'){ p++; return tk.v; }
        if(tk.v==='('){ p++; var e = parseExpr(); eat(')'); return BS+'left(' + e + BS+'right)'; }
        if(tk.t==='id'){
          p++;
          var name = tk.v;
          if(FUN[name] && peek() && peek().v==='('){ p++; var arg = parseExpr(); eat(')'); return emitFun(name, arg); }
          if(name==='pi') return BS+'pi';
          return name;
        }
        throw new Error('unexpected');
      }
      var out = parseExpr();
      if(p < toks.length) throw new Error('trailing');
      return out;
    }

    function updatePreview(){
      var raw = (fxInput.value||'').trim();
      if(!raw){ previewEl.className='ml-preview is-empty'; previewEl.textContent='Aperçu de la fonction…'; return; }
      var latex = null;
      try { latex = toLatex(raw); } catch(e){ latex = null; }
