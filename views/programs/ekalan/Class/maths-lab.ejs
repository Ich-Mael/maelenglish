            <line x1="300" y1="40" x2="300" y2="300" stroke="#bbf7d0" stroke-width="1.5"/>
            <text x="305" y="36" font-size="11" fill="#16a34a">tan</text>
            <circle cx="170" cy="170" r="130" fill="rgba(94,23,235,.04)" stroke="#5e17eb" stroke-width="2"/>
            <line id="tc-tanconn" stroke="#16a34a" stroke-width="1.2" stroke-dasharray="4 3"/>
            <line id="tc-vproj" stroke="#2563eb" stroke-width="1.5" stroke-dasharray="4 3"/>
            <line id="tc-hproj" stroke="#dc2626" stroke-width="1.5" stroke-dasharray="4 3"/>
