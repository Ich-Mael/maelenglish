    function defLim(name, fullCmd){ try { ggb.evalCommand(fullCmd); limObjs.push(name); } catch(e){} }
    function clearLimPlot(){ limObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} }); limObjs = []; }

    async function runLimit(){
      var f = (lfxInput.value || '').trim();
