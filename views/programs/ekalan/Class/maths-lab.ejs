      function mk(name, cmd, r, g, b){ var nm = 'Vc' + (k++); try { ggb.evalCommand(nm + ' = ' + cmd); if(!ggb.exists(nm)) return null; vcObjs.push(nm); id[name] = nm; try { ggb.setCaption(nm, name); ggb.setLabelStyle(nm, 3); ggb.setLabelVisible(nm, true); } catch(e){} colour(nm, r, g, b); } catch(e){ return null; } return nm; }
