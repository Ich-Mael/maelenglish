    function updateProbaPreview(){
      var tex = null;
      try {
        if(probaType === 'binom'){ var n = parseInt(pbN.value, 10), p = parseProb(pbP.value); if(!(n >= 1) || !(p >= 0 && p <= 1)) throw 0; tex = 'X ' + BS + 'sim ' + BS + 'mathcal{B}(' + n + ', ' + pf(p) + ')'; }
        else { tex = 'P(A) = ' + pf(parseProb(pcA.value)) + ', ' + BS + 'quad P(B|A) = ' + pf(parseProb(pcBA.value)) + ', ' + BS + 'quad P(B|' + BS + 'bar A) = ' + pf(parseProb(pcBnA.value)); }
      } catch(e){ tex = null; }
      if(tex == null){ probaPrevEl.className = 'ml-preview is-empty'; probaPrevEl.textContent = '…'; return; }
      try { renderKatex(probaPrevEl, tex); probaPrevEl.className = 'ml-preview'; }
      catch(e){ probaPrevEl.className = 'ml-preview is-empty'; probaPrevEl.textContent = '…'; }
    }
    [pbN, pbP, pbK, pcA, pcBA, pcBnA].forEach(function(inp){ inp.addEventListener('input', updateProbaPreview); });

    function clearProbaPlot(){ probaObjs.forEach(function(nm){ try { ggb.deleteObject(nm); } catch(e){} }); probaObjs = []; }
    function plotBinom(n, p, k){
      if(!ggb) return; clearProbaPlot(); try { ggb.deleteObject('f'); } catch(e){}
      if(n > 60) return; // too many bars to draw cleanly
      var maxP = 0;
      for(var i = 0; i <= n; i++){
        var pi = bPmf(n, p, i); if(pi > maxP) maxP = pi;
        var nm = 'pbar' + i;
        try { ggb.evalCommand(nm + '=Segment((' + i + ',0),(' + i + ',' + pi + '))'); probaObjs.push(nm);
          if(i === k){ ggb.setColor(nm, 245, 158, 11); } else { ggb.setColor(nm, 93, 6, 186); }
          ggb.setLineThickness(nm, n > 30 ? 4 : 7); } catch(e){}
      }
      try { ggb.setCoordSystem(-1, n + 1, -0.04 * maxP - 0.01, maxP * 1.18 + 0.01); } catch(e){}
      setTimeout(fitGraph, 50);
    }

    async function runProba(){
      if(!ggb){ return; }
      answerEl.innerHTML = ''; stepsEl.innerHTML = '';
      stateEl.innerHTML = '<span class="ml-spinner"></span> Calcul…';
      setProbaOpsEnabled(false);
      var kq = [], kid = 0;
      function km(l){ var id = 'prk' + (kid++); kq.push({ id: id, latex: l }); return '<span class="study-math" id="' + id + '"></span>'; }
      function line(label, l){ var s = '<div class="study-line">'; if(label) s += '<span class="study-lbl">' + label + '</span> '; if(l) s += km(l); return s + '</div>'; }
      var title, body = '', op, defStr, summary;

      if(probaType === 'binom'){
        var n = parseInt(pbN.value, 10), p = parseProb(pbP.value), k = parseInt(pbK.value, 10);
        if(!(n >= 1) || !(p >= 0 && p <= 1) || !(k >= 0)){ stateEl.textContent = 'Vérifiez n, p (0 ≤ p ≤ 1) et k.'; setProbaOpsEnabled(true); return; }
        if(k > n) k = n;
        var pmf = bPmf(n, p, k), cdf = bCdf(n, p, k), pge = 1 - (k > 0 ? bCdf(n, p, k - 1) : 0), E = n * p, sd = Math.sqrt(n * p * (1 - p));
        plotBinom(n, p, k);
        title = 'Loi binomiale B(' + n + ', ' + pf(p) + ')';
        body += line('', 'X ' + BS + 'sim ' + BS + 'mathcal{B}(' + n + ', ' + pf(p) + ')');
        body += line('P(X = ' + k + ') :', BS + 'binom{' + n + '}{' + k + '}' + BS + ',p^{' + k + '}(1-p)^{' + (n - k) + '} = ' + pf(pmf));
        body += line('P(X ' + BS + 'le ' + k + ') :', pf(cdf));
        body += line('P(X ' + BS + 'ge ' + k + ') :', pf(pge));
        body += line('Espérance :', 'E(X) = np = ' + pf(E));
        body += line('Écart-type :', BS + 'sigma(X) = ' + BS + 'sqrt{np(1-p)} = ' + pf(sd));
        op = 'binomial_law'; defStr = 'n=' + n + ', p=' + pf(p) + ', k=' + k;
        summary = ('P(X=' + k + ')=' + pf(pmf) + ' ; P(X<=' + k + ')=' + pf(cdf) + ' ; P(X>=' + k + ')=' + pf(pge) + ' ; E(X)=' + pf(E) + ' ; sigma=' + pf(sd)).slice(0, 480);
      } else {
        var pa = parseProb(pcA.value), pba = parseProb(pcBA.value), pbna = parseProb(pcBnA.value);
        if(![pa, pba, pbna].every(function(x){ return x >= 0 && x <= 1; })){ stateEl.textContent = 'Les probabilités doivent être comprises entre 0 et 1.'; setProbaOpsEnabled(true); return; }
        var pan = 1 - pa, pB = pa * pba + pan * pbna, pAB = pa * pba, pAgB = pB > 0 ? pAB / pB : NaN;
        clearProbaPlot(); try { ggb.deleteObject('f'); } catch(e){}
        title = 'Probabilités conditionnelles';
        body += line('P(' + BS + 'bar A) :', '1 - P(A) = ' + pf(pan));
        body += line('P(A ' + BS + 'cap B) :', 'P(A)' + BS + 'cdot P(B|A) = ' + pf(pAB));
        body += line('P(B) :', 'P(A)P(B|A) + P(' + BS + 'bar A)P(B|' + BS + 'bar A) = ' + pf(pB));
        body += line('P(A | B) :', BS + 'dfrac{P(A ' + BS + 'cap B)}{P(B)} = ' + pf(pAgB));
        op = 'conditional_prob'; defStr = 'P(A)=' + pf(pa) + ', P(B|A)=' + pf(pba) + ', P(B|Ā)=' + pf(pbna);
        summary = ('P(B)=' + pf(pB) + ' ; P(A∩B)=' + pf(pAB) + ' ; P(A|B)=' + pf(pAgB)).slice(0, 480);
      }

      answerEl.innerHTML = '<div class="ml-study" style="padding:.9rem 1.1rem"><div class="study-head"><i class="bi bi-dice-5"></i> ' + escapeHtml(title) + '</div><div class="study-body">' + body + '</div></div>';
      kq.forEach(function(it){ var el = document.getElementById(it.id); if(el){ try { renderKatex(el, it.latex); } catch(e){} } });
      stateEl.innerHTML = '<span class="ml-spinner"></span> Génération des étapes…';
      try {
        var resp = await fetch(EXPLAIN_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ function: defStr.slice(0, 190), operation: op, casResult: summary }) });
        var data = await resp.json();
        if(data.ok){ showSteps(data, true); }
        else { stateEl.textContent = data.error || 'Étapes indisponibles.'; }
