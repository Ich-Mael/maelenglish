      if(xs.length){ var x0 = Math.min.apply(null, xs), x1 = Math.max.apply(null, xs), y0 = Math.min.apply(null, ys), y1 = Math.max.apply(null, ys), m = Math.max(1.5, (x1 - x0) * 0.2, (y1 - y0) * 0.2); try { ggb.setCoordSystem(x0 - m, x1 + m, y0 - m, y1 + m); } catch(e){} }
