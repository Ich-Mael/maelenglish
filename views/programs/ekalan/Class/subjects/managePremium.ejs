<% layout('layouts/main') %>

<% headContent = `
  <style>
    #main { margin-top: 0 !important; padding-top: 0 !important; }
    .premium-page {
      padding: 2rem 0 4rem; min-height: calc(100vh - 200px);
      background: linear-gradient(to bottom, #f8f9fa 0%, #ffffff 100%); margin-top: 80px !important;
    }
    .page-header {
      background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%); color: white;
      padding: 2.5rem 2rem; border-radius: 20px; margin-bottom: 2rem;
      box-shadow: 0 10px 40px rgba(93, 6, 186, 0.3);
      display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
    }
    .page-header h1 { margin: 0 0 0.5rem 0; font-size: 2rem; font-weight: 700; display: flex; align-items: center; gap: 1rem; }
    .page-header p { margin: 0; opacity: 0.95; font-size: 1.1rem; font-weight: 300; }
    .class-badge {
      display: inline-block; background: rgba(255, 255, 255, 0.2); padding: 0.5rem 1rem; border-radius: 50px;
      font-size: 0.9rem; margin-top: 0.5rem; backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.3);
    }
    .btn-header {
      padding: 0.75rem 1.5rem; border-radius: 50px; text-decoration: none; font-weight: 600; transition: all 0.3s ease;
      display: inline-flex; align-items: center; gap: 0.5rem; background: white; color: #5d06ba; border: 2px solid white;
    }
    .btn-header:hover { background: rgba(255,255,255,0.9); transform: translateY(-2px); color: #2d0370; text-decoration: none; }
    .card-panel { background: white; border-radius: 20px; padding: 2rem; box-shadow: 0 4px 20px rgba(0,0,0,0.08); margin-bottom: 2rem; }
    .panel-title { font-size: 1.35rem; font-weight: 700; color: #2d0370; margin: 0 0 1.25rem; padding-bottom: .9rem; border-bottom: 2px solid #f0f0f0; display: flex; align-items: center; gap: .6rem; }
    .panel-title i { color: #5d06ba; }
    .panel-title .count { margin-left: auto; background: #ede0ff; color: #5d06ba; font-size: .85rem; padding: .2rem .7rem; border-radius: 50px; }
    .grant-form { display: flex; gap: .75rem; flex-wrap: wrap; align-items: flex-end; }
    .grant-form .field { flex: 1; min-width: 220px; }
    .grant-form label { display: block; font-weight: 600; color: #2d0370; margin-bottom: .5rem; font-size: .95rem; }
    .grant-form input { width: 100%; padding: .85rem 1rem; border: 2px solid #e0e0e0; border-radius: 12px; font-size: 1rem; background: #fafafa; }
    .grant-form input:focus { outline: none; border-color: #5d06ba; background: white; box-shadow: 0 0 0 4px rgba(93,6,186,.1); }
    .btn { padding: .8rem 1.4rem; border-radius: 50px; font-weight: 600; font-size: .95rem; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: .45rem; text-decoration: none; transition: all .25s ease; }
    .btn-primary { background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%); color: white; }
    .btn-primary:hover { transform: translateY(-2px); color: white; }
    .btn-success { background: #1e7e34; color: white; }
    .btn-danger { background: #c82333; color: white; }
    .btn-outline-danger { background: #fff; color: #c82333; border: 1px solid #f1aeb5; }
    .btn-sm { padding: .45rem .9rem; font-size: .85rem; }
    .data-table { width: 100%; border-collapse: collapse; }
    .data-table th { text-align: left; font-size: .8rem; text-transform: uppercase; letter-spacing: .03em; color: #888; padding: .6rem .75rem; border-bottom: 2px solid #f0f0f0; }
    .data-table td { padding: .85rem .75rem; border-bottom: 1px solid #f4f4f4; vertical-align: middle; }
    .data-table tr:last-child td { border-bottom: none; }
    .stu-name { font-weight: 600; color: #2d0370; }
    .stu-sub { font-size: .85rem; color: #777; }
    .status-pill { font-size: .78rem; font-weight: 600; padding: .2rem .7rem; border-radius: 50px; }
    .status-approved { background: #d4edda; color: #155724; }
    .status-rejected { background: #f8d7da; color: #721c24; }
    .empty { text-align: center; color: #999; padding: 1.5rem; font-style: italic; }
    .inline-form { display: inline; }
    .row-actions { display: flex; gap: .5rem; flex-wrap: wrap; }
    @media (max-width: 768px) {
      .page-header { padding: 2rem 1.5rem; }
      .card-panel { padding: 1.5rem; }
      .data-table thead { display: none; }
      .data-table, .data-table tbody, .data-table tr, .data-table td { display: block; width: 100%; }
      .data-table tr { border: 1px solid #f0f0f0; border-radius: 12px; margin-bottom: 1rem; padding: .5rem; }
      .data-table td { border-bottom: none; }
    }
  </style>
` %>

<div class="premium-page">
  <div class="container">
    <div class="page-header">
      <div>
        <h1><i class="bi bi-gem"></i> Gestion du premium</h1>
        <p><%= subject.title %></p>
        <span class="class-badge"><i class="bi bi-mortarboard"></i> <%= schoolClass.title %> - <%= schoolClass.serie %></span>
      </div>
      <a href="/programs/ekalan/kalan/admindashboard/kalan/class/<%= schoolClass._id %>/subjects" class="btn-header">
        <i class="bi bi-arrow-left"></i> Retour aux matières
      </a>
    </div>

    <%# ── Manual grant ─────────────────────────────── %>
    <div class="card-panel">
      <h2 class="panel-title"><i class="bi bi-person-plus"></i> Accorder l'accès manuellement</h2>
      <form class="grant-form" method="POST"
            action="/programs/ekalan/kalan/admindashboard/kalan/class/<%= schoolClass._id %>/subject/<%= subject._id %>/givepremiumaccess">
        <div class="field">
          <label for="student_username">Nom d'utilisateur de l'élève</label>
          <input type="text" id="student_username" name="student_username" placeholder="ex: aminata.diallo" required />
        </div>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Accorder l'accès</button>
      </form>
    </div>

    <%# ── Pending requests ─────────────────────────── %>
    <div class="card-panel">
      <h2 class="panel-title">
        <i class="bi bi-hourglass-split"></i> Demandes en attente
        <span class="count"><%= pendingRequests.length %></span>
      </h2>
      <% if (pendingRequests.length === 0) { %>
        <div class="empty">Aucune demande en attente pour cette matière.</div>
      <% } else { %>
        <table class="data-table">
          <thead><tr><th>Élève</th><th>Demandé le</th><th>Actions</th></tr></thead>
          <tbody>
            <% pendingRequests.forEach(function(r) { const u = r.studentId && r.studentId.studentBasicInfo; %>
              <tr>
                <td>
                  <div class="stu-name"><%= u ? `${u.surname || ''} ${u.name || ''}`.trim() || u.username : 'Élève inconnu' %></div>
                  <% if (u) { %><div class="stu-sub">@<%= u.username %><% if (u.email) { %> · <%= u.email %><% } %></div><% } %>
                </td>
                <td><%= new Date(r.createdAt).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                <td>
                  <div class="row-actions">
                    <form class="inline-form" method="POST"
                          action="/programs/ekalan/kalan/admindashboard/kalan/premium-requests/<%= r._id %>/approve">
                      <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> Approuver</button>
                    </form>
                    <form class="inline-form" method="POST"
                          action="/programs/ekalan/kalan/admindashboard/kalan/premium-requests/<%= r._id %>/reject"
                          onsubmit="return confirm('Rejeter cette demande ?');">
                      <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-x-lg"></i> Rejeter</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

    <%# ── Current premium students ─────────────────── %>
    <div class="card-panel">
      <h2 class="panel-title">
        <i class="bi bi-people-fill"></i> Élèves avec accès premium
        <span class="count"><%= (subject.premiumStudents || []).length %></span>
      </h2>
      <% if (!subject.premiumStudents || subject.premiumStudents.length === 0) { %>
        <div class="empty">Aucun élève n'a encore l'accès premium à cette matière.</div>
      <% } else { %>
        <table class="data-table">
          <thead><tr><th>Élève</th><th>Actions</th></tr></thead>
          <tbody>
            <% subject.premiumStudents.forEach(function(s) { const u = s && s.studentBasicInfo; %>
              <tr>
                <td>
                  <div class="stu-name"><%= u ? `${u.surname || ''} ${u.name || ''}`.trim() || u.username : 'Élève inconnu' %></div>
                  <% if (u) { %><div class="stu-sub">@<%= u.username %><% if (u.email) { %> · <%= u.email %><% } %></div><% } %>
                </td>
                <td>
                  <form class="inline-form" method="POST"
                        action="/programs/ekalan/kalan/admindashboard/kalan/class/<%= schoolClass._id %>/subject/<%= subject._id %>/premium/revoke/<%= s._id %>?_method=DELETE"
                        onsubmit="return confirm('Révoquer l\'accès premium de cet élève ?');">
                    <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-x-circle"></i> Révoquer</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

    <%# ── History ──────────────────────────────────── %>
    <div class="card-panel">
      <h2 class="panel-title">
        <i class="bi bi-clock-history"></i> Historique des demandes traitées
        <span class="count"><%= processedRequests.length %></span>
      </h2>
      <% if (processedRequests.length === 0) { %>
        <div class="empty">Aucune demande traitée.</div>
      <% } else { %>
        <table class="data-table">
          <thead><tr><th>Élève</th><th>Statut</th><th>Traité par</th><th>Le</th></tr></thead>
          <tbody>
            <% processedRequests.forEach(function(r) { const u = r.studentId && r.studentId.studentBasicInfo; const rv = r.reviewedBy; %>
              <tr>
                <td>
                  <div class="stu-name"><%= u ? `${u.surname || ''} ${u.name || ''}`.trim() || u.username : 'Élève inconnu' %></div>
                  <% if (u) { %><div class="stu-sub">@<%= u.username %></div><% } %>
                </td>
                <td>
                  <% if (r.status === 'approved') { %>
                    <span class="status-pill status-approved">Approuvée</span>
                  <% } else { %>
                    <span class="status-pill status-rejected">Rejetée</span>
                  <% } %>
                </td>
                <td><%= rv ? (`${rv.surname || ''} ${rv.name || ''}`.trim() || rv.username) : '—' %></td>
                <td><%= r.reviewedAt ? new Date(r.reviewedAt).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) : '—' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>
