<% layout('layouts/main') %>

<% headContent = `
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    /* Palette from the e-Kalan logo (same as the Kalan landing + class pages) */
    :root {
      --sp-sun: #ffc23a;
      --sp-sun-soft: #fff3d6;
      --sp-violet: #5e17eb;
      --sp-violet-dark: #4710c0;
      --sp-violet-soft: #efe7ff;
      --sp-navy: #322c4d;
      --sp-navy-deep: #231e38;
      --sp-cream: #fffaf0;
      --sp-muted: #6b6880;
      --sp-border: #ece9f3;
      --sp-radius: 22px;
    }

    #main { margin-top: 0 !important; padding-top: 0 !important; }

    .subject-page {
      margin-top: 72px;
      background: #fff;
      min-height: calc(100vh - 72px);
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      color: var(--sp-navy);
    }
    .subject-page h1, .subject-page h2, .subject-page h3 { font-family: 'Baloo 2', system-ui, sans-serif; }

    /* ───── Hero (light, logo-led) ───── */
    .sp-hero {
      position: relative; overflow: hidden;
      background: var(--sp-cream);
      padding: 1.75rem clamp(1rem, 4vw, 3rem) clamp(2.4rem, 5vw, 3.4rem);
    }
    /* yellow disc echoes the "e" circle of the logo */
    .sp-hero::before {
      content: ''; position: absolute; right: -150px; top: -190px;
      width: 440px; height: 440px; border-radius: 50%;
      background: var(--sp-sun); opacity: .9; pointer-events: none;
    }
    .sp-hero::after {
      content: ''; position: absolute; left: -90px; bottom: -130px;
      width: 240px; height: 240px; border-radius: 50%;
      border: 30px solid var(--sp-violet-soft); pointer-events: none;
    }
    .sp-hero__inner { max-width: 1240px; margin: 0 auto; position: relative; z-index: 2; }

    .sp-hero__top {
      display: flex; align-items: center; justify-content: space-between;
      gap: 1rem; flex-wrap: wrap; margin-bottom: 1.8rem;
    }
    .sp-breadcrumb {
      display: inline-flex; align-items: center; gap: .55rem; flex-wrap: wrap;
      font-size: .9rem; font-weight: 500; color: var(--sp-muted);
    }
    .sp-breadcrumb a {
      display: inline-flex; align-items: center; gap: .45rem;
      color: var(--sp-navy); text-decoration: none; font-weight: 600;
      background: #fff; border: 1px solid var(--sp-border);
      padding: .5rem .95rem; border-radius: 999px;
      box-shadow: 0 4px 14px rgba(50,44,77,.06);
      transition: transform .2s, border-color .2s, color .2s;
    }
    .sp-breadcrumb a:hover { transform: translateX(-3px); border-color: var(--sp-violet); color: var(--sp-violet); }
    .sp-breadcrumb .sep { opacity: .5; }
    .sp-breadcrumb .current { font-weight: 600; color: var(--sp-navy); }

    .sp-brand {
      display: inline-flex; align-items: center;
      background: #fff; border-radius: 16px; padding: .45rem .95rem;
      box-shadow: 0 12px 28px rgba(50,44,77,.16);
      transition: transform .2s;
    }
    .sp-brand:hover { transform: translateY(-2px); }
    .sp-brand img { display: block; height: 42px; width: auto; }

    .sp-hero__head {
      display: flex; align-items: flex-end; justify-content: space-between;
      gap: 2rem; flex-wrap: wrap;
    }
    .sp-eyebrow {
      display: inline-flex; align-items: center; gap: .45rem;
      font-size: .76rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase;
      color: var(--sp-violet); margin-bottom: .6rem;
    }
    .sp-eyebrow::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--sp-sun); }
    .sp-title {
      font-size: clamp(2.2rem, 5vw, 3.3rem); font-weight: 800; color: var(--sp-navy);
      margin: 0; line-height: 1.05;
    }
    .sp-subtitle {
      margin: .9rem 0 0; max-width: 580px;
      font-size: 1.04rem; line-height: 1.6; color: var(--sp-muted);
    }
    .sp-subtitle strong { color: var(--sp-navy); }
    .sp-meta { display: flex; gap: .6rem; margin-top: 1.3rem; flex-wrap: wrap; }
    .sp-meta__item {
      display: inline-flex; align-items: center; gap: .45rem;
      font-size: .86rem; font-weight: 600; color: var(--sp-navy);
      background: #fff; border: 1px solid var(--sp-border);
      padding: .42rem .85rem; border-radius: 999px;
    }
    .sp-meta__item i { color: var(--sp-violet); }
    .sp-meta__item--sun { background: var(--sp-sun-soft); border-color: #ffe3a3; }
    .sp-meta__item--sun i { color: #d99a00; }

    /* Tools */
    .sp-tools { display: flex; gap: .7rem; flex-wrap: wrap; }
    .sp-tool {
      display: inline-flex; align-items: center; gap: .6rem;
      padding: .8rem 1.25rem; border-radius: 50px; cursor: pointer;
      background: #fff; color: var(--sp-navy);
      border: 1.5px solid var(--sp-border);
      font-weight: 700; font-size: .92rem; font-family: inherit;
      box-shadow: 0 4px 14px rgba(50,44,77,.06);
      transition: background .2s, color .2s, border-color .2s, transform .2s, box-shadow .2s;
    }
    .sp-tool:hover {
      background: var(--sp-navy); color: #fff; border-color: var(--sp-navy);
      transform: translateY(-2px); box-shadow: 0 10px 24px rgba(50,44,77,.22);
    }
    .sp-tool i { font-size: 1.15rem; }

    /* ───── Chapters ───── */
    .chapters-section {
      max-width: 1040px; margin: 0 auto;
      padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 4vw, 2rem) 4rem;
    }
    /* keep the Kalan Ba / Naaba cards aligned with the chapter list */
    .chapters-section .kpc, .chapters-section .kn { max-width: none; }

    .sp-section-head { margin: .5rem 0 1.8rem; text-align: left; }
    .sp-section-head .tag {
      display: inline-flex; align-items: center; gap: .45rem;
      font-size: .76rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase;
      color: var(--sp-violet); margin-bottom: .4rem;
    }
    .sp-section-head .tag::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--sp-sun); }
    .sp-section-head h2 {
      font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0; padding: 0; line-height: 1.15; color: var(--sp-navy);
    }
    .sp-section-head h2::before, .sp-section-head h2::after { display: none; }
    .sp-section-head p { margin: .45rem 0 0; color: var(--sp-muted); font-size: 1rem; }

    .chapters-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }

    .chapter-card {
      background: #fff;
      border: 1px solid var(--sp-border);
      border-radius: var(--sp-radius);
      overflow: hidden;
      display: flex; align-items: stretch;
      box-shadow: 0 4px 20px rgba(50,44,77,.06);
      transition: transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s, border-color .35s;
    }
    .chapter-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 44px rgba(50,44,77,.14);
      border-color: #ddd4f5;
    }

    .chapter-image-wrapper {
      position: relative; width: 250px; min-width: 250px; flex-shrink: 0; overflow: hidden;
      background: var(--sp-violet);
    }
    .chapter-image { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
    .chapter-card:hover .chapter-image { transform: scale(1.07); }

    .chapter-image-placeholder {
      position: relative; overflow: hidden;
      width: 100%; height: 100%; min-height: 180px;
      display: flex; align-items: center; justify-content: center;
      background: var(--sp-violet);
    }
    .chapter-image-placeholder::before {
      content: ''; position: absolute; right: -45px; bottom: -55px;
      width: 160px; height: 160px; border-radius: 50%;
      background: var(--sp-sun); opacity: .9;
    }
    .chapter-image-placeholder i { position: relative; font-size: 3.2rem; color: #fff; }
    .chapter-card:nth-child(3n+2) .chapter-image-placeholder { background: var(--sp-navy); }
    .chapter-card:nth-child(3n+2) .chapter-image-placeholder i { color: var(--sp-sun); }
    .chapter-card:nth-child(3n) .chapter-image-placeholder { background: var(--sp-sun); }
    .chapter-card:nth-child(3n) .chapter-image-placeholder::before { background: var(--sp-violet); opacity: .85; }
    .chapter-card:nth-child(3n) .chapter-image-placeholder i { color: var(--sp-navy); }

    .chapter-number {
      position: absolute; top: .85rem; left: .85rem; z-index: 2;
      display: inline-flex; align-items: center; gap: .35rem;
      font-size: .78rem; font-weight: 800; letter-spacing: .02em;
      padding: .35rem .8rem; border-radius: 999px;
      background: #fff; color: var(--sp-navy);
      box-shadow: 0 4px 12px rgba(0,0,0,.16);
    }
    .chapter-number b { color: var(--sp-violet); }

    .chapter-content {
      padding: 1.5rem 1.6rem; flex: 1; min-width: 0;
      display: flex; flex-direction: column;
    }
    .chapter-title { font-size: 1.45rem; font-weight: 700; color: var(--sp-navy); margin: 0 0 1.1rem; line-height: 1.25; }

    .chapter-actions { margin-top: auto; display: flex; flex-wrap: wrap; gap: .6rem; }

    .btn-chapter {
      flex: 1 1 auto; white-space: nowrap;
      display: inline-flex; align-items: center; justify-content: center; gap: .55rem;
      padding: .8rem 1.1rem; border-radius: 50px;
      font-weight: 700; font-size: .93rem; text-decoration: none;
      border: 1.5px solid transparent; position: relative; overflow: hidden;
      transition: transform .2s, box-shadow .2s, background .2s, color .2s, border-color .2s;
    }
    .btn-chapter i { font-size: 1.1rem; }

    .btn-chapter-primary { background: var(--sp-violet); color: #fff; }
    .btn-chapter-primary:hover { background: var(--sp-violet-dark); color: #fff; transform: translateY(-2px); box-shadow: 0 10px 22px rgba(94,23,235,.32); }

    .btn-chapter-outline { background: #fff; color: var(--sp-navy); border-color: var(--sp-navy); }
    .btn-chapter-outline:hover { background: var(--sp-navy); color: #fff; transform: translateY(-2px); box-shadow: 0 10px 22px rgba(50,44,77,.22); }

    .btn-chapter-warning { background: var(--sp-sun); color: var(--sp-navy); }
    .btn-chapter-warning::before {
      content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,.45), transparent);
      transition: left .6s ease;
    }
    .btn-chapter-warning:hover::before { left: 100%; }
    .btn-chapter-warning:hover { color: var(--sp-navy); transform: translateY(-2px); box-shadow: 0 10px 22px rgba(255,194,58,.45); }
    .btn-chapter-warning i { animation: spSparkle 2.4s ease-in-out infinite; }
    @keyframes spSparkle { 0%,100% { transform: scale(1); } 50% { transform: scale(1.18); } }
    @media (prefers-reduced-motion: reduce) { .btn-chapter-warning i { animation: none; } }

    /* Empty state */
    .empty-state {
      text-align: center; padding: 4.5rem 2rem;
      background: var(--sp-cream); border: 1.5px dashed #ffe3a3;
      border-radius: var(--sp-radius);
    }
    .empty-state i { display: inline-flex; width: 84px; height: 84px; border-radius: 50%; align-items: center; justify-content: center;
      font-size: 2.4rem; color: var(--sp-navy); background: var(--sp-sun); margin-bottom: 1rem; }
    .empty-state h3 { font-size: 1.5rem; margin: 0 0 .4rem; color: var(--sp-navy); }
    .empty-state p { color: var(--sp-muted); margin: 0; }

    @media (max-width: 768px) {
      .sp-hero::before { width: 300px; height: 300px; right: -140px; top: -150px; }
      .sp-brand img { height: 32px; }
      .sp-tools { width: 100%; }
      .sp-tool { flex: 1 1 auto; justify-content: center; }
      .chapter-card { flex-direction: column; }
      .chapter-image-wrapper { width: 100%; min-width: 100%; height: 170px; }
      .chapter-content { padding: 1.25rem; }
      .chapter-title { font-size: 1.3rem; }
    }
  </style>
` %>

<% const chapterCount = (subject.chapters || []).length; %>

<div class="subject-page">

  <!-- ───── Hero ───── -->
  <header class="sp-hero">
    <div class="sp-hero__inner">
      <div class="sp-hero__top">
        <nav class="sp-breadcrumb" aria-label="Fil d'Ariane">
          <a href="/programs/ekalan/kalan/class/<%= schoolClass._id %>"><i class="bi bi-arrow-left"></i> <%= schoolClass.title %> <%= schoolClass.serie %></a>
          <span class="sep">/</span>
          <span class="current"><%= subject.title %></span>
        </nav>
        <a href="/programs/ekalan/kalan" class="sp-brand" aria-label="e-Kalan">
          <img src="/assets/img/logos/e-Kalan_logo/ekalan-card.png" alt="e-Kalan" width="480" height="157">
        </a>
      </div>

      <div class="sp-hero__head">
        <div>
          <span class="sp-eyebrow">Matière · <%= schoolClass.title %> <%= schoolClass.serie %></span>
          <h1 class="sp-title"><%= subject.title %></h1>
          <p class="sp-subtitle"><strong>Votre parcours vers l'excellence commence ici !</strong>
            Explorez chaque chapitre avec attention, pratiquez régulièrement les exercices
            et progressez étape par étape. Vous avez tout ce qu'il faut pour réussir.</p>
          <div class="sp-meta">
            <span class="sp-meta__item"><i class="bi bi-journal-bookmark-fill"></i> <%= chapterCount %> chapitre<%= chapterCount > 1 ? 's' : '' %></span>
            <% if (hasPremiumAccess) { %>
              <span class="sp-meta__item sp-meta__item--sun"><i class="bi bi-star-fill"></i> Kalan Ba activé</span>
            <% } %>
          </div>
        </div>

        <div class="sp-tools">
          <button type="button" class="sp-tool" data-bs-toggle="modal" data-bs-target="#graph-calc-modal">
            <i class="bi bi-graph-up"></i> Calc. Graphique
          </button>
          <button type="button" class="sp-tool" data-bs-toggle="modal" data-bs-target="#scien-calc-modal">
            <i class="bi bi-calculator"></i> Calc. Scientifique
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Calculator Modals -->
  <%- include('../../../../shared/partials/calculators/graphing-calculator-modal') %>
  <%- include('../../../../shared/partials/calculators/scientific-calculator-modal') %>

  <!-- ───── Chapters ───── -->
  <main class="chapters-section">

    <%# Premium access CTA (demande / statut) %>
    <%- include('../../../../partials/kalanPremiumCTA', { schoolClass, subject, hasPremiumAccess, hasPendingRequest }) %>

    <%# Kalan Naaba — upsell vers le bundle toute la classe %>
    <%- include('../../../../partials/kalanNaabaCTA', { schoolClass, naabaPrice, hasNaaba, naabaPending }) %>

    <div class="sp-section-head">
      <span class="tag">Programme national</span>
      <h2>Les chapitres</h2>
      <p>Suivez les cours dans l'ordre, puis entraînez-vous avec les exercices de chaque chapitre.</p>
    </div>

    <% if (chapterCount > 0) { %>
      <div class="chapters-grid">
        <% subject.chapters.forEach((chapter, i) => { %>
          <article class="chapter-card">
            <div class="chapter-image-wrapper">
              <% if (chapter.chapterImageUrl) { %>
                <img src="<%= chapter.chapterImageUrl %>" alt="<%= chapter.title %>" class="chapter-image" loading="lazy" />
              <% } else { %>
                <div class="chapter-image-placeholder"><i class="bi bi-journal-bookmark"></i></div>
              <% } %>
              <span class="chapter-number">Chapitre <b><%= i + 1 %></b></span>
            </div>

            <div class="chapter-content">
              <h3 class="chapter-title"><%= chapter.title %></h3>

              <div class="chapter-actions">
                <a href="/programs/ekalan/kalan/class/<%= schoolClass._id %>/subject/<%= subject._id %>/chapter/<%= chapter._id %>"
                   class="btn-chapter btn-chapter-primary">
                  <i class="bi bi-play-circle"></i> Contenu du cours
                </a>

                <a href="/programs/ekalan/kalan/class/<%= schoolClass._id %>/subject/<%= subject._id %>/chapter/<%= chapter._id %>/SE"
                   class="btn-chapter btn-chapter-outline">
                  <i class="bi bi-pencil-square"></i> Exercices d'apprentissage
                </a>

                <% if (hasPremiumAccess) { %>
                  <a href="/programs/ekalan/kalan/class/<%= schoolClass._id %>/subject/<%= subject._id %>/chapter/<%= chapter._id %>/PRE"
                     class="btn-chapter btn-chapter-warning">
                    <i class="bi bi-stars"></i> Kalan Ba
                  </a>
                <% } %>
              </div>
            </div>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <i class="bi bi-inbox"></i>
        <h3>Aucun chapitre disponible</h3>
        <p>Les chapitres de cette matière seront bientôt ajoutés. Veuillez revenir plus tard.</p>
      </div>
    <% } %>
  </main>
</div>
