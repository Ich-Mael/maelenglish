<% layout('layouts/main') %>

<% headContent = `
  <style>
    :root {
      --ch-brand: #5d06ba;
      --ch-brand-dark: #2d0370;
      --ch-brand-50: #f4eefe;
      --ch-brand-100: #e9d6fb;
      --ch-gold: #f0b429;
      --ch-ink: #1d1633;
      --ch-muted: #6b6880;
      --ch-bg: #f6f6fb;
      --ch-surface: #ffffff;
      --ch-border: #eceaf4;
      --ch-radius: 18px;
      --ch-shadow: 0 6px 24px rgba(45, 3, 112, 0.07);
      --ch-shadow-lg: 0 18px 44px rgba(45, 3, 112, 0.16);
    }

    #main { margin-top: 0 !important; padding-top: 0 !important; }

    .ch-page {
      margin-top: 72px;
      background: var(--ch-bg);
      min-height: calc(100vh - 72px);
      font-family: 'Outfit', system-ui, sans-serif;
      color: var(--ch-ink);
    }

    /* ───── Hero ───── */
    .ch-hero {
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(1100px 420px at 85% -40%, rgba(255,255,255,.18), transparent 60%),
        linear-gradient(135deg, #6a0fd6 0%, var(--ch-brand) 45%, var(--ch-brand-dark) 100%);
      color: #fff;
      padding: 1.5rem clamp(1rem, 4vw, 3rem) clamp(2.4rem, 5vw, 3.4rem);
    }
    .ch-hero::after {
      content: '';
      position: absolute; left: 0; right: 0; bottom: -1px; height: 40px;
      background: var(--ch-bg);
      border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    }
    .ch-hero__inner { max-width: 1240px; margin: 0 auto; position: relative; z-index: 2; }

    .ch-breadcrumb {
      display: inline-flex; align-items: center; gap: .55rem;
      font-size: .9rem; font-weight: 500; margin-bottom: 1.6rem;
    }
    .ch-breadcrumb a {
      display: inline-flex; align-items: center; gap: .45rem;
      color: #fff; text-decoration: none;
      background: rgba(255,255,255,.14);
      border: 1px solid rgba(255,255,255,.22);
      padding: .5rem .95rem; border-radius: 999px;
      transition: background .2s, transform .2s;
    }
    .ch-breadcrumb a:hover { background: rgba(255,255,255,.26); transform: translateX(-3px); color: #fff; }
    .ch-breadcrumb .sep { opacity: .5; }
    .ch-breadcrumb .current { opacity: .9; }

    .ch-hero__head {
      display: flex; align-items: flex-end; justify-content: space-between;
      gap: 2rem; flex-wrap: wrap;
    }
    .ch-title {
      font-size: clamp(2.1rem, 5vw, 3.2rem); font-weight: 700;
      margin: 0; letter-spacing: -.02em; line-height: 1.05;
      display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
    }
    .ch-serie {
      font-size: .9rem; font-weight: 600; letter-spacing: .02em;
      background: rgba(255,255,255,.16); border: 1px solid rgba(255,255,255,.28);
      padding: .4rem .9rem; border-radius: 999px; backdrop-filter: blur(6px);
    }
    .ch-subtitle {
      margin: .9rem 0 0; max-width: 560px;
      font-size: 1.02rem; font-weight: 300; line-height: 1.55; opacity: .92;
    }
    .ch-meta { display: flex; gap: 1.4rem; margin-top: 1.25rem; flex-wrap: wrap; }
    .ch-meta__item {
      display: inline-flex; align-items: center; gap: .5rem;
      font-size: .92rem; font-weight: 500; opacity: .95;
    }
    .ch-meta__item i { font-size: 1.05rem; opacity: .9; }

    /* Calculator toolbar */
    .ch-tools { display: flex; gap: .75rem; flex-wrap: wrap; }
    .ch-tool {
      display: inline-flex; align-items: center; gap: .65rem;
      padding: .8rem 1.3rem; border-radius: 14px; cursor: pointer;
      background: rgba(255,255,255,.14); color: #fff;
      border: 1px solid rgba(255,255,255,.26);
      font-weight: 600; font-size: .92rem; font-family: inherit;
      backdrop-filter: blur(8px);
      transition: background .2s, transform .2s, box-shadow .2s;
    }
    .ch-tool:hover {
      background: #fff; color: var(--ch-brand-dark);
      transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0,0,0,.2);
    }
    .ch-tool i { font-size: 1.25rem; }

    /* ───── Body ───── */
    .ch-body { max-width: 1240px; margin: 0 auto; padding: clamp(1.6rem, 4vw, 2.8rem) clamp(1rem, 4vw, 3rem) 4rem; }

    .ch-section-head { margin-bottom: 1.8rem; }
    .ch-section-head h2 {
      font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; margin: 0;
      display: flex; align-items: center; gap: .7rem; color: var(--ch-ink);
    }
    .ch-section-head h2 i { color: var(--ch-brand); }
    .ch-section-head p { margin: .5rem 0 0; color: var(--ch-muted); font-size: 1rem; max-width: 640px; }

    .ch-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
      gap: 1.5rem;
    }

    /* ───── Subject card ───── */
    .subj-card {
      background: var(--ch-surface);
      border: 1px solid var(--ch-border);
      border-radius: var(--ch-radius);
      display: flex; flex-direction: column;
      box-shadow: var(--ch-shadow);
      transition: transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s, border-color .35s;
    }
    .subj-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--ch-shadow-lg);
      border-color: var(--ch-brand-50);
    }
    /* Card with an open premium dropdown must paint above following cards */
    .subj-card .dropdown.show { position: relative; z-index: 50; }

    .subj-cover {
      position: relative; height: 158px; overflow: hidden;
      border-radius: var(--ch-radius) var(--ch-radius) 0 0;
    }
    .subj-cover img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
    .subj-card:hover .subj-cover img { transform: scale(1.07); }
    .subj-cover--ph {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      background:
        radial-gradient(120px 120px at 30% 20%, rgba(255,255,255,.14), transparent 70%),
        linear-gradient(135deg, var(--ch-brand) 0%, var(--ch-brand-dark) 100%);
    }
    .subj-cover--ph i { font-size: 3rem; color: rgba(255,255,255,.92); }
    .subj-cover::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(20,5,55,.28), transparent 55%);
    }

    .subj-pill {
      position: absolute; top: .8rem; right: .8rem; z-index: 2;
      display: inline-flex; align-items: center; gap: .35rem;
      font-size: .76rem; font-weight: 700; letter-spacing: .02em;
      padding: .35rem .7rem; border-radius: 999px;
      background: rgba(255,255,255,.95); color: var(--ch-brand-dark);
      box-shadow: 0 4px 12px rgba(0,0,0,.18);
    }
    .subj-pill i { color: var(--ch-gold); }

    .subj-body { padding: 1.25rem 1.25rem 1.4rem; flex: 1; display: flex; flex-direction: column; }
    .subj-title { font-size: 1.25rem; font-weight: 700; margin: 0 0 1rem; color: var(--ch-ink); }
    .subj-actions { margin-top: auto; display: flex; flex-direction: column; gap: .6rem; }

    .subj-btn {
      display: flex; align-items: center; justify-content: center; gap: .6rem;
      width: 100%; padding: .85rem 1rem; border-radius: 12px;
      font-weight: 600; font-size: .96rem; font-family: inherit;
      text-decoration: none; cursor: pointer; border: 1px solid transparent;
      transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    }
    .subj-btn i { font-size: 1.1rem; }

    .subj-btn--primary {
      background: linear-gradient(135deg, var(--ch-brand) 0%, var(--ch-brand-dark) 100%);
      color: #fff;
    }
    .subj-btn--primary:hover { transform: translateY(-2px); box-shadow: 0 10px 22px rgba(93,6,186,.34); color: #fff; }

    .subj-btn--premium {
      background: #15131f; color: var(--ch-gold);
      border-color: rgba(240,180,41,.45);
      position: relative; overflow: hidden;
    }
    .subj-btn--premium::before {
      content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(240,180,41,.22), transparent);
      transition: left .6s ease;
    }
    .subj-btn--premium:hover::before { left: 100%; }
    .subj-btn--premium:hover { color: var(--ch-gold); border-color: var(--ch-gold); transform: translateY(-2px); }
    .subj-btn--premium i { animation: subjSparkle 2.4s ease-in-out infinite; }
    @keyframes subjSparkle { 0%,100% { transform: scale(1); } 50% { transform: scale(1.18); } }

    .subj-btn--pending {
      background: #f3f4f6; color: #8b8a96; cursor: not-allowed; border-color: #ececf1;
    }

    .subj-pending-wrap { position: relative; }
    .subj-pending-wrap .tip {
      visibility: hidden; opacity: 0;
      position: absolute; bottom: 118%; left: 50%; transform: translateX(-50%);
      width: 220px; background: var(--ch-brand-dark); color: #fff;
      padding: .7rem .85rem; border-radius: 10px; font-size: .8rem; line-height: 1.4;
      text-align: center; z-index: 50; box-shadow: 0 8px 22px rgba(45,3,112,.3);
      transition: opacity .25s, visibility .25s;
    }
    .subj-pending-wrap .tip::after {
      content: ''; position: absolute; top: 100%; left: 50%; margin-left: -5px;
      border: 5px solid transparent; border-top-color: var(--ch-brand-dark);
    }
    .subj-pending-wrap:hover .tip { visibility: visible; opacity: 1; }

    /* Premium dropdown */
    .premium-dropdown-menu {
      min-width: 280px; padding: 0; border-radius: 16px; overflow: hidden;
      border: 1px solid var(--ch-border); box-shadow: 0 12px 36px rgba(45,3,112,.22);
    }
    .premium-dropdown-menu .dropdown-header {
      padding: 1.1rem 1rem; background: linear-gradient(135deg, var(--ch-brand) 0%, var(--ch-brand-dark) 100%); color: #fff;
    }
    .premium-dropdown-menu .dropdown-header strong { font-size: 1.05rem; display: block; margin-bottom: .35rem; }
    .premium-dropdown-menu .price-info { font-size: .88rem; opacity: .95; display: flex; align-items: center; gap: .4rem; }
    .premium-dropdown-menu .price-value { color: var(--ch-gold); font-weight: 700; }
    .premium-dropdown-menu .dropdown-item { padding: .85rem 1rem; display: flex; align-items: center; justify-content: space-between; gap: .5rem; transition: background .15s; }
    .premium-dropdown-menu .dropdown-item:hover { background: var(--ch-brand-50); }
    .premium-dropdown-menu .dropdown-item-content { display: flex; align-items: center; gap: .65rem; color: var(--ch-ink); }
    .premium-dropdown-menu .dropdown-item-content i { font-size: 1.3rem; width: 22px; text-align: center; }
    .premium-dropdown-menu .btn-contact-whatsapp:hover .dropdown-item-content { color: #25D366; }
    .premium-dropdown-menu .btn-contact-phone:hover .dropdown-item-content { color: var(--ch-brand); }
    .premium-dropdown-menu .phone-number { font-size: .9rem; color: var(--ch-muted); font-weight: 600; font-family: 'Courier New', monospace; }
    .premium-dropdown-menu .dropdown-item-text {
      background: var(--ch-brand-50); border-top: 1px solid var(--ch-border);
      color: var(--ch-muted); padding: .7rem 1rem; font-size: .8rem; display: flex; align-items: center; gap: .5rem;
    }
    .premium-dropdown-menu .dropdown-item-text i { color: var(--ch-brand); }
    .premium-dropdown-menu .dropdown-divider { margin: 0; border-color: var(--ch-border); }
    .premium-dropdown-menu a { text-decoration: none; }
    .premium-dropdown-menu .request-form { padding: .65rem .85rem; }
    .premium-dropdown-menu .dropdown-request-btn {
      width: 100%; border: none; cursor: pointer; border-radius: 12px; padding: .8rem 1rem;
      font-weight: 700; font-size: .95rem; color: #fff; display: flex; align-items: center; justify-content: center; gap: .55rem;
      background: linear-gradient(135deg, var(--ch-brand) 0%, #2d0370 100%); transition: transform .2s, box-shadow .2s;
    }
    .premium-dropdown-menu .dropdown-request-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(93,6,186,.35); }
    .premium-dropdown-menu .contact-label { font-size: .8rem; color: var(--ch-muted); padding: .35rem 1rem 0; display: flex; align-items: center; gap: .4rem; }

    /* Empty state */
    .ch-empty {
      text-align: center; padding: 4.5rem 2rem;
      background: var(--ch-surface); border: 1px dashed var(--ch-border);
      border-radius: var(--ch-radius); grid-column: 1 / -1;
    }
    .ch-empty i { font-size: 3.5rem; color: var(--ch-brand-100); margin-bottom: 1rem; }
    .ch-empty h3 { font-size: 1.4rem; margin: 0 0 .5rem; color: var(--ch-ink); }
    .ch-empty p { color: var(--ch-muted); margin: 0; }

    @media (max-width: 640px) {
      .ch-hero__head { align-items: flex-start; }
      .ch-tools { width: 100%; }
      .ch-tool { flex: 1; justify-content: center; }
    }
  </style>
` %>

<div class="ch-page">

  <!-- ───── Hero ───── -->
  <header class="ch-hero">
    <div class="ch-hero__inner">
      <nav class="ch-breadcrumb" aria-label="Fil d'Ariane">
        <a href="/programs/ekalan/kalan"><i class="bi bi-arrow-left"></i> Kalan</a>
        <span class="sep">/</span>
        <span class="current"><%= schoolClass.title %> <%= schoolClass.serie %></span>
      </nav>

      <div class="ch-hero__head">
        <div>
          <h1 class="ch-title">
            <%= schoolClass.title %>
            <% if (schoolClass.serie) { %><span class="ch-serie">Série <%= schoolClass.serie %></span><% } %>
          </h1>
          <p class="ch-subtitle">Étudiez et révisez à votre rythme. Accédez à toutes vos matières et progressez dans votre apprentissage.</p>
          <% const subjectCount = (schoolClass.subjects || []).length; %>
          <% const premiumCount = (schoolClass.subjects || []).filter(s => s.hasPremiumAccess).length; %>
          <div class="ch-meta">
            <span class="ch-meta__item"><i class="bi bi-journal-bookmark-fill"></i> <%= subjectCount %> matière<%= subjectCount > 1 ? 's' : '' %></span>
            <% if (premiumCount > 0) { %>
              <span class="ch-meta__item"><i class="bi bi-star-fill"></i> <%= premiumCount %> avec accès premium</span>
            <% } %>
          </div>
        </div>

        <div class="ch-tools">
          <button type="button" class="ch-tool" data-bs-toggle="modal" data-bs-target="#graph-calc-modal">
            <i class="bi bi-graph-up"></i> Calc. Graphique
          </button>
          <button type="button" class="ch-tool" data-bs-toggle="modal" data-bs-target="#scien-calc-modal">
            <i class="bi bi-calculator"></i> Calc. Scientifique
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Calculator Modals -->
  <%- include('../../../shared/partials/calculators/graphing-calculator-modal') %>
  <%- include('../../../shared/partials/calculators/scientific-calculator-modal') %>

  <!-- ───── Subjects ───── -->
  <main class="ch-body">
    <div class="ch-section-head">
      <h2><i class="bi bi-grid-1x2-fill"></i> Matières disponibles</h2>
      <p>Explorez les matières de votre classe et accédez à tout le contenu pédagogique.</p>
    </div>

    <% if (schoolClass.subjects && schoolClass.subjects.length > 0) { %>
      <div class="ch-grid">
        <% schoolClass.subjects.forEach(subject => { %>
          <article class="subj-card">
            <div class="subj-cover">
              <% if (subject.subjectImageUrl) { %>
                <img src="<%= subject.subjectImageUrl %>" alt="<%= subject.title %>" loading="lazy" />
              <% } else { %>
                <div class="subj-cover--ph"><i class="bi bi-journal-text"></i></div>
              <% } %>
              <% if (subject.hasPremiumAccess) { %>
                <span class="subj-pill"><i class="bi bi-star-fill"></i> Premium</span>
              <% } %>
            </div>

            <div class="subj-body">
              <h3 class="subj-title"><%= subject.title %></h3>

              <div class="subj-actions">
                <a href="/programs/ekalan/kalan/class/<%= schoolClass._id %>/subject/<%= subject._id %>" class="subj-btn subj-btn--primary">
                  <i class="bi bi-arrow-right-circle"></i> Accéder au contenu
                </a>

                <% if (!subject.hasPremiumAccess && currentUser && currentUser.highSchool_id) { %>
                  <% if (subject.hasPendingRequest) { %>
                    <div class="subj-pending-wrap">
                      <button class="subj-btn subj-btn--pending" disabled>
                        <i class="bi bi-clock-history"></i> Demande en attente
                      </button>
                      <span class="tip">Votre demande est en cours de traitement. Vous serez notifié une fois approuvée.</span>
                    </div>
                  <% } else { %>
                    <% const subjPrice = Number(subject.premiumPrice || 2000); %>
                    <div class="dropdown">
                      <button class="subj-btn subj-btn--premium dropdown-toggle" type="button"
                              id="premiumDropdown<%= subject._id %>" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-star-fill"></i> <span>Débloquer le Premium</span>
                      </button>
                      <ul class="dropdown-menu premium-dropdown-menu" aria-labelledby="premiumDropdown<%= subject._id %>">
                        <li class="dropdown-header">
                          <strong><%= subject.title %></strong>
                          <div class="price-info"><span>Prix :</span> <span class="price-value"><%= subjPrice.toLocaleString('fr-FR') %> FCFA</span></div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                          <form class="request-form" method="POST"
                                action="/programs/ekalan/kalan/class/<%= schoolClass._id %>/subject/<%= subject._id %>/request-premium-access">
                            <button type="submit" class="dropdown-request-btn">
                              <i class="bi bi-send-fill"></i> Demander l'accès premium
                            </button>
                          </form>
                        </li>
                        <li class="contact-label"><i class="bi bi-headset"></i> Ou contactez-nous directement :</li>
                        <li>
                          <a class="dropdown-item btn-contact-whatsapp" target="_blank"
                             href="https://wa.me/22653344444?text=<%= encodeURIComponent(`Bonjour, je souhaite obtenir l'accès premium pour la matière ${subject.title} (Classe: ${schoolClass.title} ${schoolClass.serie}). Prix: ${subjPrice.toLocaleString('fr-FR')} FCFA`) %>">
                            <div class="dropdown-item-content"><i class="bi bi-whatsapp"></i><span>Écrire sur WhatsApp</span></div>
                          </a>
                        </li>
                        <li>
                          <a class="dropdown-item btn-contact-phone" href="tel:+22653344444">
                            <div class="dropdown-item-content"><i class="bi bi-telephone-fill"></i><span>Appeler</span></div>
                            <span class="phone-number">+226 53 34 44 44</span>
                          </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li class="dropdown-item-text">
                          <i class="bi bi-info-circle"></i><span>Activation sous 24h après paiement</span>
                        </li>
                      </ul>
                    </div>
                  <% } %>
                <% } %>
              </div>
            </div>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <div class="ch-empty">
        <i class="bi bi-inbox"></i>
        <h3>Aucune matière disponible</h3>
        <p>Les matières de cette classe seront bientôt ajoutées. Revenez plus tard.</p>
      </div>
    <% } %>
  </main>
</div>
