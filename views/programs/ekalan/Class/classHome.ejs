<% layout('layouts/main') %>

<% headContent = `
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    /* Palette from the e-Kalan logo (same as the Kalan landing page) */
    :root {
      --ch-sun: #ffc23a;
      --ch-sun-soft: #fff3d6;
      --ch-violet: #5e17eb;
      --ch-violet-dark: #4710c0;
      --ch-violet-soft: #efe7ff;
      --ch-navy: #322c4d;
      --ch-navy-deep: #231e38;
      --ch-cream: #fffaf0;
      --ch-ink: #322c4d;
      --ch-muted: #6b6880;
      --ch-bg: #ffffff;
      --ch-surface: #ffffff;
      --ch-border: #ece9f3;
      --ch-radius: 22px;
      --ch-shadow: 0 4px 20px rgba(50, 44, 77, 0.06);
      --ch-shadow-lg: 0 20px 44px rgba(50, 44, 77, 0.14);
    }

    #main { margin-top: 0 !important; padding-top: 0 !important; }

    .ch-page {
      margin-top: 72px;
      background: var(--ch-bg);
      min-height: calc(100vh - 72px);
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      color: var(--ch-ink);
    }
    .ch-page h1, .ch-page h2, .ch-page h3 { font-family: 'Baloo 2', system-ui, sans-serif; }

    /* ───── Hero (light, logo-led) ───── */
    .ch-hero {
      position: relative;
      overflow: hidden;
      background: var(--ch-cream);
      padding: 1.75rem clamp(1rem, 4vw, 3rem) clamp(2.4rem, 5vw, 3.4rem);
    }
    /* yellow disc echoes the "e" circle of the logo */
    .ch-hero::before {
      content: ''; position: absolute; right: -150px; top: -190px;
      width: 440px; height: 440px; border-radius: 50%;
      background: var(--ch-sun); opacity: .9; pointer-events: none;
    }
    .ch-hero::after {
      content: ''; position: absolute; left: -90px; bottom: -130px;
      width: 240px; height: 240px; border-radius: 50%;
      border: 30px solid var(--ch-violet-soft); pointer-events: none;
    }
    .ch-hero__inner { max-width: 1240px; margin: 0 auto; position: relative; z-index: 2; }

    .ch-hero__top {
      display: flex; align-items: center; justify-content: space-between;
      gap: 1rem; flex-wrap: wrap; margin-bottom: 1.8rem;
    }
    .ch-breadcrumb {
      display: inline-flex; align-items: center; gap: .55rem;
      font-size: .9rem; font-weight: 500; color: var(--ch-muted);
    }
    .ch-breadcrumb a {
      display: inline-flex; align-items: center; gap: .45rem;
      color: var(--ch-navy); text-decoration: none; font-weight: 600;
      background: #fff; border: 1px solid var(--ch-border);
      padding: .5rem .95rem; border-radius: 999px;
      box-shadow: 0 4px 14px rgba(50,44,77,.06);
      transition: transform .2s, border-color .2s, color .2s;
    }
    .ch-breadcrumb a:hover { transform: translateX(-3px); border-color: var(--ch-violet); color: var(--ch-violet); }
    .ch-breadcrumb .sep { opacity: .5; }
    .ch-breadcrumb .current { font-weight: 600; color: var(--ch-navy); }

    .ch-brand {
      display: inline-flex; align-items: center;
      background: #fff; border-radius: 16px; padding: .45rem .95rem;
      box-shadow: 0 12px 28px rgba(50,44,77,.16);
      transition: transform .2s;
    }
    .ch-brand:hover { transform: translateY(-2px); }
    .ch-brand img { display: block; height: 42px; width: auto; }

    .ch-hero__head {
      display: flex; align-items: flex-end; justify-content: space-between;
      gap: 2rem; flex-wrap: wrap;
    }
    .ch-eyebrow {
      display: inline-flex; align-items: center; gap: .45rem;
      font-size: .76rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase;
      color: var(--ch-violet); margin-bottom: .6rem;
    }
    .ch-eyebrow::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--ch-sun); }
    .ch-title {
      font-size: clamp(2.2rem, 5vw, 3.3rem); font-weight: 800; color: var(--ch-navy);
      margin: 0; line-height: 1.05;
      display: flex; align-items: center; gap: .9rem; flex-wrap: wrap;
    }
    .ch-serie {
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      font-size: .88rem; font-weight: 700; letter-spacing: .02em;
      background: var(--ch-violet); color: #fff;
      padding: .4rem .9rem; border-radius: 999px;
    }
    .ch-subtitle {
      margin: .9rem 0 0; max-width: 560px;
      font-size: 1.04rem; line-height: 1.6; color: var(--ch-muted);
    }
    .ch-meta { display: flex; gap: .6rem; margin-top: 1.3rem; flex-wrap: wrap; }
    .ch-meta__item {
      display: inline-flex; align-items: center; gap: .45rem;
      font-size: .86rem; font-weight: 600; color: var(--ch-navy);
      background: #fff; border: 1px solid var(--ch-border);
      padding: .42rem .85rem; border-radius: 999px;
    }
    .ch-meta__item i { color: var(--ch-violet); }
    .ch-meta__item--sun { background: var(--ch-sun-soft); border-color: #ffe3a3; }
    .ch-meta__item--sun i { color: #d99a00; }

    /* Tools */
    .ch-tools { display: flex; gap: .7rem; flex-wrap: wrap; }
    .ch-tool {
      display: inline-flex; align-items: center; gap: .6rem;
      padding: .8rem 1.25rem; border-radius: 50px; cursor: pointer;
      background: #fff; color: var(--ch-navy);
      border: 1.5px solid var(--ch-border);
      font-weight: 700; font-size: .92rem; font-family: inherit; text-decoration: none;
      box-shadow: 0 4px 14px rgba(50,44,77,.06);
      transition: background .2s, color .2s, border-color .2s, transform .2s, box-shadow .2s;
    }
    .ch-tool:hover {
      background: var(--ch-navy); color: #fff; border-color: var(--ch-navy);
      transform: translateY(-2px); box-shadow: 0 10px 24px rgba(50,44,77,.22);
    }
    .ch-tool i { font-size: 1.15rem; }
    .ch-tool--lab { background: var(--ch-sun); border-color: var(--ch-sun); color: var(--ch-navy); box-shadow: 0 10px 24px rgba(255,194,58,.4); }
    .ch-tool--lab:hover { background: var(--ch-sun); border-color: var(--ch-sun); color: var(--ch-navy); box-shadow: 0 14px 30px rgba(255,194,58,.5); }

    /* ───── Body ───── */
    .ch-body { max-width: 1240px; margin: 0 auto; padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 4vw, 3rem) 4rem; }

    .ch-section-head { margin-bottom: 1.8rem; }
    .ch-section-head .tag {
      display: inline-flex; align-items: center; gap: .45rem;
      font-size: .76rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase;
      color: var(--ch-violet); margin-bottom: .4rem;
    }
    .ch-section-head .tag::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--ch-sun); }
    .ch-section-head h2 {
      font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0; line-height: 1.15; color: var(--ch-navy);
    }
    .ch-section-head p { margin: .45rem 0 0; color: var(--ch-muted); font-size: 1rem; max-width: 640px; }

    .ch-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
      gap: 1.5rem;
    }

    /* ───── Subject card ───── */
    .subj-card {
      background: var(--ch-surface);
      border: 1px solid var(--ch-border);
      border-radius: var(--ch-radius);
      display: flex; flex-direction: column;
      box-shadow: var(--ch-shadow);
      transition: transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s, border-color .35s;
    }
    .subj-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--ch-shadow-lg);
      border-color: #ddd4f5;
    }
    /* Card with an open premium dropdown must paint above following cards */
    .subj-card .dropdown.show { position: relative; z-index: 50; }

    .subj-cover {
      position: relative; height: 158px; overflow: hidden;
      border-radius: var(--ch-radius) var(--ch-radius) 0 0;
    }
    .subj-cover img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
    .subj-card:hover .subj-cover img { transform: scale(1.07); }
    .subj-cover--ph {
      position: relative; overflow: hidden;
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      background: var(--ch-violet);
    }
    .subj-cover--ph::before {
      content: ''; position: absolute; right: -40px; top: -50px;
      width: 150px; height: 150px; border-radius: 50%;
      background: var(--ch-sun); opacity: .9;
    }
    .subj-cover--ph i { position: relative; font-size: 3rem; color: #fff; }
    .subj-card:nth-child(3n+2) .subj-cover--ph { background: var(--ch-navy); }
    .subj-card:nth-child(3n+2) .subj-cover--ph i { color: var(--ch-sun); }
    .subj-card:nth-child(3n) .subj-cover--ph { background: var(--ch-sun); }
    .subj-card:nth-child(3n) .subj-cover--ph::before { background: var(--ch-violet); opacity: .85; }
    .subj-card:nth-child(3n) .subj-cover--ph i { color: var(--ch-navy); }
    .subj-cover::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(35,30,56,.22), transparent 55%);
    }

    .subj-pill {
      position: absolute; top: .8rem; right: .8rem; z-index: 2;
      display: inline-flex; align-items: center; gap: .35rem;
      font-size: .76rem; font-weight: 800; letter-spacing: .02em;
      padding: .35rem .75rem; border-radius: 999px;
      background: var(--ch-sun); color: var(--ch-navy);
      box-shadow: 0 4px 12px rgba(0,0,0,.18);
    }

    .subj-body { padding: 1.25rem 1.25rem 1.4rem; flex: 1; display: flex; flex-direction: column; }
    .subj-title { font-size: 1.35rem; font-weight: 700; margin: 0 0 1rem; color: var(--ch-navy); line-height: 1.25; }
    .subj-actions { margin-top: auto; display: flex; flex-direction: column; gap: .6rem; }

    .subj-btn {
      display: flex; align-items: center; justify-content: center; gap: .6rem;
      width: 100%; padding: .85rem 1rem; border-radius: 50px;
      font-weight: 700; font-size: .95rem; font-family: inherit;
      text-decoration: none; cursor: pointer; border: 1.5px solid transparent;
      transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    }
    .subj-btn i { font-size: 1.1rem; }

    .subj-btn--primary { background: var(--ch-violet); color: #fff; }
    .subj-btn--primary:hover { background: var(--ch-violet-dark); transform: translateY(-2px); box-shadow: 0 10px 22px rgba(94,23,235,.32); color: #fff; }

    .subj-btn--premium {
      background: var(--ch-navy); color: var(--ch-sun);
      position: relative; overflow: hidden;
    }
    .subj-btn--premium::before {
      content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,194,58,.22), transparent);
      transition: left .6s ease;
    }
    .subj-btn--premium:hover::before { left: 100%; }
    .subj-btn--premium:hover { color: var(--ch-sun); background: var(--ch-navy-deep); transform: translateY(-2px); box-shadow: 0 10px 22px rgba(50,44,77,.28); }
    .subj-btn--premium i { animation: subjSparkle 2.4s ease-in-out infinite; }
    @keyframes subjSparkle { 0%,100% { transform: scale(1); } 50% { transform: scale(1.18); } }
    @media (prefers-reduced-motion: reduce) { .subj-btn--premium i { animation: none; } }

    .subj-btn--pending {
      background: var(--ch-sun-soft); color: #9a6b00; cursor: not-allowed; border-color: #ffe3a3;
    }

    .subj-pending-wrap { position: relative; }
    .subj-pending-wrap .tip {
      visibility: hidden; opacity: 0;
      position: absolute; bottom: 118%; left: 50%; transform: translateX(-50%);
      width: 220px; background: var(--ch-navy); color: #fff;
      padding: .7rem .85rem; border-radius: 10px; font-size: .8rem; line-height: 1.4;
      text-align: center; z-index: 50; box-shadow: 0 8px 22px rgba(50,44,77,.3);
      transition: opacity .25s, visibility .25s;
    }
    .subj-pending-wrap .tip::after {
      content: ''; position: absolute; top: 100%; left: 50%; margin-left: -5px;
      border: 5px solid transparent; border-top-color: var(--ch-navy);
    }
    .subj-pending-wrap:hover .tip { visibility: visible; opacity: 1; }

    /* Premium dropdown */
    .premium-dropdown-menu {
      min-width: 280px; padding: 0; border-radius: 16px; overflow: hidden;
      border: 1px solid var(--ch-border); box-shadow: 0 14px 36px rgba(50,44,77,.22);
    }
    .premium-dropdown-menu .dropdown-header {
      padding: 1.1rem 1rem; background: var(--ch-navy); color: #fff;
    }
    .premium-dropdown-menu .dropdown-header strong { font-size: 1.05rem; display: block; margin-bottom: .35rem; }
    .premium-dropdown-menu .dropdown-header strong i { color: var(--ch-sun); }
    .premium-dropdown-menu .price-info { font-size: .88rem; opacity: .95; display: flex; align-items: center; gap: .4rem; }
    .premium-dropdown-menu .price-value { color: var(--ch-sun); font-weight: 800; }
    .premium-dropdown-menu .dropdown-item { padding: .85rem 1rem; display: flex; align-items: center; justify-content: space-between; gap: .5rem; transition: background .15s; }
    .premium-dropdown-menu .dropdown-item:hover { background: var(--ch-violet-soft); }
    .premium-dropdown-menu .dropdown-item-content { display: flex; align-items: center; gap: .65rem; color: var(--ch-ink); }
    .premium-dropdown-menu .dropdown-item-content i { font-size: 1.3rem; width: 22px; text-align: center; }
    .premium-dropdown-menu .btn-contact-whatsapp:hover .dropdown-item-content { color: #25D366; }
    .premium-dropdown-menu .btn-contact-phone:hover .dropdown-item-content { color: var(--ch-violet); }
    .premium-dropdown-menu .phone-number { font-size: .9rem; color: var(--ch-muted); font-weight: 600; font-family: 'Courier New', monospace; }
    .premium-dropdown-menu .dropdown-item-text {
      background: var(--ch-sun-soft); border-top: 1px solid var(--ch-border);
      color: var(--ch-muted); padding: .7rem 1rem; font-size: .8rem; display: flex; align-items: center; gap: .5rem;
    }
    .premium-dropdown-menu .dropdown-item-text i { color: #d99a00; }
    .premium-dropdown-menu .dropdown-divider { margin: 0; border-color: var(--ch-border); }
    .premium-dropdown-menu a { text-decoration: none; }
    .premium-dropdown-menu .request-form { padding: .65rem .85rem; }
    .premium-dropdown-menu .dropdown-request-btn {
      width: 100%; border: none; cursor: pointer; border-radius: 50px; padding: .8rem 1rem;
      font-weight: 700; font-size: .95rem; color: #fff; display: flex; align-items: center; justify-content: center; gap: .55rem;
      background: var(--ch-violet); transition: transform .2s, box-shadow .2s, background .2s;
    }
    .premium-dropdown-menu .dropdown-request-btn:hover { background: var(--ch-violet-dark); transform: translateY(-2px); box-shadow: 0 6px 18px rgba(94,23,235,.35); }
    .premium-dropdown-menu .contact-label { font-size: .8rem; color: var(--ch-muted); padding: .35rem 1rem 0; display: flex; align-items: center; gap: .4rem; }

    /* Empty state */
    .ch-empty {
      text-align: center; padding: 4.5rem 2rem;
      background: var(--ch-cream); border: 1.5px dashed #ffe3a3;
      border-radius: var(--ch-radius); grid-column: 1 / -1;
    }
    .ch-empty i { display: inline-flex; width: 84px; height: 84px; border-radius: 50%; align-items: center; justify-content: center;
      font-size: 2.4rem; color: var(--ch-navy); background: var(--ch-sun); margin-bottom: 1rem; }
    .ch-empty h3 { font-size: 1.5rem; margin: 0 0 .4rem; color: var(--ch-navy); }
    .ch-empty p { color: var(--ch-muted); margin: 0; }

    @media (max-width: 640px) {
      .ch-hero::before { width: 300px; height: 300px; right: -140px; top: -150px; }
      .ch-hero__head { align-items: flex-start; }
      .ch-brand img { height: 32px; }
      .ch-tools { width: 100%; }
      .ch-tool { flex: 1 1 auto; justify-content: center; }
    }
  </style>
` %>

<div class="ch-page">

  <!-- ───── Hero ───── -->
  <header class="ch-hero">
    <div class="ch-hero__inner">
      <div class="ch-hero__top">
        <nav class="ch-breadcrumb" aria-label="Fil d'Ariane">
          <a href="/programs/ekalan/kalan"><i class="bi bi-arrow-left"></i> Kalan</a>
          <span class="sep">/</span>
          <span class="current"><%= schoolClass.title %> <%= schoolClass.serie %></span>
        </nav>
        <a href="/programs/ekalan/kalan" class="ch-brand" aria-label="e-Kalan">
          <img src="/assets/img/logos/e-Kalan_logo/ekalan-card.png" alt="e-Kalan" width="480" height="157">
        </a>
      </div>

      <div class="ch-hero__head">
        <div>
          <span class="ch-eyebrow">Mon espace Kalan</span>
          <h1 class="ch-title">
            <%= schoolClass.title %>
            <% if (schoolClass.serie) { %><span class="ch-serie">Série <%= schoolClass.serie %></span><% } %>
          </h1>
          <p class="ch-subtitle">Étudiez et révisez à votre rythme. Accédez à toutes vos matières et progressez dans votre apprentissage.</p>
          <% const subjectCount = (schoolClass.subjects || []).length; %>
          <% const premiumCount = (schoolClass.subjects || []).filter(s => s.hasPremiumAccess).length; %>
          <div class="ch-meta">
            <span class="ch-meta__item"><i class="bi bi-journal-bookmark-fill"></i> <%= subjectCount %> matière<%= subjectCount > 1 ? 's' : '' %></span>
            <% if (premiumCount > 0) { %>
              <span class="ch-meta__item ch-meta__item--sun"><i class="bi bi-star-fill"></i> <%= premiumCount %> avec Kalan Ba</span>
            <% } %>
          </div>
        </div>

        <div class="ch-tools">
          <% if (typeof hasMathsLab !== 'undefined' && hasMathsLab) { %>
            <a href="/programs/ekalan/kalan/class/<%= schoolClass._id %>/maths-lab" class="ch-tool ch-tool--lab">
              <i class="bi bi-stars"></i> Kalan Maths Lab
            </a>
          <% } %>
          <button type="button" class="ch-tool" data-bs-toggle="modal" data-bs-target="#graph-calc-modal">
            <i class="bi bi-graph-up"></i> Calc. Graphique
          </button>
          <button type="button" class="ch-tool" data-bs-toggle="modal" data-bs-target="#scien-calc-modal">
            <i class="bi bi-calculator"></i> Calc. Scientifique
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Calculator Modals -->
  <%- include('../../../shared/partials/calculators/graphing-calculator-modal') %>
  <%- include('../../../shared/partials/calculators/scientific-calculator-modal') %>

  <!-- ───── Subjects ───── -->
  <main class="ch-body">
    <div class="ch-section-head">
      <span class="tag">Mes matières</span>
      <h2>Matières disponibles</h2>
      <p>Explorez les matières de votre classe et accédez à tout le contenu pédagogique.</p>
    </div>

    <%# Kalan Naaba — accès premium à toute la classe (bundle) %>
    <%- include('../../../partials/kalanNaabaCTA', { schoolClass, naabaPrice, hasNaaba, naabaPending }) %>

    <% if (schoolClass.subjects && schoolClass.subjects.length > 0) { %>
      <div class="ch-grid">
        <% schoolClass.subjects.forEach(subject => { %>
          <article class="subj-card">
            <div class="subj-cover">
              <% if (subject.subjectImageUrl) { %>
                <img src="<%= subject.subjectImageUrl %>" alt="<%= subject.title %>" loading="lazy" />
              <% } else { %>
                <div class="subj-cover--ph"><i class="bi bi-journal-text"></i></div>
              <% } %>
              <% if (subject.hasPremiumAccess) { %>
                <span class="subj-pill"><i class="bi bi-star-fill"></i> Kalan Ba</span>
              <% } %>
            </div>

            <div class="subj-body">
              <h3 class="subj-title"><%= subject.title %></h3>

              <div class="subj-actions">
                <a href="/programs/ekalan/kalan/class/<%= schoolClass._id %>/subject/<%= subject._id %>" class="subj-btn subj-btn--primary">
                  <i class="bi bi-arrow-right-circle"></i> Accéder au contenu
                </a>

                <% if (!subject.hasPremiumAccess && currentUser && currentUser.highSchool_id) { %>
                  <% if (subject.hasPendingRequest) { %>
                    <div class="subj-pending-wrap">
                      <button class="subj-btn subj-btn--pending" disabled>
                        <i class="bi bi-clock-history"></i> Demande en attente
                      </button>
                      <span class="tip">Votre demande est en cours de traitement. Vous serez notifié une fois approuvée.</span>
                    </div>
                  <% } else { %>
                    <% const subjPrice = Number(subject.premiumPrice || 2000); %>
                    <div class="dropdown">
                      <button class="subj-btn subj-btn--premium dropdown-toggle" type="button"
                              id="premiumDropdown<%= subject._id %>" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-star-fill"></i> <span>Débloquer Kalan Ba</span>
                      </button>
                      <ul class="dropdown-menu premium-dropdown-menu" aria-labelledby="premiumDropdown<%= subject._id %>">
                        <li class="dropdown-header">
                          <strong><i class="bi bi-stars"></i> Kalan Ba — <%= subject.title %></strong>
                          <div class="price-info"><span>Prix :</span> <span class="price-value"><%= subjPrice.toLocaleString('fr-FR') %> FCFA</span></div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                          <form class="request-form" method="POST"
                                action="/programs/ekalan/kalan/class/<%= schoolClass._id %>/subject/<%= subject._id %>/request-premium-access">
                            <button type="submit" class="dropdown-request-btn">
                              <i class="bi bi-send-fill"></i> Demander Kalan Ba
                            </button>
                          </form>
                        </li>
                        <li class="contact-label"><i class="bi bi-headset"></i> Ou contactez-nous directement :</li>
                        <li>
                          <a class="dropdown-item btn-contact-whatsapp" target="_blank"
                             href="https://wa.me/22653344444?text=<%= encodeURIComponent(`Bonjour, je souhaite obtenir Kalan Ba (accès premium) pour la matière ${subject.title} (Classe: ${schoolClass.title} ${schoolClass.serie}). Prix: ${subjPrice.toLocaleString('fr-FR')} FCFA`) %>">
                            <div class="dropdown-item-content"><i class="bi bi-whatsapp"></i><span>Écrire sur WhatsApp</span></div>
                          </a>
                        </li>
                        <li>
