<% layout('layouts/main') %>

<% headContent = `
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    /* Palette from the e-Kalan logo (same as the Kalan landing / class / subject pages) */
    :root {
      --cp-sun: #ffc23a;
      --cp-sun-soft: #fff3d6;
      --cp-violet: #5e17eb;
      --cp-violet-dark: #4710c0;
      --cp-violet-soft: #efe7ff;
      --cp-navy: #322c4d;
      --cp-navy-deep: #231e38;
      --cp-cream: #fffaf0;
      --cp-muted: #6b6880;
      --cp-border: #ece9f3;
      --cp-radius: 22px;
    }

    #main { margin-top: 0 !important; padding-top: 0 !important; }

    .chapter-page {
      margin-top: 72px;
      background: #fff;
      min-height: calc(100vh - 72px);
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      color: var(--cp-navy);
    }
    .chapter-page h1, .chapter-page h2, .chapter-page h3 { font-family: 'Baloo 2', system-ui, sans-serif; }

    /* ───── Hero (light, logo-led) ───── */
    .cp-hero {
      position: relative; overflow: hidden;
      background: var(--cp-cream);
      padding: 1.75rem clamp(1rem, 4vw, 3rem) clamp(2.4rem, 5vw, 3.4rem);
    }
    .cp-hero::before {
      content: ''; position: absolute; right: -150px; top: -190px;
      width: 440px; height: 440px; border-radius: 50%;
      background: var(--cp-sun); opacity: .9; pointer-events: none;
    }
    .cp-hero::after {
      content: ''; position: absolute; left: -90px; bottom: -130px;
      width: 240px; height: 240px; border-radius: 50%;
      border: 30px solid var(--cp-violet-soft); pointer-events: none;
    }
    .cp-hero__inner { max-width: 1240px; margin: 0 auto; position: relative; z-index: 2; }

    .cp-hero__top {
      display: flex; align-items: center; justify-content: space-between;
      gap: 1rem; flex-wrap: wrap; margin-bottom: 1.8rem;
    }
    .cp-breadcrumb {
      display: inline-flex; align-items: center; gap: .5rem; flex-wrap: wrap;
      font-size: .9rem; font-weight: 500; color: var(--cp-muted);
    }
    .cp-breadcrumb a {
      display: inline-flex; align-items: center; gap: .45rem;
      color: var(--cp-navy); text-decoration: none; font-weight: 600;
      background: #fff; border: 1px solid var(--cp-border);
      padding: .5rem .95rem; border-radius: 999px;
      box-shadow: 0 4px 14px rgba(50,44,77,.06);
      transition: transform .2s, border-color .2s, color .2s;
    }
    .cp-breadcrumb a:hover { transform: translateX(-3px); border-color: var(--cp-violet); color: var(--cp-violet); }
    .cp-breadcrumb .sep { opacity: .5; }
    .cp-breadcrumb .current { font-weight: 600; color: var(--cp-navy); }

    .cp-brand {
      display: inline-flex; align-items: center;
      background: #fff; border-radius: 16px; padding: .45rem .95rem;
      box-shadow: 0 12px 28px rgba(50,44,77,.16);
      transition: transform .2s;
    }
    .cp-brand:hover { transform: translateY(-2px); }
    .cp-brand img { display: block; height: 42px; width: auto; }

    .cp-hero__head {
      display: flex; align-items: flex-end; justify-content: space-between;
      gap: 2rem; flex-wrap: wrap;
    }
    .cp-hero__head > div:first-child { min-width: 0; max-width: 760px; }
    .cp-eyebrow {
      display: inline-flex; align-items: center; gap: .45rem;
      font-size: .76rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase;
      color: var(--cp-violet); margin-bottom: .6rem;
    }
    .cp-eyebrow::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--cp-sun); }
    .cp-title {
      font-size: clamp(2rem, 4.6vw, 3rem); font-weight: 800; color: var(--cp-navy);
      margin: 0; line-height: 1.08;
    }
    .cp-subtitle { margin: .85rem 0 0; max-width: 580px; font-size: 1.04rem; line-height: 1.6; color: var(--cp-muted); }
    .cp-meta { display: flex; gap: .6rem; margin-top: 1.3rem; flex-wrap: wrap; }
    .cp-meta__item {
      display: inline-flex; align-items: center; gap: .45rem;
      font-size: .86rem; font-weight: 600; color: var(--cp-navy);
      background: #fff; border: 1px solid var(--cp-border);
      padding: .42rem .85rem; border-radius: 999px;
    }
    .cp-meta__item i { color: var(--cp-violet); }

    .cp-tools { display: flex; gap: .7rem; flex-wrap: wrap; }
    .cp-tool {
      display: inline-flex; align-items: center; gap: .6rem;
      padding: .8rem 1.3rem; border-radius: 50px;
      background: var(--cp-sun); color: var(--cp-navy); border: none;
      font-weight: 700; font-size: .94rem; text-decoration: none;
      box-shadow: 0 10px 24px rgba(255,194,58,.4);
      transition: transform .2s, box-shadow .2s;
    }
    .cp-tool:hover { color: var(--cp-navy); transform: translateY(-2px); box-shadow: 0 14px 30px rgba(255,194,58,.5); }
    .cp-tool i { font-size: 1.15rem; }

    /* ───── Content ───── */
    .content-section {
      max-width: 1240px; margin: 0 auto;
      padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 4vw, 3rem) 4rem;
    }
    .cp-section-head { margin-bottom: 1.8rem; text-align: left; }
    .cp-section-head .tag {
      display: inline-flex; align-items: center; gap: .45rem;
      font-size: .76rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase;
      color: var(--cp-violet); margin-bottom: .4rem;
    }
    .cp-section-head .tag::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--cp-sun); }
    .cp-section-head h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0; padding: 0; line-height: 1.15; color: var(--cp-navy); }
    .cp-section-head h2::before, .cp-section-head h2::after { display: none; }
    .cp-section-head p { margin: .45rem 0 0; color: var(--cp-muted); font-size: 1rem; }

    .courses-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    .course-card {
      background: #fff;
      border: 1px solid var(--cp-border);
      border-radius: var(--cp-radius);
      overflow: hidden;
      display: flex; flex-direction: column;
      box-shadow: 0 4px 20px rgba(50,44,77,.06);
      transition: transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s, border-color .35s;
    }
    .course-card:hover { transform: translateY(-6px); box-shadow: 0 20px 44px rgba(50,44,77,.14); border-color: #ddd4f5; }

    /* video "thumbnail" — clickable, opens the player */
    .course-thumb {
      position: relative; overflow: hidden; height: 150px; width: 100%;
      display: flex; align-items: center; justify-content: center;
      background: var(--cp-violet); border: none; padding: 0; cursor: pointer;
    }
    .course-thumb::before {
      content: ''; position: absolute; right: -45px; bottom: -60px;
      width: 160px; height: 160px; border-radius: 50%;
      background: var(--cp-sun); opacity: .9;
    }
    .course-thumb .play {
      position: relative; width: 62px; height: 62px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      background: #fff; color: var(--cp-violet); font-size: 1.9rem;
      box-shadow: 0 10px 26px rgba(0,0,0,.22);
      transition: transform .25s;
    }
    .course-card:hover .course-thumb .play { transform: scale(1.1); }
    .course-card:nth-of-type(3n+2) .course-thumb { background: var(--cp-navy); }
    .course-card:nth-of-type(3n+2) .course-thumb .play { color: var(--cp-navy); }
    .course-card:nth-of-type(3n) .course-thumb { background: var(--cp-sun); }
    .course-card:nth-of-type(3n) .course-thumb::before { background: var(--cp-violet); opacity: .85; }
    .course-card:nth-of-type(3n) .course-thumb .play { color: var(--cp-navy); }

    .course-part-badge {
      position: absolute; top: .85rem; left: .85rem; z-index: 2;
      font-size: .78rem; font-weight: 800; letter-spacing: .02em;
      padding: .35rem .8rem; border-radius: 999px;
      background: #fff; color: var(--cp-navy);
      box-shadow: 0 4px 12px rgba(0,0,0,.16);
    }
    .course-part-badge b { color: var(--cp-violet); }

    .course-card-body { padding: 1.2rem 1.25rem 1.35rem; display: flex; flex-direction: column; flex: 1; gap: 1rem; }
    .course-title { font-size: 1.25rem; font-weight: 700; color: var(--cp-navy); margin: 0; line-height: 1.3; }

    .btn-watch-course {
      margin-top: auto;
      display: flex; align-items: center; justify-content: center; gap: .55rem;
      width: 100%; padding: .85rem 1rem; border-radius: 50px;
      background: var(--cp-violet); color: #fff; border: none;
      font-weight: 700; font-size: .95rem; text-decoration: none;
      transition: transform .2s, box-shadow .2s, background .2s;
    }
    .btn-watch-course:hover { background: var(--cp-violet-dark); color: #fff; transform: translateY(-2px); box-shadow: 0 10px 22px rgba(94,23,235,.32); }
    .btn-watch-course i { font-size: 1.15rem; }

    /* Next step band */
    .cp-next {
      position: relative; overflow: hidden; margin-top: 2.5rem;
      background: var(--cp-navy); color: #fff; border-radius: var(--cp-radius);
      padding: 1.6rem clamp(1.25rem, 3vw, 2.2rem);
      display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; flex-wrap: wrap;
    }
    .cp-next::before {
      content: ''; position: absolute; right: -60px; top: -80px; width: 220px; height: 220px; border-radius: 50%;
      background: var(--cp-sun); opacity: .14; pointer-events: none;
    }
    .cp-next > * { position: relative; }
    .cp-next h3 { margin: 0 0 .25rem; font-size: 1.35rem; font-weight: 800; color: #fff; }
    .cp-next p { margin: 0; opacity: .85; font-size: .95rem; }
    .cp-next a {
      display: inline-flex; align-items: center; gap: .55rem;
      padding: .85rem 1.5rem; border-radius: 50px;
      background: var(--cp-sun); color: var(--cp-navy); font-weight: 700; text-decoration: none;
      transition: transform .2s, box-shadow .2s;
    }
    .cp-next a:hover { color: var(--cp-navy); transform: translateY(-2px); box-shadow: 0 10px 24px rgba(255,194,58,.4); }

    /* Empty State */
    .empty-state {
      text-align: center; padding: 4.5rem 2rem;
      background: var(--cp-cream); border: 1.5px dashed #ffe3a3;
      border-radius: var(--cp-radius);
    }
    .empty-state i { display: inline-flex; width: 84px; height: 84px; border-radius: 50%; align-items: center; justify-content: center;
      font-size: 2.4rem; color: var(--cp-navy); background: var(--cp-sun); margin-bottom: 1rem; }
    .empty-state h4 { font-family: 'Baloo 2', system-ui, sans-serif; font-size: 1.5rem; font-weight: 700; margin: 0 0 .4rem; color: var(--cp-navy); }
    .empty-state p { color: var(--cp-muted); margin: 0; }

    /* Video modal */
    .cp-modal .modal-content { border: none; border-radius: 20px; overflow: hidden; }
    .cp-modal .modal-header { background: var(--cp-navy); color: #fff; border-bottom: none; padding: 1rem 1.3rem; }
    .cp-modal .modal-title { color: #fff; font-weight: 700; font-size: 1.1rem; }
    .cp-modal .modal-title i { color: var(--cp-sun); }
    .cp-modal .btn-close-white { filter: brightness(0) invert(1); }
    .cp-modal .modal-body { padding: 0; background: #000; }
    .cp-modal .video-wrapper { position: relative; width: 100%; padding-bottom: 56.25%; background: #000; }
    .cp-modal .video-wrapper iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: none; }
    .cp-modal .modal-footer { border: none; padding: .85rem 1.3rem; }
    .cp-modal .btn-close-modal {
      display: inline-flex; align-items: center; gap: .45rem;
      padding: .6rem 1.2rem; border-radius: 50px; font-weight: 700;
      background: #fff; color: var(--cp-navy); border: 1.5px solid var(--cp-navy);
    }
    .cp-modal .btn-close-modal:hover { background: var(--cp-navy); color: #fff; }

    @media (max-width: 768px) {
      .cp-hero::before { width: 300px; height: 300px; right: -140px; top: -150px; }
      .cp-brand img { height: 32px; }
      .cp-tools, .cp-tool { width: 100%; justify-content: center; }
      .cp-next { flex-direction: column; align-items: flex-start; }
      .cp-next a { width: 100%; justify-content: center; }
    }
  </style>
` %>

<% const baseUrl = `/programs/ekalan/kalan/class/${schoolClass._id}/subject/${subject._id}`; %>
<% const partCount = (chapter.content || []).length; %>

<div class="chapter-page">

  <!-- ───── Hero ───── -->
  <header class="cp-hero">
    <div class="cp-hero__inner">
      <div class="cp-hero__top">
        <nav class="cp-breadcrumb" aria-label="Fil d'Ariane">
          <a href="<%= baseUrl %>"><i class="bi bi-arrow-left"></i> <%= subject.title %></a>
          <span class="sep">/</span>
          <span class="current">Chapitre <%= chapterNumber || 1 %></span>
        </nav>
        <a href="/programs/ekalan/kalan" class="cp-brand" aria-label="e-Kalan">
          <img src="/assets/img/logos/e-Kalan_logo/ekalan-card.png" alt="e-Kalan" width="480" height="157">
        </a>
      </div>

      <div class="cp-hero__head">
        <div>
          <span class="cp-eyebrow">Chapitre <%= chapterNumber || 1 %> · <%= subject.title %> · <%= schoolClass.title %> <%= schoolClass.serie %></span>
          <h1 class="cp-title"><%= chapter.title %></h1>
          <p class="cp-subtitle">Regardez les vidéos du cours dans l'ordre, prenez des notes, puis passez aux exercices pour vous entraîner.</p>
          <div class="cp-meta">
            <span class="cp-meta__item"><i class="bi bi-camera-video-fill"></i> <%= partCount %> vidéo<%= partCount > 1 ? 's' : '' %> de cours</span>
          </div>
        </div>

        <div class="cp-tools">
          <a href="<%= baseUrl %>/chapter/<%= chapter._id %>/SE" class="cp-tool">
            <i class="bi bi-pencil-square"></i> Exercices d'apprentissage
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- ───── Content ───── -->
  <main class="content-section">
    <div class="cp-section-head">
      <span class="tag">Contenu du cours</span>
      <h2>Les vidéos du cours</h2>
      <p>Chaque partie s'ouvre dans un lecteur vidéo.</p>
    </div>

    <% if (partCount > 0) { %>
      <div class="courses-grid">
        <% chapter.content.forEach((content, i) => { %>
          <article class="course-card">
            <button type="button" class="course-thumb" data-bs-toggle="modal" data-bs-target="#videoModal<%= content._id %>"
                    aria-label="Lire : <%= content.title %>">
              <span class="course-part-badge">Partie <b><%= i + 1 %></b></span>
              <span class="play"><i class="bi bi-play-fill"></i></span>
            </button>
            <div class="course-card-body">
              <h3 class="course-title"><%= content.title %></h3>
              <a href="#" class="btn-watch-course" data-bs-toggle="modal" data-bs-target="#videoModal<%= content._id %>">
                <i class="bi bi-play-circle-fill"></i> Suivre le cours
              </a>
            </div>
          </article>

          <!-- Video Modal -->
          <div class="modal fade cp-modal" id="videoModal<%= content._id %>" tabindex="-1" aria-labelledby="videoModalLabel<%= content._id %>" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="videoModalLabel<%= content._id %>">
                    <i class="bi bi-play-circle me-2"></i><%= content.title %>
                  </h5>
                  <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                  <div class="video-wrapper">
                    <iframe src="<%= content.videoLink %>" frameborder="0"
                            allow="autoplay; fullscreen; picture-in-picture" allowfullscreen
                            title="<%= content.title %>"></iframe>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn-close-modal" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> Fermer
                  </button>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <i class="bi bi-inbox"></i>
        <h4>Aucun contenu de cours disponible</h4>
        <p>Les vidéos de cours seront bientôt ajoutées. Veuillez revenir plus tard.</p>
      </div>
    <% } %>

    <div class="cp-next">
      <div>
        <h3>Prêt à vous entraîner ?</h3>
        <p>Mettez le cours en pratique avec les exercices corrigés de ce chapitre.</p>
      </div>
      <a href="<%= baseUrl %>/chapter/<%= chapter._id %>/SE"><i class="bi bi-pencil-square"></i> Faire les exercices</a>
    </div>
  </main>
</div>
