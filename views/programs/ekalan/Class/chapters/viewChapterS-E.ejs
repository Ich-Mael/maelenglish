<% layout('layouts/100bacBoilerplate') %>

<style>
  :root {
    --se-brand: #5d06ba;
    --se-brand-dark: #2d0370;
    --se-brand-50: #f4eefe;
    --se-ink: #1d1633;
    --se-muted: #6b6880;
    --se-bg: #f6f6fb;
    --se-surface: #fff;
    --se-border: #eceaf4;
    --se-green: #15a06b;
    --se-radius: 18px;
    --se-shadow: 0 6px 24px rgba(45, 3, 112, 0.07);
    --se-shadow-lg: 0 18px 44px rgba(45, 3, 112, 0.16);
  }

  body { background: var(--se-bg); }
  /* Offset below the fixed navbar (~88px at rest) so the hero doesn't slide under it */
  .se-page { font-family: 'Poppins', system-ui, sans-serif; color: var(--se-ink); margin-top: 88px; }

  /* ── Hero ── */
  .se-hero {
    position: relative; overflow: hidden; color: #fff;
    background:
      radial-gradient(900px 360px at 88% -50%, rgba(255,255,255,.16), transparent 60%),
      linear-gradient(135deg, #6a0fd6 0%, var(--se-brand) 48%, var(--se-brand-dark) 100%);
    padding: 1.4rem clamp(1rem, 4vw, 3rem) clamp(2.2rem, 4vw, 3rem);
  }
  .se-hero::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 34px;
    background: var(--se-bg); border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  }
  .se-hero__inner { max-width: 1140px; margin: 0 auto; position: relative; z-index: 2; }

  .se-crumb { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; font-size: .85rem; margin-bottom: 1.3rem; }
  .se-crumb a {
    display: inline-flex; align-items: center; gap: .4rem; color: #fff; text-decoration: none;
    background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22);
    padding: .42rem .85rem; border-radius: 999px; transition: background .2s, transform .2s;
  }
  .se-crumb a:hover { background: rgba(255,255,255,.26); transform: translateX(-2px); color: #fff; }
  .se-crumb .sep { opacity: .45; }
  .se-crumb .current { opacity: .9; padding: .42rem .2rem; }

  .se-title { font-size: clamp(1.9rem, 4.5vw, 2.9rem); font-weight: 700; letter-spacing: -.02em; margin: 0; line-height: 1.1; }
  .se-meta { display: flex; flex-wrap: wrap; gap: 1.3rem; margin-top: 1.1rem; }
  .se-meta__item { display: inline-flex; align-items: center; gap: .5rem; font-size: .92rem; font-weight: 500; opacity: .95; }
  .se-meta__item i { font-size: 1.05rem; }

  /* ── Body ── */
  .se-body { max-width: 1140px; margin: 0 auto; padding: clamp(1.4rem, 3vw, 2.4rem) clamp(1rem, 4vw, 3rem) 4rem; }
  .se-section { margin-bottom: 2.6rem; }
  .se-section__head { display: flex; align-items: center; gap: .7rem; margin-bottom: 1.3rem; }
  .se-section__head h2 { font-size: 1.35rem; font-weight: 700; margin: 0; color: var(--se-ink); }
  .se-section__head .badge-count {
    font-size: .8rem; font-weight: 700; color: var(--se-brand-dark);
    background: var(--se-brand-50); border-radius: 999px; padding: .25rem .7rem;
  }
  .se-section__head .ic { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; color: #fff; flex-shrink: 0; }
  .ic--corr { background: linear-gradient(135deg, #18b67d, var(--se-green)); }
  .ic--prac { background: linear-gradient(135deg, var(--se-brand), var(--se-brand-dark)); }

  /* corrected grid */
  .se-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem; }
  .ex-card {
    background: var(--se-surface); border: 1px solid var(--se-border); border-radius: var(--se-radius);
    padding: 1.4rem 1.3rem; box-shadow: var(--se-shadow);
    display: flex; flex-direction: column; gap: 1rem;
    transition: transform .3s cubic-bezier(.2,.8,.2,1), box-shadow .3s, border-color .3s;
  }
  .ex-card:hover { transform: translateY(-5px); box-shadow: var(--se-shadow-lg); border-color: var(--se-brand-50); }
  .ex-card__top { display: flex; align-items: flex-start; gap: .85rem; }
  .ex-num {
    flex-shrink: 0; width: 42px; height: 42px; border-radius: 12px;
    display: grid; place-items: center; font-weight: 700; font-size: 1.05rem;
    background: var(--se-brand-50); color: var(--se-brand-dark);
  }
  .ex-card__title { font-size: 1.02rem; font-weight: 600; margin: 0; line-height: 1.35; color: var(--se-ink); }
  .ex-card__label { font-size: .76rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--se-green); }
  .ex-btn {
    display: flex; align-items: center; justify-content: center; gap: .55rem;
    width: 100%; padding: .8rem 1rem; border-radius: 12px; border: none; cursor: pointer;
    font-weight: 600; font-size: .95rem; font-family: inherit;
    background: linear-gradient(135deg, var(--se-brand) 0%, var(--se-brand-dark) 100%); color: #fff;
    transition: transform .2s, box-shadow .2s;
  }
  .ex-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 22px rgba(93,6,186,.32); color: #fff; }

  /* uncorrected list */
  .se-list { display: flex; flex-direction: column; gap: .75rem; }
  .pdf-row {
    display: flex; align-items: center; gap: 1rem; text-decoration: none;
    background: var(--se-surface); border: 1px solid var(--se-border); border-radius: 14px;
    padding: 1rem 1.2rem; box-shadow: var(--se-shadow); color: var(--se-ink);
    transition: transform .2s, box-shadow .2s, border-color .2s;
  }
  .pdf-row:hover { transform: translateX(4px); box-shadow: var(--se-shadow-lg); border-color: var(--se-brand-50); color: var(--se-ink); }
  .pdf-row .pdf-ic { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: #fdeaea; color: #d6453f; font-size: 1.4rem; flex-shrink: 0; }
  .pdf-row .pdf-info { flex: 1; min-width: 0; }
  .pdf-row .pdf-label { font-size: .74rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--se-muted); }
  .pdf-row .pdf-title { font-size: 1rem; font-weight: 600; margin: 0; }
  .pdf-row .pdf-go { color: var(--se-brand); font-size: 1.3rem; flex-shrink: 0; }

  /* empty */
  .se-empty {
    text-align: center; padding: 4.5rem 2rem; background: var(--se-surface);
    border: 1px dashed var(--se-border); border-radius: var(--se-radius);
  }
  .se-empty i { font-size: 3.5rem; color: #d9d2ee; }
  .se-empty h3 { font-size: 1.4rem; margin: 1rem 0 .4rem; color: var(--se-ink); }
  .se-empty p { color: var(--se-muted); margin: 0 0 1.3rem; }
  .se-empty .btn-back {
    display: inline-flex; align-items: center; gap: .5rem; text-decoration: none;
    padding: .7rem 1.4rem; border-radius: 999px; font-weight: 600;
    border: 1px solid var(--se-border); color: var(--se-brand-dark); background: #fff;
  }
  .se-empty .btn-back:hover { background: var(--se-brand-50); }

  /* modal video */
  .se-modal .modal-content { border: none; border-radius: 18px; overflow: hidden; }
  .se-modal .modal-header { background: linear-gradient(135deg, var(--se-brand) 0%, var(--se-brand-dark) 100%); color: #fff; border: none; padding: 1rem 1.3rem; }
  .se-modal .modal-title { font-weight: 600; font-size: 1.05rem; }
  .se-modal .modal-body { padding: 0; background: #000; }
  .se-modal .ratio iframe { border: 0; }
  .se-modal .modal-footer { border: none; padding: .85rem 1.3rem; }
</style>

<%
  const corrected = [].concat(
    (grouped && grouped.starterEx)  ? grouped.starterEx  : [],
    (grouped && grouped.CIAM_basic) ? grouped.CIAM_basic : []
  );
  const uncorrected = (grouped && grouped.practiceEx) ? grouped.practiceEx : [];
  const chapterIdx = (subject.chapters && subject.chapters.indexOf(chapter._id) >= 0)
    ? subject.chapters.indexOf(chapter._id) + 1 : null;
%>

<div class="se-page">

  <!-- ── Hero ── -->
  <header class="se-hero">
    <div class="se-hero__inner">
      <nav class="se-crumb" aria-label="Fil d'Ariane">
        <a href="/programs/ekalan/kalan/class/<%= serie._id %>"><i class="bi bi-arrow-left"></i> <%= serie.title %> <%= serie.serie %></a>
        <span class="sep">/</span>
        <a href="/programs/ekalan/kalan/class/<%= serie._id %>/subject/<%= subject._id %>"><%= subject.title %></a>
        <span class="sep">/</span>
        <span class="current"><% if (chapterIdx) { %>Chapitre <%= chapterIdx %><% } else { %>Chapitre<% } %></span>
      </nav>

      <h1 class="se-title"><%= chapter.title %></h1>

      <div class="se-meta">
        <span class="se-meta__item"><i class="bi bi-patch-check-fill"></i> <%= corrected.length %> exercice<%= corrected.length > 1 ? 's' : '' %> corrigé<%= corrected.length > 1 ? 's' : '' %></span>
        <span class="se-meta__item"><i class="bi bi-file-earmark-text-fill"></i> <%= uncorrected.length %> à télécharger</span>
      </div>
    </div>
  </header>

  <!-- ── Body ── -->
  <main class="se-body">

    <% if (corrected.length === 0 && uncorrected.length === 0) { %>
      <div class="se-empty">
        <i class="bi bi-journal-x"></i>
        <h3>Aucun exercice disponible</h3>
        <p>Les exercices d'apprentissage de ce chapitre seront bientôt ajoutés. Revenez plus tard.</p>
        <a href="/programs/ekalan/kalan/class/<%= serie._id %>/subject/<%= subject._id %>/chapter/<%= chapter._id %>" class="btn-back">
          <i class="bi bi-arrow-left"></i> Retour au chapitre
        </a>
      </div>
    <% } else { %>

      <% if (corrected.length > 0) { %>
      <section class="se-section">
        <div class="se-section__head">
          <span class="ic ic--corr"><i class="bi bi-patch-check-fill"></i></span>
          <h2>Exercices corrigés</h2>
          <span class="badge-count"><%= corrected.length %></span>
        </div>
        <div class="se-grid">
          <% corrected.forEach((content, i) => { %>
            <div class="ex-card">
              <div class="ex-card__top">
                <span class="ex-num"><%= i + 1 %></span>
                <div>
                  <div class="ex-card__label">Exercice corrigé</div>
                  <h3 class="ex-card__title"><%= content.title %></h3>
                </div>
              </div>
              <button type="button" class="ex-btn" data-bs-toggle="modal" data-bs-target="#N<%= content._id %>">
                <i class="bi bi-play-circle-fill"></i> Voir la correction
              </button>

              <!-- Modal -->
              <div class="modal fade se-modal" id="N<%= content._id %>" tabindex="-1" aria-labelledby="lbl<%= content._id %>" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-centered">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title" id="lbl<%= content._id %>"><i class="bi bi-play-circle me-2"></i><%= content.title %></h5>
                      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body">
                      <div class="ratio ratio-16x9">
                        <iframe src="<%= content.correctionVideoLink %>" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen title="<%= content.title %>"></iframe>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </section>
      <% } %>

      <% if (uncorrected.length > 0) { %>
      <section class="se-section">
        <div class="se-section__head">
          <span class="ic ic--prac"><i class="bi bi-file-earmark-text-fill"></i></span>
          <h2>Exercices non corrigés</h2>
          <span class="badge-count"><%= uncorrected.length %></span>
        </div>
        <div class="se-list">
          <% uncorrected.forEach((content, i) => { %>
            <a class="pdf-row" target="_blank" rel="noopener" href="<%= content.pdf_Link || content.pdf_link || '#' %>">
              <span class="pdf-ic"><i class="bi bi-file-earmark-pdf-fill"></i></span>
              <div class="pdf-info">
                <div class="pdf-label">Exercice <%= i + 1 %> · PDF</div>
                <p class="pdf-title"><%= content.title %></p>
              </div>
              <i class="bi bi-box-arrow-up-right pdf-go"></i>
            </a>
          <% }); %>
        </div>
      </section>
      <% } %>

    <% } %>
  </main>
</div>
