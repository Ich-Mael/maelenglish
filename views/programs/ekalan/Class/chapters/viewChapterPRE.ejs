<% layout('layouts/100bacBoilerplate') %>

<%
  // Chapter number (subject.chapters holds ObjectIds)
  const chapIdx = subject.chapters
    ? subject.chapters.findIndex((id) => id.toString() === chapter._id.toString())
    : -1;
  const chapterNo = chapIdx >= 0 ? chapIdx + 1 : null;

  // Catégories premium → libellé + icône. Rendues seulement si non vides.
  const SECTIONS = [
    { key: "CIAM_Premium", label: "CIAM — Exercices d'approfondissement", icon: "bi-journal-richtext" },
    { key: "advanceEx",    label: "Sujets d'autres livres",               icon: "bi-book-half" },
    { key: "nationalExam", label: "Examens nationaux",                     icon: "bi-mortarboard-fill" },
    { key: "schoolExam",   label: "Meilleurs établissements",             icon: "bi-building" },
    { key: "grandeEcole",  label: "Concours grandes écoles",              icon: "bi-trophy-fill" },
    { key: "bonus_profs",  label: "Bonus des professeurs",                icon: "bi-stars" },
    { key: "exo_perso",    label: "Exercices personnalisés",              icon: "bi-person-workspace" },
  ];
  const activeSections = SECTIONS.filter((s) => grouped && grouped[s.key] && grouped[s.key].length);
  const totalEx = (premiumExercises || []).length;
  const chapterUrl = `/programs/ekalan/kalan/class/${schoolClass._id}/subject/${subject._id}/chapter/${chapter._id}`;
%>

<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" rel="stylesheet">
<style>
  /* Palette from the e-Kalan logo. Kalan Ba = the premium tier → navy hero + sun yellow accents. */
  :root {
    --pr-sun: #ffc23a;
    --pr-sun-soft: #fff3d6;
    --pr-violet: #5e17eb;
    --pr-violet-dark: #4710c0;
    --pr-violet-soft: #efe7ff;
    --pr-navy: #322c4d;
    --pr-navy-deep: #231e38;
    --pr-cream: #fffaf0;
    --pr-muted: #6b6880;
    --pr-border: #ece9f3;
    --pr-radius: 22px;
  }

  body { background: #fff; }
  /* Offset below the fixed navbar (~88px at rest) so the hero doesn't slide under it */
  .pre-page { margin-top: 88px; min-height: 100vh; padding-bottom: 4rem; color: var(--pr-navy);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
  .pre-page h1, .pre-page h2, .pre-page h3 { font-family: 'Baloo 2', system-ui, sans-serif; }

  /* ── Hero (navy = premium) ── */
  .pre-hero {
    position: relative; overflow: hidden; color: #fff;
    background: var(--pr-navy);
    padding: 1.75rem clamp(1rem, 4vw, 3rem) clamp(3.6rem, 6vw, 4.4rem);
  }
  /* yellow disc echoes the "e" circle of the logo */
  .pre-hero::before {
    content: ''; position: absolute; right: -150px; top: -190px;
    width: 440px; height: 440px; border-radius: 50%;
    background: var(--pr-sun); opacity: .9; pointer-events: none;
  }
  .pre-hero::after {
    content: ''; position: absolute; left: -90px; bottom: -150px;
    width: 260px; height: 260px; border-radius: 50%;
    background: var(--pr-violet); opacity: .45; pointer-events: none;
  }
  .pre-hero__inner { max-width: 1100px; margin: 0 auto; position: relative; z-index: 1; }

  .pre-hero__top {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap; margin-bottom: 1.8rem;
  }
  .pre-crumb { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; font-size: .9rem; color: rgba(255,255,255,.7); }
  .pre-crumb a {
    display: inline-flex; align-items: center; gap: .45rem;
    color: #fff; text-decoration: none; font-weight: 600;
    background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.22);
    padding: .5rem .95rem; border-radius: 999px;
    transition: transform .2s, background .2s;
  }
  .pre-crumb a:hover { transform: translateX(-2px); background: rgba(255,255,255,.2); color: #fff; }
  .pre-crumb .sep { opacity: .5; }
  .pre-crumb .current { font-weight: 600; color: #fff; }

  .pre-brand {
    display: inline-flex; align-items: center;
    background: #fff; border-radius: 16px; padding: .45rem .95rem;
    box-shadow: 0 12px 28px rgba(0,0,0,.25);
    transition: transform .2s;
  }
  .pre-brand:hover { transform: translateY(-2px); }
  .pre-brand img { display: block; height: 42px; width: auto; }

  .pre-badge {
    display: inline-flex; align-items: center; gap: .4rem;
    font-size: .76rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
    padding: .35rem .85rem; border-radius: 999px;
    background: var(--pr-sun); color: var(--pr-navy);
  }
  .pre-hero h1 { margin: .8rem 0 .4rem; font-size: clamp(2rem, 4.6vw, 3rem); font-weight: 800; line-height: 1.08; color: #fff; max-width: 760px; }
  .pre-sub { margin: 0; max-width: 580px; font-size: 1.04rem; line-height: 1.6; color: rgba(255,255,255,.8); }
  .pre-meta { display: flex; gap: .6rem; flex-wrap: wrap; margin-top: 1.3rem; }
  .pre-chip {
    display: inline-flex; align-items: center; gap: .45rem;
    font-size: .86rem; font-weight: 600; color: #fff;
    background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2);
    padding: .42rem .85rem; border-radius: 999px;
  }
  .pre-chip i { color: var(--pr-sun); }

  .pre-wrap { max-width: 1100px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 3rem); }

  /* Warning — overlaps the hero bottom */
  .pre-warn {
    display: flex; gap: .7rem; align-items: flex-start;
    background: var(--pr-sun-soft); border: 1px solid #ffe3a3; border-radius: 16px;
    padding: .95rem 1.15rem; margin: -2rem auto 2.2rem; position: relative; z-index: 2;
    color: #7a5b00; font-size: .88rem; line-height: 1.5; box-shadow: 0 12px 30px rgba(50,44,77,.12);
  }
  .pre-warn i { font-size: 1.25rem; color: #d99a00; flex-shrink: 0; margin-top: .05rem; }

  /* Category quick-nav */
  .pre-nav { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 2.2rem; }
  .pre-nav a {
    display: inline-flex; align-items: center; gap: .4rem;
    text-decoration: none; font-size: .86rem; font-weight: 700; color: var(--pr-navy);
    padding: .5rem 1rem; border-radius: 999px; background: #fff; border: 1.5px solid var(--pr-border);
    transition: background .2s, color .2s, border-color .2s;
  }
  .pre-nav a i { color: var(--pr-violet); transition: color .2s; }
  .pre-nav a:hover { background: var(--pr-navy); color: #fff; border-color: var(--pr-navy); }
  .pre-nav a:hover i { color: var(--pr-sun); }

  /* Section */
  .pre-section { margin-bottom: 2.8rem; scroll-margin-top: 100px; }
  .pre-section__head { display: flex; align-items: center; gap: .8rem; margin-bottom: 1.2rem; }
  .pre-section__ic {
    width: 46px; height: 46px; flex-shrink: 0; border-radius: 14px;
    display: flex; align-items: center; justify-content: center; font-size: 1.3rem;
    background: var(--pr-navy); color: var(--pr-sun);
  }
  .pre-section__head h2 { margin: 0; font-size: clamp(1.35rem, 2.6vw, 1.75rem); font-weight: 800; line-height: 1.15; color: var(--pr-navy); }
  .pre-section__count {
    margin-left: auto; font-size: .82rem; font-weight: 800; color: var(--pr-navy);
    background: var(--pr-sun); padding: .3rem .8rem; border-radius: 999px;
  }

  /* Cards grid */
  .pre-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem; }
  .ex-card {
    background: #fff; border: 1px solid var(--pr-border); border-radius: var(--pr-radius);
    padding: 1.35rem 1.3rem; display: flex; flex-direction: column; gap: 1rem;
    box-shadow: 0 4px 20px rgba(50,44,77,.06);
    transition: transform .3s cubic-bezier(.2,.8,.2,1), box-shadow .3s, border-color .3s;
  }
  .ex-card:hover { transform: translateY(-5px); box-shadow: 0 20px 44px rgba(50,44,77,.14); border-color: #ffe3a3; }
  .ex-card__top { display: flex; align-items: flex-start; gap: .85rem; }
  .ex-card__num {
    flex-shrink: 0; width: 44px; height: 44px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Baloo 2', system-ui, sans-serif; font-weight: 800; font-size: 1.15rem;
    background: var(--pr-sun); color: var(--pr-navy);
  }
  .ex-card__num--1 { background: var(--pr-navy); color: var(--pr-sun); }
  .ex-card__num--2 { background: var(--pr-violet); color: #fff; }
  .ex-card__title { margin: .3rem 0 0; font-size: 1.15rem; font-weight: 700; color: var(--pr-navy); line-height: 1.3; }
  .ex-card__actions { display: flex; gap: .6rem; margin-top: auto; flex-wrap: wrap; }
  .ex-btn {
    flex: 1 1 auto; min-width: 120px; border: 1.5px solid transparent; cursor: pointer; border-radius: 50px;
    padding: .72rem 1rem; font-weight: 700; font-size: .9rem; white-space: nowrap;
    display: inline-flex; align-items: center; justify-content: center; gap: .45rem;
    text-decoration: none; transition: background .2s, color .2s, transform .2s, box-shadow .2s;
  }
  .ex-btn--pdf { background: #fff; color: var(--pr-navy); border-color: var(--pr-navy); }
  .ex-btn--pdf:hover { background: var(--pr-navy); color: #fff; }
  .ex-btn--video { background: var(--pr-sun); color: var(--pr-navy); }
  .ex-btn--video:hover { color: var(--pr-navy); transform: translateY(-2px); box-shadow: 0 10px 22px rgba(255,194,58,.45); }
  .ex-btn--disabled { background: #f4f3f8; color: #a3a0b5; border-color: #f4f3f8; pointer-events: none; }

  /* Modal */
  .pre-modal .modal-content { border: none; border-radius: 20px; overflow: hidden; }
  .pre-modal .modal-header { background: var(--pr-navy); color: #fff; border: none; padding: 1rem 1.3rem; }
  .pre-modal .modal-title { font-weight: 700; font-size: 1.05rem; }
  .pre-modal .modal-title i { color: var(--pr-sun); }
  .pre-modal .btn-close { filter: brightness(0) invert(1); }
  .pre-modal .modal-body { padding: 0; background: #000; }

  /* Empty */
  .pre-empty {
    text-align: center; background: var(--pr-cream); border: 1.5px dashed #ffe3a3; border-radius: var(--pr-radius);
    padding: 4rem 1.5rem; color: var(--pr-muted);
  }
  .pre-empty > i { display: inline-flex; width: 84px; height: 84px; border-radius: 50%; align-items: center; justify-content: center;
    font-size: 2.4rem; color: var(--pr-navy); background: var(--pr-sun); }
  .pre-empty h3 { font-size: 1.5rem; color: var(--pr-navy); margin: 1rem 0 .35rem; }
  .pre-empty p { margin: 0 0 1.3rem; }
  .pre-empty .btn-back {
    display: inline-flex; align-items: center; gap: .5rem; text-decoration: none;
    padding: .75rem 1.4rem; border-radius: 999px; font-weight: 700;
    border: 1.5px solid var(--pr-navy); color: var(--pr-navy); background: #fff;
    transition: background .2s, color .2s;
  }
  .pre-empty .btn-back:hover { background: var(--pr-navy); color: #fff; }

  @media (max-width: 768px) {
    .pre-hero::before { width: 300px; height: 300px; right: -140px; top: -150px; }
    .pre-brand img { height: 32px; }
  }
  @media (max-width: 520px) {
    .pre-grid { grid-template-columns: 1fr; }
  }
</style>

<div class="pre-page">
  <!-- ── Hero ── -->
  <header class="pre-hero">
    <div class="pre-hero__inner">
      <div class="pre-hero__top">
        <nav class="pre-crumb" aria-label="Fil d'Ariane">
          <a href="/programs/ekalan/kalan/class/<%= schoolClass._id %>/subject/<%= subject._id %>"><i class="bi bi-arrow-left"></i> <%= subject.title %></a>
          <span class="sep">/</span>
          <span class="current"><% if (chapterNo) { %>Chapitre <%= chapterNo %><% } else { %>Chapitre<% } %> · Kalan Ba</span>
        </nav>
        <a href="/programs/ekalan/kalan" class="pre-brand" aria-label="e-Kalan">
          <img src="/assets/img/logos/e-Kalan_logo/ekalan-card.png" alt="e-Kalan" width="480" height="157">
        </a>
      </div>

      <span class="pre-badge"><i class="bi bi-stars"></i> Kalan Ba · Contenus avancés</span>
      <h1><%= chapter.title %></h1>
      <p class="pre-sub">Exercices d'approfondissement, sujets d'examens et corrections vidéo pour aller plus loin.</p>
      <div class="pre-meta">
        <span class="pre-chip"><i class="bi bi-journal-text"></i> <%= subject.title %> · <%= schoolClass.title %> <%= schoolClass.serie %></span>
        <% if (chapterNo) { %><span class="pre-chip"><i class="bi bi-bookmark-fill"></i> Chapitre <%= chapterNo %></span><% } %>
        <span class="pre-chip"><i class="bi bi-collection-play-fill"></i> <%= totalEx %> exercice<%= totalEx > 1 ? 's' : '' %></span>
      </div>
    </div>
  </header>

  <div class="pre-wrap">
    <!-- Usage warning -->
    <div class="pre-warn">
      <i class="bi bi-shield-exclamation"></i>
      <span><strong>Contenu réservé à votre usage personnel (Kalan Ba).</strong>
        Le partage de votre compte, ainsi que le téléchargement, l'enregistrement ou la redistribution des vidéos et sujets
        par un moyen illégal, sont strictement interdits et entraînent la suspension immédiate de votre accès, sans remboursement.</span>
    </div>

    <% if (totalEx === 0) { %>
      <div class="pre-empty">
        <i class="bi bi-inbox"></i>
        <h3>Aucun contenu premium pour l'instant</h3>
        <p>Les exercices avancés de ce chapitre seront bientôt ajoutés. Revenez plus tard.</p>
        <a href="<%= chapterUrl %>" class="btn-back"><i class="bi bi-arrow-left"></i> Retour au chapitre</a>
      </div>
    <% } else { %>

      <!-- Quick nav -->
      <% if (activeSections.length > 1) { %>
        <nav class="pre-nav" aria-label="Catégories">
          <% activeSections.forEach((s) => { %>
            <a href="#sec-<%= s.key %>"><i class="bi <%= s.icon %>"></i> <%= s.label %></a>
          <% }); %>
        </nav>
      <% } %>

      <!-- Sections -->
      <% activeSections.forEach((s) => { const items = grouped[s.key]; %>
        <section class="pre-section" id="sec-<%= s.key %>">
          <div class="pre-section__head">
            <span class="pre-section__ic"><i class="bi <%= s.icon %>"></i></span>
            <h2><%= s.label %></h2>
            <span class="pre-section__count"><%= items.length %></span>
          </div>
          <div class="pre-grid">
            <% items.forEach((content, i) => { %>
              <div class="ex-card">
                <div class="ex-card__top">
                  <span class="ex-card__num ex-card__num--<%= i % 3 %>"><%= i + 1 %></span>
                  <h3 class="ex-card__title"><%= content.title %></h3>
                </div>
                <div class="ex-card__actions">
                  <% if (content.pdf_Link) { %>
                    <a class="ex-btn ex-btn--pdf" href="<%= content.pdf_Link %>" target="_blank" rel="noopener">
                      <i class="bi bi-file-earmark-pdf"></i> Sujet (PDF)
                    </a>
                  <% } else { %>
                    <span class="ex-btn ex-btn--pdf ex-btn--disabled"><i class="bi bi-file-earmark"></i> Sujet bientôt</span>
                  <% } %>
                  <% if (content.correctionVideoLink) { %>
                    <button type="button" class="ex-btn ex-btn--video" data-bs-toggle="modal" data-bs-target="#N<%= content._id %>">
                      <i class="bi bi-play-circle-fill"></i> Correction
                    </button>
                  <% } else { %>
                    <span class="ex-btn ex-btn--video ex-btn--disabled"><i class="bi bi-camera-video-off"></i> À venir</span>
                  <% } %>
                </div>
              </div>

              <% if (content.correctionVideoLink) { %>
                <div class="modal fade pre-modal" id="N<%= content._id %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-xl modal-dialog-centered">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-play-circle me-2"></i><%= content.title %></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                      </div>
                      <div class="modal-body">
                        <div class="ratio ratio-16x9">
                          <iframe src="<%= content.correctionVideoLink %>" frameborder="0"
                                  allow="autoplay; fullscreen; picture-in-picture" allowfullscreen
                                  title="<%= content.title %>"></iframe>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% } %>
            <% }); %>
          </div>
        </section>
      <% }); %>

    <% } %>
  </div>
</div>
