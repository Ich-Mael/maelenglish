<% layout('layouts/main') %>

<% headContent = `
<style>
    #main {
      margin-top: 0 !important;
      padding-top: 0 !important;
    }
    
    .premium-requests-page {
      padding: 2rem 0 4rem;
      min-height: calc(100vh - 200px);
      background: linear-gradient(to bottom, #f8f9fa 0%, #ffffff 100%);
      margin-top: 80px !important;
    }
    
    .page-header {
      background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
      color: white;
      padding: 2.5rem 2rem;
      border-radius: 20px;
      margin-bottom: 2rem;
      box-shadow: 0 10px 40px rgba(93, 6, 186, 0.3);
    }
    
    .page-header h1 {
      margin: 0 0 0.5rem 0;
      font-size: 2rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    
    .page-header p {
      margin: 0;
      opacity: 0.95;
      font-size: 1.1rem;
      font-weight: 300;
    }
    
    /* Stats Cards */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
    
    .stat-card {
      background: white;
      border-radius: 16px;
      padding: 1.5rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      border-left: 4px solid #5d06ba;
    }
    
    .stat-card.pending {
      border-left-color: #ffc107;
    }
    
    .stat-card.approved {
      border-left-color: #28a745;
    }
    
    .stat-card.rejected {
      border-left-color: #dc3545;
    }
    
    .stat-value {
      font-size: 2rem;
      font-weight: 700;
      color: #2d0370;
      margin: 0;
    }
    
    .stat-label {
      color: #666;
      font-size: 0.9rem;
      margin: 0.5rem 0 0 0;
      font-weight: 500;
    }
    
    /* Filter Tabs */
    .filter-tabs {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 2rem;
      flex-wrap: wrap;
    }
    
    .filter-tab {
      padding: 0.75rem 1.5rem;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
      background: white;
      color: #666;
      border: 2px solid #e0e0e0;
    }
    
    .filter-tab:hover {
      background: #f8f9fa;
      border-color: #5d06ba;
      color: #5d06ba;
      text-decoration: none;
    }
    
    .filter-tab.active {
      background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
      color: white;
      border-color: #5d06ba;
    }
    
    /* Requests Table */
    .requests-container {
      background: white;
      border-radius: 20px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      overflow: hidden;
    }
    
    .requests-table {
      width: 100%;
      border-collapse: collapse;
    }
    
    .requests-table thead {
      background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
      color: white;
    }
    
    .requests-table th {
      padding: 1.25rem 1.5rem;
      text-align: left;
      font-weight: 600;
      font-size: 0.95rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    .requests-table td {
      padding: 1.5rem;
      border-bottom: 1px solid #f0f0f0;
      vertical-align: top;
    }
    
    .requests-table tbody tr:hover {
      background: #f8f9fa;
    }
    
    .requests-table tbody tr:last-child td {
      border-bottom: none;
    }
    
    .student-info {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    
    .student-name {
      font-weight: 600;
      color: #2d0370;
      font-size: 1rem;
    }
    
    .student-username {
      color: #666;
      font-size: 0.85rem;
    }
    
    .subject-info {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    
    .subject-title {
      font-weight: 600;
      color: #2d0370;
      font-size: 1rem;
    }
    
    .subject-class {
      color: #666;
      font-size: 0.85rem;
    }
    
    .status-badge {
      display: inline-block;
      padding: 0.5rem 1rem;
      border-radius: 50px;
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    .status-badge.pending {
      background: #fff3cd;
      color: #856404;
    }
    
    .status-badge.approved {
      background: #d4edda;
      color: #155724;
    }
    
    .status-badge.rejected {
      background: #f8d7da;
      color: #721c24;
    }
    
    .date-info {
      color: #666;
      font-size: 0.9rem;
    }
    
    .actions-cell {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    
    .btn-action {
      padding: 0.5rem 1rem;
      border-radius: 8px;
      border: none;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    
    .btn-approve {
      background: #28a745;
      color: white;
    }
    
    .btn-approve:hover {
      background: #218838;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
      color: white;
      text-decoration: none;
    }
    
    .btn-reject {
      background: #dc3545;
      color: white;
    }
    
    .btn-reject:hover {
      background: #c82333;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
      color: white;
      text-decoration: none;
    }
    
    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      color: #666;
    }
    
    .empty-state i {
      font-size: 4rem;
      color: #ccc;
      margin-bottom: 1rem;
    }
    
    .empty-state h3 {
      color: #2d0370;
      margin-bottom: 0.5rem;
    }
    
    /* Modal Styles */
    .modal-header {
      background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
      color: white;
      border-bottom: none;
    }
    
    .modal-header .btn-close {
      filter: brightness(0) invert(1);
    }
    
    .modal-body {
      padding: 2rem;
    }
    
    .form-group {
      margin-bottom: 1.5rem;
    }
    
    .form-label {
      font-weight: 600;
      color: #2d0370;
      margin-bottom: 0.5rem;
      display: block;
    }
    
    .form-control {
      width: 100%;
      padding: 0.75rem;
      border: 2px solid #e0e0e0;
      border-radius: 8px;
      font-size: 1rem;
      transition: border-color 0.3s ease;
    }
    
    .form-control:focus {
      outline: none;
      border-color: #5d06ba;
    }
    
    textarea.form-control {
      min-height: 100px;
      resize: vertical;
    }
    
    @media (max-width: 768px) {
      .requests-table {
        font-size: 0.9rem;
      }
      
      .requests-table th,
      .requests-table td {
        padding: 1rem 0.75rem;
      }
      
      .actions-cell {
        flex-direction: column;
      }
    }
</style>
` %>

<div class="premium-requests-page">
  <div class="container">
    <!-- Page Header -->
    <div class="page-header">
      <h1>
        <i class="bi bi-star"></i>
        Demandes d'accès premium
      </h1>
      <p>Gérez les demandes d'accès premium des étudiants</p>
    </div>

    <!-- Flash Messages -->
    <%- include('../../../partials/flash') %>

    <!-- Stats Cards -->
    <div class="stats-row">
      <div class="stat-card pending">
        <div class="stat-value"><%= stats.pending %></div>
        <div class="stat-label">En attente</div>
      </div>
      <div class="stat-card approved">
        <div class="stat-value"><%= stats.approved %></div>
        <div class="stat-label">Approuvées</div>
      </div>
      <div class="stat-card rejected">
        <div class="stat-value"><%= stats.rejected %></div>
        <div class="stat-label">Rejetées</div>
      </div>
      <div class="stat-card">
        <div class="stat-value"><%= stats.total %></div>
        <div class="stat-label">Total</div>
      </div>
    </div>

    <!-- Filter Tabs -->
    <div class="filter-tabs">
      <a href="/programs/ekalan/kalan/admindashboard/kalan/premium-requests?status=pending" 
         class="filter-tab <%= currentStatus === 'pending' ? 'active' : '' %>">
        En attente (<%= stats.pending %>)
      </a>
      <a href="/programs/ekalan/kalan/admindashboard/kalan/premium-requests?status=approved" 
         class="filter-tab <%= currentStatus === 'approved' ? 'active' : '' %>">
        Approuvées (<%= stats.approved %>)
      </a>
      <a href="/programs/ekalan/kalan/admindashboard/kalan/premium-requests?status=rejected" 
         class="filter-tab <%= currentStatus === 'rejected' ? 'active' : '' %>">
        Rejetées (<%= stats.rejected %>)
      </a>
      <a href="/programs/ekalan/kalan/admindashboard/kalan/premium-requests?status=all" 
         class="filter-tab <%= currentStatus === 'all' ? 'active' : '' %>">
        Toutes
      </a>
    </div>

    <!-- Requests Table -->
    <div class="requests-container">
      <% if (requests && requests.length > 0) { %>
        <table class="requests-table">
          <thead>
            <tr>
              <th>Étudiant</th>
              <th>Matière</th>
              <th>Statut</th>
              <th>Date de demande</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% requests.forEach(request => { %>
              <tr>
                <td>
                  <div class="student-info">
                      <div class="student-name">
                      <%= request.studentId && request.studentId.studentBasicInfo ? 
                          (request.studentId.studentBasicInfo.name || '') + ' ' + (request.studentId.studentBasicInfo.surname || '') : 
                          'N/A' %>
                      </div>
                      <div class="student-username">
                      @<%= request.studentId && request.studentId.studentBasicInfo ? 
                          request.studentId.studentBasicInfo.username : 'N/A' %>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="subject-info">
                    <div class="subject-title">
                      <%= request.subjectId ? request.subjectId.title : 'N/A' %>
                    </div>
                    <% if (request.subjectId && request.subjectId.classId) { %>
                      <div class="subject-class">
                        <%= request.subjectId.classId.title %> - <%= request.subjectId.classId.serie %>
                      </div>
                    <% } %>
                  </div>
                </td>
                <td>
                  <span class="status-badge <%= request.status %>">
                    <%= request.status === 'pending' ? 'En attente' : 
                        request.status === 'approved' ? 'Approuvée' : 'Rejetée' %>
                  </span>
                </td>
                <td>
                  <div class="date-info">
                    <%= new Date(request.createdAt).toLocaleDateString('fr-FR', { 
                        day: '2-digit', 
                        month: 'long', 
                      year: 'numeric', 
                      hour: '2-digit',
                      minute: '2-digit'
                    }) %>
                  </div>
                  <% if (request.reviewedAt) { %>
                    <div class="date-info" style="font-size: 0.8rem; margin-top: 0.25rem; color: #999;">
                      Traitée le <%= new Date(request.reviewedAt).toLocaleDateString('fr-FR') %>
                    </div>
                  <% } %>
                </td>
                <td>
                  <% if (request.status === 'pending') { %>
                    <div class="actions-cell">
                      <button type="button" 
                              class="btn-action btn-approve" 
                              data-bs-toggle="modal" 
                              data-bs-target="#approveModal<%= request._id %>">
                          <i class="bi bi-check-circle"></i>
                          Approuver
                        </button>
                      <button type="button" 
                              class="btn-action btn-reject" 
                              data-bs-toggle="modal" 
                              data-bs-target="#rejectModal<%= request._id %>">
                        <i class="bi bi-x-circle"></i>
                        Rejeter
                      </button>
                    </div>
                  <% } else { %>
                    <span class="date-info">
                      <%= request.reviewedBy ? 'Par ' + request.reviewedBy.username : '' %>
                    </span>
                  <% } %>
                </td>
              </tr>
              
              <!-- Approve Modal -->
              <div class="modal fade" id="approveModal<%= request._id %>" tabindex="-1" aria-labelledby="approveModalLabel<%= request._id %>" aria-hidden="true">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title" id="approveModalLabel<%= request._id %>">
                        <i class="bi bi-check-circle me-2"></i>
                        Approuver la demande
                      </h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form action="/programs/ekalan/kalan/admindashboard/kalan/premium-requests/<%= request._id %>/approve" method="POST">
                      <div class="modal-body">
                        <p>Voulez-vous approuver la demande d'accès premium pour :</p>
                        <ul>
                          <li><strong>Étudiant:</strong> <%= request.studentId && request.studentId.studentBasicInfo ? request.studentId.studentBasicInfo.username : 'N/A' %></li>
                          <li><strong>Matière:</strong> <%= request.subjectId ? request.subjectId.title : 'N/A' %></li>
                        </ul>
                        <div class="form-group">
                          <label for="approveNotes<%= request._id %>" class="form-label">Notes (optionnel)</label>
                          <textarea class="form-control" id="approveNotes<%= request._id %>" name="notes" placeholder="Ajouter des notes..."></textarea>
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-success">
                          <i class="bi bi-check-circle me-2"></i>
                          Approuver
                        </button>
                      </div>
                    </form>
                  </div>
                </div>
                    </div>

                    <!-- Reject Modal -->
              <div class="modal fade" id="rejectModal<%= request._id %>" tabindex="-1" aria-labelledby="rejectModalLabel<%= request._id %>" aria-hidden="true">
                      <div class="modal-dialog">
                        <div class="modal-content">
                          <div class="modal-header">
                      <h5 class="modal-title" id="rejectModalLabel<%= request._id %>">
                              <i class="bi bi-x-circle me-2"></i>
                              Rejeter la demande
                            </h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                          </div>
                          <form action="/programs/ekalan/kalan/admindashboard/kalan/premium-requests/<%= request._id %>/reject" method="POST">
                            <div class="modal-body">
                        <p>Voulez-vous rejeter la demande d'accès premium pour :</p>
                        <ul>
                          <li><strong>Étudiant:</strong> <%= request.studentId && request.studentId.studentBasicInfo ? request.studentId.studentBasicInfo.username : 'N/A' %></li>
                          <li><strong>Matière:</strong> <%= request.subjectId ? request.subjectId.title : 'N/A' %></li>
                        </ul>
                        <div class="form-group">
                          <label for="rejectNotes<%= request._id %>" class="form-label">Raison du rejet (optionnel)</label>
                          <textarea class="form-control" id="rejectNotes<%= request._id %>" name="notes" placeholder="Expliquer la raison du rejet..."></textarea>
                              </div>
                            </div>
                            <div class="modal-footer">
                              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                              <button type="submit" class="btn btn-danger">
                                <i class="bi bi-x-circle me-2"></i>
                                Rejeter
                              </button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state">
          <i class="bi bi-inbox"></i>
          <h3>Aucune demande trouvée</h3>
          <p>Il n'y a actuellement aucune demande <%= currentStatus === 'pending' ? 'en attente' : currentStatus === 'approved' ? 'approuvée' : currentStatus === 'rejected' ? 'rejetée' : '' %>.</p>
        </div>
      <% } %>
    </div>
  </div>
</div>