<% layout('layouts/main') %>

<% headContent = `
<style>
    #main {
      margin-top: 0 !important;
      padding-top: 0 !important;
    }
    
    .premium-requests-page {
      padding: 2rem 0 4rem;
      min-height: calc(100vh - 200px);
      background: linear-gradient(to bottom, #f8f9fa 0%, #ffffff 100%);
      margin-top: 80px !important;
    }
    
    .page-header {
      background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
      color: white;
      padding: 2.5rem 2rem;
      border-radius: 20px;
      margin-bottom: 2rem;
      box-shadow: 0 10px 40px rgba(93, 6, 186, 0.3);
    }
    
    .page-header h1 {
      margin: 0 0 0.5rem 0;
      font-size: 2rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    
    .page-header p {
      margin: 0;
      opacity: 0.95;
      font-size: 1.1rem;
      font-weight: 300;
    }
    
    /* Stats Cards */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
    
    .stat-card {
      background: white;
      border-radius: 16px;
      padding: 1.5rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      border-left: 4px solid #5d06ba;
    }
    
    .stat-card.pending {
      border-left-color: #ffc107;
    }
    
    .stat-card.approved {
      border-left-color: #28a745;
    }
    
    .stat-card.rejected {
      border-left-color: #dc3545;
    }
    
    .stat-value {
      font-size: 2rem;
      font-weight: 700;
      color: #2d0370;
      margin: 0;
    }
    
    .stat-label {
      color: #666;
      font-size: 0.9rem;
      margin: 0.5rem 0 0 0;
      font-weight: 500;
    }
    
    /* Filter Tabs */
    .filter-tabs {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 2rem;
      flex-wrap: wrap;
    }
    
    .filter-tab {
      padding: 0.75rem 1.5rem;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
      background: white;
      color: #666;
      border: 2px solid #e0e0e0;
    }
    
    .filter-tab:hover {
      background: #f8f9fa;
      border-color: #5d06ba;
      color: #5d06ba;
      text-decoration: none;
    }
    
    .filter-tab.active {
      background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
      color: white;
      border-color: #5d06ba;
    }
    
    /* Requests Table */
    .requests-container {
      background: white;
      border-radius: 20px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      overflow: hidden;
    }
    
    .requests-table {
      width: 100%;
      border-collapse: collapse;
    }
    
    .requests-table thead {
      background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
      color: white;
    }
    
    .requests-table th {
      padding: 1.25rem 1.5rem;
      text-align: left;
      font-weight: 600;
      font-size: 0.95rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    .requests-table td {
      padding: 1.5rem;
      border-bottom: 1px solid #f0f0f0;
      vertical-align: top;
    }
    
    .requests-table tbody tr:hover {
      background: #f8f9fa;
    }
    
    .requests-table tbody tr:last-child td {
      border-bottom: none;
    }
    
    .student-info {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    
    .student-name {
      font-weight: 600;
      color: #2d0370;
      font-size: 1rem;
    }
    
    .student-username {
      color: #666;
      font-size: 0.85rem;
    }
    
    .subject-info {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    
    .subject-title {
      font-weight: 600;
      color: #2d0370;
      font-size: 1rem;
    }
    
    .subject-class {
      color: #666;
      font-size: 0.85rem;
    }
    
    .status-badge {
      display: inline-block;
      padding: 0.5rem 1rem;
      border-radius: 50px;
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    .status-badge.pending {
      background: #fff3cd;
      color: #856404;
    }
    
    .status-badge.approved {
      background: #d4edda;
      color: #155724;
    }
    
    .status-badge.rejected {
      background: #f8d7da;
      color: #721c24;
    }
    
    .date-info {
      color: #666;
      font-size: 0.9rem;
    }
    
    .actions-cell {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    
    .btn-action {
      padding: 0.5rem 1rem;
      border-radius: 8px;
      border: none;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    
    .btn-approve {
      background: #28a745;
      color: white;
    }
    
    .btn-approve:hover {
      background: #218838;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
      color: white;
      text-decoration: none;
    }
    
    .btn-reject {
      background: #dc3545;
      color: white;
    }
    
    .btn-reject:hover {
      background: #c82333;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
      color: white;
      text-decoration: none;
    }
    
    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      color: #666;
    }
    
    .empty-state i {
      font-size: 4rem;
      color: #ccc;
      margin-bottom: 1rem;
    }
    
    .empty-state h3 {
      color: #2d0370;
      margin-bottom: 0.5rem;
    }
    
    /* Filter / search bar */
    .filter-bar {
      background: white; border-radius: 16px; padding: 1.25rem 1.5rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08); margin-bottom: 1.5rem;
    }
    .filter-bar form { display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: flex-end; }
    .filter-field { display: flex; flex-direction: column; gap: 0.35rem; flex: 1; min-width: 180px; }
    .filter-field label { font-size: 0.78rem; font-weight: 700; color: #2d0370; text-transform: uppercase; letter-spacing: 0.03em; }
    .filter-field input, .filter-field select {
      padding: 0.7rem 0.9rem; border: 2px solid #e0e0e0; border-radius: 10px; font-size: 0.95rem; background: #fafafa;
    }
    .filter-field input:focus, .filter-field select:focus { outline: none; border-color: #5d06ba; background: #fff; }
    .filter-actions { display: flex; gap: 0.5rem; }
    .btn-filter { padding: 0.7rem 1.25rem; border-radius: 10px; border: none; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none; }
    .btn-filter-apply { background: linear-gradient(135deg, #5d06ba, #2d0370); color: #fff; }
    .btn-filter-reset { background: #f0f0f0; color: #666; }

    /* Bulk toolbar */
    .bulk-toolbar { display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.5rem; background: #f6f1ff; border-bottom: 1px solid #ece3ff; flex-wrap: wrap; }
    .bulk-toolbar .select-all-label { display: flex; align-items: center; gap: 0.5rem; font-weight: 600; cursor: pointer; color: #2d0370; }
    .bulk-toolbar .sel-count { font-weight: 600; color: #5d06ba; margin-right: auto; }
    .bulk-toolbar button { padding: 0.55rem 1.1rem; border-radius: 8px; border: none; font-weight: 600; font-size: 0.88rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem; }
    .bulk-toolbar button:disabled { opacity: 0.5; cursor: not-allowed; }
    .bulk-approve { background: #28a745; color: #fff; }
    .bulk-reject { background: #dc3545; color: #fff; }
    .req-check { width: 1.1rem; height: 1.1rem; accent-color: #5d06ba; cursor: pointer; }

    .wait-time { display: inline-block; margin-top: 0.35rem; font-size: 0.76rem; font-weight: 600; color: #9a6700; background: #fff3cd; padding: 0.15rem 0.55rem; border-radius: 50px; }
    .subject-link { color: #5d06ba; text-decoration: none; }
    .subject-link:hover { text-decoration: underline; }
    .student-email { color: #999; font-size: 0.8rem; }
    .student-phone { font-size: 0.8rem; margin-top: 0.15rem; display: flex; align-items: center; gap: 0.5rem; }
    .student-phone a { color: #5d06ba; text-decoration: none; }
    .student-phone a:hover { text-decoration: underline; }
    .student-phone .phone-wa { color: #25D366; }

    /* Pagination */
    .pagination-bar { display: flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 1.25rem; flex-wrap: wrap; }
    .pagination-bar a, .pagination-bar span { padding: 0.5rem 0.85rem; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.9rem; border: 1px solid #e0e0e0; color: #5d06ba; }
    .pagination-bar .current { background: linear-gradient(135deg, #5d06ba, #2d0370); color: #fff; border-color: #5d06ba; }
    .pagination-bar .disabled { color: #ccc; pointer-events: none; }

    /* Modal Styles */
    .modal-header {
      background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
      color: white;
      border-bottom: none;
    }
    
    .modal-header .btn-close {
      filter: brightness(0) invert(1);
    }
    
    .modal-body {
      padding: 2rem;
    }
    
    .form-group {
      margin-bottom: 1.5rem;
    }
    
    .form-label {
      font-weight: 600;
      color: #2d0370;
      margin-bottom: 0.5rem;
      display: block;
    }
    
    .form-control {
      width: 100%;
      padding: 0.75rem;
      border: 2px solid #e0e0e0;
      border-radius: 8px;
      font-size: 1rem;
      transition: border-color 0.3s ease;
    }
    
    .form-control:focus {
      outline: none;
      border-color: #5d06ba;
    }
    
    textarea.form-control {
      min-height: 100px;
      resize: vertical;
    }
    
    @media (max-width: 768px) {
      .requests-table {
        font-size: 0.9rem;
      }
      
      .requests-table th,
      .requests-table td {
        padding: 1rem 0.75rem;
      }
      
      .actions-cell {
        flex-direction: column;
      }
    }
</style>
` %>

<div class="premium-requests-page">
  <div class="container">
    <!-- Page Header -->
    <div class="page-header">
      <h1>
        <i class="bi bi-star"></i>
        Demandes d'accès premium
      </h1>
      <p>Gérez les demandes d'accès premium des étudiants</p>
    </div>

    <!-- Flash Messages -->
    <%- include('../../../partials/flash') %>

    <!-- Stats Cards -->
    <div class="stats-row">
      <div class="stat-card pending">
        <div class="stat-value"><%= stats.pending %></div>
        <div class="stat-label">En attente</div>
      </div>
      <div class="stat-card approved">
        <div class="stat-value"><%= stats.approved %></div>
        <div class="stat-label">Approuvées</div>
      </div>
      <div class="stat-card rejected">
        <div class="stat-value"><%= stats.rejected %></div>
        <div class="stat-label">Rejetées</div>
      </div>
      <div class="stat-card">
        <div class="stat-value"><%= stats.total %></div>
        <div class="stat-label">Total</div>
      </div>
    </div>

    <%
      // Construit une query string en conservant les filtres actifs
      const baseUrl = '/programs/ekalan/kalan/admindashboard/kalan/premium-requests';
      const qp = (overrides) => {
        const o = Object.assign(
          { status: currentStatus, search: filters.search, class: filters.classId, subject: filters.subjectId },
          overrides
        );
        const qs = Object.entries(o)
          .filter(([, v]) => v !== '' && v != null)
          .map(([k, v]) => `${k}=${encodeURIComponent(v)}`)
          .join('&');
        return baseUrl + (qs ? '?' + qs : '');
      };
      const timeAgo = (d) => {
        const ms = Date.now() - new Date(d).getTime();
        const days = Math.floor(ms / 86400000);
        if (days >= 1) return `il y a ${days} jour${days > 1 ? 's' : ''}`;
        const hrs = Math.floor(ms / 3600000);
        if (hrs >= 1) return `il y a ${hrs} h`;
        const mins = Math.floor(ms / 60000);
        return mins >= 1 ? `il y a ${mins} min` : `à l'instant`;
      };
    %>

    <!-- Filter Tabs -->
    <div class="filter-tabs">
      <a href="<%= qp({ status: 'pending', page: '' }) %>" class="filter-tab <%= currentStatus === 'pending' ? 'active' : '' %>">En attente (<%= stats.pending %>)</a>
      <a href="<%= qp({ status: 'approved', page: '' }) %>" class="filter-tab <%= currentStatus === 'approved' ? 'active' : '' %>">Approuvées (<%= stats.approved %>)</a>
      <a href="<%= qp({ status: 'rejected', page: '' }) %>" class="filter-tab <%= currentStatus === 'rejected' ? 'active' : '' %>">Rejetées (<%= stats.rejected %>)</a>
      <a href="<%= qp({ status: 'all', page: '' }) %>" class="filter-tab <%= currentStatus === 'all' ? 'active' : '' %>">Toutes</a>
    </div>

    <!-- Search / Filter Bar -->
    <div class="filter-bar">
      <form method="GET" action="<%= baseUrl %>">
        <input type="hidden" name="status" value="<%= currentStatus %>">
        <div class="filter-field">
          <label for="f-search">Rechercher un élève</label>
          <input type="text" id="f-search" name="search" value="<%= filters.search %>" placeholder="Nom, prénom, username, email">
        </div>
        <div class="filter-field">
          <label for="f-class">Classe</label>
          <select id="f-class" name="class">
            <option value="">Toutes les classes</option>
            <% classes.forEach(c => { %>
              <option value="<%= c._id %>" <%= filters.classId == c._id.toString() ? 'selected' : '' %>><%= c.title %> <%= c.serie %></option>
            <% }) %>
          </select>
        </div>
        <div class="filter-field">
          <label for="f-subject">Matière</label>
          <select id="f-subject" name="subject">
            <option value="">Toutes les matières</option>
            <% subjects.forEach(s => { %>
              <option value="<%= s._id %>" data-class="<%= s.classId ? s.classId._id : '' %>" <%= filters.subjectId == s._id.toString() ? 'selected' : '' %>>
                <%= s.title %><% if (s.classId) { %> — <%= s.classId.title %> <%= s.classId.serie %><% } %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="filter-actions">
          <button type="submit" class="btn-filter btn-filter-apply"><i class="bi bi-funnel"></i> Filtrer</button>
          <a href="<%= baseUrl %>?status=<%= currentStatus %>" class="btn-filter btn-filter-reset">Réinitialiser</a>
        </div>
      </form>
    </div>

    <!-- Requests Table -->
    <div class="requests-container">
      <% const hasPending = requests.some(r => r.status === 'pending'); %>
      <% if (requests && requests.length > 0) { %>
        <% if (hasPending) { %>
          <div class="bulk-toolbar">
            <label class="select-all-label">
              <input type="checkbox" class="req-check" id="selectAll"> Tout sélectionner
            </label>
            <span class="sel-count" id="selCount">0 sélectionné(s)</span>
            <button type="button" class="bulk-approve" id="bulkApproveBtn" onclick="submitBulk('approve')" disabled>
              <i class="bi bi-check-circle"></i> Approuver la sélection
            </button>
            <button type="button" class="bulk-reject" id="bulkRejectBtn" onclick="submitBulk('reject')" disabled>
              <i class="bi bi-x-circle"></i> Rejeter la sélection
            </button>
          </div>
        <% } %>
        <table class="requests-table">
          <thead>
            <tr>
              <th style="width: 40px;"></th>
              <th>Étudiant</th>
              <th>Matière</th>
              <th>Statut</th>
              <th>Date de demande</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% requests.forEach(request => { %>
              <% const sbi = request.studentId && request.studentId.studentBasicInfo; %>
              <tr>
                <td>
                  <% if (request.status === 'pending') { %>
                    <input type="checkbox" class="req-check row-check" value="<%= request._id %>">
                  <% } %>
                </td>
                <td>
                  <div class="student-info">
                      <div class="student-name">
                      <%= sbi ? ((sbi.name || '') + ' ' + (sbi.surname || '')).trim() || sbi.username : 'N/A' %>
                      </div>
                      <div class="student-username">
                      @<%= sbi ? sbi.username : 'N/A' %>
                    </div>
                    <% if (sbi && sbi.email) { %>
                      <div class="student-email"><i class="bi bi-envelope"></i> <%= sbi.email %></div>
                    <% } %>
                    <% if (sbi && sbi.phoneNumber) { %>
                      <% const waNum = String(sbi.phoneNumber).replace(/\D/g, ''); %>
                      <div class="student-phone">
                        <a href="tel:<%= sbi.phoneNumber %>"><i class="bi bi-telephone"></i> <%= sbi.phoneNumber %></a>
                        <% if (waNum) { %>
                          <a class="phone-wa" target="_blank" rel="noopener" href="https://wa.me/<%= waNum %>" title="Contacter sur WhatsApp"><i class="bi bi-whatsapp"></i></a>
                        <% } %>
                      </div>
                    <% } %>
                  </div>
                </td>
                <td>
                  <div class="subject-info">
                    <div class="subject-title">
                      <% if (request.subjectId && request.subjectId.classId) { %>
                        <a class="subject-link" title="Gérer le premium de cette matière"
                           href="/programs/ekalan/kalan/admindashboard/kalan/class/<%= request.subjectId.classId._id %>/subject/<%= request.subjectId._id %>/premium">
                          <%= request.subjectId.title %> <i class="bi bi-box-arrow-up-right" style="font-size:.75rem;"></i>
                        </a>
                      <% } else { %>
                        <%= request.subjectId ? request.subjectId.title : 'N/A' %>
                      <% } %>
                    </div>
                    <% if (request.subjectId && request.subjectId.classId) { %>
                      <div class="subject-class">
                        <%= request.subjectId.classId.title %> - <%= request.subjectId.classId.serie %>
                      </div>
                    <% } %>
                  </div>
                </td>
                <td>
                  <span class="status-badge <%= request.status %>">
                    <%= request.status === 'pending' ? 'En attente' : 
                        request.status === 'approved' ? 'Approuvée' : 'Rejetée' %>
                  </span>
                </td>
                <td>
                  <div class="date-info">
                    <%= new Date(request.createdAt).toLocaleDateString('fr-FR', { 
                        day: '2-digit', 
                        month: 'long', 
                      year: 'numeric', 
                      hour: '2-digit',
                      minute: '2-digit'
                    }) %>
                  </div>
                  <% if (request.status === 'pending') { %>
                    <div><span class="wait-time"><i class="bi bi-clock"></i> <%= timeAgo(request.createdAt) %></span></div>
                  <% } %>
                  <% if (request.reviewedAt) { %>
                    <div class="date-info" style="font-size: 0.8rem; margin-top: 0.25rem; color: #999;">
                      Traitée le <%= new Date(request.reviewedAt).toLocaleDateString('fr-FR') %>
                    </div>
                  <% } %>
                </td>
                <td>
                  <% if (request.status === 'pending') { %>
                    <div class="actions-cell">
                      <button type="button" 
                              class="btn-action btn-approve" 
                              data-bs-toggle="modal" 
                              data-bs-target="#approveModal<%= request._id %>">
                          <i class="bi bi-check-circle"></i>
                          Approuver
                        </button>
                      <button type="button" 
                              class="btn-action btn-reject" 
                              data-bs-toggle="modal" 
                              data-bs-target="#rejectModal<%= request._id %>">
                        <i class="bi bi-x-circle"></i>
                        Rejeter
                      </button>
                    </div>
                  <% } else { %>
                    <span class="date-info">
                      <%= request.reviewedBy ? 'Par ' + request.reviewedBy.username : '' %>
                    </span>
                  <% } %>
                </td>
              </tr>

              <% if (request.status === 'pending') { %>
              <!-- Approve Modal -->
              <div class="modal fade" id="approveModal<%= request._id %>" tabindex="-1" aria-labelledby="approveModalLabel<%= request._id %>" aria-hidden="true">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title" id="approveModalLabel<%= request._id %>">
                        <i class="bi bi-check-circle me-2"></i>
                        Approuver la demande
                      </h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form action="/programs/ekalan/kalan/admindashboard/kalan/premium-requests/<%= request._id %>/approve" method="POST">
                      <div class="modal-body">
                        <p>Voulez-vous approuver la demande d'accès premium pour :</p>
                        <ul>
                          <li><strong>Étudiant:</strong> <%= request.studentId && request.studentId.studentBasicInfo ? request.studentId.studentBasicInfo.username : 'N/A' %></li>
                          <li><strong>Matière:</strong> <%= request.subjectId ? request.subjectId.title : 'N/A' %></li>
                        </ul>
                        <div class="form-group">
                          <label for="approveNotes<%= request._id %>" class="form-label">Notes (optionnel)</label>
                          <textarea class="form-control" id="approveNotes<%= request._id %>" name="notes" placeholder="Ajouter des notes..."></textarea>
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-success">
                          <i class="bi bi-check-circle me-2"></i>
                          Approuver
                        </button>
                      </div>
                    </form>
                  </div>
                </div>
                    </div>

                    <!-- Reject Modal -->
              <div class="modal fade" id="rejectModal<%= request._id %>" tabindex="-1" aria-labelledby="rejectModalLabel<%= request._id %>" aria-hidden="true">
                      <div class="modal-dialog">
                        <div class="modal-content">
                          <div class="modal-header">
                      <h5 class="modal-title" id="rejectModalLabel<%= request._id %>">
                              <i class="bi bi-x-circle me-2"></i>
                              Rejeter la demande
                            </h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                          </div>
                          <form action="/programs/ekalan/kalan/admindashboard/kalan/premium-requests/<%= request._id %>/reject" method="POST">
                            <div class="modal-body">
                        <p>Voulez-vous rejeter la demande d'accès premium pour :</p>
                        <ul>
                          <li><strong>Étudiant:</strong> <%= request.studentId && request.studentId.studentBasicInfo ? request.studentId.studentBasicInfo.username : 'N/A' %></li>
                          <li><strong>Matière:</strong> <%= request.subjectId ? request.subjectId.title : 'N/A' %></li>
                        </ul>
                        <div class="form-group">
                          <label for="rejectNotes<%= request._id %>" class="form-label">Raison du rejet (optionnel)</label>
                          <textarea class="form-control" id="rejectNotes<%= request._id %>" name="notes" placeholder="Expliquer la raison du rejet..."></textarea>
                              </div>
                            </div>
                            <div class="modal-footer">
                              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                              <button type="submit" class="btn btn-danger">
                                <i class="bi bi-x-circle me-2"></i>
                                Rejeter
                              </button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
              <% } %>
            <% }); %>
          </tbody>
        </table>

        <% if (pagination.totalPages > 1) { %>
          <div class="pagination-bar">
            <% if (pagination.page > 1) { %>
              <a href="<%= qp({ page: pagination.page - 1 }) %>">‹ Précédent</a>
            <% } else { %>
              <span class="disabled">‹ Précédent</span>
            <% } %>
            <% for (let p = 1; p <= pagination.totalPages; p++) { %>
              <% if (p === pagination.page) { %>
                <span class="current"><%= p %></span>
              <% } else { %>
                <a href="<%= qp({ page: p }) %>"><%= p %></a>
              <% } %>
            <% } %>
            <% if (pagination.page < pagination.totalPages) { %>
              <a href="<%= qp({ page: pagination.page + 1 }) %>">Suivant ›</a>
            <% } else { %>
              <span class="disabled">Suivant ›</span>
            <% } %>
          </div>
        <% } %>
      <% } else { %>
        <div class="empty-state">
          <i class="bi bi-inbox"></i>
          <h3>Aucune demande trouvée</h3>
          <p>Aucune demande ne correspond à votre recherche ou à ce filtre.</p>
        </div>
      <% } %>
    </div>
  </div>

  <%# Formulaire caché pour le traitement en masse (rempli en JS) %>
  <form id="bulkForm" method="POST" action="/programs/ekalan/kalan/admindashboard/kalan/premium-requests/bulk" style="display:none;"></form>
</div>

<script>
  (function () {
    const selectAll = document.getElementById('selectAll');
    const selCount = document.getElementById('selCount');
    const approveBtn = document.getElementById('bulkApproveBtn');
    const rejectBtn = document.getElementById('bulkRejectBtn');
    const rowChecks = () => Array.from(document.querySelectorAll('.row-check'));

    function update() {
      const checks = rowChecks();
      const checked = checks.filter(c => c.checked);
      if (selCount) selCount.textContent = checked.length + ' sélectionné(s)';
      const none = checked.length === 0;
      if (approveBtn) approveBtn.disabled = none;
      if (rejectBtn) rejectBtn.disabled = none;
      if (selectAll) selectAll.checked = checks.length > 0 && checked.length === checks.length;
    }

    if (selectAll) {
      selectAll.addEventListener('change', function () {
        rowChecks().forEach(c => { c.checked = selectAll.checked; });
        update();
      });
    }
    rowChecks().forEach(c => c.addEventListener('change', update));

    window.submitBulk = function (action) {
      const checked = rowChecks().filter(c => c.checked).map(c => c.value);
      if (!checked.length) return;
      const verb = action === 'approve' ? 'approuver' : 'rejeter';
      if (!confirm('Voulez-vous ' + verb + ' ' + checked.length + ' demande(s) ?')) return;
      const form = document.getElementById('bulkForm');
      form.querySelectorAll('input').forEach(i => i.remove());
      const a = document.createElement('input');
      a.type = 'hidden'; a.name = 'action'; a.value = action;
      form.appendChild(a);
      checked.forEach(function (id) {
        const inp = document.createElement('input');
        inp.type = 'hidden'; inp.name = 'requestIds'; inp.value = id;
        form.appendChild(inp);
      });
      form.submit();
    };

    // Filtrer les matières selon la classe choisie
    const classSel = document.getElementById('f-class');
    const subjSel = document.getElementById('f-subject');
    if (classSel && subjSel) {
      const allOptions = Array.from(subjSel.options);
      function filterSubjects() {
        const cls = classSel.value;
        subjSel.innerHTML = '';
        allOptions.forEach(function (opt) {
          if (!opt.value || !cls || opt.getAttribute('data-class') === cls) {
            subjSel.appendChild(opt);
          }
        });
        if (!Array.from(subjSel.options).some(o => o.value === subjSel.value)) {
          subjSel.value = '';
        }
      }
      classSel.addEventListener('change', filterSubjects);
      filterSubjects();
    }

    update();
  })();
</script>