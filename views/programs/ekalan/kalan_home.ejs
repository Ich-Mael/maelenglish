<% scripts = `
  <script>
    // Video Modal Functionality
    document.addEventListener('DOMContentLoaded', function() {
      const enSavoirPlusBtn = document.getElementById('enSavoirPlusBtn');
      const videoModal = document.getElementById('videoModal');
      const videoModalOverlay = document.getElementById('videoModalOverlay');
      const closeVideoModal = document.getElementById('closeVideoModal');
      
      function openModal() {
        if (videoModal && videoModalOverlay) {
          document.body.style.overflow = 'hidden'; // Prevent body scroll
          videoModalOverlay.classList.add('active');
          videoModal.classList.add('active');
        }
      }
      
      function closeModal() {
        if (videoModal && videoModalOverlay) {
          document.body.style.overflow = ''; // Restore body scroll
          videoModal.classList.remove('active');
          videoModalOverlay.classList.remove('active');
        }
      }
      
      if (enSavoirPlusBtn && videoModal) {
        // Open modal on button click
        enSavoirPlusBtn.addEventListener('click', function(e) {
          e.preventDefault();
          openModal();
        });
        
        // Close modal on close button click
        if (closeVideoModal) {
          closeVideoModal.addEventListener('click', function(e) {
            e.preventDefault();
            closeModal();
          });
        }
        
        // Close modal when clicking on overlay
        if (videoModalOverlay) {
          videoModalOverlay.addEventListener('click', function(e) {
            if (e.target === videoModalOverlay) {
              closeModal();
            }
          });
        }
        
        // Close modal on ESC key
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && videoModal.classList.contains('active')) {
            closeModal();
          }
        });
      }
    });
  </script>
` %>
