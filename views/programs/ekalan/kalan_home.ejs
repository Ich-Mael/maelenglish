<% scripts = `
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const openBtn  = document.getElementById('enSavoirPlusBtn');
      const modal    = document.getElementById('videoModal');
      const overlay  = document.getElementById('videoModalOverlay');
      const closeBtn = document.getElementById('closeVideoModal');
      function open()  { if (modal && overlay) { document.body.style.overflow='hidden'; overlay.classList.add('active'); modal.classList.add('active'); } }
      function close() { if (modal && overlay) { document.body.style.overflow='';       overlay.classList.remove('active'); modal.classList.remove('active'); } }
      if (openBtn)  openBtn.addEventListener('click', function (e) { e.preventDefault(); open(); });
      if (closeBtn) closeBtn.addEventListener('click', function (e) { e.preventDefault(); close(); });
      if (overlay)  overlay.addEventListener('click', close);
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && modal.classList.contains('active')) close(); });

      // ── Testimonials carousel ──
      const track = document.getElementById('khQuotes');
      const prevBtn = document.getElementById('khQuotesPrev');
      const nextBtn = document.getElementById('khQuotesNext');
      if (track && prevBtn && nextBtn) {
        const step = () => {
          const card = track.querySelector('.kh-quote');
          const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || 24) || 24;
          return card ? card.offsetWidth + gap : track.clientWidth;
        };
        const update = () => {
          const maxScroll = track.scrollWidth - track.clientWidth - 4;
          prevBtn.disabled = track.scrollLeft <= 4;
          nextBtn.disabled = track.scrollLeft >= maxScroll;
        };
        prevBtn.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
        nextBtn.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
        track.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();

        // Slow autoplay; pauses on hover / touch
        let timer = null;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const play = () => {
          if (reduceMotion || timer) return;
          timer = setInterval(() => {
            const maxScroll = track.scrollWidth - track.clientWidth - 4;
            if (track.scrollLeft >= maxScroll) track.scrollTo({ left: 0, behavior: 'smooth' });
            else track.scrollBy({ left: step(), behavior: 'smooth' });
          }, 5000);
        };
        const stop = () => { if (timer) { clearInterval(timer); timer = null; } };
        track.addEventListener('mouseenter', stop);
        track.addEventListener('mouseleave', play);
        track.addEventListener('touchstart', stop, { passive: true });
        play();
      }
    });
  </script>
` %>
