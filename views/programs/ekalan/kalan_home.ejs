<% layout('layouts/main') %>
<% const loggedIn = (typeof currentUser !== 'undefined' && currentUser); %>
<% const classHref = (typeof studentClassId !== 'undefined' && studentClassId) ? `/programs/ekalan/kalan/class/${studentClassId}` : '/dashboard'; %>
<% const primaryCta = loggedIn ? { href: classHref, label: 'Accéder à mon espace', icon: 'bi-mortarboard-fill' } : { href: '/login', label: 'Se connecter', icon: 'bi-box-arrow-in-right' }; %>

<% headContent = `
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    .kh { --brand:#5d06ba; --brand-dark:#2d0370; --ink:#1f2937; --muted:#6b7280; --gold:#ffd700;
      font-family: system-ui,-apple-system,'Segoe UI',Roboto,sans-serif; color: var(--ink); }
    .kh-wrap { max-width: 1180px; margin: 0 auto; padding: 0 clamp(1rem,4vw,2.5rem); }

    /* Hero */
    .kh-hero { position: relative; overflow: hidden; color:#fff; padding: clamp(5rem,12vw,8rem) 0 clamp(3.5rem,8vw,6rem);
      background: radial-gradient(900px 500px at 80% -10%, rgba(255,215,0,.18), transparent 60%),
                  linear-gradient(135deg, #160a33 0%, #2d0370 55%, #5d06ba 100%); }
    .kh-hero::after { content:''; position:absolute; left:-6%; bottom:-40%; width:420px; height:420px; border-radius:50%;
      background: radial-gradient(circle, rgba(124,58,237,.35), transparent 70%); pointer-events:none; }
    .kh-hero__inner { position: relative; z-index:2; max-width: 760px; }
    .kh-eyebrow { display:inline-flex; align-items:center; gap:.5rem; font-size:.8rem; font-weight:700; letter-spacing:.05em;
      text-transform:uppercase; padding:.4rem .9rem; border-radius:999px; background:rgba(255,255,255,.12);
      border:1px solid rgba(255,255,255,.22); margin-bottom:1.4rem; }
    .kh-hero h1 { font-size: clamp(2.1rem,5vw,3.4rem); font-weight:800; line-height:1.12; margin:0 0 1.1rem; }
    .kh-hero h1 .gold { color: #d3adf7; }
    .kh-hero h1 .afrohk { font-family: 'Baloo 2', system-ui, sans-serif; font-size: inherit; font-weight: 800; letter-spacing: 0; color: #fff; padding: 0; }
    .kh-hero p.lead { font-size: clamp(1.05rem,2vw,1.3rem); opacity:.95; line-height:1.6; margin:0 0 2rem; max-width: 620px; }
    .kh-cta { display:flex; gap:.9rem; flex-wrap:wrap; align-items:center; }
    .kh-btn--lead { padding:1rem 2.1rem; }

    /* Animated slow-motion waves at the hero bottom */
    .kh-hero { padding-bottom: clamp(6.5rem, 11vw, 9rem); }
    .kh-waves { position:absolute; left:0; right:0; bottom:-1px; width:100%; height:90px; z-index:1; line-height:0; }
    .kh-waves svg { width:100%; height:100%; }
    .kh-wave { animation: kh-move-forever linear infinite; }
    .kh-wave-1 { animation-duration: 38s; animation-delay: -2s; }
    .kh-wave-2 { animation-duration: 30s; animation-delay: -3s; }
    .kh-wave-3 { animation-duration: 24s; animation-delay: -4s; }
    .kh-wave-4 { animation-duration: 18s; animation-delay: -5s; }
    @keyframes kh-move-forever {
      0%   { transform: translate3d(-90px, 0, 0); }
      100% { transform: translate3d(85px, 0, 0); }
    }
    @media (prefers-reduced-motion: reduce) { .kh-wave { animation: none; } }
    .kh-btn { border:none; cursor:pointer; border-radius:50px; padding:.95rem 1.9rem; font-weight:700; font-size:1rem;
      display:inline-flex; align-items:center; gap:.55rem; text-decoration:none; transition: transform .2s, box-shadow .2s; }
    .kh-btn--gold { background: linear-gradient(135deg,#ffd700,#ffb800); color:#2d0370; box-shadow:0 8px 24px rgba(255,215,0,.35); }
    .kh-btn--gold:hover { transform:translateY(-2px); box-shadow:0 12px 30px rgba(255,215,0,.45); color:#2d0370; }
    .kh-btn--ghost { background:rgba(255,255,255,.1); color:#fff; border:1.5px solid rgba(255,255,255,.4); }
    .kh-btn--ghost:hover { background:rgba(255,255,255,.2); color:#fff; }
    .kh-btn--brand { background: linear-gradient(135deg,#5d06ba,#2d0370); color:#fff; }
    .kh-btn--brand:hover { transform:translateY(-2px); box-shadow:0 10px 26px rgba(93,6,186,.35); color:#fff; }
    .kh-btn--outline { background:#fff; color:#5d06ba; border:1.5px solid #5d06ba; }
    .kh-btn--outline:hover { background:#5d06ba; color:#fff; }

    /* Stats band */
    .kh-stats { background:#fff; margin-top:-2.5rem; position:relative; z-index:3; border-radius:20px;
      box-shadow:0 12px 40px rgba(45,3,112,.12); padding:1.75rem clamp(1rem,3vw,2.5rem);
      display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; }
    .kh-stat { text-align:center; }
    .kh-stat i { font-size:1.5rem; color:var(--brand); }
    .kh-stat .num { font-size:1.8rem; font-weight:800; color:var(--brand-dark); line-height:1.1; }
    .kh-stat .lbl { font-size:.8rem; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); font-weight:600; }

    /* Section */
    .kh-section { padding: clamp(3.5rem,8vw,6rem) 0; }
    .kh-section--alt { background: linear-gradient(to bottom,#faf8ff,#fff); }
    .kh-section--dark { position:relative; overflow:hidden; color:#fff;
      background: radial-gradient(700px 360px at 85% -10%, rgba(255,215,0,.14), transparent 60%),
                  linear-gradient(135deg,#160a33 0%, #2d0370 55%, #5d06ba 100%); }
    .kh-head { text-align:center; max-width:680px; margin:0 auto clamp(2.5rem,5vw,3.5rem); }
    .kh-head .tag { display:inline-block; font-size:.8rem; font-weight:800; letter-spacing:.06em; text-transform:uppercase;
      color:var(--brand); background:#ede0ff; padding:.3rem .8rem; border-radius:999px; margin-bottom:1rem; }
    .kh-head h2 { font-size: clamp(1.7rem,3.5vw,2.5rem); font-weight:800; color:var(--brand-dark); margin:0 0 .8rem; }
    .kh-head p { font-size:1.1rem; color:var(--muted); margin:0; line-height:1.6; }
    .kh-section--dark .kh-head h2 { color:#fff; }
    .kh-section--dark .kh-head p { color:rgba(255,255,255,.85); }
    .kh-section--dark .kh-head .tag { background:rgba(255,255,255,.14); color:#ffd700; }

    /* Testimonials */
    .kh-quotes { position:relative; z-index:1; display:grid; grid-template-columns:repeat(auto-fill,minmax(330px,1fr)); gap:1.5rem; }
    .kh-quote { background:#fff; color:#1f2937; border-radius:18px; padding:1.75rem; box-shadow:0 12px 32px rgba(0,0,0,.2);
      display:flex; flex-direction:column; gap:.9rem; transition:transform .3s, box-shadow .3s; }
    .kh-quote:hover { transform:translateY(-6px); box-shadow:0 20px 44px rgba(0,0,0,.28); }
    .kh-quote.kh-quote--win { border:1.5px solid #ffd700; }
    .kh-quote__top { display:flex; align-items:center; justify-content:space-between; gap:.6rem; }
    .kh-quote__tag { display:inline-flex; align-items:center; gap:.35rem; font-size:.7rem; font-weight:800; letter-spacing:.03em;
      text-transform:uppercase; color:#5d06ba; background:#ede0ff; padding:.25rem .6rem; border-radius:999px; }
    .kh-quote--win .kh-quote__tag { color:#7a5b00; background:linear-gradient(135deg,#ffd700,#ffb800); }
    .kh-quote__stars { color:#ffb800; font-size:.9rem; letter-spacing:1px; flex-shrink:0; }
    .kh-quote__text { font-size:1rem; line-height:1.6; color:#374151; flex:1; margin:0; }
    .kh-quote__text::before { content:'\\201C'; color:#d9c2ff; font-size:1.6rem; font-weight:800; margin-right:.15rem; vertical-align:-.35rem; }
    .kh-quote__foot { display:flex; align-items:center; gap:.75rem; border-top:1px solid #f1edf9; padding-top:1rem; }
    .kh-avatar { width:46px; height:46px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center;
      font-weight:800; font-size:.95rem; color:#fff; background:linear-gradient(135deg,#5d06ba,#2d0370); }
    .kh-quote__name { font-weight:700; color:#2d0370; font-size:.95rem; }
    .kh-quote__meta { font-size:.82rem; color:#6b7280; }

    /* Value cards */
    .kh-grid3 { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:1.5rem; }
    .kh-value { background:#fff; border:1px solid #eee; border-radius:20px; padding:2.25rem; box-shadow:0 4px 20px rgba(0,0,0,.05);
      transition: transform .3s, box-shadow .3s, border-color .3s; }
    .kh-value:hover { transform:translateY(-8px); box-shadow:0 18px 44px rgba(93,6,186,.14); border-color:#d9ccf5; }
    .kh-value .ic { width:64px; height:64px; border-radius:16px; display:flex; align-items:center; justify-content:center;
      font-size:1.7rem; color:#fff; background:linear-gradient(135deg,#5d06ba,#2d0370); margin-bottom:1.25rem; }
    .kh-value h4 { font-size:1.2rem; font-weight:700; color:var(--brand-dark); margin:0 0 .6rem; line-height:1.35; }
    .kh-value p { color:var(--muted); line-height:1.7; margin:0; font-size:.98rem; }

    /* Pricing tiers */
    .kh-tiers { display:grid; grid-template-columns:repeat(auto-fit,minmax(290px,1fr)); gap:1.5rem; align-items:stretch; }
    .kh-tier { position:relative; background:#fff; border:1.5px solid #ece7f6; border-radius:22px; padding:2rem 1.75rem;
      display:flex; flex-direction:column; box-shadow:0 4px 20px rgba(0,0,0,.05); transition:transform .3s, box-shadow .3s; }
    .kh-tier:hover { transform:translateY(-6px); box-shadow:0 18px 44px rgba(93,6,186,.14); }
    .kh-tier--feature { border-color:transparent; background:linear-gradient(135deg,#2d0370,#5d06ba); color:#fff; box-shadow:0 16px 44px rgba(45,3,112,.3); }
    .kh-tier__badge { position:absolute; top:-13px; left:50%; transform:translateX(-50%); font-size:.72rem; font-weight:800;
      letter-spacing:.05em; text-transform:uppercase; padding:.3rem .9rem; border-radius:999px;
      background:linear-gradient(135deg,#ffd700,#ffb800); color:#2d0370; box-shadow:0 4px 12px rgba(255,184,0,.4); }
    .kh-tier__name { display:inline-flex; align-items:center; gap:.45rem; font-size:1.3rem; font-weight:800; color:var(--brand-dark); margin-bottom:.3rem; }
    .kh-tier--feature .kh-tier__name { color:#fff; }
    .kh-tier__scope { font-size:.88rem; color:var(--muted); margin-bottom:1.1rem; }
    .kh-tier--feature .kh-tier__scope { color:rgba(255,255,255,.8); }
    .kh-tier__price { font-size:2rem; font-weight:800; color:var(--brand-dark); line-height:1.1; }
    .kh-tier--feature .kh-tier__price { color:#ffd700; }
    .kh-tier__price small { font-size:.9rem; font-weight:600; color:var(--muted); }
    .kh-tier--feature .kh-tier__price small { color:rgba(255,255,255,.75); }
    .kh-tier__price .save { display:inline-block; font-size:.72rem; font-weight:700; background:rgba(255,215,0,.2); color:#7a5b00;
      padding:.12rem .5rem; border-radius:999px; margin-left:.4rem; vertical-align:middle; }
    .kh-tier--feature .kh-tier__price .save { background:rgba(255,215,0,.22); color:#ffd700; }
    .kh-feats { list-style:none; padding:0; margin:1.4rem 0; display:flex; flex-direction:column; gap:.7rem; flex:1; }
    .kh-feats li { display:flex; align-items:flex-start; gap:.6rem; font-size:.95rem; line-height:1.4; }
    .kh-feats li i { flex-shrink:0; margin-top:.1rem; }
    .kh-feats .yes { color:#1e9e54; }
    .kh-feats .yesf { color:#ffd700; }
    .kh-feats .no { color:#c7ccd4; }
    .kh-tier--feature .kh-feats li { color:rgba(255,255,255,.92); }
    .kh-tier .kh-btn { width:100%; justify-content:center; }
    .kh-tier__note { font-size:.78rem; color:var(--muted); text-align:center; margin-top:.7rem; }
    .kh-tier--feature .kh-tier__note { color:rgba(255,255,255,.75); }
    .kh-pricing-foot { text-align:center; margin-top:2rem; color:var(--muted); font-size:.92rem; }
    .kh-pricing-foot a { color:var(--brand); font-weight:600; text-decoration:none; }
    .kh-pricing-foot a:hover { text-decoration:underline; }

    /* CTA band */
    .kh-cta-band { background: radial-gradient(700px 300px at 20% 0%, rgba(255,215,0,.16), transparent 60%),
      linear-gradient(135deg,#2d0370,#5d06ba); color:#fff; border-radius:24px; padding:clamp(2.5rem,6vw,4rem);
      text-align:center; box-shadow:0 16px 50px rgba(45,3,112,.25); }
    .kh-cta-band h2 { font-size:clamp(1.6rem,3.5vw,2.3rem); font-weight:800; margin:0 0 .8rem; }
    .kh-cta-band p { opacity:.92; font-size:1.1rem; margin:0 auto 1.8rem; max-width:560px; }

    /* Video modal (preserved) */
    .video-modal-overlay { display:none; position:fixed; inset:0; background:rgba(10,2,30,.7); backdrop-filter:blur(5px);
      z-index:9998; opacity:0; transition:opacity .3s ease; }
    .video-modal-overlay.active { display:block; opacity:1; }
    .video-modal { display:none; position:fixed; top:50%; left:50%; transform:translate(-50%,-50%) scale(.9); width:92%;
      max-width:880px; background:#fff; padding:1.25rem; border-radius:20px; z-index:9999; box-shadow:0 20px 60px rgba(0,0,0,.35);
      transition:transform .3s ease, opacity .3s ease; opacity:0; }
    .video-modal.active { display:block; transform:translate(-50%,-50%) scale(1); opacity:1; }
    .video-modal-close { position:absolute; top:-18px; right:-18px; background:#5d06ba; color:#fff; border:none; width:42px; height:42px;
      border-radius:50%; font-size:1.4rem; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all .3s ease; z-index:10000; }
    .video-modal-close:hover { transform:rotate(90deg) scale(1.08); }
    .video-modal .ratio-box { position:relative; padding-bottom:56.25%; border-radius:14px; overflow:hidden; background:#000; }
    .video-modal .ratio-box iframe { position:absolute; inset:0; width:100%; height:100%; border:0; }

    @media (max-width: 720px) {
      .kh-stats { grid-template-columns:repeat(2,1fr); margin-top:-1.5rem; }
      .video-modal-close { top:-14px; right:-14px; width:36px; height:36px; }
    }
  </style>
` %>

<div class="kh">

  <!-- Hero -->
  <section id="kalan-hero" class="kh-hero">
    <div class="kh-wrap kh-hero__inner" data-aos="fade-up">
      <span class="kh-eyebrow"><i class="bi bi-mortarboard-fill"></i> Programme e-learning lycée &amp; collège</span>
      <h1>Maths, PC, SVT : <span class="gold">de la peur à la réussite</span> avec <span class="afrohk">e-kalan</span></h1>
      <p class="lead">Des cours clairs, des exercices corrigés et les sujets des meilleurs établissements —
        accessibles partout, à votre rythme, pour exceller dans vos études.</p>
      <div class="kh-cta">
        <a href="<%= primaryCta.href %>" class="kh-btn kh-btn--gold kh-btn--lead"><i class="bi <%= primaryCta.icon %>"></i> <%= primaryCta.label %></a>
        <button type="button" class="kh-btn kh-btn--ghost" id="enSavoirPlusBtn"><i class="bi bi-play-circle"></i> En savoir plus</button>
      </div>
    </div>

    <!-- Animated slow-motion waves -->
    <div class="kh-waves" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
           viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
        <defs>
          <path id="kh-wave-path" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z" />
        </defs>
        <g class="kh-wave-group">
          <use href="#kh-wave-path" xlink:href="#kh-wave-path" x="48" y="0" fill="rgba(255,255,255,.05)" class="kh-wave kh-wave-1" />
          <use href="#kh-wave-path" xlink:href="#kh-wave-path" x="48" y="3" fill="rgba(216,180,254,.10)" class="kh-wave kh-wave-2" />
          <use href="#kh-wave-path" xlink:href="#kh-wave-path" x="48" y="5" fill="rgba(124,58,237,.20)" class="kh-wave kh-wave-3" />
          <use href="#kh-wave-path" xlink:href="#kh-wave-path" x="48" y="7" fill="#faf8ff" class="kh-wave kh-wave-4" />
        </g>
      </svg>
    </div>
  </section>

  <!-- Stats band -->
  <div class="kh-wrap">
    <div class="kh-stats" data-aos="fade-up">
      <div class="kh-stat"><i class="bi bi-emoji-smile"></i>
        <div class="num"><span data-purecounter-start="0" data-purecounter-end="549" data-purecounter-duration="1" class="purecounter"></span>+</div>
        <div class="lbl">Élèves</div></div>
      <div class="kh-stat"><i class="bi bi-journal-richtext"></i>
        <div class="num"><span data-purecounter-start="0" data-purecounter-end="321" data-purecounter-duration="1" class="purecounter"></span>+</div>
        <div class="lbl">Étudiants</div></div>
      <div class="kh-stat"><i class="bi bi-building"></i>
        <div class="num"><span data-purecounter-start="0" data-purecounter-end="10" data-purecounter-duration="1" class="purecounter"></span></div>
        <div class="lbl">Écoles</div></div>
      <div class="kh-stat"><i class="bi bi-geo-alt"></i>
        <div class="num"><span data-purecounter-start="0" data-purecounter-end="3" data-purecounter-duration="1" class="purecounter"></span></div>
        <div class="lbl">Villes</div></div>
    </div>
  </div>

  <!-- Why e-kalan -->
  <section id="about" class="kh-section">
    <div class="kh-wrap">
      <div class="kh-head" data-aos="fade-up">
        <span class="tag">Pourquoi e-kalan</span>
        <h2>Tout pour réussir, au même endroit</h2>
        <p>Un programme pensé pour les élèves du Burkina, du collège à la terminale.</p>
      </div>
      <div class="kh-grid3">
        <div class="kh-value" data-aos="zoom-in" data-aos-delay="100">
          <div class="ic"><i class="bi bi-phone"></i></div>
          <h4>Étudiez à votre rythme</h4>
          <p>Accessible sur ordinateur, tablette et smartphone — apprenez quand et où vous voulez, à tout moment.</p>
        </div>
        <div class="kh-value" data-aos="zoom-in" data-aos-delay="200">
          <div class="ic"><i class="bi bi-easel2"></i></div>
          <h4>Des cours bien expliqués</h4>
          <p>Des professeurs passionnés et expérimentés. Chaque leçon est claire, complète et facile à comprendre.</p>
        </div>
        <div class="kh-value" data-aos="zoom-in" data-aos-delay="300">
          <div class="ic"><i class="bi bi-trophy"></i></div>
          <h4>Les meilleurs vous aident</h4>
          <p>Sujets corrigés des grands établissements et des examens nationaux, avec corrections en vidéo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section id="temoignages" class="kh-section kh-section--dark">
    <div class="kh-wrap">
      <div class="kh-head" data-aos="fade-up">
        <span class="tag">Témoignages</span>
        <h2>Ils ont vaincu les matières qui font peur</h2>
        <p>Maths, Physique-Chimie, SVT — les chapitres les plus redoutés du BAC, enfin maîtrisés.</p>
      </div>
      <div class="kh-quotes">

        <div class="kh-quote" data-aos="fade-up" data-aos-delay="50">
          <div class="kh-quote__top">
            <span class="kh-quote__tag"><i class="bi bi-calculator"></i> Maths · Probabilités</span>
            <span class="kh-quote__stars">★★★★★</span>
          </div>
          <p class="kh-quote__text">Les probabilités me faisaient perdre des points à chaque devoir. Avec les corrections en vidéo, j'ai enfin compris les arbres et les lois de probabilité. Je suis passée de 08 à 16 en maths.</p>
          <div class="kh-quote__foot">
            <span class="kh-avatar">AO</span>
            <div><div class="kh-quote__name">Aminata Ouédraogo</div><div class="kh-quote__meta">Terminale D · Ouagadougou</div></div>
          </div>
        </div>

        <div class="kh-quote" data-aos="fade-up" data-aos-delay="100">
          <div class="kh-quote__top">
            <span class="kh-quote__tag"><i class="bi bi-calculator"></i> Maths · Nombres complexes</span>
            <span class="kh-quote__stars">★★★★★</span>
          </div>
          <p class="kh-quote__text">Les nombres complexes, c'était du chinois pour moi. Chaque étape est expliquée clairement, du module à la forme exponentielle. C'est devenu ma partie préférée du programme.</p>
          <div class="kh-quote__foot">
            <span class="kh-avatar">BS</span>
            <div><div class="kh-quote__name">Boukary Sawadogo</div><div class="kh-quote__meta">Terminale C · Bobo-Dioulasso</div></div>
          </div>
        </div>

        <div class="kh-quote" data-aos="fade-up" data-aos-delay="150">
          <div class="kh-quote__top">
            <span class="kh-quote__tag"><i class="bi bi-lightning-charge"></i> Physique · Lois de Newton</span>
            <span class="kh-quote__stars">★★★★★</span>
          </div>
          <p class="kh-quote__text">La mécanique et les lois de Newton me bloquaient complètement. Les sujets des grands établissements corrigés m'ont préparé comme aucun cahier ne l'avait fait.</p>
          <div class="kh-quote__foot">
            <span class="kh-avatar">RK</span>
            <div><div class="kh-quote__name">Rasmané Kaboré</div><div class="kh-quote__meta">Terminale D · Koudougou</div></div>
          </div>
        </div>

        <div class="kh-quote" data-aos="fade-up" data-aos-delay="50">
          <div class="kh-quote__top">
            <span class="kh-quote__tag"><i class="bi bi-flower1"></i> SVT</span>
            <span class="kh-quote__stars">★★★★★</span>
          </div>
          <p class="kh-quote__text">La SVT demande beaucoup de méthode. Les exercices d'approfondissement et les corrections détaillées m'ont fait gagner en rigueur et en confiance pour le BAC.</p>
          <div class="kh-quote__foot">
            <span class="kh-avatar">FT</span>
            <div><div class="kh-quote__name">Fatimata Traoré</div><div class="kh-quote__meta">Terminale D · Ouagadougou</div></div>
          </div>
        </div>

