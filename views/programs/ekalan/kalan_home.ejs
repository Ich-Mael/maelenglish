<% layout('layouts/main') %>
<% const loggedIn = (typeof currentUser !== 'undefined' && currentUser); %>
<% const classHref = (typeof studentClassId !== 'undefined' && studentClassId) ? `/programs/ekalan/kalan/class/${studentClassId}` : '/dashboard'; %>
<% const primaryCta = loggedIn ? { href: classHref, label: 'My Kalan Space', icon: 'bi-mortarboard-fill' } : { href: '/login', label: 'Se connecter', icon: 'bi-box-arrow-in-right' }; %>

<% headContent = `
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    /* Palette taken from the e-Kalan logo: sun yellow, violet "K", navy wordmark */
    .kh { --sun:#ffc23a; --sun-soft:#fff3d6; --violet:#5e17eb; --violet-dark:#4710c0; --violet-soft:#efe7ff;
      --navy:#322c4d; --navy-deep:#231e38; --ink:#322c4d; --muted:#6b6880; --line:#ece9f3; --cream:#fffaf0;
      font-family: system-ui,-apple-system,'Segoe UI',Roboto,sans-serif; color: var(--ink); background:#fff; }
    .kh h1, .kh h2, .kh h4, .kh .kh-display { font-family:'Baloo 2', system-ui, sans-serif; }
    .kh-wrap { max-width: 1180px; margin: 0 auto; padding: 0 clamp(1rem,4vw,2.5rem); }

    /* ───── Hero (light, logo-led) ───── */
    .kh-hero { position: relative; overflow: hidden; background: var(--cream);
      padding: clamp(7rem,13vw,9rem) 0 clamp(4.5rem,9vw,6.5rem); }
    /* the yellow disc echoes the "e" circle of the logo */
    .kh-hero::before { content:''; position:absolute; right:-140px; top:-160px; width:520px; height:520px; border-radius:50%;
      background: var(--sun); opacity:.9; pointer-events:none; }
    .kh-hero::after { content:''; position:absolute; left:-80px; bottom:-120px; width:260px; height:260px; border-radius:50%;
      border: 34px solid var(--violet-soft); pointer-events:none; }
    .kh-hero__grid { position:relative; z-index:2; display:grid; grid-template-columns: minmax(0,1.1fr) minmax(0,.9fr); gap: clamp(2rem,5vw,4rem); align-items:center; }
    .kh-eyebrow { display:inline-flex; align-items:center; gap:.5rem; font-size:.78rem; font-weight:700; letter-spacing:.06em;
      text-transform:uppercase; padding:.45rem .95rem; border-radius:999px; background:#fff; color:var(--violet);
      border:1px solid var(--line); box-shadow:0 4px 14px rgba(50,44,77,.06); margin-bottom:1.4rem; }
    .kh-hero h1 { font-size: clamp(2.2rem,5vw,3.5rem); font-weight:800; line-height:1.08; margin:0 0 1.1rem; color:var(--navy); }
    .kh-hero h1 .hl { color: var(--violet); position:relative; }
    .kh-hero h1 .hl { background: linear-gradient(transparent 62%, rgba(255,194,58,.85) 62%, rgba(255,194,58,.85) 92%, transparent 92%);
      -webkit-box-decoration-break: clone; box-decoration-break: clone; padding: 0 .1em; }
    .kh-hero h1 .brand { color: var(--navy); }
    .kh-hero h1 .brand b { color: var(--violet); font-weight:800; }
    .kh-hero p.lead { font-size: clamp(1.02rem,1.8vw,1.22rem); color:var(--muted); line-height:1.65; margin:0 0 2rem; max-width: 580px; }
    .kh-cta { display:flex; gap:.9rem; flex-wrap:wrap; align-items:center; }
    .kh-subjects { display:flex; gap:.5rem; flex-wrap:wrap; margin-top:1.8rem; }
    .kh-chip { display:inline-flex; align-items:center; gap:.4rem; font-size:.84rem; font-weight:600; color:var(--navy);
      background:#fff; border:1px solid var(--line); padding:.4rem .8rem; border-radius:999px; }
    .kh-chip i { color: var(--violet); }
    .kh-chip--more { background: var(--sun-soft); border-color: #ffe3a3; }
    .kh-chip--more i { color: #d99a00; }

    /* Logo showcase */
    .kh-showcase { position:relative; }
    .kh-logo-card { position:relative; background:#fff; border-radius:28px; padding: clamp(1.6rem,4vw,2.6rem) clamp(1.2rem,3vw,2rem);
      box-shadow: 0 24px 60px rgba(50,44,77,.16); text-align:center; }
    .kh-logo-card img { width:100%; max-width:420px; height:auto; display:block; margin:0 auto; }
    .kh-logo-card .tagline { margin:1rem 0 0; font-size:.95rem; color:var(--muted); font-weight:500; }
    .kh-float { position:absolute; display:inline-flex; align-items:center; gap:.45rem; font-size:.82rem; font-weight:700;
      padding:.55rem .9rem; border-radius:14px; box-shadow:0 12px 28px rgba(50,44,77,.18); animation: kh-bob 5s ease-in-out infinite; }
    .kh-float--a { top:-18px; left:-14px; background:var(--violet); color:#fff; }
    .kh-float--b { bottom:-18px; right:-10px; background:var(--navy); color:#fff; animation-delay:-2.5s; }
    .kh-float--b i { color: var(--sun); }
    @keyframes kh-bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
    @media (prefers-reduced-motion: reduce) { .kh-float { animation:none; } }

    /* Buttons */
    .kh-btn { border:none; cursor:pointer; border-radius:50px; padding:.95rem 1.9rem; font-weight:700; font-size:1rem;
      display:inline-flex; align-items:center; gap:.55rem; text-decoration:none; transition: transform .2s, box-shadow .2s, background .2s, color .2s; }
    .kh-btn--lead { padding:1rem 2.1rem; }
    .kh-btn--violet { background: var(--violet); color:#fff; box-shadow:0 10px 26px rgba(94,23,235,.3); }
    .kh-btn--violet:hover { background: var(--violet-dark); color:#fff; transform:translateY(-2px); box-shadow:0 14px 32px rgba(94,23,235,.38); }
    .kh-btn--sun { background: var(--sun); color: var(--navy); box-shadow:0 10px 26px rgba(255,194,58,.4); }
    .kh-btn--sun:hover { color: var(--navy); transform:translateY(-2px); box-shadow:0 14px 32px rgba(255,194,58,.5); }
    .kh-btn--line { background:#fff; color: var(--navy); border:1.5px solid var(--navy); }
    .kh-btn--line:hover { background: var(--navy); color:#fff; }
    .kh-btn--ghost { background:rgba(255,255,255,.1); color:#fff; border:1.5px solid rgba(255,255,255,.45); }
    .kh-btn--ghost:hover { background:rgba(255,255,255,.2); color:#fff; }
    .kh-btn--navy { background: var(--navy); color:#fff; }
    .kh-btn--navy:hover { background: var(--navy-deep); color:#fff; transform:translateY(-2px); box-shadow:0 10px 26px rgba(50,44,77,.3); }

    /* ───── Stats ───── */
    .kh-stats { background:#fff; margin-top:-2.6rem; position:relative; z-index:3; border-radius:22px;
      box-shadow:0 14px 44px rgba(50,44,77,.12); padding:1.6rem clamp(1rem,3vw,2.5rem);
      display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; }
    .kh-stat { display:flex; align-items:center; gap:.9rem; justify-content:center; }
    .kh-stat .ic { width:48px; height:48px; border-radius:50%; display:flex; align-items:center; justify-content:center;
      background: var(--sun-soft); color: var(--navy); font-size:1.3rem; flex-shrink:0; }
    .kh-stat:nth-child(even) .ic { background: var(--violet-soft); color: var(--violet); }
    .kh-stat .num { font-family:'Baloo 2', system-ui, sans-serif; font-size:1.8rem; font-weight:800; color:var(--navy); line-height:1; }
    .kh-stat .lbl { font-size:.76rem; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); font-weight:600; }

    /* ───── Sections ───── */
    .kh-section { padding: clamp(3.5rem,8vw,6rem) 0; }
    .kh-section--cream { background: var(--cream); }
    .kh-section--navy { position:relative; overflow:hidden; color:#fff; background: var(--navy); }
    .kh-section--navy::before { content:''; position:absolute; right:-120px; top:-120px; width:340px; height:340px; border-radius:50%;
      background: var(--sun); opacity:.12; pointer-events:none; }
    .kh-section--navy::after { content:''; position:absolute; left:-100px; bottom:-140px; width:320px; height:320px; border-radius:50%;
      background: var(--violet); opacity:.25; pointer-events:none; }
    .kh-head { text-align:center; max-width:680px; margin:0 auto clamp(2.5rem,5vw,3.5rem); position:relative; z-index:1; }
    .kh-head .tag { display:inline-flex; align-items:center; gap:.4rem; font-size:.78rem; font-weight:800; letter-spacing:.07em; text-transform:uppercase;
      color:var(--violet); margin-bottom:.8rem; }
    .kh-head .tag::before { content:''; width:10px; height:10px; border-radius:50%; background: var(--sun); }
    .kh-head h2 { font-size: clamp(1.8rem,3.6vw,2.6rem); font-weight:800; color:var(--navy); margin:0 0 .7rem; line-height:1.15; }
    .kh-head p { font-size:1.08rem; color:var(--muted); margin:0; line-height:1.6; }
    .kh-section--navy .kh-head h2 { color:#fff; }
    .kh-section--navy .kh-head p { color:rgba(255,255,255,.8); }
    .kh-section--navy .kh-head .tag { color: var(--sun); }
    @media (min-width: 992px) {
      .kh-section--navy .kh-head { max-width: none; }
      .kh-section--navy .kh-head h2 { white-space: nowrap; }
    }

    /* Value cards */
    .kh-grid3 { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:1.5rem; }
    .kh-value { position:relative; background:#fff; border:1px solid var(--line); border-radius:22px; padding:2.2rem;
      transition: transform .3s, box-shadow .3s, border-color .3s; overflow:hidden; }
    .kh-value::after { content:''; position:absolute; right:-40px; top:-40px; width:110px; height:110px; border-radius:50%;
      background: var(--sun-soft); transition: transform .4s; }
    .kh-value:hover { transform:translateY(-8px); box-shadow:0 20px 44px rgba(50,44,77,.12); border-color:#ddd4f5; }
    .kh-value:hover::after { transform: scale(1.25); }
    .kh-value .ic { position:relative; z-index:1; width:60px; height:60px; border-radius:18px; display:flex; align-items:center; justify-content:center;
      font-size:1.6rem; margin-bottom:1.25rem; }
    .kh-value .ic--violet { background: var(--violet); color:#fff; }
    .kh-value .ic--sun { background: var(--sun); color: var(--navy); }
    .kh-value .ic--navy { background: var(--navy); color: var(--sun); }
    .kh-value h4 { position:relative; z-index:1; font-size:1.3rem; font-weight:700; color:var(--navy); margin:0 0 .5rem; line-height:1.3; }
    .kh-value p { position:relative; z-index:1; color:var(--muted); line-height:1.7; margin:0; font-size:.98rem; }

    /* Testimonials */
    .kh-carousel { position:relative; z-index:1; }
    .kh-quotes { display:flex; gap:1.5rem; overflow-x:auto; scroll-snap-type:x mandatory; scroll-behavior:smooth;
      padding:.5rem .25rem 1.25rem; -ms-overflow-style:none; scrollbar-width:none; }
    .kh-quotes::-webkit-scrollbar { display:none; }
    .kh-carousel__nav { position:absolute; top:44%; transform:translateY(-50%); z-index:4; width:46px; height:46px;
      border:none; border-radius:50%; cursor:pointer; background: var(--sun); color: var(--navy);
      box-shadow:0 8px 22px rgba(0,0,0,.3); display:flex; align-items:center; justify-content:center; font-size:1.25rem;
      transition:transform .2s, opacity .2s; }
    .kh-carousel__nav:hover { transform:translateY(-50%) scale(1.08); }
    .kh-carousel__nav:disabled { opacity:.3; cursor:default; }
    .kh-carousel__prev { left:-12px; }
    .kh-carousel__next { right:-12px; }
    @media (max-width:600px){ .kh-carousel__prev{ left:2px } .kh-carousel__next{ right:2px } }
    .kh-quote { flex:0 0 340px; max-width:86vw; scroll-snap-align:start;
      background:#fff; color:var(--ink); border-radius:20px; padding:1.75rem; box-shadow:0 12px 32px rgba(0,0,0,.22);
      display:flex; flex-direction:column; gap:.9rem; transition:transform .3s, box-shadow .3s; border-top:4px solid var(--violet); }
    .kh-quote:hover { transform:translateY(-6px); box-shadow:0 20px 44px rgba(0,0,0,.3); }
    .kh-quote.kh-quote--win { border-top-color: var(--sun); box-shadow:0 0 0 2px var(--sun), 0 12px 32px rgba(0,0,0,.22); }
    .kh-quote__top { display:flex; align-items:center; justify-content:space-between; gap:.6rem; }
    .kh-quote__tag { display:inline-flex; align-items:center; gap:.35rem; font-size:.7rem; font-weight:800; letter-spacing:.03em;
      text-transform:uppercase; color:var(--violet); background:var(--violet-soft); padding:.25rem .6rem; border-radius:999px; }
    .kh-quote--win .kh-quote__tag { color:var(--navy); background: var(--sun); }
    .kh-quote__stars { color:#f5a800; font-size:.9rem; letter-spacing:1px; flex-shrink:0; }
    .kh-quote__text { font-size:1rem; line-height:1.6; color:#45405e; flex:1; margin:0; }
    .kh-quote__text::before { content:'\\201C'; color: var(--sun); font-size:1.8rem; font-weight:800; margin-right:.15rem; vertical-align:-.4rem; }
    .kh-quote__foot { display:flex; align-items:center; gap:.75rem; border-top:1px solid var(--line); padding-top:1rem; }
    .kh-avatar { width:46px; height:46px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center;
      font-weight:800; font-size:.95rem; color:#fff; background: var(--violet); }
    .kh-quote:nth-child(3n+2) .kh-avatar { background: var(--navy); color: var(--sun); }
    .kh-quote:nth-child(3n) .kh-avatar { background: var(--sun); color: var(--navy); }
    .kh-quote__name { font-weight:700; color:var(--navy); font-size:.95rem; }
    .kh-quote__meta { font-size:.82rem; color:var(--muted); }

    /* Pricing tiers */
    .kh-tiers { display:grid; grid-template-columns:repeat(auto-fit,minmax(290px,1fr)); gap:1.5rem; align-items:stretch; }
    .kh-tier { position:relative; background:#fff; border:1.5px solid var(--line); border-radius:24px; padding:2.1rem 1.75rem;
      display:flex; flex-direction:column; box-shadow:0 4px 20px rgba(50,44,77,.05); transition:transform .3s, box-shadow .3s; }
    .kh-tier:hover { transform:translateY(-6px); box-shadow:0 20px 44px rgba(50,44,77,.14); }
    .kh-tier--feature { border-color:transparent; background: var(--violet); color:#fff; box-shadow:0 18px 48px rgba(94,23,235,.32); overflow:hidden; }
    .kh-tier--feature::before { content:''; position:absolute; right:-70px; top:-70px; width:190px; height:190px; border-radius:50%;
      background: var(--sun); opacity:.18; pointer-events:none; }
    .kh-tier--naaba { border-color: var(--navy); }
    .kh-tier__badge { position:absolute; top:-13px; left:50%; transform:translateX(-50%); font-size:.72rem; font-weight:800;
      letter-spacing:.05em; text-transform:uppercase; padding:.3rem .95rem; border-radius:999px; white-space:nowrap;
      background: var(--sun); color: var(--navy); box-shadow:0 4px 12px rgba(255,194,58,.45); z-index:2; }
    .kh-tier--feature .kh-tier__badge { top:14px; right:14px; left:auto; transform:none; }
    .kh-tier--naaba .kh-tier__badge { background: var(--navy); color: var(--sun); box-shadow:0 4px 12px rgba(50,44,77,.3); }
    .kh-tier__name { position:relative; display:inline-flex; align-items:center; gap:.45rem; font-family:'Baloo 2', system-ui, sans-serif;
      font-size:1.45rem; font-weight:800; color:var(--navy); margin-bottom:.2rem; }
    .kh-tier--feature .kh-tier__name { color:#fff; }
    .kh-tier__scope { font-size:.88rem; color:var(--muted); margin-bottom:1.1rem; }
    .kh-tier--feature .kh-tier__scope { color:rgba(255,255,255,.82); }
    .kh-tier__price { font-family:'Baloo 2', system-ui, sans-serif; font-size:2.1rem; font-weight:800; color:var(--navy); line-height:1.1; }
    .kh-tier--feature .kh-tier__price { color: var(--sun); }
    .kh-tier__price small { font-family: system-ui,-apple-system,'Segoe UI',Roboto,sans-serif; font-size:.88rem; font-weight:600; color:var(--muted); }
    .kh-tier--feature .kh-tier__price small { color:rgba(255,255,255,.8); }
    .kh-tier__price .save { display:inline-block; font-family: system-ui,-apple-system,'Segoe UI',Roboto,sans-serif; font-size:.72rem; font-weight:700;
      background: var(--sun-soft); color: var(--navy); padding:.12rem .5rem; border-radius:999px; margin-left:.4rem; vertical-align:middle; }
    .kh-feats { list-style:none; padding:0; margin:1.4rem 0; display:flex; flex-direction:column; gap:.7rem; flex:1; }
    .kh-feats li { display:flex; align-items:flex-start; gap:.6rem; font-size:.95rem; line-height:1.4; }
    .kh-feats li i { flex-shrink:0; margin-top:.1rem; }
    .kh-feats .yes { color: var(--violet); }
    .kh-feats .yesf { color: var(--sun); }
    .kh-feats .no { color:#cfcbdb; }
    .kh-tier--feature .kh-feats li { color:rgba(255,255,255,.94); }
    .kh-tier .kh-btn { width:100%; justify-content:center; position:relative; }
    .kh-tier__note { font-size:.78rem; color:var(--muted); text-align:center; margin-top:.7rem; }
    .kh-tier--feature .kh-tier__note { color:rgba(255,255,255,.78); }
    .kh-pricing-foot { text-align:center; margin-top:2rem; color:var(--muted); font-size:.92rem; }
    .kh-pricing-foot a { color:var(--violet); font-weight:600; text-decoration:none; }
    .kh-pricing-foot a:hover { text-decoration:underline; }

    /* CTA band */
    .kh-cta-band { position:relative; overflow:hidden; background: var(--navy); color:#fff; border-radius:28px;
      padding:clamp(2.5rem,6vw,4rem); display:grid; grid-template-columns: auto 1fr; gap: clamp(1.5rem,4vw,3rem); align-items:center;
      box-shadow:0 18px 50px rgba(50,44,77,.28); }
    .kh-cta-band::before { content:''; position:absolute; left:-90px; bottom:-110px; width:300px; height:300px; border-radius:50%;
      background: var(--sun); opacity:.16; pointer-events:none; }
    .kh-cta-band::after { content:''; position:absolute; right:-60px; top:-80px; width:220px; height:220px; border-radius:50%;
      background: var(--violet); opacity:.45; pointer-events:none; }
    .kh-cta-band__logo { position:relative; z-index:1; background:#fff; border-radius:20px; padding:1rem 1.2rem; }
    .kh-cta-band__logo img { display:block; width:200px; height:auto; }
    .kh-cta-band__body { position:relative; z-index:1; }
    .kh-cta-band h2 { font-size:clamp(1.6rem,3.5vw,2.3rem); font-weight:800; margin:0 0 .6rem; }
    .kh-cta-band p { opacity:.88; font-size:1.08rem; margin:0 0 1.6rem; max-width:560px; }

    /* Video modal (preserved) */
    .video-modal-overlay { display:none; position:fixed; inset:0; background:rgba(35,30,56,.72); backdrop-filter:blur(5px);
      z-index:9998; opacity:0; transition:opacity .3s ease; }
    .video-modal-overlay.active { display:block; opacity:1; }
    .video-modal { display:none; position:fixed; top:50%; left:50%; transform:translate(-50%,-50%) scale(.9); width:92%;
      max-width:880px; background:#fff; padding:1.25rem; border-radius:20px; z-index:9999; box-shadow:0 20px 60px rgba(0,0,0,.35);
      transition:transform .3s ease, opacity .3s ease; opacity:0; }
    .video-modal.active { display:block; transform:translate(-50%,-50%) scale(1); opacity:1; }
    .video-modal-close { position:absolute; top:-18px; right:-18px; background:#ffc23a; color:#322c4d; border:none; width:42px; height:42px;
      border-radius:50%; font-size:1.4rem; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all .3s ease; z-index:10000; }
    .video-modal-close:hover { transform:rotate(90deg) scale(1.08); }
    .video-modal .ratio-box { position:relative; padding-bottom:56.25%; border-radius:14px; overflow:hidden; background:#000; }
    .video-modal .ratio-box iframe { position:absolute; inset:0; width:100%; height:100%; border:0; }

    @media (max-width: 900px) {
      .kh-hero__grid { grid-template-columns: minmax(0,1fr); }
      .kh-showcase { order:-1; max-width:440px; margin: 0 auto; width:100%; }
      .kh-hero::before { width:340px; height:340px; right:-120px; top:-110px; }
      .kh-cta-band { grid-template-columns: 1fr; text-align:center; }
      .kh-cta-band__logo { justify-self:center; }
      .kh-cta-band p { margin-left:auto; margin-right:auto; }
      .kh-cta-band .kh-cta { justify-content:center; }
    }
    @media (max-width: 720px) {
      .kh-stats { grid-template-columns:repeat(2,1fr); margin-top:-1.8rem; }
      .kh-stat { justify-content:flex-start; }
      .kh-float--a { left:4px; }
      .kh-float--b { right:4px; }
      .video-modal-close { top:-14px; right:-14px; width:36px; height:36px; }
    }
  </style>
` %>

<div class="kh">

  <!-- Hero -->
  <section id="kalan-hero" class="kh-hero">
    <div class="kh-wrap kh-hero__grid">
      <div data-aos="fade-up">
        <span class="kh-eyebrow"><i class="bi bi-mortarboard-fill"></i> Programme e-learning lycée &amp; collège</span>
        <h1>Toutes vos matières : <span class="hl">de la peur à la réussite</span> avec <span class="brand">e-<b>K</b>alan</span></h1>
        <p class="lead">Mathématiques, Physique-Chimie, SVT et bien d'autres matières du programme : des cours clairs,
          des exercices corrigés et les sujets des meilleurs établissements — accessibles partout, à votre rythme.</p>
        <div class="kh-cta">
          <a href="<%= primaryCta.href %>" class="kh-btn kh-btn--violet kh-btn--lead"><i class="bi <%= primaryCta.icon %>"></i> <%= primaryCta.label %></a>
          <button type="button" class="kh-btn kh-btn--line" id="enSavoirPlusBtn"><i class="bi bi-play-circle"></i> En savoir plus</button>
        </div>
        <div class="kh-subjects">
          <span class="kh-chip"><i class="bi bi-calculator"></i> Mathématiques</span>
          <span class="kh-chip"><i class="bi bi-lightning-charge"></i> Physique-Chimie</span>
          <span class="kh-chip"><i class="bi bi-flower1"></i> SVT</span>
          <span class="kh-chip kh-chip--more"><i class="bi bi-plus-circle-fill"></i> Et bien d'autres</span>
        </div>
      </div>

      <div class="kh-showcase" data-aos="zoom-in" data-aos-delay="150">
        <div class="kh-logo-card">
