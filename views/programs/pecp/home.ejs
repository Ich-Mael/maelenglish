<% layout('layouts/pecpBoilerplate') %>
<link rel="preconnect" href="https://fonts.gstatic.com" />
<link href="https://fonts.googleapis.com/css2?family=Chango&display=swap" rel="stylesheet" />
<link href="stylesheets/pecp/home.css" rel="stylesheet" />
<!-- Series -->
<div class="banner-wrapper d-flex flex-column align-items-center justify-content-center">
  <div class="banner-content">
    <h1 class="banner-heading">Personal English Coaching Program</h1>
    <div class="buttons-wrapper d-flex flex-wrap justify-content-center" style="">
      <!-- Button trigger modal -->
      <a class=" btn my-2  mx-2 more btn btn-primary" data-bs-toggle="modal" data-bs-target="#more-pecp">
        En Savoir Plus
      </a>
      <a class="btn btn-success more my-2  mx-2 guide" href="https://drive.google.com/file/d/1hwTWJumD3ncuNh1QqZx_659T4K01nMtJ/view?usp=share_link" target="_blank">
        Telechargez le guide de l'apprenant (PECP)
      </a>
      <% if(currentUser){%>
      <% if (currentUser.isPecpStudent) {%>
      <a href="/user/<%= currentUser._id%>/pecpStudentDashboard/<%= currentUser.pecpStudent_id%>"
        class="my_pecp btn btn-success mx-2">My English Coaching Space</a>
      <%}%>

      <%}else {%>
      <a class="btn mx-2 my-2 more btn btn-primary" data-bs-toggle="modal" data-bs-target="#inscription">
        Contactez-nous pour s'inscrire
      </a>
      <%}%>

   <!-- Modal for know more -->
   <div class="modal fade" id="more-pecp" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
     <div class="modal-content">
      <div class="modal-header">
       <h5 class="modal-title" id="exampleModalLabel">Personal English Coaching Program</h5>
       <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
       <div id="tv-container">
        <div id="monitor">
         <div class="afrohk-TV">
          <h3 class="text-center afrohk-text mb-2 py-0">
           <span class="afrohk">AfroHK</span><span class="tv">Radar</span>
          </h3>
         </div>
         <div id="monitorscreen">
          <iframe id="vimeo-content" src="" frameborder="0" height="500px" width="1000px"
           allow="autoplay; fullscreen; picture-in-picture" allow="fullscreen" title="High-intensity Classes"></iframe>
         </div>
        </div>
       </div>
      </div>
      <div class="modal-footer">
       <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Quitter</button>
      </div>
     </div>
    </div>
   </div>

   <!-- Modal for Inscription -->
   <div class="modal fade" id="inscription" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
     <div class="modal-content">
      <div class="modal-header">
       <h5 class="modal-title" id="exampleModalLabel">Contactez-nous</h5>
       <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
       <h1 class="text-center py-3 bg-dark text-white">PECP Program Director Contact</h1>
       <hr>
       <div class="d-flex  justify-content-around" style="background-color: white;">
        <button id="" class="bg-white">
          <a id="" class=" fs-4" style="color: rgb(88, 7, 139);" href="mailto:afrohouseofknowledge@gmail.com?"><i class="fa mx-2 p-3 fa-envelope-o" id=""  aria-hidden="true"></i><span>Mail</span></a>
         </button>

        <button id="" class="bg-white">
         <a id="" class="fs-4" href=" tel: +22653344444">
          <i class="fa p-3 mx-2 fa-phone" aria-hidden="true"></i><span>Appel</span>
         </a>
        </button>
                
        <button id="" class="bg-white">
         <a id="" class="text-success  fs-4" style="text-decoration: none;" href="https://wa.me/22653344444"
          target="_blank">
          <i class="fa mx-2 p-3 fa-whatsapp" aria-hidden="true"></i>
          <span class="">WhatsApp</span></a>
        </button>

       </div>
      </div>
      <div class="modal-footer">
       <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Quitter</button>
      </div>
     </div>
    </div>
   </div>
  </div>
 </div>
</div>