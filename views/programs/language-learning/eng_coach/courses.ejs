<% layout('layouts/main') %>

<style>
  :root {
    --primary-color: #5d06ba;
    --primary-light: #f3e5f5;
    --primary-dark: #2d0370;
    --text-dark: #1d1d1f;
    --text-muted: #6e6e73;
    --border-color: #e5e5e5;
    --card-bg: #ffffff;
    --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --shadow-md: 0 10px 30px rgba(0, 0, 0, 0.1);
    --radius-md: 16px;
    font-family: 'Outfit', sans-serif;
  }
  
  body {
    background-color: #f8f9fa;
    font-family: var(--font-family);
  }

  .page-header {
    background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
    color: white;
    padding: 7rem 0 5rem 0;
    margin-bottom: -3rem;
    position: relative;
    z-index: 1;
  }

  .page-title {
    font-size: 2.2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    font-size: 1.1rem;
    opacity: 0.9;
    font-weight: 300;
  }

  .content-wrapper {
    position: relative;
    z-index: 2;
    padding-bottom: 3rem;
  }

  .course-card {
    background: white;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: none;
    box-shadow: var(--shadow-sm);
    transition: all 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .course-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
  }

  .course-img {
    height: 180px;
    background-color: #eee;
    background-size: cover;
    background-position: center;
    position: relative;
  }

  .course-body {
    padding: 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .course-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 0.5rem;
    text-decoration: none;
  }

  .course-meta {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .btn-primary-custom {
    background: linear-gradient(135deg, #5d06ba 0%, #4a0496 100%);
    border: none;
    padding: 0.8rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    color: white;
    transition: all 0.3s ease;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-decoration: none;
    margin-top: auto;
  }

  .btn-primary-custom:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(93, 6, 186, 0.3);
    color: white;
  }
</style>

<!-- Header -->
<div class="page-header">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-8">
        <h1 class="page-title">
          My Courses
        </h1>
        <p class="page-subtitle">
          Access and manage your assigned courses
        </p>
      </div>
    </div>
  </div>
</div>

<div class="container content-wrapper">
  <% if (courses && courses.length > 0) { %>
    <div class="row g-4">
      <% courses.forEach(assignment => { %>
        <% const course = assignment.courseId; %>
        <div class="col-md-6 col-lg-4">
          <div class="course-card">
            <div class="course-img" style="background-image: url('<%= course.image || 'https://images.unsplash.com/photo-1546410531-bb4caa6b424d' %>')">
            </div>
            <div class="course-body">
              <h5 class="course-title"><%= course.title %></h5>
              <div class="course-meta">
                <i class="bi bi-layers me-1"></i> <%= assignment.modulesAccess.length %> Modules Access
              </div>
              <p class="text-muted small mb-4">
                <%= course.description ? course.description.substring(0, 100) + '...' : 'No description available.' %>
              </p>
              <a href="/programs/language-learning/instructor/courses/<%= course._id %>" class="btn-primary-custom">
                View Details <i class="bi bi-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="col-12">
      <div class="text-center py-5 bg-white rounded-3 shadow-sm">
        <i class="bi bi-journal-x fs-1 text-muted mb-3 d-block"></i>
        <h5 class="text-muted">No active courses assigned.</h5>
        <p class="small text-muted mb-0">Contact an administrator to get assigned to a course.</p>
      </div>
    </div>
  <% } %>
</div>
