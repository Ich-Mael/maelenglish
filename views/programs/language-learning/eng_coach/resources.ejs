<% layout('layouts/main') %>

<style>
  :root {
    --primary-color: #5d06ba;
    --primary-light: #f3e5f5;
    --primary-dark: #2d0370;
    --text-dark: #1d1d1f;
    --text-muted: #6e6e73;
    --border-color: #e5e5e5;
    --card-bg: #ffffff;
    --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --shadow-md: 0 10px 30px rgba(0, 0, 0, 0.1);
    --radius-md: 16px;
    font-family: 'Outfit', sans-serif;
  }
  
  body {
    background-color: #f8f9fa;
    font-family: var(--font-family);
  }

  .page-header {
    background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
    color: white;
    padding: 7rem 0 5rem 0;
    margin-bottom: -3rem;
    position: relative;
    z-index: 1;
  }

  .breadcrumb-item a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-weight: 500;
  }
  
  .breadcrumb-item.active {
    color: rgba(255, 255, 255, 0.9);
  }
  
  .breadcrumb-item + .breadcrumb-item::before {
    color: rgba(255, 255, 255, 0.5);
  }

  .page-title {
    font-size: 2.2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    font-size: 1.1rem;
    opacity: 0.9;
    font-weight: 300;
  }

  .content-wrapper {
    position: relative;
    z-index: 2;
    padding-bottom: 3rem;
  }

  .resource-card {
    background: white;
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 1rem;
    border: 1px solid rgba(0,0,0,0.05);
    box-shadow: var(--shadow-sm);
    transition: all 0.2s ease;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .resource-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--primary-light);
  }

  .resource-icon {
    width: 60px;
    height: 60px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    background-color: var(--primary-light);
    color: var(--primary-color);
    flex-shrink: 0;
  }

  .resource-info h5 {
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 0.25rem;
  }

  .resource-meta {
    font-size: 0.9rem;
    color: var(--text-muted);
    display: flex;
    gap: 1rem;
  }

  .badge-type {
    background-color: #f8f9fa;
    color: var(--text-muted);
    border: 1px solid #e9ecef;
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .btn-action {
    background: var(--primary-color);
    color: white;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
    border: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-action:hover {
    background: var(--primary-dark);
    color: white;
    transform: translateY(-2px);
  }
</style>

<!-- Header -->
<div class="page-header">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-3">
        <li class="breadcrumb-item"><a href="/maelenglish/instructor/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="/maelenglish/instructor/courses">My Courses</a></li>
        <li class="breadcrumb-item active" aria-current="page">Resources</li>
      </ol>
    </nav>
    <div class="d-flex align-items-center gap-3">
      <div style="background: rgba(255,255,255,0.2); padding: 0.5rem; border-radius: 12px;">
        <i class="bi bi-folder2-open fs-2"></i>
      </div>
      <div>
        <h1 class="page-title mb-0">
          Module Resources
        </h1>
        <p class="page-subtitle mb-0">
          <%= module.title %>
        </p>
      </div>
    </div>
  </div>
</div>

<div class="container content-wrapper">
  
  <% if (resources && resources.length > 0) { %>
    <div class="row">
      <div class="col-lg-10 mx-auto">
        <% resources.forEach(resource => { %>
          <div class="resource-card">
            <div class="d-flex align-items-center gap-4">
              <div class="resource-icon">
                <% if (resource.type === 'Lesson Plan') { %>
                  <i class="bi bi-journal-text"></i>
                <% } else if (resource.type === 'Teaching Guide') { %>
                  <i class="bi bi-compass"></i>
                <% } else if (resource.type === 'Answer Key') { %>
                  <i class="bi bi-check2-circle"></i>
                <% } else if (resource.type === 'Presentation Slides') { %>
                  <i class="bi bi-easel"></i>
                <% } else { %>
                  <i class="bi bi-file-earmark-text"></i>
                <% } %>
              </div>
              <div class="resource-info">
                <h5><%= resource.title %></h5>
                <div class="d-flex align-items-center gap-3 mb-1">
                  <span class="badge-type"><%= resource.type %></span>
                  <span class="text-muted small"><i class="bi bi-eye me-1"></i> <%= resource.viewCount || 0 %> views</span>
                </div>
                <% if (resource.description) { %>
                  <p class="text-muted small mb-0 text-truncate" style="max-width: 400px;">
                    <%- resource.description.replace(/<[^>]*>/g, '').substring(0, 100) %>
                  </p>
                <% } %>
              </div>
            </div>
            
            <a href="/maelenglish/instructor/resources/view/<%= resource._id %>" class="btn-action">
              View Resource <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        <% }); %>
      </div>
    </div>
  <% } else { %>
    <div class="text-center py-5 bg-white rounded-3 shadow-sm col-lg-8 mx-auto">
      <div class="mb-3">
        <span class="p-4 rounded-circle bg-light d-inline-block">
          <i class="bi bi-folder2-open fs-1 text-muted"></i>
        </span>
      </div>
      <h4 class="fw-bold text-dark">No Resources Available</h4>
      <p class="text-muted">There are teaching resources currently assigned to this module.</p>
      <a href="/maelenglish/instructor/courses" class="btn btn-outline-secondary mt-2">
        <i class="bi bi-arrow-left me-2"></i> Back to Courses
      </a>
    </div>
  <% } %>
</div>
