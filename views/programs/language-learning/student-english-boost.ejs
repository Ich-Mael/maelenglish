<% layout('layouts/main') %>

<style>
  :root {
    --primary-color: #5d06ba;
    --primary-light: #f3e5f5;
    --primary-dark: #2d0370;
    --text-dark: #1a1a1a;
    --text-muted: #666;
    font-family: "Outfit", sans-serif;
  }

  /* Hero */
  .esb-hero {
    padding: 120px 0 80px;
    background: linear-gradient(135deg, #1a0533 0%, #2d0370 50%, #4b08a1 100%);
    position: relative;
    overflow: hidden;
  }

  .esb-hero::before {
    content: '';
    position: absolute;
    top: -100px;
    right: -100px;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: rgba(93, 6, 186, 0.2);
    filter: blur(80px);
  }

  .esb-hero::after {
    content: '';
    position: absolute;
    bottom: -80px;
    left: -80px;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    filter: blur(60px);
  }

  .esb-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    padding: 8px 20px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 24px;
    backdrop-filter: blur(10px);
  }

  .esb-hero-title {
    font-size: 3.8rem;
    font-weight: 800;
    color: #fff;
    line-height: 1.1;
    margin-bottom: 20px;
  }

  .esb-hero-title span {
    color: #c084fc;
  }

  .esb-hero-subtitle {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 40px;
    line-height: 1.7;
  }

  .esb-hero-stats {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
  }

  .esb-stat {
    text-align: center;
  }

  .esb-stat-number {
    font-size: 2.2rem;
    font-weight: 800;
    color: #c084fc;
    line-height: 1;
  }

  .esb-stat-label {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.65);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-top: 4px;
  }

  .esb-hero-image {
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4);
    border: 3px solid rgba(255, 255, 255, 0.15);
    position: relative;
    z-index: 2;
  }

  .esb-hero-image img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    display: block;
  }

  /* Section base */
  .esb-section {
    padding: 80px 0;
  }

  .esb-section-alt {
    background: #fafafa;
  }

  .esb-section-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 12px;
  }

  .esb-section-title span {
    color: var(--primary-color);
  }

  .esb-divider {
    width: 60px;
    height: 4px;
    background: linear-gradient(90deg, var(--primary-color), #c084fc);
    border-radius: 2px;
    margin-bottom: 24px;
  }

  /* Scholarship highlight */
  .scholarship-card {
    background: linear-gradient(135deg, var(--primary-dark) 0%, #4b08a1 100%);
    border-radius: 24px;
    padding: 48px;
    color: #fff;
    position: relative;
    overflow: hidden;
  }

  .scholarship-card::before {
    content: '';
    position: absolute;
    top: -60px;
    right: -60px;
    width: 250px;
    height: 250px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
  }

  .scholarship-table {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    overflow: hidden;
    margin-top: 24px;
  }

  .scholarship-table table {
    width: 100%;
    margin: 0;
    color: #fff;
  }

  .scholarship-table th {
    background: rgba(255, 255, 255, 0.15);
    padding: 14px 20px;
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .scholarship-table td {
    padding: 14px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.95rem;
  }

  .scholarship-table tr:last-child td {
    border-bottom: none;
    font-weight: 700;
    font-size: 1.1rem;
    color: #c084fc;
  }

  .scholarship-table tr:last-child {
    background: rgba(255, 255, 255, 0.08);
  }

  .bourses-badge {
    display: inline-block;
    background: #c084fc;
    color: var(--primary-dark);
    font-weight: 800;
    font-size: 1rem;
    padding: 8px 24px;
    border-radius: 50px;
    margin-top: 20px;
  }

  /* Feature cards */
  .feature-card {
    background: #fff;
    border-radius: 20px;
    padding: 32px 28px;
    height: 100%;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(93, 6, 186, 0.08);
    transition: all 0.3s ease;
  }

  .feature-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(93, 6, 186, 0.12);
    border-color: rgba(93, 6, 186, 0.2);
  }

  .feature-icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: var(--primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .feature-icon i {
    font-size: 26px;
    color: var(--primary-color);
  }

  .feature-card h5 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 10px;
  }

  .feature-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* Schedule */
  .schedule-card {
    border-radius: 20px;
    padding: 32px;
    height: 100%;
  }

  .schedule-card.presentiel {
    background: linear-gradient(135deg, #fff7e6, #fff3d4);
    border: 2px solid #f59e0b;
  }

  .schedule-card.online {
    background: linear-gradient(135deg, #e8f4fd, #dbeafe);
    border: 2px solid #3b82f6;
  }

  .schedule-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
  }

  .schedule-label.presentiel { color: #d97706; }
  .schedule-label.online { color: #2563eb; }

  .schedule-card h4 {
    font-size: 1.2rem;
    font-weight: 800;
    margin-bottom: 16px;
    color: var(--text-dark);
  }

  /* Sessions */
  .session-card {
    background: #fff;
    border-radius: 16px;
    padding: 28px;
    border: 2px solid transparent;
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    transition: all 0.3s ease;
    height: 100%;
  }

  .session-card:hover {
    border-color: var(--primary-color);
    box-shadow: 0 8px 32px rgba(93, 6, 186, 0.12);
  }

  .session-number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--primary-light);
    color: var(--primary-color);
    font-weight: 800;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }

  .session-card h5 {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-dark);
    margin-bottom: 6px;
  }

  .session-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* Centers */
  .center-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 20px;
    background: #fff;
    border-radius: 14px;
    border: 1px solid rgba(93, 6, 186, 0.1);
    margin-bottom: 16px;
    transition: all 0.3s ease;
  }

  .center-item:hover {
    border-color: var(--primary-color);
    box-shadow: 0 4px 16px rgba(93, 6, 186, 0.08);
  }

  .center-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .center-icon i {
    color: var(--primary-color);
    font-size: 20px;
  }

  /* Eligibility */
  .eligibility-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 16px;
    padding: 16px 20px;
    background: #fff;
    border-radius: 12px;
    border-left: 4px solid var(--primary-color);
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }

  .eligibility-item i {
    color: var(--primary-color);
    font-size: 20px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Steps */
  .step-card {
    background: #fff;
    border-radius: 20px;
    padding: 32px 28px;
    height: 100%;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    position: relative;
    text-align: center;
  }

  .step-number {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
    color: #fff;
    font-weight: 800;
    font-size: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    box-shadow: 0 6px 20px rgba(93, 6, 186, 0.3);
  }

  .step-card h5 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 10px;
  }

  .step-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* Why join */
  .why-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    margin-bottom: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .why-item i {
    color: #a3e635;
    font-size: 22px;
    flex-shrink: 0;
  }

  .why-item span {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1rem;
    font-weight: 500;
  }

  /* CTA */
  .esb-cta {
    background: linear-gradient(135deg, #1a0533 0%, #2d0370 60%, #4b08a1 100%);
    padding: 80px 0;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .esb-cta::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: rgba(93, 6, 186, 0.2);
    filter: blur(100px);
  }

  .btn-esb-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 40px;
    background: linear-gradient(135deg, #5d06ba, #4b08a1);
    color: #fff;
    text-decoration: none;
    border-radius: 50px;
    font-weight: 700;
    font-size: 1rem;
    transition: all 0.3s ease;
    box-shadow: 0 8px 28px rgba(93, 6, 186, 0.4);
    border: 2px solid rgba(255,255,255,0.15);
  }

  .btn-esb-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 36px rgba(93, 6, 186, 0.5);
    color: #fff;
  }

  .btn-esb-outline {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 40px;
    background: transparent;
    color: #fff;
    text-decoration: none;
    border-radius: 50px;
    font-weight: 700;
    font-size: 1rem;
    transition: all 0.3s ease;
    border: 2px solid rgba(255,255,255,0.4);
  }

  .btn-esb-outline:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.7);
    color: #fff;
    transform: translateY(-3px);
  }

  @media (max-width: 768px) {
    .esb-hero-title { font-size: 2.4rem; }
    .scholarship-card { padding: 28px 20px; }
    .esb-hero-stats { gap: 20px; }
  }
</style>

<!-- Hero -->
<section class="esb-hero">
  <div class="container position-relative" style="z-index: 2;">
    <div class="row align-items-center g-5">
      <div class="col-lg-6" data-aos="fade-right">
        <div class="esb-badge">
          <i class="bi bi-mortarboard-fill"></i> Bourse Partielle · 200 places
