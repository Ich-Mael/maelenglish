<% layout('layouts/main') %>

<style>
  :root {
    --primary-color: #5d06ba;
    --primary-light: #f3e5f5; /* Light purple for backgrounds */
    --primary-dark: #2d0370;
    --accent-color: #5d06ba; /* Unified accent */
    --warm-bg: #ffffff; /* Clean white background */
    --text-dark: #1a1a1a;
    --text-muted: #666;
    --radius-xl: 32px;
    font-family: "Outfit", sans-serif;
  }

  body {
    background-color: var(--warm-bg);
    color: var(--text-dark);
  }

  /* 1. Hero V3 */
  .hero-v3 {
    padding: 140px 0 100px;
    position: relative;
    overflow: hidden;
  }

  .hero-v3-bg {
    position: absolute;
    top: 0;
    right: 0;
    width: 60%;
    height: 100%;
    background:
      linear-gradient(90deg, var(--warm-bg) 0%, rgba(255, 255, 255, 0) 100%),
      url("/assets/img/english4all-hero-v3.png");
    background-size: cover;
    background-position: center;
    opacity: 0.15; /* Subtle background texture */
    z-index: 0;
    mask-image: linear-gradient(to right, transparent, black);
    -webkit-mask-image: linear-gradient(to right, transparent, black);
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .badge-premium {
    background: var(--primary-light);
    color: var(--primary-dark);
    border: 1px solid rgba(93, 6, 186, 0.2);
    padding: 8px 20px;
    border-radius: 50px;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 1px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
  }

  .hero-title-v3 {
    font-size: 4.5rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 24px;
    color: var(--text-dark);
  }

  .hero-title-v3 span {
    color: var(--primary-color);
  }

  .hero-desc {
    font-size: 1.4rem;
    color: var(--text-muted);
    max-width: 600px;
    margin-bottom: 40px;
    line-height: 1.6;
  }

  .hero-image-frame {
    position: relative;
    z-index: 2;
  }

  .hero-img-main {
    border-radius: 40px 0 40px 40px;
    box-shadow: -20px 20px 0 var(--primary-color);
    transition: transform 0.4s ease;
  }

  .hero-img-main:hover {
    transform: translate(5px, -5px);
    box-shadow: -15px 15px 0 var(--primary-dark);
  }

  /* 2. Program Cards V3 */
  .programs-section {
    padding: 80px 0;
  }

  .program-card-v3 {
    background: white;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.06);
    transition: all 0.4s ease;
    height: 100%;
    border: 1px solid rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
  }

  .program-card-v3:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 60px rgba(93, 6, 186, 0.15);
  }

  .card-img-wrapper {
    height: 280px;
    position: relative;
    overflow: hidden;
  }

  .card-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .program-card-v3:hover .card-img-wrapper img {
    transform: scale(1.05);
  }

  .card-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 24px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
    color: white;
  }

  .program-tag {
    background: var(--primary-color);
    color: white;
    padding: 4px 12px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 8px;
  }

  .program-content {
    padding: 32px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .program-title {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 16px;
    color: var(--text-dark);
  }

  .program-text {
    color: var(--text-muted);
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 24px;
    flex: 1;
  }

  .btn-program {
    width: 100%;
    padding: 16px;
    border-radius: 16px;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    transition: all 0.3s ease;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
  }

  .btn-program.primary {
    background: var(--primary-color);
    color: white;
  }

  .btn-program.primary:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
  }

  .btn-program.outline {
    background: transparent;
    border: 2px solid var(--primary-color);
    color: var(--primary-color);
  }

  .btn-program.outline:hover {
    background: var(--primary-color);
    color: white;
  }

  /* 3. Value Props Grid */
  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 30px;
    margin-top: 60px;
  }

  .value-card {
    background: white;
    padding: 32px;
    border-radius: 20px;
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  .value-icon {
    width: 60px;
    height: 60px;
    background: var(--primary-light);
    color: var(--primary-color);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin-bottom: 20px;
  }

  @media (max-width: 991px) {
    .hero-v3 {
      padding: 100px 0 60px;
      text-align: center;
    }
    .hero-title-v3 {
      font-size: 3rem;
    }
    .hero-desc {
      margin: 0 auto 40px;
    }
    .hero-v3-bg {
      width: 100%;
      opacity: 0.1;
    }
    .hero-img-main {
      margin-top: 40px;
      margin-bottom: 20px;
    }
  }
</style>

