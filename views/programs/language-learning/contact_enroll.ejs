<% layout('layouts/main') %>

<style>
  .contact-enroll-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
    padding: 100px 20px 40px; /* Reduced top padding */
    position: relative;
    overflow: hidden;
  }

  /* Animated background shapes */
  .contact-enroll-wrapper::before,
  .contact-enroll-wrapper::after {
    content: '';
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    filter: blur(80px);
    z-index: 0;
  }
  
  .contact-enroll-wrapper::before {
    background: rgba(93, 6, 186, 0.3);
    top: 20%;
    left: 10%;
    animation: float 10s infinite ease-in-out;
  }
  
  .contact-enroll-wrapper::after {
    background: rgba(37, 211, 102, 0.2); /* WhatsApp green hint */
    bottom: 20%;
    right: 10%;
    animation: float 12s infinite ease-in-out reverse;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(30px, -30px); }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .contact-card {
    background: rgba(255, 255, 255, 0.05); /* Dark Glassmorphism */
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 40px 30px; /* Compact padding */
    border-radius: 32px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    max-width: 500px; /* Slightly narrower */
    width: 100%;
    text-align: center;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .icon-circle {
    width: 80px; /* Smaller icon */
    height: 80px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
    color: #e0aaff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    margin: 0 auto 20px;
    animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
    opacity: 0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  .contact-title {
    font-size: 2rem; /* Adjusted font size */
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 15px;
    font-family: 'Outfit', sans-serif;
    line-height: 1.1;
    animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
    opacity: 0;
    text-shadow: 0 2px 10px rgba(0,0,0,0.3);
  }

  .contact-text {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1rem;
    line-height: 1.5;
    margin-bottom: 30px;
    animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    opacity: 0;
  }
  
  .contact-text strong {
      color: white;
      font-weight: 600;
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;
    opacity: 0;
  }

  .action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-weight: 600;
    font-size: 1rem;
    padding: 15px 24px;
    border-radius: 14px;
    text-decoration: none;
    transition: all 0.3s ease;
    width: 100%;
    border: 1px solid transparent;
  }

  .whatsapp-btn {
    background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
    color: white;
    box-shadow: 0 10px 20px rgba(37, 211, 102, 0.3);
  }

  .whatsapp-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(37, 211, 102, 0.4);
    color: white;
    filter: brightness(1.1);
  }

  .call-btn {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(5px);
  }

  .call-btn:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.2);
    color: white;
    border-color: rgba(255, 255, 255, 0.3);
  }

  @media (max-width: 576px) {
      .contact-card {
          padding: 30px 20px;
          border-radius: 24px;
      }
      .contact-title {
          font-size: 1.75rem;
      }
      .icon-circle {
          width: 70px;
          height: 70px;
          font-size: 2rem;
      }
      .contact-enroll-wrapper {
          padding: 100px 15px 30px;
      }
  }
</style>

<div class="contact-enroll-wrapper">
  <div class="contact-card">
    <div class="icon-circle">
      <i class="bi bi-headset"></i>
    </div>
    
    <h1 class="contact-title">Contactez l'administration</h1>
    
    <p class="contact-text">
        Pour <strong>finaliser votre inscription</strong> ou <strong>prolonger votre accès</strong> aux cours MaelEnglish, veuillez contacter un conseiller pour assistance.
    </p>

    <div class="contact-actions">
      <!-- WhatsApp (Primary) -->
      <a href="https://wa.me/22667323131" target="_blank" class="action-btn whatsapp-btn">
        <i class="bi bi-whatsapp"></i>
        Discuter sur WhatsApp
      </a>

      <!-- Call 1 -->
      <a href="tel:+22667323131" class="action-btn call-btn">
        <i class="bi bi-telephone-fill"></i>
        Appeler (+226 67 32 31 31)
      </a>
      
      <!-- Call 2 (New Number) -->
      <a href="tel:+22653344444" class="action-btn call-btn">
        <i class="bi bi-telephone-fill"></i>
        Appeler (+226 53 34 44 44)
      </a>
    </div>

  </div>
</div>
