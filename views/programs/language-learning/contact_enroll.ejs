<% layout('layouts/main') %>

<style>
  .contact-enroll-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f5f7fa 0%, #e4e7eb 100%);
    padding: 120px 20px 40px; /* Added top padding for navbar */
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .contact-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    padding: 60px 40px;
    border-radius: 32px;
    box-shadow: 0 30px 80px rgba(93, 6, 186, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.6);
    max-width: 550px;
    width: 100%;
    text-align: center;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .icon-circle {
    width: 100px;
    height: 100px;
    background: linear-gradient(135deg, rgba(93, 6, 186, 0.1) 0%, rgba(0, 210, 211, 0.1) 100%);
    color: #5d06ba;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    margin: 0 auto 30px;
    animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
    opacity: 0; /* Init hidden for animation */
    animation-fill-mode: forwards;
  }

  .contact-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: #1d1d1f;
    margin-bottom: 20px;
    font-family: 'Outfit', sans-serif;
    line-height: 1.1;
    animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
    opacity: 0;
  }

  .contact-text {
    color: #6e6e73;
    font-size: 1.15rem;
    line-height: 1.6;
    margin-bottom: 50px;
    animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    opacity: 0;
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;
    opacity: 0;
  }

  .whatsapp-btn, .call-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-weight: 700;
    font-size: 1.1rem;
    padding: 16px 32px;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.3s ease;
    width: 100%;
  }

  .whatsapp-btn {
    background: #25D366;
    color: white;
    box-shadow: 0 10px 20px rgba(37, 211, 102, 0.2);
  }

  .whatsapp-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(37, 211, 102, 0.3);
    color: white;
  }

  .call-btn {
    background: #1d1d1f;
    color: white;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
  }

  .call-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
    color: white;
  }
</style>

<div class="contact-enroll-wrapper">
  <div class="contact-card">
    <div class="icon-circle">
      <i class="bi bi-person-lines-fill"></i>
    </div>
    
    <h1 class="contact-title">Finalisez votre inscription</h1>
    
    <p class="contact-text">
      Pour rejoindre le programme <strong>General English Boost</strong>, échangez directement avec un conseiller qui validera votre dossier.
    </p>

    <div class="contact-actions">
      <a href="https://wa.me/22667323131" target="_blank" class="whatsapp-btn">
        <i class="bi bi-whatsapp"></i>
        Discuter sur WhatsApp
      </a>

      <a href="tel:+22667323131" class="call-btn">
        <i class="bi bi-telephone-fill"></i>
        Appeler maintenant (+226 67 32 31 31)
      </a>
    </div>

  </div>
</div>
