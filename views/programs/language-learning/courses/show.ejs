<% layout('layouts/main') %>
<%# MaelEnglish — course page (GET /maelenglish/cours/:course_id, coursesController.showCourse, behind checkCourseAccess).
    Locals: course (modules + instructors populated), start/end (session dates), isEnrolled, isStaff, accessEnd,
    program (linked catalogue programme or null). Brand tokens from /assets/css/maelenglish.css; page styles scoped .cs-*. %>
<% headContent = `
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800;900&display=swap" rel="stylesheet">
  <link href="/assets/css/maelenglish.css" rel="stylesheet">
` %>
<%
  const prog = typeof program !== 'undefined' ? program : null;
  const enrolled = typeof isEnrolled !== 'undefined' && isEnrolled;
  const staff = typeof isStaff !== 'undefined' && isStaff;
  const modules = course.modules || [];
  const instructors = course.instructors || [];
  const firstModule = modules[0] || null;
  const accessEndLabel = typeof accessEnd !== 'undefined' && accessEnd
    ? accessEnd.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) : null;
  const daysLeft = typeof accessEnd !== 'undefined' && accessEnd ? Math.ceil((accessEnd - new Date()) / 864e5) : null;
  const hasExam = course.finalExam && course.finalExam.questions && course.finalExam.questions.length > 0;
  const hasProject = course.finalProject && course.finalProject.title;
  const plain = (html) => String(html || '').replace(/<[^>]*>?/gm, ' ').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim();
  const heroImg = course.courseImageUrl || null;
%>

<style>
  .cs-page { background: var(--me-bg); min-height: 100vh; padding-bottom: 88px; }

  /* Hero */
  .cs-hero {
    position: relative; overflow: hidden; color: #fff;
    background: linear-gradient(135deg, var(--me-blue-deep) 0%, var(--me-blue-dark) 55%, var(--me-blue) 100%);
    padding: 116px 0 120px;
  }
  .cs-hero-bg { position: absolute; inset: 0; opacity: .14; }
  .cs-hero-bg img, .cs-hero-bg picture { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cs-hero::before {
    content: ''; position: absolute; width: 460px; height: 460px; right: -140px; top: -160px; border-radius: 50%;
    background: radial-gradient(circle, rgba(255,87,87,.4), transparent 70%); pointer-events: none;
  }
  .cs-hero .container { position: relative; z-index: 1; }
  .cs-crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: .86rem; margin-bottom: 26px; }
  .cs-crumbs a { color: rgba(255,255,255,.75); }
  .cs-crumbs a:hover { color: #fff; }
  .cs-crumbs i { color: rgba(255,255,255,.4); font-size: .7rem; }
  .cs-logo { height: 48px; width: auto; display: block; margin-bottom: 22px; }
  .cs-chip {
    display: inline-flex; align-items: center; gap: 8px; font-size: .78rem; font-weight: 700;
    letter-spacing: .06em; text-transform: uppercase; padding: 6px 14px; border-radius: 50px; margin-bottom: 16px;
    background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2); color: #fff;
  }
  .cs-chip i { color: var(--me-coral); }
  .cs-chip--coral { background: var(--me-coral); border-color: var(--me-coral); }
  .cs-chip--coral i { color: #fff; }
  .cs-hero h1 {
    font-family: var(--me-font-display); font-weight: 900; color: #fff !important;
    font-size: clamp(2rem, 4.6vw, 3.2rem); line-height: 1.1; letter-spacing: -.015em; margin: 0 0 14px; max-width: 820px;
    background: none !important; -webkit-text-fill-color: #fff !important;
  }
  .cs-hero-lead { color: rgba(255,255,255,.8); font-size: 1.1rem; max-width: 640px; margin: 0; }
  .cs-facts { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .cs-fact {
    display: inline-flex; align-items: center; gap: 8px; font-size: .88rem; font-weight: 600;
    background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.16); border-radius: 12px; padding: 8px 14px;
  }
  .cs-fact i { color: var(--me-coral); }

  /* Layout */
  .cs-grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 32px; margin-top: -72px; position: relative; z-index: 2; }

  .cs-card {
    background: #fff; border: 1px solid var(--me-line); border-radius: var(--me-radius);
    box-shadow: var(--me-shadow); padding: 30px; margin-bottom: 24px;
  }
  .cs-card-head { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
  .cs-card-head i {
    width: 42px; height: 42px; border-radius: 12px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 1.2rem;
    background: var(--me-blue-soft); color: var(--me-blue);
  }
  .cs-card-head h2 { font-family: var(--me-font-display); font-weight: 800; font-size: 1.35rem; margin: 0; color: var(--me-ink); }
  .cs-card-head .cs-count { margin-left: auto; font-size: .82rem; font-weight: 700; color: var(--me-coral); background: var(--me-coral-soft); padding: 4px 11px; border-radius: 50px; }
  .cs-rich { color: #3b4160; line-height: 1.8; font-size: 1.02rem; }
  .cs-rich ul { padding-left: 0; list-style: none; }
  .cs-rich li { position: relative; padding-left: 28px; margin-bottom: 8px; }
  .cs-rich li::before {
    content: '\F26E'; font-family: 'bootstrap-icons'; position: absolute; left: 0; top: 0; color: var(--me-coral);
  }
  .cs-rich p:last-child { margin-bottom: 0; }

  /* Modules */
  .cs-modules { display: flex; flex-direction: column; gap: 12px; }
  .cs-module {
    display: flex; align-items: center; gap: 16px; padding: 16px 18px; border-radius: 16px;
    border: 1px solid var(--me-line); background: #fff; color: inherit; text-decoration: none;
    transition: border-color .2s, box-shadow .2s, transform .2s;
  }
  .cs-module:hover { border-color: var(--me-blue); box-shadow: 0 10px 24px -14px rgba(54,79,171,.5); transform: translateX(4px); color: inherit; }
  .cs-module:focus-visible { outline: 3px solid rgba(54,79,171,.35); outline-offset: 2px; }
  .cs-module-num {
    width: 38px; height: 38px; border-radius: 12px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
    font-family: var(--me-font-display); font-weight: 800; background: var(--me-blue); color: #fff;
  }
  .cs-module:first-child .cs-module-num { background: var(--me-coral); }
  .cs-module-info { flex: 1; min-width: 0; }
  .cs-module-info h3 { font-size: 1.05rem; font-weight: 700; margin: 0; color: var(--me-ink); font-family: var(--me-font-body); }
  .cs-module-info p { margin: 3px 0 0; font-size: .88rem; color: var(--me-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cs-module-go { color: var(--me-blue); font-size: 1.1rem; transition: color .2s, transform .2s; }
  .cs-module:hover .cs-module-go { color: var(--me-coral); transform: translateX(3px); }

  /* Coaches */
  .cs-coaches { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 14px; }
  .cs-coach { display: flex; align-items: center; gap: 14px; padding: 14px; border-radius: 16px; background: var(--me-bg); }
  .cs-coach img, .cs-coach-ph {
    width: 56px; height: 56px; border-radius: 50%; object-fit: cover; flex-shrink: 0;
    border: 3px solid #fff; box-shadow: 0 4px 10px rgba(31,47,115,.15);
  }
  .cs-coach-ph { display: flex; align-items: center; justify-content: center; background: var(--me-blue); color: #fff; font-weight: 800; font-family: var(--me-font-display); }
  .cs-coach h3 { font-size: 1rem; font-weight: 700; margin: 0; color: var(--me-ink); font-family: var(--me-font-body); }
  .cs-coach p { margin: 2px 0 0; font-size: .82rem; color: var(--me-coral); font-weight: 600; }

  /* Sidebar */
  .cs-side { position: sticky; top: 100px; }
  .cs-panel { background: #fff; border: 1px solid var(--me-line); border-radius: var(--me-radius); box-shadow: var(--me-shadow); overflow: hidden; }
  .cs-panel-bar { height: 5px; background: linear-gradient(90deg, var(--me-coral) 0%, var(--me-coral) 50%, var(--me-blue) 50%, var(--me-blue) 100%); }
  .cs-panel-body { padding: 26px; }
  .cs-status { display: flex; align-items: center; gap: 12px; margin-bottom: 6px; }
  .cs-status-icon { width: 44px; height: 44px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; flex-shrink: 0; }
  .cs-status-icon--ok { background: var(--me-blue-soft); color: var(--me-blue); }
  .cs-status-icon--staff { background: var(--me-coral-soft); color: var(--me-coral); }
  .cs-status strong { display: block; font-family: var(--me-font-display); font-weight: 800; font-size: 1.12rem; color: var(--me-ink); }
  .cs-status span { font-size: .88rem; color: var(--me-muted); }
  .cs-price { font-family: var(--me-font-display); font-weight: 900; font-size: 2.2rem; color: var(--me-blue-dark); line-height: 1.1; }
  .cs-access {
    display: flex; align-items: center; gap: 8px; margin-top: 14px; font-size: .84rem; font-weight: 600;
    padding: 8px 12px; border-radius: 12px; background: var(--me-blue-soft); color: var(--me-blue-dark);
  }
  .cs-access--soon { background: #fff6e5; color: #9a5b00; }

  .cs-actions { display: flex; flex-direction: column; gap: 10px; margin: 22px 0 24px; }
  .cs-cta {
    display: flex; align-items: center; justify-content: center; gap: 9px; width: 100%;
    padding: 14px 18px; border-radius: 14px; border: 2px solid transparent; font-weight: 700; font-size: 1rem;
    text-decoration: none; transition: background .2s, color .2s, transform .2s, box-shadow .2s;
  }
  .cs-cta:hover { transform: translateY(-2px); }
  .cs-cta:focus-visible { outline: 3px solid rgba(54,79,171,.35); outline-offset: 3px; }
  .cs-cta--coral { background: var(--me-coral); color: #fff; box-shadow: 0 12px 24px -12px rgba(255,87,87,.75); }
  .cs-cta--coral:hover { background: var(--me-coral-dark); color: #fff; }
  .cs-cta--blue { background: var(--me-blue); color: #fff; }
  .cs-cta--blue:hover { background: var(--me-blue-dark); color: #fff; }
  .cs-cta--outline { background: #fff; color: var(--me-blue); border-color: var(--me-blue); }
  .cs-cta--outline:hover { background: var(--me-blue); color: #fff; }
  .cs-cta--off { background: var(--me-line); color: var(--me-muted); pointer-events: none; }

  .cs-includes-title { font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--me-muted); margin-bottom: 8px; }
  .cs-includes { list-style: none; padding: 0; margin: 0; }
  .cs-includes li { display: flex; align-items: center; gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--me-line); color: #3b4160; font-size: .94rem; }
  .cs-includes li:last-child { border-bottom: none; }
  .cs-includes i { color: var(--me-blue); width: 20px; text-align: center; }

  .cs-prog-link {
    display: flex; align-items: center; gap: 12px; margin-top: 16px; padding: 16px 18px; border-radius: var(--me-radius);
    background: #fff; border: 1px solid var(--me-line); color: var(--me-ink); text-decoration: none; transition: border-color .2s;
  }
  .cs-prog-link:hover { border-color: var(--me-coral); color: var(--me-ink); }
  .cs-prog-link i:first-child { width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: var(--me-coral-soft); color: var(--me-coral); flex-shrink: 0; }
  .cs-prog-link small { display: block; font-size: .76rem; color: var(--me-muted); }
  .cs-prog-link strong { font-size: .95rem; }
  .cs-prog-link .bi-arrow-right { margin-left: auto; color: var(--me-coral); }

  @media (max-width: 992px) {
    .cs-grid { grid-template-columns: 1fr; }
    .cs-aside { order: -1; }
    .cs-side { position: static; }
  }
  @media (max-width: 576px) {
    .cs-hero { padding: 96px 0 104px; }
    .cs-logo { height: 38px; }
    .cs-card, .cs-panel-body { padding: 22px 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cs-module, .cs-cta, .cs-module-go { transition: none; }
    .cs-module:hover, .cs-cta:hover { transform: none; }
  }
</style>

<div class="cs-page me-page">

  <section class="cs-hero">
    <% if (heroImg) { %>
      <div class="cs-hero-bg"><img src="<%= heroImg %>" alt="" decoding="async"></div>
    <% } else if (prog && prog.photo) { %>
      <div class="cs-hero-bg"><%- include('../../../partials/me-photo', { name: prog.photo, alt: '', pos: prog.photoPos, eager: true }) %></div>
    <% } %>
    <div class="container">
      <nav class="cs-crumbs" aria-label="Fil d'Ariane">
        <a href="/maelenglish/cours/my-courses"><i class="bi bi-arrow-left" style="color:inherit;font-size:.85rem"></i> Mes cours</a>
        <% if (prog) { %><i class="bi bi-chevron-right"></i><a href="/maelenglish/cours/programme/<%= prog.slug %>"><%= prog.name %></a><% } %>
      </nav>
      <picture>
        <source srcset="/assets/img/Maelenglish/maelenglish-logo-light.webp" type="image/webp">
        <img src="/assets/img/Maelenglish/maelenglish-logo-light.png" alt="MaelEnglish" class="cs-logo" width="149" height="48">
      </picture>
      <% if (course.isChallenge) { %>
        <div class="cs-chip cs-chip--coral"><i class="bi bi-lightning-charge-fill"></i> MaelEnglish Challenge</div>
      <% } else { %>
        <div class="cs-chip"><i class="bi bi-<%= prog ? prog.icon : 'award-fill' %>"></i> <%= prog ? prog.name : 'MaelEnglish' %></div>
      <% } %>
      <h1><%= course.title %></h1>
      <p class="cs-hero-lead">
        <%= prog && prog.tagline ? prog.tagline + '. ' : '' %>Speak the Language of Your Profession — avancez module par module, à votre rythme.
      </p>
      <div class="cs-facts">
        <span class="cs-fact"><i class="bi bi-collection-play-fill"></i> <%= modules.length %> module<%= modules.length > 1 ? 's' : '' %></span>
        <% if (instructors.length) { %><span class="cs-fact"><i class="bi bi-person-video3"></i> <%= instructors.length %> coach<%= instructors.length > 1 ? 's' : '' %></span><% } %>
        <% if (prog && prog.hours) { %><span class="cs-fact"><i class="bi bi-hourglass-split"></i> <%= prog.hours %></span><% } %>
        <span class="cs-fact"><i class="bi bi-wifi"></i> 100 % en ligne</span>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="cs-grid">

      <div class="cs-main">
        <% if (course.description) { %>
          <section class="cs-card">
            <div class="cs-card-head"><i class="bi bi-file-text"></i><h2>Ce que vous apprendrez</h2></div>
            <div class="cs-rich"><%- course.description %></div>
          </section>
        <% } %>

        <% if (course.willLearn) { %>
          <section class="cs-card">
            <div class="cs-card-head"><i class="bi bi-bullseye"></i><h2>Objectifs du cours</h2></div>
            <div class="cs-rich"><%- course.willLearn %></div>
          </section>
        <% } %>

        <% if (course.requirements) { %>
          <section class="cs-card">
            <div class="cs-card-head"><i class="bi bi-check2-square"></i><h2>Prérequis</h2></div>
            <div class="cs-rich"><%- course.requirements %></div>
          </section>
        <% } %>

        <% if (modules.length) { %>
          <section class="cs-card" id="modules">
            <div class="cs-card-head">
              <i class="bi bi-collection-play"></i><h2>Programme du cours</h2>
              <span class="cs-count"><%= modules.length %> module<%= modules.length > 1 ? 's' : '' %></span>
            </div>
            <div class="cs-modules">
              <% modules.forEach((module, index) => { const sum = plain(module.willLearnModule); %>
                <a href="/maelenglish/cours/<%= course._id %>/modules/<%= module._id %>/overview" class="cs-module">
                  <span class="cs-module-num"><%= index + 1 %></span>
                  <div class="cs-module-info">
                    <h3><%= module.title %></h3>
                    <% if (sum) { %><p><%= sum %></p><% } %>
                  </div>
                  <i class="bi bi-arrow-right-circle-fill cs-module-go" aria-hidden="true"></i>
                </a>
              <% }) %>
            </div>
          </section>
        <% } %>

        <% if (instructors.length) { %>
          <section class="cs-card">
            <div class="cs-card-head"><i class="bi bi-person-video3"></i><h2>Vos coachs</h2></div>
            <div class="cs-coaches">
              <% instructors.forEach((instructor) => { %>
                <div class="cs-coach">
                  <% if (instructor.imageUrl) { %>
                    <img src="<%= instructor.imageUrl %>" alt="" loading="lazy">
                  <% } else { %>
                    <span class="cs-coach-ph"><%= ((instructor.name || '?')[0] || '?').toUpperCase() %></span>
                  <% } %>
                  <div>
                    <h3><%= instructor.surname %> <%= instructor.name %></h3>
                    <p>Coach MaelEnglish</p>
                  </div>
                </div>
              <% }) %>
            </div>
          </section>
        <% } %>
      </div>

      <aside class="cs-aside">
        <div class="cs-side">
          <div class="cs-panel">
            <div class="cs-panel-bar"></div>
            <div class="cs-panel-body">
              <% if (enrolled) { %>
                <div class="cs-status">
                  <span class="cs-status-icon cs-status-icon--ok"><i class="bi bi-patch-check-fill"></i></span>
                  <div><strong>Vous êtes inscrit(e)</strong><span>Bon retour ! Prêt(e) à continuer ?</span></div>
                </div>
                <% if (accessEndLabel && daysLeft !== null && daysLeft >= 0) { %>
                  <div class="cs-access <%= daysLeft <= 14 ? 'cs-access--soon' : '' %>"><i class="bi bi-clock-history"></i> Accès jusqu'au <%= accessEndLabel %> · <%= daysLeft %> j</div>
                <% } %>
              <% } else if (staff) { %>
                <div class="cs-status">
                  <span class="cs-status-icon cs-status-icon--staff"><i class="bi bi-eye-fill"></i></span>
                  <div><strong>Aperçu équipe</strong><span>Vous voyez ce cours comme un apprenant.</span></div>
                </div>
              <% } else { %>
                <div class="cs-price"><%= course.price ? course.price + ' FCFA' : 'Gratuit' %></div>
              <% } %>

              <div class="cs-actions">
                <% if (course.isChallenge) { %>
                  <a href="/maelenglish/cours/<%= course._id %>/challenge" class="cs-cta cs-cta--coral"><i class="bi bi-lightning-charge-fill"></i> Reprendre le défi</a>
                <% } else if (firstModule) { %>
                  <a href="/maelenglish/cours/<%= course._id %>/modules/<%= firstModule._id %>/overview" class="cs-cta cs-cta--coral">
                    <%= enrolled ? "Continuer l'apprentissage" : 'Commencer maintenant' %> <i class="bi bi-arrow-right-circle-fill"></i>
                  </a>
                <% } else { %>
                  <span class="cs-cta cs-cta--off"><i class="bi bi-hourglass-split"></i> Bientôt disponible</span>
                <% } %>
                <% if (enrolled || staff) { %>
                  <% if (hasExam) { %>
                    <a href="/maelenglish/cours/<%= course._id %>/final-exam" class="cs-cta cs-cta--blue"><i class="bi bi-clipboard-check-fill"></i> Examen final</a>
                  <% } %>
                  <% if (hasProject) { %>
                    <a href="/maelenglish/cours/<%= course._id %>/final-project" class="cs-cta cs-cta--outline"><i class="bi bi-journal-check"></i> Projet final</a>
                  <% } %>
                <% } %>
              </div>

              <p class="cs-includes-title">Ce cours inclut</p>
              <ul class="cs-includes">
                <li><i class="bi bi-film"></i> Accès illimité aux vidéos</li>
                <li><i class="bi bi-phone"></i> Sur mobile, tablette et ordinateur</li>
                <% if (typeof start !== 'undefined' && start) { %><li><i class="bi bi-calendar-event"></i> Début : <%= start %></li><% } %>
                <% if (typeof end !== 'undefined' && end) { %><li><i class="bi bi-calendar-check"></i> Fin : <%= end %></li><% } %>
                <li><i class="bi bi-award"></i> Certificat de fin de formation</li>
              </ul>
            </div>
          </div>

          <% if (prog) { %>
            <a href="/maelenglish/cours/programme/<%= prog.slug %>" class="cs-prog-link">
              <i class="bi bi-<%= prog.icon %>"></i>
              <span><small>Programme</small><strong><%= prog.name %></strong></span>
              <i class="bi bi-arrow-right"></i>
            </a>
          <% } %>
        </div>
      </aside>

    </div>
  </div>
</div>
