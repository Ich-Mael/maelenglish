<% layout('layouts/main') %>

<style>
  .chl-wrap { margin-top: 80px; padding: 2.5rem 0 5rem; background: #f7f5fc; min-height: calc(100vh - 200px); }
  .chl-head {
    background: linear-gradient(135deg, #2d0370 0%, #5d06ba 60%, #7d1fd6 100%);
    color: #fff; border-radius: 22px; padding: 2.2rem 2rem; margin-bottom: 2rem;
    box-shadow: 0 14px 40px rgba(93, 6, 186, .25);
  }
  .chl-pill { display: inline-flex; align-items: center; gap: .4rem; font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; background: rgba(255,255,255,.16); padding: .35rem .8rem; border-radius: 999px; margin-bottom: .8rem; }
  .chl-head h1 { margin: 0 0 .3rem; font-size: 1.8rem; font-weight: 800; }
  .chl-head .chl-theme { opacity: .9; font-size: 1.02rem; margin: 0 0 1.2rem; }
  .chl-metrics { display: flex; gap: 1.6rem; flex-wrap: wrap; }
  .chl-metric .n { font-size: 1.5rem; font-weight: 800; display: block; line-height: 1.1; }
  .chl-metric .l { font-size: .78rem; opacity: .82; text-transform: uppercase; letter-spacing: .04em; }
  .chl-progress { margin-top: 1.2rem; height: 8px; border-radius: 999px; background: rgba(255,255,255,.2); overflow: hidden; }
  .chl-progress span { display: block; height: 100%; background: linear-gradient(90deg, #ffd24a, #ffb800); border-radius: 999px; }

  .chl-days { display: flex; flex-direction: column; gap: .9rem; max-width: 820px; }
  .chl-day {
    display: flex; align-items: center; gap: 1.1rem; background: #fff; border: 1px solid #ece7f6;
    border-radius: 16px; padding: 1.1rem 1.3rem; transition: box-shadow .2s, transform .2s;
  }
  .chl-day.is-current { border-color: #c9a8ff; box-shadow: 0 10px 26px rgba(93,6,186,.12); }
  .chl-day.is-locked { opacity: .72; }
  .chl-num {
    flex-shrink: 0; width: 46px; height: 46px; border-radius: 12px; display: flex; align-items: center;
    justify-content: center; font-weight: 800; font-size: 1.05rem; background: #f1ecfb; color: #5d06ba;
  }
  .chl-day.is-done .chl-num { background: #e4f6ec; color: #1e7e34; }
  .chl-day.is-locked .chl-num { background: #eef0f4; color: #9aa1ad; }
  .chl-info { flex: 1; min-width: 0; }
  .chl-info .d { font-size: .74rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: #9b8bbd; }
  .chl-info .t { font-weight: 700; color: #2d0370; margin: .1rem 0 0; }
  .chl-chip { font-size: .72rem; font-weight: 700; padding: .28rem .7rem; border-radius: 999px; white-space: nowrap; }
  .chip-done { background: #d4edda; color: #155724; }
  .chip-current { background: #ede0ff; color: #5d06ba; }
  .chip-pending { background: #fff3cd; color: #9a6700; }
  .chip-redo { background: #f8d7da; color: #a71d2a; }
  .chip-locked { background: #eef0f4; color: #7a8290; }
  .chl-cta { flex-shrink: 0; }
  .chl-btn { display: inline-flex; align-items: center; gap: .4rem; padding: .55rem 1.1rem; border-radius: 999px; font-weight: 700; font-size: .88rem; text-decoration: none; background: linear-gradient(135deg,#5d06ba,#2d0370); color: #fff; transition: transform .2s; }
  .chl-btn:hover { transform: translateY(-2px); color: #fff; }
  .chl-btn.ghost { background: #f1ecfb; color: #5d06ba; }
  .chl-lock { color: #9aa1ad; font-size: 1.2rem; }
  .chl-back { display: inline-flex; align-items: center; gap: .4rem; color: #5d06ba; text-decoration: none; font-weight: 600; margin-bottom: 1.2rem; }
  @media (max-width: 620px) {
    .chl-day { flex-wrap: wrap; }
    .chl-cta { width: 100%; }
    .chl-cta .chl-btn { width: 100%; justify-content: center; }
  }
</style>

<%
  const BASE = '/programs/language-learning/general-english-boost';
  const DAY_MS = 24 * 60 * 60 * 1000;
  const pct = state.totalDays ? Math.round((state.streak / state.totalDays) * 100) : 0;
  function unlockDate(day) {
    const d = new Date(new Date(state.start).getTime() + (day - 1) * DAY_MS);
    return d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long' });
  }
  const CHIP = {
    done:             ['chip-done', 'Terminé'],
    current:          ['chip-current', "Aujourd'hui"],
    pending_review:   ['chip-pending', 'En attente de correction'],
    redo:             ['chip-redo', 'À refaire'],
    locked_checkpoint:['chip-locked', 'Verrouillé'],
    locked_time:      ['chip-locked', 'Bientôt'],
    unlocked:         ['chip-current', 'Ouvert'],
  };
%>

<div class="chl-wrap">
  <div class="container">
    <a href="<%= BASE %>/my-courses" class="chl-back"><i class="bi bi-arrow-left"></i> Mes cours</a>

    <div class="chl-head">
      <span class="chl-pill"><i class="bi bi-lightning-charge-fill"></i> English Challenge</span>
      <h1><%= course.title %></h1>
      <% if (course.challenge && course.challenge.themeLabel) { %>
        <p class="chl-theme"><%= course.challenge.themeLabel %></p>
      <% } %>
      <div class="chl-metrics">
        <div class="chl-metric"><span class="n">Jour <%= state.currentDay %>/<%= state.totalDays %></span><span class="l">Progression</span></div>
        <div class="chl-metric"><span class="n"><%= state.streak %> 🔥</span><span class="l">Série (jours validés)</span></div>
        <div class="chl-metric"><span class="n"><%= pct %>%</span><span class="l">Complété</span></div>
      </div>
      <div class="chl-progress"><span style="width: <%= pct %>%;"></span></div>
    </div>

    <div class="chl-days">
      <% state.days.forEach(function(d) {
           const isDone = d.state === 'done';
           const isCurrent = ['current','pending_review','redo','unlocked'].includes(d.state);
           const isLocked = ['locked_checkpoint','locked_time'].includes(d.state);
           const chip = CHIP[d.state] || CHIP.locked_checkpoint;
           const cls = isDone ? 'is-done' : (isCurrent ? 'is-current' : 'is-locked');
           const overviewUrl = BASE + '/' + course._id + '/modules/' + d.moduleId + '/overview';
      %>
        <div class="chl-day <%= cls %>">
          <div class="chl-num"><%= isDone ? '✓' : d.day %></div>
          <div class="chl-info">
            <div class="d">Jour <%= d.day %></div>
            <p class="t"><%= d.title %></p>
          </div>
          <span class="chl-chip <%= chip[0] %>"><%= chip[1] %></span>
          <div class="chl-cta">
            <% if (d.state === 'done') { %>
              <a class="chl-btn ghost" href="<%= overviewUrl %>">Revoir</a>
            <% } else if (d.state === 'redo') { %>
              <a class="chl-btn" href="<%= overviewUrl %>">Corriger &amp; renvoyer</a>
            <% } else if (d.state === 'pending_review') { %>
              <a class="chl-btn ghost" href="<%= overviewUrl %>">Voir</a>
            <% } else if (d.accessible) { %>
              <a class="chl-btn" href="<%= overviewUrl %>"><%= d.state === 'current' ? 'Continuer' : 'Ouvrir' %> <i class="bi bi-arrow-right"></i></a>
            <% } else if (d.state === 'locked_time') { %>
              <span class="chl-lock" title="Ouvre le <%= unlockDate(d.day) %>"><i class="bi bi-clock-history"></i> <span style="font-size:.8rem;color:#9aa1ad;">Ouvre le <%= unlockDate(d.day) %></span></span>
            <% } else { %>
              <span class="chl-lock" title="Validez le jour précédent"><i class="bi bi-lock-fill"></i></span>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</div>
