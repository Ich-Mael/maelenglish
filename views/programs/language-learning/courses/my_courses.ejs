<% layout('layouts/main') %>

<style>
  :root {
    --primary-color: #e0aaff;
    --primary-light: rgba(224, 170, 255, 0.1);
    --text-light: #ffffff;
    --text-muted: rgba(255, 255, 255, 0.7);
    --card-bg: rgba(255, 255, 255, 0.05);
    --radius-lg: 24px;
    font-family: 'Outfit', sans-serif;
  }
  
  body {
    background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
    min-height: 100vh;
    color: var(--text-light);
  }

  /* 1. Learning Hub Header */
  .learning-hub-header {
    position: relative;
    padding: 120px 0 60px;
    color: white;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(10px);
  }

  /* Animated background shapes */
  .learning-hub-header::before,
  .learning-hub-header::after {
    content: '';
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    filter: blur(80px);
    z-index: 0;
  }
  
  .learning-hub-header::before {
    background: rgba(93, 6, 186, 0.3);
    top: 0;
    left: 10%;
    animation: float 10s infinite ease-in-out;
  }
  
  .learning-hub-header::after {
    background: rgba(0, 210, 211, 0.15);
    bottom: 0;
    right: 10%;
    animation: float 12s infinite ease-in-out reverse;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(30px, -30px); }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .header-content {
    position: relative;
    z-index: 2;
  }

  .welcome-badge {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 8px 20px;
    border-radius: 50px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    margin-bottom: 24px;
    color: #e0aaff;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }

  .hub-title {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 16px;
    color: white;
    text-shadow: 0 2px 10px rgba(0,0,0,0.3);
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
    opacity: 0;
  }

  .hub-subtitle {
    font-size: 1.2rem;
    opacity: 0;
    max-width: 600px;
    color: var(--text-muted);
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
  }

  /* 2. Course Grid */
  .courses-container {
    padding-bottom: 80px;
    position: relative;
    z-index: 3;
    margin-top: 40px;
  }

  .course-card {
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    height: 100%;
    display: flex;
    flex-direction: column;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }

  .course-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 30px 60px rgba(0,0,0,0.5);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
  }

  /* Card Image */
  .card-img-wrapper {
    height: 200px;
    position: relative;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .course-card:hover .card-img {
    transform: scale(1.05);
  }

  .img-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.8) 100%);
  }
  
  /* Fallback gradient if no image */
  .card-img-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, #1cb5e0, #000046);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 3rem;
  }

  /* Batches/Tags on Image */
  .card-badges {
    position: absolute;
    top: 16px;
    left: 16px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    z-index: 2;
  }

  .badge-pill {
    padding: 6px 14px;
    border-radius: 30px;
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(0, 0, 0, 0.6);
    color: white;
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255,255,255,0.1);
  }
  
  .badge-pill.private {
    background: rgba(93, 6, 186, 0.8);
    color: white;
  }

  /* Card Content */
  .card-body {
    padding: 28px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    color: white;
  }

  .course-category {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #e0aaff;
    font-weight: 800;
    margin-bottom: 8px;
    display: block;
  }

  .course-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: white !important;
    margin-bottom: 24px;
    line-height: 1.3;
    background: none !important;
    -webkit-text-fill-color: initial !important;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
  }

  /* Course Stats/Meta */
  .course-meta {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 24px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }
  
  .meta-item i {
    color: #e0aaff;
    font-size: 1.1rem;
  }

  /* Action Button */
  .btn-continue {
    background: white;
    color: #0f0c29;
    border-radius: 14px;
    padding: 14px;
    width: 100%;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: auto;
    border: none;
  }

  .btn-continue:hover {
    background: #e0aaff;
    color: #0f0c29;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(224, 170, 255, 0.2);
  }

  .btn-continue i {
    font-size: 1.1rem;
  }

  /* Expired Button Style */
  .btn-expired {
    background: rgba(255, 99, 71, 0.1) !important;
    border: 1px solid rgba(255, 99, 71, 0.3) !important;
    color: #ff8a80 !important;
    backdrop-filter: blur(4px);
  }

  .btn-expired:hover {
    background: rgba(255, 99, 71, 0.2) !important;
    border-color: rgba(255, 99, 71, 0.5) !important;
    box-shadow: 0 10px 20px rgba(255, 99, 71, 0.15) !important;
    transform: translateY(-2px);
    color: white !important;
  }

  /* Empty State */
  .empty-hub {
    text-align: center;
    padding: 6rem 2rem;
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 50px rgba(0,0,0,0.3);
    margin-top: 40px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    opacity: 0;
  }

  @media(max-width: 768px) {
    .hub-title { font-size: 2.5rem; }
    .learning-hub-header { padding: 80px 0 40px; }
  }
</style>

<!-- 1. Learning Hub Header -->
<div class="learning-hub-header">
  <div class="header-pattern"></div>
  <div class="container header-content">
    <div class="row justify-content-center">
      <div class="col-lg-8 text-center">
        <div class="welcome-badge mx-auto">
          <i class="bi bi-stars"></i> Espace Apprenant
        </div>
        <h1 class="hub-title">Mes Cours d'Anglais</h1>
        <p class="hub-subtitle mx-auto">
          Chaque leçon vous rapproche de la fluidité. Continuez votre voyage linguistique et ouvrez-vous au monde !
        </p>
      </div>
    </div>
  </div>
</div>

<!-- 2. Course Grid -->
<div class="courses-container container">
  <% if (typeof courses !== 'undefined' && courses.length > 0) { %>
    <div class="row g-4 justify-content-center">
      <% courses.forEach((course, index) => { %>
        <div class="col-lg-4 col-md-6 d-flex">
          <div class="course-card w-100" style="animation-delay: <%= index * 0.1 + 0.3 %>s;">
            <!-- Visual Header -->
            <div class="card-img-wrapper">
              <% if (course.courseImageUrl) { %>
                <img src="<%= course.courseImageUrl %>" alt="<%= course.title %>" class="card-img">
                <div class="img-overlay"></div>
              <% } else { %>
                <div class="card-img-placeholder">
                  <i class="bi bi-journal-album"></i>
                </div>
              <% } %>
              
              <!-- Badges -->
              <div class="card-badges">
                <% if (course.isPrivate) { %>
                  <span class="badge-pill private"><i class="bi bi-lock-fill me-1"></i> Program Spécial</span>
                <% } else { %>
                  <span class="badge-pill"><i class="bi bi-globe me-1"></i> Public</span>
                <% } %>
                
                <% if (course.typeOfCourse) { %>
                   <span class="badge-pill"><%= course.typeOfCourse.replace('-', ' ') %></span>
                <% } %>
              </div>
            </div>

            <!-- Content -->
            <div class="card-body">
              <div>
                <span class="course-category"><%= course.category || 'Education' %></span>
                <h3 class="course-title"><%= course.title %></h3>
                
                <!-- Description Logic: Use Syllabus Summary or Description -->
                <!-- Description Removed as per user request -->
              </div>

              <!-- Meta Info -->
              <div class="course-meta" style="flex-wrap: wrap; gap: 15px;">
                <div class="meta-item">
                  <i class="bi bi-person-video3"></i>
                  <span><%= course.instructors ? course.instructors.length : 0 %> Coachs</span>
                </div>
                <div class="meta-item">
                   <i class="bi bi-layers"></i>
                   <span><%= course.modules ? course.modules.length : 0 %> Modules</span>
                </div>
                <!-- Expiration Logic -->
                <% 
                   let expirationDate = null;
                   let isExpired = false;
                   let daysLeft = 0;
                   if (currentUser && currentUser.specialProgram) {
                       const enrollment = currentUser.specialProgram.find(p => p.courseTitle === course.title);
                       if (enrollment && enrollment.endDate) {
                           const end = new Date(enrollment.endDate);
                           expirationDate = end.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
                           isExpired = new Date() > end;
                           daysLeft = Math.ceil((end - new Date()) / (1000 * 60 * 60 * 24));
                       }
                   }
                %>
                <% if(expirationDate) { %>
                    <div class="meta-item" style="width: 100%;">
                        <% if(isExpired) { %>
                             <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-20 rounded-pill px-3">
                                <i class="bi bi-exclamation-circle me-1"></i> Expiré le <%= expirationDate %>
                             </span>
                        <% } else { %>
                             <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-20 rounded-pill px-3">
                                <i class="bi bi-clock-history me-1"></i> Expire le <%= expirationDate %> (<%= daysLeft %> j)
                             </span>
                        <% } %>
                    </div>
                <% } %>
              </div>

              <!-- Action -->
              <% if(isExpired) { %>
                  <a href="/programs/language-learning/general-english-boost/enroll-contact" class="btn-continue btn-expired">
                    <i class="bi bi-envelope-fill"></i> Contactez l'administration
                  </a>
              <% } else if (course.isChallenge) { %>
                  <a href="/programs/language-learning/general-english-boost/<%= course._id %>/challenge" class="btn-continue">
                    <i class="bi bi-lightning-charge-fill"></i> Reprendre le défi
                  </a>
              <% } else { %>
                  <a href="/programs/language-learning/general-english-boost/<%= course._id %>" class="btn-continue">
                    <i class="bi bi-play-circle-fill"></i> Continuer
                  </a>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <!-- Empty State -->
    <div class="empty-hub">
      <i class="bi bi-journal-bookmark-fill" style="font-size: 4rem; color: #e2e8f0; margin-bottom: 20px; display: block;"></i>
      <h3 style="font-weight: 700; color: #1e293b;">Aucun cours actif</h3>
      <p style="color: #64748b; margin-bottom: 30px; max-width: 400px; margin-left: auto; margin-right: auto;">
        Il semble que vous ne soyez inscrit à aucun cours pour le moment. Explorez nos programmes pour commencer.
      </p>
      <a href="/programs/language-learning/general-english-boost" class="btn" style="background: #5d06ba; color: white; border-radius: 50px; padding: 12px 30px; font-weight: 600;">
        Découvrir les programmes
      </a>
    </div>
  <% } %>
</div>
