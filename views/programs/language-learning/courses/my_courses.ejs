<% layout('layouts/main') %>

<style>
  :root {
    --primary-color: #5d06ba;
    --primary-light: #f3e5f5;
    --primary-dark: #2d0370;
    --card-bg: #ffffff;
    --radius-lg: 20px;
    --radius-xl: 32px;
    font-family: 'Outfit', sans-serif;
  }
  
  body {
    background-color: #f8f9fa;
  }

  /* 1. Learning Hub Header */
  .learning-hub-header {
    background: linear-gradient(135deg, #130f40 0%, #2d0370 100%);
    position: relative;
    padding: 120px 0 80px;
    color: white;
    overflow: hidden;
    margin-bottom: -40px; /* Overlap effect */
  }

  .header-pattern {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: radial-gradient(circle at 20% 50%, rgba(93, 6, 186, 0.4) 0%, transparent 50%),
                      radial-gradient(circle at 80% 80%, rgba(0, 210, 211, 0.2) 0%, transparent 50%);
    opacity: 0.8;
  }

  .header-content {
    position: relative;
    z-index: 2;
  }

  .welcome-badge {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 8px 20px;
    border-radius: 50px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    margin-bottom: 24px;
    color: #e0aaff;
  }

  .hub-title {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 16px;
    background: linear-gradient(to right, #ffffff, #dcdde1);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hub-subtitle {
    font-size: 1.2rem;
    opacity: 0.8;
    max-width: 600px;
  }

  /* 2. Course Grid */
  .courses-container {
    padding-bottom: 80px;
    position: relative;
    z-index: 3;
  }

  .course-card {
    background: white;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(0,0,0,0.06);
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    height: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(0,0,0,0.03);
  }

  .course-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 25px 50px rgba(93, 6, 186, 0.15);
  }

  /* Card Image */
  .card-img-wrapper {
    height: 200px;
    position: relative;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .course-card:hover .card-img {
    transform: scale(1.05);
  }

  .img-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.6) 100%);
  }
  
  /* Fallback gradient if no image */
  .card-img-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, #5d06ba, #8e44ad);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 3rem;
  }

  /* Batches/Tags on Image */
  .card-badges {
    position: absolute;
    top: 16px;
    left: 16px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .badge-pill {
    padding: 6px 14px;
    border-radius: 30px;
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(255,255,255,0.95);
    color: #2d0370;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    backdrop-filter: blur(4px);
  }
  
  .badge-pill.private {
    background: #2d0370;
    color: white;
  }

  /* Card Content */
  .card-body {
    padding: 28px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .course-category {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--primary-color);
    font-weight: 800;
    margin-bottom: 8px;
    display: block;
  }

  .course-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #1a0b2e;
    margin-bottom: 12px;
    line-height: 1.3;
  }

  .course-desc {
    color: #6e6e73;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 24px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }

  /* Course Stats/Meta */
  .course-meta {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 24px;
    padding-top: 16px;
    border-top: 1px solid #f0f0f0;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: #6e6e73;
    font-weight: 500;
  }
  
  .meta-item i {
    color: var(--primary-color);
    font-size: 1rem;
  }

  /* Action Button */
  .btn-continue {
    background: var(--text-dark, #1d1d1f);
    color: white;
    border-radius: 14px;
    padding: 14px;
    width: 100%;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: auto;
  }

  .btn-continue:hover {
    background: var(--primary-color);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(93, 6, 186, 0.2);
  }

  .btn-continue i {
    font-size: 1.1rem;
  }

  /* Empty State */
  .empty-hub {
    text-align: center;
    padding: 6rem 2rem;
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 40px rgba(0,0,0,0.05);
    margin-top: 40px;
  }

  @media(max-width: 768px) {
    .hub-title { font-size: 2.5rem; }
    .learning-hub-header { padding: 80px 0 60px; }
  }
</style>

<!-- 1. Learning Hub Header -->
<div class="learning-hub-header">
  <div class="header-pattern"></div>
  <div class="container header-content">
    <div class="row">
      <div class="col-lg-8">
        <div class="welcome-badge">
          <i class="bi bi-stars"></i> Espace Apprenant
        </div>
        <h1 class="hub-title">Mes Cours</h1>
        <p class="hub-subtitle">
          Retrouvez tous vos programmes actifs, suivez votre progression et continuez d'apprendre là où vous vous étiez arrêté.
        </p>
      </div>
    </div>
  </div>
</div>

<!-- 2. Course Grid -->
<div class="courses-container container">
  <% if (typeof courses !== 'undefined' && courses.length > 0) { %>
    <div class="row g-4 justify-content-center">
      <% courses.forEach(course => { %>
        <div class="col-lg-4 col-md-6 d-flex">
          <div class="course-card w-100">
            <!-- Visual Header -->
            <div class="card-img-wrapper">
              <% if (course.courseImageUrl) { %>
                <img src="<%= course.courseImageUrl %>" alt="<%= course.title %>" class="card-img">
                <div class="img-overlay"></div>
              <% } else { %>
                <div class="card-img-placeholder">
                  <i class="bi bi-journal-album"></i>
                </div>
              <% } %>
              
              <!-- Badges -->
              <div class="card-badges">
                <% if (course.isPrivate) { %>
                  <span class="badge-pill private"><i class="bi bi-lock-fill me-1"></i> Privé</span>
                <% } else { %>
                  <span class="badge-pill"><i class="bi bi-globe me-1"></i> Public</span>
                <% } %>
                
                <% if (course.typeOfCourse) { %>
                   <span class="badge-pill"><%= course.typeOfCourse.replace('-', ' ') %></span>
                <% } %>
              </div>
            </div>

            <!-- Content -->
            <div class="card-body">
              <div>
                <span class="course-category"><%= course.category || 'Education' %></span>
                <h3 class="course-title"><%= course.title %></h3>
                
                <!-- Description Logic: Use Syllabus Summary or Description -->
                <p class="course-desc">
                  <%= course.syllabusSummary ? course.syllabusSummary : (course.description ? course.description.replace(/<[^>]*>?/gm, '').substring(0, 100) + '...' : 'Aucune description disponible pour ce cours.') %>
                </p>
              </div>

              <!-- Meta Info -->
              <div class="course-meta">
                <div class="meta-item">
                  <i class="bi bi-person-video3"></i>
                  <span><%= course.instructors ? course.instructors.length : 0 %> Coachs</span>
                </div>
                <div class="meta-item">
                   <i class="bi bi-layers"></i>
                   <span><%= course.modules ? course.modules.length : 0 %> Modules</span>
                </div>
              </div>

              <!-- Action -->
              <a href="/programs/language-learning/general-english-boost/<%= course._id %>" class="btn-continue">
                <i class="bi bi-play-circle-fill"></i> Continuer
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <!-- Empty State -->
    <div class="empty-hub">
      <i class="bi bi-journal-bookmark-fill" style="font-size: 4rem; color: #e2e8f0; margin-bottom: 20px; display: block;"></i>
      <h3 style="font-weight: 700; color: #1e293b;">Aucun cours actif</h3>
      <p style="color: #64748b; margin-bottom: 30px; max-width: 400px; margin-left: auto; margin-right: auto;">
        Il semble que vous ne soyez inscrit à aucun cours pour le moment. Explorez nos programmes pour commencer.
      </p>
      <a href="/programs/language-learning/general-english-boost" class="btn" style="background: #5d06ba; color: white; border-radius: 50px; padding: 12px 30px; font-weight: 600;">
        Découvrir les programmes
      </a>
    </div>
  <% } %>
</div>
