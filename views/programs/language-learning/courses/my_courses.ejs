<% layout('layouts/main') %>
<%# MaelEnglish — learner's « Mes cours » (GET /maelenglish/cours/my-courses, coursesController.myCourses).
    Brand tokens (--me-coral / --me-blue …) come from /assets/css/maelenglish.css; page styles are scoped .mc-*. %>
<% headContent = `
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800;900&display=swap" rel="stylesheet">
  <link href="/assets/css/maelenglish.css" rel="stylesheet">
` %>
<%
  const typeLabels = { 'Special-program': 'Programme spécial', 'Distance-learning': 'À distance', 'Self-paced': 'À votre rythme' };
  const progs = typeof programs !== 'undefined' ? programs : {};
  const list = typeof courses !== 'undefined' ? courses : [];
  const firstName = currentUser && currentUser.name ? currentUser.name : '';
%>

<style>
  .mc-page { background: var(--me-bg); min-height: 100vh; padding-bottom: 88px; }

  /* Hero */
  .mc-hero {
    position: relative; overflow: hidden; color: #fff;
    background: linear-gradient(135deg, var(--me-blue-deep) 0%, var(--me-blue-dark) 55%, var(--me-blue) 100%);
    padding: 120px 0 112px;
  }
  .mc-hero::before, .mc-hero::after {
    content: ''; position: absolute; border-radius: 50%; pointer-events: none;
  }
  .mc-hero::before { width: 420px; height: 420px; right: -120px; top: -140px; background: radial-gradient(circle, rgba(255,87,87,.38), transparent 70%); }
  .mc-hero::after  { width: 360px; height: 360px; left: -140px; bottom: -180px; background: radial-gradient(circle, rgba(255,255,255,.12), transparent 70%); }
  .mc-hero .container { position: relative; z-index: 1; }
  .mc-hero-logo { height: 56px; width: auto; display: block; margin-bottom: 28px; }
  .mc-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    color: #fff; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2);
    padding: 6px 14px; border-radius: 50px; margin-bottom: 18px;
  }
  .mc-eyebrow i { color: var(--me-coral); }
  .mc-hero h1 {
    font-family: var(--me-font-display); font-weight: 900; color: #fff !important;
    font-size: clamp(2.1rem, 5vw, 3.4rem); line-height: 1.08; letter-spacing: -.015em; margin-bottom: 14px;
  }
  .mc-hero h1 span { color: var(--me-coral); }
  .mc-hero p { color: rgba(255,255,255,.78); font-size: 1.1rem; max-width: 560px; margin: 0; }
  .mc-hero-stats { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .mc-stat {
    background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.16);
    border-radius: 14px; padding: 10px 16px; display: flex; align-items: baseline; gap: 8px;
  }
  .mc-stat strong { font-family: var(--me-font-display); font-size: 1.5rem; color: #fff; line-height: 1; }
  .mc-stat span { font-size: .85rem; color: rgba(255,255,255,.75); }

  /* Grid */
  .mc-grid-wrap { margin-top: -64px; position: relative; z-index: 2; }
  .mc-card {
    background: #fff; border: 1px solid var(--me-line); border-radius: var(--me-radius);
    box-shadow: var(--me-shadow); overflow: hidden; display: flex; flex-direction: column;
    width: 100%; transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }
  .mc-card:hover { transform: translateY(-6px); border-color: #c9d1ef; box-shadow: 0 26px 50px -20px rgba(31,47,115,.38); }

  .mc-media { position: relative; height: 180px; overflow: hidden; background: var(--me-blue-soft); }
  .mc-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
  .mc-card:hover .mc-media img { transform: scale(1.05); }
  .mc-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,31,77,0) 45%, rgba(20,31,77,.55) 100%); }
  .mc-media--plain {
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, var(--me-blue) 0%, var(--me-blue-dark) 100%);
  }
  .mc-media--plain::after { display: none; }
  .mc-media--plain i { font-size: 3.4rem; color: rgba(255,255,255,.9); }
  .mc-media--challenge { background: linear-gradient(135deg, var(--me-coral) 0%, #c93636 100%); }

  .mc-badges { position: absolute; top: 14px; left: 14px; right: 14px; display: flex; flex-wrap: wrap; gap: 6px; z-index: 1; }
  .mc-badge {
    font-size: .72rem; font-weight: 700; padding: 5px 11px; border-radius: 50px;
    background: rgba(255,255,255,.94); color: var(--me-blue-dark);
    display: inline-flex; align-items: center; gap: 5px;
  }
  .mc-badge--coral { background: var(--me-coral); color: #fff; }

  .mc-body { padding: 22px 24px 24px; display: flex; flex-direction: column; flex: 1; }
  .mc-program {
    align-self: flex-start; font-size: .74rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
    color: var(--me-coral); margin-bottom: 8px;
  }
  .mc-program a { color: inherit; }
  .mc-program a:hover { text-decoration: underline; }
  .mc-title {
    font-family: var(--me-font-display); font-weight: 800; font-size: 1.3rem; line-height: 1.25;
    color: var(--me-ink) !important; margin: 0 0 18px; background: none !important; -webkit-text-fill-color: initial !important;
  }
  .mc-meta { display: flex; flex-wrap: wrap; gap: 8px 18px; padding-top: 16px; border-top: 1px solid var(--me-line); margin-bottom: 16px; }
  .mc-meta-item { display: inline-flex; align-items: center; gap: 7px; font-size: .86rem; color: var(--me-muted); font-weight: 500; }
  .mc-meta-item i { color: var(--me-blue); font-size: 1rem; }

  .mc-expiry { display: inline-flex; align-items: center; gap: 6px; font-size: .8rem; font-weight: 600; padding: 6px 12px; border-radius: 50px; margin-bottom: 18px; align-self: flex-start; }
  .mc-expiry--ok   { background: var(--me-blue-soft); color: var(--me-blue-dark); }
  .mc-expiry--soon { background: #fff6e5; color: #9a5b00; }
  .mc-expiry--past { background: var(--me-coral-soft); color: var(--me-coral-dark); }

  .mc-cta {
    margin-top: auto; display: flex; align-items: center; justify-content: center; gap: 8px;
    width: 100%; padding: 13px 18px; border-radius: 14px; border: 2px solid transparent;
    font-weight: 700; font-size: .98rem; text-decoration: none; transition: background .2s, color .2s, transform .2s, box-shadow .2s;
  }
  .mc-cta:hover { transform: translateY(-2px); }
  .mc-cta:focus-visible { outline: 3px solid rgba(54,79,171,.35); outline-offset: 3px; }
  .mc-cta--coral { background: var(--me-coral); color: #fff; box-shadow: 0 10px 22px -10px rgba(255,87,87,.7); }
  .mc-cta--coral:hover { background: var(--me-coral-dark); color: #fff; }
  .mc-cta--blue { background: var(--me-blue); color: #fff; box-shadow: 0 10px 22px -10px rgba(54,79,171,.7); }
  .mc-cta--blue:hover { background: var(--me-blue-dark); color: #fff; }
  .mc-cta--outline { background: #fff; color: var(--me-coral-dark); border-color: var(--me-coral); }
  .mc-cta--outline:hover { background: var(--me-coral); color: #fff; }

  /* Empty state */
  .mc-empty {
    background: #fff; border: 1px solid var(--me-line); border-radius: var(--me-radius); box-shadow: var(--me-shadow);
    text-align: center; padding: 64px 24px; max-width: 640px; margin: 0 auto;
  }
  .mc-empty-icon {
    width: 76px; height: 76px; border-radius: 22px; margin: 0 auto 20px;
    display: flex; align-items: center; justify-content: center;
    background: var(--me-coral-soft); color: var(--me-coral); font-size: 2.1rem;
  }
  .mc-empty h2 { font-family: var(--me-font-display); font-weight: 800; font-size: 1.6rem; color: var(--me-ink); margin-bottom: 10px; }
  .mc-empty p { color: var(--me-muted); max-width: 420px; margin: 0 auto 26px; }
  .mc-empty .mc-cta { width: auto; display: inline-flex; padding: 13px 28px; }

  .mc-help { text-align: center; margin-top: 40px; color: var(--me-muted); font-size: .92rem; }
  .mc-help a { color: var(--me-blue); font-weight: 600; }
  .mc-help a:hover { color: var(--me-coral); }

  @media (max-width: 768px) {
    .mc-hero { padding: 96px 0 96px; }
    .mc-hero-logo { height: 38px; }
    .mc-body { padding: 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mc-card, .mc-media img, .mc-cta { transition: none; }
    .mc-card:hover, .mc-cta:hover { transform: none; }
    .mc-card:hover .mc-media img { transform: none; }
  }
</style>

<div class="mc-page me-page">

  <section class="mc-hero">
    <div class="container">
      <picture>
        <source srcset="/assets/img/Maelenglish/maelenglish-logo-light.webp" type="image/webp">
        <img src="/assets/img/Maelenglish/maelenglish-logo-light.png" alt="MaelEnglish" class="mc-hero-logo" width="143" height="46">
      </picture>
      <div class="mc-eyebrow"><i class="bi bi-stars"></i> Espace apprenant</div>
      <h1><%= firstName ? 'Bonjour ' + firstName + ',' : 'Mes cours' %><br><span>continuez votre progression.</span></h1>
      <p>Chaque leçon vous rapproche de l'aisance. Reprenez là où vous vous êtes arrêté(e).</p>
      <% if (list.length > 0) { %>
        <div class="mc-hero-stats">
          <div class="mc-stat"><strong><%= list.length %></strong><span>cours en cours</span></div>
        </div>
      <% } %>
    </div>
  </section>

  <div class="container mc-grid-wrap">
    <% if (list.length > 0) { %>
      <div class="row g-4">
        <% list.forEach((course) => {
             const prog = progs[String(course._id)] || null;
             let expirationDate = null, isExpired = false, daysLeft = 0;
             if (currentUser && currentUser.specialProgram) {
               const enrollment = currentUser.specialProgram.find(p => p.courseTitle === course.title);
               if (enrollment && enrollment.endDate) {
                 const end = new Date(enrollment.endDate);
                 expirationDate = end.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
                 isExpired = new Date() > end;
                 daysLeft = Math.ceil((end - new Date()) / (1000 * 60 * 60 * 24));
               }
             }
             const nCoachs = course.instructors ? course.instructors.length : 0;
             const nModules = course.modules ? course.modules.length : 0;
        %>
          <div class="col-lg-4 col-md-6 d-flex">
            <article class="mc-card">
              <% if (course.courseImageUrl) { %>
                <div class="mc-media">
                  <img src="<%= course.courseImageUrl %>" alt="" loading="lazy" decoding="async">
              <% } else if (prog && prog.photo) { %>
                <div class="mc-media">
                  <%- include('../../../partials/me-photo', { name: prog.photo, alt: '', sizes: '(min-width: 992px) 33vw, (min-width: 768px) 50vw, 100vw', pos: prog.photoPos }) %>
              <% } else { %>
                <div class="mc-media mc-media--plain <%= course.isChallenge ? 'mc-media--challenge' : '' %>">
                  <i class="bi bi-<%= course.isChallenge ? 'lightning-charge-fill' : (prog ? prog.icon : 'journal-bookmark-fill') %>"></i>
              <% } %>
                  <div class="mc-badges">
                    <% if (course.isChallenge) { %><span class="mc-badge mc-badge--coral"><i class="bi bi-lightning-charge-fill"></i> Challenge</span><% } %>
                    <% if (course.typeOfCourse && typeLabels[course.typeOfCourse]) { %><span class="mc-badge"><%= typeLabels[course.typeOfCourse] %></span><% } %>
                    <% if (course.isPrivate) { %><span class="mc-badge"><i class="bi bi-lock-fill"></i> Privé</span><% } %>
                  </div>
                </div>

              <div class="mc-body">
                <span class="mc-program">
                  <% if (prog) { %>
                    <a href="/maelenglish/cours/programme/<%= prog.slug %>"><%= prog.name %></a>
                  <% } else { %>
                    MaelEnglish
                  <% } %>
                </span>
                <h3 class="mc-title"><%= course.title %></h3>

                <div class="mc-meta">
                  <span class="mc-meta-item"><i class="bi bi-person-video3"></i> <%= nCoachs %> coach<%= nCoachs > 1 ? 's' : '' %></span>
                  <span class="mc-meta-item"><i class="bi bi-layers"></i> <%= nModules %> module<%= nModules > 1 ? 's' : '' %></span>
                </div>

                <% if (expirationDate) { %>
                  <% if (isExpired) { %>
                    <span class="mc-expiry mc-expiry--past"><i class="bi bi-exclamation-circle"></i> Accès expiré le <%= expirationDate %></span>
                  <% } else { %>
                    <span class="mc-expiry <%= daysLeft <= 14 ? 'mc-expiry--soon' : 'mc-expiry--ok' %>"><i class="bi bi-clock-history"></i> Accès jusqu'au <%= expirationDate %> · <%= daysLeft %> j</span>
                  <% } %>
                <% } %>

                <% if (isExpired) { %>
                  <a href="/maelenglish/cours/enroll-contact" class="mc-cta mc-cta--outline"><i class="bi bi-envelope-fill"></i> Contacter l'administration</a>
                <% } else if (course.isChallenge) { %>
                  <a href="/maelenglish/cours/<%= course._id %>/challenge" class="mc-cta mc-cta--coral"><i class="bi bi-lightning-charge-fill"></i> Reprendre le défi</a>
                <% } else { %>
                  <a href="/maelenglish/cours/<%= course._id %>" class="mc-cta mc-cta--blue"><i class="bi bi-play-circle-fill"></i> Continuer</a>
                <% } %>
              </div>
            </article>
          </div>
        <% }) %>
      </div>
      <p class="mc-help">Envie d'aller plus loin ? <a href="/maelenglish#programmes">Découvrir les autres programmes MaelEnglish</a></p>
    <% } else { %>
      <div class="mc-empty">
        <div class="mc-empty-icon"><i class="bi bi-journal-bookmark-fill"></i></div>
        <h2>Aucun cours actif</h2>
        <p>Vous n'êtes inscrit(e) à aucun cours pour le moment. Explorez nos programmes pour commencer.</p>
        <a href="/maelenglish#programmes" class="mc-cta mc-cta--coral"><i class="bi bi-compass"></i> Découvrir les programmes</a>
      </div>
    <% } %>
  </div>
</div>
