<% layout('layouts/englishLearningBoilerplate') %>

<% headContent = `
<style>
  .create-course-page {
    padding: 2rem 0 4rem;
    min-height: calc(100vh - 200px);
    background: linear-gradient(to bottom, #f8f9fa 0%, #ffffff 100%);
    margin-top: 80px !important;
  }

  /* Page Header */
  .page-header {
    background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
    color: white;
    padding: 2.5rem 2rem;
    border-radius: 20px;
    margin-bottom: 2rem;
    box-shadow: 0 10px 40px rgba(93, 6, 186, 0.3);
  }

  .page-header h1 {
    margin: 0 0 0.5rem 0;
    font-size: 2rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .page-header p {
    margin: 0;
    opacity: 0.95;
    font-size: 1rem;
    font-weight: 300;
  }

  /* Form Container */
  .form-container {
    background: white;
    border-radius: 20px;
    padding: 3rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    max-width: 1000px;
    margin: 0 auto;
  }

  /* Form Sections */
  .form-section {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid #f0f0f0;
  }

  .form-section:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .form-section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #2d0370;
    margin: 0 0 1.5rem 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 3px solid #5d06ba;
  }

  .form-section-title i {
    color: #5d06ba;
  }

  .form-section-description {
    color: #6e6e73;
    font-size: 0.95rem;
    margin: -1rem 0 1.5rem 0;
    font-style: italic;
  }

  /* Form Groups */
  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-label {
    font-weight: 600;
    color: #2d0370;
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .form-label i {
    color: #5d06ba;
    font-size: 1rem;
  }

  .form-label .required {
    color: #dc3545;
    margin-left: 0.25rem;
  }

  .form-control,
  .form-select {
    border-radius: 10px;
    border: 2px solid #d2d2d7;
    padding: 0.875rem 1rem;
    transition: all 0.3s ease;
    font-size: 0.95rem;
  }

  .form-control:focus,
  .form-select:focus {
    border-color: #5d06ba;
    box-shadow: 0 0 0 4px rgba(93, 6, 186, 0.1);
    outline: none;
  }

  .help-text {
    font-size: 0.85rem;
    color: #6e6e73;
    margin-top: 0.5rem;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .help-text i {
    color: #5d06ba;
    margin-top: 0.2rem;
  }

  /* Form Actions */
  .form-actions {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
    padding-top: 2rem;
    border-top: 2px solid #f0f0f0;
    margin-top: 2rem;
  }

  .btn-form {
    padding: 0.875rem 2rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    transition: all 0.3s ease;
    border: none;
    text-decoration: none;
  }

  .btn-form-primary {
    background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
    color: white;
  }

  .btn-form-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(93, 6, 186, 0.4);
    color: white;
  }

  .btn-form-secondary {
    background: #f8f9fa;
    color: #6e6e73;
    border: 2px solid #e0e0e0;
  }

  .btn-form-secondary:hover {
    background: #e9ecef;
    color: #495057;
    text-decoration: none;
    border-color: #d0d0d0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .page-header {
      padding: 2rem 1.5rem;
    }

    .page-header h1 {
      font-size: 1.75rem;
    }

    .form-container {
      padding: 2rem 1.5rem;
    }

    .form-actions {
      flex-direction: column;
    }

    .btn-form {
      width: 100%;
      justify-content: center;
    }
  }
</style>
` %>

<div class="create-course-page">
  <div class="container">
    <!-- Page Header -->
    <div class="page-header">
      <h1>
        <i class="bi bi-plus-circle"></i>
        Créer un nouveau cours
      </h1>
      <p>Remplissez les informations ci-dessous pour créer un nouveau cours pour le programme General English Boost</p>
    </div>

    <!-- Form Container -->
    <div class="form-container">
      <form action="/programs/language-learning/general-english-boost/admindashboard" method="POST">
        <!-- Informations principales -->
        <div class="form-section">
          <h2 class="form-section-title">
            <i class="bi bi-info-circle"></i>
            Informations principales
          </h2>
          <p class="form-section-description">Informations de base sur le cours</p>

          <div class="row">
            <div class="col-md-8">
              <div class="form-group">
                <label for="title" class="form-label">
                  <i class="bi bi-book"></i>
                  Titre du cours <span class="required">*</span>
                </label>
                <input 
                  type="text" 
                  class="form-control" 
                  id="title" 
                  name="course[title]" 
                  placeholder="Ex: English for Beginners - Level 1"
                  required
                />
                <small class="help-text">
                  <i class="bi bi-info-circle"></i>
                  Choisissez un titre clair et descriptif pour votre cours
                </small>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-group">
                <label for="price" class="form-label">
                  <i class="bi bi-currency-euro"></i>
                  Prix <span class="required">*</span>
                </label>
                <input 
                  type="number" 
                  class="form-control" 
                  id="price" 
                  name="course[price]" 
                  placeholder="0"
                  min="0"
                  step="0.01"
                  required
                />
                <small class="help-text">
                  <i class="bi bi-info-circle"></i>
                  Prix du cours en euros
                </small>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label for="category" class="form-label">
              <i class="bi bi-tag"></i>
              Catégorie
            </label>
            <input 
              type="text" 
              class="form-control" 
              id="category" 
              name="course[category]" 
              placeholder="Ex: Débutant, Intermédiaire, Avancé"
              value="Education"
            />
            <small class="help-text">
              <i class="bi bi-info-circle"></i>
              Catégorie du cours (optionnel, par défaut: Education)
            </small>
          </div>

          <div class="form-group mb-4">
             <div class="form-check form-switch p-0 d-flex align-items-center gap-2">
                 <input class="form-check-input ms-0" type="checkbox" id="isPrivate" name="course[isPrivate]" value="true" style="width: 2.5em; height: 1.25em;">
                 <label class="form-check-label pt-1 pointer" for="isPrivate">
                     <i class="bi bi-eye-slash-fill text-danger"></i> &nbsp; Cours Privé (Ne sera visible que pour les inscrits)
                 </label>
             </div>
          </div>

          <div class="form-group">
            <label for="description" class="form-label">
              <i class="bi bi-file-text"></i>
              Description <span class="required">*</span>
            </label>
            <textarea 
              name="course[description]" 
              class="mytextarea form-control" 
              id="description"
              placeholder="Décrivez le contenu, les objectifs et les bénéfices de ce cours..."
            ></textarea>
            <small class="help-text">
              <i class="bi bi-info-circle"></i>
              Décrivez en détail le contenu et les objectifs de ce cours
            </small>
          </div>
        </div>

        <!-- Instructeurs -->
        <div class="form-section">
          <h2 class="form-section-title">
            <i class="bi bi-people"></i>
            Instructeurs
          </h2>
          <p class="form-section-description">Ajoutez les instructeurs qui enseigneront ce cours (nom d'utilisateur)</p>

          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label for="main-instructor" class="form-label">
                  <i class="bi bi-person-circle"></i>
                  Instructeur principal
                </label>
                <input 
                  type="text" 
                  class="form-control" 
                  id="main-instructor" 
                  name="instructors[main]" 
                  placeholder="Nom d'utilisateur de l'instructeur principal"
                />
                <small class="help-text">
                  <i class="bi bi-info-circle"></i>
                  Nom d'utilisateur de l'instructeur principal (optionnel)
                </small>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label for="second-instructor" class="form-label">
                  <i class="bi bi-person-circle"></i>
                  Instructeur assistant
                </label>
                <input 
                  type="text" 
                  class="form-control" 
                  id="second-instructor" 
                  name="instructors[assistant]" 
                  placeholder="Nom d'utilisateur de l'instructeur assistant"
                />
                <small class="help-text">
                  <i class="bi bi-info-circle"></i>
                  Nom d'utilisateur de l'instructeur assistant (optionnel)
                </small>
              </div>
            </div>
          </div>
        </div>

        <!-- Form Actions -->
        <div class="form-actions">
          <a href="/programs/language-learning/general-english-boost/admindashboard" class="btn-form btn-form-secondary">
            <i class="bi bi-x-circle"></i>
            Annuler
          </a>
          <button type="submit" class="btn-form btn-form-primary" id="submit-btn">
            <i class="bi bi-check-circle"></i>
            Créer le cours
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  // Ensure form submission works with Hugerte
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('form');
    const submitBtn = document.getElementById('submit-btn');
    const textarea = document.getElementById('description');
    
    if (form && submitBtn && textarea) {
      // Disable HTML5 validation for the textarea (Hugerte hides it)
      textarea.removeAttribute('required');
      
      form.addEventListener('submit', function(e) {
        // Validate description manually
        let descriptionContent = '';
        
        // Try to get content from Hugerte editor
        if (window.hugerte && typeof window.hugerte.get === 'function') {
          try {
            const editor = window.hugerte.get(textarea.id);
            if (editor && typeof editor.getContent === 'function') {
              descriptionContent = editor.getContent();
            }
          } catch (err) {
            console.warn('Could not get Hugerte content:', err);
          }
        }
        
        // Fallback to textarea value if Hugerte content is empty
        if (!descriptionContent || descriptionContent.trim() === '') {
          descriptionContent = textarea.value || '';
        }
        
        // Manual validation
        if (!descriptionContent || descriptionContent.trim() === '') {
          e.preventDefault();
          alert('Veuillez remplir la description du cours');
          return false;
        }
        
        // Update textarea with the content before submission
        textarea.value = descriptionContent;
        
        // Show loading state
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Création en cours...';
      });
    }
  });
</script>
