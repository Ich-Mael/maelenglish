<% layout('layouts/main') %>

<% headContent = `<style>
  .page-wrapper { margin-top: 80px; padding: 2rem 0 4rem; }
  .module-header { background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%); color: white; padding: 2.5rem 2rem; border-radius: 20px; margin-bottom: 2rem; }
  .module-header h1 { margin: 0 0 .5rem; font-size: 1.8rem; font-weight: 800; }
  .module-header p { margin: 0; opacity: .85; }
  .lesson-card { background: #fff; border-radius: 14px; box-shadow: 0 2px 8px rgba(0,0,0,.06); padding: 1.1rem 1.4rem; margin-bottom: .75rem; display: flex; align-items: center; gap: 1rem; transition: box-shadow .2s; text-decoration: none; color: inherit; }
  .lesson-card:hover.unlocked { box-shadow: 0 4px 16px rgba(93,6,186,.12); color: inherit; }
  .lesson-card.locked { opacity: .5; cursor: not-allowed; }
  .lesson-card.completed { border-left: 4px solid #22c55e; }
  .lesson-card.unlocked:not(.completed) { border-left: 4px solid #5d06ba; }
  .lesson-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; }
  .icon-video { background: #dbeafe; }
  .icon-text  { background: #f3e8ff; }
  .icon-pdf   { background: #fef9c3; }
  .icon-quiz  { background: #dcfce7; }
  .section-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 10px rgba(0,0,0,.06); padding: 1.5rem; margin-bottom: 1.25rem; }
  .section-card h3 { font-size: 1rem; font-weight: 700; margin: 0 0 1rem; padding-bottom: .75rem; border-bottom: 2px solid #f0f0f0; }
  .status-badge { padding: .2rem .7rem; border-radius: 20px; font-size: .75rem; font-weight: 600; }
  .badge-passed   { background: #d1fae5; color: #065f46; }
  .badge-failed   { background: #fee2e2; color: #991b1b; }
  .badge-pending  { background: #f3f4f6; color: #6b7280; }
  .badge-submitted { background: #dbeafe; color: #1e40af; }
</style>` %>

<div class="page-wrapper">
  <div class="container" style="max-width:800px;">

    <div class="module-header">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
          <p style="opacity:.7;font-size:.85rem;margin:0 0 .3rem;"><%= course.title %></p>
          <h1><%= courseModule.title %></h1>
          <p><%= courseModule.willLearnModule %></p>
        </div>
        <a href="/programs/language-learning/general-english-boost/<%= course._id %>" class="btn btn-light btn-sm">← Cours</a>
      </div>
    </div>

    <%- include('../../../../partials/flash') %>

    <!-- Lessons list -->
    <div class="section-card">
      <h3>📚 Leçons (<%= lessonsWithStatus.filter(l => l.completed).length %>/<%= lessonsWithStatus.length %> terminées)</h3>

      <% if (lessonsWithStatus.length === 0) { %>
        <p class="text-muted small">Aucune leçon pour ce module.</p>
      <% } else { %>
        <% lessonsWithStatus.forEach(({ lesson, completed, unlocked }, idx) => { %>
          <% const icons = { video: '▶', text: '📄', pdf: '📎', practice_quiz: '🧩' }; %>
          <% const iconClasses = { video: 'icon-video', text: 'icon-text', pdf: 'icon-pdf', practice_quiz: 'icon-quiz' }; %>
          <% if (unlocked) { %>
            <a href="/programs/language-learning/general-english-boost/<%= course._id %>/modules/<%= courseModule._id %>/lessons/<%= lesson._id %>"
               class="lesson-card unlocked <%= completed ? 'completed' : '' %>">
          <% } else { %>
            <div class="lesson-card locked">
          <% } %>
              <div class="lesson-icon <%= iconClasses[lesson.type] || '' %>"><%= icons[lesson.type] || '•' %></div>
              <div class="flex-grow-1">
                <div class="fw-semibold"><%= lesson.title %></div>
                <% if (lesson.description) { %><div class="text-muted small"><%= lesson.description %></div><% } %>
              </div>
              <% if (!unlocked) { %>
                <span style="color:#ccc;font-size:1.2rem;">🔒</span>
              <% } else if (completed) { %>
                <span style="color:#22c55e;font-size:1.2rem;">✓</span>
              <% } else { %>
                <span class="text-muted small">→</span>
              <% } %>
          <% if (unlocked) { %>
            </a>
          <% } else { %>
            </div>
          <% } %>
        <% }) %>
      <% } %>
    </div>

    <!-- Module Quiz -->
    <% if (courseModule.moduleQuiz && courseModule.moduleQuiz.questions && courseModule.moduleQuiz.questions.length > 0) { %>
    <div class="section-card">
      <h3>📝 Quiz du module</h3>
      <% if (!allLessonsDone) { %>
        <p class="text-muted small">Terminez toutes les leçons pour débloquer le quiz.</p>
      <% } else if (quizAttempt) { %>
        <div class="d-flex align-items-center gap-3">
          <span class="status-badge <%= quizAttempt.passed ? 'badge-passed' : 'badge-failed' %>">
            <%= quizAttempt.passed ? '✓ Réussi' : '✗ Échoué' %> — <%= quizAttempt.score %>/100
          </span>
          <% if (!quizAttempt.passed) { %>
            <a href="/programs/language-learning/general-english-boost/<%= course._id %>/modules/<%= courseModule._id %>/module-quiz" class="btn btn-sm btn-outline-primary">Réessayer</a>
          <% } %>
        </div>
      <% } else { %>
        <a href="/programs/language-learning/general-english-boost/<%= course._id %>/modules/<%= courseModule._id %>/module-quiz" class="btn btn-primary btn-sm px-4">
          Commencer le quiz (<%= courseModule.moduleQuiz.questions.length %> questions)
        </a>
      <% } %>
    </div>
    <% } %>

    <!-- Module Assignment -->
    <% if (courseModule.moduleAssignment && courseModule.moduleAssignment.title) { %>
    <div class="section-card">
      <h3>📋 Devoir du module</h3>
      <% if (!allLessonsDone) { %>
        <p class="text-muted small">Terminez toutes les leçons pour débloquer le devoir.</p>
      <% } else if (assignmentSubmission) { %>
        <span class="status-badge <%= assignmentSubmission.status === 'graded' ? 'badge-passed' : 'badge-submitted' %>">
          <%= assignmentSubmission.status === 'graded' ? `Note : ${assignmentSubmission.grade}/${assignmentSubmission.maxScore}` : '⏳ En attente de correction' %>
        </span>
        <% if (assignmentSubmission.feedback) { %>
          <p class="mt-2 small text-muted"><strong>Feedback :</strong> <%= assignmentSubmission.feedback %></p>
        <% } %>
      <% } else { %>
        <p class="mb-2 text-muted small"><%= courseModule.moduleAssignment.instructions %></p>
        <a href="/programs/language-learning/general-english-boost/<%= course._id %>/modules/<%= courseModule._id %>/assignment" class="btn btn-warning btn-sm px-4">
          Remettre le devoir
        </a>
      <% } %>
    </div>
    <% } %>

  </div>
</div>
