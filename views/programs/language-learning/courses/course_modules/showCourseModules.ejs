<% layout('layouts/main') %>

<style>
  :root {
    --primary-color: #5d06ba;
    --primary-light: #f3e5f5;
    --text-dark: #1d1d1f;
    --text-muted: #6e6e73;
    --border-color: #e5e5e5;
    --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  body {
    background-color: #f8f9fa;
    font-family: 'Outfit', sans-serif;
  }
  
  .admin-container {
    padding-top: 100px;
    padding-bottom: 50px;
    max-width: 1000px;
    margin: 0 auto;
  }

  /* Banner Styles */
  .modules-banner {
    position: relative;
    background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
    border-radius: 24px;
    padding: 3rem 2.5rem;
    margin-bottom: 2.5rem;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(93, 6, 186, 0.2);
    color: white;
  }
  
  .banner-pattern {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    opacity: 0.1;
    background-image:  radial-gradient(#ffffff 1px, transparent 1px), radial-gradient(#ffffff 1px, transparent 1px);
    background-position: 0 0, 25px 25px;
    background-size: 50px 50px;
  }

  .banner-content {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  
  .banner-text h1 {
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
  }
  
  .banner-text p {
      margin: 0;
      opacity: 0.9;
      font-size: 1.1rem;
  }

  .btn-add-module {
    background: white;
    color: var(--primary-color);
    padding: 0.7rem 1.5rem;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  }

  .btn-add-module:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.2);
    background: white;
    color: #4a0594;
  }

  /* Module List Styles */
  .modules-list {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
  }

  .module-card {
    background: white;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(0,0,0,0.05);
    transition: all 0.3s ease;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  .module-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 24px rgba(0,0,0,0.08);
      border-color: rgba(93, 6, 186, 0.1);
  }
  
  .module-info {
      flex: 1;
      min-width: 250px;
  }
  
  .module-number {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--primary-color);
      font-weight: 700;
      margin-bottom: 0.25rem;
      display: block;
  }
  
  .module-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-dark);
      margin: 0;
  }
  
  .module-meta {
      display: flex;
      gap: 1rem;
      margin-top: 0.5rem;
      font-size: 0.9rem;
      color: var(--text-muted);
  }
  
  .module-actions {
      display: flex;
      gap: 0.5rem;
  }

  .drag-handle {
      cursor: grab;
      color: #cbd5e1;
      padding: 0 6px;
      font-size: 1.1rem;
      display: flex;
      align-items: center;
      transition: color .15s;
  }
  .drag-handle:active { cursor: grabbing; }
  .module-card:hover .drag-handle { color: #94a3b8; }
  .module-card.drag-over { border: 2px dashed var(--primary-color); background: rgba(93,6,186,.04); }
  .module-card.dragging  { opacity: .4; }
  #save-order-btn {
      display: none;
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: var(--primary-color);
      color: #fff;
      border: none;
      padding: .75rem 1.5rem;
      border-radius: 50px;
      font-weight: 700;
      font-size: .95rem;
      cursor: pointer;
      box-shadow: 0 4px 16px rgba(93,6,186,.35);
      z-index: 999;
      gap: .5rem;
      align-items: center;
  }
  #save-order-btn.visible { display: flex; }
  
  .action-btn {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--border-color);
      color: var(--text-dark);
      transition: all 0.2s ease;
      background: white;
      text-decoration: none;
  }
  
  .action-btn:hover {
      transform: translateY(-2px);
  }
  
  .btn-view:hover {
      background: var(--primary-light);
      color: var(--primary-color);
      border-color: var(--primary-light);
  }
  
  .btn-edit:hover {
      background: #e3f2fd;
      color: #1976d2;
      border-color: #e3f2fd;
  }
  
  .btn-delete:hover {
      background: #fee2e2;
      color: #dc2626;
      border-color: #fee2e2;
  }
  
  .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      background: white;
      border-radius: 24px;
      border: 2px dashed var(--border-color);
  }
  
  .empty-state i {
      font-size: 3rem;
      color: var(--text-muted);
      margin-bottom: 1rem;
      display: block;
  }
  
  @media (max-width: 768px) {
      .banner-content {
          flex-direction: column;
          text-align: center;
      }
      .module-card {
          flex-direction: column;
          align-items: flex-start;
      }
      .module-actions {
          width: 100%;
          justify-content: flex-end;
          border-top: 1px solid var(--border-color);
          padding-top: 1rem;
          margin-top: 0.5rem;
      }
  }
</style>

<div class="container admin-container">
  <!-- Banner -->
  <div class="modules-banner">
      <div class="banner-pattern"></div>
      <div class="banner-content">
          <div class="banner-text">
              <h1>Modules du cours</h1>
              <p><%= course.title %></p>
          </div>
          <a href="/maelenglish/cours/admindashboard/<%= course._id %>/edit" class="btn-add-module">
              <i class="bi bi-plus-lg"></i> Créer un module
          </a>
      </div>
  </div>

  <% if(course.modules.length > 0) { %>
      <p class="text-muted small mb-2" style="text-align:center;">
          <i class="bi bi-grip-vertical"></i> Glissez les modules pour les réorganiser
      </p>
      <div class="modules-list" id="modules-list">
          <% course.modules.forEach((chapter, index) => { %>
              <div class="module-card" draggable="true" data-id="<%= chapter._id %>">
                  <span class="drag-handle" title="Réorganiser">
                      <i class="bi bi-grip-vertical"></i>
                  </span>
                  <div class="module-info">
                      <span class="module-number">Module <span class="module-index"><%= index + 1 %></span></span>
                      <h3 class="module-title"><%= chapter.title %></h3>
                      <div class="module-meta">
                          <% if(chapter.revealDate) { %>
                              <span>
                                  <i class="bi bi-calendar-event"></i>
                                  <%= new Date(chapter.revealDate).toLocaleDateString('fr-FR') %>
                              </span>
                          <% } %>
                          <% if(chapter.videoLinks) { %>
                              <span>
                                  <i class="bi bi-play-circle"></i> <%= chapter.videoLinks.length %> vidéos
                              </span>
                          <% } %>
                      </div>
                  </div>

                  <div class="module-actions">
                      <a href="/maelenglish/cours/<%= course._id %>/modules/<%= chapter._id %>"
                         class="action-btn btn-view" title="Voir le contenu">
                          <i class="bi bi-eye"></i>
                      </a>
                      <a href="/maelenglish/cours/admindashboard/<%= course._id %>/modules/<%= chapter._id %>/edit"
                         class="action-btn btn-edit" title="Modifier">
                          <i class="bi bi-pencil"></i>
                      </a>
                      <form action="/maelenglish/cours/admindashboard/<%= course._id %>/modules/<%= chapter._id %>?_method=DELETE" method="POST" style="margin: 0;">
                          <button type="submit" class="action-btn btn-delete" title="Supprimer" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce module ?');">
                              <i class="bi bi-trash"></i>
                          </button>
                      </form>
                  </div>
              </div>
          <% }) %>
      </div>

      <!-- Floating save button (appears after dragging) -->
      <button id="save-order-btn" onclick="saveOrder()">
          <i class="bi bi-check-lg"></i> Enregistrer l'ordre
      </button>
  <% } else { %>
      <div class="empty-state">
          <i class="bi bi-collection"></i>
          <h3>Aucun module pour le moment</h3>
          <p class="text-muted">Commencez par ajouter du contenu pédagogique à ce cours.</p>
          <a href="/maelenglish/cours/admindashboard/<%= course._id %>/edit" class="btn btn-primary rounded-pill mt-3">
              <i class="bi bi-plus-lg"></i> Ajouter le premier module
          </a>
      </div>
  <% } %>
</div>

<script>
(function () {
  const list    = document.getElementById('modules-list');
  const saveBtn = document.getElementById('save-order-btn');
  if (!list) return;

  let dragged   = null;
  let orderChanged = false;

  list.addEventListener('dragstart', e => {
    dragged = e.target.closest('.module-card');
    if (!dragged) return;
    setTimeout(() => dragged.classList.add('dragging'), 0);
  });

  list.addEventListener('dragend', () => {
    if (dragged) dragged.classList.remove('dragging');
    list.querySelectorAll('.module-card').forEach(c => c.classList.remove('drag-over'));
    dragged = null;
    if (orderChanged) saveBtn.classList.add('visible');
  });

  list.addEventListener('dragover', e => {
    e.preventDefault();
    const target = e.target.closest('.module-card');
    if (!target || target === dragged) return;

    list.querySelectorAll('.module-card').forEach(c => c.classList.remove('drag-over'));
    target.classList.add('drag-over');

    const rect  = target.getBoundingClientRect();
    const after = e.clientY > rect.top + rect.height / 2;
    list.insertBefore(dragged, after ? target.nextSibling : target);
    orderChanged = true;

    // Renumber visible badges
    list.querySelectorAll('.module-index').forEach((el, i) => el.textContent = i + 1);
  });

  list.addEventListener('dragenter', e => e.preventDefault());

  window.saveOrder = function () {
    const ids = Array.from(list.querySelectorAll('.module-card')).map(c => c.dataset.id).join(',');
    saveBtn.textContent = 'Enregistrement…';
    saveBtn.disabled    = true;

    fetch('/maelenglish/cours/admindashboard/<%= course._id %>/modules/reorder', {
      method:  'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body:    'orderedIds=' + encodeURIComponent(ids)
    })
    .then(r => r.json())
    .then(data => {
      if (data.ok) {
        saveBtn.innerHTML = '<i class="bi bi-check-lg"></i> Enregistré !';
        orderChanged = false;
        setTimeout(() => { saveBtn.classList.remove('visible'); saveBtn.innerHTML = '<i class="bi bi-check-lg"></i> Enregistrer l\'ordre'; saveBtn.disabled = false; }, 1500);
      }
    })
    .catch(() => {
      saveBtn.textContent = 'Erreur — réessayer';
      saveBtn.disabled = false;
    });
  };
}());
</script>
