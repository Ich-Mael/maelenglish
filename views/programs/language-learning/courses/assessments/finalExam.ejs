<% layout('layouts/main') %>
<% headContent = `<style>
  .page-wrapper{margin-top:80px;padding:2rem 0 4rem}
  .exam-header{background:linear-gradient(135deg,#065f46,#064e3b);color:#fff;padding:2rem;border-radius:16px;margin-bottom:2rem}
  .exam-header h1{margin:0 0 .3rem;font-size:1.6rem;font-weight:800}
  .quiz-card{background:#fff;border-radius:14px;box-shadow:0 2px 10px rgba(0,0,0,.07);padding:1.75rem;margin-bottom:1.25rem}
  .opt-row{display:flex;align-items:center;gap:.75rem;padding:.65rem .9rem;border-radius:8px;border:2px solid #e5e7eb;cursor:pointer;margin-bottom:.4rem;transition:border-color .15s}
  .opt-row:hover{border-color:#065f46}
</style>` %>
<div class="page-wrapper">
  <div class="container" style="max-width:760px">
    <div class="exam-header">
      <p style="opacity:.7;font-size:.82rem;margin:0 0 .25rem"><%= course.title %></p>
      <h1><%= course.finalExam.title || 'Examen final' %></h1>
      <p style="opacity:.85;margin:.25rem 0 0"><%= course.finalExam.questions.length %> questions · Score requis : <%= course.finalExam.passingScore || 70 %>%</p>
    </div>
    <%- include('../../../../partials/flash') %>
    <% if (lastAttempt && lastAttempt.passed) { %>
      <div class="quiz-card text-center">
        <p class="fs-1">🎉</p>
        <h4>Examen réussi — Score : <%= lastAttempt.score %>/100</h4>
        <a href="/programs/language-learning/general-english-boost/<%= course._id %>" class="btn btn-success mt-2">Retour au cours</a>
      </div>
    <% } else { %>
      <form action="/programs/language-learning/general-english-boost/<%= course._id %>/final-exam/submit" method="POST">
        <% course.finalExam.questions.forEach((q, qi) => { %>
          <div class="quiz-card">
            <p class="fw-semibold mb-3"><%= qi+1 %>. <%= q.text %></p>
            <% q.options.forEach(opt => { %>
              <label style="display:block;cursor:pointer">
                <input type="radio" name="answers[<%= qi %>]" value="<%= opt.value %>" required style="display:none">
                <div class="opt-row"><span style="width:18px;height:18px;border:2px solid #d1d5db;border-radius:50%;flex-shrink:0;"></span><span><%= opt.text %></span></div>
              </label>
            <% }) %>
          </div>
        <% }) %>
        <div class="d-flex gap-2 justify-content-between">
          <a href="/programs/language-learning/general-english-boost/<%= course._id %>" class="btn btn-outline-secondary">Annuler</a>
          <button type="submit" class="btn btn-success px-5">Soumettre l'examen</button>
        </div>
      </form>
    <% } %>
  </div>
</div>
