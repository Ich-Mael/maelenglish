<% layout('layouts/main') %>
<% headContent = `<style>
  .page-wrapper{margin-top:80px;padding:2rem 0 4rem}
  .asn-header{background:linear-gradient(135deg,#854d0e,#713f12);color:#fff;padding:2rem;border-radius:16px;margin-bottom:2rem}
  .asn-header h1{margin:0 0 .3rem;font-size:1.6rem;font-weight:800}
  .asn-card{background:#fff;border-radius:14px;box-shadow:0 2px 10px rgba(0,0,0,.07);padding:1.75rem}
</style>` %>
<div class="page-wrapper">
  <div class="container" style="max-width:760px">
    <div class="asn-header">
      <p style="opacity:.7;font-size:.82rem;margin:0 0 .25rem"><%= course.title %> › <%= courseModule.title %></p>
      <h1><%= courseModule.moduleAssignment.title %></h1>
      <% if (courseModule.moduleAssignment.dueDate) { %><p style="opacity:.85;margin:.25rem 0 0">Date limite : <%= new Date(courseModule.moduleAssignment.dueDate).toLocaleDateString('fr-FR') %></p><% } %>
    </div>
    <%- include('../../../../partials/flash') %>
    <div class="asn-card">
      <% if (courseModule.moduleAssignment.instructions) { %>
        <div class="mb-4 p-3 bg-light rounded"><%= courseModule.moduleAssignment.instructions %></div>
      <% } %>
      <% if (existing && existing.status === 'graded') { %>
        <div class="alert alert-success">
          <strong>Note : <%= existing.grade %>/<%= existing.maxScore %></strong>
          <% if (existing.feedback) { %><p class="mb-0 mt-1"><%= existing.feedback %></p><% } %>
        </div>
      <% } else if (existing) { %>
        <div class="alert alert-info">⏳ Devoir soumis — en attente de correction.</div>
        <p class="text-muted small">Votre réponse : <%= existing.content %></p>
      <% } %>
      <form action="/programs/language-learning/general-english-boost/<%= course._id %>/modules/<%= courseModule._id %>/assignment/submit" method="POST">
        <div class="mb-3">
          <label class="form-label fw-semibold">
            <%= courseModule.moduleAssignment.submissionType === 'link' ? 'Lien URL de votre travail' : 'Votre réponse' %>
          </label>
          <% if (courseModule.moduleAssignment.submissionType === 'link') { %>
            <input type="url" name="content" class="form-control" value="<%= existing ? existing.content : '' %>" placeholder="https://..." required>
          <% } else { %>
            <textarea name="content" class="form-control" rows="6" required><%= existing ? existing.content : '' %></textarea>
          <% } %>
        </div>
        <div class="d-flex gap-2">
          <a href="/programs/language-learning/general-english-boost/<%= course._id %>/modules/<%= courseModule._id %>/overview" class="btn btn-outline-secondary">Annuler</a>
          <button type="submit" class="btn btn-warning px-4"><%= existing ? 'Resoumettre' : 'Soumettre' %></button>
        </div>
      </form>
    </div>
  </div>
</div>
