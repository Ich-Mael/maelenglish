<% layout('layouts/main') %>
<% headContent = `<style>
  .page-wrapper{margin-top:80px;padding:2rem 0 4rem}
  .quiz-header{background:linear-gradient(135deg,#1e40af,#1e3a8a);color:#fff;padding:2rem;border-radius:16px;margin-bottom:2rem}
  .quiz-header h1{margin:0 0 .3rem;font-size:1.6rem;font-weight:800}
  .quiz-card{background:#fff;border-radius:14px;box-shadow:0 2px 10px rgba(0,0,0,.07);padding:1.75rem;margin-bottom:1.25rem}
  .opt-row{display:flex;align-items:center;gap:.75rem;padding:.65rem .9rem;border-radius:8px;border:2px solid #e5e7eb;cursor:pointer;margin-bottom:.4rem;transition:border-color .15s}
  .opt-row:hover{border-color:#1e40af}
  input[type=radio]:checked+.opt-row, .opt-row.picked{border-color:#1e40af;background:#eff6ff}
</style>` %>
<div class="page-wrapper">
  <div class="container" style="max-width:760px">
    <div class="quiz-header">
      <p style="opacity:.7;font-size:.82rem;margin:0 0 .25rem"><%= course.title %> › <%= courseModule.title %></p>
      <h1><%= courseModule.moduleQuiz.title %></h1>
      <p style="opacity:.85;margin:.25rem 0 0">Score de passage : <%= courseModule.moduleQuiz.passingScore || 70 %>%<% if (courseModule.moduleQuiz.timeLimit) { %> · Temps : <%= courseModule.moduleQuiz.timeLimit %> min<% } %></p>
    </div>
    <%- include('../../../../partials/flash') %>
    <% if (lastAttempt && lastAttempt.passed) { %>
      <div class="quiz-card text-center">
        <p class="fs-1">✅</p>
        <h4>Quiz déjà réussi — Score : <%= lastAttempt.score %>/100</h4>
        <a href="/programs/language-learning/general-english-boost/<%= course._id %>/modules/<%= courseModule._id %>/overview" class="btn btn-primary mt-2">Retour au module</a>
      </div>
    <% } else { %>
      <form action="/programs/language-learning/general-english-boost/<%= course._id %>/modules/<%= courseModule._id %>/module-quiz/submit" method="POST">
        <% courseModule.moduleQuiz.questions.forEach((q, qi) => { %>
          <div class="quiz-card">
            <p class="fw-semibold mb-3"><%= qi+1 %>. <%= q.text %></p>
            <% q.options.forEach(opt => { %>
              <label style="display:block;cursor:pointer">
                <input type="radio" name="answers[<%= qi %>]" value="<%= opt.value %>" required style="display:none">
                <div class="opt-row"><span style="width:18px;height:18px;border:2px solid #d1d5db;border-radius:50%;flex-shrink:0;"></span><span><%= opt.text %></span></div>
              </label>
            <% }) %>
          </div>
        <% }) %>
        <div class="d-flex gap-2 justify-content-between">
          <a href="/programs/language-learning/general-english-boost/<%= course._id %>/modules/<%= courseModule._id %>/overview" class="btn btn-outline-secondary">Annuler</a>
          <button type="submit" class="btn btn-primary px-5">Soumettre le quiz</button>
        </div>
      </form>
    <% } %>
  </div>
</div>
