<% layout('layouts/main') %>

<% headContent = `<style>
  .page-wrapper { margin-top: 80px; padding: 2rem 0 4rem; }
  .lesson-header { background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%); color: white; padding: 2rem; border-radius: 16px; margin-bottom: 2rem; }
  .lesson-header h1 { margin: 0 0 .3rem; font-size: 1.6rem; font-weight: 800; }
  .lesson-content-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,.07); padding: 2rem; margin-bottom: 1.5rem; }
  .lesson-nav { display: flex; gap: 1rem; justify-content: space-between; flex-wrap: wrap; margin-top: 1.5rem; }
  .sidebar-lesson { display: flex; align-items: center; gap: .75rem; padding: .6rem .8rem; border-radius: 10px; text-decoration: none; color: inherit; margin-bottom: .4rem; font-size: .875rem; }
  .sidebar-lesson.active { background: #ede8f8; font-weight: 700; color: #5d06ba; }
  .sidebar-lesson.completed { color: #166534; }
  .sidebar-lesson.locked { opacity: .45; cursor: not-allowed; pointer-events: none; }
  .video-container { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 12px; }
  .video-container iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; border-radius: 12px; }
  .practice-opt { display: flex; align-items: center; gap: .75rem; padding: .6rem .8rem; border-radius: 8px; cursor: pointer; margin-bottom: .4rem; border: 2px solid #e5e7eb; transition: border-color .15s; }
  .practice-opt:hover { border-color: #5d06ba; }
  .practice-opt.selected { border-color: #5d06ba; background: #f3e8ff; }
  .practice-opt.correct { border-color: #22c55e; background: #f0fdf4; }
  .practice-opt.wrong  { border-color: #ef4444; background: #fef2f2; }
</style>` %>

<div class="page-wrapper">
  <div class="container" style="max-width:1100px;">
    <div class="row g-3">

      <!-- Sidebar: lesson list -->
      <div class="col-md-3 d-none d-md-block">
        <div style="background:#fff;border-radius:14px;box-shadow:0 2px 8px rgba(0,0,0,.06);padding:1rem;position:sticky;top:90px;">
          <p class="fw-semibold small mb-2" style="color:#5d06ba;"><%= courseModule.title %></p>
          <% lessons.forEach(l => {
            const isActive    = l._id.toString() === lesson._id.toString();
            const lCompleted  = isCompleted && isActive ? true : false; // simplified
          %>
            <a href="/programs/language-learning/general-english-boost/<%= course._id %>/modules/<%= courseModule._id %>/lessons/<%= l._id %>"
               class="sidebar-lesson <%= isActive ? 'active' : '' %> d-flex">
              <span><%= l.type === 'video' ? '▶' : l.type === 'text' ? '📄' : l.type === 'pdf' ? '📎' : '🧩' %></span>
              <span class="flex-grow-1"><%= l.title %></span>
            </a>
          <% }) %>
          <div class="mt-3 pt-2 border-top">
            <a href="/programs/language-learning/general-english-boost/<%= course._id %>/modules/<%= courseModule._id %>/overview" class="btn btn-outline-secondary btn-sm w-100">Vue du module</a>
          </div>
        </div>
      </div>

      <!-- Main content -->
      <div class="col-md-9">
        <div class="lesson-header">
          <p style="opacity:.7;font-size:.82rem;margin:0 0 .25rem;"><%= course.title %> › <%= courseModule.title %></p>
          <h1><%= lesson.title %></h1>
          <% if (lesson.description) { %><p><%= lesson.description %></p><% } %>
        </div>

        <%- include('../../../partials/flash') %>

        <div class="lesson-content-card">

          <!-- VIDEO -->
          <% if (lesson.type === 'video') { %>
            <% if (lesson.videoUrl) { %>
              <% const isYouTube = lesson.videoUrl.includes('youtube') || lesson.videoUrl.includes('youtu.be');
                 const isVimeo   = lesson.videoUrl.includes('vimeo');
                 let embedUrl = lesson.videoUrl;
                 if (isYouTube) {
                   const ytId = lesson.videoUrl.match(/(?:v=|youtu\.be\/)([^&?]+)/);
                   if (ytId) embedUrl = 'https://www.youtube.com/embed/' + ytId[1];
                 } else if (isVimeo) {
                   const vmId = lesson.videoUrl.match(/vimeo\.com\/(\d+)/);
                   if (vmId) embedUrl = 'https://player.vimeo.com/video/' + vmId[1];
                 }
              %>
              <div class="video-container mb-3">
                <iframe src="<%= embedUrl %>" allowfullscreen title="<%= lesson.title %>"></iframe>
              </div>
            <% } else { %>
              <p class="text-muted">Aucune vidéo configurée.</p>
            <% } %>
            <% if (lesson.videoDuration) { %><p class="text-muted small"><i class="bi bi-clock me-1"></i><%= lesson.videoDuration %> min</p><% } %>

          <!-- TEXT -->
          <% } else if (lesson.type === 'text') { %>
            <% if (lesson.content) { %>
              <div class="lesson-text-content"><%- lesson.content %></div>
            <% } else { %>
              <p class="text-muted">Aucun contenu textuel configuré.</p>
            <% } %>

          <!-- PDF -->
          <% } else if (lesson.type === 'pdf') { %>
            <% if (lesson.fileUrl) { %>
              <div class="text-center py-4">
                <p class="fs-1 mb-2">📎</p>
                <p class="fw-semibold mb-3"><%= lesson.fileName || 'Document' %></p>
                <a href="<%= lesson.fileUrl %>" target="_blank" class="btn btn-primary px-4">
                  <i class="bi bi-download me-2"></i>Télécharger / Ouvrir
                </a>
              </div>
            <% } else { %>
              <p class="text-muted">Aucun fichier configuré.</p>
            <% } %>

          <!-- PRACTICE QUIZ -->
          <% } else if (lesson.type === 'practice_quiz') { %>
            <% if (lesson.practiceQuiz && lesson.practiceQuiz.questions && lesson.practiceQuiz.questions.length > 0) { %>
              <h5 class="fw-bold mb-3">🧩 Quiz de pratique</h5>
              <div id="practiceQuiz">
                <% lesson.practiceQuiz.questions.forEach((q, qi) => { %>
                  <div class="mb-4" id="pq_<%= qi %>">
                    <p class="fw-semibold mb-2"><%= qi + 1 %>. <%= q.text %></p>
                    <% q.options.forEach(opt => { %>
                      <div class="practice-opt" onclick="selectPracticeOpt(this, '<%= qi %>', '<%= opt.value %>', '<%= q.correctAnswer %>', '<%= q.explanation ? q.explanation.replace(/'/g, "\\'") : '' %>')">
                        <span class="opt-mark" style="width:20px;height:20px;border:2px solid #d1d5db;border-radius:50%;flex-shrink:0;"></span>
                        <span><%= opt.text %></span>
                      </div>
                    <% }) %>
                    <div class="explanation mt-2 small text-muted" id="exp_<%= qi %>" style="display:none;"></div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="text-muted">Questions à venir.</p>
            <% } %>
          <% } %>
        </div>

        <!-- Navigation + complete button -->
        <div class="lesson-nav">
          <a href="/programs/language-learning/general-english-boost/<%= course._id %>/modules/<%= courseModule._id %>/overview" class="btn btn-outline-secondary">← Module</a>
          <% if (!isCompleted) { %>
            <form action="/programs/language-learning/general-english-boost/<%= course._id %>/modules/<%= courseModule._id %>/lessons/<%= lesson._id %>/complete" method="POST">
              <button type="submit" class="btn btn-success px-4 rounded-pill">
                <i class="bi bi-check-circle me-2"></i>Marquer comme terminée et continuer
              </button>
            </form>
          <% } else if (nextLesson) { %>
            <a href="/programs/language-learning/general-english-boost/<%= course._id %>/modules/<%= courseModule._id %>/lessons/<%= nextLesson._id %>" class="btn btn-primary px-4 rounded-pill">
              Leçon suivante →
            </a>
          <% } else { %>
            <a href="/programs/language-learning/general-english-boost/<%= course._id %>/modules/<%= courseModule._id %>/overview" class="btn btn-success px-4 rounded-pill">
              <i class="bi bi-check-circle me-2"></i>Module terminé →
            </a>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
function selectPracticeOpt(el, qi, value, correct, explanation) {
  // Reset options in this question
  el.closest('#pq_' + qi).querySelectorAll('.practice-opt').forEach(o => {
    o.classList.remove('selected', 'correct', 'wrong');
    o.querySelector('.opt-mark').style.background = '';
    o.querySelector('.opt-mark').style.borderColor = '#d1d5db';
  });
  el.classList.add('selected');
  const isCorrect = value === correct;
  el.classList.add(isCorrect ? 'correct' : 'wrong');
  el.querySelector('.opt-mark').style.background = isCorrect ? '#22c55e' : '#ef4444';
  el.querySelector('.opt-mark').style.borderColor = isCorrect ? '#22c55e' : '#ef4444';

  const expEl = document.getElementById('exp_' + qi);
  if (explanation) {
    expEl.innerHTML = (isCorrect ? '✓ ' : '✗ ') + explanation;
    expEl.style.display = 'block';
    expEl.style.color = isCorrect ? '#166534' : '#991b1b';
  }
}
</script>
