        <div class="d-flex flex-wrap gap-3">
          <a href="#practical-info" class="btn btn-light rounded-pill px-4 py-3 fw-bold shadow-lg text-primary">
            Infos Pratiques <i class="bi bi-arrow-down-short ms-1"></i>
          </a>
          <a href="#calendar" class="btn btn-outline-light rounded-pill px-4 py-3 fw-bold shadow-lg">
            Calendrier 2026 <i class="bi bi-calendar-event ms-1"></i>
