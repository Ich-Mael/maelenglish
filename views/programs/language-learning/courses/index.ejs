          <img src="/assets/img/english-coaching-v3.png" alt="Niveau Intermédiaire" style="width:100%; height:100%; object-fit:cover;">
      </div>
      
      <div class="level-info">
        <span class="level-badge">Niveau 2</span>
        <h3 class="level-title">Niveau Intermédiaire</h3>
        <p class="level-desc">
          Gagnez en fluidité. Enrichissez votre vocabulaire, améliorez votre prononciation et exprimez des idées plus complexes dans des contextes variés.
        </p>
        
        <div class="mt-3">
          <div class="d-flex flex-wrap gap-3 text-muted small">
            <div><i class="bi bi-clock me-1"></i> 6 Semaines</div>
            <div><i class="bi bi-mic me-1"></i> Conversation</div>
            <div><i class="bi bi-award me-1"></i> Autonomie</div>
          </div>
        </div>
      </div>

       <div class="level-action">
        <span class="status-badge">Acquisition</span>
      </div>
    </div>
    
  </div>
  </div>
</div>

