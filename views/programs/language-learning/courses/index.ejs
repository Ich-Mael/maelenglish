<% layout('layouts/main') %>

<style>
  :root {
    --primary-color: #5d06ba;
    --primary-light: #f3e5f5;
    --primary-dark: #2d0370;
    --accent-color: #00d2d3;
    --text-dark: #1d1d1f;
    --text-muted: #6e6e73;
    --card-bg: #ffffff;
    --radius-lg: 24px;
    --radius-xl: 32px;
    font-family: 'Outfit', sans-serif;
  }
  
  body {
    background-color: #f8f9fa;
    font-family: var(--font-family);
    overflow-x: hidden;
  }

  /* 1. Split Hero Section */
  .hero-v2 {
    background: linear-gradient(135deg, #1a0b2e 0%, #2d0370 100%);
    color: white;
    padding: 100px 0;
    position: relative;
    overflow: hidden;
  }

  .hero-circle-bg {
    position: absolute;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(93, 6, 186, 0.4) 0%, rgba(0,0,0,0) 70%);
    top: -100px;
    right: -100px;
    border-radius: 50%;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .hero-badge {
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.2);
    padding: 8px 16px;
    border-radius: 30px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: #e0aaff;
    margin-bottom: 24px;
    letter-spacing: 0.5px;
  }

  .hero-title {
    font-size: 4rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 24px;
    background: linear-gradient(to right, #fff, #a0a0a0);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    opacity: 0.85;
    margin-bottom: 32px;
    line-height: 1.6;
    max-width: 500px;
  }

  .hero-image-pane {
    position: relative;
    z-index: 2;
  }
  
  .hero-img {
    border-radius: var(--radius-xl);
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    transform: rotate(2deg);
    transition: transform 0.5s ease;
  }
  
  .hero-img:hover {
    transform: rotate(0deg) scale(1.02);
  }

  /* 2. Features Grid */
  .features-section {
    padding: 60px 0;
    margin-top: -40px;
    position: relative;
    z-index: 3;
  }

  .feature-card {
    background: white;
    padding: 24px;
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    display: flex;
    align-items: flex-start;
    gap: 16px;
    height: 100%;
    transition: transform 0.3s ease;
  }

  .feature-card:hover {
    transform: translateY(-5px);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--primary-light);
    color: var(--primary-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  /* 3. The Path (Roadmap) */
  .path-section-wrapper {
    padding: 80px 0;
    background-color: var(--primary-light);
    position: relative;
  }

  .path-section-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0,0,0,0.05), transparent);
  }

  @keyframes gradient-animation {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .section-header {
    margin-bottom: 60px;
    padding: 80px 40px;
    border-radius: 40px;
    background: linear-gradient(135deg, #ffffff 0%, #fcfaff 100%);
    box-shadow: 0 20px 60px rgba(93, 6, 186, 0.08);
    position: relative;
    overflow: hidden;
    
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
    border: 1px solid rgba(255, 255, 255, 0.8);
  }

  /* Decorative glow */
  .header-decoration {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(93, 6, 186, 0.03) 0%, transparent 70%);
    pointer-events: none;
    z-index: 1;
  }

  .section-badge {
    position: relative;
    z-index: 2;
    color: var(--primary-color);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.85rem;
    padding: 10px 24px;
    border-radius: 50px;
    background: rgba(93, 6, 186, 0.05);
    border: 1px solid rgba(93, 6, 186, 0.1);
    margin-bottom: 24px;
    display: inline-block;
  }

  .section-title {
    position: relative;
    z-index: 2;
    font-size: 3.5rem;
    font-weight: 800;
    color: var(--text-dark);
    margin: 0 0 24px 0;
    line-height: 1.1;
    letter-spacing: -1.5px;
  }
  
  .text-gradient {
    background: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-color) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    position: relative;
  }
  
  .section-subtitle {
     position: relative;
     z-index: 2;
     font-size: 1.25rem;
     color: var(--text-muted);
     line-height: 1.6;
     margin: 0 auto;
     max-width: 600px;
  }

  @media(max-width: 991px) {
    .section-header {
      padding: 60px 24px;
    }
    .section-title {
      font-size: 2.5rem;
    }
    .section-subtitle {
      font-size: 1.1rem;
    }
  }

  .level-card {
    background: linear-gradient(120deg, #ffffff 0%, #f8f9fa 100%);
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    margin-bottom: 30px;
    overflow: hidden;
    position: relative;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .level-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(93, 6, 186, 0.1);
  }

  @media(min-width: 992px) {
    .level-card {
      flex-direction: row;
      align-items: center;
      padding: 30px;
    }
    
    .level-visual {
      width: 250px;
      height: 160px;
      border-radius: 16px;
      overflow: hidden;
      margin-right: 30px;
      flex-shrink: 0;
    }

    .level-info {
      flex: 1;
    }

    .level-action {
      margin-left: 30px;
      padding-left: 30px;
      border-left: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-width: 180px;
    }
  }

  .level-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .level-badge {
    text-transform: uppercase;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 1px;
    color: var(--primary-color);
    margin-bottom: 8px;
    display: block;
  }

  .level-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--text-dark);
  }
  
  .level-desc {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .level-price {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 12px;
  }

  .btn-path {
    background: var(--text-dark);
    color: white;
    border-radius: 50px;
    padding: 10px 24px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  
  .btn-path:hover {
    background: var(--primary-color);
    color: white;
    transform: scale(1.05);
  }

  .btn-path-outline {
    background: transparent;
    color: var(--text-dark);
    border: 2px solid var(--text-dark);
    border-radius: 50px;
    padding: 8px 24px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
  }

  .btn-path-outline:hover {
    background: var(--text-dark);
    color: white;
  }

  .status-badge {
    background: #dcfce7;
    color: #166534;
    padding: 6px 12px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.8rem;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
  }

  @media (max-width: 991px) {
    .level-card {
      padding: 0;
      border-radius: 20px;
    }
    
    .level-visual {
      width: 100%;
      height: 220px;
      border-radius: 0;
      margin: 0;
    }
    
    .level-info {
      padding: 24px 24px 0 24px;
    }

    .level-action {
      margin: 24px 0 0 0;
      padding: 24px;
      border-top: 1px solid rgba(0,0,0,0.05);
      background: #fafafa;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    
    .hero-title {
      font-size: 2.5rem;
    }
  }

  @media (max-width: 576px) {
    .hero-title {
      font-size: 2rem;
    }
    
    .level-action {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }
    
    .btn-path {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<!-- 1. Hero Section -->
<div class="hero-v2">
  <div class="hero-circle-bg"></div>
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6 hero-content">
        <h1 class="hero-title">Parlez anglais avec aisance et confiance</h1>
        <p class="hero-subtitle">
          Pour les étudiants ambitieux et les professionnels en action. Maîtrisez la communication courante pour exceller dans vos études, dynamiser votre carrière et vous ouvrir au monde.
        </p>
        <a href="#learning-path" class="btn btn-light rounded-pill px-4 py-3 fw-bold shadow-lg text-primary">
          Commencer l'aventure <i class="bi bi-arrow-down-short ms-1"></i>
        </a>
      </div>
      <div class="col-lg-6 d-none d-lg-block hero-image-pane">
        <img src="/assets/img/hero-english-boost.png" class="img-fluid hero-img" alt="Professionals discussing">
      </div>
    </div>
  </div>
</div>

<!-- 2. Features Grid -->
<div class="container features-section">
  <div class="row g-4">
    <div class="col-md-4">
      <div class="feature-card">
        <div class="feature-icon"><i class="bi bi-camera-video"></i></div>
        <div>
          <h5 class="fw-bold mb-1">Cours Vidéo HD</h5>
          <p class="text-muted small mb-0">Des leçons filmées en studio pour une clarté parfaite.</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="feature-card">
        <div class="feature-icon"><i class="bi bi-people"></i></div>
        <div>
          <h5 class="fw-bold mb-1">Coachs Certifiés</h5>
          <p class="text-muted small mb-0">Apprenez avec des experts natifs et passionnés.</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="feature-card">
        <div class="feature-icon"><i class="bi bi-trophy"></i></div>
        <div>
          <h5 class="fw-bold mb-1">Certification</h5>
          <p class="text-muted small mb-0">Obtenez un certificat reconnu à la fin de chaque niveau.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 3. Learning Path (Roadmap) -->
<div class="path-section-wrapper" id="learning-path">
  <div class="container">
  <div class="section-header">
    <div class="header-decoration"></div>
    <span class="section-badge">Programme D'Excellence</span>
    <h2 class="section-title">
      Votre Parcours <br class="d-md-none">
      <span class="text-gradient">Simplifié</span>
    </h2>
    <p class="section-subtitle">
      Une approche pédagogique moderne conçue pour des résultats rapides.
      Commencez dès maintenant votre apprentissage.
    </p>
  </div>

  <div class="path-list">
    
    <!-- Level 1: General English Boost 1 -->
    <div class="level-card">
      <!-- Visual -->
      <div class="level-visual">
        <img src="/assets/img/english-coaching-v3.png" alt="General English Boost 1">
      </div>
      
      <!-- Info -->
      <div class="level-info">
        <span class="level-badge">Niveau 1</span>
        <h3 class="level-title">General English Boost 1</h3>
