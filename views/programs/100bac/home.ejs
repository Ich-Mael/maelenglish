<% layout('layouts/boilerplate') %>
<link rel="preconnect" href="https://fonts.gstatic.com" />
<link
  href="https://fonts.googleapis.com/css2?family=Chango&display=swap"
  rel="stylesheet"
/>
<link href="stylesheets/100bac/100bachome.css" rel="stylesheet" />
<!-- Series -->
<section class="serie d-flex align-items-center">
  <div class="container">
    <div class="title">
      <h1 class="title-heading text-center animated tada">
        Operation 💯 % BAC
      </h1>
      <p id="moto" class="text-center">
        Réussir au BAC est une affaire personnelle
      </p>
    </div>  
  </div>
  <div class="select-serie-wrapper d-flex justify-content-center">
    <% if (!currentUser || currentUser == null) {%>
      <a class="start-learning-btn" href="/login">Connectez-vous et préparez-vous pour votre BAC</a>
      <%}%>
  </div>
</section>

<!-- series -->
<section class="py-5">
  <h3 class="series-list">Les series Disponibles</h3>
<div class="row serie-cards-wrapper">
  <!-- serie D -->
  <div class="col-sm-6 col-md-3 my-3">
    <div class="card">
      <div class="card-body d-flex flex-column Justify-content-center">
        <h5 class="card-title text-center">Serie D</h5>
        <button
          id="serie-d"
          class="col-12 text-center d-flex align-self-center my-3"
        >
          <a class="serie-link" href="/100bac/TleD"
            >Avoir son Bac<i class="bi bi-box-arrow-in-right"></i
          ></a>
        </button>
      </div>
    </div>
  </div>

  <!-- serie A -->
  <div class="col-sm-6 col-md-3 my-3">
    <div class="card">
      <div class="card-body d-flex flex-column Justify-content-center">
        <h5 class="card-title text-center">Serie A</h5>
        <button
          id="serie-a"
          class="col-12 text-center d-flex align-self-center my-3"
        >
          <a class="serie-link" href="/100bac/TleA"
            >Avoir son Bac A <i class="bi bi-box-arrow-in-right"></i
          ></a>
        </button>
      </div>
    </div>
  </div>

  <!-- serie C -->
  <div class="col-sm-6 col-md-3 my-3">
    <div class="card">
      <div class="card-body d-flex flex-column Justify-content-center">
        <h5 class="card-title text-center">Serie C</h5>
        <button
          id="serie-c"
          class="col-12 text-center d-flex align-self-center my-3"
        >
          <a class="serie-link" href="/100bac/TleC"
            >Avoir son Bac<i class="bi bi-box-arrow-in-right"></i
          ></a>
        </button>
      </div>
    </div>
  </div>

  <!-- serie G2 -->
  <div class="col-sm-6 col-md-3 my-3">
    <div class="card">
      <div class="card-body d-flex flex-column Justify-content-center">
        <h5 class="card-title text-center">Serie G2</h5>
        <button
          id="serie-g2"
          class="col-12 text-center d-flex align-self-center my-3"
        >
          <a class="serie-link" href="/100bac/TleG2"
            >Avoir son Bac<i class="bi bi-box-arrow-in-right"></i
          ></a>
        </button>
      </div>
    </div>
  </div>
</div>
</section>
<!--End Series -->

