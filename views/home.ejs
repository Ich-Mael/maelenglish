  <!-- Programs Section Styles - Modern Compact Design -->
  <style>
    /* Programs Section - Modern Compact Grid Design */
    .programs-section-modern {
      padding: 80px 0;
      background: #ffffff;
    }

    .programs-header-modern {
      text-align: center;
      margin-bottom: 60px;
    }

    .programs-title-modern {
      font-size: 42px;
      font-weight: 700;
      color: #1d1d1f;
      margin-bottom: 16px;
      line-height: 1.2;
    }

    .programs-subtitle-modern {
      font-size: 20px;
      font-weight: 400;
      color: #86868b;
      margin: 0;
      line-height: 1.5;
    }

    .programs-grid-modern {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 32px;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .program-card-modern {
      background: #ffffff;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      display: flex;
      flex-direction: column;
      height: 100%;
      cursor: pointer;
    }

    .program-card-modern:hover {
      transform: translateY(-8px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
    }

    .program-card-image {
      position: relative;
      width: 100%;
      height: 240px;
      overflow: hidden;
      background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
    }

    .program-card-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .program-card-modern:hover .program-card-image img {
      transform: scale(1.1);
    }

    .program-card-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.3) 100%);
    }

    .program-card-content {
      padding: 32px 24px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .program-card-header {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 16px;
    }

    .program-card-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .program-card-icon i {
      font-size: 24px;
      color: #ffffff;
    }

    .program-card-title {
      font-size: 24px;
      font-weight: 700;
      color: #1d1d1f;
      margin: 0;
      line-height: 1.3;
      flex: 1;
    }

    .program-card-description {
      font-size: 15px;
      font-weight: 400;
      color: #6e6e73;
      line-height: 1.6;
      margin-bottom: 24px;
      flex: 1;
    }


    .program-card-link {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 12px 28px;
      background: linear-gradient(135deg, #5107ce 0%, #4b08a1 100%);
      color: #fff;
      text-decoration: none;
      border-radius: 50px;
      font-weight: 600;
      font-size: 15px;
      transition: all 0.4s ease;
      margin-top: auto;
      box-shadow: 0 6px 20px rgba(81, 7, 206, 0.3);
      border: 2px solid rgba(255, 255, 255, 0.2);
      position: relative;
      overflow: hidden;
    }

    /* Shine effect */
    .program-card-link::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transition: left 0.6s ease;
    }

    .program-card-link:hover::before {
      left: 100%;
    }

    .program-card-link:hover {
      background: linear-gradient(135deg, #6b1fff 0%, #5d0fd4 100%);
      box-shadow: 0 8px 24px rgba(81, 7, 206, 0.5);
      transform: translateY(-2px);
      border-color: rgba(255, 255, 255, 0.3);
      color: #fff;
      gap: 12px;
    }

    .program-card-link i {
      font-size: 16px;
      transition: transform 0.3s ease;
    }

    .program-card-link:hover i {
      transform: translateX(4px);
    }

    /* Responsive Design */
    @media (max-width: 992px) {
      .programs-grid-modern {
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
      }

      .programs-title-modern {
        font-size: 36px;
      }

      .programs-subtitle-modern {
        font-size: 18px;
      }
    }

    @media (max-width: 768px) {
      .programs-section-modern {
        padding: 60px 0;
      }

      .programs-header-modern {
        margin-bottom: 40px;
        padding: 0 20px;
      }

      .programs-title-modern {
        font-size: 32px;
      }

      .programs-subtitle-modern {
        font-size: 16px;
      }

      .programs-grid-modern {
        grid-template-columns: 1fr;
        gap: 24px;
        padding: 0 16px;
      }

      .program-card-image {
        height: 200px;
      }

      .program-card-content {
        padding: 24px 20px;
      }
    }

    @media (max-width: 576px) {
      .programs-title-modern {
        font-size: 28px;
      }

      .program-card-title {
        font-size: 22px;
      }

      .program-card-description {
        font-size: 14px;
      }
    }

    /* About Section Mouse Move Animation */
    .about-img-wrapper {
      position: relative;
      perspective: 1000px;
      transform-style: preserve-3d;
    }

    .gallery {
      position: relative;
      width: 100%;
      height: 100%;
      transition: transform 0.1s ease-out;
    }

    .gallery img {
      transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
      will-change: transform;
    }

    .gallery img:nth-child(1) {
      transition-delay: 0s;
    }

    .gallery img:nth-child(2) {
      transition-delay: 0.05s;
    }

    .gallery img:nth-child(3) {
      transition-delay: 0.1s;
    }

    .gallery img:nth-child(4) {
      transition-delay: 0.15s;
    }

    /* Fix for white space below About section */
    #about.section-bg:before {
      bottom: 0;
    }
  </style>
</head>

