<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />

  <title>Afro House of Knowledge</title>
  <meta
    content="Afro House of Knowledge - Plateforme éducative en ligne proposant des formations d'excellence académique, accompagnement scolaire et apprentissage des langues. Le savoir sans barrières. Découvrir, Développer, Devenir."
    name="description" />

  <meta content="" name="keywords" />

  <!-- Favicons -->
  <link href="/assets/img/afrohk_logo_2.png" rel="icon" />
  <meta property="og:image" content="/assets/img/afrohk_logo_2.png" />
  <!-- Font awesome -->
  <script src="https://kit.fontawesome.com/9ecb022092.js" defer></script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css?family=Open+Sans:400,600,700|Raleway:400,500,600,700|Poppins:400,500,600,700&display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="assets/vendor/aos/aos.css" rel="stylesheet" />
  <link href="assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
  <link href="assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" />
  <link href="assets/vendor/boxicons/css/boxicons.min.css" rel="stylesheet" />
  <link href="assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet" />
  <link href="assets/vendor/remixicon/remixicon.css" rel="stylesheet" />
  <link href="assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet" />

  <!-- Template Main CSS File -->
  <link href="assets/css/Home.css" rel="stylesheet" />
  <link href="assets/css/navbar.css" rel="stylesheet" />
  <link href="assets/css/contact-redesign.css" rel="stylesheet" />
  <link href="assets/css/reflection-gallery.css" rel="stylesheet" />


  <!-- Programs Section Styles - Modern Compact Design -->
  <style>
    /* Programs Section - Modern Compact Grid Design */
    .programs-section-modern {
      padding: 80px 0;
      background: #ffffff;
    }

    .programs-header-modern {
      text-align: center;
      margin-bottom: 60px;
    }

    .programs-title-modern {
      font-size: 42px;
      font-weight: 700;
      color: #1d1d1f;
      margin-bottom: 16px;
      line-height: 1.2;
    }

    .programs-subtitle-modern {
      font-size: 20px;
      font-weight: 400;
      color: #86868b;
      margin: 0;
      line-height: 1.5;
    }

    .programs-grid-modern {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .program-card-modern {
      background: #ffffff;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      display: flex;
      flex-direction: column;
      height: 100%;
      cursor: pointer;
    }

    .program-card-modern:hover {
      transform: translateY(-8px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
    }

    .program-card-image {
      position: relative;
      width: 100%;
      height: 240px;
      overflow: hidden;
      background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
    }

    .program-card-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .program-card-modern:hover .program-card-image img {
      transform: scale(1.1);
    }

    .program-card-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.3) 100%);
    }

    .program-card-content {
      padding: 32px 24px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .program-card-header {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 16px;
    }

    .program-card-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .program-card-icon i {
      font-size: 24px;
      color: #ffffff;
    }

    .program-card-title {
      font-size: 24px;
      font-weight: 700;
      color: #1d1d1f;
      margin: 0;
      line-height: 1.3;
      flex: 1;
    }

    .program-card-description {
      font-size: 15px;
      font-weight: 400;
      color: #6e6e73;
      line-height: 1.6;
      margin-bottom: 24px;
      flex: 1;
    }


    .program-card-link {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 12px 28px;
      background: linear-gradient(135deg, #5107ce 0%, #4b08a1 100%);
      color: #fff;
      text-decoration: none;
      border-radius: 50px;
      font-weight: 600;
      font-size: 15px;
      transition: all 0.4s ease;
      margin-top: auto;
      box-shadow: 0 6px 20px rgba(81, 7, 206, 0.3);
      border: 2px solid rgba(255, 255, 255, 0.2);
      position: relative;
      overflow: hidden;
    }

    /* Shine effect */
    .program-card-link::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transition: left 0.6s ease;
    }

    .program-card-link:hover::before {
      left: 100%;
    }

    .program-card-link:hover {
      background: linear-gradient(135deg, #6b1fff 0%, #5d0fd4 100%);
      box-shadow: 0 8px 24px rgba(81, 7, 206, 0.5);
      transform: translateY(-2px);
      border-color: rgba(255, 255, 255, 0.3);
      color: #fff;
      gap: 12px;
    }

    .program-card-link i {
      font-size: 16px;
      transition: transform 0.3s ease;
    }

    .program-card-link:hover i {
      transform: translateX(4px);
    }

    /* Responsive Design */
    @media (max-width: 992px) {
      .programs-grid-modern {
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
      }

      .programs-title-modern {
        font-size: 36px;
      }

      .programs-subtitle-modern {
        font-size: 18px;
      }
    }

    @media (max-width: 768px) {
      .programs-section-modern {
        padding: 60px 0;
      }

      .programs-header-modern {
        margin-bottom: 40px;
        padding: 0 20px;
      }

      .programs-title-modern {
        font-size: 32px;
      }

      .programs-subtitle-modern {
        font-size: 16px;
      }

      .programs-grid-modern {
        grid-template-columns: 1fr;
        gap: 24px;
        padding: 0 16px;
      }

      .program-card-image {
        height: 200px;
      }

      .program-card-content {
        padding: 24px 20px;
      }
    }

    @media (max-width: 576px) {
      .programs-title-modern {
        font-size: 28px;
      }

      .program-card-title {
        font-size: 22px;
      }

      .program-card-description {
        font-size: 14px;
      }
    }

    /* Institution Formations Teaser */
    #institution-formations {
      position: relative;
      overflow: hidden;
      padding: 110px 0;
      background:
        url('https://images.pexels.com/photos/11694327/pexels-photo-11694327.jpeg') center/cover no-repeat;
    }

    #institution-formations::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(110deg,
          rgba(10, 2, 35, 0.90) 0%,
          rgba(45, 3, 112, 0.82) 45%,
          rgba(10, 2, 35, 0.55) 100%);
    }

    .inst-teaser-inner {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 1fr 400px;
      gap: 64px;
      align-items: center;
    }

    .inst-teaser-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: rgba(255, 255, 255, .12);
      border: 1px solid rgba(255, 255, 255, .25);
      backdrop-filter: blur(6px);
      color: #e0d4ff;
      font-size: .72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .09em;
      padding: 6px 16px;
      border-radius: 50px;
      margin-bottom: 20px;
    }

    .inst-teaser-heading {
      font-size: 3rem;
      font-weight: 800;
      color: #fff;
      line-height: 1.1;
      margin-bottom: 20px;
      text-shadow: 0 2px 20px rgba(0, 0, 0, .3);
    }

    .inst-teaser-heading span {
      background: linear-gradient(90deg, #c084fc, #a78bfa);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .inst-teaser-desc {
      font-size: 1.05rem;
      color: rgba(255, 255, 255, .78);
      line-height: 1.75;
      margin-bottom: 28px;
      max-width: 500px;
    }

    .inst-teaser-features {
      list-style: none;
      padding: 0;
      margin: 0 0 32px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 24px;
    }

    .inst-teaser-features li {
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: .9rem;
      color: rgba(255, 255, 255, .85);
      font-weight: 500;
    }

    .inst-teaser-features li i {
      color: #a78bfa;
      font-size: 1rem;
      flex-shrink: 0;
    }

    .inst-teaser-stats {
      display: flex;
      gap: 36px;
      margin-bottom: 40px;
      padding-top: 8px;
      border-top: 1px solid rgba(255, 255, 255, .12);
    }

    .inst-stat {
      display: flex;
      flex-direction: column;
    }

    .inst-stat-num {
      font-size: 2.4rem;
      font-weight: 800;
      color: #c084fc;
      line-height: 1;
    }

    .inst-stat-label {
      font-size: .75rem;
      color: rgba(255, 255, 255, .5);
      text-transform: uppercase;
      letter-spacing: .07em;
      margin-top: 3px;
    }

    .inst-teaser-cta {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 15px 34px;
      background: #fff;
      color: #4b08a1;
      text-decoration: none;
      border-radius: 50px;
      font-weight: 800;
      font-size: 1rem;
      box-shadow: 0 8px 32px rgba(0, 0, 0, .25);
      transition: all .3s ease;
      position: relative;
      overflow: hidden;
    }

    .inst-teaser-cta::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, #ede9fe, #fff);
      opacity: 0;
      transition: opacity .3s;
    }

    .inst-teaser-cta:hover::before {
      opacity: 1;
    }

    .inst-teaser-cta span,
    .inst-teaser-cta i {
      position: relative;
      z-index: 1;
    }

    .inst-teaser-cta:hover {
      color: #4b08a1;
      box-shadow: 0 14px 40px rgba(0, 0, 0, .35);
      transform: translateY(-2px);
    }

    .inst-teaser-cta i {
      transition: transform .3s ease;
    }

    .inst-teaser-cta:hover i {
      transform: translateX(5px);
    }

    /* Glassmorphism card panel */
    .inst-teaser-right {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .inst-glass-panel {
      background: rgba(255, 255, 255, .08);
      border: 1px solid rgba(255, 255, 255, .15);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-radius: 24px;
      padding: 28px;
      width: 100%;
      max-width: 360px;
    }

    .igp-label {
      font-size: .72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: rgba(255, 255, 255, .5);
      margin-bottom: 18px;
    }

    .igp-course {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 12px;
      border-radius: 14px;
      background: rgba(255, 255, 255, .06);
      border: 1px solid rgba(255, 255, 255, .08);
      margin-bottom: 10px;
      transition: background .2s;
    }

    .igp-course:last-of-type {
      margin-bottom: 0;
    }

    .igp-thumb {
      width: 46px;
      height: 46px;
      border-radius: 10px;
      flex-shrink: 0;
    }

    .igp-t1 {
      background: linear-gradient(135deg, #7c3aed, #4b08a1);
    }

    .igp-t2 {
      background: linear-gradient(135deg, #0ea5e9, #0369a1);
    }

    .igp-t3 {
      background: linear-gradient(135deg, #f59e0b, #b45309);
    }

    .igp-info {
      flex: 1;
      min-width: 0;
    }

    .igp-title {
      font-size: .85rem;
      font-weight: 700;
      color: #fff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin-bottom: 3px;
    }

    .igp-inst {
      font-size: .72rem;
      color: rgba(255, 255, 255, .5);
    }

    .igp-badge {
      font-size: .65rem;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 50px;
      background: rgba(167, 139, 250, .2);
      color: #c084fc;
      border: 1px solid rgba(167, 139, 250, .3);
      white-space: nowrap;
    }

    .igp-divider {
      border: none;
      border-top: 1px solid rgba(255, 255, 255, .08);
      margin: 16px 0;
    }

    .igp-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .igp-footer-text {
      font-size: .78rem;
      color: rgba(255, 255, 255, .45);
    }

    .igp-footer-link {
      font-size: .78rem;
      font-weight: 700;
      color: #c084fc;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .igp-footer-link:hover {
      color: #a78bfa;
    }

    @media (max-width: 1024px) {
      .inst-teaser-inner {
        grid-template-columns: 1fr;
        gap: 48px;
      }

      .inst-teaser-right {
        display: none;
      }

      .inst-teaser-features {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 768px) {
      #institution-formations {
        padding: 80px 0;
      }

      .inst-teaser-heading {
        font-size: 2.2rem;
      }
    }

    /* ── About Section Redesign ── */
    .abt-section {
      padding: 100px 0 80px;
      background: linear-gradient(135deg, #0f0720 0%, #1a0a38 50%, #0d1530 100%);
      position: relative;
      overflow: hidden;
    }

    .abt-section::before {
      content: '';
      position: absolute;
      top: -120px;
      right: -120px;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(81, 7, 206, .18) 0%, transparent 70%);
      pointer-events: none;
    }

    .abt-section::after {
      content: '';
      position: absolute;
      bottom: -80px;
      left: -80px;
      width: 400px;
      height: 400px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(14, 165, 233, .08) 0%, transparent 70%);
      pointer-events: none;
    }

    .abt-header {
      text-align: center;
      margin-bottom: 64px;
      position: relative;
      z-index: 1;
    }

    .abt-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255, 255, 255, .08);
      color: #c4b5fd;
      font-size: .72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .09em;
      padding: 6px 16px;
      border-radius: 50px;
      margin-bottom: 18px;
      border: 1px solid rgba(255, 255, 255, .12);
    }

    .abt-heading {
      font-size: 2.6rem;
      font-weight: 800;
      color: #fff;
      line-height: 1.15;
      margin: 0;
    }

    .abt-heading em {
      font-style: normal;
      background: linear-gradient(90deg, #a78bfa, #c084fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Vision / Mission */
    .abt-top-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: center;
      margin-bottom: 80px;
      position: relative;
      z-index: 1;
    }

    .abt-vm-stack {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .abt-vm-card {
      display: flex;
      gap: 20px;
      align-items: flex-start;
      background: rgba(255, 255, 255, .05);
      border-radius: 18px;
      padding: 28px;
      border: 1px solid rgba(255, 255, 255, .09);
      backdrop-filter: blur(8px);
      transition: background .3s, transform .3s;
    }

    .abt-vm-card:hover {
      background: rgba(255, 255, 255, .08);
      transform: translateY(-3px);
    }

    .abt-vm-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      flex-shrink: 0;
    }

    .abt-vision .abt-vm-icon {
      background: rgba(167, 139, 250, .15);
      color: #a78bfa;
    }

    .abt-mission .abt-vm-icon {
      background: rgba(245, 158, 11, .12);
      color: #fbbf24;
    }

    .abt-vm-label {
      font-size: .72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: rgba(255, 255, 255, .35);
      margin: 0 0 6px;
    }

    .abt-vm-text {
      font-size: .95rem;
      color: rgba(255, 255, 255, .72);
      line-height: 1.7;
      margin: 0;
    }

    /* Photo side */
    .abt-photos-wrap {
      position: relative;
      padding-bottom: 18px;
    }

    .abt-photos-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 200px 200px;
      gap: 12px;
    }

    .abt-photo {
      overflow: hidden;
      border-radius: 14px;
      position: relative;
    }

    .abt-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform .5s ease;
      display: block;
    }

    .abt-photo:hover img {
      transform: scale(1.07);
    }

    .abt-photo-tall {
      grid-row: span 2;
    }

    .abt-photos-badge {
      position: absolute;
      bottom: 0;
      right: 20px;
      background: rgba(255, 255, 255, .08);
      border: 1px solid rgba(255, 255, 255, .15);
      backdrop-filter: blur(14px);
      border-radius: 14px;
      padding: 12px 20px;
      display: flex;
      align-items: center;
      gap: 10px;
      white-space: nowrap;
    }

    .abt-photos-badge-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: linear-gradient(135deg, #7c3aed, #4b08a1);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 1rem;
      flex-shrink: 0;
    }

    .abt-photos-badge-text {
      font-size: .78rem;
      color: rgba(255, 255, 255, .6);
    }

    .abt-photos-badge-text strong {
      display: block;
      font-size: .9rem;
      color: #fff;
      font-weight: 800;
    }

    /* Values */
    .abt-values-header {
      text-align: center;
      margin-bottom: 36px;
      position: relative;
      z-index: 1;
    }

    .abt-values-eyebrow {
      font-size: .72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .09em;
      color: rgba(255, 255, 255, .3);
      margin-bottom: 8px;
    }

    .abt-values-title {
      font-size: 1.9rem;
      font-weight: 800;
      color: #fff;
      margin: 0;
    }

    .abt-values-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      position: relative;
      z-index: 1;
    }

    .abt-value-card {
      background: rgba(255, 255, 255, .05);
      border-radius: 18px;
      padding: 26px 22px;
      border: 1px solid rgba(255, 255, 255, .08);
      transition: transform .3s, background .3s;
    }

    .abt-value-card:hover {
      transform: translateY(-5px);
      background: rgba(255, 255, 255, .09);
    }

    .abt-val-icon {
      width: 48px;
      height: 48px;
      border-radius: 13px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      margin-bottom: 16px;
    }

    .abt-val-name {
      font-size: 1rem;
      font-weight: 800;
      color: #fff;
      margin: 0 0 8px;
    }

    .abt-val-desc {
      font-size: .85rem;
      color: rgba(255, 255, 255, .55);
      line-height: 1.65;
      margin: 0;
    }

    @media (max-width: 992px) {
      .abt-top-grid {
        grid-template-columns: 1fr;
        gap: 40px;
      }

      .abt-values-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .abt-heading {
        font-size: 2.1rem;
      }
    }

    @media (max-width: 600px) {
      .abt-section {
        padding: 70px 0 60px;
      }

      .abt-values-grid {
        grid-template-columns: 1fr;
      }

      .abt-photos-grid {
        grid-template-rows: 160px 160px;
      }
    }

    /* About Section Mouse Move Animation */
    .about-img-wrapper {
      position: relative;
      perspective: 1000px;
      transform-style: preserve-3d;
