                  <p class="card-text text-center anywhere">
                    Étudiez quand <br />
                    vous voulez 
                  </p>
                </div>
              </div>
            </div>
          </div>
          <div
            data-aos="zoom-in-up"
            data-aos-offset="200"
            data-aos-delay="100"
            data-aos-duration="1600"
            data-aos-easing="ease-in-out"
            data-aos-mirror="true"
            class="col-12 col-md-4 mb-5 rounded"
          >
            <div class="d-flex my-2 justify-content-center">
              <div class="card my-card" style="width: 18rem">
                <img
                  class="card-img-top"
                  style="height: 12rem"
                  src="https://images.pexels.com/photos/359989/pexels-photo-359989.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=750&w=1260"
                  alt="Card image cap"
                />
                <div
                  class="
                    card-body
                    border border-3 border-warning
                    bg-dark
                    d-flex
                    flex-column
                    align-items-center
                  "
                >
                  <p class="card-text text-center anywhere">
                    Étudiez à votre rythme
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- End Programmes section-->
