            function showImage(index) {
              // Wrap around
              if (index < 1) index = totalImages;
              if (index > totalImages) index = 1;

              currentIndex = index;

              // Uncheck all radios
              for (let i = 1; i <= totalImages; i++) {
                document.getElementById(`img${i}`).checked = false;
              }

              // Check the current radio
              document.getElementById(`img${currentIndex}`).checked = true;
            }

            function nextImage() {
              showImage(currentIndex + 1);
            }

            function prevImage() {
              showImage(currentIndex - 1);
            }

            function startAutoPlay() {
              stopAutoPlay(); // Clear any existing interval
              autoPlayInterval = setInterval(nextImage, 4000); // Change every 4 seconds
            }

            function stopAutoPlay() {
              if (autoPlayInterval) {
                clearInterval(autoPlayInterval);
              }
            }

            // Event listeners
            prevBtn.addEventListener('click', () => {
              prevImage();
              stopAutoPlay();
              startAutoPlay(); // Restart timer
            });

            nextBtn.addEventListener('click', () => {
              nextImage();
              stopAutoPlay();
              startAutoPlay(); // Restart timer
            });

            // Thumbnail click handling
            document.querySelectorAll('.thumbs label').forEach((label, index) => {
              label.addEventListener('click', () => {
                currentIndex = index + 1;
                stopAutoPlay();
                startAutoPlay(); // Restart timer
              });
            });

            // Start auto-play on load
            startAutoPlay();

            // Pause on hover
            const galleryContainer = document.querySelector('.gallery-container');
            galleryContainer.addEventListener('mouseenter', stopAutoPlay);
            galleryContainer.addEventListener('mouseleave', startAutoPlay);
          })();
        </script>


