<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Bootstrap Css -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.0/font/bootstrap-icons.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-BmbxuPwQa2lc/FVzBcNJ7UAyJxM6wuqIj61tLrc4wSX0szH/Ev+nYRRuWlolflfl"
      crossorigin="anonymous"
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
    <link href="/stylesheets/landingpage.css" rel="stylesheet" />
    <script src="https://kit.fontawesome.com/9ecb022092.js"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Akronim&family=Great+Vibes&family=Kaushan+Script&family=Marck+Script&family=Markazi+Text&family=Nosifer&family=Sigmar+One&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Chango&family=Fondamento&family=Kaushan+Script&family=Merriweather:wght@900&family=Ultra&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <script type="text/javascript" src="/javascripts/warpspeed.js"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Noto+Sans:wght@400;700&family=Vollkorn&display=swap"
      rel="stylesheet"
    />
    <title>Afro house of Knowledge</title>
  </head>

  <body>
    <!--Navbar-->
    <nav
      class="navbar navbar-expand-lg py-1 navbar-light bg-light p-0 sticky-top"
    >
      <div class="container-fluid">
        <a class="navbar-brand" id="brand-name" href="/">
          <!-- <img src="../images/logo_Afrohk.jpeg" alt="" width="50" height="50"> -->
          <span class="afro">Afro</span><span class="hk">HK</span>
        </a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNavAltMarkup"
          aria-controls="navbarNavAltMarkup"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
          <div class="navbar-nav">
            <!-- <a class="nav-link active" aria-current="page" href="/">Acceuil</a>
                        -->
            <li class="nav-item dropdown">
              <a
                class="nav-link dropdown-toggle"
                href="#"
                id="navbarDropdown"
                role="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
              >
                NOS PROGRAMMES
              </a>
              <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                <li><a class="dropdown-item" href="/100bac">100 % BAC</a></li>
                <li>
                  <a class="dropdown-item" href="/englishlang4all"
                    >English for all</a
                  >
                </li>
                <!-- <li>
                  <a class="dropdown-item" href="/xpaxetudiant"
                    >XPAX Etudiant</a
                  >
                </li> -->
                <li>
                  <hr
                    class="dropdown-divider"
                    style="color: #f8f5f4; height: 2px"
                  />
                </li>
                <!-- <li>
                  <a class="dropdown-item" href="/courses">Voir nos Cours</a>
                </li> -->

                <li>
                  <hr
                    class="dropdown-divider"
                    style="color: #f8f5f4; height: 3px"
                  />
                </li>
                <li>
                  <a class="dropdown-item" href="#footer">Contacts</a>
                </li>
              </ul>
            </li>
          </div>
          <div class="navbar-nav ms-auto">
            <% if (!currentUser) {%>
            <a class="nav-link btn btn-outline-success my-2 mx-2" href="/login"
              >Connexion</a
            >
            <a class="nav-link btn btn-outline-info mx-2 my-2" href="/register"
              >Inscription</a
            >
            <%} else { %>
            <h3 id="user" class="px-3 align-self-center">
              <a class="profile-link" href="/user/<%= currentUser._id %> ">
                <i class="bi bi-person-circle"></i> Welcome
                <%=currentUser.username%>
              </a>
            </h3>
            <a class="nav-link px-2 my-2 btn btn-outline-danger" href="/logout"
              >Deconnexion</a
            >
            <%}%>
          </div>
        </div>
      </div>
    </nav>

    <!--End Navbar-->
    <div id="sky-wrapper">
      <div
        style="
          position: absolute;
          z-index: 1;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
        "
      >
        <canvas id="canvas" style="width: 100%; height: 100%"></canvas>
        <script>
          new WarpSpeed("canvas");
        </script>
      </div>
      <div id="banner-wrapper">
        <div class="container flash mt-2"><%-include('./partials/flash')%></div>

        <div
          id="banner"
          data-aos="zoom-in-down"
          data-aos-offset="200"
          data-aos-delay="150"
          data-aos-duration="3000"
          data-aos-easing="ease-in-out"
          data-aos-mirror="true"

        >
          <h1  class="header-text">Afro House of Knowledge</h1>
          <p class="motto">
            Empower the young generation with <br />
            valuable skills
          </p>
          <div data-aos="zoom-in-right"
          data-aos-offset="200"
          data-aos-delay="1000"
          data-aos-duration="1000"
          data-aos-easing="ease-in-out"
          data-aos-mirror="true" class="account-wrapper">
            <% if (!currentUser || currentUser === undefined) {%>
            <a class="get-account" href="/register"
              >Obtenez gratuitement un compte</a
            >
  
            <%} else { %>
            <a class="get-account" href="#programs">
              Bienvenue dans l'univers du savoir</a
            >
            <%}%>
          </div>
        </div>
        
      </div>
    </div>
    <main id="site-content" class="container">
      <!--Programmes section-->
      <div class="program-section-wrapper">
        <h1 id="programs" class="text-center py-4">Nos Programmes Educatifs</h1>
        <div class="container program-section-wrapper my-5">
          <div class="row mt-3">
            <!-- Operation 100% BAC-->
            <div
              data-aos="fade-up"
              data-aos-offset="200"
              data-aos-delay="50"
              data-aos-duration="1200"
              data-aos-easing="ease-in-out"
              data-aos-mirror="true"
              class="col-12 col-md-6 mb-5 rounded"
            >
              <div class="d-flex mt- mb-2 justify-content-center">
                <div class="card my-card" style="width: 18rem">
                  <img
                    class="card-img-top"
                    style="height: 13rem"
                    src="https://images.pexels.com/photos/6140707/pexels-photo-6140707.jpeg?auto=compress&cs=tinysrgb&dpr=2&w=500"
                    alt="Card image cap"
                  />
                  <div class="card-body d-flex flex-column align-items-center">
                    <p class="card-text text-center">
                      A l'aide des videos, approfondissez votre comprehension du
                      cours, exercez vous afin de bien assimiler les notions
                      importantes.
                    </p>
                    <button
                      class="btn mt-1 course-btn btn-default btn-outline-dark"
                      data-bs-toggle="offcanvas"
                      data-bs-target="#offcanvas100BAC"
                      aria-controls="offcanvas100BAC"
                    >
                      <a href="/100bac" class="course-link"
                        >OPERATION 100% REUSSITE AU BAC</a
                      >
                    </button>
                  </div>
                </div>
              </div>
            </div>
          
            <!-- English for all-->
            <div
              data-aos="fade-down"
              data-aos-offset="200"
              data-aos-delay="150"
              data-aos-duration="1200"
              data-aos-easing="ease-in-out"
              data-aos-mirror="true"
              class="col-12 col-md-6 mb-5 rounded"
            >
              <div class="d-flex my-2 justify-content-center">
                <div class="card my-card" style="width: 18rem">
                  <img
                    class="card-img-top"
                    style="height: 13rem"
                    src="https://upload.wikimedia.org/wikipedia/commons/thumb/0/0b/English_language.svg/1280px-English_language.svg.png"
                    alt="Card image cap"
                  />
                  <div id="card-content" class="card-body d-flex flex-column align-items-center">
                    <p class="card-text text-center">
                      Améliorer votre niveau d'anglais a partir d'un programme
                      bien elaboré. Apprenez juste ce qu'il vous faut pour être
                      operationnel dans votre domaine d'activité.
                    </p>
                    <button
                      class="btn mt-1 course-btn btn-default btn-outline-dark"
                      data-bs-toggle="offcanvas"
                      data-bs-target="#offcanvas100BAC"
                      aria-controls="offcanvas100BAC"
                    >
                      <a href="/englishlang4all" class="course-link"
                        >House of English Lovers</a>
                    </button>
                  </div>
                </div>
              </div>
            </div>
  
            <!-- Xpax etudiant-->
            <!-- <div
              data-aos="flip-down"
              data-aos-offset="200"
              data-aos-delay="100"
