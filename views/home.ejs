        <!-- About Section Mouse Move Animation -->
        <script>
          document.addEventListener('DOMContentLoaded', function () {
            const aboutSection = document.querySelector('#about');
            const gallery = aboutSection?.querySelector('.gallery');
            const images = gallery?.querySelectorAll('img');

            if (!gallery || !images || images.length === 0) return;

            const aboutWrapper = aboutSection.querySelector('.about-img-wrapper');
            if (!aboutWrapper) return;

            aboutWrapper.addEventListener('mousemove', function (e) {
              const rect = aboutWrapper.getBoundingClientRect();
              const x = e.clientX - rect.left;
              const y = e.clientY - rect.top;

              // Calculate center point
              const centerX = rect.width / 2;
              const centerY = rect.height / 2;

              // Calculate offset from center (normalized to -1 to 1)
              const offsetX = (x - centerX) / centerX;
              const offsetY = (y - centerY) / centerY;

              // Maximum rotation in degrees
              const maxRotate = 15;
              const maxTranslate = 20;

              // Apply 3D rotation to gallery
              const rotateY = offsetX * maxRotate;
              const rotateX = -offsetY * maxRotate;
              gallery.style.transform = `perspective(1000px) rotateY(${rotateY}deg) rotateX(${rotateX}deg)`;

              // Apply individual transformations to images for parallax effect
              images.forEach((img, index) => {
                const intensity = (index + 1) * 0.3; // Different intensity for each image
                const translateX = offsetX * maxTranslate * intensity;
                const translateY = offsetY * maxTranslate * intensity;
                const scale = 1 + (Math.abs(offsetX) + Math.abs(offsetY)) * 0.05 * intensity;

                img.style.transform = `translate3d(${translateX}px, ${translateY}px, 0) scale(${scale})`;
              });
            });

            aboutWrapper.addEventListener('mouseleave', function () {
              // Reset all transforms when mouse leaves
              gallery.style.transform = 'perspective(1000px) rotateY(0deg) rotateX(0deg)';
              images.forEach(img => {
                img.style.transform = 'translate3d(0, 0, 0) scale(1)';
              });
            });
          });
        </script>
