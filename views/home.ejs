<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Bootstrap Css -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.0/font/bootstrap-icons.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-BmbxuPwQa2lc/FVzBcNJ7UAyJxM6wuqIj61tLrc4wSX0szH/Ev+nYRRuWlolflfl"
      crossorigin="anonymous"
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
    <link href="/stylesheets/landingpage.css" rel="stylesheet" />
    <script src="https://kit.fontawesome.com/9ecb022092.js"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Akronim&family=Great+Vibes&family=Kaushan+Script&family=Marck+Script&family=Markazi+Text&family=Nosifer&family=Sigmar+One&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Chango&family=Fondamento&family=Kaushan+Script&family=Merriweather:wght@900&family=Ultra&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <script type="text/javascript" src="/javascripts/warpspeed.js"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Noto+Sans:wght@400;700&family=Vollkorn&display=swap"
      rel="stylesheet"
    />
    <title>Afro house of Knowledge</title>
  </head>

  <body>
    <!--Navbar-->
    <nav
      class="navbar navbar-expand-lg py-1 navbar-light bg-light p-0 sticky-top"
    >
      <div class="container-fluid">
        <a class="navbar-brand" id="brand-name" href="/">
          <!-- <img src="../images/logo_Afrohk.jpeg" alt="" width="50" height="50"> -->
          <span class="afro">Afro</span><span class="hk">HK</span>
        </a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNavAltMarkup"
          aria-controls="navbarNavAltMarkup"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
          <div class="navbar-nav">
            <!-- <a class="nav-link active" aria-current="page" href="/">Acceuil</a>
                        -->
            <li class="nav-item dropdown">
              <a
                class="nav-link dropdown-toggle"
                href="#"
                id="navbarDropdown"
                role="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
              >
                NOS PROGRAMMES
              </a>
              <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                <li><a class="dropdown-item" href="/100bac">100 % BAC</a></li>
                <li>
                  <a class="dropdown-item" href="/englishlang4all"
                    >English for all</a
                  >
                </li>
                <li>
                  <a class="dropdown-item" href="/xpaxetudiant"
                    >XPAX Etudiant</a
                  >
                </li>
                <li>
                  <hr
                    class="dropdown-divider"
                    style="color: #f8f5f4; height: 2px"
                  />
                </li>
                <!-- <li>
                  <a class="dropdown-item" href="/courses">Voir nos Cours</a>
                </li> -->

                <li>
                  <hr
                    class="dropdown-divider"
                    style="color: #f8f5f4; height: 3px"
                  />
                </li>
                <li>
                  <a class="dropdown-item" href="#footer">Nous Contacter</a>
                </li>
              </ul>
            </li>
          </div>
          <div class="navbar-nav ms-auto">
            <% if (!currentUser) {%>
            <a class="nav-link btn btn-outline-success my-2 mx-2" href="/login"
              >Connexion</a
            >
            <a class="nav-link btn btn-outline-info mx-2 my-2" href="/register"
              >Inscription</a
            >
            <%} else { %>
            <h3 id="user" class="px-3 align-self-center">
              <a class="profile-link" href="/user/<%= currentUser._id %> ">
                <i class="bi bi-person-circle"></i> Welcome
                <%=currentUser.username%>
              </a>
            </h3>
            <a class="nav-link px-2 my-2 btn btn-outline-danger" href="/logout"
              >Deconnexion</a
            >
            <%}%>
          </div>
        </div>
      </div>
    </nav>

    <!--End Navbar-->
    <div id="sky-wrapper">
      <div
        style="
          position: absolute;
          z-index: 1;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
        "
      >
        <canvas id="canvas" style="width: 100%; height: 100%"></canvas>
        <script>
          new WarpSpeed("canvas");
        </script>
      </div>
      <div id="banner-wrapper">
        <div class="container flash mt-2"><%-include('./partials/flash')%></div>

        <div
          id="banner"
          style="
            font-size: 3vw;
            color: #ffffff;
            font-weight: 100;
            text-align: center;
            margin-top: 5rem;
          "
        >
          <h1 class="header-text">Afro House of Knowledge</h1>
          <p class="motto">
            Empower the young generation with <br />
            valuable skills
          </p>
        </div>
        <div class="account-wrapper">
          <% if (!currentUser) {%>
          <a class="get-account" href="/register"
            >Obtenez gratuitement un compte</a
          >

          <%} else { %>
          <a class="get-account" href="#programs">
            Bienvenue dans l'univers du savoir</a
          >
          <%}%>
        </div>
      </div>
    </div>
    <main id="site-content" class="container mt-3">
      <!--Programmes section-->
      <h1 id="programs" class="text-center py-4">Nos Programmes Educatifs</h1>
      <div class="container my-5">
        <div class="row mt-3">
          <div
            data-aos="fade-up-right"
            data-aos-offset="200"
            data-aos-delay="50"
            data-aos-duration="1200"
            data-aos-easing="ease-in-out"
            data-aos-mirror="true"
            class="col-12 col-md-4 mb-5 rounded"
          >
            <div class="d-flex mt- mb-2 justify-content-center">
              <div class="card my-card" style="width: 18rem">
                <img
                  class="card-img-top"
                  style="height: 18rem"
                  src="https://images.pexels.com/photos/3118214/pexels-photo-3118214.jpeg?auto=compress&cs=tinysrgb&dpr=2&w=500"
                  alt="Card image cap"
                />
                <div class="card-body d-flex flex-column align-items-center">
                  <p class="card-text text-center">
                    A l'aide des videos, approfondissez votre comprehension du
                    cours, exercez vous afin de bien assimiler les notions
                    importantes.
                  </p>
                  <button
                    class="btn mt-1 course-btn btn-default btn-outline-dark"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#offcanvas100BAC"
                    aria-controls="offcanvas100BAC"
                  >
                    <a href="/100bac" class="course-link"
                      >OPERATION 100% REUSSITE AU BAC</a
                    >
                  </button>
                </div>
              </div>
            </div>
          </div>
          <div
            data-aos="flip-right"
            data-aos-offset="200"
            data-aos-delay="150"
            data-aos-duration="1200"
            data-aos-easing="ease-in-out"
            data-aos-mirror="true"
            class="col-12 col-md-4 mb-5 rounded"
          >
            <div class="d-flex my-2 justify-content-center">
              <div class="card my-card" style="width: 18rem">
                <img
                  class="card-img-top"
                  style="height: 18rem"
                  src="https://images.pexels.com/photos/4126126/pexels-photo-4126126.jpeg?auto=compress&cs=tinysrgb&dpr=2&w=500"
                  alt="Card image cap"
                />
                <div class="card-body d-flex flex-column align-items-center">
                  <p class="card-text text-center">
                    Améliorer votre niveau d'anglais a partir d'un programme
                    bien elaboré. Apprenez juste ce qu'il vous faut pour être
                    operationnel dans votre domaine d'activité.
                  </p>
                  <button
                    class="btn mt-1 course-btn btn-default btn-outline-dark"
                  >
                    <a href="/englishlang4all" class="course-link"
                      >House of English Lovers</a
                    >
                  </button>
                </div>
              </div>
            </div>
          </div>
          <div
            data-aos="flip-down"
            data-aos-offset="200"
            data-aos-delay="100"
            data-aos-duration="1500"
            data-aos-easing="ease-in-out"
            data-aos-mirror="true"
            class="col-12 col-md-4 mb-5 rounded"
          >
            <div class="d-flex my-2 justify-content-center">
              <div class="card my-card" style="width: 18rem">
                <img
                  class="card-img-top"
                  style="height: 18rem"
                  src="https://images.pexels.com/photos/267885/pexels-photo-267885.jpeg?auto=compress&cs=tinysrgb&dpr=2&w=500"
                  alt="Card image cap"
                />
                <div class="card-body d-flex flex-column align-items-center">
                  <p class="card-text text-center">
                    Le programme pour une meilleure experience universitaire.
                    Choix de filière, des formations gratuites, des conseils et
                    astuces...
                  </p>
                  <button
                    class="btn mt-1 course-btn btn-default btn-outline-dark"
                  >
                    <a href="/xpaxetudiant" class="course-link px-2"
                      >XPAX ETUDIANT</a
                    >
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- End Programmes section-->
      </div>
      <!--SECTION 2 Why learn with us-->
      <div
        class="learn-with-us"
        data-aos="flip-up"
        data-aos-duration="2800"
        data-aos-delay="150"
      >
        <h3 class="">Do you know why learning with us is fun ?</h3>
      </div>
      <div class="container my-5">
        <div class="row mt-3">
          <div
            data-aos="fade-up-right"
            data-aos-offset="200"
            data-aos-delay="50"
            data-aos-duration="2000"
            data-aos-easing="ease-in-out"
            data-aos-mirror="true"
            class="col-12 col-md-4 mb-5 rounded"
          >
            <div class="d-flex mt- mb-2 justify-content-center">
              <div class="card my-card" style="width: 18rem">
                <img
                  class="card-img-top"
                  style="height: 18rem"
                  src="https://images.pexels.com/photos/4050334/pexels-photo-4050334.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=750&w=1260"
                  alt="Card image cap"
                />
                <div
                  class="
                    card-body
                    border border-info border-3
                    bg-dark
                    d-flex
                    flex-column
                    align-items-center
                  "
                >
                  <p class="card-text text-center anywhere">
                    Learn <br />
                    Anywhere
                  </p>
                </div>
              </div>
            </div>
          </div>
          <div
            data-aos="flip-up"
            data-aos-offset="200"
            data-aos-delay="150"
            data-aos-duration="1200"
            data-aos-easing="ease-in-out"
            data-aos-mirror="true"
            class="col-12 col-md-4 mb-5 rounded"
          >
            <div class="d-flex my-2 justify-content-center">
              <div class="card my-card" style="width: 18rem">
                <img
                  class="card-img-top"
                  style="height: 18rem"
                  src="https://images.pexels.com/photos/4384147/pexels-photo-4384147.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=750&w=1260"
                  alt="Card image cap"
                />
                <div
                  class="
                    card-body
                    bg-dark
                    border border-3 border-secondary
                    d-flex
                    flex-column
                    align-items-center
                  "
                >
                  <p class="card-text text-center anywhere">
                    Learn <br />
                    Anytime
                  </p>
                </div>
              </div>
            </div>
          </div>
          <div
            data-aos="zoom-in"
            data-aos-offset="200"
            data-aos-delay="100"
            data-aos-duration="1800"
            data-aos-easing="ease-in-out"
            data-aos-mirror="true"
            class="col-12 col-md-4 mb-5 rounded"
          >
            <div class="d-flex my-2 justify-content-center">
              <div class="card my-card" style="width: 18rem">
                <img
                  class="card-img-top"
                  style="height: 18rem"
                  src="https://images.pexels.com/photos/359989/pexels-photo-359989.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=750&w=1260"
                  alt="Card image cap"
                />
                <div
                  class="
                    card-body
                    border border-3 border-warning
                    bg-dark
                    d-flex
                    flex-column
                    align-items-center
                  "
                >
                  <p class="card-text text-center anywhere">
                    Learn At your own Pace
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- End Programmes section-->
      </div>

      <!-- TESTIMONIALS -->
      <div
        class="about-us"
        data-aos="flip-up"
        data-aos-duration="2800"
        data-aos-delay="150"
      >
        <!-- <h3 class="about-us-heading">Ce que les clients pensent de nous</h3> -->
      </div>
      <section class="testimonial mb-5 text-center">
