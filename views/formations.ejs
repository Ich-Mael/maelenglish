<% layout('layouts/main') %>

<% headContent = `<style>
  .catalog-hero {
    margin-top: 70px;
    padding: 56px 0 40px;
    background: linear-gradient(135deg, #2d0370 0%, #5107ce 60%, #3b0fa8 100%);
    color: #fff;
  }
  .catalog-hero h1 { font-size: 2.4rem; font-weight: 800; margin-bottom: 10px; line-height: 1.2; }
  .catalog-hero p  { font-size: 1.05rem; color: rgba(255,255,255,.8); margin-bottom: 28px; max-width: 560px; }

  .search-bar-wrap {
    display: flex;
    gap: 10px;
    max-width: 600px;
  }
  .search-bar-wrap input {
    flex: 1;
    padding: 12px 20px;
    border: none;
    border-radius: 12px;
    font-size: .95rem;
    outline: none;
    box-shadow: 0 2px 12px rgba(0,0,0,.15);
  }
  .search-bar-wrap input::placeholder { color: #94a3b8; }
  .search-bar-wrap button {
    padding: 12px 22px;
    background: #f59e0b;
    color: #fff;
    border: none;
    border-radius: 12px;
    font-weight: 700;
    font-size: .95rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background .2s;
  }
  .search-bar-wrap button:hover { background: #d97706; }

  .catalog-body { padding: 48px 0 80px; background: #f8fafc; min-height: 60vh; }

  .filter-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }
  .filter-label { font-size: .82rem; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: .05em; }
  .filter-pill {
    padding: 6px 16px;
    border-radius: 50px;
    border: 1.5px solid #e2e8f0;
    background: #fff;
    font-size: .83rem;
    font-weight: 600;
    color: #374151;
    cursor: pointer;
    transition: all .2s;
    white-space: nowrap;
  }
  .filter-pill:hover, .filter-pill.active {
    border-color: #5107ce;
    background: #5107ce;
    color: #fff;
  }

  .results-meta {
    font-size: .85rem;
    color: #6b7280;
    margin-bottom: 24px;
  }
  .results-meta strong { color: #1e293b; }

  .courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
  }

  .course-card {
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 2px 14px rgba(0,0,0,.07);
    display: flex;
    flex-direction: column;
    transition: transform .25s, box-shadow .25s;
  }
  .course-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 32px rgba(0,0,0,.13);
  }
  .course-thumb {
    position: relative;
    height: 175px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .course-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .course-thumb-icon {
    font-size: 3rem;
    opacity: .35;
    color: #fff;
    position: relative;
    z-index: 1;
  }
  .course-thumb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(0,0,0,.4) 100%);
  }
  .course-body {
    padding: 1.25rem 1.3rem 1.4rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: .55rem;
  }
  .course-inst-row {
    display: flex;
    align-items: center;
    gap: .5rem;
  }
  .inst-logo-sm {
    width: 24px; height: 24px;
    border-radius: 6px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .inst-logo-sm-fallback {
    width: 24px; height: 24px;
    border-radius: 6px;
    color: #fff;
    font-size: .62rem;
    font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .inst-name-sm {
    font-size: .75rem;
    font-weight: 600;
    color: #64748b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .course-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1e293b;
    margin: 0;
    line-height: 1.35;
  }
  .course-desc {
    font-size: .83rem;
    color: #64748b;
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }
  .course-meta-row {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: .75rem;
    color: #94a3b8;
    margin-top: .2rem;
  }
  .course-meta-row span {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .course-divider {
    border: none;
    border-top: 1px solid #f1f5f9;
    margin: .4rem 0 0;
  }
  .enroll-info {
    padding: 0 1.3rem 1.3rem;
  }
  .enroll-info-heading {
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: #94a3b8;
    margin-bottom: 8px;
  }
  .enroll-info-rows { display: flex; flex-direction: column; gap: 5px; }
  .enroll-info-row {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: .8rem;
    color: #475569;
  }
  .enroll-info-row i { color: #5107ce; font-size: .85rem; flex-shrink: 0; }
  .enroll-info-row a { color: #5107ce; text-decoration: none; }
  .enroll-info-row a:hover { text-decoration: underline; }

  .empty-state {
    text-align: center;
    padding: 5rem 2rem;
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 2px 12px rgba(0,0,0,.06);
    grid-column: 1 / -1;
  }
  .empty-state i { font-size: 3.5rem; color: #cbd5e1; display: block; margin-bottom: 1rem; }

  @media (max-width: 600px) {
    .catalog-hero h1 { font-size: 1.8rem; }
    .search-bar-wrap { flex-direction: column; }
    .search-bar-wrap button { width: 100%; }
  }
</style>` %>

<!-- Hero -->
<section class="catalog-hero">
  <div class="container">
    <h1><i class="bi bi-buildings me-2"></i>Formations Institutionnelles</h1>
    <p>Parcourez les cours disponibles dans nos institutions partenaires et découvrez comment vous inscrire.</p>
    <div class="search-bar-wrap">
      <input type="text" id="searchInput" placeholder="Rechercher par titre, institution, description…" autocomplete="off">
      <button type="button" onclick="runSearch()"><i class="bi bi-search me-1"></i> Rechercher</button>
    </div>
  </div>
</section>

<!-- Catalog body -->
<section class="catalog-body">
  <div class="container">

    <%
      const allInstitutions = [];
      const seenIds = new Set();
      courses.forEach(c => {
        const inst = c.institutionId;
        if (inst && !seenIds.has(String(inst._id))) {
          seenIds.add(String(inst._id));
          allInstitutions.push(inst);
        }
      });
    %>

    <!-- Institution filter pills -->
    <% if (allInstitutions.length > 1) { %>
    <div class="filter-bar">
      <span class="filter-label">Filtrer :</span>
      <button class="filter-pill active" data-inst="">Toutes les institutions</button>
      <% allInstitutions.forEach(inst => { %>
        <button class="filter-pill" data-inst="<%= String(inst._id) %>"><%= inst.name %></button>
      <% }) %>
    </div>
    <% } %>

    <p class="results-meta"><strong id="resultCount"><%= courses.length %></strong> cours disponible<%= courses.length !== 1 ? 's' : '' %></p>

    <% if (courses.length === 0) { %>
      <div class="courses-grid">
        <div class="empty-state">
          <i class="bi bi-journal-bookmark"></i>
          <h3 style="font-weight:700;color:#1e293b;">Aucun cours disponible pour le moment</h3>
          <p style="color:#64748b;max-width:420px;margin:.5rem auto 0;">Revenez bientôt — de nouvelles formations sont en cours de préparation par nos institutions partenaires.</p>
        </div>
      </div>
    <% } else { %>
    <div class="courses-grid" id="coursesGrid">
      <% courses.forEach(course => {
        const inst = course.institutionId;
        const brand = (inst && inst.primaryColor) ? inst.primaryColor : '#5107ce';
        const initials = inst ? inst.name.substring(0,2).toUpperCase() : 'IN';
        const instId = inst ? String(inst._id) : '';
        const moduleCount = (course.modules || []).length;
      %>
      <div class="course-card" data-inst="<%= instId %>"
           data-search="<%= [course.title, course.description, inst ? inst.name : ''].join(' ').toLowerCase() %>">
        <div class="course-thumb" style="background: linear-gradient(135deg, <%= brand %>, color-mix(in srgb, <%= brand %> 60%, #000));">
          <% if (course.imageUrl) { %>
            <img loading="lazy" src="<%= course.imageUrl %>" alt="<%= course.title %>">
          <% } else { %>
            <i class="bi bi-book-half course-thumb-icon"></i>
          <% } %>
          <div class="course-thumb-overlay"></div>
        </div>

        <div class="course-body">
          <div class="course-inst-row">
            <% if (inst && inst.logoUrl) { %>
              <img src="<%= inst.logoUrl %>" alt="<%= inst.name %>" class="inst-logo-sm">
            <% } else { %>
              <div class="inst-logo-sm-fallback" style="background:<%= brand %>;"><%= initials %></div>
            <% } %>
            <span class="inst-name-sm"><%= inst ? inst.name : 'Institution' %></span>
          </div>
          <h5 class="course-title"><%= course.title %></h5>
          <% if (course.description) { %>
            <p class="course-desc"><%= course.description.substring(0, 110) %><%= course.description.length > 110 ? '…' : '' %></p>
          <% } %>
          <div class="course-meta-row">
            <span><i class="bi bi-grid-3x3-gap-fill"></i> <%= moduleCount %> module<%= moduleCount !== 1 ? 's' : '' %></span>
            <% if (inst && (inst.city || inst.country)) { %>
              <span><i class="bi bi-geo-alt-fill"></i> <%= [inst.city, inst.country].filter(Boolean).join(', ') %></span>
            <% } %>
          </div>
        </div>

        <% if (inst && (inst.contactEmail || inst.phone)) { %>
        <hr class="course-divider">
        <div class="enroll-info">
          <p class="enroll-info-heading">Comment s'inscrire</p>
          <div class="enroll-info-rows">
            <% if (inst.contactEmail) { %>
              <div class="enroll-info-row">
                <i class="bi bi-envelope-fill"></i>
                <a href="mailto:<%= inst.contactEmail %>"><%= inst.contactEmail %></a>
              </div>
            <% } %>
            <% if (inst.phone) { %>
              <div class="enroll-info-row">
                <i class="bi bi-telephone-fill"></i>
                <span><%= inst.phone %></span>
              </div>
            <% } %>
          </div>
        </div>
        <% } %>
      </div>
      <% }) %>
    </div>
    <% } %>

  </div>
</section>

<% scripts = `<script>
(function () {
  const grid = document.getElementById('coursesGrid');
  if (!grid) return;

  const cards = Array.from(grid.querySelectorAll('.course-card'));
  const countEl = document.getElementById('resultCount');
  const searchInput = document.getElementById('searchInput');
  const filterPills = document.querySelectorAll('.filter-pill');

  let activeInst = '';
  let searchQuery = '';

  function applyFilters() {
    let visible = 0;
    cards.forEach(card => {
      const matchInst = !activeInst || card.dataset.inst === activeInst;
      const matchSearch = !searchQuery || card.dataset.search.includes(searchQuery);
      const show = matchInst && matchSearch;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    countEl.textContent = visible;
  }

  filterPills.forEach(pill => {
    pill.addEventListener('click', function () {
      filterPills.forEach(p => p.classList.remove('active'));
      this.classList.add('active');
      activeInst = this.dataset.inst;
      applyFilters();
    });
  });

  searchInput.addEventListener('input', function () {
    searchQuery = this.value.trim().toLowerCase();
    applyFilters();
  });

  searchInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') applyFilters();
  });

  window.runSearch = function () {
    searchQuery = searchInput.value.trim().toLowerCase();
    applyFilters();
  };
})();
</script>` %>
