<% layout('layouts/main') %>

<% headContent = `<style>
  .catalog-hero {
    margin-top: 70px;
    padding: 56px 0 40px;
    background: linear-gradient(135deg, #2d0370 0%, #5107ce 60%, #3b0fa8 100%);
    color: #fff;
  }
  .catalog-hero h1 { font-size: 2.4rem; font-weight: 800; margin-bottom: 10px; line-height: 1.2; }
  .catalog-hero p  { font-size: 1.05rem; color: rgba(255,255,255,.8); margin-bottom: 28px; max-width: 560px; }

  .search-bar-wrap {
    display: flex;
    gap: 10px;
    max-width: 600px;
  }
  .search-bar-wrap input {
    flex: 1;
    padding: 12px 20px;
    border: none;
    border-radius: 12px;
    font-size: .95rem;
    outline: none;
    box-shadow: 0 2px 12px rgba(0,0,0,.15);
  }
  .search-bar-wrap input::placeholder { color: #94a3b8; }
  .search-bar-wrap button {
    padding: 12px 22px;
    background: #1e293b;
    color: #fff;
    border: none;
    border-radius: 12px;
    font-weight: 700;
    font-size: .95rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background .2s;
  }
  .search-bar-wrap button:hover { background: #0f172a; }

  .catalog-body { padding: 48px 0 80px; background: #f8fafc; min-height: 60vh; }

  .filter-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }
  .filter-label { font-size: .82rem; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: .05em; }
  .filter-pill {
    padding: 6px 16px;
    border-radius: 50px;
    border: 1.5px solid #e2e8f0;
    background: #fff;
    font-size: .83rem;
    font-weight: 600;
    color: #374151;
    cursor: pointer;
    transition: all .2s;
    white-space: nowrap;
  }
  .filter-pill:hover, .filter-pill.active {
    border-color: #5107ce;
    background: #5107ce;
    color: #fff;
  }
  .category-badge {
    display: inline-block;
    font-size: .7rem;
    font-weight: 700;
    padding: .2rem .6rem;
    border-radius: 20px;
    background: #ede9fe;
    color: #5107ce;
    white-space: nowrap;
    align-self: flex-start;
  }

  .results-meta {
    font-size: .85rem;
    color: #6b7280;
    margin-bottom: 24px;
  }
  .results-meta strong { color: #1e293b; }

  .courses-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 992px) { .courses-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px)  { .courses-grid { grid-template-columns: 1fr; } }

  .course-card {
    background: #fff;
    border-radius: 18px;
    overflow: visible;
    box-shadow: 0 2px 14px rgba(0,0,0,.07);
    display: flex;
    flex-direction: column;
    transition: transform .25s, box-shadow .25s;
  }
  .course-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 32px rgba(0,0,0,.13);
  }
  /* Description tooltip */
  .course-desc-wrap {
    position: relative;
    flex: 1;
    overflow: visible;
  }
  .course-desc {
    font-size: .83rem;
    color: #64748b;
    line-height: 1.55;
    margin: 0;
    cursor: default;
  }
  .desc-tooltip {
    display: none;
    position: absolute;
    bottom: calc(100% + 8px);
    left: 0; right: 0;
    background: #1e293b;
    color: #e2e8f0;
    font-size: .8rem;
    line-height: 1.6;
    padding: .85rem 1rem;
    border-radius: 10px;
    box-shadow: 0 8px 28px rgba(0,0,0,.25);
    z-index: 100;
    pointer-events: none;
  }
  .desc-tooltip::after {
    content: '';
    position: absolute;
    top: 100%; left: 20px;
    border: 6px solid transparent;
    border-top-color: #1e293b;
  }
  .course-desc-wrap:hover .desc-tooltip { display: block; }
  .course-thumb {
    position: relative;
    height: 210px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 18px 18px 0 0;
  }
  .course-price-badge {
    position: absolute;
    top: 10px; right: 10px;
    z-index: 3;
    font-size: .72rem;
    font-weight: 800;
    padding: .3rem .75rem;
    border-radius: 20px;
    backdrop-filter: blur(6px);
  }
  .course-price-badge.free { background: rgba(22,163,74,.9); color: #fff; }
  .course-price-badge.paid { background: rgba(255,255,255,.92); color: #1d1d1f; }
  .course-price-badge.demand { background: rgba(0,0,0,.55); color: rgba(255,255,255,.9); border: 1px solid rgba(255,255,255,.25); }
  .course-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .course-thumb-icon {
    font-size: 3rem;
    opacity: .35;
    color: #fff;
    position: relative;
    z-index: 1;
  }
  .course-thumb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(0,0,0,.4) 100%);
  }
  .course-body {
    padding: 1.25rem 1.3rem 1.4rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: .55rem;
  }
  .course-inst-row {
    display: flex;
    align-items: center;
    gap: .5rem;
  }
  .inst-logo-sm {
    width: 24px; height: 24px;
    border-radius: 6px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .inst-logo-sm-fallback {
    width: 24px; height: 24px;
    border-radius: 6px;
    color: #fff;
    font-size: .62rem;
    font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .inst-name-sm {
    font-size: .75rem;
    font-weight: 600;
    color: #64748b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .course-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1e293b;
    margin: 0;
    line-height: 1.35;
  }
  .course-meta-row {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: .75rem;
    color: #94a3b8;
    margin-top: .2rem;
  }
  .course-meta-row span {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .course-footer {
    padding: .85rem 1.3rem 1.1rem;
    border-top: 1px solid #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
  }
  .course-footer .meta { font-size: .75rem; color: #94a3b8; }
  .btn-learn-more {
    display: inline-flex; align-items: center; gap: .35rem;
    background: #5107ce; color: #fff;
    font-size: .8rem; font-weight: 700;
    padding: .5rem 1.1rem; border-radius: 8px;
    text-decoration: none; white-space: nowrap;
    transition: background .18s;
    flex-shrink: 0;
  }
  .btn-learn-more:hover { background: #3d0094; color: #fff; }

  .empty-state {
    text-align: center;
    padding: 5rem 2rem;
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 2px 12px rgba(0,0,0,.06);
    grid-column: 1 / -1;
  }
  .empty-state i { font-size: 3.5rem; color: #cbd5e1; display: block; margin-bottom: 1rem; }

  @media (max-width: 600px) {
    .catalog-hero h1 { font-size: 1.8rem; }
    .search-bar-wrap { flex-direction: column; }
    .search-bar-wrap button { width: 100%; }
  }
</style>` %>

<!-- Hero -->
<section class="catalog-hero">
  <div class="container">
    <h1><i class="bi bi-buildings me-2"></i>Formations Institutionnelles</h1>
    <p>Parcourez les cours disponibles dans nos institutions partenaires et découvrez comment vous inscrire.</p>
    <div class="search-bar-wrap">
      <input type="text" id="searchInput" placeholder="Rechercher par titre, institution, description…" autocomplete="off">
      <button type="button" onclick="runSearch()"><i class="bi bi-search me-1"></i> Rechercher</button>
    </div>
  </div>
</section>

<!-- Catalog body -->
<section class="catalog-body">
  <div class="container">

    <%
      const allInstitutions = [];
      const seenIds = new Set();
      const allCategories = [];
      const seenCats = new Set();
      courses.forEach(c => {
        const inst = c.institutionId;
        if (inst && !seenIds.has(String(inst._id))) {
          seenIds.add(String(inst._id));
          allInstitutions.push(inst);
        }
        const cat = c.category || 'Autre';
        if (!seenCats.has(cat)) { seenCats.add(cat); allCategories.push(cat); }
      });
    %>

    <!-- Institution filter pills -->
    <% if (allInstitutions.length > 1) { %>
    <div class="filter-bar">
      <span class="filter-label">Institution :</span>
      <button class="filter-pill active" data-inst="">Toutes</button>
      <% allInstitutions.forEach(inst => { %>
        <button class="filter-pill" data-inst="<%= String(inst._id) %>"><%= inst.name %></button>
      <% }) %>
    </div>
    <% } %>

    <!-- Category filter pills -->
    <% if (allCategories.length > 1) { %>
    <div class="filter-bar" id="catFilterBar">
      <span class="filter-label">Catégorie :</span>
      <button class="filter-pill active" data-cat="">Toutes</button>
      <% allCategories.forEach(cat => { %>
        <button class="filter-pill" data-cat="<%= cat %>"><%= cat %></button>
      <% }) %>
    </div>
    <% } %>

    <p class="results-meta"><strong id="resultCount"><%= courses.length %></strong> cours disponible<%= courses.length !== 1 ? 's' : '' %></p>

    <% if (courses.length === 0) { %>
      <div class="courses-grid">
        <div class="empty-state">
          <i class="bi bi-journal-bookmark"></i>
          <h3 style="font-weight:700;color:#1e293b;">Aucun cours disponible pour le moment</h3>
          <p style="color:#64748b;max-width:420px;margin:.5rem auto 0;">Revenez bientôt — de nouvelles formations sont en cours de préparation par nos institutions partenaires.</p>
        </div>
      </div>
    <% } else { %>
    <div class="courses-grid" id="coursesGrid">
      <% courses.forEach(course => {
        const inst = course.institutionId;
        const brand = (inst && inst.primaryColor) ? inst.primaryColor : '#5107ce';
        const initials = inst ? inst.name.substring(0,2).toUpperCase() : 'IN';
        const instId = inst ? String(inst._id) : '';
        const moduleCount = (course.modules || []).length;
        const pricing = course.pricing || {};
        let priceLabel, priceBadgeClass;
        if (pricing.isFree) { priceLabel = 'Gratuit'; priceBadgeClass = 'free'; }
        else if (pricing.amount) { priceLabel = Number(pricing.amount).toLocaleString('fr-FR') + ' ' + (pricing.currency || 'FCFA'); priceBadgeClass = 'paid'; }
        else { priceLabel = 'Sur demande'; priceBadgeClass = 'demand'; }
      %>
      <% const courseCat = course.category || 'Autre'; %>
      <div class="course-card" data-inst="<%= instId %>" data-cat="<%= courseCat %>"
           data-search="<%= [course.title, course.description, inst ? inst.name : '', courseCat].join(' ').toLowerCase() %>">
        <div class="course-thumb" style="background: linear-gradient(135deg, <%= brand %>, color-mix(in srgb, <%= brand %> 60%, #000));">
          <% if (course.imageUrl) { %>
            <img loading="lazy" src="<%= course.imageUrl %>" alt="<%= course.title %>">
          <% } else { %>
            <i class="bi bi-book-half course-thumb-icon"></i>
          <% } %>
          <div class="course-thumb-overlay"></div>
          <span class="course-price-badge <%= priceBadgeClass %>"><%= priceLabel %></span>
        </div>

        <div class="course-body">
          <div class="course-inst-row">
            <% if (inst && inst.logoUrl) { %>
              <img src="<%= inst.logoUrl %>" alt="<%= inst.name %>" class="inst-logo-sm">
            <% } else { %>
              <div class="inst-logo-sm-fallback" style="background:<%= brand %>;"><%= initials %></div>
            <% } %>
            <span class="inst-name-sm"><%= inst ? inst.name : 'Institution' %></span>
          </div>
          <h5 class="course-title"><%= course.title %></h5>
          <span class="category-badge"><%= courseCat %></span>
          <% if (course.description) { %>
            <div class="course-desc-wrap">
              <p class="course-desc"><%= course.description.substring(0, 110) %><%= course.description.length > 110 ? '…' : '' %></p>
              <% if (course.description.length > 110) { %>
                <div class="desc-tooltip"><%= course.description %></div>
              <% } %>
            </div>
          <% } %>
          <div class="course-meta-row">
            <span><i class="bi bi-grid-3x3-gap-fill"></i> <%= moduleCount %> module<%= moduleCount !== 1 ? 's' : '' %></span>
            <% if (inst && (inst.city || inst.country)) { %>
              <span><i class="bi bi-geo-alt-fill"></i> <%= [inst.city, inst.country].filter(Boolean).join(', ') %></span>
            <% } %>
          </div>
        </div>

        <div class="course-footer">
          <span class="meta"><i class="bi bi-building"></i> <%= inst ? inst.name : 'Institution' %></span>
          <a href="/formations/<%= course._id %>" class="btn-learn-more">En savoir plus →</a>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>

  </div>
</section>

<% scripts = `<script>
(function () {
  const grid = document.getElementById('coursesGrid');
  if (!grid) return;

  const cards = Array.from(grid.querySelectorAll('.course-card'));
  const countEl = document.getElementById('resultCount');
  const searchInput = document.getElementById('searchInput');
  const instPills = document.querySelectorAll('[data-inst]');
  const catPills  = document.querySelectorAll('[data-cat]');

  let activeInst = '';
  let activeCat  = '';
  let searchQuery = '';

  function applyFilters() {
    let visible = 0;
    cards.forEach(card => {
      const matchInst = !activeInst || card.dataset.inst === activeInst;
      const matchCat  = !activeCat  || card.dataset.cat  === activeCat;
      const matchSearch = !searchQuery || card.dataset.search.includes(searchQuery);
      const show = matchInst && matchCat && matchSearch;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    countEl.textContent = visible;
  }

  instPills.forEach(pill => {
    pill.addEventListener('click', function () {
      instPills.forEach(p => p.classList.remove('active'));
      this.classList.add('active');
      activeInst = this.dataset.inst;
      applyFilters();
    });
  });

  catPills.forEach(pill => {
    pill.addEventListener('click', function () {
      catPills.forEach(p => p.classList.remove('active'));
      this.classList.add('active');
      activeCat = this.dataset.cat;
      applyFilters();
    });
  });

  searchInput.addEventListener('input', function () {
    searchQuery = this.value.trim().toLowerCase();
    applyFilters();
  });

  searchInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') applyFilters();
  });

  window.runSearch = function () {
    searchQuery = searchInput.value.trim().toLowerCase();
    applyFilters();
  };
})();
</script>` %>
