<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />

  <title>
    <%= typeof title !=='undefined' ? title : 'AfroHK — Institutions' %>
  </title>

  <!-- Favicon -->
  <link href="/assets/img/afrohk_logo_2.png" rel="icon" />
  <meta property="og:image" content="/assets/img/afrohk_logo_2.png" />

  <!-- Font Awesome -->
  <script src="https://kit.fontawesome.com/9ecb022092.js"></script>

  <!-- Google Fonts -->
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=Open+Sans:wght@300;400;600&display=swap"
    rel="stylesheet">

  <!-- Vendor CSS -->
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" />

  <!-- App CSS -->
  <link href="/assets/css/Home.css" rel="stylesheet" />
  <link href="/assets/css/navbar.css" rel="stylesheet" />

  <!-- HugeRTE (pinned to v1 for styleselect support) -->
  <script src="https://cdn.jsdelivr.net/npm/hugerte@1/hugerte.min.js"></script>
  <script>
    // Shared RTE config — use as: hugerte.init({ ...RTECONFIG, selector: '#myField' })
    // Or add class="institution-rte" to any textarea for auto-init.
    window.RTECONFIG = {
      height: 200,
      relative_urls: false,
      remove_script_host: false,
      toolbar: "insertfile undo redo | styleselect | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image",
      plugins: 'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount',
      max_width: 500,
      min_height: 300,
      min_width: 400
    };
    hugerte.init({ ...window.RTECONFIG, selector: '.institution-rte' });
  </script>

  <%- typeof headContent !=='undefined' ? headContent : '' %>
  <style>
    :root {
      --secondary: <%= (typeof institutionSecondaryColor !== 'undefined' && institutionSecondaryColor) ? institutionSecondaryColor : 'color-mix(in srgb, var(--brand, #0e7490) 18%, #fff)' %>;
      --accent:    <%= (typeof institutionAccentColor    !== 'undefined' && institutionAccentColor)    ? institutionAccentColor    : '#f59e0b' %>;
    }
  </style>
</head>

<body>
  <% if (typeof learnMode !== 'undefined' && learnMode) { %>
    <%- include('../partials/learnNavbar') %>
  <% } else { %>
    <%- include('../partials/institutionNavbar') %>
    <%- include('../partials/flash') %>
  <% } %>

  <main id="main">
    <%- body %>
  </main>

  <% if (!(typeof learnMode !== 'undefined' && learnMode)) { %>
    <%- include('../partials/institutionFooter') %>
  <% } %>

        <!-- Vendor JS -->
        <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

        <!-- App JS -->
        <script src="/assets/js/main.js"></script>

        <%- typeof scripts !=='undefined' ? scripts : '' %>
</body>

</html>