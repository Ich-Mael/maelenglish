<% layout('layouts/boilerplate') %>
<link href="/stylesheets/englishforAll/basicenglish.css" rel="stylesheet" />
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />

<!--SECTION 1 Course info-->
<div class="course-announcement">
  <div class="row">
    <div class="col-lg-2"></div>
    <div class="col-lg-8 course">
      <div class="d-flex flex-column">
        <h1 class="course-heading animated pulse">
          Basic English For Everyone
        </h1>
      </div>
      <div class="mx-2 d-flex flex-wrap justify-content-center">
        <div class="d-flex justify-content-center">
          <h3 class="skill"><span>Pronunciation</span></h3>
        </div>
        <div class="d-flex justify-content-center">
          <h3 class="skill"><span>Speaking</span></h3>
        </div>
        <div class="d-flex justify-content-center">
          <h3 class="skill"><span class="">Listening</span></h3>
        </div>
        <div class="d-flex justify-content-center">
          <h3 class="skill"><span class="">Reading</span></h3>
        </div>
        <div class="d-flex justify-content-center">
          <h3 class="skill"><span class="">Vocabulary</span></h3>
        </div>
      </div>
      <div></div>
      <div class="row mx-2 my-2 d-flex justify-content-center">
        <div class="col-lg-3">
          <h3 class="course-details">
            <i class="bi mx-2 bi-hourglass-split"></i>Duree -
            <span class="course-details-info"> 8 semaines</span>
          </h3>
        </div>
        <div class="col-lg-4">
          <h3 class="heure-sem course-details">
            <i class="bi mx-2 bi-clock-history"></i
            ><span class="course-details-info"> 4 heures </span> par semaine
          </h3>
        </div>
        <div class="col-lg-3">
          <h3 class="course-details">
            <i class="bi mx-2 bi-globe"></i
            ><span class="course-details-info">100% </span> en ligne
          </h3>
        </div>
      </div>
      <div class="d-flex motivation flex-column">
        <p class="px-5 text-center encouragement">
          Développez votre anglais pour une utilisation dans différentes
          situations quotidiennes et renforcez votre confiance en vos capacités
          d'écoute.
        </p>
        <p class="course-paragraph px-3 text-center">
          Tout ce qu'il faut pour s'exprimer en Anglais en toute confiance
        </p>
        <button class="mb-3 py-2 start-learning-btn">
          <a href="">Start Learning Now</a>
        </button>
      </div>
    </div>
    <div class="col-lg-2"></div>
  </div>
</div>

<!--SECTION 2 Why learn with us-->
<div
  class="learn-with-us"
  data-aos="flip-up"
  data-aos-duration="2800"
  data-aos-delay="150"
>
  <h3 class="">Do you know why learning with us is fun ?</h3>
</div>
<div class="container my-5">
  <div class="row mt-3">
    <div
      data-aos="fade-up-right"
      data-aos-offset="200"
      data-aos-delay="50"
      data-aos-duration="2000"
      data-aos-easing="ease-in-out"
      data-aos-mirror="true"
      class="col-12 col-md-4 mb-5 rounded"
    >
      <div class="d-flex mt- mb-2 justify-content-center">
        <div class="card my-card" style="width: 18rem">
          <img
            class="card-img-top"
            style="height: 18rem"
            src="https://images.pexels.com/photos/4050334/pexels-photo-4050334.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=750&w=1260"
            alt="Card image cap"
          />
          <div
            class="
              card-body
              border border-info border-3
              bg-dark
              d-flex
              flex-column
              align-items-center
            "
          >
            <p class="card-text text-center anywhere">
              Learn <br />
              Anywhere
            </p>
          </div>
        </div>
      </div>
    </div>
    <div
      data-aos="flip-up"
      data-aos-offset="200"
      data-aos-delay="150"
      data-aos-duration="1200"
      data-aos-easing="ease-in-out"
      data-aos-mirror="true"
      class="col-12 col-md-4 mb-5 rounded"
    >
      <div class="d-flex my-2 justify-content-center">
        <div class="card my-card" style="width: 18rem">
          <img
            class="card-img-top"
            style="height: 18rem"
            src="https://images.pexels.com/photos/4384147/pexels-photo-4384147.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=750&w=1260"
            alt="Card image cap"
          />
          <div
            class="
              card-body
              bg-dark
              border border-3 border-secondary
              d-flex
              flex-column
              align-items-center
            "
          >
            <p class="card-text text-center anywhere">
              Learn <br />
              Anytime
            </p>
          </div>
        </div>
      </div>
    </div>
    <div
      data-aos="zoom-in"
      data-aos-offset="200"
      data-aos-delay="100"
      data-aos-duration="1800"
      data-aos-easing="ease-in-out"
      data-aos-mirror="true"
      class="col-12 col-md-4 mb-5 rounded"
    >
      <div class="d-flex my-2 justify-content-center">
        <div class="card my-card" style="width: 18rem">
          <img
            class="card-img-top"
            style="height: 18rem"
            src="https://images.pexels.com/photos/359989/pexels-photo-359989.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=750&w=1260"
            alt="Card image cap"
          />
          <div
            class="
              card-body
              border border-3 border-warning
              bg-dark
              d-flex
              flex-column
              align-items-center
            "
          >
            <p class="card-text text-center anywhere">Learn At your own Pace</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- End Programmes section-->
</div>

