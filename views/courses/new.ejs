<% layout('layouts/boilerplate') %>
<link href="/stylesheets/course.css" rel="stylesheet" />
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
<!-- Google Fonts -->
<link
  href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Raleway:300,300i,400,400i,500,500i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i"
  rel="stylesheet"
/>
<div class="container my-5 d-flex flex-column justify-content-center">
<h1>Create a new course</h1>
<form action="/courses" method="POST">
  <label for="title">Course title</label>
  <input type="text" name="course[title]" value="" />
  <label for="description">Description</label>
  <textarea name="course[description]" id="" cols="30" rows="10">
  </textarea>
  <label for="price">Price</label>
  <input type="text" name="course[price]" value="" />
  <button type="submit">Create a Course</button>
</form>

</div>
