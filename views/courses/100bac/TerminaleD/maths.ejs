<link href="/stylesheets/100bac/mathstleD.css" rel="stylesheet"/>
<h1 class="maths-title text-center">Cours de mathematiques Tle D</h1>
<div class="maths-wrapper d-flex flex-column justify-content-center align-items-center container">
    <div id="course-menu-wrapper" class="col-2 d-flex flex-column justify-content-center align-items-center col-md-4">
        <!-- Button trigger modal -->
        <button type="button" class="course-menu-btn" data-bs-toggle="modal" data-bs-target="#maths-menu-collapse">
            Liste des chapitres
        </button>
        <div class="modal fade" id="maths-menu-collapse" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title text-center" id="exampleModalLabel">Liste des chapitres Maths Tle D</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="course-list d-flex flex-wrap justify-content-center">
                            <p class="chapitre course-video-link"><span>1</span>Nombres Complexes</p>
                            <p class="chapitre course-video-link"><span>2</span>Limites et Continuite</p>
                            <p class="chapitre course-video-link"><span>3</span>Derivation</p>
                            <p class="chapitre course-video-link"><span>4</span>Fonction Logarithme Neperien</p>
                            <p class="chapitre course-video-link"><span>5</span>Fonction exponentielle</p>
                            <p class="chapitre  course-video-link"><span>6</span>Calcul d'Integrales</p>
                            <p class="chapitre course-video-link"><span>7</span>Suites Numeriques</p>
                            <p class="chapitre course-video-link"><span>8</span>Probabilites</p>
                            <p class="chapitre course-video-link"><span>9</span>Equations Differentielles</p>
                            <p class="chapitre course-video-link"><span>10</span>Geometrie dans l'espace</p>
                            <p class="chapitre course-video-link"><span>11</span>Statistiques</p>
                            <p class="chapitre course-video-link"><span>12</span>Courbes Parametrees</p>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Fermer</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="maths-section">
<div class="chapters">
