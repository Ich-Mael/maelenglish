<% layout('layouts/courseBoilerplate') %>
<link href="/stylesheets/courses/showModule.css" rel="stylesheet" />
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
<!-- Google Fonts -->
<link
  href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Raleway:300,300i,400,400i,500,500i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i"
  rel="stylesheet"
/>

<div
  data-aos="zoom-out"
  data-aos-delay="100"
  data-aos-duration="1800"
  class="header-wrapper"
>
  <div class="bg-img-wrapper">
    <img class="img-medium" src="<%= course.courseImageUrl %> " alt="" />
  </div>
  <div class="banner-wrapper">
    <div class="d-flex align-items-center flex-column" style="width: 100vw">
      <h1 class="banner-heading"><%= course.title %></h1>
      <!-- Button trigger modal -->
      <button
        type="button"
        class="btn btn-success"
        data-bs-toggle="modal"
        data-bs-target="#exampleModal"
      >
        Voir tous les modules
      </button>
    </div>
  </div>
</div>
<!-- Modal -->
<div
  class="modal fade"
  id="exampleModal"
  tabindex="-1"
  aria-labelledby="exampleModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">
          Les modules de ce cours
        </h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body">
        <ol>
        <% for(let chapter of course.modules){ %>
         <li class="module"><a href="/courses/<%= course._id %>/modules/<%=chapter._id%>"> <%= chapter.title %></a></li> 
        <% } %>
        </ol>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">
          Quitter
        </button>
      </div>
    </div>
  </div>
</div>
<p class="module-title-wrapper">
  Module <%=course.modules.indexOf(courseModule._id) + 1 %> : <%=
  courseModule.title %>
</p>
<% if(revealDate) {%>
<!-- Module content -->
<section class="container col-md-8">
  <div class="mb-3 mt-5">
    <h3 class="about-course-heading">
      <span class="underline-section"
        >Objectifs d'apprentissage de ce module</span
      >
    </h3>
    <p><%- courseModule.willLearnModule %></p>
  </div>
  <hr />
  <div class="my-3">
    <h3 class="about-course-heading">
      <span class="underline-section">Contenu du module</span>
    </h3>
    <% for (video of courseModule.videoLinks) {%>
    <!-- Button trigger modal -->
    <button
      type="button"
      class="btn me-4 btn-outline-primary"
      data-bs-toggle="modal"
      data-bs-target="#video-<%= courseModule.videoLinks.indexOf(video) %>"
    >
      Partie <%= courseModule.videoLinks.indexOf(video) + 1 %>
    </button>

    <!-- Modal -->
    <div
      class="modal fade"
      id="video-<%= courseModule.videoLinks.indexOf(video) %>"
      tabindex="-1"
      aria-labelledby="exampleModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="exampleModalLabel">
              Video <%= courseModule.videoLinks.indexOf(video) +1 %>
            </h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">
            <div id="tv-container">
              <div id="monitor">
                <div class="afrohk-TV">
                  <h3 class="text-center afrohk-text mb-2 py-0">
                    <span class="afrohk">AfroHK</span
                    ><span class="tv">Radar</span>
                  </h3>
                </div>
                <div id="monitorscreen">
                  <iframe
                    id="vimeo-content"
                    src="<%=video %>"
                    frameborder="0"
                    height="500px"
                    width="1000px"
                    allow="autoplay; fullscreen; picture-in-picture"
                    allow="fullscreen"
                    title="High-intensity Classes"
                  ></iframe>
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-danger"
              data-bs-dismiss="modal"
            >
              Quitter
            </button>
          </div>
        </div>
      </div>
    </div>
    <% } %>
  </div>
  <hr />
  <div class="my-3">
    <h3 class="about-course-heading">
      <span class="underline-section">Pour mieux comprendre</span>
    </h3>
    <p><%- courseModule.explanationText %></p>
  </div>
  <hr />
  <div class="my-3">
    <h3 class="about-course-heading">
      <span class="underline-section">En savoir plus (optionnel) </span>
    </h3>
    <p><%- courseModule.moreDetails %></p>
  </div>
</section>
<% } else { %> 
<section>
  <p> Ce module sera disponible <br> <span class="module-date"><%= displayRevealDate %></span></p>
</section>
  <% } %> 