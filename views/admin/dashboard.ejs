<% layout('layouts/main') %>

<% headContent = `
  <style>
    /* Ensure admin dashboard content is not hidden by fixed navbar */
    #main {
      margin-top: 0 !important;
      padding-top: 0 !important;
    }
    
    .admin-dashboard {
      padding: 2rem 0 4rem;
      min-height: calc(100vh - 200px);
      background: linear-gradient(to bottom, #f8f9fa 0%, #ffffff 100%);
      margin-top: 80px !important; /* Compensate for fixed navbar */
    }
    
    /* Page Header (E-Kalan style) */
    .page-header {
      background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
      color: white;
      padding: 2.5rem 2rem;
      border-radius: 20px;
      margin-bottom: 2rem;
      box-shadow: 0 10px 40px rgba(93, 6, 186, 0.3);
    }
    
    .page-header h1 {
      margin: 0 0 0.5rem 0;
      font-size: 2rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    
    .page-header p {
      margin: 0;
      opacity: 0.95;
      font-size: 1.1rem;
      font-weight: 300;
    }
    
    .page-header .role-badge {
      display: inline-block;
      background: rgba(255, 255, 255, 0.2);
      padding: 0.5rem 1rem;
      border-radius: 50px;
      font-size: 0.9rem;
      margin-top: 1rem;
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.3);
    }
    
    /* Stats Grid (E-Kalan style) */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
    
    .stat-card {
      background: white;
      border-radius: 16px;
      padding: 1.5rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      border-left: 4px solid #5d06ba;
      transition: all 0.3s ease;
    }
    
    .stat-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 30px rgba(93, 6, 186, 0.15);
    }
    
    .stat-card.users { border-left-color: #5d06ba; }
    .stat-card.admins { border-left-color: #e74c3c; }
    .stat-card.learners { border-left-color: #3498db; }
    .stat-card.verified { border-left-color: #2ecc71; }
    
    .stat-value {
      font-size: 2rem;
      font-weight: 700;
      color: #2d0370;
      margin: 0;
    }
    
    .stat-label {
      color: #666;
      font-size: 0.9rem;
      margin: 0.5rem 0 0 0;
      font-weight: 500;
    }
    
    /* Quick Actions */
    .quick-actions {
      margin-bottom: 3rem;
    }
    
    .section-title {
      font-size: 1.75rem;
      font-weight: 700;
      color: #2d0370;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    
    .section-title i {
      font-size: 1.5rem;
    }
    
    .actions-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    
    .action-card {
      background: white;
      border-radius: 12px;
      padding: 1.25rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      text-decoration: none;
      display: block;
      border: 2px solid transparent;
      position: relative;
      overflow: hidden;
    }
    
    .action-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(90deg, #5d06ba 0%, #2d0370 100%);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.3s ease;
    }
    
    .action-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 40px rgba(93, 6, 186, 0.2);
      border-color: #5d06ba;
      text-decoration: none;
    }
    
    .action-card:hover::before {
      transform: scaleX(1);
    }
    
    .action-icon {
      width: 50px;
      height: 50px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      color: white;
      background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
      margin-bottom: 1rem;
      transition: transform 0.3s ease;
    }
    
    .action-card:hover .action-icon {
      transform: scale(1.1) rotate(5deg);
    }
    
    .action-title {
      font-size: 1.1rem;
      font-weight: 600;
      color: #2d0370;
      margin: 0 0 0.5rem 0;
      line-height: 1.3;
    }
    
    .action-description {
      color: #666;
      font-size: 0.85rem;
      line-height: 1.5;
      margin: 0 0 0.75rem 0;
    }
    
    .action-link {
      color: #5d06ba;
      font-weight: 600;
      font-size: 0.85rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition: gap 0.3s ease;
    }
    
    .action-card:hover .action-link {
      gap: 0.75rem;
    }
    
    .action-link i {
      transition: transform 0.3s ease;
    }
    
    .action-card:hover .action-link i {
      transform: translateX(5px);
    }
    
    /* Programs Section */
    .programs-section {
      margin-bottom: 3rem;
    }
    
    .program-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
    }
    
    .program-card {
      background: white;
      border-radius: 16px;
      padding: 2rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      border: 2px solid #e8e8e8;
      transition: all 0.3s ease;
    }
    
    .program-card:hover {
      border-color: #5d06ba;
      box-shadow: 0 8px 30px rgba(93, 6, 186, 0.15);
      transform: translateY(-3px);
    }
    
    .program-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid #f0f0f0;
    }
    
    .program-icon {
      width: 50px;
      height: 50px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
      color: white;
    }
    
    .program-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: #2d0370;
      margin: 0;
    }
    
    .program-links {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    
    .program-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: #5d06ba;
      text-decoration: none;
      font-weight: 500;
      padding: 0.5rem 1rem;
      border-radius: 8px;
      transition: all 0.3s ease;
      background: rgba(93, 6, 186, 0.05);
    }
    
    .program-link:hover {
      background: rgba(93, 6, 186, 0.1);
      color: #2d0370;
      text-decoration: none;
      transform: translateX(5px);
    }
    
    /* Coming Soon Badge */
    .coming-soon {
      display: inline-block;
      background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
      color: white;
      padding: 0.25rem 0.75rem;
      border-radius: 50px;
      font-size: 0.75rem;
      font-weight: 600;
      margin-left: 0.5rem;
      opacity: 0.8;
    }
    
    /* Responsive */
    @media (max-width: 768px) {
      .page-header {
        padding: 2rem 1.5rem;
      }
      
      .page-header h1 {
        font-size: 1.75rem;
      }
      
      .stats-grid {
        grid-template-columns: 1fr;
      }
      
      .actions-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;
      }
      
      .action-card {
        padding: 1rem;
      }
      
      .action-icon {
        width: 45px;
        height: 45px;
        font-size: 1.3rem;
        margin-bottom: 0.75rem;
      }
      
      .action-title {
        font-size: 1rem;
      }
      
      .action-description {
        font-size: 0.8rem;
      }
      
      .program-cards {
        grid-template-columns: 1fr;
      }
    }
  </style>
` %>

<div class="admin-dashboard">
  <div class="container">
    <!-- Page Header (E-Kalan style) -->
    <div class="page-header">
      <h1>
        <i class="bi bi-speedometer2"></i>
        Dashboard Administrateur
      </h1>
      <p>Bienvenue, <strong><%= currentUser.name %> <%= currentUser.surname %></strong></p>
      <span class="role-badge">
        <i class="bi bi-shield-check"></i>
        <%= currentUser.role === 'super-admin' ? 'Super Administrateur' : 'Administrateur' %>
      </span>
    </div>
    
    <!-- Statistics Cards (E-Kalan style) -->
    <div class="stats-grid">
      <div class="stat-card users">
        <p class="stat-value"><%= typeof stats !== 'undefined' ? stats.totalUsers : '0' %></p>
        <p class="stat-label">Total Utilisateurs</p>
      </div>
      
      <div class="stat-card admins">
        <p class="stat-value"><%= typeof stats !== 'undefined' ? stats.totalAdmins : '0' %></p>
        <p class="stat-label">Administrateurs</p>
      </div>
      
      <div class="stat-card learners">
        <p class="stat-value"><%= typeof stats !== 'undefined' ? stats.totalLearners : '0' %></p>
        <p class="stat-label">Apprenants</p>
      </div>
      
      <div class="stat-card verified">
        <p class="stat-value"><%= typeof stats !== 'undefined' ? stats.verifiedUsers : '0' %></p>
        <p class="stat-label">Comptes Vérifiés</p>
      </div>
    </div>
    
    <!-- Institution Analytics -->
    <% if (typeof institutionStats !== 'undefined' && institutionStats.length > 0) { %>
    <div style="margin:2rem 0;background:#fff;border-radius:16px;box-shadow:0 2px 12px rgba(0,0,0,.07);padding:1.75rem;">
      <h2 style="font-size:1.1rem;font-weight:700;color:#5d06ba;margin:0 0 1.25rem;padding-bottom:.75rem;border-bottom:2px solid #ede8f8;display:flex;justify-content:space-between;align-items:center;">
        <span><i class="bi bi-building me-2"></i>Institutions partenaires</span>
        <span style="font-size:.85rem;font-weight:500;color:#888;"><%= totalInstitutions %> active(s) · <%= totalInstitutionStudents %> étudiant(s) rattaché(s)</span>
      </h2>
      <div style="overflow-x:auto;">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead style="font-size:.8rem;text-transform:uppercase;color:#888;">
            <tr>
              <th>Institution</th>
              <th>Cours assignés</th>
              <th>Étudiants inscrits</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% institutionStats.forEach(({ institution, studentCount }) => { %>
              <tr>
                <td class="fw-semibold"><%= institution.name %></td>
                <td><%= institution.assignedCourses.length %></td>
                <td>
                  <span style="background:#ede8f8;color:#5d06ba;padding:.15rem .6rem;border-radius:20px;font-size:.8rem;font-weight:600;">
                    <%= studentCount %>
                  </span>
                </td>
                <td><a href="/admin/institutions/<%= institution._id %>" class="btn btn-sm btn-outline-primary py-0 px-2">Voir</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (recentEnrollments && recentEnrollments.length > 0) { %>
        <div style="margin-top:1.25rem;padding-top:1rem;border-top:1px solid #f0f0f0;">
          <p style="font-size:.85rem;font-weight:600;color:#555;margin-bottom:.5rem;">Inscriptions — 6 derniers mois</p>
          <div style="display:flex;gap:.5rem;align-items:flex-end;height:60px;">
            <% const maxCount = Math.max(...recentEnrollments.map(e => e.count), 1); %>
            <% recentEnrollments.forEach(e => { %>
              <div title="<%= e._id.month %>/<%= e._id.year %> : <%= e.count %> inscription(s)"
                   style="flex:1;background:#5d06ba;border-radius:4px 4px 0 0;height:<%= Math.round((e.count / maxCount) * 100) %>%;min-height:4px;opacity:.75;transition:opacity .2s;"
                   onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=.75">
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
    <% } %>

    <!-- Quick Actions -->
    <div class="quick-actions">
      <h2 class="section-title">
        <i class="bi bi-lightning-charge"></i>
        Actions Rapides
      </h2>
      <div class="actions-grid">
        <a href="/admin/users/create" class="action-card">
          <div class="action-icon">
            <i class="bi bi-person-plus"></i>
          </div>
          <h3 class="action-title">Créer un Compte</h3>
          <p class="action-description">
            Ajouter un nouvel utilisateur à la plateforme (admin, apprenant, etc.)
          </p>
          <span class="action-link">
            Accéder <i class="bi bi-arrow-right"></i>
          </span>
        </a>
        
        <a href="/admin/users" class="action-card">
          <div class="action-icon">
            <i class="bi bi-list-ul"></i>
          </div>
          <h3 class="action-title">Gérer les Utilisateurs</h3>
          <p class="action-description">
            Voir, modifier et gérer tous les comptes utilisateurs
          </p>
          <span class="action-link">
            Accéder <i class="bi bi-arrow-right"></i>
          </span>
        </a>
        
        <a href="#" class="action-card" onclick="return false;" style="opacity: 0.7; cursor: not-allowed;">
          <div class="action-icon" style="background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);">
            <i class="bi bi-graph-up"></i>
          </div>
          <h3 class="action-title">Statistiques Détaillées<span class="coming-soon">Bientôt</span></h3>
          <p class="action-description">
            Consulter les rapports et analyses détaillées de la plateforme
          </p>
          <span class="action-link">
            Bientôt disponible <i class="bi bi-arrow-right"></i>
          </span>
        </a>
        
        <a href="#" class="action-card" onclick="return false;" style="opacity: 0.7; cursor: not-allowed;">
          <div class="action-icon" style="background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);">
            <i class="bi bi-gear"></i>
          </div>
          <h3 class="action-title">Paramètres<span class="coming-soon">Bientôt</span></h3>
          <p class="action-description">
            Configurer les paramètres généraux de la plateforme
          </p>
          <span class="action-link">
            Bientôt disponible <i class="bi bi-arrow-right"></i>
          </span>
        </a>
      </div>
    </div>
    
    <!-- Programs Management -->
    <div class="programs-section">
      <h2 class="section-title">
        <i class="bi bi-grid"></i>
        Gestion des Programmes
      </h2>
      <div class="program-cards">
        <!-- E-Kalan Program -->
        <div class="program-card">
          <div class="program-header">
            <div class="program-icon">
              <i class="bi bi-mortarboard"></i>
            </div>
            <h3 class="program-title">E-Kalan</h3>
          </div>
          <div class="program-links">
            <a href="/programs/ekalan/kalan/admindashboard/kalan/premium-requests" class="program-link">
              <i class="bi bi-star"></i>
              Demandes d'accès premium
            </a>
            <a href="/programs/ekalan/kalan/admindashboard/kalan/students" class="program-link">
              <i class="bi bi-people"></i>
              Gérer les étudiants
            </a>
            <a href="/programs/ekalan/kalan/admindashboard/kalan/series_and_classes" class="program-link">
              <i class="bi bi-book"></i>
              Classes et séries
            </a>
            <a href="/programs/ekalan/kalan/admindashboard/kalan/students" class="program-link">
              <i class="bi bi-list-check"></i>
              Voir tous les étudiants
            </a>
          </div>
        </div>
        
        <!-- Language Learning Program -->
        <div class="program-card">
          <div class="program-header">
            <div class="program-icon">
              <i class="bi bi-translate"></i>
            </div>
            <h3 class="program-title">Language Learning</h3>
          </div>
          <div class="program-links">
            <a href="/programs/language-learning/general-english-boost/admindashboard" class="program-link">
              <i class="bi bi-book"></i>
              Gérer les cours
            </a>
            <a href="/programs/language-learning/general-english-boost/admindashboard/new" class="program-link">
              <i class="bi bi-plus-circle"></i>
              Créer un nouveau cours
            </a>
            <a href="/programs/language-learning/admin/instructors" class="program-link">
              <i class="bi bi-person-badge"></i>
              Gérer les instructeurs
            </a>
            <a href="/programs/language-learning/pecp" class="program-link">
              <i class="bi bi-people"></i>
              Personal English Coaching Boost
            </a>
          </div>
        </div>

        <!-- Institutions partenaires -->
        <div class="program-card">
          <div class="program-header">
            <div class="program-icon">
              <i class="bi bi-building"></i>
            </div>
            <h3 class="program-title">Institutions partenaires</h3>
          </div>
          <div class="program-links">
            <a href="/admin/institutions" class="program-link">
              <i class="bi bi-list-ul"></i>
              Voir toutes les institutions
            </a>
            <a href="/admin/institutions/new" class="program-link">
              <i class="bi bi-plus-circle"></i>
              Créer une institution
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
