<% layout('layouts/main') %>

<% headContent = `<style>
  .page-wrapper { margin-top: 80px; padding: 2rem 0 4rem; }
  .page-header { background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%); color: white; padding: 2rem; border-radius: 16px; margin-bottom: 2rem; }
  .page-header h1 { margin: 0; font-size: 1.8rem; font-weight: 700; }
  .form-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,.07); padding: 2rem; margin-bottom: 1.5rem; }
  .form-card h2 { font-size: 1.1rem; font-weight: 700; color: #5d06ba; margin: 0 0 1.25rem; padding-bottom: .75rem; border-bottom: 2px solid #ede8f8; }
  .form-label { font-weight: 600; font-size: .9rem; }

  .color-slots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .color-slot { border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 1rem; display: flex; flex-direction: column; gap: .6rem; transition: border-color .2s; }
  .color-slot:focus-within { border-color: #5d06ba; }
  .color-slot-label { font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: #64748b; }
  .color-slot-optional { font-size: .7rem; font-weight: 400; color: #94a3b8; text-transform: none; letter-spacing: 0; }
  .color-picker-row { display: flex; align-items: center; gap: .5rem; }
  .swatch { width: 38px; height: 38px; border-radius: 8px; border: none; cursor: pointer; padding: 2px; flex-shrink: 0; background: none; }
  .hex-input { flex: 1; font-family: monospace; font-size: .88rem; padding: .4rem .6rem; border-radius: 8px; border: 1.5px solid #e2e8f0; }
  .hex-input:focus { outline: none; border-color: #5d06ba; }
  .clear-btn { background: none; border: none; color: #94a3b8; font-size: .85rem; cursor: pointer; padding: .2rem .4rem; border-radius: 6px; line-height: 1; }
  .clear-btn:hover { background: #fee2e2; color: #dc2626; }
  .brand-preview { border-radius: 10px; overflow: hidden; height: 40px; display: flex; margin-top: .75rem; border: 1px solid #e2e8f0; }
  .brand-preview-block { flex: 1; transition: background .2s; }
  @media (max-width: 640px) { .color-slots { grid-template-columns: 1fr; } }
</style>` %>

<div class="page-wrapper">
  <div class="container" style="max-width:700px">
    <div class="page-header">
      <h1>Modifier : <%= institution.name %></h1>
    </div>

    <%- include('../../partials/flash') %>

    <div class="form-card">
      <form action="/admin/institutions/<%= institution._id %>?_method=PUT" method="POST">
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label">Nom de l'institution</label>
            <input type="text" name="name" class="form-control" value="<%= institution.name %>" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Email de contact</label>
            <input type="email" name="contactEmail" class="form-control" value="<%= institution.contactEmail || '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label">Téléphone</label>
            <input type="text" name="phone" class="form-control" value="<%= institution.phone || '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label">Ville</label>
            <input type="text" name="city" class="form-control" value="<%= institution.city || '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label">Pays</label>
            <input type="text" name="country" class="form-control" value="<%= institution.country || 'Burkina Faso' %>">
          </div>
          <div class="col-12">
            <label class="form-label">URL du logo</label>
            <input type="url" name="logoUrl" class="form-control" value="<%= institution.logoUrl || '' %>" placeholder="https://...">
          </div>
          <div class="col-12">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="3"><%= institution.description || '' %></textarea>
          </div>
        </div>

        <!-- Brand colors -->
        <hr class="my-4">
        <h2 style="margin:0 0 1rem;">🎨 Couleurs de la marque</h2>
        <p class="text-muted small mb-3">Jusqu'à 3 couleurs pour l'identité visuelle de l'institution.</p>

        <div class="color-slots mb-2">
          <div class="color-slot">
            <span class="color-slot-label">Principale <span style="color:#dc3545;">*</span></span>
            <div class="color-picker-row">
              <input type="color" class="swatch" id="swatch1" value="<%= institution.primaryColor || '#0e7490' %>">
              <input type="text" name="primaryColor" id="hex1" class="hex-input"
                     value="<%= institution.primaryColor || '#0e7490' %>" maxlength="7">
            </div>
          </div>
          <div class="color-slot">
            <span class="color-slot-label">Secondaire <span class="color-slot-optional">(optionnel)</span></span>
            <div class="color-picker-row">
              <input type="color" class="swatch" id="swatch2" value="<%= institution.secondaryColor || '#0e7490' %>">
              <input type="text" name="secondaryColor" id="hex2" class="hex-input"
                     value="<%= institution.secondaryColor || '' %>" maxlength="7" placeholder="—">
              <button type="button" class="clear-btn" onclick="clearColor(2)" title="Effacer">×</button>
            </div>
          </div>
          <div class="color-slot">
            <span class="color-slot-label">Accent <span class="color-slot-optional">(optionnel)</span></span>
            <div class="color-picker-row">
              <input type="color" class="swatch" id="swatch3" value="<%= institution.accentColor || '#0e7490' %>">
              <input type="text" name="accentColor" id="hex3" class="hex-input"
                     value="<%= institution.accentColor || '' %>" maxlength="7" placeholder="—">
              <button type="button" class="clear-btn" onclick="clearColor(3)" title="Effacer">×</button>
            </div>
          </div>
        </div>

        <div class="brand-preview" id="brandPreview">
          <div class="brand-preview-block" id="preview1"></div>
          <div class="brand-preview-block" id="preview2"></div>
          <div class="brand-preview-block" id="preview3"></div>
        </div>
        <p class="text-muted" style="font-size:.75rem;margin-top:.5rem;">Aperçu des couleurs choisies</p>

        <div class="d-flex gap-2 justify-content-end mt-4">
          <a href="/admin/institutions/<%= institution._id %>" class="btn btn-outline-secondary">Annuler</a>
          <button type="submit" class="btn btn-primary px-4">Enregistrer</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
(function () {
  const IS_HEX = /^#[0-9a-fA-F]{6}$/;

  function wireColor(n) {
    const swatch = document.getElementById('swatch' + n);
    const hex    = document.getElementById('hex' + n);
    const prev   = document.getElementById('preview' + n);

    function applyColor(val) {
      const valid = IS_HEX.test(val);
      prev.style.background = valid ? val : '#e2e8f0';
      prev.style.opacity    = (n > 1 && !valid) ? '0.3' : '1';
    }

    swatch.addEventListener('input', function () { hex.value = this.value; applyColor(this.value); });
    hex.addEventListener('input', function () {
      const v = this.value.trim();
      if (IS_HEX.test(v)) { swatch.value = v; applyColor(v); }
      else applyColor('');
    });

    applyColor(hex.value || '');
  }

  wireColor(1); wireColor(2); wireColor(3);

  window.clearColor = function (n) {
    document.getElementById('hex' + n).value    = '';
    document.getElementById('swatch' + n).value = '#0e7490';
    document.getElementById('preview' + n).style.background = '#e2e8f0';
    document.getElementById('preview' + n).style.opacity    = '0.3';
  };
})();
</script>
