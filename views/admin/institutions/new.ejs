<% layout('layouts/main') %>

<% headContent = `<style>
  .page-wrapper { margin-top: 80px; padding: 2rem 0 4rem; }
  .page-header { background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%); color: white; padding: 2rem; border-radius: 16px; margin-bottom: 2rem; }
  .page-header h1 { margin: 0 0 .25rem; font-size: 1.8rem; font-weight: 700; }
  .form-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,.07); padding: 2rem; margin-bottom: 1.5rem; }
  .form-card h2 { font-size: 1.1rem; font-weight: 700; color: #5d06ba; margin: 0 0 1.25rem; padding-bottom: .75rem; border-bottom: 2px solid #ede8f8; }
  .form-label { font-weight: 600; font-size: .9rem; }
  .required-mark { color: #dc3545; }

  /* Brand colors */
  .color-slots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .color-slot { border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 1rem; display: flex; flex-direction: column; gap: .6rem; transition: border-color .2s; }
  .color-slot:focus-within { border-color: #5d06ba; }
  .color-slot-label { font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: #64748b; }
  .color-slot-optional { font-size: .7rem; font-weight: 400; color: #94a3b8; text-transform: none; letter-spacing: 0; }
  .color-picker-row { display: flex; align-items: center; gap: .5rem; }
  .swatch { width: 38px; height: 38px; border-radius: 8px; border: none; cursor: pointer; padding: 2px; flex-shrink: 0; background: none; }
  .hex-input { flex: 1; font-family: monospace; font-size: .88rem; padding: .4rem .6rem; border-radius: 8px; border: 1.5px solid #e2e8f0; }
  .hex-input:focus { outline: none; border-color: #5d06ba; }
  .clear-btn { background: none; border: none; color: #94a3b8; font-size: .85rem; cursor: pointer; padding: .2rem .4rem; border-radius: 6px; line-height: 1; }
  .clear-btn:hover { background: #fee2e2; color: #dc2626; }

  /* Preview strip */
  .brand-preview { border-radius: 10px; overflow: hidden; height: 40px; display: flex; margin-top: .75rem; border: 1px solid #e2e8f0; }
  .brand-preview-block { flex: 1; transition: background .2s; }

  @media (max-width: 640px) { .color-slots { grid-template-columns: 1fr; } }
</style>` %>

<div class="page-wrapper">
  <div class="container" style="max-width:780px">
    <div class="page-header">
      <h1>Nouvelle institution partenaire</h1>
      <p style="opacity:.85;margin:0">Un compte administrateur sera créé et un email d'activation envoyé automatiquement.</p>
    </div>

    <%- include('../../partials/flash') %>

    <form action="/admin/institutions" method="POST">

      <div class="form-card">
        <h2>Informations de l'institution</h2>
        <div class="row g-3">
          <div class="col-md-12">
            <label class="form-label">Nom de l'institution <span class="required-mark">*</span></label>
            <input type="text" name="name" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Email de contact</label>
            <input type="email" name="contactEmail" class="form-control">
          </div>
          <div class="col-md-6">
            <label class="form-label">Téléphone</label>
            <input type="text" name="phone" class="form-control">
          </div>
          <div class="col-md-6">
            <label class="form-label">Ville</label>
            <input type="text" name="city" class="form-control" value="Ouagadougou">
          </div>
          <div class="col-md-6">
            <label class="form-label">Pays</label>
            <input type="text" name="country" class="form-control" value="Burkina Faso">
          </div>
          <div class="col-md-12">
            <label class="form-label">URL du logo</label>
            <input type="url" name="logoUrl" class="form-control" placeholder="https://...">
          </div>
          <div class="col-md-12">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="3"></textarea>
          </div>
        </div>
      </div>

      <!-- Brand colors -->
      <div class="form-card">
        <h2>🎨 Couleurs de la marque</h2>
        <p class="text-muted small mb-3">Choisissez jusqu'à 3 couleurs qui définissent l'identité visuelle de l'institution. Seule la couleur principale est obligatoire.</p>

        <div class="color-slots">
          <!-- Color 1 — primary (required) -->
          <div class="color-slot">
            <span class="color-slot-label">Couleur principale <span style="color:#dc3545;">*</span></span>
            <div class="color-picker-row">
              <input type="color" class="swatch" id="swatch1" value="#0e7490">
              <input type="text" name="primaryColor" id="hex1" class="hex-input" value="#0e7490" maxlength="7" placeholder="#0e7490">
            </div>
          </div>

          <!-- Color 2 — secondary (optional) -->
          <div class="color-slot">
            <span class="color-slot-label">Couleur secondaire <span class="color-slot-optional">(optionnel)</span></span>
            <div class="color-picker-row">
              <input type="color" class="swatch" id="swatch2" value="#0e7490">
              <input type="text" name="secondaryColor" id="hex2" class="hex-input" value="" maxlength="7" placeholder="—">
              <button type="button" class="clear-btn" onclick="clearColor(2)" title="Effacer">×</button>
            </div>
          </div>

          <!-- Color 3 — accent (optional) -->
          <div class="color-slot">
            <span class="color-slot-label">Couleur d'accent <span class="color-slot-optional">(optionnel)</span></span>
            <div class="color-picker-row">
              <input type="color" class="swatch" id="swatch3" value="#0e7490">
              <input type="text" name="accentColor" id="hex3" class="hex-input" value="" maxlength="7" placeholder="—">
              <button type="button" class="clear-btn" onclick="clearColor(3)" title="Effacer">×</button>
            </div>
          </div>
        </div>

        <!-- Live preview -->
        <div class="brand-preview" id="brandPreview">
          <div class="brand-preview-block" id="preview1" style="background:#0e7490;"></div>
          <div class="brand-preview-block" id="preview2" style="background:#e2e8f0;opacity:.4;"></div>
          <div class="brand-preview-block" id="preview3" style="background:#e2e8f0;opacity:.4;"></div>
        </div>
        <p class="text-muted" style="font-size:.75rem;margin-top:.5rem;">Aperçu des couleurs choisies</p>
      </div>

      <div class="form-card">
        <h2>Compte administrateur de l'institution</h2>
        <p class="text-muted small mb-3">Ce compte recevra un email d'activation avec un mot de passe temporaire.</p>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Prénom <span class="required-mark">*</span></label>
            <input type="text" name="adminName" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Nom <span class="required-mark">*</span></label>
            <input type="text" name="adminSurname" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Nom d'utilisateur <span class="required-mark">*</span></label>
            <input type="text" name="adminUsername" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Email <span class="required-mark">*</span></label>
            <input type="email" name="adminEmail" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Genre <span class="required-mark">*</span></label>
            <select name="adminGender" class="form-select" required>
              <option value="">-- Sélectionner --</option>
              <option value="male">Homme</option>
              <option value="female">Femme</option>
              <option value="other">Autre</option>
            </select>
          </div>
        </div>
      </div>

      <div class="d-flex gap-2 justify-content-end">
        <a href="/admin/institutions" class="btn btn-outline-secondary">Annuler</a>
        <button type="submit" class="btn btn-primary px-4">Créer l'institution</button>
      </div>
    </form>
  </div>
</div>

<script>
(function () {
  const IS_HEX = /^#[0-9a-fA-F]{6}$/;

  function wireColor(n, defaultColor) {
    const swatch = document.getElementById('swatch' + n);
    const hex    = document.getElementById('hex' + n);
    const prev   = document.getElementById('preview' + n);

    function applyColor(val) {
      const valid = IS_HEX.test(val);
      prev.style.background = valid ? val : '#e2e8f0';
      prev.style.opacity    = (n > 1 && !valid) ? '0.3' : '1';
    }

    swatch.addEventListener('input', function () {
      hex.value = this.value;
      applyColor(this.value);
    });

    hex.addEventListener('input', function () {
      const v = this.value.trim();
      if (IS_HEX.test(v)) { swatch.value = v; applyColor(v); }
      else applyColor('');
    });

    applyColor(hex.value || defaultColor || '');
  }

  wireColor(1, '#0e7490');
  wireColor(2, '');
  wireColor(3, '');

  window.clearColor = function (n) {
    document.getElementById('hex' + n).value   = '';
    document.getElementById('swatch' + n).value = '#0e7490';
    document.getElementById('preview' + n).style.background = '#e2e8f0';
    document.getElementById('preview' + n).style.opacity    = '0.3';
  };
})();
</script>
