<% layout('layouts/main') %>

<% headContent = `<style>
  .page-wrapper { margin-top: 80px; padding: 2rem 0 4rem; min-height: calc(100vh - 200px); }
  .page-header { background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%); color: white; padding: 2rem; border-radius: 16px; margin-bottom: 2rem; }
  .page-header h1 { margin: 0 0 0.25rem; font-size: 1.8rem; font-weight: 700; }
  .page-header p { margin: 0; opacity: 0.85; }
  .filter-bar { background: #fff; border-radius: 12px; padding: 1rem 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,.06); margin-bottom: 1.5rem; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
  .institution-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,.06); padding: 1.25rem 1.5rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 1.25rem; transition: box-shadow .2s; }
  .institution-card:hover { box-shadow: 0 4px 16px rgba(93,6,186,.12); }
  .inst-logo { width: 52px; height: 52px; border-radius: 10px; object-fit: cover; background: #ede8f8; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 700; color: #5d06ba; flex-shrink: 0; }
  .inst-info { flex: 1; min-width: 0; }
  .inst-name { font-weight: 700; font-size: 1.05rem; color: #1a1a2e; margin: 0 0 .2rem; }
  .inst-meta { font-size: .83rem; color: #666; margin: 0; }
  .badge-active { background: #d1fae5; color: #065f46; padding: .2rem .6rem; border-radius: 20px; font-size: .78rem; font-weight: 600; }
  .badge-inactive { background: #fee2e2; color: #991b1b; padding: .2rem .6rem; border-radius: 20px; font-size: .78rem; font-weight: 600; }
  .empty-state { text-align: center; padding: 3rem; color: #888; }
</style>` %>

<div class="page-wrapper">
  <div class="container">
    <div class="page-header">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <h1>Institutions partenaires</h1>
          <p>Gérer les institutions et leurs accès aux cours AfroHK</p>
        </div>
        <a href="/admin/institutions/new" class="btn btn-light fw-semibold">+ Nouvelle institution</a>
      </div>
    </div>

    <%- include('../../partials/flash') %>

    <div class="filter-bar">
      <span class="fw-semibold text-secondary me-1">Filtrer :</span>
      <a href="/admin/institutions" class="btn btn-sm <%= !filters.active ? 'btn-primary' : 'btn-outline-secondary' %>">Toutes</a>
      <a href="/admin/institutions?active=true" class="btn btn-sm <%= filters.active === 'true' ? 'btn-success' : 'btn-outline-secondary' %>">Actives</a>
      <a href="/admin/institutions?active=false" class="btn btn-sm <%= filters.active === 'false' ? 'btn-danger' : 'btn-outline-secondary' %>">Inactives</a>
      <span class="ms-auto text-secondary small"><%= institutions.length %> institution(s)</span>
    </div>

    <% if (institutions.length === 0) { %>
      <div class="empty-state">
        <p style="font-size:3rem">🏫</p>
        <p>Aucune institution pour l'instant.</p>
        <a href="/admin/institutions/new" class="btn btn-primary">Créer la première institution</a>
      </div>
    <% } else { %>
      <% institutions.forEach(inst => { %>
        <div class="institution-card">
          <% if (inst.logoUrl) { %>
            <img src="<%= inst.logoUrl %>" alt="<%= inst.name %>" class="inst-logo" style="width:52px;height:52px;border-radius:10px;object-fit:cover;">
          <% } else { %>
            <div class="inst-logo"><%= inst.name.charAt(0).toUpperCase() %></div>
          <% } %>
          <div class="inst-info">
            <p class="inst-name"><%= inst.name %></p>
            <p class="inst-meta">
              <%= inst.city %><% if (inst.city && inst.country) { %>, <% } %><%= inst.country %>
              &nbsp;·&nbsp;
              <%= inst.admins.length %> admin(s)
              &nbsp;·&nbsp;
              <% if (inst.contactEmail) { %><%= inst.contactEmail %><% } %>
            </p>
          </div>
          <span class="<%= inst.isActive ? 'badge-active' : 'badge-inactive' %>">
            <%= inst.isActive ? 'Active' : 'Inactive' %>
          </span>
          <a href="/admin/institutions/<%= inst._id %>" class="btn btn-sm btn-outline-primary ms-2">Voir</a>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>
