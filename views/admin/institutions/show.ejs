<% layout('layouts/main') %>
<%
  const brand    = institution.primaryColor  || '#5d06ba';
  const brandDark = 'color-mix(in srgb, ' + brand + ' 65%, #000)';
  const hasSocial = institution.socialMedia &&
    Object.values(institution.socialMedia).some(v => v && v.trim());
%>

<% headContent = `<style>
  :root { --brand: ${brand}; }

  /* ── page shell ── */
  .page-wrapper { margin-top: 70px; padding: 0 0 5rem; background: #f0f2f5; min-height: 100vh; }

  /* ── hero header ── */
  .inst-hero {
    background: linear-gradient(120deg, color-mix(in srgb, var(--brand) 80%, #000) 0%, var(--brand) 55%, color-mix(in srgb, var(--brand) 70%, #1a1a2e) 100%);
    padding: 2.5rem 0 0;
    position: relative;
    overflow: hidden;
  }
  .inst-hero::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 60% 80% at 80% 20%, rgba(255,255,255,.08), transparent);
    pointer-events: none;
  }
  .inst-hero-inner {
    display: flex; align-items: flex-start; gap: 1.5rem; flex-wrap: wrap;
    padding-bottom: 1.75rem;
  }
  .inst-logo-wrap {
    width: 80px; height: 80px; border-radius: 18px;
    background: rgba(255,255,255,.15); border: 2px solid rgba(255,255,255,.25);
    display: flex; align-items: center; justify-content:center;
    overflow: hidden; flex-shrink: 0;
  }
  .inst-logo-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .inst-logo-initials { font-size: 1.7rem; font-weight: 900; color: #fff; letter-spacing: -.03em; }
  .inst-hero-meta { flex: 1; min-width: 200px; }
  .inst-hero-meta h1 { font-size: 1.9rem; font-weight: 800; color: #fff; margin: 0 0 .3rem; line-height: 1.2; }
  .inst-hero-meta .location { color: rgba(255,255,255,.7); font-size: .88rem; margin-bottom: .75rem; }
  .inst-hero-meta .chips { display: flex; gap: .5rem; flex-wrap: wrap; }
  .chip { display: inline-flex; align-items: center; gap: .3rem; font-size: .75rem; font-weight: 700; padding: .28rem .75rem; border-radius: 20px; }
  .chip-active   { background: rgba(22,163,74,.25);  color: #bbf7d0; border: 1px solid rgba(22,163,74,.4); }
  .chip-inactive { background: rgba(239,68,68,.2);   color: #fecaca; border: 1px solid rgba(239,68,68,.35); }
  .chip-slug     { background: rgba(255,255,255,.1); color: rgba(255,255,255,.75); border: 1px solid rgba(255,255,255,.18); font-family: monospace; }
  .inst-hero-actions { display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; padding-top:.25rem; }

  /* ── stat strip ── */
  .stat-strip {
    background: rgba(0,0,0,.18);
    backdrop-filter: blur(8px);
    border-top: 1px solid rgba(255,255,255,.1);
    padding: .75rem 0;
  }
  .stat-strip-inner { display: flex; gap: 2rem; flex-wrap: wrap; }
  .stat-item { display: flex; align-items: center; gap: .65rem; }
  .stat-icon { width: 36px; height: 36px; border-radius: 10px; background: rgba(255,255,255,.12); display: flex; align-items:center; justify-content:center; font-size: 1rem; flex-shrink:0; }
  .stat-text .num { font-size: 1.25rem; font-weight: 800; color: #fff; line-height: 1; }
  .stat-text .lbl { font-size: .7rem; color: rgba(255,255,255,.6); letter-spacing:.03em; }

  /* ── cards ── */
  .sc { background: #fff; border-radius: 18px; box-shadow: 0 2px 14px rgba(0,0,0,.07); margin-bottom: 1.25rem; overflow: hidden; }
  .sc-head { padding: 1.1rem 1.5rem; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .sc-head .sc-title { font-size: .9rem; font-weight: 800; color: #1d1d1f; }
  .sc-body { padding: 1.35rem 1.5rem; }

  /* ── info table ── */
  .info-row { display: flex; align-items: flex-start; padding: .65rem 0; border-bottom: 1px solid #f8fafc; gap: 1rem; }
  .info-row:last-child { border-bottom: none; }
  .info-label { font-size: .78rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; min-width: 120px; padding-top: .05rem; }
  .info-value { font-size: .88rem; color: #374151; flex: 1; }
  .info-value a { color: var(--brand); text-decoration: none; }
  .info-value a:hover { text-decoration: underline; }
  code { background: #f3f4f6; padding: .1rem .45rem; border-radius: 5px; font-size: .82rem; color: #374151; }

  /* ── color swatches ── */
  .color-swatch { display: inline-block; width: 18px; height: 18px; border-radius: 5px; border: 1px solid rgba(0,0,0,.12); vertical-align: middle; margin-right: .4rem; }

  /* ── person rows ── */
  .person-row { display: flex; align-items: center; padding: .8rem 0; border-bottom: 1px solid #f8fafc; gap: .85rem; }
  .person-row:last-child { border-bottom: none; }
  .person-avatar {
    width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: .9rem; color: #fff; background: var(--brand);
  }
  .person-avatar img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
  .person-name { font-weight: 700; font-size: .88rem; color: #1d1d1f; line-height: 1.3; }
  .person-sub  { font-size: .76rem; color: #94a3b8; }
  .person-title-chip { font-size: .72rem; color: var(--brand); font-weight: 600; }

  /* ── status badges ── */
  .badge-v  { background: #dcfce7; color: #15803d; padding: .2rem .65rem; border-radius: 20px; font-size: .7rem; font-weight: 700; white-space: nowrap; }
  .badge-p  { background: #fef9c3; color: #92400e; padding: .2rem .65rem; border-radius: 20px; font-size: .7rem; font-weight: 700; white-space: nowrap; }

  /* ── cta quick-access card ── */
  .quick-link { display: flex; align-items: center; gap: .75rem; padding: .85rem 1rem; border-radius: 12px; background: #f8fafc; border: 1px solid #e2e8f0; text-decoration: none; transition: background .15s, border-color .15s; margin-bottom: .6rem; }
  .quick-link:last-child { margin-bottom: 0; }
  .quick-link:hover { background: #f0f2ff; border-color: var(--brand); }
  .quick-link .ql-icon { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0; }
  .quick-link .ql-text .title { font-size: .85rem; font-weight: 700; color: #1d1d1f; }
  .quick-link .ql-text .sub   { font-size: .75rem; color: #94a3b8; }
  .quick-link .ql-arrow { margin-left: auto; color: #cbd5e1; font-size: .8rem; }

  /* ── instructor create form ── */
  .create-form-wrap { background: #f8f5ff; border-radius: 12px; padding: 1.25rem; border: 1px solid #ede8f8; margin-bottom: 1.25rem; display: none; }
  .create-form-wrap.open { display: block; }

  /* ── empty state ── */
  .empty-hint { font-size: .83rem; color: #94a3b8; text-align: center; padding: 1.25rem 0; }

  /* ── social links ── */
  .social-row { display: flex; flex-wrap: wrap; gap: .5rem; }
  .social-pill { display: inline-flex; align-items: center; gap: .4rem; font-size: .78rem; padding: .3rem .8rem; border-radius: 20px; background: #f3f4f6; color: #374151; text-decoration: none; border: 1px solid #e2e8f0; }
  .social-pill:hover { background: #e5e7eb; }

  @media (max-width: 576px) {
    .inst-hero-meta h1 { font-size: 1.5rem; }
    .stat-strip-inner { gap: 1.25rem; }
  }
</style>` %>

<div class="page-wrapper">

  <!-- Hero -->
  <div class="inst-hero">
    <div class="container">
      <div class="inst-hero-inner">
        <div class="inst-logo-wrap">
          <% if (institution.logoUrl) { %>
            <img src="<%= institution.logoUrl %>" alt="<%= institution.name %>">
          <% } else { %>
            <span class="inst-logo-initials"><%= institution.name.substring(0,2).toUpperCase() %></span>
          <% } %>
        </div>
        <div class="inst-hero-meta">
          <h1><%= institution.name %></h1>
          <% if (institution.city || institution.country) { %>
            <p class="location">📍 <%= [institution.city, institution.country].filter(Boolean).join(', ') %></p>
          <% } %>
          <div class="chips">
            <span class="chip <%= institution.isActive ? 'chip-active' : 'chip-inactive' %>">
              <%= institution.isActive ? '● Active' : '● Inactive' %>
            </span>
            <span class="chip chip-slug"><%= institution.slug %></span>
          </div>
        </div>
        <div class="inst-hero-actions">
          <button class="btn btn-sm" style="background:rgba(255,255,255,.18);color:#fff;border:1px solid rgba(255,255,255,.3);font-weight:700;" onclick="document.getElementById('createInstrForm').classList.toggle('open');this.closest('.page-wrapper').querySelector('#createInstrForm').scrollIntoView({behavior:'smooth',block:'center'})">
            + Instructeur
          </button>
          <a href="/admin/institutions/<%= institution._id %>/edit" class="btn btn-sm" style="background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.22);">✏️ Modifier</a>
          <form action="/admin/institutions/<%= institution._id %>/toggle?_method=POST" method="POST" style="display:inline">
            <button type="submit" class="btn btn-sm" style="background:rgba(255,255,255,.1);color:<%= institution.isActive ? '#fca5a5' : '#bbf7d0' %>;border:1px solid <%= institution.isActive ? 'rgba(239,68,68,.4)' : 'rgba(22,163,74,.4)' %>;">
              <%= institution.isActive ? '⏸ Désactiver' : '▶ Activer' %>
            </button>
          </form>
          <a href="/admin/institutions" class="btn btn-sm" style="background:rgba(0,0,0,.2);color:rgba(255,255,255,.7);border:1px solid rgba(255,255,255,.1);">← Retour</a>
        </div>
      </div>
    </div>

    <!-- Stat strip -->
    <div class="stat-strip">
      <div class="container">
        <div class="stat-strip-inner">
          <div class="stat-item">
            <div class="stat-icon">📚</div>
            <div class="stat-text">
              <div class="num"><%= courseCount %></div>
              <div class="lbl">COURS CRÉÉS</div>
            </div>
          </div>
          <div class="stat-item">
            <div class="stat-icon">🎓</div>
            <div class="stat-text">
              <div class="num"><%= studentCount %></div>
              <div class="lbl">ÉTUDIANTS</div>
            </div>
          </div>
          <div class="stat-item">
            <div class="stat-icon">👤</div>
            <div class="stat-text">
              <div class="num"><%= institution.admins.length %></div>
              <div class="lbl">ADMINS</div>
            </div>
          </div>
          <div class="stat-item">
            <div class="stat-icon">🏫</div>
            <div class="stat-text">
              <div class="num"><%= instructors.length %></div>
              <div class="lbl">INSTRUCTEURS</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container" style="padding-top: 2rem;">
    <div class="row g-3">

      <!-- ── LEFT COLUMN ─────────────────────────────────────────────── -->
      <div class="col-lg-8">

        <!-- Quick access -->
        <div class="sc">
          <div class="sc-head"><span class="sc-title">🔗 Accès rapide</span></div>
          <div class="sc-body" style="padding: 1rem 1.25rem;">
            <a href="/institution/dashboard/content?institutionId=<%= institution._id %>" class="quick-link">
              <div class="ql-icon" style="background:#f5f0ff;">📝</div>
              <div class="ql-text">
                <div class="title">Gestion du contenu</div>
                <div class="sub">Créer et modifier les cours, modules et leçons</div>
              </div>
              <span class="ql-arrow">→</span>
            </a>
            <a href="/institution/dashboard?institutionId=<%= institution._id %>" class="quick-link">
              <div class="ql-icon" style="background:#f0fdf4;">📊</div>
              <div class="ql-text">
                <div class="title">Tableau de bord institution</div>
                <div class="sub">Voir les étudiants, inscriptions et progression</div>
              </div>
              <span class="ql-arrow">→</span>
            </a>
            <a href="/admin/users?institutionId=<%= institution._id %>" class="quick-link">
              <div class="ql-icon" style="background:#fff7ed;">🎓</div>
              <div class="ql-text">
                <div class="title">Étudiants (<%= studentCount %>)</div>
                <div class="sub">Voir tous les comptes étudiants de cette institution</div>
              </div>
              <span class="ql-arrow">→</span>
            </a>
          </div>
        </div>

        <!-- Informations -->
        <div class="sc">
          <div class="sc-head"><span class="sc-title">ℹ️ Informations</span></div>
          <div class="sc-body">
            <div class="info-row">
              <span class="info-label">Email</span>
              <span class="info-value">
                <% if (institution.contactEmail) { %>
                  <a href="mailto:<%= institution.contactEmail %>"><%= institution.contactEmail %></a>
                <% } else { %>—<% } %>
              </span>
            </div>
            <div class="info-row">
              <span class="info-label">Téléphone</span>
              <span class="info-value">
                <% if (institution.phone) { %><a href="tel:<%= institution.phone %>"><%= institution.phone %></a><% } else { %>—<% } %>
              </span>
            </div>
            <div class="info-row">
              <span class="info-label">Slug</span>
              <span class="info-value"><code><%= institution.slug %></code></span>
            </div>
            <div class="info-row">
              <span class="info-label">Créée le</span>
              <span class="info-value"><%= institution.createdAt.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' }) %></span>
            </div>
            <div class="info-row">
              <span class="info-label">Couleurs</span>
              <span class="info-value">
                <span class="color-swatch" style="background:<%= institution.primaryColor || '#5d06ba' %>;"></span>Principal
                <% if (institution.secondaryColor) { %>
                  &nbsp;&nbsp;<span class="color-swatch" style="background:<%= institution.secondaryColor %>;"></span>Secondaire
                <% } %>
                <% if (institution.accentColor) { %>
                  &nbsp;&nbsp;<span class="color-swatch" style="background:<%= institution.accentColor %>;"></span>Accent
                <% } %>
              </span>
            </div>
            <% if (institution.description) { %>
            <div class="info-row">
              <span class="info-label">Description</span>
              <span class="info-value" style="font-style:italic;color:#64748b;"><%= institution.description %></span>
            </div>
            <% } %>
            <% if (hasSocial) { %>
            <div class="info-row">
              <span class="info-label">Réseaux</span>
              <span class="info-value">
                <div class="social-row">
                  <% const sm = institution.socialMedia || {}; %>
                  <% if (sm.website)   { %><a href="<%= sm.website %>"   target="_blank" class="social-pill">🌐 Site web</a><% } %>
                  <% if (sm.facebook)  { %><a href="<%= sm.facebook %>"  target="_blank" class="social-pill">📘 Facebook</a><% } %>
                  <% if (sm.instagram) { %><a href="<%= sm.instagram %>" target="_blank" class="social-pill">📸 Instagram</a><% } %>
                  <% if (sm.twitter)   { %><a href="<%= sm.twitter %>"   target="_blank" class="social-pill">🐦 Twitter</a><% } %>
                  <% if (sm.linkedin)  { %><a href="<%= sm.linkedin %>"  target="_blank" class="social-pill">💼 LinkedIn</a><% } %>
                  <% if (sm.youtube)   { %><a href="<%= sm.youtube %>"   target="_blank" class="social-pill">▶ YouTube</a><% } %>
                  <% if (sm.whatsapp)  { %><a href="https://wa.me/<%= sm.whatsapp.replace(/\D/g,'') %>" target="_blank" class="social-pill">💬 WhatsApp</a><% } %>
                </div>
              </span>
            </div>
            <% } %>
          </div>
        </div>

        <!-- Instructors -->
        <div class="sc">
          <div class="sc-head">
            <span class="sc-title">🏫 Instructeurs (<%= instructors.length %>)</span>
          </div>

          <!-- Create form -->
          <div id="createInstrForm" class="create-form-wrap" style="margin:1rem 1.5rem 0;">
            <p class="fw-semibold mb-3" style="font-size:.88rem;">Nouveau compte instructeur pour <em><%= institution.name %></em></p>
            <form action="/admin/institutions/<%= institution._id %>/instructors" method="POST">
              <div class="row g-2 mb-2">
                <div class="col-md-4"><input type="text" name="name" class="form-control form-control-sm" placeholder="Prénom *" required></div>
                <div class="col-md-4"><input type="text" name="surname" class="form-control form-control-sm" placeholder="Nom *" required></div>
                <div class="col-md-4">
                  <select name="gender" class="form-select form-select-sm" required>
                    <option value="" disabled selected>Genre *</option>
                    <option value="male">Homme</option>
                    <option value="female">Femme</option>
                  </select>
                </div>
              </div>
              <div class="row g-2 mb-2">
                <div class="col-md-5"><input type="email" name="email" class="form-control form-control-sm" placeholder="Email *" required></div>
                <div class="col-md-4"><input type="text" name="username" class="form-control form-control-sm" placeholder="Nom d'utilisateur *" required></div>
                <div class="col-md-3"><input type="text" name="title" class="form-control form-control-sm" placeholder="Titre / Fonction"></div>
              </div>
              <div class="row g-2 mb-3">
                <div class="col-md-8"><input type="url" name="photoUrl" class="form-control form-control-sm" placeholder="URL de photo (optionnel)"></div>
              </div>
              <button type="submit" class="btn btn-sm btn-primary px-4">Créer et envoyer l'invitation</button>
            </form>
          </div>

          <div class="sc-body" style="padding-top:0;">
            <% if (!instructors || instructors.length === 0) { %>
              <p class="empty-hint">Aucun instructeur — créez-en un ci-dessus.</p>
            <% } else { %>
              <% instructors.forEach(instr => { %>
                <div class="person-row">
                  <% if (instr.photoUrl) { %>
                    <div class="person-avatar" style="background:transparent;padding:0;"><img src="<%= instr.photoUrl %>" alt="<%= instr.name %>"></div>
                  <% } else { %>
                    <div class="person-avatar"><%= (instr.name || 'I')[0].toUpperCase() %></div>
                  <% } %>
                  <div style="flex:1;min-width:0;">
                    <div class="person-name"><%= instr.name %> <% if (instr.userId && instr.userId.surname) { %><%= instr.userId.surname %><% } %></div>
                    <% if (instr.title) { %><div class="person-title-chip"><%= instr.title %></div><% } %>
                    <% if (instr.userId) { %>
                      <div class="person-sub">@<%= instr.userId.username %> · <%= instr.userId.email %></div>
                    <% } %>
                  </div>
                  <% if (instr.userId) { %>
                    <span class="<%= instr.userId.isVerified ? 'badge-v' : 'badge-p' %>">
                      <%= instr.userId.isVerified ? '✓ Vérifié' : '⏳ En attente' %>
                    </span>
                    <a href="/admin/users/<%= instr.userId._id %>/edit" class="btn btn-sm btn-outline-secondary ms-2" style="padding:.2rem .6rem;font-size:.78rem;">✎</a>
                  <% } %>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>

      </div>

      <!-- ── RIGHT COLUMN ────────────────────────────────────────────── -->
      <div class="col-lg-4">

        <!-- Admins -->
        <div class="sc">
          <div class="sc-head"><span class="sc-title">👤 Administrateurs (<%= institution.admins.length %>)</span></div>
          <div class="sc-body">
            <% if (institution.admins.length === 0) { %>
              <p class="empty-hint">Aucun administrateur assigné.</p>
            <% } else { %>
              <% institution.admins.forEach(admin => { %>
                <div class="person-row">
                  <div class="person-avatar"><%= (admin.name || '?')[0].toUpperCase() %></div>
                  <div style="flex:1;min-width:0;">
                    <div class="person-name"><%= admin.name %> <%= admin.surname %></div>
                    <div class="person-sub"><%= admin.email %></div>
                  </div>
                  <span class="<%= admin.isVerified ? 'badge-v' : 'badge-p' %>">
                    <%= admin.isVerified ? '✓ Vérifié' : '⏳ En attente' %>
                  </span>
                  <a href="/admin/users/<%= admin._id %>/edit" class="btn btn-sm btn-outline-secondary ms-2" style="padding:.2rem .6rem;font-size:.78rem;">✎</a>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>

        <!-- ID card -->
        <div class="sc">
          <div class="sc-head"><span class="sc-title">🔑 Identifiant système</span></div>
          <div class="sc-body">
            <div style="font-size:.75rem;color:#94a3b8;margin-bottom:.35rem;">Institution ID</div>
            <code style="font-size:.75rem;word-break:break-all;color:#374151;"><%= institution._id %></code>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
