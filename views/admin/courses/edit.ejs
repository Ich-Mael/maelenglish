<% layout('layouts/main') %>

<% headContent = `<style>
  .page-wrapper { margin-top: 80px; padding: 2rem 0 4rem; }
  .page-header { background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%); color: white; padding: 2rem; border-radius: 16px; margin-bottom: 2rem; }
  .page-header h1 { margin: 0; font-size: 1.8rem; font-weight: 700; }
  .form-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,.07); padding: 2rem; }
  .form-label { font-weight: 600; font-size: .9rem; }
</style>` %>

<div class="page-wrapper">
  <div class="container" style="max-width:780px">
    <div class="page-header">
      <h1>Modifier : <%= course.title %></h1>
    </div>

    <%- include('../../partials/flash') %>

    <div class="form-card">
      <form action="/admin/courses/<%= course._id %>?_method=PUT" method="POST">
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label">Titre</label>
            <input type="text" name="title" class="form-control" value="<%= course.title %>" required>
          </div>
          <div class="col-12">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="3"><%= course.description || '' %></textarea>
          </div>
          <div class="col-md-4">
            <label class="form-label">Niveau</label>
            <select name="level" class="form-select">
              <option value="beginner"     <%= course.level === 'beginner'     ? 'selected' : '' %>>Débutant</option>
              <option value="intermediate" <%= course.level === 'intermediate' ? 'selected' : '' %>>Intermédiaire</option>
              <option value="advanced"     <%= course.level === 'advanced'     ? 'selected' : '' %>>Avancé</option>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label">Prix (FCFA)</label>
            <input type="number" name="price" class="form-control" min="0" value="<%= course.price || 0 %>">
          </div>
          <div class="col-md-4">
            <label class="form-label">Statut</label>
            <div class="form-check mt-2">
              <input type="checkbox" name="isActive" id="isActive" class="form-check-input" <%= course.isActive ? 'checked' : '' %>>
              <label for="isActive" class="form-check-label">Cours actif</label>
            </div>
            <div class="form-check">
              <input type="checkbox" name="isPrivate" id="isPrivate" class="form-check-input" <%= course.isPrivate ? 'checked' : '' %>>
              <label for="isPrivate" class="form-check-label">Cours privé</label>
            </div>
          </div>
          <div class="col-12">
            <label class="form-label">Ce que l'étudiant apprendra</label>
            <textarea name="willLearn" class="form-control" rows="2"><%= course.willLearn || '' %></textarea>
          </div>
          <div class="col-12">
            <label class="form-label">Prérequis</label>
            <input type="text" name="requirements" class="form-control" value="<%= course.requirements || '' %>">
          </div>
          <div class="col-12">
            <label class="form-label">URL de l'image de couverture</label>
            <input type="url" name="courseImageUrl" class="form-control" value="<%= course.courseImageUrl || '' %>" placeholder="https://...">
          </div>
          <div class="col-12">
            <label class="form-label">Résumé du syllabus</label>
            <input type="text" name="syllabusSummary" class="form-control" value="<%= course.syllabusSummary || '' %>">
          </div>
        </div>
        <div class="d-flex gap-2 justify-content-end mt-4">
          <a href="/admin/courses/<%= course._id %>" class="btn btn-outline-secondary">Annuler</a>
          <button type="submit" class="btn btn-primary px-4">Enregistrer</button>
        </div>
      </form>
    </div>
  </div>
</div>
