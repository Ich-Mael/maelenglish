<% layout('layouts/main') %>

<% headContent = `<style>
  .page-wrapper { margin-top: 80px; padding: 2rem 0 4rem; }
  .page-header { background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%); color: white; padding: 2rem; border-radius: 16px; margin-bottom: 2rem; }
  .page-header h1 { margin: 0; font-size: 1.8rem; font-weight: 700; }
  .filter-bar { background: #fff; border-radius: 12px; padding: 1rem 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,.06); margin-bottom: 1.5rem; display: flex; gap: .75rem; align-items: center; flex-wrap: wrap; }
  .course-row { background: #fff; border-radius: 12px; box-shadow: 0 1px 6px rgba(0,0,0,.06); padding: 1.1rem 1.4rem; margin-bottom: .75rem; display: flex; align-items: center; gap: 1.25rem; transition: box-shadow .2s; }
  .course-row:hover { box-shadow: 0 3px 12px rgba(93,6,186,.1); }
  .course-img { width: 52px; height: 52px; border-radius: 10px; object-fit: cover; background: #ede8f8; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0; }
  .course-title { font-weight: 700; color: #1a1a2e; margin: 0 0 .15rem; }
  .course-meta { font-size: .8rem; color: #888; margin: 0; }
  .badge-active { background: #d1fae5; color: #065f46; padding: .15rem .55rem; border-radius: 20px; font-size: .75rem; font-weight: 600; }
  .badge-draft  { background: #f3f4f6; color: #6b7280; padding: .15rem .55rem; border-radius: 20px; font-size: .75rem; font-weight: 600; }
  .level-badge  { background: #ede8f8; color: #5d06ba; padding: .15rem .55rem; border-radius: 20px; font-size: .72rem; font-weight: 600; text-transform: capitalize; }
  .empty-state { text-align: center; padding: 3rem; color: #888; }
</style>` %>

<div class="page-wrapper">
  <div class="container">
    <div class="page-header">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <h1>Cours pour institutions</h1>
          <p style="opacity:.85;margin:.25rem 0 0">Cours créés pour les institutions partenaires</p>
        </div>
        <a href="/admin/courses/new" class="btn btn-light fw-semibold">+ Nouveau cours</a>
      </div>
    </div>

    <%- include('../../partials/flash') %>

    <form class="filter-bar" method="GET" action="/admin/courses">
      <input type="text" name="search" class="form-control form-control-sm" style="max-width:240px" placeholder="Rechercher…" value="<%= filters.search || '' %>">
      <select name="active" class="form-select form-select-sm" style="max-width:150px">
        <option value="">Tous les statuts</option>
        <option value="true"  <%= filters.active === 'true'  ? 'selected' : '' %>>Actifs</option>
        <option value="false" <%= filters.active === 'false' ? 'selected' : '' %>>Brouillons</option>
      </select>
      <button type="submit" class="btn btn-sm btn-primary">Filtrer</button>
      <a href="/admin/courses" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
      <span class="ms-auto text-muted small"><%= courses.length %> cours</span>
    </form>

    <% if (courses.length === 0) { %>
      <div class="empty-state">
        <p style="font-size:3rem">📚</p>
        <p>Aucun cours pour l'instant.</p>
        <a href="/admin/courses/new" class="btn btn-primary">Créer le premier cours</a>
      </div>
    <% } else { %>
      <% courses.forEach(course => { %>
        <div class="course-row">
          <% if (course.courseImageUrl) { %>
            <img src="<%= course.courseImageUrl %>" alt="" class="course-img" style="width:52px;height:52px;border-radius:10px;object-fit:cover;">
          <% } else { %>
            <div class="course-img">📖</div>
          <% } %>
          <div class="flex-grow-1 min-width-0">
            <p class="course-title"><%= course.title %></p>
            <p class="course-meta">
              <%= course.modules.length %> module(s) ·
              <%= course.students.length %> étudiant(s) inscrit(s)
              <% if (course.price) { %>· <%= course.price.toLocaleString('fr-FR') %> FCFA<% } %>
            </p>
          </div>
          <span class="level-badge"><%= course.level || 'beginner' %></span>
          <span class="<%= course.isActive ? 'badge-active' : 'badge-draft' %>">
            <%= course.isActive ? 'Actif' : 'Brouillon' %>
          </span>
          <a href="/admin/courses/<%= course._id %>" class="btn btn-sm btn-outline-primary ms-1">Voir</a>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>
