<% layout('layouts/main') %>

<% headContent = `<style>
  .page-wrapper { margin-top: 80px; padding: 2rem 0 4rem; }
  .page-header { background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%); color: white; padding: 2rem; border-radius: 16px; margin-bottom: 2rem; }
  .page-header h1 { margin: 0; font-size: 1.8rem; font-weight: 700; }
  .form-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,.07); padding: 2rem; }
  .form-label { font-weight: 600; font-size: .9rem; }
  .required-mark { color: #dc3545; }
</style>` %>

<div class="page-wrapper">
  <div class="container" style="max-width:780px">
    <div class="page-header">
      <h1>Nouveau cours</h1>
      <p style="opacity:.85;margin:.25rem 0 0">Ce cours sera disponible pour être assigné aux institutions partenaires.</p>
    </div>

    <%- include('../../partials/flash') %>

    <div class="form-card">
      <form action="/admin/courses" method="POST">
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label">Titre <span class="required-mark">*</span></label>
            <input type="text" name="title" class="form-control" required placeholder="Ex: English for Business Professionals">
          </div>
          <div class="col-12">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="3" placeholder="Décrivez le contenu et les objectifs de ce cours..."></textarea>
          </div>
          <div class="col-md-4">
            <label class="form-label">Niveau</label>
            <select name="level" class="form-select">
              <option value="beginner">Débutant</option>
              <option value="intermediate">Intermédiaire</option>
              <option value="advanced">Avancé</option>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label">Prix (FCFA) <span class="required-mark">*</span></label>
            <input type="number" name="price" class="form-control" min="0" required placeholder="0">
          </div>
          <div class="col-md-4">
            <label class="form-label">Visibilité</label>
            <div class="form-check mt-2">
              <input type="checkbox" name="isPrivate" id="isPrivate" class="form-check-input">
              <label for="isPrivate" class="form-check-label">Cours privé (institutions uniquement)</label>
            </div>
          </div>
          <div class="col-12">
            <label class="form-label">Ce que l'étudiant apprendra</label>
            <textarea name="willLearn" class="form-control" rows="2" placeholder="Compétences et connaissances acquises..."></textarea>
          </div>
          <div class="col-12">
            <label class="form-label">Prérequis</label>
            <input type="text" name="requirements" class="form-control" placeholder="Ex: Niveau A2 en anglais">
          </div>
          <div class="col-12">
            <label class="form-label">URL de l'image de couverture</label>
            <input type="url" name="courseImageUrl" class="form-control" placeholder="https://...">
          </div>
          <div class="col-12">
            <label class="form-label">Résumé du syllabus</label>
            <input type="text" name="syllabusSummary" class="form-control" placeholder="Ex: 4 modules, 2 évaluations, 1 projet final">
          </div>
        </div>
        <div class="d-flex gap-2 justify-content-end mt-4">
          <a href="/admin/courses" class="btn btn-outline-secondary">Annuler</a>
          <button type="submit" class="btn btn-primary px-4">Créer le cours</button>
        </div>
      </form>
    </div>
  </div>
</div>
