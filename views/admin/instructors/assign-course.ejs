<%- layout('layouts/main') %>

<style>
  .assign-course-page {
    margin-top: 100px;
    padding-bottom: 3rem;
    background: linear-gradient(to bottom, #f8f9fa 0%, #ffffff 100%);
    min-height: calc(100vh - 100px);
  }
  
  .page-header {
    background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
    color: white;
    padding: 2rem;
    border-radius: 20px;
    margin-bottom: 2rem;
    box-shadow: 0 10px 40px rgba(93, 6, 186, 0.3);
  }
  
  .page-header h2 {
    margin: 0;
    font-size: 2rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  
  .page-header p {
    margin: 0.5rem 0 0 0;
    opacity: 0.9;
  }
  
  .btn-back {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    border: 2px solid white;
    padding: 0.5rem 1.5rem;
    border-radius: 50px;
    font-weight: 600;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  
  .btn-back:hover {
    background: white;
    color: #5d06ba;
    text-decoration: none;
  }
  
  .form-card {
    background: white;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }
  
  .form-section {
    margin-bottom: 2rem;
  }
  
  .form-label {
    font-weight: 600;
    color: #2d0370;
    margin-bottom: 0.75rem;
    display: block;
    font-size: 1.1rem;
  }
  
  .required {
    color: #e74c3c;
  }
  
  .form-select {
    padding: 0.875rem;
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    transition: all 0.3s ease;
    width: 100%;
    font-size: 1rem;
  }
  
  .form-select:focus {
    border-color: #5d06ba;
    box-shadow: 0 0 0 3px rgba(93, 6, 186, 0.1);
    outline: none;
  }
  
  .form-text {
    font-size: 0.85rem;
    color: #666;
    margin-top: 0.5rem;
    display: block;
  }
  
  .empty-state {
    text-align: center;
    padding: 3rem 2rem;
    color: #666;
    background: #f8f9fa;
    border-radius: 12px;
    border: 2px dashed #e0e0e0;
  }
  
  .empty-state i {
    font-size: 3rem;
    color: #5d06ba;
    margin-bottom: 1rem;
  }
  
  .form-actions {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
    padding-top: 2rem;
    border-top: 2px solid #f0f0f0;
    margin-top: 2rem;
  }
  
  .btn {
    padding: 0.875rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .btn-primary {
    background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
    color: white;
  }
  
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(93, 6, 186, 0.3);
    color: white;
    text-decoration: none;
  }
  
  .btn-secondary {
    background: #e0e0e0;
    color: #333;
  }
  
  .btn-secondary:hover {
    background: #d0d0d0;
    text-decoration: none;
  }
  
  @media (max-width: 768px) {
    .form-actions {
      flex-direction: column;
    }
    
    .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<div class="assign-course-page">
  <div class="container px-4">
    <a href="/maelenglish/admin/instructors/<%= instructor._id %>" class="btn-back">
      <i class="bi bi-arrow-left"></i>
      Back to Profile
    </a>
    
    <div class="page-header">
      <h2>
        <i class="bi bi-plus-square"></i>
        Assign Course
      </h2>
      <p>Assign a course to <%= instructor.firstName %> <%= instructor.lastName %></p>
    </div>

    <div class="form-card">
      <% if (courses.length === 0) { %>
        <div class="empty-state">
          <i class="bi bi-inbox"></i>
          <h4>No Courses Available</h4>
          <p>There are no courses in the system yet. Please create a course first.</p>
        </div>
      <% } else { %>
        <form action="/maelenglish/admin/instructors/<%= instructor._id %>/assign-course" method="POST">
          <div class="form-section">
            <label for="courseId" class="form-label">
              <i class="bi bi-book"></i>
              Select Course <span class="required">*</span>
            </label>
            <select name="courseId" id="courseId" class="form-select" required>
              <option value="">-- Choose a course --</option>
              <% courses.forEach(course => { %>
                <option value="<%= course._id %>"><%= course.title || course.name %></option>
              <% }); %>
            </select>
            <small class="form-text">Select the course you want to assign to this coach</small>
          </div>

          <div class="form-actions">
            <a href="/maelenglish/admin/instructors/<%= instructor._id %>" class="btn btn-secondary">
              <i class="bi bi-x-circle"></i>
              Cancel
            </a>
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check-circle"></i>
              Assign Course
            </button>
          </div>
        </form>
      <% } %>
    </div>
  </div>
</div>
