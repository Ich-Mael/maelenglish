<%- layout('layouts/main') %>

<style>
  .instructor-detail-page {
    margin-top: 100px;
    padding-bottom: 3rem;
    background: linear-gradient(to bottom, #f8f9fa 0%, #ffffff 100%);
    min-height: calc(100vh - 100px);
  }
  
  .page-header {
    background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
    color: white;
    padding: 2rem;
    border-radius: 20px;
    margin-bottom: 2rem;
    box-shadow: 0 10px 40px rgba(93, 6, 186, 0.3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  .btn-back {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    border: 2px solid white;
    padding: 0.5rem 1.5rem;
    border-radius: 50px;
    font-weight: 600;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .btn-back:hover {
    background: white;
    color: #5d06ba;
    text-decoration: none;
  }
  
  .profile-card {
    background: white;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    text-align: center;
    position: sticky;
    top: 120px;
  }
  
  .profile-avatar {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    border: 5px solid #5d06ba;
    margin-bottom: 1.5rem;
  }
  
  .profile-card h3 {
    margin: 0 0 0.5rem 0;
    color: #2d0370;
    font-size: 1.5rem;
    font-weight: 700;
  }
  
  .profile-card .email {
    color: #666;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  
  .role-badge {
    background: rgba(93, 6, 186, 0.1);
    color: #5d06ba;
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-weight: 600;
    display: inline-block;
    margin-bottom: 1.5rem;
  }
  
  .action-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .btn-action {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  
  .btn-edit {
    background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
    color: white;
  }
  
  .btn-edit:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(52, 152, 219, 0.3);
    color: white;
    text-decoration: none;
  }
  
  .btn-assign {
    background: linear-gradient(135deg, #2ecc71 0%, #27ae60 100%);
    color: white;
  }
  
  .btn-assign:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(46, 204, 113, 0.3);
    color: white;
    text-decoration: none;
  }
  
  .info-card {
    background: white;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    margin-bottom: 1.5rem;
  }
  
  .info-card h4 {
    color: #2d0370;
    font-weight: 700;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #f0f0f0;
  }
  
  .info-row {
    display: flex;
    padding: 1rem 0;
    border-bottom: 1px solid #f0f0f0;
  }
  
  .info-row:last-child {
    border-bottom: none;
  }
  
  .info-label {
    font-weight: 600;
    color: #2d0370;
    min-width: 150px;
  }
  
  .info-value {
    color: #666;
    flex: 1;
  }
  
  .spec-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .spec-badge {
    background: rgba(93, 6, 186, 0.1);
    color: #5d06ba;
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 600;
  }
  
  .course-card {
    background: #f8f9fa;
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1rem;
    border-left: 4px solid #5d06ba;
    transition: all 0.3s ease;
  }
  
  .course-card:hover {
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    transform: translateX(5px);
  }
  
  .course-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 1rem;
  }
  
  .course-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #2d0370;
    margin: 0 0 0.5rem 0;
  }
  
  .course-date {
    color: #666;
    font-size: 0.9rem;
  }
  
  .status-badge {
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.85rem;
  }
  
  .status-active {
    background: rgba(46, 204, 113, 0.1);
    color: #2ecc71;
  }
  
  .status-inactive {
    background: rgba(149, 165, 166, 0.1);
    color: #95a5a6;
  }
  
  .modules-section {
    margin-top: 1rem;
  }
  
  .modules-label {
    font-weight: 600;
    color: #2d0370;
    margin-bottom: 0.75rem;
    display: block;
  }
  
  .module-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .module-badge {
    background: white;
    color: #5d06ba;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    border: 2px solid #5d06ba;
  }
  
  .btn-unassign {
    background: rgba(231, 76, 60, 0.1);
    color: #e74c3c;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 1rem;
  }
  
  .btn-unassign:hover {
    background: #e74c3c;
    color: white;
  }
  
  .empty-state {
    text-align: center;
    padding: 3rem 2rem;
    color: #666;
  }
  
  .empty-state i {
    font-size: 3rem;
    color: #5d06ba;
    margin-bottom: 1rem;
  }
  
  @media (max-width: 768px) {
    .profile-card {
      position: relative;
      top: 0;
    }
    
    .page-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<div class="instructor-detail-page">
  <div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="page-header">
      <div>
        <h2 style="margin: 0; font-size: 2rem; font-weight: 700;">
          <i class="bi bi-person-badge"></i>
          <%= instructor.firstName %> <%= instructor.lastName %>
        </h2>
        <p style="margin: 0.5rem 0 0 0; opacity: 0.9;">English Coach Profile</p>
      </div>
      <a href="/programs/language-learning/admin/instructors" class="btn-back">
        <i class="bi bi-arrow-left"></i>
        Back to Coaches
      </a>
    </div>

    <div class="row">
      <!-- Profile Sidebar -->
      <div class="col-lg-4 mb-4">
        <div class="profile-card">
          <img src="<%= instructor.profileImage || instructor.userId.imageUrl %>" 
               alt="<%= instructor.firstName %>" 
               class="profile-avatar">
          <h3><%= instructor.firstName %> <%= instructor.lastName %></h3>
          <p class="email">
            <i class="bi bi-envelope"></i>
            <%= instructor.email %>
          </p>
          <span class="role-badge">
            <i class="bi bi-shield-check"></i>
            <%= instructor.userId.role %>
          </span>
          
          <div class="action-buttons">
            <a href="/programs/language-learning/admin/instructors/<%= instructor._id %>/edit" class="btn-action btn-edit">
              <i class="bi bi-pencil"></i>
              Edit Profile
            </a>
            <a href="/programs/language-learning/admin/instructors/<%= instructor._id %>/assign-course" class="btn-action btn-assign">
              <i class="bi bi-plus-square"></i>
              Assign Course
            </a>
          </div>
        </div>
      </div>

      <!-- Main Content -->
      <div class="col-lg-8">
        <!-- Details Card -->
        <div class="info-card">
          <h4>
            <i class="bi bi-info-circle"></i>
            Details
          </h4>
          
          <div class="info-row">
            <div class="info-label">Username</div>
            <div class="info-value"><%= instructor.userId.username %></div>
          </div>
          
          <div class="info-row">
            <div class="info-label">Specializations</div>
            <div class="info-value">
              <% if (instructor.specializations && instructor.specializations.length > 0) { %>
                <div class="spec-badges">
                  <% instructor.specializations.forEach(spec => { %>
                    <span class="spec-badge"><%= spec %></span>
                  <% }); %>
                </div>
              <% } else { %>
                <span class="text-muted">None specified</span>
              <% } %>
            </div>
          </div>
          
          <% if (instructor.bio) { %>
            <div class="info-row">
              <div class="info-label">Bio</div>
              <div class="info-value"><%= instructor.bio %></div>
            </div>
          <% } %>
        </div>

        <!-- Assigned Courses Card -->
        <div class="info-card">
          <h4>
            <i class="bi bi-book"></i>
            Assigned Courses (<%= instructor.assignedCourses.length %>)
          </h4>
          
          <% if (instructor.assignedCourses.length === 0) { %>
            <div class="empty-state">
              <i class="bi bi-inbox"></i>
              <p>No courses assigned yet</p>
              <a href="/programs/language-learning/admin/instructors/<%= instructor._id %>/assign-course" class="btn-action btn-assign" style="display: inline-flex;">
                <i class="bi bi-plus-square"></i>
                Assign First Course
              </a>
            </div>
          <% } else { %>
            <% instructor.assignedCourses.forEach(assignment => { %>
              <div class="course-card">
                <div class="course-header">
                  <div>
                    <h5 class="course-title"><%= assignment.courseId.name %></h5>
                    <p class="course-date">
                      <i class="bi bi-calendar"></i>
                      Assigned: <%= new Date(assignment.assignedDate).toLocaleDateString() %>
                    </p>
                  </div>
                  <span class="status-badge <%= assignment.status === 'active' ? 'status-active' : 'status-inactive' %>">
                    <%= assignment.status %>
                  </span>
                </div>
                
                <div class="modules-section">
                  <span class="modules-label">
                    <i class="bi bi-collection"></i>
                    Modules (<%= assignment.modulesAccess.length %>)
                  </span>
                  <div class="module-badges">
                    <% assignment.modulesAccess.forEach(module => { %>
                      <span class="module-badge"><%= module.name %></span>
                    <% }); %>
                  </div>
                </div>
                
                <form action="/programs/language-learning/admin/instructors/<%= instructor._id %>/unassign-course/<%= assignment.courseId._id %>?_method=DELETE" 
                      method="POST" 
                      onsubmit="return confirm('Are you sure you want to unassign this course?');">
                  <button type="submit" class="btn-unassign">
                    <i class="bi bi-x-circle"></i>
                    Unassign Course
                  </button>
                </form>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
