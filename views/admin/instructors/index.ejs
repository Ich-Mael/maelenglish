<%- layout('layouts/main') %>

<style>
  .instructor-page {
    margin-top: 100px;
    padding-bottom: 3rem;
    background: linear-gradient(to bottom, #f8f9fa 0%, #ffffff 100%);
    min-height: calc(100vh - 100px);
  }
  
  .page-header {
    background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
    color: white;
    padding: 2.5rem 2rem;
    border-radius: 20px;
    margin-bottom: 2rem;
    box-shadow: 0 10px 40px rgba(93, 6, 186, 0.3);
  }
  
  .page-header h2 {
    margin: 0 0 0.5rem 0;
    font-size: 2rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  
  .page-header p {
    margin: 0;
    opacity: 0.9;
  }
  
  .btn-add-instructor {
    background: white;
    color: #5d06ba;
    border: none;
    padding: 0.875rem 2rem;
    border-radius: 50px;
    font-weight: 600;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  }
  
  .btn-add-instructor:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
    color: #5d06ba;
    text-decoration: none;
  }
  
  .instructors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1.5rem;
  }
  
  .instructor-card {
    background: white;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
    border: 2px solid transparent;
  }
  
  .instructor-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 30px rgba(93, 6, 186, 0.15);
    border-color: #5d06ba;
  }
  
  .instructor-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #f0f0f0;
  }
  
  .instructor-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #5d06ba;
  }
  
  .instructor-info h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: #2d0370;
  }
  
  .instructor-info p {
    margin: 0.25rem 0 0 0;
    color: #666;
    font-size: 0.9rem;
  }
  
  .instructor-details {
    margin-bottom: 1rem;
  }
  
  .detail-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
  }
  
  .detail-row i {
    color: #5d06ba;
    width: 20px;
  }
  
  .specializations {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  
  .spec-badge {
    background: rgba(93, 6, 186, 0.1);
    color: #5d06ba;
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 600;
  }
  
  .status-badge {
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 600;
  }
  
  .status-active {
    background: rgba(46, 204, 113, 0.1);
    color: #2ecc71;
  }
  
  .status-inactive {
    background: rgba(149, 165, 166, 0.1);
    color: #95a5a6;
  }
  
  .instructor-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 2px solid #f0f0f0;
  }
  
  .btn-action {
    flex: 1;
    padding: 0.5rem;
    border-radius: 8px;
    border: none;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    text-decoration: none;
  }
  
  .btn-view {
    background: rgba(93, 6, 186, 0.1);
    color: #5d06ba;
  }
  
  .btn-view:hover {
    background: #5d06ba;
    color: white;
    text-decoration: none;
  }
  
  .btn-edit {
    background: rgba(52, 152, 219, 0.1);
    color: #3498db;
  }
  
  .btn-edit:hover {
    background: #3498db;
    color: white;
    text-decoration: none;
  }
  
  .btn-assign {
    background: rgba(46, 204, 113, 0.1);
    color: #2ecc71;
  }
  
  .btn-assign:hover {
    background: #2ecc71;
    color: white;
    text-decoration: none;
  }
  
  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: white;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }
  
  .empty-state i {
    font-size: 4rem;
    color: #5d06ba;
    margin-bottom: 1rem;
  }
  
  .empty-state h3 {
    color: #2d0370;
    margin-bottom: 0.5rem;
  }
  
  .empty-state p {
    color: #666;
    margin-bottom: 1.5rem;
  }
  
  @media (max-width: 768px) {
    .instructors-grid {
      grid-template-columns: 1fr;
    }
    
    .page-header {
      padding: 1.5rem;
    }
    
    .page-header h2 {
      font-size: 1.5rem;
    }
  }
</style>

<div class="instructor-page">
  <div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="page-header">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
          <h2>
            <i class="bi bi-person-badge"></i>
            English Coaches
          </h2>
          <p>Manage your English language instructors and their specializations</p>
        </div>
        <a href="/maelenglish/admin/instructors/new" class="btn-add-instructor">
          <i class="bi bi-plus-circle"></i>
          Add New Coach
        </a>
      </div>
    </div>

    <% if (instructors.length === 0) { %>
      <!-- Empty State -->
      <div class="empty-state">
        <i class="bi bi-person-badge"></i>
        <h3>No English Coaches Yet</h3>
        <p>Get started by adding your first English coach to the platform</p>
        <a href="/maelenglish/admin/instructors/new" class="btn-add-instructor">
          <i class="bi bi-plus-circle"></i>
          Add Your First Coach
        </a>
      </div>
    <% } else { %>
      <!-- Instructors Grid -->
      <div class="instructors-grid">
        <% instructors.forEach(instructor => { %>
          <div class="instructor-card">
            <!-- Header -->
            <div class="instructor-header">
              <img src="<%= instructor.profileImage || instructor.userId.imageUrl %>" 
                   alt="<%= instructor.firstName %>" 
                   class="instructor-avatar">
              <div class="instructor-info">
                <h3><%= instructor.firstName %> <%= instructor.lastName %></h3>
                <p><i class="bi bi-envelope"></i> <%= instructor.email %></p>
              </div>
            </div>
            
            <!-- Details -->
            <div class="instructor-details">
              <div class="detail-row">
                <i class="bi bi-book"></i>
                <strong>Courses:</strong>
                <span class="ms-auto"><%= instructor.assignedCourses.length %> assigned</span>
              </div>
              
              <div class="detail-row">
                <i class="bi bi-award"></i>
                <strong>Status:</strong>
                <% const activeCourses = instructor.assignedCourses.filter(c => c.status === 'active').length; %>
                <span class="ms-auto status-badge <%= activeCourses > 0 ? 'status-active' : 'status-inactive' %>">
                  <%= activeCourses > 0 ? 'Active' : 'Inactive' %>
                </span>
              </div>
              
              <% if (instructor.specializations && instructor.specializations.length > 0) { %>
                <div class="detail-row">
                  <i class="bi bi-star"></i>
                  <strong>Specializations:</strong>
                </div>
                <div class="specializations">
                  <% instructor.specializations.slice(0, 3).forEach(spec => { %>
                    <span class="spec-badge"><%= spec %></span>
                  <% }); %>
                  <% if (instructor.specializations.length > 3) { %>
                    <span class="spec-badge">+<%= instructor.specializations.length - 3 %> more</span>
                  <% } %>
                </div>
              <% } %>
            </div>
            
            <!-- Actions -->
            <div class="instructor-actions">
              <a href="/maelenglish/admin/instructors/<%= instructor._id %>" 
                 class="btn-action btn-view" title="View Details">
                <i class="bi bi-eye"></i>
                View
              </a>
              <a href="/maelenglish/admin/instructors/<%= instructor._id %>/edit" 
                 class="btn-action btn-edit" title="Edit Profile">
                <i class="bi bi-pencil"></i>
                Edit
              </a>
              <a href="/maelenglish/admin/instructors/<%= instructor._id %>/assign-course" 
                 class="btn-action btn-assign" title="Assign Course">
                <i class="bi bi-plus-square"></i>
                Assign
              </a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>
