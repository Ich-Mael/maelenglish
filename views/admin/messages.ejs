<% layout('layouts/main') %>

<% headContent = `<style>
  .page-wrapper { margin-top: 80px; padding: 2rem 0 4rem; min-height: calc(100vh - 200px); background: #f5f4f8; }
  .page-header { background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%); color: white; padding: 2rem; border-radius: 16px; margin-bottom: 2rem; }
  .page-header h1 { margin: 0 0 .25rem; font-size: 1.8rem; font-weight: 700; }
  .page-header p  { margin: 0; opacity: .85; }
  .msg-card { background: #fff; border-radius: 14px; box-shadow: 0 2px 8px rgba(0,0,0,.06); padding: 1.35rem 1.5rem; margin-bottom: 1rem; border-left: 4px solid transparent; transition: box-shadow .2s; }
  .msg-card.unread { border-left-color: #5d06ba; background: #fdfbff; }
  .msg-card:hover { box-shadow: 0 4px 16px rgba(93,6,186,.1); }
  .msg-meta { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; margin-bottom: .6rem; }
  .msg-name  { font-weight: 700; font-size: 1rem; color: #1a1a2e; }
  .msg-email { font-size: .83rem; color: #5d06ba; }
  .msg-date  { font-size: .78rem; color: #888; margin-left: auto; }
  .msg-body  { font-size: .9rem; color: #374151; line-height: 1.6; white-space: pre-wrap; word-break: break-word; }
  .badge-unread { background: #ede8f8; color: #5d06ba; padding: .15rem .55rem; border-radius: 20px; font-size: .72rem; font-weight: 700; }
  .badge-read   { background: #f1f5f9; color: #94a3b8; padding: .15rem .55rem; border-radius: 20px; font-size: .72rem; font-weight: 600; }
  .msg-actions  { display: flex; gap: .5rem; margin-top: .9rem; flex-wrap: wrap; }
  .empty-state  { text-align: center; padding: 4rem; color: #888; }
</style>` %>

<div class="page-wrapper">
  <div class="container">

    <div class="page-header">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <h1>Messages visiteurs</h1>
          <p>Formulaire de contact du site public</p>
        </div>
        <% if (unreadCount > 0) { %>
          <span style="background:rgba(255,255,255,.2);padding:.4rem 1rem;border-radius:20px;font-weight:700;font-size:.95rem;">
            <%= unreadCount %> non lu<%= unreadCount > 1 ? 's' : '' %>
          </span>
        <% } %>
      </div>
    </div>

    <%- include('../partials/flash') %>

    <% if (messages.length === 0) { %>
      <div class="empty-state">
        <p style="font-size:3rem">📭</p>
        <p>Aucun message pour l'instant.</p>
      </div>
    <% } else { %>
      <% messages.forEach(msg => { %>
        <div class="msg-card <%= msg.isRead ? '' : 'unread' %>">
          <div class="msg-meta">
            <span class="msg-name"><%= msg.name %></span>
            <a href="mailto:<%= msg.email %>" class="msg-email"><%= msg.email %></a>
            <% if (!msg.isRead) { %><span class="badge-unread">Nouveau</span><% } else { %><span class="badge-read">Lu</span><% } %>
            <span class="msg-date"><%= new Date(msg.createdAt).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
          </div>

          <div class="msg-body"><%= msg.message %></div>

          <div class="msg-actions">
            <% if (!msg.isRead) { %>
              <form action="/admin/messages/<%= msg._id %>/read" method="post">
                <button class="btn btn-sm btn-outline-primary">Marquer comme lu</button>
              </form>
            <% } else { %>
              <form action="/admin/messages/<%= msg._id %>/unread" method="post">
                <button class="btn btn-sm btn-outline-secondary">Marquer non lu</button>
              </form>
            <% } %>
            <a href="mailto:<%= msg.email %>?subject=Re: votre message AfroHK" class="btn btn-sm btn-primary">Répondre par email</a>
            <form action="/admin/messages/<%= msg._id %>?_method=DELETE" method="post" onsubmit="return confirm('Supprimer ce message ?')">
              <button class="btn btn-sm btn-outline-danger">Supprimer</button>
            </form>
          </div>
        </div>
      <% }) %>
    <% } %>

  </div>
</div>
