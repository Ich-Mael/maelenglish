<% layout('layouts/main') %>

<%
  const inst = course.institutionId || {};
  const brand = inst.primaryColor || '#5d06ba';

  function pricingLabel(pricing) {
    if (!pricing) return 'Sur demande';
    if (pricing.isFree) return 'Gratuit';
    if (pricing.amount) return pricing.amount.toLocaleString('fr-FR') + ' ' + (pricing.currency || 'FCFA');
    return 'Sur demande';
  }

  const priceText = pricingLabel(course.pricing);
  const isFree = course.pricing && course.pricing.isFree;
  const hasFinalExam = course.finalExam && course.finalExam.questions && course.finalExam.questions.length > 0;
  const hasFinalProject = course.finalProject && course.finalProject.title;
  const avgRating = testimonials.length
    ? (testimonials.reduce((s, t) => s + (t.rating || 0), 0) / testimonials.filter(t => t.rating).length).toFixed(1)
    : null;
%>

<% headContent = `<style>
  :root { --brand: ${brand}; }

  /* ── Hero ── */
  .cd-hero {
    margin-top: 70px;
    background: linear-gradient(135deg, #0f0720 0%, #1a0a38 100%);
    padding: 2.75rem 0 2.75rem;
    position: relative;
    overflow: hidden;
  }
  .cd-hero::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 80% 50%, color-mix(in srgb, ${brand} 20%, transparent) 0%, transparent 60%);
    pointer-events: none;
  }
  .cd-hero-grid {
    position: relative; z-index: 2;
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2.5rem;
    align-items: center;
  }
  .cd-hero-left { display: flex; flex-direction: column; align-items: flex-start; }
  .cd-back-link {
    display: inline-flex; align-items: center; gap: .45rem;
    font-size: .82rem; font-weight: 700;
    color: rgba(255,255,255,.85);
    background: rgba(255,255,255,.1);
    border: 1px solid rgba(255,255,255,.18);
    backdrop-filter: blur(8px);
    padding: .45rem 1rem .45rem .8rem;
    border-radius: 50px;
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: background .18s, color .18s;
  }
  .cd-back-link:hover { background: rgba(255,255,255,.2); color: #fff; }
  .cd-back-link .arrow { transition: transform .18s; }
  .cd-back-link:hover .arrow { transform: translateX(-3px); }
  .cd-inst-block {
    display: flex; align-items: center; gap: .85rem;
    margin-bottom: 1.1rem;
    text-decoration: none;
  }
  .cd-inst-logo {
    width: 56px; height: 56px; flex-shrink: 0;
    border-radius: 12px; background: #fff;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 16px rgba(0,0,0,.35);
    overflow: hidden;
  }
  .cd-inst-logo img { width: 100%; height: 100%; object-fit: contain; padding: 5px; }
  .cd-inst-logo .initials { font-size: 1.3rem; font-weight: 900; color: var(--brand); line-height: 1; }
  .cd-inst-label { font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: rgba(255,255,255,.4); margin-bottom: .15rem; }
  .cd-inst-name  { font-size: 1rem; font-weight: 800; color: #fff; line-height: 1.2; }
  .cd-inst-location { font-size: .75rem; color: rgba(255,255,255,.55); margin-top: .1rem; }
  .cd-inst-block:hover .cd-inst-name { text-decoration: underline; }
  .cd-title { font-size: 2rem; font-weight: 800; color: #fff; line-height: 1.25; margin: 0 0 1.1rem; }
  .cd-chips { display: flex; flex-wrap: wrap; gap: .5rem; }
  .cd-chip { display: inline-flex; align-items: center; gap: .35rem; font-size: .78rem; padding: .35rem .8rem; border-radius: 20px; font-weight: 600; }
  .cd-chip-price { background: var(--brand); color: #fff; }
  .cd-chip-price.free { background: #16a34a; }
  .cd-chip-price.demand { background: rgba(255,255,255,.12); color: rgba(255,255,255,.8); border: 1px solid rgba(255,255,255,.2); }
  .cd-chip-neutral { background: rgba(255,255,255,.1); color: rgba(255,255,255,.8); border: 1px solid rgba(255,255,255,.12); }
  /* right image panel */
  .cd-hero-img {
    aspect-ratio: 16/10;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 16px 48px rgba(0,0,0,.45);
    background: linear-gradient(135deg, color-mix(in srgb, ${brand} 60%, #000), #0f0720);
    display: flex; align-items: center; justify-content: center;
    position: relative;
  }
  .cd-hero-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cd-hero-img .no-img-icon { font-size: 4rem; opacity: .25; color: #fff; }
  @media (max-width: 900px) {
    .cd-hero-grid { grid-template-columns: 1fr; }
    .cd-hero-img { aspect-ratio: 16/7; border-radius: 14px; }
    .cd-title { font-size: 1.65rem; }
  }
  @media (max-width: 500px) {
    .cd-hero-img { aspect-ratio: 16/9; }
    .cd-title { font-size: 1.4rem; }
  }

  /* ── Stat bar ── */
  .cd-stat-bar { background: #fff; border-bottom: 1px solid #f1f5f9; padding: .9rem 0; }
  .cd-stat-bar .inner { display: flex; gap: 2rem; flex-wrap: wrap; align-items: center; }
  .cd-stat { display: flex; align-items: center; gap: .5rem; font-size: .85rem; color: #374151; }
  .cd-stat .icon { font-size: 1.05rem; }
  .cd-stat .val { font-weight: 700; color: #1d1d1f; }

  /* ── Body ── */
  .cd-body { padding: 3rem 0 5rem; background: #f8fafc; }
  .cd-main { max-width: 820px; }
  .cd-sidebar { width: 320px; flex-shrink: 0; }

  .cd-section { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,.06); padding: 1.75rem; margin-bottom: 1.5rem; }
  .cd-section h2 { font-size: 1.05rem; font-weight: 800; color: #1d1d1f; margin: 0 0 1.1rem; padding-bottom: .75rem; border-bottom: 2px solid #f1f5f9; }

  /* ── Modules accordion ── */
  .mod-item { border: 1px solid #e2e8f0; border-radius: 10px; margin-bottom: .6rem; overflow: hidden; }
  .mod-header { display: flex; align-items: center; justify-content: space-between; padding: .85rem 1rem; cursor: pointer; background: #fafafa; gap: .75rem; }
  .mod-header:hover { background: #f3f4f6; }
  .mod-num { width: 26px; height: 26px; border-radius: 50%; background: var(--brand); color: #fff; font-size: .72rem; font-weight: 800; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .mod-title { font-weight: 700; font-size: .9rem; color: #1d1d1f; flex: 1; }
  .mod-count { font-size: .75rem; color: #94a3b8; white-space: nowrap; }
  .mod-arrow { color: #94a3b8; font-size: .8rem; transition: transform .2s; }
  .mod-item.open .mod-arrow { transform: rotate(180deg); }
  .mod-lessons { display: none; padding: .75rem 1rem; border-top: 1px solid #f1f5f9; background: #fff; }
  .mod-item.open .mod-lessons { display: block; }
  .lesson-row { display: flex; align-items: center; gap: .6rem; padding: .45rem .25rem; font-size: .85rem; color: #374151; border-bottom: 1px solid #f9fafb; }
  .lesson-row:last-child { border-bottom: none; }
  .lesson-icon { color: #94a3b8; font-size: .85rem; width: 18px; text-align: center; flex-shrink: 0; }

  /* ── Prerequisites box ── */
  .prereq-box { background: #f5f3ff; border-left: 3px solid var(--brand); border-radius: 10px; padding: 1rem 1.25rem; }

  /* ── Instructor cards ── */
  .instr-card { display: flex; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid #f1f5f9; align-items: flex-start; }
  .instr-card:last-child { border-bottom: none; }
  .instr-avatar { width: 54px; height: 54px; border-radius: 50%; object-fit: cover; flex-shrink: 0; background: var(--brand); display:flex; align-items:center; justify-content:center; font-weight:800; color:#fff; font-size:1.2rem; }
  .instr-name { font-weight: 700; color: #1d1d1f; margin-bottom: .15rem; }
  .instr-title { font-size: .82rem; color: #64748b; margin-bottom: .4rem; }
  .instr-bio { font-size: .85rem; color: #374151; line-height: 1.5; }

  /* ── Testimonials ── */
  .testi-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
  .testi-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.1rem; }
  .testi-stars { color: #f59e0b; font-size: .85rem; margin-bottom: .5rem; }
  .testi-content { font-size: .88rem; color: #374151; line-height: 1.55; font-style: italic; margin-bottom: .75rem; }
  .testi-author { font-size: .8rem; font-weight: 700; color: #1d1d1f; }
  .testi-role { font-size: .75rem; color: #94a3b8; }

  /* ── Sticky CTA sidebar ── */
  .cta-card { background: #fff; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,.1); padding: 1.5rem; position: sticky; top: 90px; }
  .cta-price { font-size: 1.6rem; font-weight: 800; color: var(--brand); margin-bottom: .25rem; }
  .cta-price.free { color: #16a34a; }
  .cta-price.demand { font-size: 1.1rem; color: #64748b; }
  .cta-inst-name { font-size: .85rem; color: #64748b; margin-bottom: 1.25rem; }
  .cta-contact { margin-top: 1rem; font-size: .85rem; color: #374151; }
  .cta-contact a { color: var(--brand); font-weight: 600; text-decoration: none; word-break: break-all; }
  .cta-contact a:hover { text-decoration: underline; }
  .cta-divider { height: 1px; background: #f1f5f9; margin: 1rem 0; }

  @media (max-width: 900px) {
    .cd-layout { flex-direction: column; }
    .cd-sidebar { width: 100%; }
    .cta-card { position: static; }
  }
</style>` %>

<!-- Hero -->
<section class="cd-hero">
  <div class="container">
    <div class="cd-hero-grid">

      <!-- Left: text content -->
      <div class="cd-hero-left">
        <a href="/formations" class="cd-back-link"><span class="arrow">←</span> Retour au catalogue</a>
        <a href="/formations/institutions/<%= inst._id %>" class="cd-inst-block">
          <div class="cd-inst-logo">
            <% if (inst.logoUrl) { %>
              <img src="<%= inst.logoUrl %>" alt="<%= inst.name %>">
            <% } else { %>
              <span class="initials"><%= (inst.name || 'I').substring(0,2).toUpperCase() %></span>
            <% } %>
          </div>
          <div>
            <div class="cd-inst-label">Institution</div>
            <div class="cd-inst-name"><%= inst.name || 'Institution' %></div>
            <% if (inst.city || inst.country) { %>
              <div class="cd-inst-location">📍 <%= [inst.city, inst.country].filter(Boolean).join(', ') %></div>
            <% } %>
          </div>
        </a>
        <h1 class="cd-title"><%= course.title %></h1>
        <div class="cd-chips">
          <%
            let priceChipClass = 'cd-chip-price';
            if (isFree) priceChipClass += ' free';
            else if (priceText === 'Sur demande') priceChipClass += ' demand';
          %>
          <span class="cd-chip <%= priceChipClass %>">
            <%= isFree ? '🎓' : (priceText === 'Sur demande' ? '📋' : '💳') %> <%= priceText %>
          </span>
          <span class="cd-chip cd-chip-neutral">📚 <%= modules.length %> module<%= modules.length !== 1 ? 's' : '' %></span>
          <span class="cd-chip cd-chip-neutral">🎬 <%= totalLessons %> leçon<%= totalLessons !== 1 ? 's' : '' %></span>
          <% if (hasFinalExam) { %><span class="cd-chip cd-chip-neutral">📝 Examen final</span><% } %>
          <% if (hasFinalProject) { %><span class="cd-chip cd-chip-neutral">🎯 Projet final</span><% } %>
          <% if (avgRating) { %><span class="cd-chip cd-chip-neutral">⭐ <%= avgRating %>/5</span><% } %>
        </div>
      </div>

      <!-- Right: course image -->
      <div class="cd-hero-img">
        <% if (course.imageUrl) { %>
          <img src="<%= course.imageUrl %>" alt="<%= course.title %>">
        <% } else { %>
          <i class="bi bi-book-half no-img-icon"></i>
        <% } %>
      </div>

    </div>
  </div>
</section>

<!-- Body -->
<div class="cd-body">
  <div class="container">
    <div class="d-flex gap-4 cd-layout align-items-start">

      <!-- Main content -->
      <div class="cd-main flex-grow-1">

        <!-- Description -->
        <% if (course.description) { %>
        <div class="cd-section">
          <h2>À propos de ce cours</h2>
          <p style="color:#374151;line-height:1.7;font-size:.95rem;margin:0;"><%= course.description %></p>
        </div>
        <% } %>

        <!-- Prerequisites -->
        <% if (course.prerequisites) { %>
        <div class="cd-section">
          <h2>Prérequis</h2>
          <div class="prereq-box">
            <p style="margin:0;color:#374151;font-size:.9rem;line-height:1.6;"><%= course.prerequisites %></p>
          </div>
        </div>
        <% } %>

        <!-- Modules -->
        <% if (modules.length > 0) { %>
        <div class="cd-section">
          <h2>Contenu du cours</h2>
          <% modules.forEach((mod, idx) => { %>
            <div class="mod-item" id="mod-<%= idx %>">
              <div class="mod-header" onclick="toggleMod(<%= idx %>)">
                <span class="mod-num"><%= idx + 1 %></span>
                <span class="mod-title"><%= mod.title %></span>
                <span class="mod-count"><%= mod.lessons ? mod.lessons.length : 0 %> leçon<%= (mod.lessons && mod.lessons.length !== 1) ? 's' : '' %></span>
                <span class="mod-arrow">▼</span>
              </div>
              <% if (mod.lessons && mod.lessons.length > 0) { %>
              <div class="mod-lessons">
                <% mod.lessons.forEach(l => { %>
                  <div class="lesson-row">
                    <%
                      const icons = { video: '▶', text: '📄', pdf: '📎', practice_quiz: '✍' };
                      const icon = icons[l.type] || '·';
                    %>
                    <span class="lesson-icon"><%= icon %></span>
                    <span><%= l.title || 'Leçon sans titre' %></span>
                  </div>
                <% }) %>
                <% if (mod.quiz) { %>
                  <div class="lesson-row">
                    <span class="lesson-icon">📋</span>
                    <span style="color:#64748b;font-style:italic;">Quiz de module</span>
                  </div>
                <% } %>
                <% if (mod.assignment) { %>
                  <div class="lesson-row">
                    <span class="lesson-icon">📝</span>
                    <span style="color:#64748b;font-style:italic;">Devoir noté</span>
                  </div>
                <% } %>
              </div>
              <% } %>
            </div>
          <% }) %>
        </div>
        <% } %>

        <!-- Instructors -->
        <% if (course.instructors && course.instructors.length > 0) { %>
        <div class="cd-section">
          <h2>Votre équipe pédagogique</h2>
          <% course.instructors.forEach(instr => { %>
            <div class="instr-card">
              <% if (instr.photoUrl) { %>
                <img src="<%= instr.photoUrl %>" alt="<%= instr.name %>" class="instr-avatar" style="width:54px;height:54px;border-radius:50%;object-fit:cover;">
              <% } else { %>
                <div class="instr-avatar"><%= (instr.name || 'I').charAt(0).toUpperCase() %></div>
              <% } %>
              <div>
                <div class="instr-name"><%= instr.name %></div>
                <% if (instr.title) { %><div class="instr-title"><%= instr.title %></div><% } %>
                <% if (instr.bio) { %><div class="instr-bio"><%= instr.bio %></div><% } %>
              </div>
            </div>
          <% }) %>
        </div>
        <% } %>

        <!-- Testimonials -->
        <% if (testimonials.length > 0) { %>
        <div class="cd-section">
          <h2>Témoignages<% if (avgRating) { %> &nbsp;<span style="font-size:.85rem;font-weight:400;color:#94a3b8;">⭐ <%= avgRating %>/5 · <%= testimonials.length %> avis</span><% } %></h2>
          <div class="testi-grid">
            <% testimonials.forEach(t => { %>
              <div class="testi-card">
                <% if (t.rating) { %><div class="testi-stars"><%= '★'.repeat(t.rating) %><%= '☆'.repeat(5 - t.rating) %></div><% } %>
                <div class="testi-content">"<%= t.content %>"</div>
                <div class="testi-author"><%= t.authorName %></div>
                <% if (t.authorTitle) { %><div class="testi-role"><%= t.authorTitle %></div><% } %>
              </div>
            <% }) %>
          </div>
        </div>
        <% } %>

      </div>

      <!-- Sidebar -->
      <div class="cd-sidebar">
        <div class="cta-card">
          <div class="cta-price <%= isFree ? 'free' : (priceText === 'Sur demande' ? 'demand' : '') %>"><%= priceText %></div>
          <div class="cta-inst-name">Proposé par <strong><%= inst.name || 'l\'institution' %></strong></div>
          <a href="/formations/institutions/<%= inst._id %>" style="display:inline-flex;align-items:center;gap:.35rem;font-size:.78rem;font-weight:700;color:var(--brand);text-decoration:none;margin-top:.35rem;">
            Voir tous les cours →
          </a>

          <div class="cta-divider"></div>

          <div style="font-size:.85rem;font-weight:700;color:#374151;margin-bottom:.75rem;">Comment s'inscrire</div>
          <p style="font-size:.82rem;color:#64748b;line-height:1.5;margin-bottom:1rem;">Contactez directement l'institution pour vous inscrire à ce cours.</p>

          <% if (inst.contactEmail) { %>
            <div class="cta-contact">
              <span style="color:#94a3b8;font-size:.75rem;display:block;margin-bottom:.25rem;">Email</span>
              <a href="mailto:<%= inst.contactEmail %>"><%= inst.contactEmail %></a>
            </div>
          <% } %>

          <% if (inst.phone) { %>
            <div class="cta-contact" style="margin-top:.75rem;">
              <span style="color:#94a3b8;font-size:.75rem;display:block;margin-bottom:.25rem;">Téléphone</span>
              <a href="tel:<%= inst.phone %>"><%= inst.phone %></a>
            </div>
          <% } %>

          <% if (inst.city || inst.country) { %>
            <div class="cta-divider"></div>
            <div class="cta-contact">
              <span style="color:#94a3b8;font-size:.75rem;display:block;margin-bottom:.25rem;">Localisation</span>
              <span style="font-weight:600;"><%= [inst.city, inst.country].filter(Boolean).join(', ') %></span>
            </div>
          <% } %>

          <div class="cta-divider"></div>
          <a href="/formations" style="display:flex;align-items:center;justify-content:center;gap:.4rem;font-size:.82rem;font-weight:600;color:#64748b;text-decoration:none;padding:.5rem;border-radius:8px;transition:background .15s,color .15s;" onmouseover="this.style.background='#f1f5f9';this.style.color='#1e293b'" onmouseout="this.style.background='';this.style.color='#64748b'">
            <span style="font-size:.9rem;">←</span> Retour au catalogue
          </a>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
function toggleMod(idx) {
  const el = document.getElementById('mod-' + idx);
  el.classList.toggle('open');
}
</script>
