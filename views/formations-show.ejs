<% layout('layouts/main') %>

<%
  const inst = course.institutionId || {};
  const brand = inst.primaryColor || '#5d06ba';

  function pricingLabel(pricing) {
    if (!pricing) return 'Sur demande';
    if (pricing.isFree) return 'Gratuit';
    if (pricing.amount) return pricing.amount.toLocaleString('fr-FR') + ' ' + (pricing.currency || 'FCFA');
    return 'Sur demande';
  }

  const priceText = pricingLabel(course.pricing);
  const isFree    = course.pricing && course.pricing.isFree;
  const hasFinalExam    = course.finalExam && course.finalExam.questions && course.finalExam.questions.length > 0;
  const hasFinalProject = course.finalProject && course.finalProject.title;
  const avgRating = testimonials.length
    ? (testimonials.reduce((s, t) => s + (t.rating || 0), 0) / testimonials.filter(t => t.rating).length).toFixed(1)
    : null;

  const promoEmbed  = embedUrl(course.promoVideoUrl);
  const isDirectVid = promoEmbed && /\.(mp4|webm|ogv)/i.test(promoEmbed);

  const allPreviewLessons = [];
  const previewIcons = { video: '▶', text: '📄', pdf: '📎', practice_quiz: '✍' };
  modules.forEach(function(mod) {
    if (mod.lessons) mod.lessons.forEach(function(l) {
      if (l.isPreview) allPreviewLessons.push({ lesson: l, modTitle: mod.title });
    });
  });
%>

<% headContent = `<style>
  :root { --brand: ${brand}; }

  /* ── Hero ── */
  .cd-hero {
    margin-top: 70px;
    background: linear-gradient(150deg, #080414 0%, #160535 50%, #2a0760 100%);
    padding: 3rem 0 3.5rem;
    position: relative; overflow: hidden;
  }
  .cd-hero::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 75% 40%, color-mix(in srgb, ${brand} 22%, transparent) 0%, transparent 60%);
    pointer-events: none;
  }
  .cd-hero::after {
    content: '';
    position: absolute; bottom: -1px; left: 0; right: 0; height: 48px;
    background: linear-gradient(to bottom, transparent, #f4f6fb);
    pointer-events: none; z-index: 3;
  }
  .cd-hero-grid {
    position: relative; z-index: 2;
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2.5rem;
    align-items: center;
  }
  .cd-hero-left { display: flex; flex-direction: column; align-items: flex-start; }
  .cd-back-link {
    display: inline-flex; align-items: center; gap: .45rem;
    font-size: .8rem; font-weight: 700;
    color: rgba(255,255,255,.7);
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.14);
    backdrop-filter: blur(8px);
    padding: .4rem 1rem .4rem .75rem;
    border-radius: 50px; text-decoration: none;
    margin-bottom: 1.5rem;
    transition: background .18s, color .18s;
  }
  .cd-back-link:hover { background: rgba(255,255,255,.16); color: #fff; }
  .cd-back-link .arrow { transition: transform .18s; }
  .cd-back-link:hover .arrow { transform: translateX(-3px); }

  .cd-inst-block {
    display: flex; align-items: center; gap: .8rem;
    margin-bottom: 1.25rem; text-decoration: none;
  }
  .cd-inst-logo {
    width: 50px; height: 50px; flex-shrink: 0;
    border-radius: 12px; background: #fff;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 16px rgba(0,0,0,.4); overflow: hidden;
  }
  .cd-inst-logo img { width: 100%; height: 100%; object-fit: contain; padding: 5px; }
  .cd-inst-logo .initials { font-size: 1.25rem; font-weight: 900; color: var(--brand); }
  .cd-inst-label    { font-size: .65rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: rgba(255,255,255,.35); margin-bottom: .1rem; }
  .cd-inst-name     { font-size: .95rem; font-weight: 800; color: #fff; line-height: 1.2; }
  .cd-inst-location { font-size: .72rem; color: rgba(255,255,255,.5); margin-top: .1rem; }
  .cd-inst-block:hover .cd-inst-name { text-decoration: underline; }

  .cd-title { font-size: 2.1rem; font-weight: 800; color: #fff; line-height: 1.22; margin: 0 0 1.25rem; }

  .cd-chips { display: flex; flex-wrap: wrap; gap: .45rem; }
  .cd-chip { display: inline-flex; align-items: center; gap: .35rem; font-size: .76rem; padding: .32rem .8rem; border-radius: 20px; font-weight: 600; }
  .cd-chip-price { background: var(--brand); color: #fff; }
  .cd-chip-price.free   { background: #16a34a; }
  .cd-chip-price.demand { background: rgba(255,255,255,.1); color: rgba(255,255,255,.8); border: 1px solid rgba(255,255,255,.18); }
  .cd-chip-neutral { background: rgba(255,255,255,.09); color: rgba(255,255,255,.78); border: 1px solid rgba(255,255,255,.1); }

  .cd-hero-img {
    aspect-ratio: 16/10; border-radius: 18px; overflow: hidden;
    box-shadow: 0 20px 56px rgba(0,0,0,.55);
    background: linear-gradient(135deg, color-mix(in srgb, ${brand} 60%, #000), #0f0720);
    display: flex; align-items: center; justify-content: center;
    position: relative;
  }
  .cd-hero-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cd-hero-img .no-img-icon { font-size: 4rem; opacity: .2; color: #fff; }

  /* ── Body ── */
  .cd-body { padding: 2.5rem 0 5rem; background: #f4f6fb; }
  .cd-layout { display: flex; gap: 2rem; align-items: flex-start; }
  .cd-main { flex: 1; min-width: 0; }
  .cd-sidebar { width: 308px; flex-shrink: 0; }

  /* ── Section card ── */
  .cd-section {
    background: #fff; border-radius: 16px;
    box-shadow: 0 1px 8px rgba(0,0,0,.05), 0 4px 16px rgba(0,0,0,.04);
    overflow: hidden; margin-bottom: 1.25rem;
  }
  .cd-sec-head {
    display: flex; align-items: center; gap: .65rem;
    padding: 1.25rem 1.5rem 1rem;
    border-bottom: 1.5px solid #f1f5f9;
  }
  .cd-sec-icon {
    width: 32px; height: 32px; border-radius: 8px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: .9rem;
  }
  .cd-sec-title { font-size: 1rem; font-weight: 800; color: #0f172a; flex: 1; margin: 0; }
  .cd-sec-meta  { font-size: .75rem; color: #94a3b8; font-weight: 500; }
  .cd-sec-body  { padding: 1.25rem 1.5rem; }

  /* ── Promo video ── */
  .cd-promo-video {
    border-radius: 14px; overflow: hidden;
    box-shadow: 0 6px 28px rgba(0,0,0,.18);
    margin-bottom: 1.25rem; position: relative; aspect-ratio: 16/9;
    background: #000;
  }
  .cd-promo-video iframe, .cd-promo-video video {
    position: absolute; inset: 0; width: 100%; height: 100%; border: none; display: block;
  }

  /* ── Objectives / Audience / Prerequisites ── */
  .obj-box { background: #f0fdf4; border-radius: 10px; padding: 1.1rem 1.25rem; }
  .obj-box .rte-content { font-size: .9rem; color: #1e293b; line-height: 1.7; }
  .obj-box .rte-content ul { padding-left: 1.1rem; margin: 0; }
  .obj-box .rte-content p { margin: 0 0 .5rem; }
  .audience-box { background: #eff6ff; border-left: 3px solid #3b82f6; border-radius: 10px; padding: 1rem 1.25rem; }
  .audience-box .rte-content { font-size: .9rem; color: #1e293b; line-height: 1.7; }
  .audience-box .rte-content p { margin: 0 0 .5rem; }
  .audience-box .rte-content ul, .audience-box .rte-content ol { padding-left: 1.25rem; margin: 0; }
  .prereq-box { background: #f5f3ff; border-left: 3px solid var(--brand); border-radius: 10px; padding: 1rem 1.25rem; }
  .prereq-box .rte-content { font-size: .9rem; color: #1e293b; line-height: 1.7; }

  /* ── Modules accordion ── */
  .mod-list { display: flex; flex-direction: column; gap: .5rem; }
  .mod-item {
    border: 1.5px solid #e8edf5; border-radius: 12px;
    overflow: hidden; background: #fafbfc;
    transition: border-color .18s;
  }
  .mod-item.open { border-color: color-mix(in srgb, ${brand} 35%, #e8edf5); }
  .mod-header {
    display: flex; align-items: center; gap: .85rem;
    padding: .9rem 1.1rem; cursor: pointer;
    user-select: none;
  }
  .mod-header:hover { background: #f3f4f8; }
  .mod-num {
    width: 28px; height: 28px; border-radius: 8px;
    background: color-mix(in srgb, ${brand} 12%, #fff);
    color: var(--brand);
    font-size: .75rem; font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; border: 1.5px solid color-mix(in srgb, ${brand} 22%, transparent);
  }
  .mod-item.open .mod-num { background: var(--brand); color: #fff; border-color: var(--brand); }
  .mod-title { font-weight: 700; font-size: .9rem; color: #0f172a; flex: 1; line-height: 1.35; }
  .mod-count { font-size: .72rem; color: #94a3b8; white-space: nowrap; flex-shrink: 0; }
  .mod-arrow { color: #cbd5e1; font-size: .75rem; transition: transform .22s; flex-shrink: 0; }
  .mod-item.open .mod-arrow { transform: rotate(180deg); color: var(--brand); }
  .mod-lessons { display: none; border-top: 1.5px solid #f0f2f8; background: #fff; }
  .mod-item.open .mod-lessons { display: block; }
  .lesson-row {
    display: flex; align-items: center; gap: .6rem;
    padding: .55rem 1.1rem; font-size: .84rem; color: #374151;
    border-bottom: 1px solid #f8f9fc;
  }
  .lesson-row:last-child { border-bottom: none; }
  .lesson-icon { font-size: .8rem; color: #94a3b8; width: 18px; text-align: center; flex-shrink: 0; }
  .lesson-title-text { flex: 1; }
  .lesson-preview-badge {
    display: inline-flex; align-items: center; gap: .25rem;
    font-size: .65rem; font-weight: 700;
    background: rgba(124,58,237,.08); color: #7c3aed;
    border: 1px solid rgba(124,58,237,.2);
    padding: .12rem .48rem; border-radius: 20px; flex-shrink: 0;
  }
  .lesson-preview-link {
    margin-left: auto; flex-shrink: 0;
    font-size: .73rem; font-weight: 700; color: #7c3aed;
    text-decoration: none;
    display: inline-flex; align-items: center; gap: .2rem;
    padding: .18rem .5rem; border-radius: 5px;
    border: 1px solid rgba(124,58,237,.25);
    transition: background .13s, color .13s;
  }
  .lesson-preview-link:hover { background: #7c3aed; color: #fff; border-color: #7c3aed; }
  .mod-extra-row {
    display: flex; align-items: center; gap: .6rem;
    padding: .5rem 1.1rem; font-size: .82rem; color: #64748b;
    background: #fafbfc; border-top: 1px solid #f0f2f8;
    font-style: italic;
  }

  /* ── Free preview card ── */
  .cd-previews {
    background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);
    border: 1.5px solid #ddd6fe;
    border-radius: 14px; overflow: hidden;
    margin-bottom: 1.25rem;
  }
  .cd-previews-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: .9rem 1.25rem;
    border-bottom: 1px solid #e9d5ff;
    background: rgba(124,58,237,.06);
  }
  .cd-previews-title {
    display: flex; align-items: center; gap: .5rem;
    font-size: .9rem; font-weight: 800; color: #5b21b6;
  }
  .cd-previews-pill {
    background: #7c3aed; color: #fff;
    font-size: .65rem; font-weight: 700;
    padding: .12rem .5rem; border-radius: 20px;
  }
  .cd-preview-list { padding: .75rem 1rem; display: flex; flex-direction: column; gap: .45rem; }
  .cd-preview-row {
    display: flex; align-items: center; gap: .75rem;
    padding: .6rem .85rem;
    background: #fff; border-radius: 9px;
    border: 1px solid #ede9fe;
    transition: box-shadow .18s, border-color .18s;
  }
  .cd-preview-row:hover { box-shadow: 0 3px 10px rgba(124,58,237,.1); border-color: #c4b5fd; }
  .cd-preview-icon { font-size: .8rem; color: #7c3aed; width: 18px; text-align: center; flex-shrink: 0; }
  .cd-preview-title { flex: 1; font-size: .86rem; font-weight: 600; color: #1e1b4b; }
  .cd-preview-mod   { font-size: .7rem; color: #a78bfa; flex-shrink: 0; white-space: nowrap; }
  .cd-preview-btn {
    display: inline-flex; align-items: center; gap: .3rem;
    font-size: .76rem; font-weight: 700; color: #7c3aed;
    text-decoration: none; padding: .28rem .72rem;
    border-radius: 6px; border: 1.5px solid #c4b5fd;
    flex-shrink: 0; transition: background .13s, color .13s;
  }
  .cd-preview-btn:hover { background: #7c3aed; color: #fff; border-color: #7c3aed; }

  /* ── Instructors ── */
  .instr-card { display: flex; gap: 1rem; padding: .85rem 0; border-bottom: 1px solid #f1f5f9; align-items: flex-start; }
  .instr-card:last-child { border-bottom: none; padding-bottom: 0; }
  .instr-avatar { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; flex-shrink: 0; background: var(--brand); display: flex; align-items: center; justify-content: center; font-weight: 800; color: #fff; font-size: 1.2rem; }
  .instr-name  { font-weight: 700; color: #0f172a; margin-bottom: .12rem; font-size: .95rem; }
  .instr-title { font-size: .8rem; color: #64748b; margin-bottom: .35rem; }
  .instr-bio   { font-size: .83rem; color: #374151; line-height: 1.55; }

  /* ── Testimonials ── */
  .testi-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: .85rem; }
  .testi-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1rem 1.1rem; }
  .testi-stars { color: #f59e0b; font-size: .82rem; margin-bottom: .5rem; letter-spacing: .05em; }
  .testi-content { font-size: .86rem; color: #374151; line-height: 1.55; font-style: italic; margin-bottom: .7rem; }
  .testi-author { font-size: .8rem; font-weight: 700; color: #0f172a; }
  .testi-role   { font-size: .73rem; color: #94a3b8; }

  /* ── Sidebar ── */
  .cta-card {
    background: #fff; border-radius: 18px;
    box-shadow: 0 4px 24px rgba(0,0,0,.09), 0 1px 6px rgba(0,0,0,.05);
    overflow: hidden; position: sticky; top: 88px;
  }
  .cta-price-block {
    padding: 1.5rem 1.5rem 1.25rem;
    border-bottom: 1.5px solid #f1f5f9;
  }
  .cta-price {
    font-size: 1.85rem; font-weight: 800; color: var(--brand); line-height: 1;
    margin-bottom: .3rem;
  }
  .cta-price.free   { color: #16a34a; }
  .cta-price.demand { font-size: 1.15rem; color: #64748b; }
  .cta-price-note   { font-size: .78rem; color: #94a3b8; }
  .cta-enroll-btn {
    display: flex; align-items: center; justify-content: center; gap: .5rem;
    width: 100%; padding: .85rem;
    background: var(--brand); color: #fff;
    border: none; border-radius: 12px; cursor: pointer;
    font-weight: 700; font-size: .95rem;
    margin: 1.25rem 0 0;
    text-decoration: none;
    transition: background .18s, transform .18s;
  }
  .cta-enroll-btn:hover { background: color-mix(in srgb, var(--brand) 85%, #000); transform: translateY(-1px); color: #fff; }
  .cta-enroll-btn.free-btn { background: #16a34a; }
  .cta-enroll-btn.free-btn:hover { background: #15803d; }
  .cta-body { padding: 1.25rem 1.5rem; }
  .cta-inst-row {
    display: flex; align-items: center; gap: .7rem;
    padding-bottom: 1rem; border-bottom: 1px solid #f1f5f9; margin-bottom: 1rem;
  }
  .cta-inst-logo {
    width: 38px; height: 38px; border-radius: 8px; overflow: hidden;
    background: #f1f5f9; display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; border: 1px solid #e2e8f0;
  }
  .cta-inst-logo img { width: 100%; height: 100%; object-fit: contain; padding: 3px; }
  .cta-inst-logo .ini { font-size: .7rem; font-weight: 800; color: var(--brand); }
  .cta-inst-name-text { font-size: .85rem; font-weight: 700; color: #0f172a; }
  .cta-inst-link { font-size: .75rem; color: var(--brand); text-decoration: none; }
  .cta-inst-link:hover { text-decoration: underline; }
  .cta-label { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #94a3b8; margin-bottom: .5rem; display: block; }
  .cta-contact-val { font-size: .85rem; color: #374151; font-weight: 500; word-break: break-all; }
  .cta-contact-val a { color: var(--brand); text-decoration: none; }
  .cta-contact-val a:hover { text-decoration: underline; }
  .cta-row { margin-bottom: .85rem; }
  .cta-divider { height: 1px; background: #f1f5f9; margin: 1rem 0; }
  .cta-back {
    display: flex; align-items: center; justify-content: center; gap: .4rem;
    font-size: .8rem; font-weight: 600; color: #64748b;
    text-decoration: none; padding: .55rem;
    border-radius: 9px; border: 1px solid #e2e8f0;
    transition: background .15s, color .15s;
  }
  .cta-back:hover { background: #f1f5f9; color: #0f172a; }

  /* ── Enrollment request form ── */
  .enroll-form-head {
    padding: 1.1rem 1.5rem .9rem;
    border-bottom: 1.5px solid #f1f5f9;
    display: flex; flex-direction: column; gap: .15rem;
  }
  .enroll-form-title { font-size: .95rem; font-weight: 800; color: #0f172a; }
  .enroll-form-sub   { font-size: .76rem; color: #94a3b8; }
  .enroll-form-body  { padding: 1.1rem 1.5rem 1.25rem; }
  .ef-field { margin-bottom: .7rem; }
  .ef-label { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #64748b; display: block; margin-bottom: .3rem; }
  .ef-input, .ef-textarea {
    width: 100%; padding: .6rem .85rem;
    border: 1.5px solid #e2e8f0; border-radius: 9px;
    font-size: .86rem; color: #0f172a; background: #f8fafc;
    outline: none; transition: border-color .18s, background .18s;
    font-family: inherit; box-sizing: border-box;
  }
  .ef-input:focus, .ef-textarea:focus { border-color: var(--brand); background: #fff; }
  .ef-textarea { resize: vertical; min-height: 70px; }
  .ef-submit {
    width: 100%; padding: .78rem;
    background: var(--brand); color: #fff; border: none; border-radius: 10px;
    font-size: .9rem; font-weight: 700; cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: .45rem;
    margin-top: .3rem;
    transition: background .18s, transform .15s;
  }
  .ef-submit:hover { background: color-mix(in srgb, var(--brand) 85%, #000); transform: translateY(-1px); }
  .ef-note { font-size: .72rem; color: #94a3b8; text-align: center; margin-top: .5rem; }

  /* ── Responsive ── */
  @media (max-width: 960px) {
    .cd-layout { flex-direction: column; }
    .cd-sidebar { width: 100%; }
    .cta-card { position: static; }
    .cd-hero-grid { grid-template-columns: 1fr; }
    .cd-hero-img { aspect-ratio: 16/7; border-radius: 14px; }
    .cd-title { font-size: 1.7rem; }
  }
  @media (max-width: 500px) {
    .cd-title { font-size: 1.4rem; }
    .cd-preview-mod { display: none; }
  }
</style>` %>

<!-- Hero -->
<section class="cd-hero">
  <div class="container">
    <div class="cd-hero-grid">

      <div class="cd-hero-left">
        <a href="/formations" class="cd-back-link"><span class="arrow">←</span> Retour au catalogue</a>

        <a href="/formations/institutions/<%= inst._id %>" class="cd-inst-block">
          <div class="cd-inst-logo">
            <% if (inst.logoUrl) { %>
              <img src="<%= inst.logoUrl %>" alt="<%= inst.name %>">
            <% } else { %>
              <span class="initials"><%= (inst.name || 'I').substring(0,2).toUpperCase() %></span>
            <% } %>
          </div>
          <div>
            <div class="cd-inst-label">Institution</div>
            <div class="cd-inst-name"><%= inst.name || 'Institution' %></div>
            <% if (inst.city || inst.country) { %>
              <div class="cd-inst-location">📍 <%= [inst.city, inst.country].filter(Boolean).join(', ') %></div>
            <% } %>
          </div>
        </a>

        <h1 class="cd-title"><%= course.title %></h1>

        <div class="cd-chips">
          <%
            let priceChipClass = 'cd-chip-price';
            if (isFree) priceChipClass += ' free';
            else if (priceText === 'Sur demande') priceChipClass += ' demand';
          %>
          <span class="cd-chip <%= priceChipClass %>">
            <%= isFree ? '🎓' : (priceText === 'Sur demande' ? '📋' : '💳') %> <%= priceText %>
          </span>
          <% if (course.category && course.category !== 'Autre') { %>
            <span class="cd-chip cd-chip-neutral">🏷 <%= course.category %></span>
          <% } %>
          <span class="cd-chip cd-chip-neutral">📚 <%= modules.length %> module<%= modules.length !== 1 ? 's' : '' %></span>
          <span class="cd-chip cd-chip-neutral">🎬 <%= totalLessons %> leçon<%= totalLessons !== 1 ? 's' : '' %></span>
          <% if (hasFinalExam)    { %><span class="cd-chip cd-chip-neutral">📝 Examen final</span><% } %>
          <% if (hasFinalProject) { %><span class="cd-chip cd-chip-neutral">🎯 Projet final</span><% } %>
          <% if (avgRating)       { %><span class="cd-chip cd-chip-neutral">⭐ <%= avgRating %>/5</span><% } %>
        </div>
      </div>

      <div class="cd-hero-img">
        <% if (course.imageUrl) { %>
          <img src="<%= course.imageUrl %>" alt="<%= course.title %>">
        <% } else { %>
          <i class="bi bi-book-half no-img-icon"></i>
        <% } %>
      </div>

    </div>
  </div>
</section>

<!-- Body -->
<div class="cd-body">
  <div class="container">
    <div class="cd-layout">

      <!-- ── Main ── -->
      <div class="cd-main">

        <!-- Promo video -->
        <% if (promoEmbed) { %>
        <div class="cd-promo-video">
          <% if (isDirectVid) { %>
            <video controls><source src="<%= promoEmbed %>"></video>
          <% } else { %>
            <iframe src="<%= promoEmbed %>" allowfullscreen allow="autoplay; fullscreen; picture-in-picture"></iframe>
          <% } %>
        </div>
        <% } %>

        <!-- Description -->
        <% if (course.description) { %>
        <div class="cd-section">
          <div class="cd-sec-head">
            <div class="cd-sec-icon" style="background:#eff6ff;color:#2563eb;">📖</div>
            <h2 class="cd-sec-title">À propos de ce cours</h2>
          </div>
          <div class="cd-sec-body" style="color:#374151;line-height:1.75;font-size:.93rem;"><%- course.description %></div>
        </div>
        <% } %>

        <!-- Objectives -->
        <% if (course.objectives) { %>
        <div class="cd-section">
          <div class="cd-sec-head">
            <div class="cd-sec-icon" style="background:#f0fdf4;color:#16a34a;">🎯</div>
            <h2 class="cd-sec-title">Ce que vous allez apprendre</h2>
          </div>
          <div class="cd-sec-body">
            <div class="obj-box"><div class="rte-content"><%- course.objectives %></div></div>
          </div>
        </div>
        <% } %>

        <!-- Target audience -->
        <% if (course.targetAudience) { %>
        <div class="cd-section">
          <div class="cd-sec-head">
            <div class="cd-sec-icon" style="background:#eff6ff;color:#3b82f6;">👥</div>
            <h2 class="cd-sec-title">À qui s'adresse ce cours ?</h2>
          </div>
          <div class="cd-sec-body">
            <div class="audience-box"><div class="rte-content"><%- course.targetAudience %></div></div>
          </div>
        </div>
        <% } %>

        <!-- Prerequisites -->
        <% if (course.prerequisites) { %>
        <div class="cd-section">
          <div class="cd-sec-head">
            <div class="cd-sec-icon" style="background:#f5f3ff;color:var(--brand);">✅</div>
            <h2 class="cd-sec-title">Prérequis</h2>
          </div>
          <div class="cd-sec-body">
            <div class="prereq-box"><div class="rte-content"><%- course.prerequisites %></div></div>
          </div>
        </div>
        <% } %>

        <!-- Modules -->
        <% if (modules.length > 0) { %>
        <div class="cd-section">
          <div class="cd-sec-head">
            <div class="cd-sec-icon" style="background:color-mix(in srgb, var(--brand) 10%, #fff);color:var(--brand);">📚</div>
            <h2 class="cd-sec-title">Modules</h2>
            <span class="cd-sec-meta"><%= modules.length %> module<%= modules.length !== 1 ? 's' : '' %> · <%= totalLessons %> leçon<%= totalLessons !== 1 ? 's' : '' %></span>
          </div>
          <div class="cd-sec-body">
            <div class="mod-list">
              <% modules.forEach((mod, idx) => { %>
                <div class="mod-item <%= idx === 0 ? 'open' : '' %>" id="mod-<%= idx %>">
                  <div class="mod-header" onclick="toggleMod(<%= idx %>)">
                    <span class="mod-num"><%= idx + 1 %></span>
                    <span class="mod-title"><%= mod.title %></span>
                    <span class="mod-count"><%= mod.lessons ? mod.lessons.length : 0 %> leçon<%= (mod.lessons && mod.lessons.length !== 1) ? 's' : '' %></span>
                    <span class="mod-arrow">▾</span>
                  </div>
                  <% if (mod.lessons && mod.lessons.length > 0) { %>
                  <div class="mod-lessons">
                    <% mod.lessons.forEach(l => { %>
                      <div class="lesson-row">
                        <%
                          const lIcons = { video: '▶', text: '📄', pdf: '📎', practice_quiz: '✍' };
                          const lIcon  = lIcons[l.type] || '·';
                        %>
                        <span class="lesson-icon"><%= lIcon %></span>
                        <span class="lesson-title-text"><%= l.title || 'Leçon sans titre' %></span>
                        <% if (l.isPreview) { %>
                          <span class="lesson-preview-badge">👁 Aperçu</span>
                          <a href="/formations/<%= course._id %>/preview/<%= l._id %>" class="lesson-preview-link" target="_blank">Voir →</a>
                        <% } %>
                      </div>
                    <% }) %>
                    <% if (mod.quiz || mod.assignment) { %>
                      <div class="mod-extra-row">
                        <% if (mod.quiz) { %><span>📋 Quiz de module</span><% } %>
                        <% if (mod.assignment) { %><span style="margin-left:.75rem;">📝 Devoir noté</span><% } %>
                      </div>
                    <% } %>
                  </div>
                  <% } %>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
        <% } %>

        <!-- Free previews (below modules) -->
        <% if (allPreviewLessons.length > 0) { %>
        <div class="cd-previews">
          <div class="cd-previews-head">
            <div class="cd-previews-title">
              👁 Aperçus gratuits
              <span class="cd-previews-pill"><%= allPreviewLessons.length %></span>
            </div>
            <span style="font-size:.75rem;color:#a78bfa;">Accessibles sans inscription</span>
          </div>
          <div class="cd-preview-list">
            <% allPreviewLessons.forEach(function(p) { %>
              <div class="cd-preview-row">
                <span class="cd-preview-icon"><%= previewIcons[p.lesson.type] || '·' %></span>
                <span class="cd-preview-title"><%= p.lesson.title %></span>
                <span class="cd-preview-mod"><%= p.modTitle %></span>
                <a href="/formations/<%= course._id %>/preview/<%= p.lesson._id %>" class="cd-preview-btn" target="_blank">▶ Regarder</a>
              </div>
            <% }); %>
          </div>
        </div>
        <% } %>

        <!-- Instructors -->
        <% if (course.instructors && course.instructors.length > 0) { %>
        <div class="cd-section">
          <div class="cd-sec-head">
            <div class="cd-sec-icon" style="background:#fef9c3;color:#ca8a04;">👨‍🏫</div>
            <h2 class="cd-sec-title">Équipe pédagogique</h2>
          </div>
          <div class="cd-sec-body">
            <% course.instructors.forEach(instr => { %>
              <div class="instr-card">
                <% if (instr.photoUrl) { %>
                  <img src="<%= instr.photoUrl %>" alt="<%= instr.name %>" class="instr-avatar" style="width:52px;height:52px;border-radius:50%;object-fit:cover;">
                <% } else { %>
                  <div class="instr-avatar"><%= (instr.name || 'I').charAt(0).toUpperCase() %></div>
                <% } %>
                <div>
                  <div class="instr-name"><%= instr.name %></div>
                  <% if (instr.title) { %><div class="instr-title"><%= instr.title %></div><% } %>
                  <% if (instr.bio) { %><div class="instr-bio"><%= instr.bio %></div><% } %>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
        <% } %>

        <!-- Testimonials -->
        <% if (testimonials.length > 0) { %>
        <div class="cd-section">
          <div class="cd-sec-head">
            <div class="cd-sec-icon" style="background:#fff7ed;color:#ea580c;">⭐</div>
            <h2 class="cd-sec-title">Témoignages</h2>
            <% if (avgRating) { %>
              <span class="cd-sec-meta">⭐ <%= avgRating %>/5 · <%= testimonials.length %> avis</span>
            <% } %>
          </div>
          <div class="cd-sec-body">
            <div class="testi-grid">
              <% testimonials.forEach(t => { %>
                <div class="testi-card">
                  <% if (t.rating) { %><div class="testi-stars"><%= '★'.repeat(t.rating) %><%= '☆'.repeat(5 - t.rating) %></div><% } %>
                  <div class="testi-content">"<%= t.content %>"</div>
                  <div class="testi-author"><%= t.authorName %></div>
                  <% if (t.authorTitle) { %><div class="testi-role"><%= t.authorTitle %></div><% } %>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
        <% } %>

      </div>

      <!-- ── Sidebar ── -->
      <div class="cd-sidebar">
        <div class="cta-card">

          <div class="cta-price-block">
            <div class="cta-price <%= isFree ? 'free' : (priceText === 'Sur demande' ? 'demand' : '') %>">
              <%= priceText %>
            </div>
            <% if (!isFree && priceText !== 'Sur demande') { %>
              <div class="cta-price-note">Tarif de formation</div>
            <% } %>
          </div>

          <!-- Enrollment request form -->
          <div class="enroll-form-head">
            <div class="enroll-form-title">✉ Demander l'inscription</div>
            <div class="enroll-form-sub">L'institution vous recontactera sous 48 h</div>
          </div>
          <div class="enroll-form-body">
            <form action="/formations/<%= course._id %>/enroll-request" method="POST">
              <div class="ef-field">
                <label class="ef-label" for="ef-name">Nom complet *</label>
                <input class="ef-input" type="text" id="ef-name" name="name" placeholder="Votre nom" required>
              </div>
              <div class="ef-field">
                <label class="ef-label" for="ef-email">Email *</label>
                <input class="ef-input" type="email" id="ef-email" name="email" placeholder="votre@email.com" required>
              </div>
              <div class="ef-field">
                <label class="ef-label" for="ef-phone">Téléphone</label>
                <input class="ef-input" type="tel" id="ef-phone" name="phone" placeholder="+226 70 00 00 00">
              </div>
              <div class="ef-field">
                <label class="ef-label" for="ef-message">Message</label>
                <textarea class="ef-textarea" id="ef-message" name="message" placeholder="Questions, disponibilités…"></textarea>
              </div>
              <button type="submit" class="ef-submit">
                <i class="bi bi-send-fill"></i> Envoyer la demande
              </button>
              <p class="ef-note">Gratuit, sans engagement</p>
            </form>
          </div>

          <div class="cta-body">
            <!-- Institution -->
            <div class="cta-inst-row">
              <div class="cta-inst-logo">
                <% if (inst.logoUrl) { %>
                  <img src="<%= inst.logoUrl %>" alt="<%= inst.name %>">
                <% } else { %>
                  <span class="ini"><%= (inst.name || 'I').substring(0,2).toUpperCase() %></span>
                <% } %>
              </div>
              <div>
                <div class="cta-inst-name-text"><%= inst.name || 'Institution' %></div>
                <a href="/formations/institutions/<%= inst._id %>" class="cta-inst-link">Voir tous les cours →</a>
              </div>
            </div>

            <div class="cta-divider"></div>
            <a href="/formations" class="cta-back">← Retour au catalogue</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
function toggleMod(idx) {
  document.getElementById('mod-' + idx).classList.toggle('open');
}
</script>
