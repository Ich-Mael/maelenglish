<% layout('layouts/main') %>

<% headContent = `<style>
  .page-wrapper { margin-top: 80px; padding: 2rem 0 4rem; }
  .page-header { background: linear-gradient(135deg, #0e7490 0%, #164e63 100%); color: white; padding: 2rem; border-radius: 16px; margin-bottom: 2rem; }
  .page-header h1 { margin: 0; font-size: 1.8rem; font-weight: 700; }
  .student-row { background: #fff; border-radius: 12px; box-shadow: 0 1px 6px rgba(0,0,0,.06); padding: 1rem 1.25rem; margin-bottom: .75rem; display: flex; align-items: center; gap: 1rem; transition: box-shadow .2s; }
  .student-row:hover { box-shadow: 0 3px 12px rgba(14,116,144,.12); }
  .avatar { width: 42px; height: 42px; border-radius: 50%; background: #e0f2f7; color: #0e7490; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.1rem; flex-shrink: 0; }
  .s-name { font-weight: 600; color: #1a1a2e; margin: 0 0 .1rem; }
  .s-meta { font-size: .8rem; color: #888; margin: 0; }
  .empty-state { text-align: center; padding: 3rem; color: #888; }
  .badge-inactive-alert { background: #fff3cd; color: #856404; padding: .2rem .6rem; border-radius: 20px; font-size: .72rem; font-weight: 600; }
  .bulk-panel { background: #fff; border-radius: 14px; box-shadow: 0 2px 10px rgba(0,0,0,.07); padding: 1.25rem 1.5rem; margin-bottom: 1.5rem; border-left: 4px solid #0e7490; display: none; }
  .bulk-panel.visible { display: block; }
  .bulk-toolbar { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; }
  #selectedCount { font-weight: 700; color: #0e7490; }
  /* Search panel */
  .search-panel { background: #fff; border-radius: 14px; box-shadow: 0 2px 10px rgba(0,0,0,.07); padding: 1.5rem; margin-bottom: 1.5rem; }
  .search-panel h3 { font-size: 1rem; font-weight: 700; color: #0e7490; margin: 0 0 1rem; }
  .search-results { margin-top: .75rem; border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden; display: none; }
  .search-result-row { display: flex; align-items: center; gap: 1rem; padding: .75rem 1rem; border-bottom: 1px solid #f0f0f0; cursor: pointer; transition: background .15s; }
  .search-result-row:last-child { border-bottom: none; }
  .search-result-row:hover { background: #f0fdff; }
  .search-result-row.selected { background: #e0f2f7; }
  .enroll-form { background: #f8f9fa; border-radius: 10px; padding: 1rem; margin-top: .75rem; display: none; }
  .enroll-form.visible { display: block; }
  .enrolled-tag { background: #d1fae5; color: #065f46; padding: .1rem .5rem; border-radius: 20px; font-size: .72rem; font-weight: 600; }
</style>` %>

<div class="page-wrapper">
  <div class="container">
    <div class="page-header">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h1>Étudiants — <%= institution.name %></h1>
        <a href="/institution/dashboard" class="btn btn-light btn-sm">← Tableau de bord</a>
      </div>
    </div>

    <%- include('../../partials/flash') %>

    <!-- ── STUDENT SEARCH ── -->
    <% if (institution.assignedCourses && institution.assignedCourses.length > 0) { %>
    <div class="search-panel">
      <h3>➕ Ajouter un étudiant</h3>
      <div>
        <input type="text" id="studentSearch" class="form-control" placeholder="Rechercher par nom, prénom, username ou email…" autocomplete="off">
        <div class="search-results" id="searchResults"></div>
      </div>

      <!-- Enroll form — revealed after selecting a user -->
      <form class="enroll-form" id="enrollForm" method="POST">
        <p class="mb-2 fw-semibold" id="selectedName"></p>
        <div class="row g-2 align-items-end">
          <div class="col-md-5">
            <label class="form-label mb-1" style="font-size:.82rem">Cours</label>
            <select name="courseId" class="form-select form-select-sm" required>
              <option value="">-- Choisir un cours --</option>
              <% (typeof assignedCourseDetails !== 'undefined' ? assignedCourseDetails : []).forEach(c => { %>
                <option value="<%= c._id %>"><%= c.title %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label mb-1" style="font-size:.82rem">Début</label>
            <input type="date" name="startDate" class="form-control form-control-sm" value="<%= new Date().toISOString().split('T')[0] %>">
          </div>
          <div class="col-md-3">
            <label class="form-label mb-1" style="font-size:.82rem">Fin</label>
            <input type="date" name="endDate" class="form-control form-control-sm">
          </div>
          <div class="col-md-1">
            <button type="submit" class="btn btn-primary btn-sm w-100">OK</button>
          </div>
        </div>
      </form>
    </div>
    <% } %>

    <% if (studentsWithMeta.length > 0 && institution.assignedCourses && institution.assignedCourses.length > 0) { %>
    <form action="/institution/dashboard/enroll-bulk" method="POST" id="bulkForm">
      <!-- Bulk enrollment panel (shown when students are selected) -->
      <div class="bulk-panel" id="bulkPanel">
        <div class="bulk-toolbar">
          <span><span id="selectedCount">0</span> étudiant(s) sélectionné(s)</span>
          <select name="courseId" class="form-select form-select-sm" style="max-width:260px" required>
            <option value="">-- Choisir un cours --</option>
            <% (typeof assignedCourseDetails !== 'undefined' ? assignedCourseDetails : []).forEach(c => { %>
              <option value="<%= c._id %>"><%= c.title %></option>
            <% }) %>
          </select>
          <input type="date" name="startDate" class="form-control form-control-sm" style="max-width:150px" value="<%= new Date().toISOString().split('T')[0] %>">
          <input type="date" name="endDate" class="form-control form-control-sm" style="max-width:150px">
          <button type="submit" class="btn btn-primary btn-sm px-3">Inscrire la sélection</button>
          <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearSelection()">Annuler</button>
        </div>
      </div>

      <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <p class="text-muted mb-0"><strong><%= studentsWithMeta.length %></strong> étudiant(s)</p>
        <label class="form-check d-flex align-items-center gap-2 mb-0" style="cursor:pointer">
          <input type="checkbox" id="selectAll" class="form-check-input" onchange="toggleAll(this)">
          <span class="form-check-label small">Tout sélectionner</span>
        </label>
      </div>
    <% } else if (studentsWithMeta.length > 0) { %>
      <p class="text-muted mb-3"><strong><%= studentsWithMeta.length %></strong> étudiant(s)</p>
    <% } %>

    <% if (studentsWithMeta.length === 0) { %>
      <div class="empty-state">
        <p style="font-size:3rem">👥</p>
        <p>Aucun étudiant pour l'instant.</p>
        <p class="text-muted small">Les étudiants sont créés par l'équipe AfroHK et rattachés à votre institution.</p>
      </div>
    <% } else { %>
      <p class="text-muted mb-3"><strong><%= studentsWithMeta.length %></strong> étudiant(s)</p>
      <% studentsWithMeta.forEach(({ student, lastLogin, activeEnrollmentsCount }) => {
        const INACTIVE_DAYS = 14;
        const isInactive = !lastLogin || (Date.now() - new Date(lastLogin).getTime()) > INACTIVE_DAYS * 24 * 60 * 60 * 1000;
      %>
        <div class="student-row" data-id="<%= student._id %>">
          <input type="checkbox" name="studentIds" value="<%= student._id %>" class="form-check-input student-check flex-shrink-0" onchange="updateBulkPanel()" style="width:18px;height:18px;cursor:pointer">
          <div class="avatar"><%= student.name.charAt(0).toUpperCase() %></div>
          <div class="flex-grow-1 min-width-0">
            <p class="s-name"><%= student.surname %> <%= student.name %></p>
            <p class="s-meta"><%= student.email %> &nbsp;·&nbsp; @<%= student.username %></p>
          </div>
          <div class="text-center d-none d-md-block" style="min-width:110px">
            <div class="fw-semibold text-primary"><%= activeEnrollmentsCount %></div>
            <div class="text-muted" style="font-size:.75rem">inscriptions actives</div>
          </div>
          <div class="text-center d-none d-md-block" style="min-width:120px">
            <% if (lastLogin) { %>
              <div style="font-size:.8rem;color:#555"><%= new Date(lastLogin).toLocaleDateString('fr-FR') %></div>
              <div class="text-muted" style="font-size:.72rem">dernière connexion</div>
            <% } else { %>
              <span class="text-muted" style="font-size:.8rem">Jamais connecté</span>
            <% } %>
          </div>
          <% if (isInactive && activeEnrollmentsCount > 0) { %>
            <span class="badge-inactive-alert" title="Aucune connexion depuis plus de <%= 14 %> jours">⚠ Inactif</span>
          <% } %>
          <span class="badge <%= student.isVerified ? 'bg-success' : 'bg-warning text-dark' %>" style="font-size:.72rem;">
            <%= student.isVerified ? 'Vérifié' : 'Non vérifié' %>
          </span>
          <a href="/institution/dashboard/students/<%= student._id %>" class="btn btn-sm btn-outline-primary ms-1">Voir</a>
        </div>
      <% }) %>
    <% } %>
    <% if (studentsWithMeta.length > 0 && institution.assignedCourses && institution.assignedCourses.length > 0) { %>
    </form>
    <% } %>
  </div>
</div>

<script>
function updateBulkPanel() {
  const checked = document.querySelectorAll('.student-check:checked').length;
  document.getElementById('selectedCount').textContent = checked;
  document.getElementById('bulkPanel').classList.toggle('visible', checked > 0);
}
function toggleAll(cb) {
  document.querySelectorAll('.student-check').forEach(c => { c.checked = cb.checked; });
  updateBulkPanel();
}
function clearSelection() {
  document.querySelectorAll('.student-check').forEach(c => c.checked = false);
  const sa = document.getElementById('selectAll');
  if (sa) sa.checked = false;
  updateBulkPanel();
}

// ── Student search ──
(function() {
  const input     = document.getElementById('studentSearch');
  const results   = document.getElementById('searchResults');
  const enrollForm = document.getElementById('enrollForm');
  const selectedName = document.getElementById('selectedName');
  if (!input) return;

  let debounce;
  input.addEventListener('input', function() {
    clearTimeout(debounce);
    const q = this.value.trim();
    if (q.length < 2) { results.style.display = 'none'; results.innerHTML = ''; return; }
    debounce = setTimeout(() => fetchUsers(q), 280);
  });

  async function fetchUsers(q) {
    const res = await fetch('/institution/dashboard/students/search?q=' + encodeURIComponent(q));
    const data = await res.json();
    renderResults(data.users);
  }

  function renderResults(users) {
    if (!users.length) {
      results.innerHTML = '<div style="padding:.75rem 1rem;color:#888;font-size:.875rem;">Aucun résultat.</div>';
      results.style.display = 'block';
      return;
    }
    results.innerHTML = users.map(u => `
      <div class="search-result-row" data-id="${u._id}" data-name="${u.name} ${u.surname} (@${u.username})">
        <div style="width:36px;height:36px;border-radius:50%;background:#e0f2f7;color:#0e7490;display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0;">
          ${u.name.charAt(0).toUpperCase()}
        </div>
        <div style="flex:1;min-width:0;">
          <div style="font-weight:600;font-size:.9rem;">${u.surname} ${u.name}</div>
          <div style="font-size:.78rem;color:#888;">@${u.username} · ${u.email}</div>
        </div>
        ${u.enrolled ? '<span class="enrolled-tag">Déjà inscrit</span>' : ''}
        ${!u.isVerified ? '<span style="background:#fef3c7;color:#92400e;padding:.1rem .5rem;border-radius:20px;font-size:.72rem;font-weight:600;">Non vérifié</span>' : ''}
      </div>`).join('');
    results.style.display = 'block';

    results.querySelectorAll('.search-result-row').forEach(row => {
      row.addEventListener('click', function() {
        results.querySelectorAll('.search-result-row').forEach(r => r.classList.remove('selected'));
        this.classList.add('selected');
        const userId = this.dataset.id;
        const name   = this.dataset.name;
        enrollForm.action = '/institution/dashboard/students/' + userId + '/enroll';
        selectedName.textContent = '👤 ' + name;
        enrollForm.classList.add('visible');
        enrollForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });
  }

  // Hide results when clicking outside
  document.addEventListener('click', function(e) {
    if (!input.contains(e.target) && !results.contains(e.target)) {
      results.style.display = 'none';
    }
  });

  // Reset search after successful enroll
  enrollForm && enrollForm.addEventListener('submit', function() {
    setTimeout(() => {
      input.value = '';
      results.style.display = 'none';
      results.innerHTML = '';
      enrollForm.classList.remove('visible');
    }, 100);
  });
})();
</script>
