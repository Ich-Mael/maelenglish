<% layout('layouts/institutionBoilerplate') %>

<% headContent = `<style>
  :root { --brand: ${institutionColor}; }
  .page-wrapper { margin-top: 80px; padding: 2.5rem 0 5rem; min-height: 100vh; background: #f8fafc; }
  .page-header { background: linear-gradient(135deg, var(--brand) 0%, color-mix(in srgb, var(--brand) 70%, #000) 100%); color: white; padding: 2.5rem 2rem; border-radius: 20px; margin-bottom: 2rem; }
  .page-header h1 { margin: 0 0 .3rem; font-size: 1.8rem; font-weight: 800; }
  .page-header p  { margin: 0; opacity: .85; font-size: 1rem; }
  .inst-hero-brand { display: flex; align-items: center; gap: .65rem; margin-bottom: 1rem; }
  .inst-hero-logo { width: 44px; height: 44px; border-radius: 12px; object-fit: contain; background: rgba(255,255,255,.2); border: 2px solid rgba(255,255,255,.3); padding: 2px; }
  .inst-hero-fallback { width: 44px; height: 44px; border-radius: 12px; background: rgba(255,255,255,.25); color: #fff; font-size: .82rem; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 2px solid rgba(255,255,255,.3); }
  .inst-hero-name { font-size: .95rem; font-weight: 700; color: rgba(255,255,255,.95); }
  .instructor-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; }
  .instructor-card { background: #fff; border-radius: 20px; box-shadow: 0 2px 14px rgba(0,0,0,.07); overflow: hidden; display: flex; flex-direction: column; transition: transform .25s, box-shadow .25s; }
  .instructor-card:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(0,0,0,.12); }
  .card-cover { height: 200px; background: linear-gradient(160deg, color-mix(in srgb, var(--brand) 80%, #000), var(--brand)); display: flex; align-items: flex-end; padding: 1.25rem; position: relative; overflow: hidden; }
  .card-avatar { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 3px solid rgba(255,255,255,.7); flex-shrink: 0; }
  .card-avatar-fallback { width: 80px; height: 80px; border-radius: 50%; background: rgba(255,255,255,.2); border: 3px solid rgba(255,255,255,.6); color: #fff; font-size: 1.8rem; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .card-cover-name { margin-left: 1rem; }
  .card-cover-name h3 { color: #fff; font-weight: 800; font-size: 1.1rem; margin: 0 0 .15rem; text-shadow: 0 1px 4px rgba(0,0,0,.3); }
  .card-cover-name p  { color: rgba(255,255,255,.8); font-size: .82rem; font-weight: 600; margin: 0; }
  .card-body { padding: 1.25rem; flex: 1; display: flex; flex-direction: column; }
  .card-bio { font-size: .88rem; color: #475569; line-height: 1.65; flex: 1; }
  .card-email { margin-top: .75rem; font-size: .8rem; color: var(--brand); display: flex; align-items: center; gap: .35rem; }
  .empty-state { text-align: center; padding: 4rem 2rem; background: #fff; border-radius: 20px; box-shadow: 0 2px 12px rgba(0,0,0,.06); color: #94a3b8; }
  .empty-state .icon { font-size: 3rem; display: block; margin-bottom: 1rem; }
</style>` %>

<div class="page-wrapper">
  <div class="container" style="max-width:1060px;">

    <% const _ii = institution; %>
    <div class="page-header">
      <div class="inst-hero-brand">
        <% if (_ii && _ii.logoUrl) { %>
          <img src="<%= _ii.logoUrl %>" alt="<%= _ii.name %>" class="inst-hero-logo">
        <% } else { %>
          <div class="inst-hero-fallback"><%= _ii ? _ii.name.substring(0,2).toUpperCase() : 'I' %></div>
        <% } %>
        <div>
          <div class="inst-hero-name"><%= _ii ? _ii.name : '' %></div>
        </div>
      </div>
      <h1>👨‍🏫 Nos instructeurs</h1>
      <p>Découvrez l'équipe pédagogique qui vous accompagne dans votre apprentissage.</p>
    </div>

    <%- include('../../partials/flash') %>

    <% if (instructors.length === 0) { %>
      <div class="empty-state">
        <span class="icon">👨‍🏫</span>
        <p class="fw-semibold">Aucun instructeur publié pour le moment.</p>
      </div>
    <% } else { %>
      <div class="instructor-grid">
        <% instructors.forEach(inst => { %>
          <div class="instructor-card">
            <div class="card-cover">
              <% if (inst.photoUrl) { %>
                <img src="<%= inst.photoUrl %>" class="card-avatar" alt="<%= inst.name %>">
              <% } else { %>
                <div class="card-avatar-fallback"><%= inst.name[0].toUpperCase() %></div>
              <% } %>
              <div class="card-cover-name">
                <h3><%= inst.name %></h3>
                <% if (inst.title) { %><p><%= inst.title %></p><% } %>
              </div>
            </div>
            <div class="card-body">
              <% if (inst.bio) { %>
                <div class="card-bio"><%- inst.bio.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().substring(0, 260) %><%= inst.bio.replace(/<[^>]+>/g,'').length > 260 ? '…' : '' %></div>
              <% } else { %>
                <p class="card-bio text-muted">Aucune biographie disponible.</p>
              <% } %>
              <% if (inst.email) { %>
                <div class="card-email"><i class="bi bi-envelope"></i> <%= inst.email %></div>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

  </div>
</div>
