<% layout('layouts/institutionBoilerplate') %>
<% const exam = course.finalExam; %>

<% headContent = `<style>
  :root { --brand: ${institutionColor}; }
  .page-wrapper { margin-top: 80px; padding: 2rem 0 4rem; background: #f8fafc; }
  .exam-header { background: linear-gradient(135deg, color-mix(in srgb, var(--brand) 80%, #000) 0%, var(--brand) 100%); color: white; padding: 2rem; border-radius: 18px; margin-bottom: 1.75rem; }
  .exam-header h1 { margin: 0 0 .3rem; font-size: 1.6rem; font-weight: 800; }
  .exam-header p  { margin: 0; opacity: .85; font-size: .9rem; }
  .question-block { background: #fff; border-radius: 14px; box-shadow: 0 1px 8px rgba(0,0,0,.06); padding: 1.5rem; margin-bottom: 1rem; }
  .question-num { font-size: .72rem; font-weight: 700; text-transform: uppercase; color: var(--brand); letter-spacing: .06em; margin-bottom: .35rem; }
  .question-text { font-weight: 600; color: #1e293b; margin-bottom: 1rem; font-size: 1rem; line-height: 1.5; }
  .option-wrap { position: relative; margin-bottom: .4rem; }
  .option-wrap input[type=radio] { display: none; }
  .option-label { display: flex; align-items: center; gap: .75rem; padding: .65rem .9rem; border-radius: 10px; border: 2px solid #e2e8f0; cursor: pointer; transition: border-color .15s, background .15s; }
  .option-label:hover { border-color: var(--brand); background: color-mix(in srgb, var(--brand) 6%, #fff); }
  .option-wrap input[type=radio]:checked + .option-label { border-color: var(--brand); background: color-mix(in srgb, var(--brand) 10%, #fff); }
  .option-dot { width: 18px; height: 18px; border: 2px solid #cbd5e1; border-radius: 50%; flex-shrink: 0; transition: border-color .15s, background .15s; }
  .option-wrap input[type=radio]:checked + .option-label .option-dot { border-color: var(--brand); background: var(--brand); }
  .btn-submit { background: var(--brand); color: #fff; border: none; padding: .9rem 2.5rem; border-radius: 14px; font-weight: 700; font-size: 1rem; cursor: pointer; transition: opacity .2s; }
  .btn-submit:hover { opacity: .88; }
  .btn-submit:disabled { opacity: .5; cursor: not-allowed; }
  .result-card { border-radius: 16px; padding: 2rem; text-align: center; margin-bottom: 1.5rem; }
  .result-passed { background: #d1fae5; border: 2px solid #6ee7b7; }
  .result-failed  { background: #fee2e2; border: 2px solid #fca5a5; }
  .result-score { font-size: 2.5rem; font-weight: 800; margin: .5rem 0; }
  .attempt-banner { border-radius: 14px; padding: 1rem 1.5rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .attempt-passed { background: #d1fae5; border: 1px solid #6ee7b7; }
  .attempt-failed { background: #fef9c3; border: 1px solid #fde68a; }
  #result-section { display: none; }
</style>` %>

<div class="page-wrapper">
  <div class="container" style="max-width:760px;">

    <div class="exam-header">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
          <p style="opacity:.7;font-size:.82rem;margin:0 0 .2rem;"><%= course.title %></p>
          <h1>🎓 <%= exam.title || 'Examen final' %></h1>
          <p>
            <%= (exam.questions || []).length %> question<%= (exam.questions || []).length > 1 ? 's' : '' %>
            · Score requis : <%= exam.passingScore || 70 %>%
            <% if (exam.timeLimit) { %> · <%= exam.timeLimit %> min<% } %>
          </p>
        </div>
        <a href="/institution/learn/courses/<%= courseId %>" class="btn btn-light btn-sm">← Cours</a>
      </div>
    </div>

    <%- include('../../partials/flash') %>

    <!-- Previous attempt banner -->
    <% if (lastAttempt) { %>
      <div class="attempt-banner <%= lastAttempt.passed ? 'attempt-passed' : 'attempt-failed' %>">
        <div style="font-size:1.4rem;"><%= lastAttempt.passed ? '🎉' : '📋' %></div>
        <div>
          <strong><%= lastAttempt.passed ? 'Réussi' : 'Tentatve précédente' %></strong>
          — Score : <%= lastAttempt.score %>%
          <% if (!lastAttempt.passed) { %>
            <div class="small" style="color:#92400e;margin-top:.2rem;">Vous pouvez faire une nouvelle tentative ci-dessous.</div>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- Result section (shown after AJAX submit) -->
    <div id="result-section">
      <div id="result-card" class="result-card">
        <div id="result-icon" style="font-size:2.5rem;"></div>
        <div id="result-label" style="font-weight:700;font-size:1.1rem;margin:.5rem 0;"></div>
        <div class="result-score" id="result-score"></div>
        <div id="result-msg" style="color:#6b7280;font-size:.9rem;"></div>
        <a href="/institution/learn/courses/<%= courseId %>" class="btn mt-3 px-4 rounded-pill" style="background:var(--brand);color:#fff;">← Retour au cours</a>
      </div>
    </div>

    <!-- Exam form -->
    <% if (!lastAttempt || !lastAttempt.passed) { %>
    <div id="exam-form-section">
      <form id="examForm">
        <% (exam.questions || []).forEach((q, idx) => { %>
          <div class="question-block">
            <div class="question-num">Question <%= idx + 1 %></div>
            <div class="question-text"><%= q.text %></div>
            <% (q.options || []).forEach(opt => { %>
              <div class="option-wrap">
                <input type="radio" name="answers[<%= idx %>]" value="<%= opt.value %>" id="q<%= idx %>_<%= opt.value %>">
                <label class="option-label" for="q<%= idx %>_<%= opt.value %>">
                  <span class="option-dot"></span>
                  <%= opt.text %>
                </label>
              </div>
            <% }) %>
          </div>
        <% }) %>

        <div class="d-flex justify-content-between align-items-center mt-3">
          <button type="submit" class="btn-submit" id="submitBtn">
            <i class="bi bi-send me-2"></i>Soumettre l'examen
          </button>
          <span id="submitStatus" class="small text-muted"></span>
        </div>
      </form>
    </div>
    <% } else { %>
      <div class="text-center py-5">
        <p style="font-size:2.5rem;">✅</p>
        <p class="fw-semibold fs-5 text-success mb-1">Examen final réussi !</p>
        <p class="text-muted small mb-3">Score obtenu : <%= lastAttempt.score %>%</p>
        <a href="/institution/learn/courses/<%= courseId %>" class="btn px-4 rounded-pill" style="background:var(--brand);color:#fff;">← Retour au cours</a>
      </div>
    <% } %>

  </div>
</div>

<script>
document.getElementById('examForm') && document.getElementById('examForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  var btn    = document.getElementById('submitBtn');
  var status = document.getElementById('submitStatus');
  btn.disabled = true;
  btn.textContent = 'Envoi en cours…';

  var formData = new FormData(this);
  var body = new URLSearchParams(formData).toString();

  try {
    var res = await fetch('/institution/learn/courses/<%= courseId %>/final-exam/submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: body
    });
    var data = await res.json();

    document.getElementById('exam-form-section').style.display = 'none';
    var resultSection = document.getElementById('result-section');
    var resultCard    = document.getElementById('result-card');
    resultSection.style.display = 'block';
    resultCard.className = 'result-card ' + (data.passed ? 'result-passed' : 'result-failed');
    document.getElementById('result-icon').textContent  = data.passed ? '🎉' : '😔';
    document.getElementById('result-label').textContent = data.passed ? 'Examen réussi !' : 'Examen échoué';
    document.getElementById('result-score').textContent = data.score + '%';
    document.getElementById('result-msg').textContent   = data.passed
      ? 'Félicitations ! Vous avez réussi l\'examen final.'
      : 'Score insuffisant (' + data.score + '% obtenu, ' + <%= exam.passingScore || 70 %> + '% requis). Vous pouvez réessayer.';
    resultSection.scrollIntoView({ behavior: 'smooth' });
  } catch(err) {
    btn.disabled = false;
    btn.textContent = 'Soumettre l\'examen';
    status.textContent = 'Une erreur est survenue. Veuillez réessayer.';
  }
});
</script>
