<% layout('layouts/institutionBoilerplate') %>

<% headContent = `<style>
  :root { --brand: ${institutionColor}; }
  .page-wrapper { margin-top: 80px; padding: 2rem 0 4rem; background: #f8fafc; }
  .module-header { background: linear-gradient(135deg, color-mix(in srgb, var(--brand) 85%, #000) 0%, var(--brand) 100%); color: white; padding: 2rem; border-radius: 18px; margin-bottom: 1.75rem; }
  .module-header h1 { margin: 0 0 .3rem; font-size: 1.7rem; font-weight: 800; }
  .module-header p  { margin: 0; opacity: .8; font-size: .95rem; }
  .section-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 10px rgba(0,0,0,.06); padding: 1.5rem; margin-bottom: 1.25rem; }
  .section-card h3 { font-size: .95rem; font-weight: 700; margin: 0 0 1rem; padding-bottom: .65rem; border-bottom: 2px solid #f1f5f9; display: flex; align-items: center; gap: .5rem; }
  .lesson-card { display: flex; align-items: center; gap: .9rem; padding: .85rem 1rem; border-radius: 12px; border: 1px solid #e2e8f0; margin-bottom: .5rem; text-decoration: none; color: inherit; transition: border-color .2s; }
  .lesson-card.unlocked:hover { border-color: var(--brand); color: inherit; }
  .lesson-card.locked  { opacity: .5; cursor: not-allowed; }
  .lesson-card.completed { border-left: 4px solid #22c55e; }
  .lesson-card.unlocked:not(.completed) { border-left: 4px solid var(--brand); }
  .lesson-icon { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0; }
  .icon-video { background: #dbeafe; } .icon-text { background: #f3e8ff; }
  .icon-pdf   { background: #fef9c3; } .icon-quiz { background: #dcfce7; }
  .status-badge { padding: .2rem .65rem; border-radius: 20px; font-size: .75rem; font-weight: 600; }
  .badge-passed    { background: #d1fae5; color: #065f46; }
  .badge-failed    { background: #fee2e2; color: #991b1b; }
  .badge-submitted { background: #dbeafe; color: #1e40af; }
  .btn-action { display: inline-flex; align-items: center; gap: .4rem; padding: .55rem 1.2rem; border-radius: 10px; font-weight: 600; font-size: .9rem; text-decoration: none; border: none; cursor: pointer; transition: opacity .2s; }
  .btn-primary-brand { background: var(--brand); color: #fff; }
  .btn-primary-brand:hover { opacity: .88; color: #fff; }
  .btn-outline-brand { background: #fff; color: var(--brand); border: 1.5px solid var(--brand); }
  .btn-outline-brand:hover { background: color-mix(in srgb, var(--brand) 8%, #fff); color: var(--brand); }
  .inst-pill { display: inline-flex; align-items: center; gap: .45rem; background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.28); border-radius: 30px; padding: .25rem .75rem .25rem .35rem; margin-bottom: .9rem; }
  .inst-pill-logo { width: 22px; height: 22px; border-radius: 50%; object-fit: contain; background: rgba(255,255,255,.85); }
  .inst-pill-fallback { width: 22px; height: 22px; border-radius: 50%; background: rgba(255,255,255,.9); color: var(--brand); font-size: .58rem; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .inst-pill-name { font-size: .78rem; font-weight: 700; color: rgba(255,255,255,.92); }
</style>` %>

<div class="page-wrapper">
  <div class="container" style="max-width:780px;">

    <% const _mi = typeof institution !== 'undefined' ? institution : null; %>
    <div class="module-header">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
          <% if (_mi) { %>
            <div class="inst-pill">
              <% if (_mi.logoUrl) { %><img src="<%= _mi.logoUrl %>" class="inst-pill-logo" alt="<%= _mi.name %>">
              <% } else { %><div class="inst-pill-fallback"><%= _mi.name.substring(0,2).toUpperCase() %></div><% } %>
              <span class="inst-pill-name"><%= _mi.name %></span>
            </div>
          <% } %>
          <p style="opacity:.7;font-size:.82rem;margin:0 0 .2rem;"><%= course.title %></p>
          <h1><%= courseModule.title %></h1>
          <% if (courseModule.description) { %><p><%= courseModule.description %></p><% } %>
        </div>
        <a href="/institution/learn/courses/<%= course._id %>" class="btn btn-light btn-sm">← Cours</a>
      </div>
    </div>

    <%- include('../../partials/flash') %>

    <!-- Lessons -->
    <div class="section-card">
      <h3>📚 Leçons (<%= lessonsWithStatus.filter(l => l.completed).length %>/<%= lessonsWithStatus.length %> terminées)</h3>

      <% if (lessonsWithStatus.length === 0) { %>
        <p class="text-muted small">Aucune leçon pour ce module.</p>
      <% } else { %>
        <% const icons      = { video: '▶', text: '📄', pdf: '📎', practice_quiz: '🧩' }; %>
        <% const iconClass  = { video: 'icon-video', text: 'icon-text', pdf: 'icon-pdf', practice_quiz: 'icon-quiz' }; %>
        <% lessonsWithStatus.forEach(({ lesson, completed, unlocked }) => { %>
          <% if (unlocked) { %>
            <a href="/institution/learn/courses/<%= course._id %>/modules/<%= courseModule._id %>/lessons/<%= lesson._id %>"
               class="lesson-card unlocked <%= completed ? 'completed' : '' %>">
          <% } else { %>
            <div class="lesson-card locked">
          <% } %>
              <div class="lesson-icon <%= iconClass[lesson.type] || '' %>"><%= icons[lesson.type] || '•' %></div>
              <div class="flex-grow-1">
                <div class="fw-semibold" style="font-size:.95rem;"><%= lesson.title %></div>
                <% if (lesson.description) { %><div class="text-muted small"><%= lesson.description %></div><% } %>
              </div>
              <% if (!unlocked) { %>
                <span style="color:#cbd5e1;">🔒</span>
              <% } else if (completed) { %>
                <span style="color:#22c55e;font-size:1.1rem;">✓</span>
              <% } else { %>
                <span class="text-muted small" style="color:var(--brand)!important;">→</span>
              <% } %>
          <% if (unlocked) { %></a><% } else { %></div><% } %>
        <% }) %>
      <% } %>
    </div>

    <!-- Module Quiz -->
    <% if (courseModule.quiz && courseModule.quiz.questions && courseModule.quiz.questions.length > 0) { %>
    <div class="section-card">
      <h3>📝 Quiz du module</h3>
      <% if (!allLessonsDone) { %>
        <p class="text-muted small mb-0">Terminez toutes les leçons pour débloquer le quiz.</p>
      <% } else if (quizAttempt) { %>
        <div class="d-flex align-items-center gap-3 flex-wrap">
          <span class="status-badge <%= quizAttempt.passed ? 'badge-passed' : 'badge-failed' %>">
            <%= quizAttempt.passed ? '✓ Réussi' : '✗ Échoué' %> — <%= quizAttempt.score %>/100
          </span>
          <% if (!quizAttempt.passed) { %>
            <a href="/institution/learn/courses/<%= course._id %>/modules/<%= courseModule._id %>/quiz" class="btn-action btn-outline-brand">Réessayer</a>
          <% } %>
        </div>
      <% } else { %>
        <a href="/institution/learn/courses/<%= course._id %>/modules/<%= courseModule._id %>/quiz" class="btn-action btn-primary-brand">
          Commencer le quiz (<%= courseModule.quiz.questions.length %> questions)
        </a>
      <% } %>
    </div>
    <% } %>

    <!-- Module Assignment -->
    <% if (courseModule.assignment && courseModule.assignment.title) { %>
    <div class="section-card">
      <h3>📋 Devoir du module</h3>
      <% if (!allLessonsDone) { %>
        <p class="text-muted small mb-0">Terminez toutes les leçons pour débloquer le devoir.</p>
      <% } else if (assignmentSubmission) { %>
        <span class="status-badge <%= assignmentSubmission.status === 'graded' ? 'badge-passed' : 'badge-submitted' %>">
          <%= assignmentSubmission.status === 'graded'
              ? `Note : ${assignmentSubmission.grade}/${courseModule.assignment.maxScore || 100}`
              : '⏳ En attente de correction' %>
        </span>
        <% if (assignmentSubmission.feedback) { %>
          <p class="mt-2 small text-muted mb-0"><strong>Feedback :</strong> <%= assignmentSubmission.feedback %></p>
        <% } %>
      <% } else { %>
        <div class="text-muted small mb-2" style="line-height:1.6;"><%- courseModule.assignment.instructions %></div>
        <a href="/institution/learn/courses/<%= course._id %>/modules/<%= courseModule._id %>/assignment" class="btn-action btn-primary-brand">
          Remettre le devoir
        </a>
      <% } %>
    </div>
    <% } %>

  </div>
</div>
