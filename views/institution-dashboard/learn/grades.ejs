<% layout('layouts/institutionBoilerplate') %>

<% const _color = typeof institutionColor !== 'undefined' ? institutionColor : '#0e7490'; %>
<% headContent = `<style>
  :root { --brand: ${_color}; }
  .page-wrapper { margin-top: 80px; padding: 2rem 0 5rem; background: #f8fafc; min-height: 100vh; }
  .grades-hero { background: linear-gradient(135deg, color-mix(in srgb, var(--brand) 85%, #000) 0%, var(--brand) 100%); color: #fff; padding: 2.5rem 0 3.5rem; }
  .grades-hero h1 { font-size: 1.9rem; font-weight: 800; margin: 0 0 .25rem; }
  .grades-hero p  { opacity: .8; margin: 0; font-size: .95rem; }
  .content-area { max-width: 820px; margin: -1.5rem auto 0; padding: 0 1rem; position: relative; z-index: 5; }
  /* Summary bar */
  .summary-bar { background: #fff; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,.1); padding: 1.5rem 2rem; display: flex; gap: 2rem; flex-wrap: wrap; margin-bottom: 1.75rem; }
  .summary-stat { text-align: center; }
  .summary-stat .num { font-size: 1.9rem; font-weight: 800; color: var(--brand); line-height: 1; }
  .summary-stat .lbl { font-size: .75rem; color: #64748b; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; margin-top: .2rem; }
  .summary-divider { width: 1px; background: #f1f5f9; flex-shrink: 0; }
  /* Section */
  .section { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,.06); margin-bottom: 1.25rem; overflow: hidden; }
  .section-head { padding: 1.1rem 1.5rem; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; justify-content: space-between; }
  .section-head h2 { font-size: .95rem; font-weight: 700; color: #1e293b; margin: 0; display: flex; align-items: center; gap: .5rem; }
  /* Grade row */
  .grade-row { display: grid; grid-template-columns: 1fr auto; gap: 1rem; align-items: start; padding: 1.1rem 1.5rem; border-bottom: 1px solid #f8fafc; }
  .grade-row:last-child { border-bottom: none; }
  .grade-row-title { font-weight: 600; font-size: .9rem; color: #1e293b; margin-bottom: .15rem; }
  .grade-row-sub { font-size: .78rem; color: #64748b; }
  .grade-right { text-align: right; flex-shrink: 0; }
  /* Status pills */
  .pill { display: inline-flex; align-items: center; gap: .3rem; padding: .25rem .75rem; border-radius: 20px; font-size: .78rem; font-weight: 700; white-space: nowrap; }
  .pill-pass    { background: #d1fae5; color: #065f46; }
  .pill-fail    { background: #fee2e2; color: #991b1b; }
  .pill-pending { background: #fef9c3; color: #854d0e; }
  .pill-none    { background: #f1f5f9; color: #94a3b8; }
  /* Score display */
  .score-big { font-size: 1.4rem; font-weight: 800; color: var(--brand); line-height: 1; }
  .score-max { font-size: .75rem; color: #94a3b8; }
  /* Feedback block */
  .feedback-block { margin-top: .75rem; background: #eff6ff; border-radius: 10px; padding: .75rem 1rem; border-left: 3px solid var(--brand); }
  .feedback-block p { margin: 0; font-size: .85rem; color: #1e40af; line-height: 1.6; }
  .feedback-label { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #3b82f6; margin-bottom: .3rem; }
  /* Empty */
  .empty-state { text-align: center; padding: 3rem 2rem; color: #94a3b8; }
  .empty-state p:first-child { font-size: 2.5rem; margin-bottom: .5rem; }
  /* Institution pill */
  .inst-pill { display: inline-flex; align-items: center; gap: .45rem; background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.28); border-radius: 30px; padding: .25rem .75rem .25rem .35rem; margin-bottom: .9rem; }
  .inst-pill-logo { width: 22px; height: 22px; border-radius: 50%; object-fit: contain; background: rgba(255,255,255,.85); }
  .inst-pill-fallback { width: 22px; height: 22px; border-radius: 50%; background: rgba(255,255,255,.9); color: var(--brand); font-size: .58rem; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .inst-pill-name { font-size: .78rem; font-weight: 700; color: rgba(255,255,255,.92); }
  @media (max-width: 640px) { .summary-bar { gap: 1.2rem; } .summary-divider { display: none; } }
</style>` %>

<%
  const _inst = typeof institution !== 'undefined' ? institution : null;
  const _initials = _inst ? _inst.name.substring(0,2).toUpperCase() : 'I';

  // compute totals
  let quizTotal = 0, quizPassed = 0;
  let assignTotal = 0, assignGraded = 0, assignPending = 0;
  moduleGrades.forEach(({ quiz, assignment, hasQuiz, hasAssignment }) => {
    if (hasQuiz) { quizTotal++; if (quiz && quiz.passed) quizPassed++; }
    if (hasAssignment) { assignTotal++; if (assignment && assignment.status === 'graded') assignGraded++; else if (assignment) assignPending++; }
  });
  const hasFinalExam    = course.finalExam && course.finalExam.questions && course.finalExam.questions.length > 0;
  const hasFinalProject = course.finalProject && course.finalProject.title;
%>

<div class="page-wrapper">
  <div class="grades-hero">
    <div class="container">
      <% if (_inst) { %>
        <div class="inst-pill">
          <% if (_inst.logoUrl) { %><img src="<%= _inst.logoUrl %>" class="inst-pill-logo" alt="<%= _inst.name %>">
          <% } else { %><div class="inst-pill-fallback"><%= _initials %></div><% } %>
          <span class="inst-pill-name"><%= _inst.name %></span>
        </div>
      <% } %>
      <a href="/institution/learn/courses/<%= course._id %>" style="color:rgba(255,255,255,.7);font-size:.875rem;text-decoration:none;display:block;margin-bottom:.5rem;">← <%= course.title %></a>
      <h1>📊 Mes notes</h1>
      <p>Résumé de toutes vos évaluations pour ce cours.</p>
    </div>
  </div>

  <div class="content-area">
    <%- include('../../partials/flash') %>

    <!-- Summary bar -->
    <div class="summary-bar">
      <div class="summary-stat">
        <div class="num"><%= quizPassed %>/<%= quizTotal %></div>
        <div class="lbl">Quiz réussis</div>
      </div>
      <div class="summary-divider"></div>
      <div class="summary-stat">
        <div class="num"><%= assignGraded %>/<%= assignTotal %></div>
        <div class="lbl">Devoirs notés</div>
      </div>
      <% if (hasFinalExam) { %>
      <div class="summary-divider"></div>
      <div class="summary-stat">
        <div class="num" style="font-size:1.4rem;"><%= bestFinalExam ? bestFinalExam.score + '%' : '—' %></div>
        <div class="lbl">Examen final</div>
      </div>
      <% } %>
      <% if (hasFinalProject) { %>
      <div class="summary-divider"></div>
      <div class="summary-stat">
        <div class="num" style="font-size:1.4rem;">
          <% if (finalProjectSub && finalProjectSub.status === 'graded') { %><%= finalProjectSub.grade %>pts
          <% } else if (finalProjectSub) { %>⏳
          <% } else { %>—<% } %>
        </div>
        <div class="lbl">Projet final</div>
      </div>
      <% } %>
      <% if (pendingCount > 0) { %>
      <div class="summary-divider"></div>
      <div class="summary-stat">
        <div class="num" style="color:#f59e0b;"><%= pendingCount %></div>
        <div class="lbl">En attente</div>
      </div>
      <% } %>
    </div>

    <!-- Module evaluations -->
    <% if (moduleGrades.length === 0) { %>
      <div class="section">
        <div class="empty-state">
          <p>📋</p>
          <p style="font-weight:600;">Aucune évaluation dans ce cours pour l'instant.</p>
        </div>
      </div>
    <% } else { %>
      <% moduleGrades.forEach(({ module, quiz, assignment, hasQuiz, hasAssignment }, idx) => { %>
      <div class="section">
        <div class="section-head">
          <h2>
            <span style="width:26px;height:26px;border-radius:50%;background:color-mix(in srgb,var(--brand) 12%,#fff);color:var(--brand);font-size:.75rem;font-weight:800;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;"><%= idx + 1 %></span>
            <%= module.title %>
          </h2>
        </div>

        <% if (hasQuiz) { %>
        <div class="grade-row">
          <div>
            <div class="grade-row-title">📝 Quiz</div>
            <div class="grade-row-sub">
              <%= module.quiz.questions.length %> question<%= module.quiz.questions.length > 1 ? 's' : '' %> ·
              Score requis : <%= module.quiz.passingScore || 70 %>/100
            </div>
            <% if (quiz && !quiz.passed) { %>
              <a href="/institution/learn/courses/<%= course._id %>/modules/<%= module._id %>/quiz"
                 style="font-size:.78rem;color:var(--brand);text-decoration:none;display:inline-block;margin-top:.4rem;">
                Réessayer →
              </a>
            <% } %>
          </div>
          <div class="grade-right">
            <% if (!quiz) { %>
              <span class="pill pill-none">Non tenté</span>
            <% } else { %>
              <div class="score-big"><%= quiz.score %><span class="score-max">/100</span></div>
              <div style="margin-top:.25rem;">
                <span class="pill <%= quiz.passed ? 'pill-pass' : 'pill-fail' %>">
                  <%= quiz.passed ? '✓ Réussi' : '✗ Échoué' %>
                </span>
              </div>
              <% if (quiz.attempts > 1) { %>
                <div class="score-max mt-1"><%= quiz.attempts %> tentative<%= quiz.attempts > 1 ? 's' : '' %></div>
              <% } %>
            <% } %>
          </div>
        </div>
        <% } %>

        <% if (hasAssignment) { %>
        <div class="grade-row">
          <div style="flex:1;">
            <div class="grade-row-title">📋 <%= module.assignment.title %></div>
            <div class="grade-row-sub">Score max : <%= module.assignment.maxScore || 100 %> pts</div>
            <% if (!assignment) { %>
              <a href="/institution/learn/courses/<%= course._id %>/modules/<%= module._id %>/assignment"
                 style="font-size:.78rem;color:var(--brand);text-decoration:none;display:inline-block;margin-top:.4rem;">
                Soumettre →
              </a>
            <% } %>
            <% if (assignment && assignment.feedback) { %>
              <div class="feedback-block">
                <div class="feedback-label">Feedback de l'instructeur</div>
                <p><%= assignment.feedback %></p>
              </div>
            <% } %>
          </div>
          <div class="grade-right">
            <% if (!assignment) { %>
              <span class="pill pill-none">Non soumis</span>
            <% } else if (assignment.status === 'graded') { %>
              <div class="score-big"><%= assignment.grade %><span class="score-max">/<%= module.assignment.maxScore || 100 %></span></div>
              <div style="margin-top:.25rem;"><span class="pill pill-pass">✓ Noté</span></div>
            <% } else { %>
              <span class="pill pill-pending">⏳ En attente</span>
            <% } %>
          </div>
        </div>
        <% } %>
      </div>
      <% }) %>
    <% } %>

    <!-- Final exam -->
    <% if (hasFinalExam) { %>
    <div class="section">
      <div class="section-head">
        <h2>🎓 Examen final</h2>
        <% if (!bestFinalExam) { %>
          <a href="/institution/learn/courses/<%= course._id %>/final-exam"
             style="font-size:.82rem;color:var(--brand);text-decoration:none;font-weight:600;">
            Passer l'examen →
          </a>
        <% } %>
      </div>
      <div class="grade-row">
        <div>
          <div class="grade-row-title"><%= course.finalExam.title || 'Examen final' %></div>
          <div class="grade-row-sub">
            <%= course.finalExam.questions.length %> questions ·
            Score requis : <%= course.finalExam.passingScore || 70 %>/100
            <% if (course.finalExam.timeLimit) { %> · <%= course.finalExam.timeLimit %> min<% } %>
          </div>
          <% if (bestFinalExam && !bestFinalExam.passed) { %>
            <a href="/institution/learn/courses/<%= course._id %>/final-exam"
               style="font-size:.78rem;color:var(--brand);text-decoration:none;display:inline-block;margin-top:.4rem;">
              Réessayer →
            </a>
          <% } %>
        </div>
        <div class="grade-right">
          <% if (!bestFinalExam) { %>
            <span class="pill pill-none">Non tenté</span>
          <% } else { %>
            <div class="score-big"><%= bestFinalExam.score %><span class="score-max">/100</span></div>
            <div style="margin-top:.25rem;">
              <span class="pill <%= bestFinalExam.passed ? 'pill-pass' : 'pill-fail' %>">
                <%= bestFinalExam.passed ? '✓ Réussi' : '✗ Échoué' %>
              </span>
            </div>
          <% } %>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Final project -->
    <% if (hasFinalProject) { %>
    <div class="section">
      <div class="section-head">
        <h2>🎯 Projet final</h2>
        <% if (!finalProjectSub) { %>
          <a href="/institution/learn/courses/<%= course._id %>/final-project"
             style="font-size:.82rem;color:var(--brand);text-decoration:none;font-weight:600;">
            Soumettre →
          </a>
        <% } %>
      </div>
      <div class="grade-row">
        <div style="flex:1;">
          <div class="grade-row-title"><%= course.finalProject.title %></div>
          <div class="grade-row-sub">Score max : <%= course.finalProject.maxScore || 100 %> pts</div>
          <% if (finalProjectSub && finalProjectSub.feedback) { %>
            <div class="feedback-block">
              <div class="feedback-label">Feedback de l'instructeur</div>
              <p><%= finalProjectSub.feedback %></p>
            </div>
          <% } %>
        </div>
        <div class="grade-right">
          <% if (!finalProjectSub) { %>
            <span class="pill pill-none">Non soumis</span>
          <% } else if (finalProjectSub.status === 'graded') { %>
            <div class="score-big"><%= finalProjectSub.grade %><span class="score-max">/<%= course.finalProject.maxScore || 100 %></span></div>
            <div style="margin-top:.25rem;"><span class="pill pill-pass">✓ Noté</span></div>
          <% } else { %>
            <span class="pill pill-pending">⏳ En attente de correction</span>
          <% } %>
        </div>
      </div>
    </div>
    <% } %>

  </div>
</div>
