<% layout('layouts/institutionBoilerplate') %>
<% const quiz     = quizType === 'final_exam' ? course.finalExam : courseModule.moduleQuiz; %>
<% const isFinal  = quizType === 'final_exam'; %>

<% headContent = `<style>
  :root { --brand: ${institutionColor}; }
  .page-wrapper { margin-top: 80px; padding: 2rem 0 4rem; background: #f8fafc; }
  .quiz-header { background: linear-gradient(135deg, color-mix(in srgb, var(--brand) 85%, #000) 0%, var(--brand) 100%); color: white; padding: 2rem; border-radius: 18px; margin-bottom: 1.75rem; }
  .quiz-header h1 { margin: 0 0 .3rem; font-size: 1.6rem; font-weight: 800; }
  .quiz-header p  { margin: 0; opacity: .8; }
  .card { border-radius: 16px; border: none; box-shadow: 0 2px 12px rgba(0,0,0,.07); }
  .question-block { background: #fff; border-radius: 14px; box-shadow: 0 1px 8px rgba(0,0,0,.06); padding: 1.5rem; margin-bottom: 1rem; }
  .question-num { font-size: .75rem; font-weight: 700; text-transform: uppercase; color: var(--brand); letter-spacing: .05em; margin-bottom: .4rem; }
  .question-text { font-weight: 600; color: #1e293b; margin-bottom: 1rem; font-size: 1rem; }
  .option-label { display: flex; align-items: center; gap: .75rem; padding: .65rem .9rem; border-radius: 10px; border: 2px solid #e2e8f0; margin-bottom: .4rem; cursor: pointer; transition: border-color .15s, background .15s; }
  .option-label:hover { border-color: var(--brand); background: color-mix(in srgb, var(--brand) 6%, #fff); }
  input[type=radio]:checked + .option-label { border-color: var(--brand); background: color-mix(in srgb, var(--brand) 10%, #fff); }
  input[type=radio] { display: none; }
  .btn-submit { background: var(--brand); color: #fff; border: none; padding: .9rem 2.5rem; border-radius: 14px; font-weight: 700; font-size: 1rem; cursor: pointer; transition: opacity .2s; }
  .btn-submit:hover { opacity: .88; }
  .attempt-banner { border-radius: 14px; padding: 1.2rem 1.5rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .attempt-passed { background: #d1fae5; border: 1px solid #6ee7b7; }
  .attempt-failed { background: #fee2e2; border: 1px solid #fca5a5; }
</style>` %>

<div class="page-wrapper">
  <div class="container" style="max-width:760px;">

    <div class="quiz-header">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
          <p style="opacity:.7;font-size:.82rem;margin:0 0 .2rem;">
            <%= course.title %><% if (!isFinal) { %> › <%= courseModule.title %><% } %>
          </p>
          <h1><%= isFinal ? (quiz.title || 'Examen final') : (quiz.title || 'Quiz du module') %></h1>
          <p>
            <%= quiz.questions.length %> question<%= quiz.questions.length > 1 ? 's' : '' %> ·
            Score requis : <%= quiz.passingScore || 70 %>/100
            <% if (quiz.timeLimit) { %>· <%= quiz.timeLimit %> min<% } %>
          </p>
        </div>
        <a href="<%= backUrl %>" class="btn btn-light btn-sm">← Retour</a>
      </div>
    </div>

    <%- include('../../partials/flash') %>

    <!-- Last attempt result -->
    <% if (lastAttempt) { %>
      <div class="attempt-banner <%= lastAttempt.passed ? 'attempt-passed' : 'attempt-failed' %>">
        <div style="font-size:1.5rem;"><%= lastAttempt.passed ? '🎉' : '😔' %></div>
        <div>
          <strong><%= lastAttempt.passed ? 'Réussi' : 'Échoué' %></strong> —
          Dernière tentative : <%= lastAttempt.score %>/100
          <% if (!lastAttempt.passed) { %>
            <div class="small" style="color:#6b7280;">Vous pouvez réessayer.</div>
          <% } %>
        </div>
      </div>
    <% } %>

    <% if (!lastAttempt || !lastAttempt.passed) { %>
    <form action="<%= submitUrl %>" method="POST">
      <% quiz.questions.forEach((q, idx) => { %>
        <div class="question-block">
          <div class="question-num">Question <%= idx + 1 %></div>
          <div class="question-text"><%= q.text %></div>
          <% q.options.forEach(opt => { %>
            <div>
              <input type="radio" name="answers[<%= idx %>]" value="<%= opt.value %>" id="q<%= idx %>_<%= opt.value %>">
              <label class="option-label" for="q<%= idx %>_<%= opt.value %>">
                <span style="width:18px;height:18px;border:2px solid #cbd5e1;border-radius:50%;flex-shrink:0;"></span>
                <%= opt.text %>
              </label>
            </div>
          <% }) %>
        </div>
      <% }) %>

      <div class="d-flex justify-content-between align-items-center mt-3">
        <button type="submit" class="btn-submit">
          <i class="bi bi-send me-2"></i>Soumettre le <%= isFinal ? 'examen' : 'quiz' %>
        </button>
      </div>
    </form>
    <% } else { %>
      <div class="text-center py-4">
        <p class="fs-2 mb-2">✅</p>
        <p class="fw-semibold text-success"><%= isFinal ? 'Examen final réussi !' : 'Quiz réussi !' %></p>
        <a href="<%= backUrl %>" class="btn btn-success px-4 rounded-pill mt-2">← Retour</a>
      </div>
    <% } %>

  </div>
</div>
