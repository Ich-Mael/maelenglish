<% layout('layouts/institutionBoilerplate') %>

<% headContent = `<style>
  :root { --brand: ${institutionColor}; }
  .page-wrapper { margin-top: 80px; padding: 2.5rem 0 5rem; min-height: 100vh; background: #f8fafc; }
  .page-header { background: linear-gradient(135deg, var(--brand) 0%, color-mix(in srgb, var(--brand) 70%, #000) 100%); color: white; padding: 2.5rem 2rem; border-radius: 20px; margin-bottom: 2rem; box-shadow: 0 8px 30px rgba(0,0,0,.15); }
  .page-header h1 { margin: 0 0 .3rem; font-size: 1.9rem; font-weight: 800; }
  .page-header p  { margin: 0; opacity: .85; font-size: 1rem; }
  .courses-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px,1fr)); gap: 1.5rem; }
  .course-card { background: #fff; border-radius: 18px; box-shadow: 0 2px 16px rgba(0,0,0,.07); overflow: hidden; display: flex; flex-direction: column; transition: transform .25s, box-shadow .25s; }
  .course-card:hover { transform: translateY(-4px); box-shadow: 0 8px 28px rgba(0,0,0,.12); }
  .card-thumb { height: 170px; background: linear-gradient(135deg, var(--brand), color-mix(in srgb, var(--brand) 60%, #fff)); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .card-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .card-thumb-icon { font-size: 3.5rem; opacity: .35; color: #fff; }
  .card-body { padding: 1.4rem; flex: 1; display: flex; flex-direction: column; }
  .card-category { font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--brand); margin-bottom: .4rem; }
  .card-title { font-size: 1.15rem; font-weight: 700; color: #1e293b; margin: 0 0 1rem; line-height: 1.35; }
  .progress-wrap { margin-bottom: 1rem; }
  .progress-bar-bg { height: 6px; border-radius: 3px; background: #e2e8f0; overflow: hidden; }
  .progress-bar-fill { height: 100%; background: var(--brand); border-radius: 3px; transition: width .4s; }
  .progress-label { font-size: .78rem; color: #64748b; margin-top: .3rem; display: flex; justify-content: space-between; }
  .expiry-badge { font-size: .75rem; font-weight: 600; padding: .2rem .65rem; border-radius: 20px; display: inline-flex; align-items: center; gap: .35rem; margin-bottom: .75rem; }
  .badge-active  { background: #d1fae5; color: #065f46; }
  .badge-expired { background: #fee2e2; color: #991b1b; }
  .btn-continue { display: flex; align-items: center; justify-content: center; gap: .5rem; width: 100%; padding: .75rem; background: var(--brand); color: #fff; border-radius: 12px; font-weight: 600; text-decoration: none; margin-top: auto; transition: opacity .2s; }
  .btn-continue:hover { opacity: .88; color: #fff; }
  .btn-expired { background: #94a3b8 !important; pointer-events: none; }
  .empty-state { text-align: center; padding: 5rem 2rem; background: #fff; border-radius: 20px; box-shadow: 0 2px 12px rgba(0,0,0,.06); }
  .empty-state i { font-size: 3.5rem; color: #cbd5e1; display: block; margin-bottom: 1rem; }
  .inst-hero-brand { display: flex; align-items: center; gap: .65rem; margin-bottom: 1.1rem; }
  .inst-hero-logo { width: 48px; height: 48px; border-radius: 12px; object-fit: contain; background: rgba(255,255,255,.2); border: 2px solid rgba(255,255,255,.3); padding: 2px; }
  .inst-hero-fallback { width: 48px; height: 48px; border-radius: 12px; background: rgba(255,255,255,.25); color: #fff; font-size: .85rem; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 2px solid rgba(255,255,255,.3); }
  .inst-hero-name { font-size: 1rem; font-weight: 700; color: rgba(255,255,255,.95); letter-spacing: .01em; }
  .inst-hero-tagline { font-size: .78rem; color: rgba(255,255,255,.65); }
  .ann-list { margin-bottom: 1.75rem; display: flex; flex-direction: column; gap: .65rem; }
  .ann-item { background: #fff; border-radius: 14px; border-left: 4px solid var(--brand); padding: 1rem 1.25rem 1rem 1.1rem; box-shadow: 0 1px 8px rgba(0,0,0,.06); display: flex; gap: 1rem; align-items: flex-start; }
  .ann-item.pinned { background: color-mix(in srgb, var(--brand) 5%, #fff); }
  .ann-icon { font-size: 1.25rem; flex-shrink: 0; line-height: 1; margin-top: .1rem; }
  .ann-content { flex: 1; min-width: 0; }
  .ann-header { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin-bottom: .25rem; }
  .ann-title { font-weight: 700; font-size: .92rem; color: #1e293b; margin: 0; }
  .ann-pin { font-size: .75rem; color: var(--brand); font-weight: 600; }
  .ann-body { font-size: .85rem; color: #475569; line-height: 1.6; margin: 0 0 .3rem; white-space: pre-line; }
  .ann-meta { font-size: .73rem; color: #94a3b8; }
  .ann-dismiss { background: none; border: none; color: #cbd5e1; font-size: 1.1rem; cursor: pointer; padding: 0; flex-shrink: 0; line-height: 1; margin-top: .1rem; }
  .ann-dismiss:hover { color: #94a3b8; }
  .type-info       { --ann-icon: '📢'; }
  .type-discount   { --ann-icon: '🎉'; }
  .type-new_course { --ann-icon: '📚'; }
  .type-event      { --ann-icon: '📅'; }
  .type-reminder   { --ann-icon: '⏰'; }
</style>` %>

<div class="page-wrapper">
  <div class="container">
    <% const _i = institution; const _ini = _i ? _i.name.substring(0,2).toUpperCase() : 'I'; %>
    <div class="page-header">
      <div class="inst-hero-brand">
        <% if (_i && _i.logoUrl) { %>
          <img src="<%= _i.logoUrl %>" alt="<%= _i.name %>" class="inst-hero-logo">
        <% } else { %>
          <div class="inst-hero-fallback"><%= _ini %></div>
        <% } %>
        <div>
          <div class="inst-hero-name"><%= _i ? _i.name : '' %></div>
          <% if (_i && (_i.city || _i.country)) { %>
            <div class="inst-hero-tagline"><i class="bi bi-geo-alt me-1"></i><%= [_i.city, _i.country].filter(Boolean).join(', ') %></div>
          <% } %>
        </div>
      </div>
      <h1 style="font-size:1.6rem;"><i class="bi bi-mortarboard-fill me-2"></i>Mes cours</h1>
      <p>Bienvenue, <%= typeof currentUser !== 'undefined' && currentUser ? currentUser.name || currentUser.username : '' %></p>
    </div>

    <%- include('../../partials/flash') %>

    <% if (typeof announcements !== 'undefined' && announcements.length > 0) { %>
    <%
      const _annIcons = { info: '📢', discount: '🎉', new_course: '📚', event: '📅', reminder: '⏰' };
    %>
    <div class="ann-list" id="annList">
      <% announcements.forEach(ann => { %>
        <div class="ann-item <%= ann.isPinned ? 'pinned' : '' %>" data-ann-id="<%= ann._id %>">
          <span class="ann-icon"><%= _annIcons[ann.type] || '📢' %></span>
          <div class="ann-content">
            <div class="ann-header">
              <p class="ann-title"><%= ann.title %></p>
              <% if (ann.isPinned) { %><span class="ann-pin">📌 Épinglé</span><% } %>
            </div>
            <p class="ann-body"><%= ann.body %></p>
            <p class="ann-meta"><%= new Date(ann.createdAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
          </div>
          <button class="ann-dismiss" title="Masquer" onclick="dismissAnn(this, '<%= ann._id %>')">×</button>
        </div>
      <% }) %>
    </div>
    <% } %>

    <% if (coursesWithProgress.length === 0) { %>
      <div class="empty-state">
        <i class="bi bi-journal-bookmark"></i>
        <h3 style="font-weight:700;color:#1e293b;">Aucun cours disponible</h3>
        <p style="color:#64748b;max-width:400px;margin:.5rem auto 0;">Contactez votre institution pour être inscrit à un cours.</p>
      </div>
    <% } else { %>
      <div class="courses-grid">
        <% coursesWithProgress.forEach(({ course, completed, total, pct, enrollment, resumeUrl }) => {
          const now = new Date();
          const isExpired = enrollment && enrollment.endDate && new Date(enrollment.endDate) < now;
          const daysLeft  = enrollment && enrollment.endDate ? Math.ceil((new Date(enrollment.endDate) - now) / 86400000) : null;
        %>
          <div class="course-card">
            <div class="card-thumb">
              <% if (course.imageUrl) { %>
                <img src="<%= course.imageUrl %>" alt="<%= course.title %>">
              <% } else { %>
                <i class="bi bi-book-half card-thumb-icon"></i>
              <% } %>
            </div>
            <div class="card-body">
              <span class="card-category"><%= course.category || 'Formation' %></span>
              <h3 class="card-title"><%= course.title %></h3>

              <% if (enrollment && enrollment.endDate) { %>
                <% if (isExpired) { %>
                  <span class="expiry-badge badge-expired"><i class="bi bi-x-circle-fill"></i> Accès expiré</span>
                <% } else { %>
                  <span class="expiry-badge badge-active"><i class="bi bi-clock-history"></i> Expire dans <%= daysLeft %> j</span>
                <% } %>
              <% } %>

              <div class="progress-wrap">
                <div class="progress-bar-bg">
                  <div class="progress-bar-fill" style="width:<%= pct %>%"></div>
                </div>
                <div class="progress-label">
                  <span><%= completed %> / <%= total %> leçons</span>
                  <span><%= pct %>%</span>
                </div>
              </div>

              <a href="<%= isExpired ? '#' : resumeUrl %>" class="btn-continue <%= isExpired ? 'btn-expired' : '' %>">
                <i class="bi bi-play-circle-fill"></i>
                <%= pct === 0 ? 'Commencer' : pct === 100 ? 'Revoir' : 'Continuer' %>
              </a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<script>
(function () {
  const KEY = 'dismissed_anns_<%= typeof institution !== "undefined" && institution ? institution._id : "x" %>';
  const dismissed = new Set(JSON.parse(sessionStorage.getItem(KEY) || '[]'));

  // Hide already-dismissed announcements immediately
  document.querySelectorAll('[data-ann-id]').forEach(el => {
    if (dismissed.has(el.dataset.annId)) el.style.display = 'none';
  });

  window.dismissAnn = function (btn, id) {
    const item = btn.closest('[data-ann-id]');
    item.style.transition = 'opacity .2s';
    item.style.opacity = '0';
    setTimeout(() => { item.style.display = 'none'; }, 200);
    dismissed.add(id);
    sessionStorage.setItem(KEY, JSON.stringify([...dismissed]));
  };
})();
</script>
