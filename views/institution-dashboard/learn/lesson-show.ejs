<% layout('layouts/institutionBoilerplate') %>

<% headContent = `<style>
  :root { --brand: ${institutionColor}; }
  .page-wrapper { margin-top: 80px; padding: 2rem 0 4rem; background: #f8fafc; }
  .lesson-header { background: linear-gradient(135deg, color-mix(in srgb, var(--brand) 85%, #000) 0%, var(--brand) 100%); color: white; padding: 1.75rem 2rem; border-radius: 16px; margin-bottom: 1.75rem; }
  .lesson-header h1 { margin: 0 0 .25rem; font-size: 1.5rem; font-weight: 800; }
  .lesson-header p  { margin: 0; opacity: .8; font-size: .9rem; }
  .lesson-content-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,.07); padding: 2rem; margin-bottom: 1.5rem; }
  .video-container { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 12px; }
  .video-container iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; border-radius: 12px; }
  .lesson-nav { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .btn-nav { display: inline-flex; align-items: center; gap: .5rem; padding: .7rem 1.4rem; border-radius: 12px; font-weight: 600; text-decoration: none; border: none; cursor: pointer; transition: opacity .2s; }
  .btn-back    { background: #f1f5f9; color: #475569; }
  .btn-back:hover { background: #e2e8f0; color: #475569; }
  .btn-complete { background: var(--brand); color: #fff; }
  .btn-complete:hover { opacity: .88; color: #fff; }
  .btn-next    { background: var(--brand); color: #fff; }
  .btn-next:hover { opacity: .88; color: #fff; }
  /* Sidebar */
  .sidebar-list { background: #fff; border-radius: 14px; box-shadow: 0 2px 8px rgba(0,0,0,.06); padding: 1rem; position: sticky; top: 90px; }
  .sidebar-list .section-label { font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--brand); margin-bottom: .6rem; }
  .sidebar-item { display: flex; align-items: center; gap: .6rem; padding: .5rem .65rem; border-radius: 8px; text-decoration: none; color: #475569; font-size: .85rem; margin-bottom: .2rem; }
  .sidebar-item.active { background: color-mix(in srgb, var(--brand) 10%, #fff); font-weight: 700; color: var(--brand); }
  .sidebar-item:hover:not(.active) { background: #f8fafc; color: #1e293b; }
  /* Practice quiz */
  .practice-opt { display: flex; align-items: center; gap: .75rem; padding: .6rem .8rem; border-radius: 8px; cursor: pointer; margin-bottom: .4rem; border: 2px solid #e2e8f0; transition: border-color .15s; }
  .practice-opt:hover { border-color: var(--brand); }
  .practice-opt.selected { border-color: var(--brand); background: color-mix(in srgb, var(--brand) 8%, #fff); }
  .practice-opt.correct { border-color: #22c55e; background: #f0fdf4; }
  .practice-opt.wrong   { border-color: #ef4444; background: #fef2f2; }
</style>` %>

<div class="page-wrapper">
  <div class="container" style="max-width:1060px;">
    <div class="row g-3">

      <!-- Sidebar -->
      <div class="col-md-3 d-none d-md-block">
        <div class="sidebar-list">
          <p class="section-label"><%= courseModule.title %></p>
          <% lessons.forEach(l => { %>
            <a href="/institution/learn/courses/<%= course._id %>/modules/<%= courseModule._id %>/lessons/<%= l._id %>"
               class="sidebar-item <%= l._id.toString() === lesson._id.toString() ? 'active' : '' %>">
              <span><%= l.type === 'video' ? '▶' : l.type === 'text' ? '📄' : l.type === 'pdf' ? '📎' : '🧩' %></span>
              <span class="flex-grow-1"><%= l.title %></span>
            </a>
          <% }) %>
          <div class="mt-3 pt-2 border-top">
            <a href="/institution/learn/courses/<%= course._id %>/modules/<%= courseModule._id %>/overview"
               class="btn btn-outline-secondary btn-sm w-100">Vue du module</a>
          </div>
        </div>
      </div>

      <!-- Main content -->
      <div class="col-md-9">
        <div class="lesson-header">
          <p><%= course.title %> › <%= courseModule.title %></p>
          <h1><%= lesson.title %></h1>
          <% if (lesson.description) { %><p><%= lesson.description %></p><% } %>
        </div>

        <%- include('../../partials/flash') %>

        <div class="lesson-content-card">
          <% if (lesson.type === 'video') { %>
            <% if (lesson.videoUrl) { %>
              <%
                const isYT    = lesson.videoUrl.includes('youtube') || lesson.videoUrl.includes('youtu.be');
                const isVimeo = lesson.videoUrl.includes('vimeo');
                let embed = lesson.videoUrl;
                if (isYT) {
                  const m = lesson.videoUrl.match(/(?:v=|youtu\.be\/)([^&?]+)/);
                  if (m) embed = 'https://www.youtube.com/embed/' + m[1];
                }
                if (isVimeo) {
                  if (lesson.videoUrl.includes('player.vimeo.com')) {
                    // Already embed format — decode HTML entities from copied embed code
                    embed = lesson.videoUrl.replace(/&amp;/g, '&');
                  } else {
                    const m = lesson.videoUrl.match(/vimeo\.com\/(\d+)/);
                    if (m) embed = 'https://player.vimeo.com/video/' + m[1];
                  }
                }
              %>
              <div class="video-container mb-3">
                <iframe src="<%- embed %>" allowfullscreen allow="autoplay; fullscreen; picture-in-picture" title="<%= lesson.title %>"></iframe>
              </div>
            <% } else { %>
              <p class="text-muted">Aucune vidéo configurée.</p>
            <% } %>
            <% if (lesson.videoDuration) { %><p class="text-muted small"><i class="bi bi-clock me-1"></i><%= lesson.videoDuration %> min</p><% } %>

          <% } else if (lesson.type === 'text') { %>
            <% if (lesson.content) { %>
              <div style="line-height:1.75;color:#334155;"><%- lesson.content %></div>
            <% } else { %>
              <p class="text-muted">Aucun contenu textuel configuré.</p>
            <% } %>

          <% } else if (lesson.type === 'pdf') { %>
            <% if (lesson.fileUrl) { %>
              <div class="text-center py-4">
                <p class="fs-1 mb-2">📎</p>
                <p class="fw-semibold mb-3"><%= lesson.fileName || 'Document' %></p>
                <a href="<%= lesson.fileUrl %>" target="_blank" class="btn btn-primary px-4">
                  <i class="bi bi-download me-2"></i>Télécharger / Ouvrir
                </a>
              </div>
            <% } else { %>
              <p class="text-muted">Aucun fichier configuré.</p>
            <% } %>

          <% } else if (lesson.type === 'practice_quiz') { %>
            <% if (lesson.practiceQuiz && lesson.practiceQuiz.questions && lesson.practiceQuiz.questions.length > 0) { %>
              <h5 class="fw-bold mb-3">🧩 Quiz de pratique</h5>
              <% lesson.practiceQuiz.questions.forEach((q, qi) => { %>
                <div class="mb-4" id="pq_<%= qi %>">
                  <p class="fw-semibold mb-2"><%= qi + 1 %>. <%= q.text %></p>
                  <% q.options.forEach(opt => { %>
                    <div class="practice-opt"
                         onclick="selectOpt(this,'<%= qi %>','<%= opt.value %>','<%= q.correctAnswer %>','<%= (q.explanation||'').replace(/'/g,"\\'") %>')">
                      <span class="opt-mark" style="width:20px;height:20px;border:2px solid #cbd5e1;border-radius:50%;flex-shrink:0;"></span>
                      <span><%= opt.text %></span>
                    </div>
                  <% }) %>
                  <div class="small text-muted mt-2" id="exp_<%= qi %>" style="display:none;"></div>
                </div>
              <% }) %>
            <% } else { %>
              <p class="text-muted">Questions à venir.</p>
            <% } %>
          <% } %>
        </div>

        <!-- Navigation -->
        <div class="lesson-nav">
          <a href="/institution/learn/courses/<%= course._id %>/modules/<%= courseModule._id %>/overview" class="btn-nav btn-back">
            <i class="bi bi-arrow-left"></i> Module
          </a>
          <% if (!isCompleted) { %>
            <form action="/institution/learn/courses/<%= course._id %>/modules/<%= courseModule._id %>/lessons/<%= lesson._id %>/complete" method="POST">
              <button type="submit" class="btn-nav btn-complete">
                <i class="bi bi-check-circle me-1"></i>Marquer terminée et continuer
              </button>
            </form>
          <% } else if (nextLesson) { %>
            <a href="/institution/learn/courses/<%= course._id %>/modules/<%= courseModule._id %>/lessons/<%= nextLesson._id %>" class="btn-nav btn-next">
              Leçon suivante <i class="bi bi-arrow-right"></i>
            </a>
          <% } else { %>
            <a href="/institution/learn/courses/<%= course._id %>/modules/<%= courseModule._id %>/overview" class="btn-nav btn-complete">
              <i class="bi bi-check-circle me-1"></i>Module terminé →
            </a>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
function selectOpt(el, qi, value, correct, explanation) {
  el.closest('#pq_' + qi).querySelectorAll('.practice-opt').forEach(o => {
    o.classList.remove('selected','correct','wrong');
    o.querySelector('.opt-mark').style.cssText = 'width:20px;height:20px;border:2px solid #cbd5e1;border-radius:50%;flex-shrink:0;';
  });
  el.classList.add('selected');
  const ok = value === correct;
  el.classList.add(ok ? 'correct' : 'wrong');
  el.querySelector('.opt-mark').style.background  = ok ? '#22c55e' : '#ef4444';
  el.querySelector('.opt-mark').style.borderColor = ok ? '#22c55e' : '#ef4444';
  const expEl = document.getElementById('exp_' + qi);
  if (explanation) { expEl.innerHTML = (ok ? '✓ ' : '✗ ') + explanation; expEl.style.display = 'block'; expEl.style.color = ok ? '#166534' : '#991b1b'; }
}
</script>
