<% layout('layouts/main') %>

<% headContent = `<style>
  :root { --brand: <%= institutionColor %>; }
  .page-wrapper { margin-top: 80px; padding-bottom: 4rem; background: #f8fafc; }
  .course-hero { background: linear-gradient(135deg, color-mix(in srgb, var(--brand) 85%, #000) 0%, var(--brand) 100%); color: white; padding: 3rem 0 4rem; }
  .course-hero h1 { font-size: 2.2rem; font-weight: 800; margin-bottom: .5rem; }
  .course-hero p  { opacity: .85; font-size: 1.05rem; max-width: 640px; }
  .layout-grid { display: grid; grid-template-columns: 1fr 340px; gap: 2rem; position: relative; z-index: 5; margin-top: -2rem; }
  .section-card { background: #fff; border-radius: 18px; box-shadow: 0 2px 14px rgba(0,0,0,.07); padding: 1.75rem; margin-bottom: 1.5rem; }
  .section-card h2 { font-size: 1.1rem; font-weight: 700; color: #1e293b; margin: 0 0 1.25rem; padding-bottom: .75rem; border-bottom: 2px solid #f1f5f9; display: flex; align-items: center; gap: .5rem; }
  .module-row { display: flex; align-items: center; gap: 1rem; padding: .9rem 1rem; border-radius: 12px; border: 1px solid #e2e8f0; margin-bottom: .6rem; text-decoration: none; color: inherit; transition: border-color .2s, box-shadow .2s; }
  .module-row:hover { border-color: var(--brand); box-shadow: 0 2px 10px rgba(0,0,0,.07); color: inherit; }
  .module-num { width: 34px; height: 34px; border-radius: 50%; background: color-mix(in srgb, var(--brand) 12%, #fff); color: var(--brand); font-size: .85rem; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .module-info { flex: 1; }
  .module-info strong { font-size: .95rem; display: block; }
  .module-meta { font-size: .78rem; color: #64748b; margin-top: .15rem; }
  .mod-progress { width: 70px; }
  .mod-bar-bg  { height: 5px; border-radius: 3px; background: #e2e8f0; overflow: hidden; }
  .mod-bar-fill { height: 100%; background: var(--brand); border-radius: 3px; }
  .mod-pct { font-size: .72rem; color: #64748b; text-align: right; margin-top: .2rem; }
  /* Sidebar */
  .sidebar { position: sticky; top: 95px; }
  .sidebar-card { background: #fff; border-radius: 18px; box-shadow: 0 4px 24px rgba(0,0,0,.1); padding: 1.75rem; }
  .btn-cta { display: flex; align-items: center; justify-content: center; gap: .6rem; width: 100%; padding: .9rem; background: var(--brand); color: #fff; border-radius: 14px; font-weight: 700; text-decoration: none; font-size: 1rem; transition: opacity .2s; margin-bottom: .75rem; }
  .btn-cta:hover { opacity: .88; color: #fff; }
  .btn-cta-outline { background: #fff; color: var(--brand); border: 2px solid var(--brand); }
  .btn-cta-outline:hover { background: color-mix(in srgb, var(--brand) 8%, #fff); color: var(--brand); opacity: 1; }
  .sidebar-meta li { display: flex; align-items: center; gap: .6rem; padding: .6rem 0; border-bottom: 1px solid #f1f5f9; font-size: .88rem; color: #475569; }
  .sidebar-meta li:last-child { border-bottom: none; }
  .sidebar-meta i { color: var(--brand); width: 18px; }
  @media(max-width:900px){ .layout-grid{ grid-template-columns:1fr; } .sidebar{ position:static; } }
</style>` %>

<div class="page-wrapper">
  <div class="course-hero">
    <div class="container">
      <a href="/institution/learn/courses" style="color:rgba(255,255,255,.75);font-size:.875rem;text-decoration:none;">← Mes cours</a>
      <h1 class="mt-2"><%= course.title %></h1>
      <% if (course.description) { %><p><%- course.description.replace(/<[^>]*>/g,'').substring(0,160) %>...</p><% } %>
    </div>
  </div>

  <div class="container">
    <%- include('../../partials/flash') %>

    <div class="layout-grid">
      <!-- Left: modules -->
      <div>
        <% if (course.description) { %>
        <div class="section-card">
          <h2><i class="bi bi-file-text" style="color:var(--brand)"></i> À propos</h2>
          <div style="color:#475569;line-height:1.7;"><%- course.description %></div>
        </div>
        <% } %>

        <div class="section-card">
          <h2><i class="bi bi-collection-play" style="color:var(--brand)"></i> Modules (<%= modulesWithProgress.length %>)</h2>
          <% modulesWithProgress.forEach(({ module, completed, total, pct }, idx) => { %>
            <a href="/institution/learn/courses/<%= course._id %>/modules/<%= module._id %>/overview" class="module-row">
              <div class="module-num"><%= idx + 1 %></div>
              <div class="module-info">
                <strong><%= module.title %></strong>
                <div class="module-meta"><%= completed %>/<%= total %> leçons terminées</div>
              </div>
              <div class="mod-progress">
                <div class="mod-bar-bg"><div class="mod-bar-fill" style="width:<%= pct %>%"></div></div>
                <div class="mod-pct"><%= pct %>%</div>
              </div>
              <i class="bi bi-chevron-right" style="color:#cbd5e1;font-size:.85rem;"></i>
            </a>
          <% }) %>
        </div>
      </div>

      <!-- Right: sidebar -->
      <div class="sidebar">
        <div class="sidebar-card">
          <% if (resumeModule) { %>
            <a href="/institution/learn/courses/<%= course._id %>/modules/<%= resumeModule.module._id %>/overview" class="btn-cta">
              <i class="bi bi-play-circle-fill"></i>
              <%= resumeModule.pct === 0 ? 'Commencer' : 'Continuer' %>
            </a>
          <% } %>

          <% if (course.finalExam && course.finalExam.questions && course.finalExam.questions.length > 0) { %>
            <a href="/institution/learn/courses/<%= course._id %>/final-exam" class="btn-cta btn-cta-outline">
              <i class="bi bi-clipboard-check"></i>
              Examen final
              <% if (finalExamAttempt) { %>
                <span class="badge <%= finalExamAttempt.passed ? 'bg-success' : 'bg-danger' %> ms-auto" style="font-size:.7rem;">
                  <%= finalExamAttempt.score %>/100
                </span>
              <% } %>
            </a>
          <% } %>

          <% if (course.finalProject && course.finalProject.title) { %>
            <a href="/institution/learn/courses/<%= course._id %>/final-project" class="btn-cta btn-cta-outline">
              <i class="bi bi-journal-check"></i>
              Projet final
              <% if (finalProjectSubmission) { %>
                <span class="badge <%= finalProjectSubmission.status === 'graded' ? 'bg-success' : 'bg-warning text-dark' %> ms-auto" style="font-size:.7rem;">
                  <%= finalProjectSubmission.status === 'graded' ? 'Noté' : 'En attente' %>
                </span>
              <% } %>
            </a>
          <% } %>

          <ul class="sidebar-meta list-unstyled mt-3 mb-0">
            <li><i class="bi bi-layers"></i><span><%= modulesWithProgress.length %> module<%= modulesWithProgress.length > 1 ? 's' : '' %></span></li>
            <% if (enrollment && enrollment.startDate) { %>
              <li><i class="bi bi-calendar-event"></i><span>Début : <%= new Date(enrollment.startDate).toLocaleDateString('fr-FR') %></span></li>
            <% } %>
            <% if (enrollment && enrollment.endDate) { %>
              <% const isExpired = new Date(enrollment.endDate) < new Date(); %>
              <li>
                <i class="bi bi-calendar-check"></i>
                <span style="color:<%= isExpired ? '#dc2626' : 'inherit' %>">
                  Fin : <%= new Date(enrollment.endDate).toLocaleDateString('fr-FR') %>
                  <% if (isExpired) { %><strong> (expiré)</strong><% } %>
                </span>
              </li>
            <% } %>
            <li><i class="bi bi-building"></i><span><%= institution.name %></span></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
