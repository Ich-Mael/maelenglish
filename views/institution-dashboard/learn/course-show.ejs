<% layout('layouts/institutionBoilerplate') %>

<% headContent = `<style>
  :root { --brand: ${institutionColor}; }
  .page-wrapper { margin-top: 80px; padding-bottom: 4rem; background: #f8fafc; }
  .course-hero { background: linear-gradient(135deg, color-mix(in srgb, var(--brand) 85%, #000) 0%, var(--brand) 100%); color: white; padding: 3rem 0 4rem; }
  .course-hero h1 { font-size: 2.2rem; font-weight: 800; margin-bottom: .5rem; }
  .course-hero p  { opacity: .85; font-size: 1.05rem; max-width: 640px; }
  .layout-grid { display: grid; grid-template-columns: 1fr 340px; gap: 2rem; position: relative; z-index: 5; margin-top: -2rem; }
  .section-card { background: #fff; border-radius: 18px; box-shadow: 0 2px 14px rgba(0,0,0,.07); padding: 1.75rem; margin-bottom: 1.5rem; }
  .section-card h2 { font-size: 1.1rem; font-weight: 700; color: #1e293b; margin: 0 0 1.25rem; padding-bottom: .75rem; border-bottom: 2px solid color-mix(in srgb, var(--secondary) 50%, #f1f5f9); display: flex; align-items: center; gap: .5rem; }
  .module-row { display: flex; align-items: center; gap: 1rem; padding: .9rem 1rem; border-radius: 12px; border: 1px solid #e2e8f0; margin-bottom: .6rem; text-decoration: none; color: inherit; transition: border-color .2s, box-shadow .2s; }
  .module-row:hover { border-color: var(--brand); box-shadow: 0 2px 10px rgba(0,0,0,.07); color: inherit; }
  .module-num { width: 34px; height: 34px; border-radius: 50%; background: color-mix(in srgb, var(--secondary) 25%, #fff); color: var(--brand); font-size: .85rem; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .module-info { flex: 1; }
  .module-info strong { font-size: .95rem; display: block; }
  .module-meta { font-size: .78rem; color: #64748b; margin-top: .15rem; }
  .mod-progress { width: 70px; }
  .mod-bar-bg  { height: 5px; border-radius: 3px; background: #e2e8f0; overflow: hidden; }
  .mod-bar-fill { height: 100%; background: var(--brand); border-radius: 3px; }
  .mod-pct { font-size: .72rem; color: #64748b; text-align: right; margin-top: .2rem; }
  /* Grades */
  .grade-table { width: 100%; border-collapse: collapse; }
  .grade-table th { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #64748b; padding: .4rem .6rem; text-align: left; border-bottom: 2px solid color-mix(in srgb, var(--secondary) 40%, #f1f5f9); }
  .grade-table td { padding: .65rem .6rem; border-bottom: 1px solid #f8fafc; font-size: .88rem; vertical-align: middle; }
  .grade-table tr:last-child td { border-bottom: none; }
  .grade-pill { display: inline-flex; align-items: center; gap: .3rem; padding: .18rem .6rem; border-radius: 20px; font-size: .75rem; font-weight: 600; }
  .grade-pass    { background: color-mix(in srgb, var(--accent) 15%, #fff); color: color-mix(in srgb, var(--accent) 75%, #000); }
  .grade-fail    { background: #fee2e2; color: #991b1b; }
  .grade-pending { background: #fef9c3; color: #854d0e; }
  .grade-none    { color: #cbd5e1; font-size: .8rem; }
  /* Sidebar */
  .sidebar { position: sticky; top: 95px; }
  .sidebar-card { background: #fff; border-radius: 18px; box-shadow: 0 4px 24px rgba(0,0,0,.1); padding: 1.75rem; }
  .btn-cta { display: flex; align-items: center; justify-content: center; gap: .6rem; width: 100%; padding: .9rem; background: var(--brand); color: #fff; border-radius: 14px; font-weight: 700; text-decoration: none; font-size: 1rem; transition: opacity .2s; margin-bottom: .75rem; }
  .btn-cta:hover { opacity: .88; color: #fff; }
  .btn-cta-outline { background: #fff; color: var(--brand); border: 2px solid var(--brand); }
  .btn-cta-outline:hover { background: color-mix(in srgb, var(--brand) 8%, #fff); color: var(--brand); opacity: 1; }
  .sidebar-meta li { display: flex; align-items: center; gap: .6rem; padding: .6rem 0; border-bottom: 1px solid #f1f5f9; font-size: .88rem; color: #475569; }
  .sidebar-meta li:last-child { border-bottom: none; }
  .sidebar-meta i { color: var(--brand); width: 18px; }
  /* Institution branding */
  .inst-badge { display: inline-flex; align-items: center; gap: .55rem; background: rgba(255,255,255,.15); backdrop-filter: blur(6px); border: 1px solid rgba(255,255,255,.25); border-radius: 30px; padding: .35rem .85rem .35rem .45rem; margin-bottom: 1.1rem; }
  .inst-badge-logo { width: 26px; height: 26px; border-radius: 50%; object-fit: contain; background: #fff; }
  .inst-badge-fallback { width: 26px; height: 26px; border-radius: 50%; background: rgba(255,255,255,.9); color: var(--brand); font-size: .65rem; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .inst-badge-name { font-size: .82rem; font-weight: 700; color: rgba(255,255,255,.95); }
  .sidebar-inst-card { border: 1px solid #f1f5f9; border-radius: 14px; padding: 1.1rem; margin-bottom: 1.1rem; display: flex; align-items: center; gap: .85rem; }
  .sidebar-inst-logo { width: 46px; height: 46px; border-radius: 10px; object-fit: contain; border: 1px solid #f1f5f9; flex-shrink: 0; }
  .sidebar-inst-fallback { width: 46px; height: 46px; border-radius: 10px; background: var(--brand); color: #fff; font-size: .8rem; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; letter-spacing: .03em; }
  .sidebar-inst-name { font-weight: 700; font-size: .9rem; color: #1e293b; line-height: 1.3; }
  .sidebar-inst-location { font-size: .78rem; color: #64748b; margin-top: .15rem; }
  /* Announcements */
  .ann-card { background: #fff; border-radius: 18px; box-shadow: 0 2px 14px rgba(0,0,0,.07); padding: 1.35rem 1.5rem; margin-top: 1.25rem; }
  .ann-card-title { font-size: .8rem; font-weight: 800; text-transform: uppercase; letter-spacing: .07em; color: #94a3b8; margin-bottom: 1rem; }
  .ann-item { padding: .8rem 0; border-bottom: 1px solid #f1f5f9; }
  .ann-item:last-child { border-bottom: none; padding-bottom: 0; }
  .ann-item:first-child { padding-top: 0; }
  .ann-type-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; margin-top: .35rem; }
  .ann-title { font-size: .88rem; font-weight: 700; color: #1e293b; line-height: 1.35; margin-bottom: .25rem; }
  .ann-body  { font-size: .8rem; color: #64748b; line-height: 1.5; }
  .ann-date  { font-size: .72rem; color: #94a3b8; margin-top: .3rem; }
  .ann-pin   { font-size: .68rem; font-weight: 700; color: var(--brand); background: color-mix(in srgb, var(--brand) 10%, #fff); border-radius: 20px; padding: .1rem .5rem; margin-left: .4rem; }
  @media(max-width:900px){ .layout-grid{ grid-template-columns:1fr; } .sidebar{ position:static; } }
</style>` %>

<% const _initials = institution ? institution.name.substring(0,2).toUpperCase() : 'I'; %>

<div class="page-wrapper">
  <div class="course-hero">
    <div class="container">
      <!-- Institution badge -->
      <div class="inst-badge">
        <% if (institution && institution.logoUrl) { %>
          <img src="<%= institution.logoUrl %>" alt="<%= institution.name %>" class="inst-badge-logo">
        <% } else { %>
          <div class="inst-badge-fallback"><%= _initials %></div>
        <% } %>
        <span class="inst-badge-name"><%= institution ? institution.name : '' %></span>
      </div>
      <a href="/institution/learn/courses" style="color:rgba(255,255,255,.7);font-size:.875rem;text-decoration:none;display:block;margin-bottom:.6rem;">← Mes cours</a>
      <h1><%= course.title %></h1>
      <% if (course.description) { %><p><%- course.description.replace(/<[^>]*>/g,'').substring(0,160) %>...</p><% } %>
    </div>
  </div>

  <div class="container">
    <%- include('../../partials/flash') %>

    <div class="layout-grid">
      <!-- Left: modules -->
      <div>
        <% if (course.description) { %>
        <div class="section-card">
          <h2><i class="bi bi-file-text" style="color:var(--brand)"></i> À propos</h2>
          <div style="color:#475569;line-height:1.7;"><%- course.description %></div>
        </div>
        <% } %>

        <div class="section-card">
          <h2><i class="bi bi-collection-play" style="color:var(--brand)"></i> Modules (<%= modulesWithProgress.length %>)</h2>
          <% modulesWithProgress.forEach(({ module, completed, total, pct }, idx) => { %>
            <a href="/institution/learn/courses/<%= course._id %>/modules/<%= module._id %>/overview" class="module-row">
              <div class="module-num"><%= idx + 1 %></div>
              <div class="module-info">
                <strong><%= module.title %></strong>
                <div class="module-meta"><%= completed %>/<%= total %> leçons terminées</div>
              </div>
              <div class="mod-progress">
                <div class="mod-bar-bg"><div class="mod-bar-fill" style="width:<%= pct %>%"></div></div>
                <div class="mod-pct"><%= pct %>%</div>
              </div>
              <i class="bi bi-chevron-right" style="color:#cbd5e1;font-size:.85rem;"></i>
            </a>
          <% }) %>
        </div>
        <!-- Grades summary -->
        <div class="section-card">
          <h2><i class="bi bi-award" style="color:var(--brand)"></i> Mes notes</h2>
          <table class="grade-table">
            <thead>
              <tr>
                <th>Module / Évaluation</th>
                <th>Quiz</th>
                <th>Devoir</th>
              </tr>
            </thead>
            <tbody>
              <% modulesWithProgress.forEach(({ module }) => { %>
                <%
                  const qa  = quizAttemptByModule[module._id.toString()];
                  const as  = assignmentSubByModule[module._id.toString()];
                  const hasQuiz       = module.quiz && module.quiz.questions && module.quiz.questions.length > 0;
                  const hasAssignment = module.assignment && module.assignment.title;
                %>
                <% if (hasQuiz || hasAssignment) { %>
                <tr>
                  <td class="fw-semibold" style="color:#334155;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= module.title %></td>
                  <td>
                    <% if (!hasQuiz) { %>
                      <span class="grade-none">—</span>
                    <% } else if (qa) { %>
                      <span class="grade-pill <%= qa.passed ? 'grade-pass' : 'grade-fail' %>">
                        <%= qa.passed ? '✓' : '✗' %> <%= qa.score %>/100
                      </span>
                    <% } else { %>
                      <span class="grade-none">Non tenté</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (!hasAssignment) { %>
                      <span class="grade-none">—</span>
                    <% } else if (as && as.status === 'graded') { %>
                      <span class="grade-pill grade-pass">✓ <%= as.grade %>/<%= module.assignment.maxScore || 100 %></span>
                    <% } else if (as) { %>
                      <span class="grade-pill grade-pending">⏳ En attente</span>
                    <% } else { %>
                      <span class="grade-none">Non soumis</span>
                    <% } %>
                  </td>
                </tr>
                <% } %>
              <% }) %>

              <% if (course.finalExam && course.finalExam.questions && course.finalExam.questions.length > 0) { %>
              <tr style="background:#fafafa;">
                <td class="fw-semibold" style="color:#334155;">Examen final</td>
                <td colspan="2">
                  <% if (finalExamAttempt) { %>
                    <span class="grade-pill <%= finalExamAttempt.passed ? 'grade-pass' : 'grade-fail' %>">
                      <%= finalExamAttempt.passed ? '✓' : '✗' %> <%= finalExamAttempt.score %>/100
                    </span>
                  <% } else { %>
                    <span class="grade-none">Non tenté</span>
                  <% } %>
                </td>
              </tr>
              <% } %>

              <% if (course.finalProject && course.finalProject.title) { %>
              <tr style="background:#fafafa;">
                <td class="fw-semibold" style="color:#334155;">Projet final</td>
                <td colspan="2">
                  <% if (finalProjectSubmission && finalProjectSubmission.status === 'graded') { %>
                    <span class="grade-pill grade-pass">✓ <%= finalProjectSubmission.grade %>/<%= course.finalProject.maxScore || 100 %></span>
                    <% if (finalProjectSubmission.feedback) { %>
                      <div class="small text-muted mt-1"><i class="bi bi-chat-left-text me-1"></i><%= finalProjectSubmission.feedback %></div>
                    <% } %>
                  <% } else if (finalProjectSubmission) { %>
                    <span class="grade-pill grade-pending">⏳ En attente</span>
                  <% } else { %>
                    <span class="grade-none">Non soumis</span>
                  <% } %>
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Right: sidebar -->
      <div class="sidebar">
        <div class="sidebar-card">
          <% if (resumeModule) { %>
            <a href="/institution/learn/courses/<%= course._id %>/modules/<%= resumeModule.module._id %>/overview" class="btn-cta">
              <i class="bi bi-play-circle-fill"></i>
              <%= resumeModule.pct === 0 ? 'Commencer' : 'Continuer' %>
            </a>
          <% } %>

          <%
            const _pendingGrades = Object.values(assignmentSubByModule).filter(s => s.status === 'submitted').length
              + (finalProjectSubmission && finalProjectSubmission.status === 'submitted' ? 1 : 0);
            const _gradedNew = Object.values(assignmentSubByModule).filter(s => s.status === 'graded').length
              + (finalProjectSubmission && finalProjectSubmission.status === 'graded' ? 1 : 0);
          %>
          <a href="/institution/learn/courses/<%= course._id %>/grades" class="btn-cta btn-cta-outline" style="position:relative;">
            <i class="bi bi-award"></i>
            Mes notes
            <% if (_pendingGrades > 0) { %>
              <span style="position:absolute;top:-6px;right:-6px;width:18px;height:18px;border-radius:50%;background:var(--accent);color:#fff;font-size:.65rem;font-weight:800;display:flex;align-items:center;justify-content:center;"><%= _pendingGrades %></span>
            <% } %>
          </a>

          <% if (typeof isCertificateEligible !== 'undefined' && isCertificateEligible) { %>
            <a href="/institution/learn/courses/<%= course._id %>/certificate" class="btn-cta" style="background:var(--accent);filter:brightness(.95);">
              <i class="bi bi-patch-check-fill"></i>
              Télécharger mon certificat
            </a>
          <% } %>

          <% if (course.finalExam && course.finalExam.questions && course.finalExam.questions.length > 0) { %>
            <a href="/institution/learn/courses/<%= course._id %>/final-exam" class="btn-cta btn-cta-outline">
              <i class="bi bi-clipboard-check"></i>
              Examen final
              <% if (finalExamAttempt) { %>
                <span class="badge <%= finalExamAttempt.passed ? 'bg-success' : 'bg-danger' %> ms-auto" style="font-size:.7rem;">
                  <%= finalExamAttempt.score %>/100
                </span>
              <% } %>
            </a>
          <% } %>

          <% if (course.finalProject && course.finalProject.title) { %>
            <a href="/institution/learn/courses/<%= course._id %>/final-project" class="btn-cta btn-cta-outline">
              <i class="bi bi-journal-check"></i>
              Projet final
              <% if (finalProjectSubmission) { %>
                <span class="badge <%= finalProjectSubmission.status === 'graded' ? 'bg-success' : 'bg-warning text-dark' %> ms-auto" style="font-size:.7rem;">
                  <%= finalProjectSubmission.status === 'graded' ? 'Noté' : 'En attente' %>
                </span>
              <% } %>
            </a>
          <% } %>

          <!-- Institution branding -->
          <% if (institution) { %>
          <div class="sidebar-inst-card">
            <% if (institution.logoUrl) { %>
              <img src="<%= institution.logoUrl %>" alt="<%= institution.name %>" class="sidebar-inst-logo">
            <% } else { %>
              <div class="sidebar-inst-fallback"><%= _initials %></div>
            <% } %>
            <div>
              <div class="sidebar-inst-name"><%= institution.name %></div>
              <% if (institution.city || institution.country) { %>
                <div class="sidebar-inst-location">
                  <i class="bi bi-geo-alt" style="color:var(--brand);font-size:.75rem;"></i>
                  <%= [institution.city, institution.country].filter(Boolean).join(', ') %>
                </div>
              <% } %>
            </div>
          </div>
          <% } %>

          <ul class="sidebar-meta list-unstyled mb-0">
            <li><i class="bi bi-layers"></i><span><%= modulesWithProgress.length %> module<%= modulesWithProgress.length > 1 ? 's' : '' %></span></li>
            <% if (enrollment && enrollment.startDate) { %>
              <li><i class="bi bi-calendar-event"></i><span>Début : <%= new Date(enrollment.startDate).toLocaleDateString('fr-FR') %></span></li>
            <% } %>
            <% if (enrollment && enrollment.endDate) { %>
              <% const isExpired = new Date(enrollment.endDate) < new Date(); %>
              <li>
                <i class="bi bi-calendar-check"></i>
                <span style="color:<%= isExpired ? '#dc2626' : 'inherit' %>">
                  Fin : <%= new Date(enrollment.endDate).toLocaleDateString('fr-FR') %>
                  <% if (isExpired) { %><strong> (expiré)</strong><% } %>
                </span>
              </li>
            <% } %>
          </ul>
        </div>

        <!-- Announcements -->
        <% if (announcements && announcements.length > 0) { %>
        <%
          const _annColors = { info: '#60a5fa', discount: '#34d399', new_course: '#a78bfa', event: '#f59e0b', reminder: '#f87171' };
        %>
        <div class="ann-card">
          <div class="ann-card-title">📢 Annonces</div>
          <% announcements.forEach(ann => { %>
            <div class="ann-item">
              <div style="display:flex;align-items:flex-start;gap:.6rem;">
                <div class="ann-type-dot" style="background:<%= _annColors[ann.type] || '#94a3b8' %>;"></div>
                <div style="flex:1;min-width:0;">
                  <div class="ann-title">
                    <%= ann.title %>
                    <% if (ann.isPinned) { %><span class="ann-pin">📌 Épinglé</span><% } %>
                  </div>
                  <div class="ann-body"><%= ann.body %></div>
                  <div class="ann-date"><%= new Date(ann.createdAt).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) %></div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
        <% } %>

      </div>
    </div>
  </div>
</div>
