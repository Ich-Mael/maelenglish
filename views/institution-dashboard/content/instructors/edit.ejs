<% layout('layouts/institutionBoilerplate') %>

<% headContent = `<style>
  :root { --brand: ${institutionColor}; }
  .page-wrapper { margin-top: 80px; padding: 2rem 0 4rem; background: #f8fafc; min-height: 100vh; }
  .form-card { background: #fff; border-radius: 18px; box-shadow: 0 2px 12px rgba(0,0,0,.07); padding: 2rem; max-width: 720px; margin: 0 auto; }
  .form-card h1 { font-size: 1.4rem; font-weight: 800; color: #1e293b; margin: 0 0 1.5rem; }
  .form-label { font-size: .85rem; font-weight: 600; color: #374151; }
  .form-control { border-radius: 10px; border: 1.5px solid #e2e8f0; font-size: .92rem; padding: .7rem .95rem; }
  .form-control:focus { border-color: var(--brand); box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 18%, #fff); outline: none; }
  .btn-save { background: var(--brand); color: #fff; border: none; padding: .75rem 2rem; border-radius: 12px; font-weight: 700; font-size: .95rem; cursor: pointer; transition: opacity .2s; }
  .btn-save:hover { opacity: .88; }
  .photo-preview { width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 2px solid #e2e8f0; }
  .photo-fallback { width: 100px; height: 100px; border-radius: 50%; background: color-mix(in srgb, var(--brand) 15%, #fff); color: var(--brand); font-size: 1.75rem; font-weight: 700; display: flex; align-items: center; justify-content: center; }
</style>` %>

<div class="page-wrapper">
  <div class="container">
    <div class="form-card">
      <h1>✏️ Modifier l'instructeur</h1>

      <%- include('../../../partials/flash') %>

      <form action="/institution/dashboard/content/instructors/<%= instructor._id %>?_method=PUT" method="POST">
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label">Nom complet *</label>
            <input type="text" name="name" class="form-control" value="<%= instructor.name %>" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Titre / Fonction</label>
            <input type="text" name="title" class="form-control" value="<%= instructor.title || '' %>">
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label">Photo (URL)</label>
          <div class="d-flex align-items-center gap-3 mb-2">
            <% if (instructor.photoUrl) { %>
              <img id="photoPreview" class="photo-preview" src="<%= instructor.photoUrl %>" alt="<%= instructor.name %>">
            <% } else { %>
              <div id="photoFallback" class="photo-fallback"><%= instructor.name[0].toUpperCase() %></div>
            <% } %>
          </div>
          <input type="url" name="photoUrl" id="photoUrl" class="form-control" value="<%= instructor.photoUrl || '' %>">
        </div>

        <div class="mb-3">
          <label class="form-label">Email (optionnel)</label>
          <input type="email" name="email" class="form-control" value="<%= instructor.email || '' %>">
        </div>

        <div class="mb-4">
          <label class="form-label">Biographie / À propos</label>
          <textarea name="bio" class="institution-rte" id="instBio" rows="6"><%- instructor.bio || '' %></textarea>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn-save" onclick="if(typeof hugerte!=='undefined') hugerte.triggerSave()">Enregistrer</button>
          <a href="/institution/dashboard/content/instructors" class="btn btn-outline-secondary px-4">Annuler</a>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.getElementById('photoUrl').addEventListener('input', function () {
  var url = this.value.trim();
  var existing = document.getElementById('photoPreview');
  var fallback  = document.getElementById('photoFallback');
  if (url) {
    if (!existing) {
      var img = document.createElement('img');
      img.id = 'photoPreview';
      img.className = 'photo-preview';
      img.alt = 'Aperçu';
      this.parentNode.insertBefore(img, this);
      if (fallback) fallback.style.display = 'none';
      existing = img;
    }
    existing.src = url;
    existing.style.display = 'block';
    if (fallback) fallback.style.display = 'none';
  } else if (fallback) {
    if (existing) existing.style.display = 'none';
    fallback.style.display = 'flex';
  }
});
</script>
