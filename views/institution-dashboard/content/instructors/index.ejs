<% layout('layouts/institutionBoilerplate') %>

<% headContent = `<style>
  :root { --brand: ${institutionColor}; }
  .page-wrapper { margin-top: 80px; padding: 2rem 0 4rem; background: #f8fafc; min-height: 100vh; }
  .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.75rem; flex-wrap: wrap; gap: 1rem; }
  .page-title { font-size: 1.5rem; font-weight: 800; color: #1e293b; margin: 0; }
  .btn-add { background: var(--brand); color: #fff; padding: .6rem 1.25rem; border-radius: 10px; font-weight: 600; text-decoration: none; font-size: .9rem; display: inline-flex; align-items: center; gap: .4rem; transition: opacity .2s; }
  .btn-add:hover { opacity: .88; color: #fff; }
  .instructor-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px,1fr)); gap: 1.25rem; }
  .instructor-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 10px rgba(0,0,0,.06); overflow: hidden; display: flex; flex-direction: column; }
  .card-photo { height: 160px; background: linear-gradient(135deg, var(--brand), color-mix(in srgb, var(--brand) 60%, #fff)); display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; }
  .card-photo img { width: 100%; height: 100%; object-fit: cover; }
  .card-photo-fallback { width: 72px; height: 72px; border-radius: 50%; background: rgba(255,255,255,.25); color: #fff; font-size: 1.6rem; font-weight: 700; display: flex; align-items: center; justify-content: center; }
  .card-body { padding: 1.2rem; flex: 1; display: flex; flex-direction: column; }
  .card-name { font-size: 1.05rem; font-weight: 700; color: #1e293b; margin: 0 0 .2rem; }
  .card-title { font-size: .82rem; color: var(--brand); font-weight: 600; margin: 0 0 .65rem; }
  .card-bio { font-size: .83rem; color: #64748b; line-height: 1.5; flex: 1; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
  .card-actions { display: flex; gap: .5rem; margin-top: 1rem; padding-top: .75rem; border-top: 1px solid #f1f5f9; }
  .btn-edit { flex: 1; padding: .45rem; border-radius: 8px; font-size: .82rem; font-weight: 600; text-align: center; text-decoration: none; background: #f1f5f9; color: #475569; transition: background .15s; }
  .btn-edit:hover { background: #e2e8f0; color: #1e293b; }
  .btn-del { padding: .45rem .75rem; border-radius: 8px; font-size: .82rem; background: #fee2e2; color: #dc2626; border: none; cursor: pointer; font-weight: 600; transition: background .15s; }
  .btn-del:hover { background: #fecaca; }
  .empty-state { text-align: center; padding: 4rem 2rem; background: #fff; border-radius: 16px; box-shadow: 0 2px 10px rgba(0,0,0,.06); color: #94a3b8; }
  .empty-state .icon { font-size: 3rem; display: block; margin-bottom: 1rem; }
</style>` %>

<div class="page-wrapper">
  <div class="container" style="max-width:1100px;">
    <div class="page-header">
      <h1 class="page-title">👨‍🏫 Instructeurs</h1>
      <a href="/institution/dashboard/content/instructors/new" class="btn-add">+ Ajouter un instructeur</a>
    </div>

    <%- include('../../../partials/flash') %>

    <% if (instructors.length === 0) { %>
      <div class="empty-state">
        <span class="icon">👨‍🏫</span>
        <p class="fw-semibold mb-1">Aucun instructeur</p>
        <p class="small mb-3">Ajoutez des instructeurs pour les assigner à vos leçons.</p>
        <a href="/institution/dashboard/content/instructors/new" class="btn-add">+ Ajouter le premier</a>
      </div>
    <% } else { %>
      <div class="instructor-grid">
        <% instructors.forEach(inst => { %>
          <div class="instructor-card">
            <div class="card-photo">
              <% if (inst.photoUrl) { %>
                <img src="<%= inst.photoUrl %>" alt="<%= inst.name %>">
              <% } else { %>
                <div class="card-photo-fallback"><%= inst.name[0].toUpperCase() %></div>
              <% } %>
            </div>
            <div class="card-body">
              <p class="card-name"><%= inst.name %></p>
              <% if (inst.title) { %><p class="card-title"><%= inst.title %></p><% } %>
              <% if (inst.bio) { %><p class="card-bio"><%- inst.bio.replace(/<[^>]+>/g, '') %></p><% } %>
              <div class="card-actions">
                <a href="/institution/dashboard/content/instructors/<%= inst._id %>/edit" class="btn-edit">Modifier</a>
                <form action="/institution/dashboard/content/instructors/<%= inst._id %>?_method=DELETE" method="POST"
                      onsubmit="return confirm('Supprimer <%= inst.name.replace(/'/g,'\\\'') %> ?')">
                  <button type="submit" class="btn-del">×</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>
