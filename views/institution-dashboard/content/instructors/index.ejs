<% layout('layouts/institutionBoilerplate') %>

<% headContent = `<style>
  :root { --brand: ${institutionColor}; }
  .page-wrapper { margin-top: 80px; padding: 2rem 0 4rem; background: #f8fafc; min-height: 100vh; }
  .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.75rem; flex-wrap: wrap; gap: 1rem; }
  .page-title { font-size: 1.5rem; font-weight: 800; color: #1e293b; margin: 0; }
  /* Add panel */
  .add-panel { background: #fff; border-radius: 14px; box-shadow: 0 2px 10px rgba(0,0,0,.06); padding: 1.5rem; margin-bottom: 1.75rem; border-left: 4px solid var(--brand); }
  .add-panel h3 { font-size: .95rem; font-weight: 700; color: #1e293b; margin: 0 0 1rem; }
  .search-results { border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; margin-top: .5rem; display: none; }
  .search-row { display: flex; align-items: center; gap: .85rem; padding: .7rem 1rem; cursor: pointer; transition: background .15s; border-bottom: 1px solid #f1f5f9; }
  .search-row:last-child { border-bottom: none; }
  .search-row:hover { background: color-mix(in srgb, var(--brand) 6%, #fff); }
  .search-row.selected { background: color-mix(in srgb, var(--brand) 10%, #fff); }
  .search-avatar { width: 34px; height: 34px; border-radius: 50%; background: color-mix(in srgb, var(--brand) 15%, #fff); color: var(--brand); font-weight: 700; font-size: .85rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .add-form { background: #f8fafc; border-radius: 10px; padding: 1rem; margin-top: .75rem; display: none; }
  .add-form.visible { display: block; }
  /* Grid */
  .instructor-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px,1fr)); gap: 1.25rem; }
  .instructor-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 10px rgba(0,0,0,.06); overflow: hidden; display: flex; flex-direction: column; }
  .card-photo { height: 150px; background: linear-gradient(160deg, var(--brand), color-mix(in srgb, var(--brand) 55%, #fff)); display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .card-photo img { width: 100%; height: 100%; object-fit: cover; }
  .card-photo-fallback { width: 68px; height: 68px; border-radius: 50%; background: rgba(255,255,255,.25); color: #fff; font-size: 1.5rem; font-weight: 700; display: flex; align-items: center; justify-content: center; }
  .card-body { padding: 1.1rem; flex: 1; display: flex; flex-direction: column; }
  .card-name { font-size: 1rem; font-weight: 700; color: #1e293b; margin: 0 0 .15rem; }
  .card-title { font-size: .8rem; color: var(--brand); font-weight: 600; margin: 0 0 .5rem; }
  .card-username { font-size: .75rem; color: #94a3b8; margin: 0 0 .5rem; }
  .card-bio { font-size: .82rem; color: #64748b; line-height: 1.5; flex: 1; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .card-actions { display: flex; gap: .5rem; margin-top: .85rem; padding-top: .65rem; border-top: 1px solid #f1f5f9; }
  .btn-edit { flex: 1; padding: .4rem; border-radius: 8px; font-size: .8rem; font-weight: 600; text-align: center; text-decoration: none; background: #f1f5f9; color: #475569; transition: background .15s; }
  .btn-edit:hover { background: #e2e8f0; color: #1e293b; }
  .btn-del { padding: .4rem .7rem; border-radius: 8px; font-size: .8rem; background: #fee2e2; color: #dc2626; border: none; cursor: pointer; font-weight: 600; }
  .btn-del:hover { background: #fecaca; }
  .empty-state { text-align: center; padding: 4rem 2rem; background: #fff; border-radius: 16px; box-shadow: 0 2px 10px rgba(0,0,0,.06); color: #94a3b8; }
  .form-control, .form-select { border-radius: 8px; border: 1.5px solid #e2e8f0; font-size: .88rem; }
  .form-control:focus { border-color: var(--brand); box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 18%, #fff); outline: none; }
</style>` %>

<div class="page-wrapper">
  <div class="container" style="max-width:1060px;">
    <div class="page-header">
      <h1 class="page-title">👨‍🏫 Instructeurs</h1>
    </div>

    <%- include('../../../partials/flash') %>

    <!-- Add instructor panel -->
    <div class="add-panel">
      <h3>➕ Ajouter un instructeur à votre institution</h3>
      <p class="small text-muted mb-3">Recherchez un compte instructeur créé par AfroHK, puis ajoutez-le à votre institution.</p>
      <input type="text" id="instrSearch" class="form-control" placeholder="Rechercher par nom, prénom, username ou email…" autocomplete="off">
      <div class="search-results" id="instrResults"></div>

      <form class="add-form" id="addForm" action="/institution/dashboard/content/instructors" method="POST">
        <input type="hidden" name="userId" id="selectedUserId">
        <p class="fw-semibold mb-2 small" id="selectedLabel"></p>
        <div class="row g-2 mb-2">
          <div class="col-md-5">
            <input type="text" name="title" class="form-control form-control-sm" placeholder="Titre / Fonction (ex: Professeur de mathématiques)">
          </div>
          <div class="col-md-5">
            <input type="url" name="photoUrl" class="form-control form-control-sm" placeholder="URL de photo (optionnel)">
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-primary btn-sm w-100">Ajouter</button>
          </div>
        </div>
      </form>
    </div>

    <% if (instructors.length === 0) { %>
      <div class="empty-state">
        <p style="font-size:2.5rem;">👨‍🏫</p>
        <p class="fw-semibold">Aucun instructeur pour l'instant.</p>
        <p class="small">Utilisez la recherche ci-dessus pour ajouter un instructeur à votre institution.</p>
      </div>
    <% } else { %>
      <div class="instructor-grid">
        <% instructors.forEach(inst => { %>
          <div class="instructor-card">
            <div class="card-photo">
              <% if (inst.photoUrl) { %>
                <img src="<%= inst.photoUrl %>" alt="<%= inst.name %>">
              <% } else { %>
                <div class="card-photo-fallback"><%= inst.name[0].toUpperCase() %></div>
              <% } %>
            </div>
            <div class="card-body">
              <p class="card-name"><%= inst.name %></p>
              <% if (inst.title) { %><p class="card-title"><%= inst.title %></p><% } %>
              <% if (inst.userId) { %><p class="card-username">@<%= inst.userId.username %></p><% } %>
              <% if (inst.bio) { %><p class="card-bio"><%- inst.bio.replace(/<[^>]+>/g, '') %></p><% } %>
              <div class="card-actions">
                <a href="/institution/dashboard/content/instructors/<%= inst._id %>/edit" class="btn-edit">Modifier le profil</a>
                <form action="/institution/dashboard/content/instructors/<%= inst._id %>?_method=DELETE" method="POST"
                      onsubmit="return confirm('Retirer <%= inst.name.replace(/'/g,'\\\'') %> de votre institution ?')">
                  <button type="submit" class="btn-del">×</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<script>
(function () {
  const input    = document.getElementById('instrSearch');
  const results  = document.getElementById('instrResults');
  const addForm  = document.getElementById('addForm');
  const label    = document.getElementById('selectedLabel');
  const userIdIn = document.getElementById('selectedUserId');

  let debounce;
  input.addEventListener('input', function () {
    clearTimeout(debounce);
    const q = this.value.trim();
    if (q.length < 2) { results.style.display = 'none'; results.innerHTML = ''; return; }
    debounce = setTimeout(() => fetch('/institution/dashboard/content/instructors/search?q=' + encodeURIComponent(q))
      .then(r => r.json()).then(d => render(d.users)), 280);
  });

  function render(users) {
    if (!users.length) {
      results.innerHTML = '<div style="padding:.7rem 1rem;color:#888;font-size:.85rem;">Aucun résultat.</div>';
      results.style.display = 'block';
      return;
    }
    results.innerHTML = users.map(u => `
      <div class="search-row" data-id="${u._id}" data-label="${u.name} ${u.surname} (@${u.username})">
        <div class="search-avatar">${u.name[0].toUpperCase()}</div>
        <div style="flex:1;min-width:0;">
          <div style="font-weight:600;font-size:.88rem;">${u.surname} ${u.name}</div>
          <div style="font-size:.75rem;color:#888;">@${u.username} · ${u.email}</div>
        </div>
      </div>`).join('');
    results.style.display = 'block';

    results.querySelectorAll('.search-row').forEach(row => {
      row.addEventListener('click', function () {
        results.querySelectorAll('.search-row').forEach(r => r.classList.remove('selected'));
        this.classList.add('selected');
        userIdIn.value = this.dataset.id;
        label.textContent = '👤 ' + this.dataset.label;
        addForm.classList.add('visible');
        addForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });
  }

  document.addEventListener('click', function (e) {
    if (!input.contains(e.target) && !results.contains(e.target)) results.style.display = 'none';
  });
})();
</script>
