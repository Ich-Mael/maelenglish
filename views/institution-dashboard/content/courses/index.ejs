<% layout('layouts/institutionBoilerplate') %>

<% headContent = `<style>
  .page-wrapper { margin-top: 80px; padding: 2rem 0 5rem; background: #f8fafc; }
  .page-header { background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%); color: white; padding: 1.75rem 2rem; border-radius: 16px; margin-bottom: 2rem; }
  .page-header h1 { margin: 0 0 .25rem; font-size: 1.6rem; font-weight: 800; }
  .page-header p  { margin: 0; opacity: .8; font-size: .9rem; }
  .section-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,.07); padding: 1.75rem; margin-bottom: 1.5rem; }
  .section-card h2 { font-size: 1rem; font-weight: 700; color: #2d0370; margin: 0 0 1.25rem; padding-bottom: .75rem; border-bottom: 2px solid #ede8f8; }
  .course-card { border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; margin-bottom: 1rem; transition: all .2s ease; }
  .course-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.1); border-color: #5d06ba; }
  .course-title { font-size: 1rem; font-weight: 700; color: #1d1d1f; margin-bottom: .5rem; }
  .course-meta { font-size: .85rem; color: #6b7280; margin-bottom: .75rem; }
  .course-status { display: inline-block; padding: .25rem .75rem; border-radius: 20px; font-size: .75rem; font-weight: 600; }
  .status-active { background: #dcfce7; color: #166534; }
  .status-draft { background: #f3f4f6; color: #374151; }
  .btn-new { background: #5d06ba; color: #fff; border: none; padding: .7rem 1.75rem; border-radius: 10px; font-weight: 700; font-size: .9rem; cursor: pointer; text-decoration: none; display: inline-block; }
  .btn-new:hover { background: #4a0594; }
  .btn-small { padding: .4rem .8rem; font-size: .8rem; }
  .btn-outline-secondary { border: 1px solid #e2e8f0; background: #fff; color: #374151; padding: .4rem .8rem; border-radius: 6px; font-size: .8rem; cursor: pointer; text-decoration: none; display: inline-block; }
  .btn-outline-secondary:hover { background: #f3f4f6; }
  .btn-outline-danger { border: 1px solid #fca5a5; background: #fff; color: #dc2626; padding: .4rem .8rem; border-radius: 6px; font-size: .8rem; cursor: pointer; }
  .btn-outline-danger:hover { background: #fef2f2; }
  .empty-state { text-align: center; padding: 3rem 2rem; }
  .empty-state p { color: #6b7280; margin-bottom: 1.5rem; }
</style>` %>

<div class="page-wrapper">
  <div class="container" style="max-width:900px;">

    <div class="page-header">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <h1>📚 Contenu du cours</h1>
          <p>Gérez tous les cours de votre institution</p>
        </div>
        <a href="/institution/dashboard/content/courses/new?institutionId=<%= institution ? institution._id : '' %>" class="btn-new">+ Nouveau cours</a>
      </div>
    </div>

    <%- include('../../../partials/flash') %>

    <div class="section-card">
      <h2>Vos cours (<%= courses.length %>)</h2>

      <% if (courses.length === 0) { %>
        <div class="empty-state">
          <p>Aucun cours créé pour le moment.</p>
          <a href="/institution/dashboard/content/courses/new?institutionId=<%= institution ? institution._id : '' %>" class="btn-new">Créer votre premier cours</a>
        </div>
      <% } else { %>
        <% courses.forEach(course => { %>
          <div class="course-card">
            <div class="d-flex justify-content-between align-items-start">
              <div class="flex-grow-1">
                <div class="course-title"><%= course.title %></div>
                <div class="course-meta">
                  <span class="course-status <%= course.isActive ? 'status-active' : 'status-draft' %>">
                    <%= course.isActive ? '✓ Actif' : '● Brouillon' %>
                  </span>
                  <span style="margin-left: 1rem; color: #9ca3af;">
                    <%= course.modules ? course.modules.length : 0 %> module<%= (course.modules && course.modules.length !== 1) ? 's' : '' %>
                  </span>
                </div>
              </div>
              <div class="d-flex gap-2 flex-wrap">
                <a href="/institution/dashboard/content/courses/<%= course._id %>/submissions" class="btn-outline-secondary btn-small" style="color:#5d06ba;border-color:#c4b5fd;">📋 Soumissions</a>
                <a href="/institution/dashboard/content/courses/<%= course._id %>" class="btn-outline-secondary btn-small">Voir</a>
                <a href="/institution/dashboard/content/courses/<%= course._id %>/edit" class="btn-outline-secondary btn-small">Modifier</a>
                <form action="/institution/dashboard/content/courses/<%= course._id %>/toggle-active" method="POST" style="display:inline;">
                  <button type="submit" class="btn-small" style="border-radius:6px;cursor:pointer;font-size:.8rem;padding:.4rem .8rem;
                    background:<%= course.isActive ? '#fef2f2' : '#f0fdf4' %>;
                    color:<%= course.isActive ? '#dc2626' : '#15803d' %>;
                    border:1px solid <%= course.isActive ? '#fca5a5' : '#86efac' %>;">
                    <%= course.isActive ? 'Désactiver' : 'Activer' %>
                  </button>
                </form>
                <form action="/institution/dashboard/content/courses/<%= course._id %>?_method=DELETE" method="POST" style="display: inline;"
                      onsubmit="return confirm('Supprimer ce cours ? Cela supprimera tous ses modules et leçons.')">
                  <button type="submit" class="btn-outline-danger btn-small">Supprimer</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>

  </div>
</div>
