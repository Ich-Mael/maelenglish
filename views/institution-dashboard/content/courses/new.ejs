<% layout('layouts/institutionBoilerplate') %>

<% headContent = `<style>
  .page-wrapper { margin-top: 80px; padding: 2rem 0 5rem; background: #f8fafc; }
  .page-header { background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%); color: white; padding: 1.75rem 2rem; border-radius: 16px; margin-bottom: 2rem; }
  .page-header h1 { margin: 0 0 .25rem; font-size: 1.6rem; font-weight: 800; }
  .section-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,.07); padding: 1.75rem; margin-bottom: 1.5rem; }
  .section-card h2 { font-size: 1rem; font-weight: 700; color: #2d0370; margin: 0 0 1.25rem; padding-bottom: .75rem; border-bottom: 2px solid #ede8f8; }
  .form-label { font-size: .85rem; font-weight: 600; color: #374151; }
  .form-control { border-radius: 10px; border: 1.5px solid #e2e8f0; font-size: .9rem; padding: .6rem .9rem; }
  .form-control:focus { border-color: #5d06ba; box-shadow: 0 0 0 3px rgba(93,6,186,.15); outline: none; }
  .btn-save { background: #5d06ba; color: #fff; border: none; padding: .7rem 1.75rem; border-radius: 10px; font-weight: 700; font-size: .9rem; cursor: pointer; }
  .btn-save:hover { background: #4a0594; }
  .btn-cancel { background: #f3f4f6; color: #374151; border: 1px solid #e2e8f0; padding: .7rem 1.75rem; border-radius: 10px; font-weight: 700; font-size: .9rem; cursor: pointer; text-decoration: none; display: inline-block; }
  .btn-cancel:hover { background: #e5e7eb; }
</style>` %>

<div class="page-wrapper">
  <div class="container" style="max-width:860px;">

    <div class="page-header">
      <h1>➕ Nouveau cours</h1>
      <p>Créez un cours pour votre institution</p>
    </div>

    <%- include('../../../partials/flash') %>

    <div class="section-card">
      <form action="/institution/dashboard/content/courses" method="POST">
        <input type="hidden" name="institutionId" value="<%= institution ? institution._id : '' %>">
        <div class="mb-3">
          <label class="form-label">Titre du cours *</label>
          <input type="text" name="title" class="form-control" required placeholder="ex: Introduction à la gestion de projet">
        </div>

        <div class="mb-3">
          <label class="form-label">Description</label>
          <textarea id="courseDesc" name="description" class="form-control" rows="4" placeholder="Décrivez le contenu et les objectifs du cours..."></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label">Prérequis</label>
          <textarea id="coursePrereqs" name="prerequisites" class="form-control" rows="3" placeholder="Listez les connaissances nécessaires avant de suivre ce cours..."></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label">Objectifs du cours</label>
          <textarea id="courseObjectives" name="objectives" class="form-control" rows="4" placeholder="Ce que les apprenants vont acquérir à l'issue de ce cours..."></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label">À qui s'adresse ce cours ?</label>
          <textarea id="courseAudience" name="targetAudience" class="form-control" rows="3" placeholder="Décrivez le public cible : profils, niveau, besoins..."></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label">Catégorie</label>
          <select name="category" class="form-control">
            <% ['Informatique & Tech','Gestion & Finance','Droit & Fiscalité','Langues','Marketing & Communication','Comptabilité','Ressources Humaines','Développement Personnel','Santé','Agriculture','Autre'].forEach(cat => { %>
              <option value="<%= cat %>"><%= cat %></option>
            <% }) %>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label">Vidéo de présentation (URL)</label>
          <input type="url" name="promoVideoUrl" class="form-control" placeholder="https://youtube.com/watch?v=... ou https://vimeo.com/...">
          <small class="text-muted">Vidéo publique visible sur la page du cours — YouTube, Vimeo ou lien direct.</small>
        </div>

        <div class="mb-3">
          <label class="form-label">Image de couverture (URL)</label>
          <input type="url" name="imageUrl" class="form-control" placeholder="https://example.com/image.jpg">
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn-save">Créer le cours</button>
          <a href="/institution/dashboard/content<%= typeof institutionId !== 'undefined' ? '?institutionId=' + institutionId : '' %>" class="btn-cancel">Annuler</a>
        </div>
      </form>
    </div>

  </div>
</div>

<script>
hugerte.init({ ...window.RTECONFIG, selector: '#courseDesc', height: 240 });
hugerte.init({ ...window.RTECONFIG, selector: '#coursePrereqs', height: 180 });
hugerte.init({ ...window.RTECONFIG, selector: '#courseObjectives', height: 200 });
hugerte.init({ ...window.RTECONFIG, selector: '#courseAudience', height: 180 });
document.querySelector('form').addEventListener('submit', function() {
  ['courseDesc', 'coursePrereqs', 'courseObjectives', 'courseAudience'].forEach(function(id) {
    var ed = window.hugerte && window.hugerte.get(id);
    if (ed) document.getElementById(id).value = ed.getContent();
  });
});
</script>
