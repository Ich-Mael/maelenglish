<% layout('layouts/institutionBoilerplate') %>

<% headContent = `<style>
  .page-wrapper { margin-top: 80px; padding: 2rem 0 5rem; background: #f8fafc; }
  .page-header { background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%); color: white; padding: 1.75rem 2rem; border-radius: 16px; margin-bottom: 2rem; }
  .page-header h1 { margin: 0 0 .25rem; font-size: 1.6rem; font-weight: 800; }
  .page-header p { margin: 0; opacity: .8; font-size: .9rem; }
  .section-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,.07); padding: 1.75rem; margin-bottom: 1.5rem; }
  .section-card h2 { font-size: 1rem; font-weight: 700; color: #2d0370; margin: 0 0 1.25rem; padding-bottom: .75rem; border-bottom: 2px solid #ede8f8; }
  .form-label { font-size: .85rem; font-weight: 600; color: #374151; }
  .form-control, .form-check-input { border-radius: 10px; border: 1.5px solid #e2e8f0; font-size: .9rem; }
  .form-control { padding: .6rem .9rem; }
  .form-control:focus, .form-check-input:focus { border-color: #5d06ba; box-shadow: 0 0 0 3px rgba(93,6,186,.15); outline: none; }
  .btn-save { background: #5d06ba; color: #fff; border: none; padding: .7rem 1.75rem; border-radius: 10px; font-weight: 700; font-size: .9rem; cursor: pointer; }
  .btn-save:hover { background: #4a0594; }
  .btn-cancel { background: #f3f4f6; color: #374151; border: 1px solid #e2e8f0; padding: .7rem 1.75rem; border-radius: 10px; font-weight: 700; font-size: .9rem; cursor: pointer; text-decoration: none; display: inline-block; }
  .btn-cancel:hover { background: #e5e7eb; }
  .field-hint { font-size: .78rem; color: #9ca3af; margin-top: .25rem; }
</style>` %>

<div class="page-wrapper">
  <div class="container" style="max-width:860px;">

    <div class="page-header">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
          <h1>✏️ Modifier le cours</h1>
          <p><%= course.title %></p>
        </div>
        <a href="/institution/dashboard/content/courses/<%= course._id %>" class="btn btn-light btn-sm">← Voir le cours</a>
      </div>
    </div>

    <%- include('../../../partials/flash') %>

    <div class="section-card">
      <form id="editForm" action="/institution/dashboard/content/courses/<%= course._id %>?_method=PUT" method="POST">

        <div class="mb-4">
          <label class="form-label">Titre du cours *</label>
          <input type="text" name="title" class="form-control" value="<%= course.title %>" required>
        </div>

        <div class="mb-4">
          <label class="form-label">Description</label>
          <textarea id="courseDesc" name="description" class="form-control" rows="4"><%= course.description || '' %></textarea>
          <p class="field-hint">Présentez le contenu, les objectifs et la valeur du cours.</p>
        </div>

        <div class="mb-4">
          <label class="form-label">Prérequis</label>
          <textarea id="coursePrereqs" name="prerequisites" class="form-control" rows="3"><%= course.prerequisites || '' %></textarea>
          <p class="field-hint">Listez les connaissances ou compétences nécessaires avant de suivre ce cours.</p>
        </div>

        <div class="mb-4">
          <label class="form-label">Image de couverture (URL)</label>
          <input type="url" name="imageUrl" class="form-control" value="<%= course.imageUrl || '' %>" placeholder="https://example.com/image.jpg">
        </div>

        <!-- Pricing -->
        <div class="mb-4" style="background:#f8f5ff;border-radius:12px;padding:1.25rem;">
          <label class="form-label" style="color:#2d0370;font-size:.9rem;">💰 Tarification</label>
          <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" id="isFree" name="pricing[isFree]" <%= (course.pricing && course.pricing.isFree) ? 'checked' : '' %> onchange="togglePricing(this.checked)">
            <label class="form-check-label" for="isFree" style="font-size:.9rem;">Formation gratuite</label>
          </div>
          <div id="pricingFields" style="display:<%= (course.pricing && course.pricing.isFree) ? 'none' : 'flex' %>;gap:1rem;align-items:flex-end;">
            <div style="flex:1;">
              <label class="form-label">Montant</label>
              <input type="number" name="pricing[amount]" class="form-control" min="0" placeholder="ex: 50000" value="<%= (course.pricing && course.pricing.amount) ? course.pricing.amount : '' %>">
            </div>
            <div style="width:130px;">
              <label class="form-label">Devise</label>
              <input type="text" name="pricing[currency]" class="form-control" placeholder="FCFA" value="<%= (course.pricing && course.pricing.currency) ? course.pricing.currency : 'FCFA' %>">
            </div>
          </div>
          <p class="field-hint" style="margin-top:.5rem;">Si aucun montant n'est précisé, la tarification sera affichée "Sur demande" sur le catalogue public.</p>
        </div>

        <div class="mb-4 form-check">
          <input type="checkbox" class="form-check-input" id="isActive" name="isActive" <%= course.isActive ? 'checked' : '' %>>
          <label class="form-check-label" for="isActive" style="font-size:.9rem;">
            Cours actif <span class="text-muted" style="font-weight:400;">(visible pour les étudiants inscrits)</span>
          </label>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn-save">Enregistrer les modifications</button>
          <a href="/institution/dashboard/content/courses/<%= course._id %>" class="btn-cancel">Annuler</a>
        </div>
      </form>
    </div>

  </div>
</div>

<script>
hugerte.init({ ...window.RTECONFIG, selector: '#courseDesc', height: 240 });
hugerte.init({ ...window.RTECONFIG, selector: '#coursePrereqs', height: 180 });

document.getElementById('editForm').addEventListener('submit', function() {
  ['courseDesc', 'coursePrereqs'].forEach(function(id) {
    var ed = window.hugerte && window.hugerte.get(id);
    if (ed) document.getElementById(id).value = ed.getContent();
  });
});

function togglePricing(isFree) {
  document.getElementById('pricingFields').style.display = isFree ? 'none' : 'flex';
}
</script>
