<% layout('layouts/institutionBoilerplate') %>

<% headContent = `<style>
  .page-wrapper { margin-top: 80px; padding: 2rem 0 5rem; background: #f8fafc; }
  .page-header { background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%); color: white; padding: 1.75rem 2rem; border-radius: 16px; margin-bottom: 1.75rem; }
  .page-header h1 { margin: 0 0 .25rem; font-size: 1.55rem; font-weight: 800; }
  .page-header p { margin: 0; opacity: .8; font-size: .9rem; }
  .section-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,.07); padding: 1.75rem; margin-bottom: 1.5rem; }
  .section-card h2 { font-size: 1rem; font-weight: 700; color: #2d0370; margin: 0 0 1.25rem; padding-bottom: .75rem; border-bottom: 2px solid #ede8f8; }
  .module-label { font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #5d06ba; margin-bottom: .75rem; }
  .sub-card { border: 1px solid #e5e7eb; border-radius: 12px; padding: 1.25rem; margin-bottom: 1rem; background: #fafafa; }
  .sub-card.graded { border-color: #6ee7b7; background: #f0fdf4; }
  .sub-card.pending { border-color: #fde68a; background: #fffbeb; }
  .sub-student { font-weight: 700; color: #1e293b; margin-bottom: .2rem; }
  .sub-meta { font-size: .8rem; color: #64748b; margin-bottom: .75rem; }
  .sub-content { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: .85rem 1rem; font-size: .9rem; color: #334155; white-space: pre-wrap; word-break: break-word; max-height: 200px; overflow-y: auto; margin-bottom: 1rem; }
  .badge-pending { background: #fef9c3; color: #854d0e; padding: .2rem .65rem; border-radius: 20px; font-size: .75rem; font-weight: 600; }
  .badge-graded  { background: #d1fae5; color: #065f46; padding: .2rem .65rem; border-radius: 20px; font-size: .75rem; font-weight: 600; }
  .grade-form { display: flex; flex-wrap: wrap; gap: .75rem; align-items: flex-end; }
  .grade-form .form-group { display: flex; flex-direction: column; gap: .3rem; }
  .grade-form label { font-size: .8rem; font-weight: 600; color: #475569; }
  .grade-form input[type="number"] { width: 90px; padding: .5rem .75rem; border-radius: 8px; border: 1.5px solid #e2e8f0; font-size: .9rem; }
  .grade-form input[type="number"]:focus { border-color: #5d06ba; outline: none; box-shadow: 0 0 0 3px rgba(93,6,186,.1); }
  .grade-form textarea { padding: .5rem .75rem; border-radius: 8px; border: 1.5px solid #e2e8f0; font-size: .9rem; resize: vertical; min-width: 260px; }
  .grade-form textarea:focus { border-color: #5d06ba; outline: none; box-shadow: 0 0 0 3px rgba(93,6,186,.1); }
  .btn-grade { background: #5d06ba; color: #fff; border: none; padding: .55rem 1.4rem; border-radius: 8px; font-weight: 700; font-size: .875rem; cursor: pointer; white-space: nowrap; }
  .btn-grade:hover { background: #4a0594; }
  .existing-grade { background: #eff6ff; border-radius: 8px; padding: .75rem 1rem; border: 1px solid #bfdbfe; margin-bottom: .75rem; font-size: .88rem; }
  .empty-state { text-align: center; padding: 2.5rem; color: #94a3b8; }
  .summary-pill { display: inline-flex; align-items: center; gap: .4rem; padding: .3rem .85rem; border-radius: 20px; font-size: .82rem; font-weight: 600; }
  .pill-pending { background: #fef9c3; color: #854d0e; }
  .pill-done { background: #d1fae5; color: #065f46; }
</style>` %>

<div class="page-wrapper">
  <div class="container" style="max-width:900px;">

    <div class="page-header">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
          <p style="opacity:.7;font-size:.82rem;margin:0 0 .2rem;">Corrections &amp; Notes</p>
          <h1><%= course.title %></h1>
          <p>
            <% if (pendingCount > 0) { %>
              <span class="summary-pill pill-pending">⏳ <%= pendingCount %> en attente</span>
            <% } else { %>
              <span class="summary-pill pill-done">✓ Tout est noté</span>
            <% } %>
          </p>
        </div>
        <a href="/institution/dashboard/content/courses/<%= course._id %>" class="btn btn-light btn-sm">← Cours</a>
      </div>
    </div>

    <%- include('../../../partials/flash') %>

    <!-- ── MODULE ASSIGNMENTS ───────────────────────────────────────────── -->
    <div class="section-card">
      <h2>📝 Devoirs de modules</h2>

      <% const modulesWithAssignment = course.modules.filter(m => m.assignment && m.assignment.title); %>

      <% if (modulesWithAssignment.length === 0) { %>
        <div class="empty-state">Aucun devoir configuré dans ce cours.</div>
      <% } else { %>
        <% modulesWithAssignment.forEach(mod => { %>
          <% const subs = subsByModule[mod._id.toString()] || []; %>
          <div class="module-label"><%= mod.title %> — <%= mod.assignment.title %> (max <%= mod.assignment.maxScore || 100 %> pts)</div>

          <% if (subs.length === 0) { %>
            <p class="text-muted small mb-4">Aucune soumission pour ce module.</p>
          <% } else { %>
            <% subs.forEach(sub => { %>
              <div class="sub-card <%= sub.status === 'graded' ? 'graded' : 'pending' %>">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-1">
                  <div class="sub-student">
                    <%= sub.userId ? (sub.userId.surname || '') + ' ' + (sub.userId.name || '') : 'Étudiant inconnu' %>
                    <span class="text-muted fw-normal" style="font-size:.85rem;">@<%= sub.userId ? sub.userId.username : '—' %></span>
                  </div>
                  <div class="d-flex align-items-center gap-2">
                    <span class="badge-<%= sub.status %>">
                      <% if (sub.status === 'graded') { %>✓ Noté : <%= sub.grade %>/<%= mod.assignment.maxScore || 100 %><% } else { %>⏳ En attente<% } %>
                    </span>
                  </div>
                </div>
                <div class="sub-meta">
                  Soumis le <%= new Date(sub.submittedAt || sub.createdAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                  · <%= sub.submissionType === 'link' ? 'Lien' : 'Texte' %>
                </div>

                <div class="sub-content">
                  <% if (sub.submissionType === 'link') { %>
                    <a href="<%= sub.content %>" target="_blank" rel="noopener" style="color:#5d06ba;word-break:break-all;"><%= sub.content %></a>
                  <% } else { %>
                    <%- sub.content %>
                  <% } %>
                </div>

                <% if (sub.status === 'graded' && sub.feedback) { %>
                  <div class="existing-grade mb-3">
                    <strong style="color:#1e40af;">Feedback actuel :</strong>
                    <span style="color:#1e40af;"> <%= sub.feedback %></span>
                  </div>
                <% } %>

                <form action="/institution/dashboard/content/courses/<%= course._id %>/assignments/<%= sub._id %>/grade?_method=POST" method="POST">
                  <div class="grade-form">
                    <div class="form-group">
                      <label>Note (/ <%= mod.assignment.maxScore || 100 %>)</label>
                      <input type="number" name="grade" min="0" max="<%= mod.assignment.maxScore || 100 %>" step="0.5"
                             value="<%= sub.status === 'graded' ? sub.grade : '' %>" required placeholder="ex: 85">
                    </div>
                    <div class="form-group" style="flex:1;">
                      <label>Feedback (optionnel)</label>
                      <textarea name="feedback" rows="2" placeholder="Commentaire pour l'étudiant…"><%= sub.feedback || '' %></textarea>
                    </div>
                    <button type="submit" class="btn-grade">
                      <%= sub.status === 'graded' ? 'Mettre à jour' : 'Noter' %>
                    </button>
                  </div>
                </form>
              </div>
            <% }) %>
          <% } %>
          <div style="height:.5rem;"></div>
        <% }) %>
      <% } %>
    </div>

    <!-- ── FINAL PROJECTS ─────────────────────────────────────────────────── -->
    <% if (course.finalProject && course.finalProject.title) { %>
    <div class="section-card">
      <h2>🎯 Projets finaux — <%= course.finalProject.title %> (max <%= course.finalProject.maxScore || 100 %> pts)</h2>

      <% if (finalProjectSubs.length === 0) { %>
        <div class="empty-state">Aucune soumission de projet final.</div>
      <% } else { %>
        <% finalProjectSubs.forEach(sub => { %>
          <div class="sub-card <%= sub.status === 'graded' ? 'graded' : 'pending' %>">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-1">
              <div class="sub-student">
                <%= sub.userId ? (sub.userId.surname || '') + ' ' + (sub.userId.name || '') : 'Étudiant inconnu' %>
                <span class="text-muted fw-normal" style="font-size:.85rem;">@<%= sub.userId ? sub.userId.username : '—' %></span>
              </div>
              <span class="badge-<%= sub.status %>">
                <% if (sub.status === 'graded') { %>✓ Noté : <%= sub.grade %>/<%= course.finalProject.maxScore || 100 %><% } else { %>⏳ En attente<% } %>
              </span>
            </div>
            <div class="sub-meta">
              Soumis le <%= new Date(sub.submittedAt || sub.createdAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %>
              · <%= sub.submissionType === 'link' ? 'Lien' : 'Texte' %>
            </div>

            <div class="sub-content">
              <% if (sub.submissionType === 'link') { %>
                <a href="<%= sub.content %>" target="_blank" rel="noopener" style="color:#5d06ba;word-break:break-all;"><%= sub.content %></a>
              <% } else { %>
                <%= sub.content %>
              <% } %>
            </div>

            <% if (sub.status === 'graded' && sub.feedback) { %>
              <div class="existing-grade mb-3">
                <strong style="color:#1e40af;">Feedback actuel :</strong>
                <span style="color:#1e40af;"> <%= sub.feedback %></span>
              </div>
            <% } %>

            <form action="/institution/dashboard/content/courses/<%= course._id %>/final-projects/<%= sub._id %>/grade?_method=POST" method="POST">
              <div class="grade-form">
                <div class="form-group">
                  <label>Note (/ <%= course.finalProject.maxScore || 100 %>)</label>
                  <input type="number" name="grade" min="0" max="<%= course.finalProject.maxScore || 100 %>" step="0.5"
                         value="<%= sub.status === 'graded' ? sub.grade : '' %>" required placeholder="ex: 90">
                </div>
                <div class="form-group" style="flex:1;">
                  <label>Feedback (optionnel)</label>
                  <textarea name="feedback" rows="2" placeholder="Commentaire pour l'étudiant…"><%= sub.feedback || '' %></textarea>
                </div>
                <button type="submit" class="btn-grade">
                  <%= sub.status === 'graded' ? 'Mettre à jour' : 'Noter' %>
                </button>
              </div>
            </form>
          </div>
        <% }) %>
      <% } %>
    </div>
    <% } %>

  </div>
</div>
