<% layout('layouts/institutionBoilerplate') %>
<% const _brand = typeof institutionColor !== 'undefined' ? institutionColor : '#0e7490'; %>

<% headContent = `<style>
  :root { --brand: ${_brand}; }
  .page-wrapper { margin-top: 80px; padding: 2rem 0 5rem; background: #f8fafc; min-height: 100vh; }

  /* ── Page header ── */
  .page-header { background: linear-gradient(135deg, var(--brand) 0%, color-mix(in srgb, var(--brand) 68%, #000) 100%); color: #fff; padding: 2rem 2.25rem; border-radius: 20px; margin-bottom: 1.75rem; }
  .page-header h1 { margin: 0 0 .3rem; font-size: 1.75rem; font-weight: 800; }
  .page-header p { margin: 0; opacity: .8; font-size: .9rem; }

  /* ── Summary bar ── */
  .summary-row { display: flex; gap: 1.5rem; background: #fff; border-radius: 14px; padding: 1rem 1.5rem; margin-bottom: 1.5rem; flex-wrap: wrap; box-shadow: 0 2px 10px rgba(0,0,0,.06); }
  .summary-item .num { font-size: 1.5rem; font-weight: 800; color: var(--brand); line-height: 1.1; }
  .summary-item .lbl { font-size: .73rem; color: #94a3b8; margin-top: .1rem; }

  /* ── Section cards ── */
  .section-card { background: #fff; border-radius: 18px; box-shadow: 0 2px 14px rgba(0,0,0,.07); margin-bottom: 1.5rem; overflow: hidden; }
  .section-card .sc-head { padding: 1.1rem 1.5rem; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .section-card .sc-title { font-size: 1rem; font-weight: 700; color: #1e293b; margin: 0; }
  .section-card .sc-body { padding: 1.5rem; }

  /* ── Students table ── */
  .table th { background: color-mix(in srgb, var(--secondary) 30%, #fff); color: var(--brand); font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; border-bottom: 2px solid color-mix(in srgb, var(--secondary) 60%, #fff); }
  .progress-bar-custom { height: 7px; border-radius: 4px; background: #e2e8f0; overflow: hidden; min-width: 80px; }
  .progress-bar-fill { height: 100%; background: var(--brand); border-radius: 4px; }
  .badge-active   { color: #065f46; background: #d1fae5; padding: .15rem .55rem; border-radius: 20px; font-size: .75rem; font-weight: 600; }
  .badge-expired  { color: #991b1b; background: #fee2e2; padding: .15rem .55rem; border-radius: 20px; font-size: .75rem; font-weight: 600; }

  /* ── Grading summary ── */
  .grading-list { display: flex; flex-direction: column; gap: .6rem; }
  .grading-row  { display: flex; align-items: center; gap: 1rem; padding: .65rem 1rem; background: #f8fafc; border-radius: 10px; }
  .grading-row .gr-title { font-size: .88rem; font-weight: 600; color: #1e293b; flex: 1; }
  .grading-row .gr-badge { font-size: .78rem; font-weight: 700; padding: .2rem .6rem; border-radius: 20px; white-space: nowrap; }
  .gr-badge.pending { background: #fee2e2; color: #dc2626; }
  .gr-badge.ok      { background: #d1fae5; color: #065f46; }
  .gr-badge.none    { background: #f1f5f9; color: #94a3b8; }
  .grading-bar-wrap { width: 120px; }
  .grading-bar { height: 6px; border-radius: 3px; background: #e2e8f0; overflow: hidden; }
  .grading-bar-fill { height: 100%; background: var(--brand); border-radius: 3px; transition: width .4s; }

  /* ── Instructors ── */
  .instr-grid { display: flex; flex-wrap: wrap; gap: .75rem; }
  .instr-card { display: flex; align-items: center; gap: .75rem; background: #f8fafc; border-radius: 12px; padding: .7rem 1rem; border: 1px solid #e2e8f0; min-width: 200px; }
  .instr-avatar { width: 38px; height: 38px; border-radius: 50%; background: color-mix(in srgb, var(--brand) 15%, #fff); color: var(--brand); font-weight: 800; font-size: .85rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .instr-name { font-weight: 600; font-size: .88rem; color: #1e293b; margin: 0 0 .1rem; }
  .instr-title { font-size: .75rem; color: #94a3b8; margin: 0; }

  /* ── Enroll panel ── */
  .enroll-panel { border-top: 1px solid #f1f5f9; padding: 1.25rem 1.5rem; background: #fafcff; }
  .enroll-search-wrap { position: relative; }
  .enroll-results { position: absolute; top: 100%; left: 0; right: 0; background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,.1); z-index: 100; max-height: 250px; overflow-y: auto; display: none; }
  .enroll-result-item { padding: .6rem 1rem; cursor: pointer; display: flex; align-items: center; justify-content: space-between; font-size: .88rem; transition: background .15s; }
  .enroll-result-item:hover { background: color-mix(in srgb, var(--secondary) 20%, #fff); }
  .enroll-result-item .already { font-size: .72rem; color: #94a3b8; }
  #selectedUserId { /* hidden input */ }
</style>` %>

<div class="page-wrapper">
  <div class="container" style="max-width:1100px;">

    <!-- Header -->
    <div class="page-header">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
          <h1><%= course.title %></h1>
          <p>Gestion du cours · <%= institution.name %></p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <a href="/institution/dashboard/courses/<%= course._id %>/export.csv" class="btn btn-light btn-sm">⬇ Export CSV</a>
          <a href="/institution/dashboard" class="btn btn-light btn-sm">← Tableau de bord</a>
        </div>
      </div>
    </div>

    <%- include('../../partials/flash') %>

    <%
      const now = new Date();
      const enrolledCount = studentsData.length;
      const activeCount = studentsData.filter(s => !s.enrollment.endDate || new Date(s.enrollment.endDate) >= now).length;
      const totalModules = studentsData[0] ? studentsData[0].totalModules : 0;
      const avgProgress = enrolledCount > 0 && totalModules > 0
        ? Math.round(studentsData.reduce((s, d) => s + (d.completedModules / d.totalModules * 100), 0) / enrolledCount)
        : 0;
      const totalPendingGrading = modulesWithGrading.reduce((s, m) => s + (m.grading ? m.grading.submitted : 0), 0)
          + finalProjectStats.submitted;
    %>

    <!-- Summary bar -->
    <div class="summary-row">
      <div class="summary-item"><div class="num"><%= enrolledCount %></div><div class="lbl">Inscrits</div></div>
      <div class="summary-item"><div class="num"><%= activeCount %></div><div class="lbl">Actifs</div></div>
      <div class="summary-item"><div class="num"><%= avgProgress %>%</div><div class="lbl">Progression moy.</div></div>
      <div class="summary-item"><div class="num"><%= totalModules %></div><div class="lbl">Leçons</div></div>
      <% if (totalPendingGrading > 0) { %>
      <div class="summary-item">
        <div class="num" style="color:#dc2626"><%= totalPendingGrading %></div>
        <div class="lbl" style="color:#dc2626">À corriger</div>
      </div>
      <% } %>
    </div>

    <!-- ── Grading summary ── -->
    <% const gradedModules = modulesWithGrading.filter(m => m.grading || (m.assignment && m.assignment.title)); %>
    <% if (gradedModules.length > 0 || finalProjectStats.submitted + finalProjectStats.graded > 0) { %>
    <div class="section-card">
      <div class="sc-head">
        <h2 class="sc-title">📋 Corrections</h2>
        <% if (totalPendingGrading > 0) { %>
          <span style="font-size:.82rem;color:#dc2626;font-weight:700;"><%= totalPendingGrading %> en attente</span>
        <% } else { %>
          <span style="font-size:.82rem;color:#059669;font-weight:700;">Tout est corrigé ✓</span>
        <% } %>
      </div>
      <div class="sc-body">
        <div class="grading-list">
          <% gradedModules.forEach(m => {
            const submitted = m.grading ? m.grading.submitted : 0;
            const graded    = m.grading ? m.grading.graded    : 0;
            const total     = submitted + graded;
            const pct       = total > 0 ? Math.round((graded / total) * 100) : 0;
          %>
          <div class="grading-row">
            <span class="gr-title"><%= m.title %><% if (m.assignment && m.assignment.title) { %> — <em style="font-weight:400;color:#64748b;"><%= m.assignment.title %></em><% } %></span>
            <div class="grading-bar-wrap">
              <div class="grading-bar"><div class="grading-bar-fill" style="width:<%= pct %>%"></div></div>
              <div style="font-size:.7rem;color:#94a3b8;margin-top:.2rem;text-align:right"><%= graded %>/<%= total %> notés</div>
            </div>
            <% if (submitted > 0) { %>
              <span class="gr-badge pending"><%= submitted %> en attente</span>
            <% } else if (graded > 0) { %>
              <span class="gr-badge ok">Tout corrigé</span>
            <% } else { %>
              <span class="gr-badge none">Aucune soumission</span>
            <% } %>
          </div>
          <% }) %>

          <% if (course.finalProject && course.finalProject.title) {
            const sub = finalProjectStats.submitted;
            const grd = finalProjectStats.graded;
            const tot = sub + grd;
            const pct = tot > 0 ? Math.round((grd / tot) * 100) : 0;
          %>
          <div class="grading-row">
            <span class="gr-title">Projet final — <em style="font-weight:400;color:#64748b;"><%= course.finalProject.title %></em></span>
            <div class="grading-bar-wrap">
              <div class="grading-bar"><div class="grading-bar-fill" style="width:<%= pct %>%"></div></div>
              <div style="font-size:.7rem;color:#94a3b8;margin-top:.2rem;text-align:right"><%= grd %>/<%= tot %> notés</div>
            </div>
            <% if (sub > 0) { %>
              <span class="gr-badge pending"><%= sub %> en attente</span>
            <% } else if (grd > 0) { %>
              <span class="gr-badge ok">Tout corrigé</span>
            <% } else { %>
              <span class="gr-badge none">Aucune soumission</span>
            <% } %>
          </div>
          <% } %>
        </div>
      </div>
    </div>
    <% } %>

    <!-- ── Instructors ── -->
    <div class="section-card">
      <div class="sc-head">
        <h2 class="sc-title">👨‍🏫 Instructeurs assignés</h2>
        <a href="/institution/dashboard/content/courses/<%= course._id %>" class="btn btn-sm" style="font-size:.8rem;padding:.3rem .8rem;background:color-mix(in srgb,var(--brand) 12%,#fff);color:var(--brand);border-radius:8px;font-weight:600;text-decoration:none;">Gérer →</a>
      </div>
      <div class="sc-body">
        <% if (!course.instructors || course.instructors.length === 0) { %>
          <p class="text-muted small mb-0">Aucun instructeur assigné à ce cours. <a href="/institution/dashboard/content/courses/<%= course._id %>">Assigner un instructeur →</a></p>
        <% } else { %>
          <div class="instr-grid">
            <% course.instructors.forEach(inst => { %>
              <div class="instr-card">
                <div class="instr-avatar"><%= (inst.name || '?').charAt(0).toUpperCase() %></div>
                <div>
                  <p class="instr-name"><%= inst.name %></p>
                  <p class="instr-title"><%= inst.title || inst.email || 'Instructeur' %></p>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- ── Students table ── -->
    <div class="section-card">
      <div class="sc-head">
        <h2 class="sc-title">👥 Étudiants (<%= enrolledCount %>)</h2>
      </div>

      <% if (studentsData.length === 0) { %>
        <div class="sc-body text-center text-muted py-4">
          <p style="font-size:2rem;margin:0 0 .5rem;">📭</p>
          <p class="small mb-0">Aucun étudiant inscrit. Utilisez le panneau ci-dessous pour inscrire des étudiants.</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th>Étudiant</th>
                <th>Statut</th>
                <th>Accès jusqu'au</th>
                <th>Progression</th>
                <th>Dernière activité</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% studentsData.forEach(({ student, enrollment, completedModules, totalModules: tl, lastActivity }) => {
                const isExpired = enrollment.endDate && new Date(enrollment.endDate) < now;
                const pct = tl > 0 ? Math.round((completedModules / tl) * 100) : 0;
              %>
                <tr>
                  <td>
                    <div class="fw-semibold"><%= student.surname %> <%= student.name %></div>
                    <div class="text-muted" style="font-size:.78rem">@<%= student.username %></div>
                  </td>
                  <td>
                    <% if (isExpired) { %><span class="badge-expired">Expiré</span>
                    <% } else { %><span class="badge-active">Actif</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (enrollment.endDate) { %>
                      <span style="font-size:.83rem"><%= new Date(enrollment.endDate).toLocaleDateString('fr-FR') %></span>
                    <% } else { %><span class="text-muted">—</span><% } %>
                  </td>
                  <td style="min-width:140px">
                    <% if (tl > 0) { %>
                      <div class="d-flex align-items-center gap-2">
                        <div class="progress-bar-custom flex-grow-1">
                          <div class="progress-bar-fill" style="width:<%= pct %>%"></div>
                        </div>
                        <span style="font-size:.78rem;color:#555;white-space:nowrap"><%= completedModules %>/<%= tl %></span>
                      </div>
                    <% } else { %><span class="text-muted small">—</span><% } %>
                  </td>
                  <td>
                    <% if (lastActivity) { %>
                      <span style="font-size:.82rem"><%= new Date(lastActivity).toLocaleDateString('fr-FR') %></span>
                    <% } else { %><span class="text-muted small">—</span><% } %>
                  </td>
                  <td>
                    <a href="/institution/dashboard/students/<%= student._id %>" class="btn btn-sm btn-outline-primary py-0 px-2">Voir</a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>

      <!-- Enroll panel -->
      <div class="enroll-panel">
        <p class="fw-semibold mb-3" style="font-size:.9rem;">➕ Inscrire un étudiant</p>
        <form action="/institution/dashboard/courses/<%= course._id %>/enroll" method="POST" id="enrollForm">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <input type="hidden" name="userId" id="selectedUserId">

          <div class="row g-3 align-items-end">
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Rechercher un étudiant</label>
              <div class="enroll-search-wrap">
                <input type="text" id="enrollSearch" class="form-control form-control-sm" placeholder="Nom, prénom ou email…" autocomplete="off">
                <div class="enroll-results" id="enrollResults"></div>
              </div>
              <div id="selectedInfo" class="mt-1" style="font-size:.78rem;color:var(--brand);display:none;"></div>
            </div>
            <div class="col-md-3">
              <label class="form-label small fw-semibold">Date début</label>
              <input type="date" name="startDate" class="form-control form-control-sm" value="<%= new Date().toISOString().split('T')[0] %>">
            </div>
            <div class="col-md-3">
              <label class="form-label small fw-semibold">Date fin</label>
              <input type="date" name="endDate" class="form-control form-control-sm">
            </div>
            <div class="col-md-2">
              <button type="submit" class="btn btn-sm w-100" id="enrollSubmit" disabled style="background:var(--brand);color:#fff;font-weight:700;">Inscrire</button>
            </div>
          </div>
        </form>
      </div>
    </div>

  </div>
</div>

<script>
(function() {
  const enrolledSet = new Set(<%= JSON.stringify(enrolledUserIds) %>);
  const searchInput = document.getElementById('enrollSearch');
  const resultsBox  = document.getElementById('enrollResults');
  const hiddenId    = document.getElementById('selectedUserId');
  const submitBtn   = document.getElementById('enrollSubmit');
  const selectedInfo = document.getElementById('selectedInfo');

  let debounceTimer;

  searchInput.addEventListener('input', function() {
    clearTimeout(debounceTimer);
    const q = this.value.trim();
    hiddenId.value = '';
    submitBtn.disabled = true;
    selectedInfo.style.display = 'none';
    if (q.length < 2) { resultsBox.style.display = 'none'; return; }
    debounceTimer = setTimeout(() => fetchResults(q), 250);
  });

  document.addEventListener('click', function(e) {
    if (!e.target.closest('.enroll-search-wrap')) {
      resultsBox.style.display = 'none';
    }
  });

  function fetchResults(q) {
    fetch('/institution/dashboard/students/search?q=' + encodeURIComponent(q))
      .then(r => r.json())
      .then(data => {
        resultsBox.innerHTML = '';
        if (!data.users.length) {
          resultsBox.innerHTML = '<div style="padding:.7rem 1rem;color:#94a3b8;font-size:.85rem;">Aucun résultat</div>';
          resultsBox.style.display = 'block';
          return;
        }
        data.users.forEach(u => {
          const alreadyEnrolled = enrolledSet.has(u._id);
          const div = document.createElement('div');
          div.className = 'enroll-result-item';
          div.innerHTML = `<span><strong>${u.surname} ${u.name}</strong> <span style="color:#94a3b8">@${u.username}</span></span>`
            + (alreadyEnrolled ? '<span class="already">Déjà inscrit</span>' : '');
          if (!alreadyEnrolled) {
            div.addEventListener('click', () => selectUser(u));
          } else {
            div.style.opacity = '.55';
            div.style.cursor = 'default';
          }
          resultsBox.appendChild(div);
        });
        resultsBox.style.display = 'block';
      })
      .catch(() => { resultsBox.style.display = 'none'; });
  }

  function selectUser(u) {
    hiddenId.value = u._id;
    searchInput.value = u.surname + ' ' + u.name + ' (@' + u.username + ')';
    resultsBox.style.display = 'none';
    submitBtn.disabled = false;
    selectedInfo.textContent = u.email;
    selectedInfo.style.display = 'block';
  }

  document.getElementById('enrollForm').addEventListener('submit', function(e) {
    if (!hiddenId.value) { e.preventDefault(); alert('Veuillez sélectionner un étudiant.'); }
  });
})();
</script>
