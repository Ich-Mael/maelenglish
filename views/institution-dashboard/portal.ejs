<% layout('layouts/main') %>

<% headContent = `<style>
  :root { --brand: <%= institutionColor %>; }
  .portal-wrapper { margin-top: 80px; padding-bottom: 5rem; background: #f8fafc; min-height: 100vh; }

  /* Hero */
  .portal-hero { background: linear-gradient(135deg, color-mix(in srgb,var(--brand) 80%,#000) 0%, var(--brand) 100%); color: white; padding: 3rem 0; }
  .institution-logo { width: 72px; height: 72px; border-radius: 18px; object-fit: cover; border: 3px solid rgba(255,255,255,.3); box-shadow: 0 4px 16px rgba(0,0,0,.2); }
  .logo-placeholder { width: 72px; height: 72px; border-radius: 18px; background: rgba(255,255,255,.2); display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 800; color: white; border: 3px solid rgba(255,255,255,.3); flex-shrink: 0; }
  .portal-hero h1 { font-size: 2rem; font-weight: 800; margin: 0 0 .3rem; }
  .portal-hero p  { margin: 0; opacity: .85; font-size: 1rem; }

  /* Layout */
  .portal-grid { display: grid; grid-template-columns: 1fr 360px; gap: 2rem; padding-top: 2rem; }
  @media(max-width:900px){ .portal-grid{ grid-template-columns:1fr; } .sidebar{ order:-1; } }

  /* Section card */
  .section-card { background: #fff; border-radius: 18px; box-shadow: 0 2px 14px rgba(0,0,0,.07); padding: 1.75rem; margin-bottom: 1.5rem; }
  .section-card h2 { font-size: 1.05rem; font-weight: 700; color: #1e293b; margin: 0 0 1.25rem; padding-bottom: .75rem; border-bottom: 2px solid #f1f5f9; display: flex; align-items: center; gap: .5rem; }

  /* Announcements */
  .ann-item { border-radius: 14px; padding: 1.1rem 1.25rem; margin-bottom: .75rem; border-left: 4px solid var(--brand); background: #fff; box-shadow: 0 1px 6px rgba(0,0,0,.05); }
  .ann-item.pinned { background: color-mix(in srgb, var(--brand) 6%, #fff); }
  .ann-type-badge { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; padding: .15rem .55rem; border-radius: 20px; margin-left: .5rem; }
  .type-info     { background: #dbeafe; color: #1e40af; }
  .type-discount { background: #dcfce7; color: #166534; }
  .type-new_course { background: #f3e8ff; color: #6d28d9; }
  .type-event    { background: #ffedd5; color: #c2410c; }
  .type-reminder { background: #fef9c3; color: #854d0e; }
  .ann-title { font-weight: 700; color: #1e293b; margin: 0 0 .35rem; font-size: .95rem; }
  .ann-body  { color: #475569; font-size: .88rem; line-height: 1.6; margin: 0 0 .4rem; }
  .ann-meta  { font-size: .75rem; color: #94a3b8; }

  /* Courses */
  .course-row { display: flex; align-items: center; gap: 1rem; padding: .85rem 1rem; border-radius: 12px; border: 1px solid #e2e8f0; margin-bottom: .6rem; text-decoration: none; color: inherit; transition: border-color .2s, box-shadow .2s; }
  .course-row:hover { border-color: var(--brand); box-shadow: 0 2px 10px rgba(0,0,0,.07); color: inherit; }
  .course-thumb { width: 52px; height: 52px; border-radius: 10px; object-fit: cover; flex-shrink: 0; background: color-mix(in srgb, var(--brand) 15%, #fff); display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
  .course-thumb img { width: 100%; height: 100%; border-radius: 10px; object-fit: cover; }
  .course-info { flex: 1; min-width: 0; }
  .course-info strong { font-size: .95rem; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .course-info .meta { font-size: .78rem; color: #64748b; margin-top: .15rem; }
  .mini-bar-bg   { height: 5px; border-radius: 3px; background: #e2e8f0; overflow: hidden; margin-top: .35rem; }
  .mini-bar-fill { height: 100%; background: var(--brand); border-radius: 3px; }

  /* Sidebar */
  .sidebar-card { background: #fff; border-radius: 18px; box-shadow: 0 2px 14px rgba(0,0,0,.07); padding: 1.5rem; margin-bottom: 1.5rem; }
  .sidebar-card h3 { font-size: .9rem; font-weight: 700; color: #1e293b; margin: 0 0 1rem; padding-bottom: .6rem; border-bottom: 1px solid #f1f5f9; }
  .info-row { display: flex; gap: .6rem; align-items: flex-start; padding: .5rem 0; border-bottom: 1px solid #f8fafc; font-size: .85rem; color: #475569; }
  .info-row:last-child { border-bottom: none; }
  .info-row i { color: var(--brand); width: 18px; flex-shrink: 0; margin-top: .1rem; }
  .btn-all-courses { display: flex; align-items: center; justify-content: center; gap: .5rem; width: 100%; padding: .75rem; background: var(--brand); color: #fff; border-radius: 12px; font-weight: 600; text-decoration: none; font-size: .9rem; margin-top: 1rem; transition: opacity .2s; }
  .btn-all-courses:hover { opacity: .88; color: #fff; }
</style>` %>

<div class="portal-wrapper">

  <!-- Hero -->
  <div class="portal-hero">
    <div class="container">
      <div class="d-flex align-items-center gap-3">
        <% if (institution.logoUrl) { %>
          <img src="<%= institution.logoUrl %>" alt="<%= institution.name %>" class="institution-logo">
        <% } else { %>
          <div class="logo-placeholder"><%= institution.name.charAt(0).toUpperCase() %></div>
        <% } %>
        <div>
          <h1><%= institution.name %></h1>
          <p><% if (institution.city) { %><%= institution.city %><% if (institution.country) { %>, <%= institution.country %><% } %><% } else { %>Portail étudiant<% } %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <%- include('../partials/flash') %>

    <div class="portal-grid">

      <!-- Left: Announcements + Courses -->
      <div>
        <!-- Announcements -->
        <div class="section-card">
          <h2>📢 Annonces</h2>
          <% if (announcements.length === 0) { %>
            <p class="text-muted small mb-0">Aucune annonce pour le moment.</p>
          <% } else { %>
            <% const typeLabels = { info: 'Info', discount: 'Promo', new_course: 'Nouveau cours', event: 'Événement', reminder: 'Rappel' }; %>
            <% announcements.forEach(ann => { %>
              <div class="ann-item <%= ann.isPinned ? 'pinned' : '' %>">
                <div class="d-flex align-items-center gap-1 mb-1">
                  <% if (ann.isPinned) { %><span style="font-size:.8rem;">📌</span><% } %>
                  <p class="ann-title mb-0"><%= ann.title %></p>
                  <span class="ann-type-badge type-<%= ann.type %>"><%= typeLabels[ann.type] || ann.type %></span>
                </div>
                <p class="ann-body"><%= ann.body %></p>
                <p class="ann-meta"><%= new Date(ann.createdAt).toLocaleDateString('fr-FR', { day:'numeric', month:'long', year:'numeric' }) %></p>
              </div>
            <% }) %>
          <% } %>
        </div>

        <!-- My courses -->
        <div class="section-card">
          <h2>🎓 Mes cours (<%= coursesWithProgress.length %>)</h2>
          <% if (coursesWithProgress.length === 0) { %>
            <p class="text-muted small mb-0">Aucun cours inscrit pour le moment.</p>
          <% } else { %>
            <% coursesWithProgress.forEach(({ course, completed, total, pct, enrollment }) => {
              const now       = new Date();
              const isExpired = enrollment && enrollment.endDate && new Date(enrollment.endDate) < now;
            %>
              <a href="/institution/learn/courses/<%= course._id %>" class="course-row">
                <div class="course-thumb">
                  <% if (course.courseImageUrl) { %>
                    <img src="<%= course.courseImageUrl %>" alt="">
                  <% } else { %>
                    📘
                  <% } %>
                </div>
                <div class="course-info">
                  <strong><%= course.title %></strong>
                  <div class="meta">
                    <%= completed %>/<%= total %> leçons
                    <% if (isExpired) { %>· <span style="color:#dc2626;">expiré</span><% } %>
                    <% else if (enrollment && enrollment.endDate) { %>
                      · expire le <%= new Date(enrollment.endDate).toLocaleDateString('fr-FR') %>
                    <% } %>
                  </div>
                  <div class="mini-bar-bg"><div class="mini-bar-fill" style="width:<%= pct %>%"></div></div>
                </div>
                <span style="color:#cbd5e1;font-size:.85rem;"><%= pct %>%</span>
              </a>
            <% }) %>
          <% } %>
          <a href="/institution/learn/courses" class="btn-all-courses">
            <i class="bi bi-grid-3x3-gap"></i> Voir tous mes cours
          </a>
        </div>
      </div>

      <!-- Right: Sidebar -->
      <div class="sidebar">
        <div class="sidebar-card">
          <h3>À propos</h3>
          <% if (institution.description) { %>
            <p style="color:#475569;font-size:.88rem;line-height:1.6;margin-bottom:1rem;"><%= institution.description %></p>
          <% } %>
          <% if (institution.contactEmail) { %>
            <div class="info-row"><i class="bi bi-envelope"></i><span><%= institution.contactEmail %></span></div>
          <% } %>
          <% if (institution.phone) { %>
            <div class="info-row"><i class="bi bi-telephone"></i><span><%= institution.phone %></span></div>
          <% } %>
          <% if (institution.city) { %>
            <div class="info-row"><i class="bi bi-geo-alt"></i><span><%= institution.city %><% if (institution.country) { %>, <%= institution.country %><% } %></span></div>
          <% } %>
        </div>

        <div class="sidebar-card">
          <h3>Navigation</h3>
          <a href="/dashboard" class="d-flex align-items-center gap-2 py-2" style="text-decoration:none;color:#475569;font-size:.9rem;border-bottom:1px solid #f1f5f9;">
            <i class="bi bi-house" style="color:var(--brand)"></i> Tableau de bord AfroHK
          </a>
          <a href="/institution/learn/courses" class="d-flex align-items-center gap-2 py-2" style="text-decoration:none;color:#475569;font-size:.9rem;">
            <i class="bi bi-mortarboard" style="color:var(--brand)"></i> Mes cours
          </a>
        </div>
      </div>

    </div>
  </div>
</div>
