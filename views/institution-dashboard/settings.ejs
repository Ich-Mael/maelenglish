<% layout('layouts/institutionBoilerplate') %>

<% const brandColor = typeof institutionColor !== 'undefined' ? institutionColor : '#0e7490'; %>
<% headContent = `<style>
  :root { --brand: ${brandColor}; }
  .page-wrapper { margin-top: 80px; padding: 2rem 0 5rem; background: #f8fafc; min-height: 100vh; }
  .page-header { background: linear-gradient(135deg, var(--brand) 0%, color-mix(in srgb, var(--brand) 65%, #000) 100%); color: #fff; padding: 1.75rem 2rem; border-radius: 18px; margin-bottom: 2rem; }
  .page-header h1 { margin: 0 0 .2rem; font-size: 1.6rem; font-weight: 800; }
  .page-header p  { margin: 0; opacity: .8; font-size: .9rem; }
  .settings-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,.07); padding: 1.75rem; margin-bottom: 1.5rem; }
  .settings-card h2 { font-size: .95rem; font-weight: 700; color: var(--brand); margin: 0 0 1.25rem; padding-bottom: .75rem; border-bottom: 2px solid color-mix(in srgb, var(--brand) 15%, #fff); display: flex; align-items: center; gap: .5rem; }
  .form-label { font-size: .83rem; font-weight: 600; color: #374151; margin-bottom: .3rem; }
  .form-control, .form-select { border-radius: 9px; border: 1.5px solid #e2e8f0; font-size: .88rem; padding: .5rem .75rem; transition: border-color .15s, box-shadow .15s; }
  .form-control:focus, .form-select:focus { border-color: var(--brand); box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 15%, #fff); outline: none; }
  .input-icon-wrap { position: relative; }
  .input-icon-wrap .icon { position: absolute; left: .75rem; top: 50%; transform: translateY(-50%); font-size: .95rem; pointer-events: none; }
  .input-icon-wrap .form-control { padding-left: 2.1rem; }
  .hint { font-size: .75rem; color: #94a3b8; margin-top: .3rem; }
  .color-slots { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 1rem; }
  .color-slot { border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 1rem; display: flex; flex-direction: column; gap: .55rem; transition: border-color .15s; overflow: hidden; }
  .color-slot:focus-within { border-color: var(--brand); }
  .color-slot-label { font-size: .76rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: #64748b; }
  .color-slot-optional { font-size: .69rem; font-weight: 400; color: #94a3b8; text-transform: none; letter-spacing: 0; }
  .color-picker-row { display: flex; align-items: center; gap: .5rem; }
  .color-swatch { width: 38px; height: 38px; border-radius: 8px; border: none; cursor: pointer; padding: 2px; flex-shrink: 0; background: none; }
  .color-hex { flex: 1; min-width: 0; font-family: monospace; font-size: .87rem; padding: .4rem .6rem; border-radius: 8px; border: 1.5px solid #e2e8f0; }
  .color-hex:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 15%, #fff); }
  .clear-color-btn { background: none; border: none; color: #94a3b8; font-size: .85rem; cursor: pointer; padding: .2rem .4rem; border-radius: 6px; }
  .clear-color-btn:hover { background: #fee2e2; color: #dc2626; }
  .brand-preview { border-radius: 10px; overflow: hidden; height: 36px; display: flex; margin-top: .6rem; border: 1px solid #e2e8f0; }
  .brand-preview-block { flex: 1; transition: background .2s; }
  .btn-save { background: var(--brand); color: #fff; border: none; padding: .7rem 2.5rem; border-radius: 10px; font-weight: 700; font-size: .95rem; cursor: pointer; transition: opacity .15s; }
  .btn-save:hover { opacity: .88; }
  .social-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .85rem; }
  @media (max-width: 600px) { .social-grid { grid-template-columns: 1fr; } }
  .logo-preview { width: 72px; height: 72px; border-radius: 12px; object-fit: cover; border: 2px solid #e2e8f0; display: none; }
  .logo-preview.visible { display: block; }
</style>` %>

<div class="page-wrapper">
  <div class="container" style="max-width:780px;">

    <div class="page-header">
      <h1>⚙️ Paramètres de l'institution</h1>
      <p>Modifiez les informations publiques, les coordonnées et la présence en ligne de <%= institution.name %>.</p>
    </div>

    <%- include('../partials/flash') %>

    <form action="/institution/dashboard/settings?_method=PUT" method="POST">

      <!-- Présentation -->
      <div class="settings-card">
        <h2>🏫 Présentation</h2>
        <div class="mb-3">
          <label class="form-label">Nom de l'institution</label>
          <input type="text" class="form-control" value="<%= institution.name %>" disabled>
          <p class="hint">Le nom est géré par l'équipe AfroHK. Contactez-nous pour le modifier.</p>
        </div>
        <div class="mb-3">
          <label class="form-label">Description</label>
          <textarea name="description" class="form-control" rows="4" placeholder="Présentez votre institution en quelques phrases…"><%= institution.description || '' %></textarea>
        </div>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Ville</label>
            <input type="text" name="city" class="form-control" value="<%= institution.city || '' %>" placeholder="Ouagadougou">
          </div>
          <div class="col-md-6">
            <label class="form-label">Pays</label>
            <input type="text" name="country" class="form-control" value="<%= institution.country || 'Burkina Faso' %>">
          </div>
        </div>
      </div>

      <!-- Coordonnées -->
      <div class="settings-card">
        <h2>📞 Coordonnées</h2>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Email de contact</label>
            <div class="input-icon-wrap">
              <span class="icon">✉️</span>
              <input type="email" name="contactEmail" class="form-control" value="<%= institution.contactEmail || '' %>" placeholder="contact@institution.bf">
            </div>
          </div>
          <div class="col-md-6">
            <label class="form-label">Téléphone / WhatsApp</label>
            <div class="input-icon-wrap">
              <span class="icon">📱</span>
              <input type="text" name="phone" class="form-control" value="<%= institution.phone || '' %>" placeholder="+226 XX XX XX XX">
            </div>
          </div>
        </div>
      </div>

      <!-- Apparence -->
      <div class="settings-card">
        <h2>🎨 Apparence</h2>
        <div class="mb-3">
          <label class="form-label">Logo (URL de l'image)</label>
          <div class="d-flex align-items-start gap-3">
            <img id="logoPreview" class="logo-preview<%= institution.logoUrl ? ' visible' : '' %>"
                 src="<%= institution.logoUrl || '' %>" alt="Logo">
            <div style="flex:1;">
              <input type="url" name="logoUrl" id="logoUrlInput" class="form-control"
                     value="<%= institution.logoUrl || '' %>"
                     placeholder="https://example.com/logo.png">
              <p class="hint">Utilisez une image carrée de 200×200px minimum.</p>
            </div>
          </div>
        </div>
        <div class="mb-1">
          <label class="form-label">Couleurs de la marque</label>
          <p class="hint mb-2">Jusqu'à 3 couleurs. Seule la principale est obligatoire.</p>
          <div class="color-slots">
            <div class="color-slot">
              <span class="color-slot-label">Principale <span style="color:#dc3545;">*</span></span>
              <div class="color-picker-row">
                <input type="color" class="color-swatch" id="swatch1" value="<%= institution.primaryColor || '#0e7490' %>">
                <input type="text"  name="primaryColor"  id="hex1"   class="color-hex"
                       value="<%= institution.primaryColor || '#0e7490' %>" maxlength="7">
              </div>
            </div>
            <div class="color-slot">
              <span class="color-slot-label">Secondaire <span class="color-slot-optional">(optionnel)</span></span>
              <div class="color-picker-row">
                <input type="color" class="color-swatch" id="swatch2" value="<%= institution.secondaryColor || '#0e7490' %>">
                <input type="text"  name="secondaryColor" id="hex2"  class="color-hex"
                       value="<%= institution.secondaryColor || '' %>" maxlength="7" placeholder="—">
                <button type="button" class="clear-color-btn" onclick="clearColor(2)" title="Effacer">×</button>
              </div>
            </div>
            <div class="color-slot">
              <span class="color-slot-label">Accent <span class="color-slot-optional">(optionnel)</span></span>
              <div class="color-picker-row">
                <input type="color" class="color-swatch" id="swatch3" value="<%= institution.accentColor || '#0e7490' %>">
                <input type="text"  name="accentColor"   id="hex3"   class="color-hex"
                       value="<%= institution.accentColor || '' %>" maxlength="7" placeholder="—">
                <button type="button" class="clear-color-btn" onclick="clearColor(3)" title="Effacer">×</button>
              </div>
            </div>
          </div>
          <div class="brand-preview">
            <div class="brand-preview-block" id="preview1"></div>
            <div class="brand-preview-block" id="preview2"></div>
            <div class="brand-preview-block" id="preview3"></div>
          </div>
        </div>
      </div>

      <!-- Réseaux sociaux -->
      <div class="settings-card">
        <h2>🌐 Présence en ligne</h2>
        <div class="mb-3">
          <label class="form-label">Site web</label>
          <div class="input-icon-wrap">
            <span class="icon">🔗</span>
            <input type="url" name="website" class="form-control"
                   value="<%= institution.socialMedia && institution.socialMedia.website || '' %>"
                   placeholder="https://www.votresite.bf">
          </div>
        </div>
        <div class="social-grid">
          <div>
            <label class="form-label">Facebook</label>
            <div class="input-icon-wrap">
              <span class="icon" style="font-size:.85rem;">fb</span>
              <input type="url" name="facebook" class="form-control"
                     value="<%= institution.socialMedia && institution.socialMedia.facebook || '' %>"
                     placeholder="https://facebook.com/votreepage">
            </div>
          </div>
          <div>
            <label class="form-label">Instagram</label>
            <div class="input-icon-wrap">
              <span class="icon" style="font-size:.85rem;">ig</span>
              <input type="url" name="instagram" class="form-control"
                     value="<%= institution.socialMedia && institution.socialMedia.instagram || '' %>"
                     placeholder="https://instagram.com/votrecompte">
            </div>
          </div>
          <div>
            <label class="form-label">Twitter / X</label>
            <div class="input-icon-wrap">
              <span class="icon" style="font-size:.85rem;">𝕏</span>
              <input type="url" name="twitter" class="form-control"
                     value="<%= institution.socialMedia && institution.socialMedia.twitter || '' %>"
                     placeholder="https://twitter.com/votrecompte">
            </div>
          </div>
          <div>
            <label class="form-label">LinkedIn</label>
            <div class="input-icon-wrap">
              <span class="icon" style="font-size:.85rem;">in</span>
              <input type="url" name="linkedin" class="form-control"
                     value="<%= institution.socialMedia && institution.socialMedia.linkedin || '' %>"
                     placeholder="https://linkedin.com/company/votre-institution">
            </div>
          </div>
          <div>
            <label class="form-label">YouTube</label>
            <div class="input-icon-wrap">
              <span class="icon" style="font-size:.85rem;">▶</span>
              <input type="url" name="youtube" class="form-control"
                     value="<%= institution.socialMedia && institution.socialMedia.youtube || '' %>"
                     placeholder="https://youtube.com/@votrechaine">
            </div>
          </div>
          <div>
            <label class="form-label">WhatsApp (lien ou numéro)</label>
            <div class="input-icon-wrap">
              <span class="icon">💬</span>
              <input type="text" name="whatsapp" class="form-control"
                     value="<%= institution.socialMedia && institution.socialMedia.whatsapp || '' %>"
                     placeholder="+22600000000 ou lien wa.me">
            </div>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-between align-items-center">
        <a href="/institution/dashboard" style="font-size:.85rem;color:#94a3b8;text-decoration:none;">← Tableau de bord</a>
        <button type="submit" class="btn-save">Enregistrer les modifications</button>
      </div>

    </form>
  </div>
</div>

<script>
(function () {
  // Logo preview
  const logoInput = document.getElementById('logoUrlInput');
  const logoImg   = document.getElementById('logoPreview');
  logoInput.addEventListener('input', function () {
    const v = this.value.trim();
    if (v) { logoImg.src = v; logoImg.classList.add('visible'); }
    else   { logoImg.classList.remove('visible'); }
  });

  // Brand color pickers
  const IS_HEX = /^#[0-9a-fA-F]{6}$/;

  function wireColor(n) {
    const swatch = document.getElementById('swatch' + n);
    const hex    = document.getElementById('hex' + n);
    const prev   = document.getElementById('preview' + n);
    if (!swatch || !hex || !prev) return;

    function applyColor(val) {
      const valid = IS_HEX.test(val);
      prev.style.background = valid ? val : '#e2e8f0';
      prev.style.opacity    = (n > 1 && !valid) ? '0.3' : '1';
    }

    swatch.addEventListener('input', function () { hex.value = this.value; applyColor(this.value); });
    hex.addEventListener('input', function () {
      const v = this.value.trim();
      if (IS_HEX.test(v)) { swatch.value = v; applyColor(v); }
      else applyColor('');
    });

    applyColor(hex.value || '');
  }

  wireColor(1); wireColor(2); wireColor(3);

  window.clearColor = function (n) {
    document.getElementById('hex' + n).value    = '';
    document.getElementById('swatch' + n).value = '#0e7490';
    document.getElementById('preview' + n).style.background = '#e2e8f0';
    document.getElementById('preview' + n).style.opacity    = '0.3';
  };
})();
</script>
