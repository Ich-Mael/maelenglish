<%
  layout(false);
  const _color = typeof institutionColor !== 'undefined' ? institutionColor : '#7c3aed';
%>
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Corrections — <%= institution ? institution.name : 'AfroHK' %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <style>
    :root { --brand: <%= _color %>; }
    * { box-sizing: border-box; }
    body { margin: 0; background: #0f172a; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #e2e8f0; min-height: 100vh; }
    .main { margin-top: 64px; padding: 2.5rem 1.5rem 4rem; max-width: 900px; margin-left: auto; margin-right: auto; }
    .page-title { font-size: 1.6rem; font-weight: 800; color: #f8fafc; margin-bottom: .35rem; }
    .page-sub { font-size: .9rem; color: #94a3b8; margin-bottom: 2rem; }
    .course-card {
      background: #1e293b; border-radius: 14px; padding: 1.4rem 1.6rem;
      display: flex; align-items: center; gap: 1.25rem;
      margin-bottom: 1rem; text-decoration: none; color: inherit;
      border: 1.5px solid rgba(255,255,255,.06);
      transition: border-color .15s, background .15s;
    }
    .course-card:hover { background: #263246; border-color: var(--brand); color: inherit; }
    .course-thumb {
      width: 64px; height: 64px; border-radius: 10px; object-fit: cover;
      background: linear-gradient(135deg, var(--brand), color-mix(in srgb, var(--brand) 50%, #000));
      flex-shrink: 0; display: flex; align-items: center; justify-content: center;
      font-size: 1.5rem;
    }
    .course-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 10px; }
    .course-info { flex: 1; min-width: 0; }
    .course-name { font-weight: 700; font-size: 1rem; color: #f1f5f9; margin: 0 0 .3rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .course-status { font-size: .8rem; color: #64748b; }
    .badge-pending {
      display: inline-flex; align-items: center; gap: .3rem;
      background: rgba(245,158,11,.15); color: #fbbf24;
      border: 1px solid rgba(245,158,11,.3); border-radius: 20px;
      font-size: .78rem; font-weight: 700; padding: .25rem .7rem; white-space: nowrap;
    }
    .badge-ok {
      display: inline-flex; align-items: center; gap: .3rem;
      background: rgba(16,185,129,.1); color: #34d399;
      border: 1px solid rgba(16,185,129,.2); border-radius: 20px;
      font-size: .78rem; font-weight: 600; padding: .25rem .7rem; white-space: nowrap;
    }
    .empty-state { text-align: center; padding: 5rem 2rem; color: #475569; }
    .empty-state p:first-child { font-size: 3rem; margin-bottom: .5rem; }
    .arrow-icon { color: #475569; font-size: 1.1rem; flex-shrink: 0; }
  </style>
</head>
<body>
  <%- include('../../partials/instructorNavbar', { activePage: 'home' }) %>

  <div class="main">
    <h1 class="page-title">📋 Mes cours à corriger</h1>
    <p class="page-sub">Cliquez sur un cours pour voir les soumissions en attente.</p>

    <%- include('../../partials/flash') %>

    <% if (!coursesWithCounts || coursesWithCounts.length === 0) { %>
      <div class="empty-state">
        <p>📭</p>
        <p style="font-weight:700;color:#64748b;">Aucun cours assigné pour le moment.</p>
        <p style="font-size:.85rem;">Contactez l'administrateur de votre institution pour être assigné à un cours.</p>
      </div>
    <% } else { %>
      <% coursesWithCounts.forEach(({ course, pendingAssignments, pendingProjects }) => { %>
        <% const totalPending = pendingAssignments + pendingProjects; %>
        <a href="/institution/grade/courses/<%= course._id %>/submissions" class="course-card">
          <div class="course-thumb">
            <% if (course.imageUrl) { %>
              <img src="<%= course.imageUrl %>" alt="<%= course.title %>">
            <% } else { %>
              📚
            <% } %>
          </div>
          <div class="course-info">
            <p class="course-name"><%= course.title %></p>
            <p class="course-status"><%= course.isActive ? 'Actif' : 'Brouillon' %></p>
          </div>
          <div class="d-flex flex-column align-items-end gap-1" style="flex-shrink:0;">
            <% if (totalPending > 0) { %>
              <span class="badge-pending">⏳ <%= totalPending %> en attente</span>
            <% } else { %>
              <span class="badge-ok">✓ À jour</span>
            <% } %>
            <% if (pendingAssignments > 0) { %>
              <span style="font-size:.72rem;color:#64748b;"><%= pendingAssignments %> devoir<%= pendingAssignments > 1 ? 's' : '' %></span>
            <% } %>
            <% if (pendingProjects > 0) { %>
              <span style="font-size:.72rem;color:#64748b;"><%= pendingProjects %> projet<%= pendingProjects > 1 ? 's' : '' %> final<%= pendingProjects > 1 ? 'aux' : '' %></span>
            <% } %>
          </div>
          <i class="bi bi-chevron-right arrow-icon"></i>
        </a>
      <% }) %>
    <% } %>
  </div>
</body>
</html>
