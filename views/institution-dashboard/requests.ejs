<% layout('layouts/institutionBoilerplate') %>

<%
  const statusLabels = { pending: 'En attente', contacted: 'Contacté', enrolled: 'Inscrit', rejected: 'Rejeté' };
  const statusColors = { pending: '#f59e0b', contacted: '#3b82f6', enrolled: '#16a34a', rejected: '#ef4444' };
  const statusBg     = { pending: '#fef9c3', contacted: '#eff6ff', enrolled: '#f0fdf4', rejected: '#fef2f2' };
  const nextStatus   = { pending: 'contacted', contacted: 'enrolled', enrolled: 'rejected', rejected: 'pending' };
  const nextLabel    = { pending: 'Marquer contacté', contacted: 'Marquer inscrit', enrolled: 'Marquer rejeté', rejected: 'Remettre en attente' };
%>

<% headContent = `<style>
  :root { --brand: ${institution.primaryColor || '#5d06ba'}; }

  .req-page { padding: 2rem 0 5rem; background: #f4f6fb; min-height: 100vh; margin-top: 70px; }

  /* Header */
  .req-header {
    background: linear-gradient(135deg, #07031a, #1a0935);
    padding: 2rem 0 2.5rem; position: relative; overflow: hidden;
  }
  .req-header::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse at 80% 50%, color-mix(in srgb, ${institution.primaryColor || '#5d06ba'} 20%, transparent), transparent 60%);
    pointer-events: none;
  }
  .req-header-inner { position: relative; z-index: 1; }
  .req-header h1 { font-size: 1.5rem; font-weight: 800; color: #fff; margin: 0 0 .3rem; }
  .req-header p  { font-size: .88rem; color: rgba(255,255,255,.6); margin: 0; }
  .back-link {
    display: inline-flex; align-items: center; gap: .4rem;
    font-size: .78rem; font-weight: 700;
    color: rgba(255,255,255,.7); background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.14); border-radius: 50px;
    padding: .35rem .9rem; text-decoration: none; margin-bottom: 1.25rem;
    transition: background .15s;
  }
  .back-link:hover { background: rgba(255,255,255,.16); color: #fff; }

  /* Status filter tabs */
  .req-tabs { display: flex; gap: .45rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .req-tab {
    padding: .38rem 1rem; border-radius: 50px;
    border: 1.5px solid #e2e8f0; background: #fff;
    font-size: .82rem; font-weight: 700; color: #374151;
    text-decoration: none; white-space: nowrap;
    transition: all .18s;
  }
  .req-tab:hover { border-color: var(--brand); color: var(--brand); }
  .req-tab.active { background: var(--brand); border-color: var(--brand); color: #fff; }
  .req-tab .tab-count {
    display: inline-flex; align-items: center; justify-content: center;
    width: 18px; height: 18px; border-radius: 50%;
    font-size: .65rem; font-weight: 800;
    background: rgba(255,255,255,.25); color: inherit; margin-left: .25rem;
  }
  .req-tab.active .tab-count { background: rgba(255,255,255,.3); color: #fff; }

  /* Request cards */
  .req-list { display: flex; flex-direction: column; gap: .85rem; }
  .req-card {
    background: #fff; border-radius: 14px;
    box-shadow: 0 1px 6px rgba(0,0,0,.05), 0 3px 12px rgba(0,0,0,.04);
    overflow: hidden;
  }
  .req-card-top {
    display: flex; align-items: flex-start; gap: 1.1rem;
    padding: 1.1rem 1.25rem .9rem;
  }
  .req-avatar {
    width: 44px; height: 44px; border-radius: 50%; flex-shrink: 0;
    background: var(--brand); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.15rem; font-weight: 800;
  }
  .req-name  { font-weight: 700; font-size: .95rem; color: #0f172a; margin-bottom: .12rem; }
  .req-email { font-size: .82rem; color: #64748b; }
  .req-phone { font-size: .8rem; color: #94a3b8; margin-top: .08rem; }
  .req-status-badge {
    margin-left: auto; flex-shrink: 0;
    font-size: .7rem; font-weight: 800; padding: .2rem .65rem; border-radius: 20px;
  }
  .req-card-mid {
    padding: 0 1.25rem .9rem;
    display: flex; gap: 1rem; flex-wrap: wrap; align-items: center;
  }
  .req-course-chip {
    display: inline-flex; align-items: center; gap: .3rem;
    font-size: .78rem; font-weight: 600; color: #374151;
    background: #f1f5f9; border-radius: 20px; padding: .2rem .75rem;
  }
  .req-date { font-size: .76rem; color: #94a3b8; }
  .req-message-box {
    margin: 0 1.25rem .9rem;
    background: #f8fafc; border-left: 3px solid #e2e8f0;
    border-radius: 0 8px 8px 0; padding: .65rem .9rem;
    font-size: .83rem; color: #374151; line-height: 1.55; font-style: italic;
  }
  .req-actions {
    display: flex; gap: .5rem; flex-wrap: wrap; align-items: center;
    padding: .75rem 1.25rem;
    border-top: 1px solid #f1f5f9; background: #fafbfc;
  }
  .btn-status {
    font-size: .78rem; font-weight: 700; padding: .35rem .9rem; border-radius: 8px;
    border: 1.5px solid var(--brand); color: var(--brand); background: transparent; cursor: pointer;
    transition: background .15s, color .15s;
  }
  .btn-status:hover { background: var(--brand); color: #fff; }
  .btn-delete {
    font-size: .78rem; font-weight: 700; padding: .35rem .9rem; border-radius: 8px;
    border: 1.5px solid #fca5a5; color: #ef4444; background: transparent; cursor: pointer;
    transition: background .15s, color .15s; margin-left: auto;
  }
  .btn-delete:hover { background: #fef2f2; }

  /* Empty state */
  .empty-state {
    text-align: center; padding: 4rem 2rem;
    background: #fff; border-radius: 16px;
    box-shadow: 0 1px 6px rgba(0,0,0,.05);
  }
</style>` %>

<div class="req-header">
  <div class="container req-header-inner">
    <a href="/institution/dashboard" class="back-link">← Tableau de bord</a>
    <h1>📩 Demandes d'inscription</h1>
    <p>Visiteurs ayant soumis une demande via le catalogue public</p>
  </div>
</div>

<div class="req-page">
  <div class="container">

    <!-- Status filter tabs -->
    <div class="req-tabs">
      <a href="/institution/dashboard/requests" class="req-tab <%= !activeStatus ? 'active' : '' %>">
        Toutes <span class="tab-count"><%= countMap.pending + countMap.contacted + countMap.enrolled + countMap.rejected %></span>
      </a>
      <a href="/institution/dashboard/requests?status=pending" class="req-tab <%= activeStatus === 'pending' ? 'active' : '' %>">
        En attente <span class="tab-count"><%= countMap.pending %></span>
      </a>
      <a href="/institution/dashboard/requests?status=contacted" class="req-tab <%= activeStatus === 'contacted' ? 'active' : '' %>">
        Contacté <span class="tab-count"><%= countMap.contacted %></span>
      </a>
      <a href="/institution/dashboard/requests?status=enrolled" class="req-tab <%= activeStatus === 'enrolled' ? 'active' : '' %>">
        Inscrit <span class="tab-count"><%= countMap.enrolled %></span>
      </a>
      <a href="/institution/dashboard/requests?status=rejected" class="req-tab <%= activeStatus === 'rejected' ? 'active' : '' %>">
        Rejeté <span class="tab-count"><%= countMap.rejected %></span>
      </a>
    </div>

    <!-- Request list -->
    <% if (requests.length === 0) { %>
      <div class="empty-state">
        <p style="font-size:2.5rem;margin-bottom:.6rem;">📭</p>
        <p style="color:#64748b;">Aucune demande<%= activeStatus ? ' avec ce statut' : '' %> pour le moment.</p>
        <% if (activeStatus) { %>
          <a href="/institution/dashboard/requests" style="color:var(--brand);font-weight:700;text-decoration:none;">← Voir toutes les demandes</a>
        <% } %>
      </div>
    <% } else { %>
    <div class="req-list">
      <% requests.forEach(r => {
        const initials = (r.name || 'X').charAt(0).toUpperCase();
        const courseName = r.courseId ? (r.courseId.title || 'Cours supprimé') : 'Cours supprimé';
        const dateStr = new Date(r.createdAt).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' });
      %>
      <div class="req-card">
        <div class="req-card-top">
          <div class="req-avatar"><%= initials %></div>
          <div style="flex:1;min-width:0;">
            <div class="req-name"><%= r.name %></div>
            <div class="req-email"><a href="mailto:<%= r.email %>" style="color:#64748b;text-decoration:none;"><%= r.email %></a></div>
            <% if (r.phone) { %><div class="req-phone">📞 <%= r.phone %></div><% } %>
          </div>
          <span class="req-status-badge" style="background:<%= statusBg[r.status] %>;color:<%= statusColors[r.status] %>;">
            <%= statusLabels[r.status] %>
          </span>
        </div>

        <div class="req-card-mid">
          <span class="req-course-chip">📚 <%= courseName %></span>
          <span class="req-date">Reçu le <%= dateStr %></span>
        </div>

        <% if (r.message) { %>
          <div class="req-message-box">"<%= r.message %>"</div>
        <% } %>

        <div class="req-actions">
          <!-- Status update -->
          <form action="/institution/dashboard/requests/<%= r._id %>/status?_method=PUT" method="POST" style="display:inline;">
            <input type="hidden" name="status" value="<%= nextStatus[r.status] %>">
            <button type="submit" class="btn-status"><%= nextLabel[r.status] %> →</button>
          </form>
          <!-- Quick enroll link if status is not already enrolled -->
          <% if (r.status !== 'enrolled') { %>
            <a href="/institution/dashboard/students/create?email=<%= encodeURIComponent(r.email) %>&name=<%= encodeURIComponent(r.name) %>&courseId=<%= r.courseId ? r.courseId._id : '' %>" style="font-size:.78rem;font-weight:700;color:#16a34a;text-decoration:none;padding:.35rem .9rem;border:1.5px solid #86efac;border-radius:8px;transition:background .15s;" onmouseover="this.style.background='#f0fdf4'" onmouseout="this.style.background=''">
              ✚ Créer le compte
            </a>
          <% } %>
          <!-- Delete -->
          <form action="/institution/dashboard/requests/<%= r._id %>?_method=DELETE" method="POST" style="margin-left:auto;">
            <button type="submit" class="btn-delete" onclick="return confirm('Supprimer cette demande ?')">✕ Supprimer</button>
          </form>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>

  </div>
</div>
