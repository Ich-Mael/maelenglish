<% layout('layouts/main') %>

<% headContent = `
  <style>
    .auth-container {
      max-width: 500px;
      margin: 4rem auto;
      padding: 2rem;
    }
    
    .auth-card {
      background: white;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      padding: 2.5rem;
      border-top: 5px solid #5d06ba;
    }
    
    .auth-title {
      color: var(--color-dark);
      margin-bottom: 1.5rem;
      text-align: center;
      font-weight: 700;
    }
    
    .auth-btn {
      width: 100%;
      padding: 0.8rem;
      font-weight: 600;
      margin-top: 1rem;
      background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
      border: none;
      color: white;
      transition: all 0.3s ease;
    }

    .auth-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(93, 6, 186, 0.3);
      color: white;
    }
    
    .form-label {
      font-weight: 500;
      color: #555;
    }
    
    .form-control {
      padding: 0.8rem;
      border-radius: var(--radius-sm);
    }
    
    .form-control:focus {
      border-color: #5d06ba;
      box-shadow: 0 0 0 0.25rem rgba(93, 6, 186, 0.1);
    }

    /* Password strength meter */
    .pw-strength { margin-top: .6rem; }
    .pw-meter {
      display: flex; gap: 5px; margin-bottom: .35rem;
    }
    .pw-meter span {
      flex: 1; height: 6px; border-radius: 99px;
      background: #e5e7eb; transition: background .25s ease;
    }
    .pw-meter.lvl-1 span:nth-child(1) { background: #ef4444; }
    .pw-meter.lvl-2 span:nth-child(-n+2) { background: #f59e0b; }
    .pw-meter.lvl-3 span:nth-child(-n+3) { background: #eab308; }
    .pw-meter.lvl-4 span { background: #22c55e; }
    .pw-strength-label { font-size: .82rem; font-weight: 600; min-height: 1.1em; }
    .pw-strength-label.lvl-1 { color: #ef4444; }
    .pw-strength-label.lvl-2 { color: #d97706; }
    .pw-strength-label.lvl-3 { color: #ca8a04; }
    .pw-strength-label.lvl-4 { color: #16a34a; }

    .pw-reqs { list-style: none; padding: 0; margin: .6rem 0 0; font-size: .8rem; }
    .pw-reqs li { color: #9ca3af; margin: .15rem 0; transition: color .2s ease; }
    .pw-reqs li i { margin-right: .35rem; }
    .pw-reqs li.ok { color: #16a34a; }

    .pw-match { font-size: .82rem; font-weight: 600; min-height: 1.1em; margin-top: .4rem; }
    .pw-match.ok  { color: #16a34a; }
    .pw-match.bad { color: #ef4444; }

    .auth-btn:disabled { opacity: .55; cursor: not-allowed; transform: none; box-shadow: none; }
  </style>
` %>

<div class="auth-container">
  <div class="auth-card" data-aos="fade-up">
    <h2 class="auth-title">Code reçu sur WhatsApp</h2>
    <p class="text-center text-muted mb-4">Saisissez le code à 6 chiffres reçu sur WhatsApp (valable 10 minutes), puis choisissez un nouveau mot de passe.</p>
    
    <form action="/reset-code" method="POST" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="code" class="form-label">Code à 6 chiffres</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-whatsapp"></i></span>
            <input type="text" class="form-control" id="code" name="code" required inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" placeholder="123456" style="letter-spacing:.3em; font-weight:700">
        </div>
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Nouveau mot de passe</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-lock"></i></span>
            <input type="password" class="form-control" id="password" name="password" required minlength="6">
            <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('password')">
                <i class="bi bi-eye"></i>
            </button>
        </div>

        <div class="pw-strength" aria-live="polite">
          <div class="pw-meter" id="pwMeter"><span></span><span></span><span></span><span></span></div>
          <div class="pw-strength-label" id="pwLabel"></div>
        </div>
        <ul class="pw-reqs" id="pwReqs">
          <li data-req="length"><i class="bi bi-circle"></i>Au moins 8 caractères</li>
          <li data-req="case"><i class="bi bi-circle"></i>Majuscules et minuscules</li>
          <li data-req="digit"><i class="bi bi-circle"></i>Au moins un chiffre</li>
          <li data-req="symbol"><i class="bi bi-circle"></i>Au moins un symbole (!?@#…)</li>
        </ul>
      </div>

      <div class="mb-3">
        <label for="confirm" class="form-label">Confirmer le mot de passe</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
            <input type="password" class="form-control" id="confirm" name="confirm" required minlength="6">
            <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('confirm')">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <div class="pw-match" id="pwMatch" aria-live="polite"></div>
      </div>

      <button type="submit" class="btn auth-btn" id="submitBtn">Changer le mot de passe</button>
    </form>
    
    <div class="text-center mt-3"><a href="/forgot-password"><i class="bi bi-arrow-repeat"></i> Recevoir un nouveau code</a></div>

    <script>
        function togglePassword(fieldId) {
            const input = document.getElementById(fieldId);
            const icon = event.currentTarget.querySelector('i');

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = "password";
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }

        (function () {
            const pw      = document.getElementById('password');
            const confirm = document.getElementById('confirm');
            const meter   = document.getElementById('pwMeter');
            const label   = document.getElementById('pwLabel');
            const reqsEl  = document.getElementById('pwReqs');
            const matchEl = document.getElementById('pwMatch');
            const btn     = document.getElementById('submitBtn');

            const LABELS = ['', 'Faible', 'Moyen', 'Bon', 'Fort'];

            function checks(v) {
                return {
                    length: v.length >= 8,
                    case:   /[a-z]/.test(v) && /[A-Z]/.test(v),
                    digit:  /\d/.test(v),
                    symbol: /[^A-Za-z0-9]/.test(v)
                };
            }

            // Strength level 0–4 from satisfied criteria (+ length bonus)
            function level(v) {
                if (!v) return 0;
                const c = checks(v);
                let score = Object.values(c).filter(Boolean).length; // 0–4
                if (v.length >= 12 && score >= 3) score = 4;
                if (v.length < 6) score = Math.min(score, 1);
                return Math.max(1, Math.min(score, 4));
            }

            function updateStrength() {
                const v = pw.value;
                const c = checks(v);
                Array.from(reqsEl.children).forEach(li => {
                    const ok = c[li.dataset.req];
                    li.classList.toggle('ok', !!ok);
                    const i = li.querySelector('i');
                    i.className = ok ? 'bi bi-check-circle-fill' : 'bi bi-circle';
                });
                const lvl = level(v);
                meter.className = 'pw-meter' + (lvl ? ' lvl-' + lvl : '');
                label.className = 'pw-strength-label' + (lvl ? ' lvl-' + lvl : '');
                label.textContent = v ? ('Force du mot de passe : ' + LABELS[lvl]) : '';
                updateMatch();
            }

            function updateMatch() {
                if (!confirm.value) { matchEl.textContent = ''; matchEl.className = 'pw-match'; }
                else if (pw.value === confirm.value) {
                    matchEl.textContent = '✓ Les mots de passe correspondent';
                    matchEl.className = 'pw-match ok';
                } else {
                    matchEl.textContent = '✗ Les mots de passe ne correspondent pas';
                    matchEl.className = 'pw-match bad';
                }
                // Block submit on mismatch (server still validates as well)
                const mismatch = confirm.value && pw.value !== confirm.value;
                btn.disabled = mismatch;
            }

            pw.addEventListener('input', updateStrength);
            confirm.addEventListener('input', updateMatch);
        })();
    </script>
  </div>
</div>
