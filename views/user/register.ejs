<% layout('layouts/boilerplate') %>
    <link href="stylesheets/user/register.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <section class="inscription">
    <form class="validated-form" novalidate action="/register" method="POST">
        <div class="container ">
            <div class="row d-flex align-items-center justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="card py-5">
<h1 class="create-account-header text-center"> Creation de Compte</h1>
                        <span class="circle"><i class="fa fa-check"></i></span>
                        <h5 class="mt-3 join-number">
                            Being knowlegeable is the best way  <br /> to make your dream come true
                        </h5>
                        <!--name-->
                        <div class="form-input">
                            <i class="bi bi-person-circle"></i>
                            <input class="form-control" placeholder="Nom" id="name" name="name" type="text" value="" required />
                        </div>
                        <div class="form-input">
                            <i class="bi bi-person-circle"></i>
                            <input class="form-control" placeholder="Prénoms" id="surname" name="surname" type="text" value="" required />
                        </div>
                        <!--username input-->
                        <div class="form-input">
                            <i class="bi bi-person-circle fs-5"></i>
                            <input class="form-control" placeholder="Nom Utilisateur" id="username" name="username" type="text" value="" required />
                        </div>
                        <!--Email input-->
                        <div class="form-input">
                            <i class="bi bi-envelope-fill"></i>
                            <input class="form-control" id="email" placeholder="Votre addresse mail" name="email" type="text" value="" required />
                        </div>
                        <!--Password-->
                        <div class="form-input">
                            <i class="fa fa-lock"></i>
                            <input class="form-control" placeholder="Saisissez votre mot de passe" id="password" name="password" type="password" value="" required />
                        </div>
                        <div class="form-input">
                            <i class="bi bi-shield-lock-fill fs-5"></i>
                            <input class="form-control" placeholder="Confirmez votre mot de passe" id="confirmedpassword" name="confirmedpassword" type="password" value="" required />
                        </div>
                        <div style="margin-top: 7px; background-color:rgba(250, 249, 249, 0.89); text-align: center;" id="CheckPasswordMatch"></div>
                        <button type="submit" class="btn btn-warning mt-4 signup">Creation de compte</button>
                        <div class="text-center mt-4">
                            <span class="">Vous avez déjà un compte?</span>
                            <a href="/login" class="deja-compte text-center text-decoration-none">Connexion</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </div>
    </form>
</section>
    <script>
        $(document).ready(function() {
            $("#confirmedpassword").on("keyup", function() {
                const password = $("#password").val();
                const confirmPassword = $("#confirmedpassword").val();
                if (password != confirmPassword)
                    $("#CheckPasswordMatch")
                    .html("Mots de passe non identiques !")
                    .css("color", "red");
                else
                    $("#CheckPasswordMatch")
                    .html("Super, les mots de passe sont identiques!")
                    .css("color", "green");
            });
        });
    </script>