<% layout('layouts/boilerplate') %>
<link href="stylesheets/register.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>

<form class="validated-form" novalidate action="/register" method="POST">
  <div class="container mt-5 mb-5">
    <div class="row d-flex align-items-center justify-content-center">
      <div class="col-md-6">
        <div class="card px-5 py-5">
          <span class="circle"><i class="fa fa-check"></i></span>
          <h5 class="mt-3 text-warning">
            Join over 10 million <br />
            learners all accross Africa
          </h5>
          <small class="mt-2 text-white"
            > Learn .... Kia you will help me here.. ( un truc pour motiver les gens a avoir un compte )</small
          >
          <!--name-->
         <div class="form-input">
            <i class="bi bi-person-circle"></i>
            <input
              class="form-control"
              placeholder="Nom"
              id="name"
              name="name"
              type="text"
              value=""
              required
            />
         </div> 
         <div class="form-input">
            <i class="bi bi-person-circle"></i>
            <input
              class="form-control"
              placeholder="Prénoms"
              id="surname"
              name="surname"
              type="text"
              value=""
              required
            />
         </div>
 <!--username input--> 
 <div class="form-input">
    <i class="bi bi-person-circle fs-5"></i>
    <input
      class="form-control"
      placeholder="Nom Utilisateur"
      id="username"
      name="username"
      type="text"
      value=""
      required
    />
  </div>
          <!--Email input-->
          <div class="form-input">
            <i class="bi bi-envelope-fill"></i>
            <input
              class="form-control"
              id="email"
              placeholder="Votre addresse mail"
              name="email"
              type="text"
              value=""
              required
            />
          </div>
<!--Password-->
          <div class="form-input">
            <i class="fa fa-lock"></i>
              <input
                class="form-control"
                placeholder="Saisissez votre mot de passe"
                id="password"
                name="password"
                type="password"
                value=""
                required
              />
          </div>
          <div class="form-input">
            <i class="bi bi-shield-lock-fill fs-5"></i>
            <input
              class="form-control"
                placeholder="Confirmez votre mot de passe"
              id="confirmedpassword"
              name="confirmedpassword"
              type="password"
              value=""
              required
            />
          </div>
          <div style="margin-top: 7px; background-color:rgba(250, 249, 249, 0.89); text-align: center;" id="CheckPasswordMatch"></div>
          <button type="submit" class="btn btn-warning mt-4 signup">Creation de compte</button>
          <div class="text-center mt-4">
            <span class="">Vous avez déjà un compte?</span>
            <a href="/login" class="deja-compte text-center text-decoration-none">Connexion</a>
          </div>
        </div>
      </div>
      </div>
    </div>
  </div>
</form>
<script>
  $(document).ready(function () {
    $("#confirmedpassword").on("keyup", function () {
      const password = $("#password").val();
      const confirmPassword = $("#confirmedpassword").val();
      if (password != confirmPassword)
        $("#CheckPasswordMatch")
          .html("Mots de passe non identiques !")
          .css("color", "red");
      else
        $("#CheckPasswordMatch")
          .html("Super, les mots de passe sont identiques!")
          .css("color", "green");
    });
  });
</script>
