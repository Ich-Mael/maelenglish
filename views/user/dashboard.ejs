<% layout('layouts/main') %>

<% headContent = `<style>
  #main { margin-top: 0 !important; padding-top: 0 !important; }

  /* ─── Layout ─────────────────────────────────────────── */
  .ud-page {
    background: #f3f4f8;
    min-height: 100vh;
    padding: 100px 0 5rem;
  }
  .ud-container { max-width: 1060px; margin: 0 auto; padding: 0 1.25rem; }

  /* ─── Hero ───────────────────────────────────────────── */
  .ud-hero {
    background: linear-gradient(135deg, #1a0044 0%, #3b0096 55%, #6d22c5 100%);
    border-radius: 20px;
    padding: 2.25rem 2.5rem;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 12px 40px rgba(93,6,186,.28);
    position: relative;
    overflow: hidden;
  }
  .ud-hero::after {
    content: '';
    position: absolute;
    right: -80px; top: -80px;
    width: 280px; height: 280px;
    background: rgba(255,255,255,.07);
    border-radius: 50%;
    pointer-events: none;
  }
  .ud-avatar {
    width: 90px; height: 90px;
    border-radius: 50%;
    border: 3px solid rgba(255,255,255,.3);
    object-fit: cover;
    flex-shrink: 0;
  }
  .ud-avatar-initials {
    width: 90px; height: 90px;
    border-radius: 50%;
    border: 3px solid rgba(255,255,255,.3);
    background: rgba(255,255,255,.15);
    display: flex; align-items: center; justify-content: center;
    font-size: 2rem; font-weight: 700; color: #fff;
    flex-shrink: 0;
    backdrop-filter: blur(4px);
  }
  .ud-hero-info { flex: 1; min-width: 0; }
  .ud-hero-name { font-size: 1.65rem; font-weight: 800; margin: 0 0 .2rem; line-height: 1.2; }
  .ud-hero-meta { font-size: .85rem; opacity: .75; margin-bottom: .9rem; display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .ud-hero-meta span { display: inline-flex; align-items: center; gap: .35rem; }
  .ud-chips { display: flex; gap: .5rem; flex-wrap: wrap; }
  .ud-chip {
    padding: .3rem .85rem;
    border-radius: 50px;
    font-size: .78rem; font-weight: 600;
    background: rgba(255,255,255,.15);
    border: 1px solid rgba(255,255,255,.2);
    backdrop-filter: blur(6px);
    display: inline-flex; align-items: center; gap: .35rem;
  }
  .ud-chip-green { background: rgba(52,211,153,.25); border-color: rgba(52,211,153,.4); }
  .ud-hero-actions { display: flex; flex-direction: column; gap: .75rem; align-items: flex-end; flex-shrink: 0; }
  .ud-btn-pw {
    display: inline-flex; align-items: center; gap: .6rem;
    padding: .65rem 1.4rem;
    background: rgba(255,255,255,.15);
    border: 1.5px solid rgba(255,255,255,.3);
    color: #fff; text-decoration: none;
    border-radius: 12px; font-weight: 600; font-size: .88rem;
    backdrop-filter: blur(6px);
    transition: background .2s, transform .2s;
    white-space: nowrap;
  }
  .ud-btn-pw:hover { background: rgba(255,255,255,.25); transform: translateY(-2px); color: #fff; text-decoration: none; }

  /* ─── Stats ──────────────────────────────────────────── */
  .ud-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .ud-stat {
    background: #fff;
    border-radius: 14px;
    padding: 1.25rem 1.4rem;
    box-shadow: 0 2px 12px rgba(0,0,0,.06);
    display: flex; align-items: center; gap: 1rem;
    transition: transform .2s, box-shadow .2s;
  }
  .ud-stat:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(0,0,0,.1); }
  .ud-stat-icon {
    width: 48px; height: 48px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.35rem; flex-shrink: 0;
  }
  .ud-stat-icon.purple { background: rgba(93,6,186,.1); color: #5d06ba; }
  .ud-stat-icon.blue   { background: rgba(59,130,246,.1); color: #2563eb; }
  .ud-stat-icon.teal   { background: rgba(20,184,166,.1); color: #0d9488; }
  .ud-stat-icon.green  { background: rgba(34,197,94,.1); color: #16a34a; }
  .ud-stat-icon.orange { background: rgba(249,115,22,.1); color: #ea580c; }
  .ud-stat-val { font-size: 1.6rem; font-weight: 800; color: #1e1b4b; line-height: 1; }
  .ud-stat-lbl { font-size: .78rem; color: #64748b; margin-top: .2rem; font-weight: 500; }

  /* ─── Sections ───────────────────────────────────────── */
  .ud-section { margin-bottom: 2rem; }
  .ud-section-head {
    display: flex; align-items: center; gap: .65rem;
    font-size: 1.1rem; font-weight: 700; color: #1e1b4b;
    margin-bottom: 1.1rem;
    padding-bottom: .75rem;
    border-bottom: 2px solid #ede8ff;
  }
  .ud-section-head i { color: #5d06ba; font-size: 1.1rem; }

  /* ─── Quick Actions ──────────────────────────────────── */
  .ud-actions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: .9rem;
  }
  .ud-action-btn {
    display: flex; align-items: center; gap: .75rem;
    padding: 1rem 1.25rem;
    background: #fff;
    border-radius: 12px;
    border: 1.5px solid #e8e3ff;
    color: #3b0096; font-weight: 600; font-size: .9rem;
    text-decoration: none;
    transition: all .2s;
    box-shadow: 0 2px 8px rgba(93,6,186,.06);
  }
  .ud-action-btn i { font-size: 1.2rem; color: #5d06ba; }
  .ud-action-btn:hover {
    background: #5d06ba; color: #fff; border-color: #5d06ba;
    transform: translateY(-2px); box-shadow: 0 6px 18px rgba(93,6,186,.25);
    text-decoration: none;
  }
  .ud-action-btn:hover i { color: #fff; }

  /* ─── Program & Course Cards ─────────────────────────── */
  .ud-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .ud-card {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 2px 12px rgba(0,0,0,.06);
    overflow: hidden;
    display: flex; flex-direction: column;
    transition: transform .2s, box-shadow .2s;
  }
  .ud-card:hover { transform: translateY(-4px); box-shadow: 0 8px 28px rgba(0,0,0,.1); }
  .ud-card-accent { height: 4px; }
  .ud-card-body { padding: 1.4rem; flex: 1; display: flex; flex-direction: column; gap: .9rem; }
  .ud-card-header { display: flex; align-items: center; gap: .85rem; }
  .ud-card-icon {
    width: 44px; height: 44px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.25rem; flex-shrink: 0;
  }
  .ud-card-title { font-size: 1rem; font-weight: 700; color: #1e1b4b; margin: 0; line-height: 1.3; }
  .ud-card-subtitle { font-size: .77rem; color: #94a3b8; font-weight: 500; margin-top: .15rem; }
  .ud-card-status {
    display: inline-flex; align-items: center; gap: .4rem;
    font-size: .8rem; font-weight: 600;
    padding: .35rem .75rem;
    border-radius: 50px;
  }
  .ud-status-active  { background: #dcfce7; color: #15803d; }
  .ud-status-expired { background: #fee2e2; color: #dc2626; }
  .ud-status-pending { background: #fef3c7; color: #d97706; }
  .ud-card-footer { margin-top: auto; }
  .ud-btn-primary {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
    width: 100%; padding: .7rem 1.25rem;
    border-radius: 10px;
    font-weight: 600; font-size: .88rem;
    color: #fff; text-decoration: none;
    transition: opacity .2s, transform .2s;
  }
  .ud-btn-primary:hover { opacity: .88; transform: translateY(-1px); color: #fff; text-decoration: none; }
  .ud-btn-disabled {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
    width: 100%; padding: .7rem 1.25rem;
    border-radius: 10px;
    font-weight: 600; font-size: .88rem;
    background: #f1f5f9; color: #94a3b8;
    cursor: default;
  }
  .ud-expiry-note { font-size: .78rem; color: #94a3b8; display: flex; align-items: center; gap: .35rem; }

  /* ─── Empty State ────────────────────────────────────── */
  .ud-empty {
    background: #fff;
    border-radius: 14px;
    padding: 2.5rem 2rem;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0,0,0,.05);
  }
  .ud-empty i { font-size: 2.5rem; color: #cbd5e1; display: block; margin-bottom: .75rem; }
  .ud-empty p { color: #94a3b8; margin: 0; font-size: .9rem; }

  /* ─── Account Info ───────────────────────────────────── */
  .ud-account-grid {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 2px 12px rgba(0,0,0,.06);
    overflow: hidden;
  }
  .ud-account-row {
    display: flex; align-items: center;
    padding: .9rem 1.5rem;
    border-bottom: 1px solid #f1f5f9;
    gap: 1rem;
  }
  .ud-account-row:last-child { border-bottom: none; }
  .ud-account-icon { color: #5d06ba; font-size: 1rem; width: 20px; flex-shrink: 0; }
  .ud-account-label { font-size: .82rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; min-width: 140px; flex-shrink: 0; }
  .ud-account-value { color: #1e1b4b; font-weight: 500; font-size: .9rem; }
  .ud-verified-badge {
    display: inline-flex; align-items: center; gap: .35rem;
    padding: .25rem .75rem; border-radius: 50px; font-size: .8rem; font-weight: 600;
  }

  /* ─── Responsive ─────────────────────────────────────── */
  @media (max-width: 900px) {
    .ud-stats { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .ud-hero { flex-direction: column; text-align: center; padding: 1.75rem 1.5rem; gap: 1.25rem; }
    .ud-hero-meta { justify-content: center; }
    .ud-chips { justify-content: center; }
    .ud-hero-actions { align-items: center; width: 100%; }
    .ud-stats { grid-template-columns: repeat(2, 1fr); }
    .ud-account-row { flex-wrap: wrap; }
    .ud-account-label { min-width: 100%; margin-bottom: .1rem; }
  }
  @media (max-width: 400px) {
    .ud-stats { grid-template-columns: 1fr; }
  }
</style>` %>

<div class="ud-page">
  <div class="ud-container">

    <%- include('../partials/flash') %>

    <!-- ─── Hero ─────────────────────────────────────────────── -->
    <div class="ud-hero">
      <% if (user.imageUrl && !user.imageUrl.includes('kindpng.com')) { %>
        <img src="<%= user.imageUrl %>" alt="<%= user.name %>" class="ud-avatar">
      <% } else { %>
        <div class="ud-avatar-initials">
          <%= user.name.charAt(0).toUpperCase() %><%= user.surname.charAt(0).toUpperCase() %>
        </div>
      <% } %>

      <div class="ud-hero-info">
        <h1 class="ud-hero-name"><%= user.name %> <%= user.surname %></h1>
        <div class="ud-hero-meta">
          <span><i class="bi bi-at"></i><%= user.username %></span>
          <span><i class="bi bi-envelope"></i><%= user.email %></span>
        </div>
        <div class="ud-chips">
          <span class="ud-chip">
            <i class="bi bi-person-fill"></i>
            <%= user.role === 'admin' ? 'Administrateur'
              : user.role === 'super-admin' ? 'Super Admin'
              : user.role === 'english-coach' ? 'Instructeur'
              : user.role === 'institution-admin' ? 'Admin Institution'
              : 'Apprenant' %>
          </span>
          <% if (user.isVerified) { %>
            <span class="ud-chip ud-chip-green">
              <i class="bi bi-patch-check-fill"></i> Vérifié
            </span>
          <% } %>
          <% if (user.institutionId) { %>
            <span class="ud-chip">
              <i class="bi bi-building"></i> Institution
            </span>
          <% } %>
        </div>
      </div>

      <div class="ud-hero-actions">
        <a href="/forgot-password" class="ud-btn-pw">
          <i class="bi bi-key-fill"></i> Changer le mot de passe
        </a>
      </div>
    </div>

    <!-- ─── Stats ─────────────────────────────────────────────── -->
    <%
      const progCount = (user.isHighSchoolStudent ? 1 : 0)
                      + (user.isClubMember ? 1 : 0)
                      + (user.isPecpStudent || user.isPecpCoach ? 1 : 0)
                      + (user.coursesTaken && user.coursesTaken.length > 0 ? 1 : 0);
      const instCount = typeof institutionEnrollments !== 'undefined' ? institutionEnrollments.length : 0;
    %>
    <div class="ud-stats">
      <div class="ud-stat">
        <div class="ud-stat-icon blue"><i class="bi bi-book-half"></i></div>
        <div>
          <div class="ud-stat-val"><%= user.coursesTaken ? user.coursesTaken.length : 0 %></div>
          <div class="ud-stat-lbl">Cours AfroHK</div>
        </div>
      </div>
      <div class="ud-stat">
        <div class="ud-stat-icon purple"><i class="bi bi-grid-3x3-gap-fill"></i></div>
        <div>
          <div class="ud-stat-val"><%= progCount %></div>
          <div class="ud-stat-lbl">Programmes</div>
        </div>
      </div>
      <div class="ud-stat">
        <div class="ud-stat-icon teal"><i class="bi bi-building"></i></div>
        <div>
          <div class="ud-stat-val"><%= instCount %></div>
          <div class="ud-stat-lbl">Cours institution</div>
        </div>
      </div>
      <div class="ud-stat">
        <div class="ud-stat-icon <%= user.isVerified ? 'green' : 'orange' %>">
          <i class="bi bi-<%= user.isVerified ? 'patch-check-fill' : 'exclamation-circle' %>"></i>
        </div>
        <div>
          <div class="ud-stat-val" style="font-size:1rem;padding-top:.25rem;"><%= user.isVerified ? 'Vérifié' : 'En attente' %></div>
          <div class="ud-stat-lbl">Statut du compte</div>
        </div>
      </div>
    </div>

    <!-- ─── Quick Actions ─────────────────────────────────────── -->
    <%
      const hasActions = (user.role === 'admin' || user.role === 'super-admin' || user.role === 'account-manager')
                      || user.role === 'english-coach'
                      || user.isHighSchoolStudent
                      || (user.coursesTaken && user.coursesTaken.some(c => (c._id || c).toString() === '69584e4bf744983f1e3ed576'));
    %>
    <% if (hasActions) { %>
    <div class="ud-section">
      <div class="ud-section-head">
        <i class="bi bi-lightning-charge-fill"></i> Actions rapides
      </div>
      <div class="ud-actions-grid">
        <% if (user.role === 'admin' || user.role === 'super-admin') { %>
          <a href="/admin/dashboard" class="ud-action-btn">
            <i class="bi bi-speedometer2"></i> Dashboard Admin
          </a>
          <a href="/admin/users" class="ud-action-btn">
            <i class="bi bi-people-fill"></i> Gérer les utilisateurs
          </a>
        <% } %>
        <% if (user.role === 'admin' || user.role === 'super-admin' || user.role === 'account-manager') { %>
          <a href="/admin/users/create" class="ud-action-btn">
            <i class="bi bi-person-plus-fill"></i> Créer un compte
          </a>
        <% } %>
        <% if (user.role === 'english-coach') { %>
          <a href="/programs/language-learning/instructor/dashboard" class="ud-action-btn">
            <i class="bi bi-person-video3"></i> Dashboard Instructeur
          </a>
        <% } %>
        <% if (user.isHighSchoolStudent) { %>
          <%
            const kalanRoute = typeof studentClassId !== 'undefined' && studentClassId
              ? `/programs/ekalan/kalan/class/${studentClassId}`
              : '/programs/ekalan/kalan';
          %>
          <a href="<%= kalanRoute %>" class="ud-action-btn">
            <i class="bi bi-mortarboard-fill"></i> Tableau de bord Kalan
          </a>
        <% } %>
        <% if (user.coursesTaken && user.coursesTaken.some(c => (c._id || c).toString() === '69584e4bf744983f1e3ed576')) { %>
          <a href="/programs/language-learning/general-english-boost/my-courses" class="ud-action-btn">
            <i class="bi bi-play-circle-fill"></i> English Boost — mes cours
          </a>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- ─── AfroHK Programmes ──────────────────────────────────── -->
    <%
      const afroProg = [];
      if (user.isHighSchoolStudent) {
        const kr = typeof studentClassId !== 'undefined' && studentClassId
          ? `/programs/ekalan/kalan/class/${studentClassId}`
          : '/programs/ekalan/kalan';
        afroProg.push({ name: 'Kalan', sub: 'Plateforme lycée', icon: 'mortarboard-fill', color: '#7c3aed', route: kr });
      }
      if (user.isClubMember)
        afroProg.push({ name: 'English4All', sub: 'Club linguistique', icon: 'translate', color: '#0891b2', route: '/programs/language-learning/english4all' });
      if (user.isPecpStudent)
        afroProg.push({ name: 'PECP', sub: 'Étudiant', icon: 'book-fill', color: '#16a34a', route: '/programs/language-learning/pecp' });
      if (user.isPecpCoach)
        afroProg.push({ name: 'PECP', sub: 'Coach', icon: 'person-check-fill', color: '#0d9488', route: '/programs/language-learning/pecp' });
      if (user.coursesTaken && user.coursesTaken.length > 0)
        afroProg.push({ name: 'General English Boost', sub: 'Cours de langue', icon: 'stars', color: '#d97706', route: '/programs/language-learning/general-english-boost/my-courses' });
    %>
    <div class="ud-section">
      <div class="ud-section-head">
        <i class="bi bi-grid-3x3-gap-fill"></i> Mes programmes AfroHK
      </div>
      <% if (afroProg.length > 0) { %>
        <div class="ud-cards-grid">
          <% afroProg.forEach(p => { %>
            <div class="ud-card">
              <div class="ud-card-accent" style="background:<%= p.color %>;"></div>
              <div class="ud-card-body">
                <div class="ud-card-header">
                  <div class="ud-card-icon" style="background:color-mix(in srgb,<%= p.color %> 12%,#fff);color:<%= p.color %>;">
                    <i class="bi bi-<%= p.icon %>"></i>
                  </div>
                  <div>
                    <p class="ud-card-title"><%= p.name %></p>
                    <p class="ud-card-subtitle"><%= p.sub %></p>
                  </div>
                </div>
                <span class="ud-card-status ud-status-active">
                  <i class="bi bi-check-circle-fill"></i> Programme actif
                </span>
                <div class="ud-card-footer">
                  <a href="<%= p.route %>" class="ud-btn-primary" style="background:<%= p.color %>;">
                    <i class="bi bi-box-arrow-in-right"></i> Accéder
                  </a>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="ud-empty">
          <i class="bi bi-inbox"></i>
          <p>Aucun programme AfroHK actif. Contactez un administrateur pour vous inscrire.</p>
        </div>
      <% } %>
    </div>

    <!-- ─── Institution Courses ────────────────────────────────── -->
    <% if (typeof institutionEnrollments !== 'undefined' && institutionEnrollments.length > 0) { %>
    <div class="ud-section">
      <div class="ud-section-head">
        <i class="bi bi-building-fill"></i> Mes cours d'institution
      </div>
      <div class="ud-cards-grid">
        <% institutionEnrollments.forEach(enrollment => { %>
          <% const instCourse = enrollment.courseId; %>
          <% const inst = enrollment.institutionId; %>
          <% const brandColor = inst ? (inst.primaryColor || '#0e7490') : '#0e7490'; %>
          <% const now = new Date(); %>
          <% const isExpired = enrollment.endDate && new Date(enrollment.endDate) < now; %>
          <% const notStarted = enrollment.startDate && new Date(enrollment.startDate) > now; %>
          <div class="ud-card">
            <div class="ud-card-accent" style="background:<%= brandColor %>;"></div>
            <div class="ud-card-body">
              <div class="ud-card-header">
                <div class="ud-card-icon" style="background:color-mix(in srgb,<%= brandColor %> 12%,#fff);color:<%= brandColor %>;">
                  <% if (inst && inst.logoUrl) { %>
                    <img src="<%= inst.logoUrl %>" alt="" style="width:26px;height:26px;object-fit:cover;border-radius:6px;">
                  <% } else { %>
                    <i class="bi bi-building-fill"></i>
                  <% } %>
                </div>
                <div>
                  <p class="ud-card-title"><%= instCourse ? instCourse.title : 'Cours' %></p>
                  <p class="ud-card-subtitle"><%= inst ? inst.name : 'Institution' %></p>
                </div>
              </div>

              <% if (isExpired) { %>
                <span class="ud-card-status ud-status-expired">
                  <i class="bi bi-x-circle-fill"></i> Accès expiré
                </span>
              <% } else if (notStarted) { %>
                <span class="ud-card-status ud-status-pending">
                  <i class="bi bi-hourglass-split"></i> Disponible le <%= new Date(enrollment.startDate).toLocaleDateString('fr-FR', {day:'2-digit',month:'short',year:'numeric'}) %>
                </span>
              <% } else { %>
                <span class="ud-card-status ud-status-active">
                  <i class="bi bi-check-circle-fill"></i> Cours actif
                </span>
              <% } %>

              <% if (enrollment.endDate) { %>
                <p class="ud-expiry-note">
                  <i class="bi bi-calendar3"></i>
                  <% if (isExpired) { %>
                    A expiré le <%= new Date(enrollment.endDate).toLocaleDateString('fr-FR', {day:'2-digit',month:'long',year:'numeric'}) %>
                  <% } else { %>
                    Accès jusqu'au <%= new Date(enrollment.endDate).toLocaleDateString('fr-FR', {day:'2-digit',month:'long',year:'numeric'}) %>
                  <% } %>
                </p>
              <% } %>

              <div class="ud-card-footer">
                <% if (!isExpired && !notStarted && instCourse) { %>
                  <a href="/institution/learn/courses/<%= instCourse._id %>" class="ud-btn-primary" style="background:<%= brandColor %>;">
                    <i class="bi bi-play-fill"></i> Accéder au cours
                  </a>
                <% } else { %>
                  <div class="ud-btn-disabled">
                    <i class="bi bi-lock-fill"></i>
                    <%= isExpired ? 'Accès expiré' : 'Pas encore disponible' %>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
    <% } %>

    <!-- ─── Account Info ──────────────────────────────────────── -->
    <div class="ud-section">
      <div class="ud-section-head">
        <i class="bi bi-person-lines-fill"></i> Informations du compte
      </div>
      <div class="ud-account-grid">
        <div class="ud-account-row">
          <i class="bi bi-person-fill ud-account-icon"></i>
          <span class="ud-account-label">Nom complet</span>
          <span class="ud-account-value"><%= user.name %> <%= user.surname %></span>
        </div>
        <div class="ud-account-row">
          <i class="bi bi-at ud-account-icon"></i>
          <span class="ud-account-label">Nom d'utilisateur</span>
          <span class="ud-account-value">@<%= user.username %></span>
        </div>
        <div class="ud-account-row">
          <i class="bi bi-envelope-fill ud-account-icon"></i>
          <span class="ud-account-label">Adresse email</span>
          <span class="ud-account-value"><%= user.email %></span>
        </div>
        <% if (user.phoneNumber) { %>
        <div class="ud-account-row">
          <i class="bi bi-phone-fill ud-account-icon"></i>
          <span class="ud-account-label">Téléphone</span>
          <span class="ud-account-value"><%= user.phoneNumber %></span>
        </div>
        <% } %>
        <div class="ud-account-row">
          <i class="bi bi-gender-ambiguous ud-account-icon"></i>
          <span class="ud-account-label">Genre</span>
          <span class="ud-account-value"><%= user.gender === 'male' ? 'Homme' : user.gender === 'female' ? 'Femme' : 'Non précisé' %></span>
        </div>
        <% if (user.englishLevel) { %>
        <div class="ud-account-row">
          <i class="bi bi-translate ud-account-icon"></i>
          <span class="ud-account-label">Niveau d'anglais</span>
          <span class="ud-account-value"><%= user.englishLevel %></span>
        </div>
        <% } %>
        <div class="ud-account-row">
          <i class="bi bi-patch-check-fill ud-account-icon"></i>
          <span class="ud-account-label">Vérification</span>
          <span class="ud-account-value">
            <span class="ud-verified-badge <%= user.isVerified ? 'ud-status-active' : 'ud-status-pending' %>">
              <i class="bi bi-<%= user.isVerified ? 'check-circle-fill' : 'clock' %>"></i>
              <%= user.isVerified ? 'Compte vérifié' : 'En attente de vérification' %>
            </span>
          </span>
        </div>
        <div class="ud-account-row">
          <i class="bi bi-calendar3 ud-account-icon"></i>
          <span class="ud-account-label">Membre depuis</span>
          <span class="ud-account-value"><%= new Date(user.createdAt).toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' }) %></span>
        </div>
      </div>
    </div>

  </div>
</div>
