<% layout('layouts/boilerplate') %>
<style type="text/css">
  .jumbotron {
    padding: 4rem 2rem;
    margin: 2rem 0;
    background-color: rgba(231, 239, 241, 0.733);
    border-radius: 0.3rem;
  }
</style>
<div class="container d-flex justify-content-center align-items-center">
  <!-- show a dialog if user is not verified  -->
  <% if(!verified && !emailsent){ %>
  <div class="jumbotron"></div>
  <div class=" mt-3">
    <strong class="text-red">IMPORTANT !</strong> Activez votre compte pour bénéficier pleinement de nos services
    <a href="/user/send-verification-email">Recevoir un nouveau lien d'activation de compte par mail</a>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
</div>
<% } %>

<% if(typeof emailsent !='undefined' ){ %> <% if(emailsent && !verified){ %>
<div class="jumbotron">
  <h1 class="display-4 py-3">
    Bienvenue
    <!-- <span style="font-family: Georgia, 'Times New Roman', Times, serif"><%= username %></span> -->
  </h1>
  <hr class="my-4" />
  <p><strong>Etape suivante : Activation de compte </strong></p>
  <p>
    Consultez votre boîte mail pour activer votre compte. <br><span class="text-danger">Le lien d'activation de compte
      est valide pour 20 minutes</span>
  </p>
  <br>
  <p>Vous n'avez pas reçu le mail d'activation de compte ?</p>
  <a class="btn btn-outline-primary btn-small mt-2" href="/user/send-verification-email" role="button">Recevoir un
    nouveau lien d'activation de compte par mail</a>
</div>
<% } %>

<% } %> <% if(typeof err !='undefined' ){ %> <% if(err  && !emailsent && !verified){ %>
<div class="jumbotron">
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <strong>ERREUR </strong>
    <%= err %>.
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
  <a href="/user/send-verification-email">Recevoir un nouveau lien d'activation de compte par mail</a>
</div>

<% } %> <% } %>
</div>