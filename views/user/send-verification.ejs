<% layout('layouts/main') %>

<% headContent = `
  <style>
    .auth-container {
      max-width: 500px;
      margin: 4rem auto;
      padding: 2rem;
    }
    
    .auth-card {
      background: white;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      padding: 2.5rem;
      border-top: 5px solid #5d06ba;
    }
    
    .auth-title {
      color: var(--color-dark);
      margin-bottom: 1.5rem;
      text-align: center;
      font-weight: 700;
    }
    
    .auth-btn {
      width: 100%;
      padding: 0.8rem;
      font-weight: 600;
      margin-top: 1rem;
      background: linear-gradient(135deg, #5d06ba 0%, #2d0370 100%);
      border: none;
      color: white;
      transition: all 0.3s ease;
    }

    .auth-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(93, 6, 186, 0.3);
      color: white;
    }
    
    .form-label {
      font-weight: 500;
      color: #555;
    }
    
    .form-control {
      padding: 0.8rem;
      border-radius: var(--radius-sm);
    }
    
    .form-control:focus {
      border-color: #5d06ba;
      box-shadow: 0 0 0 0.25rem rgba(93, 6, 186, 0.1);
    }

    /* Password strength meter */
    .pw-strength { margin-top: .6rem; }
    .pw-meter {
      display: flex; gap: 5px; margin-bottom: .35rem;
    }
    .pw-meter span {
      flex: 1; height: 6px; border-radius: 99px;
      background: #e5e7eb; transition: background .25s ease;
    }
    .pw-meter.lvl-1 span:nth-child(1) { background: #ef4444; }
    .pw-meter.lvl-2 span:nth-child(-n+2) { background: #f59e0b; }
    .pw-meter.lvl-3 span:nth-child(-n+3) { background: #eab308; }
    .pw-meter.lvl-4 span { background: #22c55e; }
    .pw-strength-label { font-size: .82rem; font-weight: 600; min-height: 1.1em; }
    .pw-strength-label.lvl-1 { color: #ef4444; }
    .pw-strength-label.lvl-2 { color: #d97706; }
    .pw-strength-label.lvl-3 { color: #ca8a04; }
    .pw-strength-label.lvl-4 { color: #16a34a; }

    .pw-reqs { list-style: none; padding: 0; margin: .6rem 0 0; font-size: .8rem; }
    .pw-reqs li { color: #9ca3af; margin: .15rem 0; transition: color .2s ease; }
    .pw-reqs li i { margin-right: .35rem; }
    .pw-reqs li.ok { color: #16a34a; }

    .pw-match { font-size: .82rem; font-weight: 600; min-height: 1.1em; margin-top: .4rem; }
    .pw-match.ok  { color: #16a34a; }
    .pw-match.bad { color: #ef4444; }

    .auth-btn:disabled { opacity: .55; cursor: not-allowed; transform: none; box-shadow: none; }
  </style>
` %>

<div class="auth-container">
  <div class="auth-card" data-aos="fade-up">
    <h2 class="auth-title">Activez votre compte</h2>
    <p class="text-center text-muted mb-4">Votre compte n’est pas encore activé.
      <% if (channel === 'email') { %>Nous pouvons renvoyer le lien d’activation à <strong><%= email %></strong>.
      <% } else if (channel === 'whatsapp') { %>Nous pouvons renvoyer le lien d’activation sur WhatsApp au <strong><%= phone %></strong>.
      <% } else { %>L’envoi automatique n’est pas encore disponible pour votre compte : contactez l’équipe AfroHK.<% } %>
    </p>
    <% if (channel === 'email' || channel === 'whatsapp') { %>
    <form action="/user/send-verification-email" method="POST">
      <button type="submit" class="btn auth-btn"><i class="bi bi-send"></i> Renvoyer le lien d’activation</button>
    </form>
    <% } %>
    <div class="text-center mt-3"><a href="/logout">Se déconnecter</a></div>
  </div>
</div>
